    m_Localized: "\uC804\uC5F4 \uC8FC\uBCC0\uC5D0 \uC9E7\uAC8C \uC720\uC9C0\uB418\uB294
      \uACA9\uC790 \uBC29\uBCBD\uC744 \uC138\uC6CC barrier\uB97C \uB354\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350408
    m_Localized: "\uAC00\uB85C\uB9C9\uB294 \uAC01\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350409
    m_Localized: "\uBCF4\uD638 \uB300\uC0C1 \uC544\uAD70\uC744 \uC9C0\uC815\uD574
      \uB4E4\uC5B4\uC624\uB294 \uC555\uBC15\uC744 \uD30C\uC218\uC790\uAC00 \uAC00\uB85C\uB9C9\uB3C4\uB85D
      \uB9CC\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350410
    m_Localized: "\uB9F9\uC138\uC758 \uBB34\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350411
    m_Localized: "\uD328\uC2DC\uBE0C. \uC804\uD22C \uC2DC\uC791 \uD6C4 8\uCD08\uAC04
      \uBC1B\uB294 \uD53C\uD574\uAC00 \uC904\uC5B4\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350412
    m_Localized: "\uACA9\uC790 \uBCF4\uB8E8"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350413
    m_Localized: "\uD328\uC2DC\uBE0C. \uC544\uAD70\uC774 \uC4F0\uB7EC\uC9C8 \uB54C\uB9C8\uB2E4
      \uB0A8\uC740 \uC544\uAD70 \uC804\uCCB4\uAC00 \uBCF4\uD638\uB9C9 25\uB97C \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350414
    m_Localized: "\uC804\uC5F4 \uACE0\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350415
    m_Localized: "\uC11C\uD3EC\uD2B8 \uC99D\uAC15. guard \uD6A8\uACFC\uAC00 \uC778\uC811
      \uC544\uAD70\uC758 \uC804\uC5F4\uB3C4 \uC548\uC815\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350416
    m_Localized: "\uCCA0\uD53C \uB09C\uD0C0"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350417
    m_Localized: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC744 \uBB34\uAC81\uAC8C
      \uD6C4\uB824\uCCD0 wound\uB97C \uB0A8\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350418
    m_Localized: "\uB179\uAC00\uC8FD \uB3CC\uC9C4"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350419
    m_Localized: "\uB178\uCD9C\uB41C \uC801\uC5D0\uAC8C \uB3CC\uC9C4\uD574 \uC9E7\uAC8C
      root\uB97C \uAC74\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350420
    m_Localized: "\uCCA0\uD53C \uD3EC\uD6A8"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350421
    m_Localized: "\uC9E7\uC740 \uC555\uBC15 \uD3EC\uD6A8\uB85C \uC8FC\uBCC0 \uC801\uC744
      exposed \uC0C1\uD0DC\uB85C \uB9CC\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350422
    m_Localized: "\uCCA0\uAC00\uC8FD \uAE30\uC5B5"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350423
    m_Localized: "\uD328\uC2DC\uBE0C. \uCCB4\uB825\uC774 \uC808\uBC18 \uC544\uB798\uB85C
      \uCC98\uC74C \uB5A8\uC5B4\uC9C0\uBA74 \uBCF4\uD638\uB9C9 45\uB97C \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350424
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uCCA0\uD53C"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350425
    m_Localized: "\uD328\uC2DC\uBE0C. \uCCB4\uB825\uC774 \uB0AE\uC744 \uB54C \uC804\uD22C\uB2F9
      \uD55C \uBC88 \uC9E7\uC740 unstoppable\uC744 \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350426
    m_Localized: "\uD504\uB9AC\uC998 \uCC3D"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350427
    m_Localized: "\uAC00\uB290\uB2E4\uB780 \uD504\uB9AC\uC998 \uD0C4\uC744 \uC3D8\uC544
      marked \uB300\uC0C1\uC744 \uC6B0\uC120\uD558\uACE0 \uD45C\uC2DD\uC744 \uAC31\uC2E0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350428
    m_Localized: "\uBD88\uC528 \uD654\uC0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350429
    m_Localized: "\uBE60\uB978 \uBD88\uC528 \uD654\uC0B4\uB85C \uC801\uC5D0\uAC8C
      burn\uC744 \uAC74\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350430
    m_Localized: "\uC7BF\uBD88 \uCD94\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350431
    m_Localized: "\uC57D\uD574\uC9C4 \uC801\uC744 \uC7BF\uBD88 \uC0AC\uACA9\uC73C\uB85C
      \uC555\uBC15\uD558\uACE0 slow\uB97C \uAC74\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350432
    m_Localized: "\uAD74\uC808 \uB36B"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350433
    m_Localized: "\uB178\uCD9C\uB41C \uB300\uC0C1\uC744 root\uC2DC\uD0A4\uB294 \uD504\uB9AC\uC998
      \uB36B\uC744 \uB193\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350434
    m_Localized: "\uC2E0\uD638 \uC12C\uAD11"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350435
    m_Localized: "\uC6B0\uC120 \uB300\uC0C1\uC744 marked\uB85C \uC9C0\uC815\uD558\uACE0
      \uC9E7\uAC8C exposed\uB97C \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350436
    m_Localized: "\uC7BF\uAC78\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350437
    m_Localized: "\uC9E7\uC740 \uC7BF\uAE38\uC744 \uB9CC\uB4E4\uACE0 \uC21C\uAC04\uC801\uC778
      unstoppable \uC7AC\uBC30\uCE58\uB97C \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350438
    m_Localized: "\uD504\uB9AC\uC998 \uC2DC\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350439
    m_Localized: "\uD328\uC2DC\uBE0C. \uC790\uC2E0\uC758 \uC561\uD2F0\uBE0C \uC2A4\uD0AC\uC774
      \uCE58\uBA85\uD0C0\uB97C \uB0BC \uC218 \uC788\uAC8C \uB418\uACE0 \uC0AC\uAC70\uB9AC\uAC00
      \uB298\uC5B4\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350440
    m_Localized: "\uC5F4\uC544\uC9C0\uB791\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350441
    m_Localized: "\uD328\uC2DC\uBE0C. \uCCB4\uB825\uC774 60% \uC544\uB798\uB85C \uCC98\uC74C
      \uB5A8\uC5B4\uC9C0\uBA74 4\uCD08\uAC04 \uBC1B\uB294 \uD53C\uD574\uAC00 \uC904\uC5B4\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350442
    m_Localized: "\uBE60\uB978 \uBD88\uC3D8\uC2DC\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350443
    m_Localized: "\uD328\uC2DC\uBE0C. \uC804\uD22C\uB97C \uC5D0\uB108\uC9C0 15\uB85C
      \uC2DC\uC791\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350444
    m_Localized: "\uC720\uB9AC\uAE38 \uD0D0\uC0C9\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350445
    m_Localized: "\uD328\uC2DC\uBE0C. \uC544\uAD70\uC774 \uC4F0\uB7EC\uC9C0\uBA74
      3\uCD08\uAC04 \uC801 \uC804\uCCB4\uAC00 \uD45C\uC801\uC73C\uB85C \uC0C8\uACA8\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350446
    m_Localized: "\uD3B8\uAC80 \uC808\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350447
    m_Localized: "\uB178\uCD9C\uB41C \uB300\uC0C1\uC744 \uC815\uD655\uD788 \uBCA0\uC5B4
      wound\uC640 sunder\uB97C \uB0A8\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350448
    m_Localized: "\uAC70\uC6B8 \uBCA0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350449
    m_Localized: "marked \uB300\uC0C1\uC5D0\uAC8C \uAC70\uC6B8\uCC98\uB7FC \uC587\uC740
      \uD30C\uD3B8\uC744 \uB358\uC838 exposed\uB97C \uAC74\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350450
    m_Localized: "\uADE0\uC5F4 \uBCF4\uBC95"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350451
    m_Localized: "\uB4A4\uB530\uB974\uB294 \uC801\uC744 slow\uC2DC\uD0A4\uB294 \uADE0\uC5F4
      \uADA4\uC801\uC744 \uB0A8\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350452
    m_Localized: "\uBC18\uACA9\uAC01"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350453
    m_Localized: "\uC881\uC740 \uBC18\uACA9 \uAC01\uB3C4\uB97C \uC7A1\uACE0 \uC9E7\uAC8C
      guarded\uB97C \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350454
    m_Localized: "\uD30C\uD3B8 \uAE30\uC5B5"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350455
    m_Localized: "\uD328\uC2DC\uBE0C. \uC801\uC744 \uCC98\uCE58\uD558\uBA74 2.5\uCD08\uAC04
      \uB0A8\uC740 \uC801\uB4E4\uC758 \uBE48\uD2C8\uC774 \uB4DC\uB7EC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350456
    m_Localized: "\uC120\uACE0\uC758 \uCE7C\uB05D"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350457
    m_Localized: "\uD328\uC2DC\uBE0C. \uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uC5D0\uB108\uC9C0
      20\uC744 \uC5BB\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350458
    m_Localized: "\uBB34\uD608\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350459
    m_Localized: "\uD328\uC2DC\uBE0C. \uC801\uC744 \uCC98\uCE58\uD558\uBA74 2.5\uCD08\uAC04
      \uBC1B\uB294 \uD53C\uD574\uAC00 \uC904\uC5B4\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350460
    m_Localized: "\uACF5\uBA85 \uBC18\uD5A5"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350461
    m_Localized: "\uC9D1\uC911 \uACF5\uBA85\uD30C\uB85C marked \uB300\uC0C1\uC744
      silence\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350462
    m_Localized: "\uAE30\uC5B5 \uC870\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350463
    m_Localized: "\uBD80\uC0C1\uB2F9\uD55C \uC544\uAD70\uC758 \uAE30\uC5B5 \uD328\uD134\uC744
      \uC870\uC728\uD574 \uD68C\uBCF5\uC2DC\uD0A4\uACE0 \uC791\uC740 barrier\uB97C
      \uB354\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350464
    m_Localized: "\uC704\uC0C1 \uACB0\uBC15"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350465
    m_Localized: "\uB178\uCD9C\uB41C \uC801\uC744 \uC704\uC0C1 \uC7A1\uC74C\uC5D0
      \uBB36\uC5B4 root\uC640 slow\uB97C \uAC74\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350466
    m_Localized: "\uBC18\uD5A5 \uAE30\uB85D\uACE0"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350467
    m_Localized: "\uD328\uC2DC\uBE0C. \uC790\uC2E0\uC758 \uC561\uD2F0\uBE0C\uAC00
      \uBD80\uC5EC\uD558\uB294 \uC0C1\uD0DC\uC774\uC0C1\uC774 30% \uC624\uB798 \uC9C0\uC18D\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350468
    m_Localized: "\uACA9\uC790 \uCCAD\uCDE8\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350469
    m_Localized: "\uD328\uC2DC\uBE0C. \uC804\uD22C \uC2DC\uC791 \uC2DC 3\uCD08\uAC04
      \uC801 \uC804\uCCB4\uAC00 \uB290\uB824\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350470
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uBC1C\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350471
    m_Localized: "\uD328\uC2DC\uBE0C. \uC804\uD22C\uB2F9 \uD55C \uBC88 \uC4F0\uB7EC\uC9C0\uB294
      \uC544\uAD70\uC774 \uC9E7\uC740 silence \uD30C\uB3D9\uC744 \uB0A8\uAE38 \uC218
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350472
    m_Localized: "\uACF5\uBA85 \uC815\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 335601013350473
    m_Localized: "\uC11C\uD3EC\uD2B8 \uC99D\uAC15. cleanse \uACC4\uC5F4 \uD6A8\uACFC\uAC00
      \uC9E7\uC740 unstoppable \uD30C\uB3D9\uB3C4 \uBD80\uC5EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
