      m_Items: []
  - m_Id: 19023179963240448
    m_Localized: "\uC9D0\uAC00\uBC29 \uC548\uCABD\uC5D0 \uC0AC\uC81C \uC778\uC7A5\uC774
      \uD480\uB9B0 \uCC44 \uB4E4\uC5B4 \uC788\uB2E4. \uCC45\uC0C1 \uC704\uC5D0 \uB450\uACE0
      \uC654\uB358 \uC790\uB9AC\uC5D0\uC11C \uC7BF\uACE8 \uD55C\uC0C8\uAC00 \uD55C
      \uBC88 \uB354 \uC62E\uACA8 \uC640 \uC9D0\uC5D0 \uB123\uC5B4 \uC92C\uB2E4. \"\uAC70\uAE30
      \uAC00\uC11C \uB450\uACE0 \uC640\uC694. \uCC45\uC0C1\uBCF4\uB2E4 \uBCF8 \uB300\uC131\uB2F9\uC774
      \uC778\uC7A5\uC758 \uC790\uB9AC\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240449
    m_Localized: "...\uADF8\uBD84\uC758 \uC74C\uC131\uC774 \uB4E4\uB9AC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uADF8\uB7EC\uB098 \uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uC790\uB3C4 \uC774 \uBB38
      \uC55E\uC5D0 \uC124 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240450
    m_Localized: "\uB2E8\uB9B0\uC774 \uBB38\uD131\uC744 \uB118\uB294\uB2E4. \uBC31\uAE08
      \uC789\uD06C\uC758 \uC785\uD68C \uBB38\uC7A5\uC774 \uC704\uC5D0\uC11C \uD55C
      \uBC88 \uAE38\uAC8C \uBE44\uCD98\uB2E4. \uC9D0\uAC00\uBC29\uC758 \uB048\uC774
      \uD55C \uBC88 \uB354 \uB2E8\uB2E8\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240451
    m_Localized: "\uC911\uC559 \uBB38\uC11C\uACE0. \uBC31\uAE08 \uC789\uD06C \uD45C\uC9C0\uC758
      \uC0AC\uBCF8\uB4E4\uC774 \uC120\uBC18\uC5D0 \uC904\uC9C0\uC5B4 \uC788\uB2E4.
      \uC0AC\uC11C \uD55C \uBA85\uC774 \uB2E8\uB9B0\uC758 \uBCF4\uACE0 \uC790\uB8CC\uC5D0
      \uC0AC\uBCF8 \uBC88\uD638\uB97C \uB9E4\uAE30\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240452
    m_Localized: "\uCC45\uC0C1 \uC704\uC5D0 \uC138 \uAC00\uC9C0\uAC00 \uCC28\uB840\uB85C
      \uB193\uC778\uB2E4. \uBCC0\uBC29 \uC218\uBE44\uB300 \uBA85\uBD80 \uC0AC\uBCF8
      \u2014 \u300C\uACE0\uC9C4\u300D \uC774\uB984 \uC606\uC5D0 \uC605\uC740 \uBBF8\uC815\uB9AC
      \uD45C\uC2DD\uC774 \uADF8\uB300\uB85C \uB0A8\uC544 \uC788\uB2E4. \uB2E8\uD604
      \uC77C\uC9C0 \uC0AC\uBCF8 \u2014 \uD45C\uC9C0 \uC548\uCABD\uC5D0 \uAC19\uC740
      \uC591\uC2DD\uC758 \uC0AC\uBCF8 \uBC88\uD638. \uBC31\uADDC\uC758 \uBA85\uB839\uC11C
      \uC0AC\uBCF8 \u2014 \uACB0\uC7AC\uB780\uC774 \uBCF8 \uB300\uC131\uB2F9 \uD615\uC2DD."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240453
    m_Localized: "...\uC138 \uC790\uB9AC\uC5D0\uC11C \uAC19\uC740 \uD615\uC2DD\uC774
      \uBCF4\uC785\uB2C8\uB2E4. \uBCC0\uBC29 \uC218\uBE44\uB300 \uBA85\uBD80\uC5D0
      \uBBF8\uC815\uB9AC\uB85C \uB0A8\uC740 \uC774\uB984. \uB2E8\uD604 \uC77C\uC9C0\uAC00
      \uC0AC\uBCF8\uC73C\uB85C \uB3C4\uB294 \uD750\uB984. \uBC31\uADDC\uC758 \uACB0\uC7AC\uB780.
      \uAC19\uC740 \uCC45\uC0C1 \uC704\uC5D0 \uB193\uACE0 \uBCF4\uB2C8, \uD55C \uC0AC\uB78C\uC758
      \uC190\uC774 \uB9CC\uB4E0 \uC2DC\uC2A4\uD15C\uC774 \uC544\uB2C8\uB77C\uB294
      \uAC8C \uBCF4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240454
    m_Localized: "...\uC0AC\uC81C\uB2D8. \uC774 \uBBF8\uC815\uB9AC \uD45C\uC2DD\uC740
      80\uB144 \uB3D9\uC548 \uADF8\uB300\uB85C\uC600\uC2B5\uB2C8\uB2E4. \uD55C \uBC88\uB3C4
      \uC815\uB9AC\uD558\uB77C\uB294 \uBA85\uB839\uC774 \uC5C6\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240455
    m_Localized: "\uADF8\uAC8C \uC815\uB9AC \uBA85\uB839\uC774 \uC5C6\uC5C8\uB358
      \uAC8C \uC544\uB2C8\uB77C, \uC815\uB9AC\uD558\uBA74 \uC548 \uB418\uB294 \uD45C\uC2DD\uC774\uC5C8\uC744
      \uAC81\uB2C8\uB2E4. \uC774\uB984\uC744 \uC9C0\uC6B0\uC9C0 \uC54A\uC740 \uCC44
      \uC78A\uC73C\uB77C\uB294 \uD45C\uC2DD. \uB204\uAC00 \uADF8\uB807\uAC8C \uACB0\uC815\uD588\uB294\uC9C0
      \u2014 \uADF8 \uACB0\uC815\uC774 \uC5B4\uB514 \uC801\uD600 \uC788\uB294\uC9C0\uBD80\uD130
      \uCC3E\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240456
    m_Localized: "\uC0AC\uC11C\uAC00 \uC9E7\uAC8C \uB044\uB355\uC778\uB2E4. \uB2E8\uB9B0\uC758
      \uC190\uC774 \uC0AC\uBCF8 \uBC88\uD638\uC5D0 \uD55C \uBC88 \uBA38\uBB38\uB2E4.
      \uC5B4\uBA38\uB2C8\uAC00 \uB9C8\uC9C0\uB9C9\uC5D0 \uC9DA\uC73C\uC168\uB358
      \uC790\uC218\uC758 \uBC31\uAE08\uACFC \uAC19\uC740 \uC0C9."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240457
    m_Localized: "\uBCF8 \uB300\uC131\uB2F9 \uB300\uAE30\uC2E4. \uC758\uC790 \uB450
      \uC904. \uB2E8\uB9B0\uC774 \uC67C\uCABD \uB05D\uC5D0 \uC549\uC544 \uC788\uB2E4.
      \uC120\uC601\uC774 \uD55C \uBC1C \uB2A6\uAC8C \uB4E4\uC5B4\uC640 \uAC19\uC740
      \uC904 \uB2E4\uB978 \uB05D\uC5D0 \uC549\uB294\uB2E4. \uC0AC\uC81C\uBCF5\uC740
      \uADF8\uB300\uB85C\uC9C0\uB9CC \uC778\uC7A5\uC740 \uD480\uB824 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240458
    m_Localized: "...\uC790\uB9E4\uC5EC. \uC815\uC2DD \uC790\uB9AC\uB97C \uBABB \uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240459
    m_Localized: "\uC555\uB2C8\uB2E4. \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240460
    m_Localized: "\uCC98\uC74C\uC73C\uB85C \uBB3B\uC2B5\uB2C8\uB2E4. \uADF8\uBD84\uC758
      \uC74C\uC131\uC774 \uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uC0AC\uB78C\uB3C4 \u2014
      \uBB3B\uB294 \uC77C\uC740 \uD560 \uC218 \uC788\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240461
    m_Localized: "\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uAC8C \uC0AC\uC81C\uAC00
      \uC544\uB2C8\uC5B4\uB3C4 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240462
    m_Localized: "\uC120\uC601\uC774 \uC190\uC744 \uBB34\uB98E \uC704\uC5D0 \uB454\uB2E4.
      \uBB34\uB98E \uC704\uC5D0 \uC0AC\uC81C \uC778\uC7A5\uC774 \uC5C6\uB2E4. \uCC45\uC0C1
      \uC704\uC5D0 \uB450\uACE0 \uC628 \uC9C0 \uD55C \uB2EC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240463
    m_Localized: "\uC790\uB9E4\uC5EC, \uB2F5\uC744 \uB0B4\uB824\uB193\uACE0 \uB530\uB77C\uC624\uB77C
      \uD558\uC168\uC9C0\uC694. \uB2F5\uC774 \uBB34\uC5C7\uC774\uC5C8\uB294\uC9C0\uB3C4
      \u2014 \uC774\uC81C\uB294 \uC798 \uBAA8\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240464
    m_Localized: "\uADF8\uB7EC\uBA74 \uAC19\uC774 \uBAA8\uB974\uBA74\uC11C \uBB3B\uACA0\uC2B5\uB2C8\uB2E4.
      \uD55C \uC904\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240465
    m_Localized: "\uB450 \uC0AC\uB78C \uC0AC\uC774\uC5D0 \uCE68\uBB35\uC774 \uAE38\uAC8C
      \uBA38\uBB38\uB2E4. \uC120\uC601\uC758 \uC785\uAC00\uAC00 \uD55C \uBC88 \uB5A8\uB9B0\uB2E4.
      \uB5A8\uB9BC\uC774 \uBBF8\uC18C\uB85C \uAC00\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB7EC\uB098
      \uB2F5\uC744 \uC678\uC6B0\uC9C0 \uC54A\uC740 \uC785\uAC00\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240466
    m_Localized: "\uC791\uC740 \uCC45\uC0C1. \uBD09\uC778\uB41C \uD3B8\uC9C0 \uD55C
      \uD1B5. \uC778\uC7A5\uC740 \uD559\uC790\uC7A5 \uAC83\uC774 \uC544\uB2C8\uB2E4.
      \uBC31\uADDC \uBCF8\uC778\uC758 \uC61B \uD559\uC790 \uC778\uC7A5 \u2014 \uD559\uC124\uC744
      \uCC98\uC74C \uB4F1\uC7AC\uD560 \uB54C \uBC1B\uC740 \uC790\uAD6D. \uD559\uC790\uC7A5\uC774
      \uB418\uAE30 \uC804\uC758 \uC774\uB984\uC774 \uD568\uAED8 \uC801\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240467
    m_Localized: "\uB2E8\uB9B0\uC774 \uD3B8\uC9C0\uB97C \uC5F0\uB2E4. \uC885\uC774\uAC00
      \uD55C \uBC88 \uB5A8\uB9B0\uB2E4. \uBC31\uADDC\uC758 \uC190\uAE00\uC528. \uD3C9\uC18C\uC758
      \uD589\uC815 \uC11C\uC2DD\uC774 \uC544\uB2C8\uB2E4 \u2014 \uD559\uC790\uC758
      \uC9C1\uC811 \uAE00."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240468
    m_Localized: "\uC0AC\uC81C \uB2E8\uB9B0. \uADF8\uB300\uC758 \uBCF4\uACE0\uC11C\uAC00
      \uC911\uC559 \uBB38\uC11C\uACE0\uC5D0 \uB4E4\uC5B4\uC654\uB2E4\uB294 \uC18C\uC2DD\uC744
      \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uD559\uD30C\uC758 \uD6C4\uC18D \uD559\uC790\uB85C\uC11C
      \uD55C \uAC00\uC9C0\uB97C \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240469
    m_Localized: "\uB2E8\uD604 \uD559\uC790\uC7A5\uC758 \uB9C8\uC9C0\uB9C9 \uBD80\uD0C1
      \u2014 '\uC774 \uD559\uC124\uC744 \uC5B4\uB5BB\uAC8C \uC0AC\uC6A9\uD560\uC9C0\uB97C
      \uB2E4\uC2DC \uC0DD\uAC01\uD558\uB77C' \u2014 \uC744 \uADF8\uB300\uB294 \uB3C4\uC2DC
      \uC548\uC5D0\uC11C \uC778\uC6A9\uD588\uC2B5\uB2C8\uB2E4. \uADF8 \uBB38\uC7A5\uC774
      \uD559\uD30C \uC678\uBD80\uC5D0\uC11C \uC778\uC6A9\uB420 \uB54C\uB9C8\uB2E4
      \uD559\uC124 \uC790\uCCB4\uC758 \uC758\uB3C4\uAC00 \uB354 \uBE68\uB9AC \uBD80\uC11C\uC9D1\uB2C8\uB2E4.
      \uC778\uC6A9\uC744 \uBCF4\uACE0\uC11C \uBCF8\uBB38\uC5D0\uC11C \uBE7C \uC8FC\uC2DC\uAE30\uB97C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240470
    m_Localized: "...\uD559\uC124\uC758 \uC758\uB3C4\uB97C \uAC00\uC7A5 \uBE68\uB9AC
      \uBD80\uC21C \uBD84\uC774 \uD559\uC124\uC758 \uB9C8\uC9C0\uB9C9 \uBD80\uD0C1\uC744
      \uBCF4\uD638\uD574 \uB2EC\uB77C\uACE0 \uD558\uC2DC\uB294\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240471
    m_Localized: "\uB2E8\uB9B0\uC774 \uD3B8\uC9C0\uB97C \uCC45\uC0C1 \uC704\uC5D0
      \uB454\uB2E4. \uB2F5\uC7A5\uC740 \uC4F0\uC9C0 \uC54A\uB294\uB2E4. \uBCF4\uACE0\uC11C\uC758
      \uB2E8\uD604 \uC778\uC6A9 line\uC5D0\uB294 \uBE68\uAC04 \uD45C\uC2DC\uB97C
      \uD55C \uBC88 \uB354 \uD55C\uB2E4 \u2014 \uBE7C\uC9C0 \uC54A\uACA0\uB2E4\uB294
      \uD45C\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240472
    m_Localized: "...\uD559\uC124\uC758 \uD6C4\uC18D \uD559\uC790\uAC00 \uD559\uC124\uC744
      \uBCF4\uD638\uD558\uACE0 \uC2F6\uB2E4\uBA74, \uADF8 \uC778\uC6A9\uC744 \uBE7C\uB294
      \uAC8C \uC544\uB2C8\uB77C \uADF8 \uC778\uC6A9\uC5D0 \uBD80\uD0C1\uB41C \uCC45\uC784\uC744
      \uC9C1\uC811 \uBC1B\uC73C\uC154\uC57C \uD569\uB2C8\uB2E4. \uADF8\uAC83\uC744
      \uD559\uC790\uC7A5 \uC778\uC7A5 \uC606\uC5D0 \uC801\uC5B4 \uBCF4\uB0B4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240473
    m_Localized: "\uC9D1\uC815\uAD00 \uD68C\uC758\uC2E4. \uAE34 \uD0C1\uC790. \uB2E8\uB9B0\uC774
      \uD55C \uB05D\uC5D0 \uC11C \uC788\uB2E4. \uD68C\uC758\uCCB4\uC758 \uC758\uC790
      \uC77C\uACF1 \uC790\uB9AC. \uADF8\uC911 \uD55C \uC790\uB9AC\uB294 \uBE44\uC5B4
      \uC788\uB2E4 \u2014 \uBC31\uADDC \uD559\uC790\uC7A5\uC774 \uBE44\uC6B4 \uC790\uB9AC.
      \uD559\uC124 \uD6C4\uC18D \uD559\uC790\uAC00 \uC544\uC9C1 \uCD94\uB300\uB418\uC9C0
      \uC54A\uC740 \uC0C1\uD0DC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240474
    m_Localized: "\uC0AC\uC81C \uB2E8\uB9B0. \uBCC0\uBC29 \uD611\uACE1 \uC0AC\uAC74\uC758
      \uBCF4\uACE0\uC11C\uB97C \uBC1B\uC558\uC2B5\uB2C8\uB2E4. \uBCF8 \uB300\uC131\uB2F9
      \uC815\uC2DD \uC785\uD68C \uC0AC\uC81C\uB85C\uC11C, \uCCAB \uB3C4\uC2DC \uD559\uC0B4
      \uAE30\uB85D\uC758 \uBCF8 \uB300\uC131\uB2F9 \uBD80\uBCF8 \uBCF4\uC874\uC744
      \uC5B4\uB5BB\uAC8C \uCC45\uC784\uC9C0\uC2DC\uACA0\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240475
    m_Localized: "\uC6D0\uBB38\uC740 \uD68C\uC0C1 \uACB0\uC0AC \uBA85\uC74C \uAE30\uB85D\uAD00\uC5D0
      \uBCF4\uC874\uB429\uB2C8\uB2E4. \uBCF8 \uB300\uC131\uB2F9 \uBD80\uBCF8\uC740
      \u2014 \uD559\uC124 \uBB34\uAE30\uD654\uC758 \uAC00\uB2A5\uC131\uC744 \uB9C9\uAE30
      \uC704\uD574, \uBB38\uBC16 \uC99D\uC5B8\uC790 \uACF5\uD55C\uC758 \uBD80\uBCF8\uACFC
      \uD55C \uBB36\uC74C\uC73C\uB85C \uBCF4\uAD00\uB429\uB2C8\uB2E4. \uBCF8 \uB300\uC131\uB2F9\uC774
      \uB2E8\uB3C5\uC73C\uB85C \uBCF4\uAD00\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uADF8\uAC83\uC774 \uB2E8\uD604 \uD559\uC790\uC7A5\uC758 \uB9C8\uC9C0\uB9C9
      \uBD80\uD0C1\uC744 \u2014 \uCC98\uC74C\uC73C\uB85C \uC9C1\uC811 \uC778\uC6A9\uD55C
      \uD615\uC2DD\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240476
    m_Localized: "...\uBCF8 \uB300\uC131\uB2F9\uC774 \uB2E8\uB3C5 \uBCF4\uAD00\uD558\uC9C0
      \uC54A\uB294\uB2E4\uB294 \uD615\uC2DD\uC740 \u2014 \uBCF8 \uB300\uC131\uB2F9
      \uC815\uC2DD \uC591\uC2DD\uC5D0 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240477
    m_Localized: "\uC591\uC2DD\uC5D0 \uC5C6\uC73C\uBA74 \uB9CC\uB4E4\uACA0\uC2B5\uB2C8\uB2E4.
      \uC591\uC2DD\uC774 \uC0AC\uB78C\uC744 \uC0B4\uB9AC\uB824\uACE0 \uC0DD\uAE34
      \uAC83\uC774\uB77C\uBA74, \uC5C6\uB294 \uC591\uC2DD\uB3C4 \uB9CC\uB4E4 \uC218
      \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240478
    m_Localized: "\uD68C\uC758\uCCB4\uC758 \uD55C \uC758\uC790\uAC00 \uC9E7\uAC8C
      \uD754\uB4E4\uB9B0\uB2E4. \uBE44\uC5B4 \uC788\uB294 \uD559\uC790\uC7A5 \uC790\uB9AC
      \uC606 \uC758\uC790. \uADF8 \uC790\uB9AC\uC5D0 \uC549\uC740 \uC9D1\uC815\uAD00\uC774
      \uAC00\uC7A5 \uBA3C\uC800 \uB044\uB355\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240479
    m_Localized: "\uAE30\uB85D. \uBCF8 \uB300\uC131\uB2F9 \uBD80\uBCF8 + \uC678\uBD80
      \uC99D\uC5B8 \uBD80\uBCF8. \uBB36\uC74C \uBCF4\uAD00. \uB2E8\uB9B0 \uC0AC\uC81C\uAC00
      \uBD80\uBCF8\uC758 \uC815\uD569\uC131\uC744 \uCC45\uC784\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240480
    m_Localized: "...\uC0AC\uC81C \uC790\uACA9\uC73C\uB85C\uB294 \uBC1B\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240481
    m_Localized: "...\uADF8\uB7FC \uBB34\uC5C7\uC73C\uB85C \uBC1B\uACA0\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240482
    m_Localized: "\uD55C \uC0AC\uB78C\uC73C\uB85C \uBC1B\uACA0\uC2B5\uB2C8\uB2E4.
      \uC0AC\uC81C \uC778\uC7A5\uC740 \uC624\uB298 \uC774 \uD68C\uC758\uC2E4\uC5D0\uC11C
      \uBC18\uB0A9\uD569\uB2C8\uB2E4. \uCC45\uC784\uC744 \uC778\uC7A5\uC73C\uB85C
      \uBC1B\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4 \u2014 \uC774\uB984\uC73C\uB85C \uBC1B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240483
    m_Localized: "\uB2E8\uB9B0\uC774 \uC9D0\uAC00\uBC29\uC5D0\uC11C \uC0AC\uC81C
      \uC778\uC7A5\uC744 \uAEBC\uB0B8\uB2E4. \uD480\uB9B0 \uCC44\uB85C. \uD68C\uC758
      \uD0C1\uC790 \uD55C\uAC00\uC6B4\uB370\uC5D0 \uB454\uB2E4. \uC790\uC218\uC758
      \uBC31\uAE08\uACFC \uC778\uC7A5 \uB05D\uC758 \uBC31\uAE08\uC774 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uAC19\uC740 \uBE5B\uC73C\uB85C \uB9CC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240484
    m_Localized: "...\uBC1B\uC2B5\uB2C8\uB2E4. \uC790\uACA9 \uBC18\uB0A9. \uCC45\uC784\uC740
      \uC774\uB984\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240485
    m_Localized: "\uD68C\uC758\uCCB4 \uC77C\uACF1 \uC758\uC790 \uC911 \uBE44\uC5B4
      \uC788\uB294 \uD559\uC790\uC7A5 \uC790\uB9AC \uC606\uC5D0\uC11C \uD55C \uBA85\uC758
      \uC9D1\uC815\uAD00\uC774 \uCC98\uC74C\uC73C\uB85C \uB2E8\uB9B0\uC5D0\uAC8C
      \uC815\uBA74\uC73C\uB85C \uC2DC\uC120\uC744 \uB454\uB2E4. \uB2F5\uC744 \uC678\uC6B0\uC9C0
      \uC54A\uC740 \uC2DC\uC120."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240486
    m_Localized: "\uD68C\uB791. \uCC3D\uBB38 \uB108\uBA38 \uD669\uD63C. \uB2E8\uB9B0\uC774
      \uC778\uC7A5 \uC5C6\uB294 \uC190\uC73C\uB85C \uD68C\uB791 \uB05D\uC744 \uD5A5\uD574
      \uAC77\uB294\uB2E4. \uC120\uC601\uC774 \uD55C \uBC1C \uB2A6\uAC8C \uB530\uB77C\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240487
    m_Localized: "...\uC790\uB9E4\uC5EC. \uB2F5\uC744 \uB0B4\uB824\uB193\uACE0 \uB530\uB77C\uAC00\uB3C4
      \uB429\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240488
    m_Localized: "\uB0B4\uB824\uB193\uACE0 \uC624\uC138\uC694. \uB2E4\uB9CC \u2014
      \uB0B4\uB824\uB193\uC740 \uC790\uB9AC\uB294 \uBCF8\uC778\uC774 \uD45C\uC2DC\uD574
      \uB450\uC138\uC694. \uB204\uAC00 \uD45C\uC2DC\uD574 \uC8FC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240489
    m_Localized: "...\uC5B4\uB290 \uC790\uB9AC\uC5D0 \uD45C\uC2DC\uD558\uC9C0\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240490
    m_Localized: "\uC5B4\uBA38\uB2C8\uAC00 \uAC00\uB974\uCE58\uC2E0 \uCCAB \uAE30\uB3C4\uC758
      \uC790\uB9AC\uC5D0. \uADF8 \uC790\uB9AC \uC606\uC5D0. \uC678\uC6B0\uC9C0 \uC54A\uC740
      \uC790\uB9AC\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240491
    m_Localized: "\uC120\uC601\uC774 \uC9E7\uAC8C \uB044\uB355\uC778\uB2E4. \uC785\uAC00\uAC00
      \uD55C \uBC88 \uB5A8\uB9B0\uB2E4. \uBBF8\uC18C\uB85C \uAC00\uC9C0 \uC54A\uB294\uB2E4.
      \uADF8\uB7EC\uB098 \uB2F5\uC744 \uC678\uC6B0\uC9C0 \uC54A\uC740 \uC785\uAC00\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240492
    m_Localized: "...\uAC19\uC774 \uBB3B\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240493
    m_Localized: "\uB450 \uC0AC\uB78C\uC758 \uBC1C\uC790\uAD6D\uC774 \uD68C\uB791
      \uB05D\uAE4C\uC9C0 \uAC19\uC740 \uBC15\uC790\uB85C \uAC04\uB2E4. \uC778\uC7A5
      \uC5C6\uB294 \uC190\uACFC \uC778\uC7A5 \uC5C6\uB294 \uC190. \uC0AC\uC81C\uBCF5
      \uB450 \uBC8C\uC774 \uD669\uD63C \uBE5B\uC5D0 \uAC19\uC740 \uC790\uC218\uC758
      \uBC31\uAE08\uC744 \uD55C \uBC88 \uBE44\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240494
    m_Localized: "\uBCF8 \uB300\uC131\uB2F9\uC758 \uC678\uBB38. \uC785\uD68C \uBB38\uC7A5\uC774
      \uC704\uC5D0\uC11C \uBE44\uCD98\uB2E4. \uB2E8\uB9B0\uC774 \uADF8 \uC544\uB798\uB97C
      \uC9C0\uB09C\uB2E4. \uC9D0\uAC00\uBC29\uC774 \uD55C\uACB0 \uAC00\uBCCD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240495
    m_Localized: "\uAE30\uB3C4\uAC00 \uC870\uC6A9\uD574\uC9C4 \uB4A4\uC5D0\uB3C4,
      \uBB3B\uB294 \uC77C\uC740 \uB0A8\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240496
    m_Localized: "\uBC31\uAE08 \uC789\uD06C\uC758 \uC785\uD68C \uBB38\uC7A5\uC774
      \uB2E8\uB9B0\uC758 \uB4F1 \uB4A4\uC5D0\uC11C \uD55C \uBC88 \uB354 \uBE44\uCD98\uB2E4.
      \uB2E8\uB9B0\uC774 \uB4A4\uB3CC\uC544\uBCF4\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240497
    m_Localized: "\uC7BF\uACE8\uB85C \uAC00\uB294 \uAE38. \uAE38\uC774 \uD3C9\uC18C\uBCF4\uB2E4
      \uC9E7\uAC8C \uBCF4\uC778\uB2E4. \uC778\uC7A5\uC774 \uC5C6\uB294 \uC190\uC774
      \uAE38\uC758 \uB05D\uC5D0\uC11C \uD55C \uBC88 \uC190\uAC00\uB77D\uC744 \uD3B4
      \uBCF8\uB2E4. \uB5A8\uB9AC\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB798\uC11C \u2014
      \uD55C \uBC88 \uB354 \uBCF8\uB2E4. \uD3C9\uC18C \uB2E8\uB9B0\uC774 \uC548 \uD558\uB358
      \uB3D9\uC791\uC774\uB2E4. \uC5B4\uB514\uC11C \uBC30\uC6E0\uB294\uC9C0, \uBCF8\uC778\uB3C4
      \uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240498
    m_Localized: "\uC7BF\uACE8 \uD68C\uC758\uC2E4. \uD0C1\uC790 \uB458\uB808\uC758
      \uB124 \uC758\uC790. \uADF8\uC911 \uB458\uC740 \uC5EC\uC804\uD788 \uBE44\uC5B4
      \uC788\uB2E4. \uADF8\uB7F0\uB370 \uD68C\uC870 \uCABD\uC758 \uBE44\uC5B4 \uC788\uB294
      \uC758\uC790\uC5D0 \u2014 \uAC80\uC740 \uD1A0\uD15C \uB048 \uD55C \uC904\uC774
      \uBB36\uC5EC \uC788\uB2E4. \uC870\uAE08 \uC804\uC5D0\uB294 \uC5C6\uC5C8\uB358
      \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240499
    m_Localized: "\uD55C\uC0C8\uAC00 \uD68C\uC758\uC2E4 \uC785\uAD6C\uC5D0\uC11C
      \uC7A0\uAE50 \uBA48\uCD98\uB2E4. \uB048\uC758 \uC0C9\uC744 \uBCF8\uB2E4. \uD1A0\uD15C
      \uB048\uC758 \uAC80\uC740 \uC0C9\uC740 \uC774\uB9AC\uC194 \uBD84\uB9AC\uD30C
      \uD45C\uC9C0 \u2014 \uADF8\uB7EC\uB098 \uB048\uC758 \uACB0\uC18D \uBC29\uD5A5\uC774
      \uC2DC\uACC4\uBC29\uD5A5\uC774\uB2E4. \uBD84\uB9AC\uD30C\uB294 \uBC18\uB300\uBC29\uD5A5\uC73C\uB85C
      \uBB36\uB294\uB2E4. \uC2DC\uACC4\uBC29\uD5A5\uC740 \uBB34\uB9AC\uC758 \uB9E4\uB4ED\uBC95."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240500
    m_Localized: "...\uBD84\uB9AC\uD30C \uC0C9\uC5D0 \uBB34\uB9AC \uB9E4\uB4ED. \uB204\uAC00
      \uBCF4\uB0C8\uB294\uC9C0\uB294 \uC54C\uACA0\uB294\uB370, \uC5B4\uB290 \uCABD\uC5D0\uC11C
      \uBCF4\uB0C8\uB294\uC9C0\uAC00 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240501
    m_Localized: "\uD68C\uC758\uC2E4 \uC606 \uCC9C\uB9C9 \uC785\uAD6C\uC5D0 \uC774\uBE68\uBC14\uB78C\uC774
      \uBA48\uCDB0 \uC120\uB2E4. \uD1A0\uD15C \uBCF4\uD638\uB300\uC758 \uAC80\uC740
      \uCE60\uC774 \uBAA8\uB2E5\uBD88 \uBE5B \uC544\uB798\uC5D0\uC11C \uD55C \uBC88
      \uD750\uB824\uC84C\uB2E4 \uB2E4\uC2DC \uB610\uB837\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240502
    m_Localized: "...\uD615\uC81C\uAC00 \uBCF4\uB0B8 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240503
    m_Localized: "\uC7BF\uACE8 \uC0AC\uB0E5\uAFBC \uAE38\uB4DC \uAC70\uC810. \uC5F0\uC8FC\uAC00
      \uBB34\uB98E \uC606\uC5D0 \uC2E0\uBC1C \uB450 \uCF24\uB808\uB97C \uB450\uACE0
      \uC788\uB2E4. \uBB34\uB9AC \uCABD \uC0AC\uB0E5\uAFBC \uBD80\uCE20\uC640 \uC7BF\uACE8
      \uC815\uCC30\uBCD1 \uBD80\uCE20. \uD55C \uCF24\uB808\uC529 \uB2E4\uB978 \uBC1C\uC5D0
      \uC2E0\uC5B4 \uBCF4\uACE0 \uC788\uB2E4. \uB450 \uBC1C\uC790\uAD6D\uC774 \uD55C
      \uC790\uB9AC\uC5D0\uC11C \uB9CC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240504
    m_Localized: "...\uC5F0\uC8FC. \uD68C\uC870\uAC00 \uC2E0\uD638\uB97C \uBCF4\uB0C8\uC5B4.
      \uC9C1\uC811 \uB9CC\uB098\uB7EC \uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240505
    m_Localized: "...\uAC19\uC774 \uAC00\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240506
    m_Localized: "\uC544\uB2C8. \uB108\uB294 \uAC19\uC774 \uBABB \uAC00. \uB124 \uBC1C\uC790\uAD6D\uC740
      \uB124\uAC00 \uC120 \uC790\uB9AC\uC5D0\uC11C \uC2DC\uC791\uD574\uC57C \uD574.
      \uD615\uC81C \uC0AC\uC774\uC5D0 \uB07C\uBA74, \uB124 \uAC78\uC74C\uC774 \uB0A8\uC9C0
      \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240507
    m_Localized: "...\uADF8\uB7FC \uC800\uB294 \uC5B4\uB290 \uCABD \uBD80\uCE20\uB97C
      \uC2E0\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240508
    m_Localized: "\uC624\uB298\uC740 \uB450 \uCF24\uB808 \uB2E4 \uC2E0\uC5B4. \uD55C
      \uBC1C\uC5D0 \uBB34\uB9AC \uBD80\uCE20, \uD55C \uBC1C\uC5D0 \uC815\uCC30\uBCD1
      \uBD80\uCE20. \uC5B4\uB290 \uCABD\uC774 \uBA3C\uC800 \uB2F3\uB294\uC9C0 \uBD10.
      \uADF8\uAC8C \uB2F5\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240509
    m_Localized: "\uC5F0\uC8FC\uAC00 \uC9E7\uAC8C \uB044\uB355\uC778\uB2E4. \uD55C
      \uBC1C\uC5D0 \uBB34\uB9AC \uBD80\uCE20\uB97C \uC2E0\uACE0, \uB2E4\uB978 \uBC1C\uC5D0
      \uC815\uCC30\uBCD1 \uBD80\uCE20\uB97C \uC2E0\uB294\uB2E4. \uB450 \uBC1C\uC774
      \uAC19\uC740 \uC790\uB9AC\uC5D0 \uC11C \uC788\uC9C0\uB9CC \uAC78\uC74C\uC774
      \uC0B4\uC9DD \uC5B4\uAE0B\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240510
    m_Localized: "...\uBB34\uB9AC \uBD80\uCE20\uAC00 \uB354 \uBB34\uAC70\uC6CC\uC694.
      \uC815\uCC30\uBCD1 \uBD80\uCE20\uB294 \uAC00\uBCBC\uC6CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240511
    m_Localized: "\uB458 \uB2E4 \uC633\uC740 \uB2F5\uC774\uC57C. \uBB34\uAC70\uC6B4
      \uAC8C \uC88B\uC544\uC11C \uBB34\uB9AC\uB85C \uAC00\uB294 \uC790\uAC00 \uC788\uACE0,
      \uAC00\uBCBC\uC6B4 \uAC8C \uC88B\uC544\uC11C \uC815\uCC30\uBCD1\uC73C\uB85C
      \uAC00\uB294 \uC790\uB3C4 \uC788\uC5B4. \uB2F5\uC740 \uB354 \uB2A6\uAC8C \uC640\uB3C4
      \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240512
    m_Localized: "...\uC624\uB298\uC740 \uB450 \uCF24\uB808\uB85C \uAC08\uAC8C\uC694.
      \uB2F5\uC774 \uB2F3\uC744 \uB54C\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240513
    m_Localized: "\uC5F0\uC8FC\uAC00 \uB450 \uCF24\uB808\uB85C \uBC1C\uC790\uAD6D
      \uD55C \uAC1C\uB97C \uC62E\uAE34\uB2E4. \uC5B4\uB290 \uD55C \uBD80\uCE20\uB3C4
      \uBA3C\uC800 \uB2F3\uC9C0 \uC54A\uB294\uB2E4. \uB2F5\uC740 \uC808\uBC18\uB9CC
      \uD45C\uC2DC\uB41C \uCC44\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240514
    m_Localized: "\uBCC0\uACBD \uD611\uACE1 \uC606. \uB3CC\uBB34\uB354\uAE30 \uAC00\uC7A5
      \uC717\uC790\uB9AC. \uD68C\uC870\uAC00 \uC549\uC544 \uC788\uB2E4. \uC190\uC5D0
      \uC791\uC740 \uB3CC \uB124 \uAC1C. \uC190\uBAA9 \uD749\uD130\uB294 \uC637\uC136
      \uC548\uC5D0 \uC228\uACA8\uC838 \uC788\uB2E4. \uC606\uC5D0 \uB2E4\uB978 \uBC1C\uC790\uAD6D\uC774
      \uD55C \uAC1C \uC788\uB2E4 \u2014 \uB204\uAD70\uAC00 \uD68C\uC870\uB97C \uC5EC\uAE30\uAE4C\uC9C0
      \uB370\uB824\uC640 \uB450\uACE0 \uB5A0\uB09C \uD754\uC801. \uCCA0\uD53C \uAC15\uACBD\uD30C\uC758
      \uBD80\uCE20 \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240515
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uAC19\uC740 \uC790\uB9AC\uC5D0
      \uB3C4\uCC29\uD55C\uB2E4. \uCF54\uB97C \uD55C \uBC88 \uB4E0\uB2E4. \uD68C\uC870
      \uB0C4\uC0C8\uAC00 \uC870\uAE08 \uC2DD\uC5B4 \uC788\uB2E4. \uBD84\uB9AC\uD30C
      \uB0C4\uC0C8\uAC00 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uC870\uAE08 \uB354 \uC9C4\uD558\uAC8C
      \u2014 \uADF8\uB7EC\uB098 \uADF8 \uB0C4\uC0C8\uB294 \uB5A0\uB09C \uC790\uB9AC\uC758
      \uC794\uD5A5."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240516
    m_Localized: "...\uC654\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240517
    m_Localized: "...\uC654\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240518
    m_Localized: "\uD68C\uC870\uAC00 \uC190\uBC14\uB2E5\uC758 \uB3CC \uB124 \uAC1C\uB97C
      \uCC28\uB840\uB85C \uB5A8\uC5B4\uB728\uB9B0\uB2E4. \uC138 \uBC88, \uADF8\uB9AC\uACE0
      \uD55C \uBC88 \uB354. \uADF8\uB0A0 \uC808\uBCBD\uC5D0\uC11C \uB4E4\uB824\uC628
      \uBC15\uC790\uC640 \uAC19\uC558\uB2E4. \uADF8\uB7EC\uB098 \uC774\uBC88\uC5D0\uB294
      \uC9C1\uC811 \uBCF4\uC774\uB294 \uC790\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240519
    m_Localized: "...\uAC19\uC740 \uBC15\uC790\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240520
    m_Localized: "...\uB108\uD76C \uD68C\uB2F4\uC744 \uB4E4\uC5C8\uC5B4. \uD615\uC81C\uB2F5\uB124.
      \uBE44\uAC81\uD558\uAC8C \uB2E4\uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240521
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uCC98\uC74C\uC73C\uB85C \uC785\uAC00\uC5D0
      \uBBF8\uC138 \uBBF8\uC18C\uB97C \uB764\uB2E4. \uD611\uACE1\uC5D0\uC11C \uC790\uC2E0\uC774
      \uBC49\uC740 \uB9D0\uC774, \uD68C\uC870\uC758 \uC785\uC744 \uC9C0\uB098 \uC870\uAE08
      \uB2E4\uB978 \uBB34\uAC8C\uB85C \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240522
    m_Localized: "...\uBB34\uB9AC \uB9E4\uB4ED\uC73C\uB85C \uB048\uC744 \uBB36\uC5B4
      \uBCF4\uB0C8\uC5B4. \uADF8\uAC74 \uBB34\uB9AC \uCABD \uC2E0\uD638\uC778\uB370,
      \uC0C9\uC740 \uBD84\uB9AC\uD30C \uAC80\uC740\uC0C9\uC774\uACE0. \uC5B4\uB514\uC11C
      \uBB36\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240523
    m_Localized: "...\uBB34\uB9AC\uB3C4 \uBD84\uB9AC\uD30C\uB3C4 \uC544\uB2CC \uC790\uB9AC\uC57C.
      \uB450 \uC790\uB9AC \uC0AC\uC774\uC5D0 \uD55C \uC790\uB9AC\uAC00 \uC0DD\uACBC\uC5B4.
      \uD615\uC81C\uC758 \uC77C\uBD80\uAC00 \uAC70\uAE30 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240524
    m_Localized: "...\uB108\uB294 \uC5B4\uB290 \uC790\uB9AC\uC5D0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240525
    m_Localized: "...\uC544\uC9C1 \uB458 \uC0AC\uC774\uC57C. \uBB34\uB9AC\uB3C4 \uBD84\uB9AC\uD30C\uB3C4
      \uC544\uB2CC \uC790\uB9AC. \uADF8 \uC790\uB9AC\uAC00 \uD55C \uC790\uB9AC\uB85C
      \uC790\uB784\uC9C0, \uB2E4\uC2DC \uB2EB\uD790\uC9C0 \u2014 \uBAA8\uB974\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240526
    m_Localized: "\uB450 \uC0AC\uB78C \uC0AC\uC774\uB85C \uBCC0\uACBD \uD611\uACE1\uC758
      \uBC14\uB78C\uC774 \uD55C \uBC88 \uAE38\uAC8C \uC9C0\uB098\uAC04\uB2E4. \uD68C\uC870\uAC00
      \uC190\uBAA9 \uD749\uD130\uB97C \uD55C \uBC88 \uB354 \uC637\uC136 \uC548\uCABD\uC5D0\uC11C
      \uB9CC\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240527
    m_Localized: "...\uD615\uC81C \uB9D0, \uC785\uC5D0\uC11C \uB2E4\uC2DC \uB098\uC640?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240528
    m_Localized: "...\uB098\uC640. \uB2E4\uB978 \uB9D0\uC744 \uBABB \uCC3E\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240529
    m_Localized: "...\uADF8 \uB9D0\uC740 \uAC00\uC838\uAC00\uB3C4 \uB3FC? \uB2E4\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240530
    m_Localized: "\uAC00\uC838\uAC00. \uADF8 \uB9D0\uC740 \uC544\uC9C1 \uB124 \uAC70\uC57C.
      \uAC80\uC740 \uCE60\uC740 \uB04A\uB294 \uCE60\uC774 \uC544\uB2C8\uB77C, \uBABB
      \uC78A\uC5C8\uB2E4\uB294 \uD45C\uC2DC\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240531
    m_Localized: "\uD68C\uC870\uC758 \uC785\uAC00\uC5D0 \uCC98\uC74C\uC73C\uB85C
      \uBBF8\uC18C\uAC00 \uC7A0\uAE50 \uBA38\uBB38\uB2E4. \uBD84\uB9AC\uD30C\uC5D0\uC11C
      1\uB144 \uB3D9\uC548 \uB4E4\uC9C0 \uC54A\uC740 \uBBF8\uC18C. \uADF8\uB7EC\uB098
      \uB05D\uAE4C\uC9C0 \uAC00\uC9C0 \uC54A\uB294\uB2E4 \u2014 \uAC19\uC774 \uC7BF\uACE8\uB85C
      \uB3CC\uC544\uAC00\uC9C0 \uC54A\uC744 \uACB0\uC815\uC774 \uADF8 \uBBF8\uC18C
      \uB05D\uC5D0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240532
    m_Localized: "...\uD615\uC81C. \uC7BF\uACE8 \uC758\uC790\uC5D0\uB294 \uC548 \uC549\uC744
      \uAC70\uC57C. \uC544\uC9C1\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240533
    m_Localized: "\uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240534
    m_Localized: "\uBD84\uB9AC\uD30C\uC5D0\uB3C4 \uC548 \uB3CC\uC544\uAC00. \uADF8
      \uB458 \uC0AC\uC774\uC758 \uC790\uB9AC\uC5D0\uC11C \uC870\uAE08 \uB354 \uBA38\uBB34\uB97C
      \uAC70\uC57C. \uC0C8 \uC790\uB9AC\uAC00 \uC0DD\uAE30\uB294\uC9C0 \uBCF4\uACE0
      \uC2F6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240535
    m_Localized: "...\uBB34\uB9AC\uC5D0\uB3C4 \uADF8\uB7F0 \uC790\uB9AC\uAC00 \uC0DD\uAE38\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240536
    m_Localized: "...\uC6B0\uB9AC\uAC00 \uB9CC\uB4E4\uC5B4 \uBD10\uC57C \uC54C\uACA0\uC9C0.
      \uB458\uC774 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uC788\uC9C0 \uC54A\uC544\uB3C4
      \u2014 \uAC19\uC740 \uB9E4\uB4ED\uBC95\uC73C\uB85C \uBB36\uC744 \uC218\uB294
      \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240537
    m_Localized: "\uB450 \uC0AC\uB78C\uC774 \uC77C\uC5B4\uC120\uB2E4. \uD55C \uC0AC\uB78C\uC740
      \uC7BF\uACE8 \uBC29\uD5A5, \uD55C \uC0AC\uB78C\uC740 \uD611\uACE1 \uC548\uCABD.
      \uBC1C\uC790\uAD6D \uBC29\uD5A5\uC774 \uAC19\uC740 \uC790\uB9AC\uC5D0\uC11C
      \uB2E4\uB974\uAC8C \uAC08\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240538
    m_Localized: "...\uB3CC \uD55C \uAC1C \uB354 \uB4E4\uACE0 \uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240539
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uB3CC\uBB34\uB354\uAE30\uC5D0\uC11C
      \uC791\uC740 \uB3CC \uD558\uB098\uB97C \uC9D1\uC5B4 \uD68C\uC870\uC5D0\uAC8C
      \uAC74\uB128\uB2E4. \uB2E4\uC12F \uBC88\uC9F8 \uB3CC. \uADF8\uB0A0 \uC808\uBCBD\uC758
      \uB124 \uBC88 \uB3CC\uC18C\uB9AC\uC5D0 \uD55C \uBC88 \uB354 \uB354\uD574\uC9C8
      \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240540
    m_Localized: "...\uB2E4\uC74C\uC5D0 \uBCF4\uB0BC \uC2E0\uD638\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240541
    m_Localized: "...\uB108\uC758 \uC2E0\uD638. \uB3CC \uB2E4\uC12F \uBC88\uC774
      \uB4E4\uB9AC\uBA74, \uADF8\uAC74 \uB108\uC758 \uCC28\uB840\uC57C. \uC7BF\uACE8\uC5D0\uC11C
      \uBC1B\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240542
    m_Localized: "...\uADF8\uB798. \uD615\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240543
    m_Localized: "\uD68C\uC870\uAC00 \uB2E4\uC12F \uBC88\uC9F8 \uB3CC\uC744 \uC190\uBC14\uB2E5\uC5D0
      \uD55C \uBC88 \uAD74\uB9B0\uB2E4. \uBC1C\uC790\uAD6D \uD55C \uAC1C\uAC00 \uD611\uACE1
      \uC548\uCABD\uC73C\uB85C \uD5A5\uD55C\uB2E4. \uC774\uBE68\uBC14\uB78C\uC758
      \uBC1C\uC790\uAD6D \uD55C \uAC1C\uAC00 \uC7BF\uACE8 \uCABD\uC73C\uB85C \uD5A5\uD55C\uB2E4.
      \uB450 \uBC1C\uC790\uAD6D\uC774 \uAC19\uC740 \uB3CC\uBB34\uB354\uAE30\uC5D0\uC11C
      \uC2DC\uC791\uD574\uC11C \uB2E4\uB978 \uBC29\uD5A5\uC73C\uB85C \uBA40\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240544
    m_Localized: "\uBCC0\uACBD \uAE38\uBAA9. \uD55C\uC0C8\uAC00 \uD55C \uBC1C \uB2A6\uAC8C
      \uB098\uD0C0\uB09C\uB2E4. \uC190\uC5D0 \uC791\uC740 \uD1A0\uD15C \uC870\uAC01
      \uD558\uB098\uB97C \uB4E4\uACE0 \uC788\uB2E4. \uC0C9\uC740 \uC605\uC740 \uD68C\uC0C9
      \u2014 \uBB34\uB9AC \uCABD \uD1A0\uD15C\uC0C9\uB3C4, \uBD84\uB9AC\uD30C \uAC80\uC740\uC0C9\uB3C4
      \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240545
    m_Localized: "...\uBD81\uCABD\uC774\uB098 \uC11C\uCABD \uD55C \uACF3\uC5D0\uC11C
      \uBCF4\uB0B8 \uD1A0\uD15C \uC870\uAC01\uC785\uB2C8\uB2E4. \uC5B4\uB290 \uCABD\uC778\uC9C0\uB294
      \uC548 \uC801\uD600 \uC788\uC5B4\uC694. \uC774\uB9AC\uC194 \uC61B \uC751\uB2F5
      \uBBF8\uC815 \uC138\uB825 \uD45C\uC9C0\uC778\uB370 \u2014 \uC774\uB984\uC740
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240546
    m_Localized: "...\uB458 \uC911 \uD55C \uCABD\uC774 \uB2F5\uC744 \uAC00\uC838\uC654\uB2E4\uB294
      \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240547
    m_Localized: "\uC608. \uB2F5\uC774 \uC808\uBC18 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240548
    m_Localized: "...\uC5B4\uB290 \uCABD\uC778\uC9C0 \uC54C\uBA74 \uB2F5\uC744 \uBC1B\uAE30
      \uB354 \uC27D\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240549
    m_Localized: "...\uC544\uB2C8\uC694. \uC5B4\uB290 \uCABD\uC5D0\uC11C \uBCF4\uB0C8\uB294\uC9C0
      \uBAA8\uB97C \uB54C \uB2F5\uC774 \uB354 \uBB34\uAC81\uC2B5\uB2C8\uB2E4. \uBCF4\uB0B8
      \uC790\uB9AC\uB97C \uC54C\uBA74, \uBC1B\uB294 \uC790\uB9AC\uB3C4 \uC815\uD574\uC9D1\uB2C8\uB2E4.
      \uBAA8\uB974\uBA74 \u2014 \uC591\uCABD \uB2E4 \uBC1B\uC544\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240550
    m_Localized: "...\uC591\uCABD \uB2E4 \uBC1B\uACA0\uB2E4. \uC774\uB984 \uC5C6\uB294
      \uCC44\uB85C \uBCF4\uB0B8 \uB2F5\uC774\uBA74, \uC6B0\uB9AC\uB3C4 \uC774\uB984
      \uC5C6\uB294 \uCC44\uB85C \uBC1B\uC790. \uB2E4\uC74C \uD68C\uB2F4\uC5D0 \uB450
      \uC790\uB9AC \uB354 \uB9CC\uB4E4\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240551
    m_Localized: "...\uBA85\uC74C \uAE30\uB85D\uAD00\uC5D0\uAC8C \uC11C\uC2E0 \uBCF4\uB0B4\uACA0\uC2B5\uB2C8\uB2E4.
      \uB2E4\uB978 \uBCC0\uBC29 \uB450 \uC790\uB9AC \uCD94\uAC00. \uC774\uB984 \uBBF8\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240552
    m_Localized: "\uBCC0\uACBD \uAE38\uBAA9\uC758 \uBC14\uB78C\uC774 \uD55C \uBC88
      \uB354 \uAE38\uAC8C \uC9C0\uB098\uAC04\uB2E4. \uC605\uC740 \uD68C\uC0C9 \uD1A0\uD15C
      \uC870\uAC01\uC774 \uD55C\uC0C8\uC758 \uC190\uC5D0\uC11C \uC791\uAC8C \uBE5B\uB09C\uB2E4.
      \uB2F5\uC740 \uC808\uBC18\uB9CC \uB3C4\uCC29\uD55C \uCC44\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240553
    m_Localized: "\uC7BF\uACE8 \uD68C\uC758\uC2E4. \uD0C1\uC790 \uB458\uB808\uC758
      \uB124 \uC758\uC790. \uBCF8 \uB300\uC131\uB2F9 \uCABD \uC758\uC790\uB294 \uC5EC\uC804\uD788
      \uBE44\uC5B4 \uC788\uB2E4 \u2014 \uB2E8\uB9B0\uC774 \uBCF8 \uB300\uC131\uB2F9\uC5D0\uC11C
      \uB3CC\uC544\uC624\uBA74 \uADF8 \uC790\uB9AC\uAC00 \uCC44\uC6CC\uC9C8\uC9C0,
      \uBCF8\uC778\uC774 \uC815\uD55C\uB2E4. \uD68C\uC870 \uCABD \uC758\uC790\uC5D0\uB294
      \uBCC0\uD654. \uAC80\uC740 \uD1A0\uD15C \uB048\uC774 \uD480\uB824 \uC788\uACE0,
      \uADF8 \uC790\uB9AC\uC5D0 \uB2E4\uC12F \uBC88\uC9F8 \uB3CC\uC774 \uD55C \uAC1C
      \uB193\uC5EC \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240554
    m_Localized: "\uC606 \uC758\uC790\uC5D0 \uB450 \uC0C8 \uC758\uC790\uAC00 \uCD94\uAC00\uB41C\uB2E4.
      \uC774\uB984 \uBBF8\uC815. \uC605\uC740 \uD68C\uC0C9 \uD1A0\uD15C \uC870\uAC01
      \uD55C \uC790\uB9AC\uC5D0 \uB193\uC5EC \uC788\uB2E4 \u2014 \uBD81\uCABD\uC774\uB098
      \uC11C\uCABD \uD55C \uCABD\uC5D0\uC11C \uBCF4\uB0B8 \uC751\uB2F5 \uD45C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240555
    m_Localized: "...\uD68C\uC870\uB294 \uC548 \uC640. \uADF8\uB798\uB3C4 \uC758\uC790\uC5D0
      \uB3CC \uD55C \uAC1C\uB97C \uB450\uACE0 \uAC14\uC5B4. \uADF8\uAC74 \uB2E4\uC74C
      \uC790\uB9AC\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240556
    m_Localized: "\uC5F0\uC8FC\uAC00 \uB450 \uCF24\uB808 \uBD80\uCE20\uB85C \uC785\uAD6C\uC5D0
      \uC120\uB2E4. \uD55C \uBC1C\uC740 \uBB34\uB9AC \uBD80\uCE20, \uD55C \uBC1C\uC740
      \uC815\uCC30\uBCD1 \uBD80\uCE20. \uB450 \uBC1C\uC790\uAD6D\uC774 \uD55C \uC790\uB9AC\uC5D0\uC11C
      \uB9CC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240557
    m_Localized: "...\uC624\uBE60. \uBD80\uCE20\uAC00 \uC544\uC9C1 \uBA40\uCA61\uD574\uC694.
      \uB2F5\uC740 \uB354 \uB2A6\uAC8C \uC640\uB3C4 \uB418\uB294 \uAC70\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240558
    m_Localized: "...\uB2A6\uC5B4\uB3C4 \uB3FC. \uB108\uC758 \uC790\uB9AC\uAC00 \uB108\uC758
      \uC790\uB9AC\uAC00 \uB420 \uB54C\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240559
    m_Localized: "\uBE48 \uC758\uC790 \uB458\uACFC \uC0C8 \uC758\uC790 \uB458. \uB2E4\uC12F
      \uBC88\uC9F8 \uB3CC\uACFC \uC605\uC740 \uD68C\uC0C9 \uD1A0\uD15C \uC870\uAC01.
      \uBCC0\uACBD\uC758 \uD68C\uB2F4\uC740 \uD55C \uC790\uB9AC \uB354 \uBB34\uAC70\uC6CC\uC84C\uB2E4.
      \uADF8\uB7EC\uB098 \uC790\uB9AC\uAC00 \uB2EB\uD788\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240560
    m_Localized: "\uB2E4\uB978 \uBB38. \uCCAB \uB3C4\uC2DC \uBB38\uACFC \uB2E4\uB978
      \uC790\uB9AC. \uACA9\uC790 \uBB38\uC591\uC740 \uAC19\uC740 \uD615\uC2DD\uC774\uC9C0\uB9CC
      \uD55C \uC790\uB9AC \uC5B4\uAE0B\uB098 \uC788\uB2E4. \uACF5\uD55C\uC774 \uADF8
      \uC5B4\uAE0B\uB0A8\uC744 \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240561
    m_Localized: "\uACF5\uD55C\uC758 \uC190\uC5D0 \uACA9\uC790 \uB9E4\uB4ED \uD654\uC0B4\uC774
      \uB4E4\uB824 \uC788\uB2E4. \uC3D8\uC9C0 \uC54A\uC740 \uD654\uC0B4. \uC190\uBC14\uB2E5\uC758
      \uACA9\uC790 \uBB38\uC591\uC774 \uB2E4\uB978 \uBB38\uC758 \uACA9\uC790\uC640
      \uAC19\uC740 \uBC15\uC790\uB85C \uBE5B\uB09C\uB2E4. \uADF8\uB7EC\uB098 \uBC15\uC790\uAC00
      \uD55C \uC790\uB9AC \uC5B4\uAE0B\uB098 \uC788\uB2E4 \u2014 1800\uB144 \uC804
      \uBCF8\uC778\uC774 \uB2EB\uC740 \uBB38\uC774 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240562
    m_Localized: "...\uC774\uCABD \uBB38\uC740 \uC544\uB2C8\uB2E4. \uADF8\uB7EC\uB098
      \uAC19\uC740 \uC190\uC774 \uBB36\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240563
    m_Localized: "\uACF5\uD55C\uC774 \uD654\uC0B4\uC744 \uD65C\uC2DC\uC704\uC5D0
      \uAC78\uC9C0 \uC54A\uB294\uB2E4. \uC190\uC5D0 \uB4E0 \uCC44\uB85C \uBB38 \uC55E\uC5D0
      \uC120\uB2E4. \uBC1C\uC790\uAD6D\uC774 \uBB38\uD131 \uD55C \uBC1C \uC55E\uC5D0\uC11C
      \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240564
    m_Localized: "\uB2E4\uB978 \uBB38 \uC606 \uD759\uBC14\uB2E5\uC5D0 \uD3F4\uC554\uC73C\uB85C
      \uADF8\uC5B4\uC9C4 \uACA9\uC790 \uD55C \uC904\uC774 \uC788\uB2E4. \uBC29\uC9C4\uC758
      \uC790\uAD6D. \uC57D\uC18D\uC758 \uB9E4\uB4ED \uD55C \uD615\uC2DD. \uB204\uAC00
      \uBD10\uB3C4 \uC678\uBD80 \uB3D9\uB9F9\uC5D0\uAC8C \uAC00\uB974\uCE58\uB294
      \uC790\uC138. \uBC29\uC9C4\uC740 \uADF8 \uC790\uAD6D\uB9CC \uB0A8\uAE30\uACE0
      \uC0AC\uB77C\uC9C4 \uC9C0 \uC624\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240565
    m_Localized: "\uB2E4\uB978 \uBB38 \uC606. \uCE68\uC6D4\uC774 \uD6C4\uB4DC \uC5C6\uC774
      \uC11C \uC788\uB2E4. \uC774\uB9C8\uC758 \uBB38\uC591\uC774 \uD3C9\uC18C\uCC98\uB7FC
      \uCC28\uAC11\uAC8C \uB4DC\uB7EC\uB09C\uB2E4. \uADF8\uB7EC\uB098 \uCCAB \uB3C4\uC2DC
      \uBB38 \uC55E\uC5D0\uC11C\uBCF4\uB2E4, \uC2DC\uC120\uC774 \uC870\uAE08 \uB354
      \uC624\uB798 \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240566
    m_Localized: "...\uC2DC\uC870. \uB450 \uBC88\uC9F8 \uC790\uB9AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240567
    m_Localized: "...\uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240568
    m_Localized: "\uACB0\uC0AC \uC548\uC758 \uC774\uB984\uC740 \uD55C \uBC88 \uC783\uC740
      \uB4A4\uC5D0 \uB450 \uBC88 \uB2E4\uC2DC \uC783\uC2B5\uB2C8\uB2E4. \uB450 \uBC88\uC9F8
      \uBE44\uC6A9\uC744 \uCCAD\uAD6C\uD558\uB7EC \uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240569
    m_Localized: "...\uC774\uB984\uC740 \uC774\uBBF8 \uD55C \uBC88 \uC783\uC5C8\uB2E4.
      \uB450 \uBC88\uC9F8\uB294 \uBB34\uC5C7\uC744 \uC783\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240570
    m_Localized: "...\uC758\uB840\uC758 \uC190\uAC00\uB77D \uD558\uB098\uC785\uB2C8\uB2E4.
      \uB2E4\uB978 \uBB38\uC758 \uBD09\uC778\uC744 \uBB36\uC5C8\uB358 \uC190. 1800\uB144
      \uC804 \uC9C1\uC811 \uBB36\uC740 \uC190\uC774 \uC544\uB2C8\uC9C0\uB9CC, \uAC19\uC740
      \uC758\uB840\uC5D0\uC11C \uAC19\uC740 \uB9E4\uB4ED\uBC95\uC73C\uB85C \uBB36\uC778
      \uC190. \uADF8 \uC190\uC774 \uC678\uBD80\uC5D0\uC11C \uB2E4\uB978 \uBB38\uC744
      \uB2E4\uC2DC \uB9CC\uC9C0\uBA74 \u2014 \uC548\uCABD\uC5D0\uC11C \uADF8 \uC190\uAC00\uB77D
      \uD558\uB098\uC758 \uC57D\uC18D\uC774 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4. \uC190\uAC00\uB77D
      \uD558\uB098\uB294 \uC57D\uC18D \uD558\uB098\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240571
    m_Localized: "\uACF5\uD55C\uC774 \uC790\uAE30 \uC190\uC744 \uD55C \uBC88 \uBCF8\uB2E4.
      \uACA9\uC790 \uBB38\uC591\uC774 \uC190\uBC14\uB2E5\uC5D0 \uC788\uB2E4. \uC190\uAC00\uB77D
      \uB9C8\uB514 \uC0AC\uC774\uC5D0 \uC791\uC740 \uB9E4\uB4ED\uC758 \uC790\uAD6D\uC774
      \uC788\uB2E4 \u2014 1800\uB144 \uC758\uB840\uC5D0\uC11C \uBC1B\uC740 \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240572
    m_Localized: "...\uC5B4\uB290 \uC190\uAC00\uB77D\uC774 \uC0AC\uB77C\uC9C0\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240573
    m_Localized: "\uBC14\uAE65\uC5D0\uC11C\uB294 \uC815\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uACB0\uC0AC \uC548\uCABD \uC758\uB840\uAC00 \uC2DC\uC870\uC758 \uC190\uAC00\uB77D
      \uD558\uB098\uB97C \uACE0\uB985\uB2C8\uB2E4. \uBC16\uC5D0\uC11C\uB294 \uBCF4\uC774\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uC548\uCABD \uAE30\uB85D\uC5D0\uB9CC \uB0A8\uC2B5\uB2C8\uB2E4.
      \uADF8\uAC8C \uC57D\uC18D\uC758 \uAE00\uC790 \uADF8\uB300\uB85C\uC758 \uCC98\uB9AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240574
    m_Localized: "...\uAD1C\uCC2E\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240575
    m_Localized: "...\uC815\uB9D0 \uAD1C\uCC2E\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240576
    m_Localized: "...\uAD1C\uCC2E\uB2E4. \uB2E4\uB9CC \uD55C \uB9E4\uB4ED\uC740 \uB2E4\uC74C
      \uB9E4\uB4ED\uC744 \uC704\uD574 \uBB36\uC778\uB2E4. \uC783\uC740 \uB9E4\uB4ED\uC774
      \uB2E4\uC74C \uB9E4\uB4ED\uC758 \uAE38\uC744 \uAC00\uB9AC\uD0A8\uB2E4\uBA74,
      \uADF8 \uBE44\uC6A9\uC740 \uAE38\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240577
    m_Localized: "\uCE68\uC6D4\uC758 \uC785\uAC00\uAC00 \uCC98\uC74C\uC73C\uB85C
      \uB5A8\uB9B0\uB2E4. \uBBF8\uC18C\uB85C \uAC00\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB7EC\uB098
      \uCC28\uAC00\uC6B4 \uC790\uC138\uAC00 \uC7A0\uAE50 \uD480\uB9B0\uB2E4. \uACE7
      \uB2E4\uC2DC \uB2E8\uB2E8\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240578
    m_Localized: "...\uC2DC\uC870. \uC783\uB294 \uAC83\uC744 \uAE38\uC774\uB77C\uACE0
      \uBD80\uB978 \uAE30\uB85D\uC740 \uC5C6\uC2B5\uB2C8\uB2E4. \uC624\uB298 \uC804\uAE4C\uC9C0\uB294\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240579
    m_Localized: "\uBAA8\uB2E5\uBD88. \uBA85\uC74C\uC774 \uC758\uB840 \uAC70\uC6B8\uC744
      \uBB34\uB98E \uC704\uC5D0 \uB454\uB2E4. \uAC70\uC6B8 \uC548\uC5D0 \uACF5\uD55C\uC758
      \uC190 \uB9C8\uB514 \uC0AC\uC774 \uC791\uC740 \uB9E4\uB4ED\uC758 \uC790\uAD6D\uC774
      \uBE44\uCE5C\uB2E4. \uBAA8\uB2E5\uBD88\uC758 \uBE5B\uC774 \uADF8 \uC790\uAD6D
      \uC704\uC5D0\uC11C \uC7A0\uC2DC \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240580
    m_Localized: "\uAE30\uB85D. \uC2DC\uC870 \uACF5\uD55C. \uC678\uBD80 \uC99D\uC5B8\uC790
      \uC790\uC138 \uC720\uC9C0. \uACB0\uC0AC \uC548\uCABD \uC758\uB840\uC5D0\uC11C
      \uC190\uAC00\uB77D \uD558\uB098 \uC57D\uC18D \uCC98\uB9AC\uB428."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240581
    m_Localized: "\uAE30\uB85D\uAD00. \uACB0\uC0AC \uAC15\uACBD \uCE21 \uBE44\uC6A9
      \uCCAD\uAD6C\uB3C4 \uD568\uAED8 \uC801\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240582
    m_Localized: "\uD568\uAED8 \uC801\uC2B5\uB2C8\uB2E4. \uAC15\uACBD \uCE21\uACFC
      \uC678\uBD80 \uC99D\uC5B8\uC790 \uB458\uC774 \uAC19\uC740 \uAC70\uC6B8\uC5D0
      \uBE44\uCE69\uB2C8\uB2E4. \uBCD1\uD569\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240583
    m_Localized: "...\uB450 \uBC88\uC9F8 \uB9E4\uB4ED\uC758 \uC790\uB9AC\uC5D0 \uC801\uC5B4
      \uB450\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240584
    m_Localized: "\uAE30\uB85D. \uB450 \uBC88\uC9F8 \uB9E4\uB4ED\uC758 \uC790\uB9AC.
      \uC2DC\uC870 \uACF5\uD55C \uC678\uBD80 \uC99D\uC5B8\uC790 \uC790\uC138 \uB450
      \uBC88\uC9F8 \uBE44\uC6A9 \uCC98\uB9AC. \uAC15\uACBD \uCE21 \uCE68\uC6D4 \uC9C1\uC811
      \uCCAD\uAD6C. \uBD09\uD569\uC790 \uBA85\uC74C \uAC70\uC6B8 \uB9C8\uC8FC \uC138\uC6C0.
      \uBCD1\uD569\uD558\uC9C0 \uC54A\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240585
    m_Localized: "\uAC70\uC6B8 \uC548\uC5D0 \uB2E4\uC12F \uBC88\uC9F8 \uBE5B\uC774
      \uD55C \uBC88 \uAE5C\uBE61\uC778\uB2E4. \uC678\uBD80 \uB3D9\uB9F9\uC758 \uC790\uB9AC.
      \uACF5\uD55C / \uCE68\uC6D4 / \uBA85\uC74C \uC14B\uC774 \uAC19\uC740 \uAC70\uC6B8\uC5D0
      \uBE44\uCE58\uC9C0\uB9CC, \uB2E4\uC12F \uBC88\uC9F8 \uBE5B\uC774 \uC14B \uC606\uC5D0\uC11C
      \uC7A0\uAE50 \uC0B4\uC544\uB09C\uB2E4. \uB2E8\uB9B0\xB7\uC774\uBE68\uBC14\uB78C\xB7\uBB35\uD5A5\uC774
      \uC5C6\uC5B4\uB3C4, \uADF8 \uC790\uB9AC\uB294 \uBE44\uC6CC \uB454 \uCC44 \uB0A8\uC544
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240586
    m_Localized: "...\uB2E8\uB9B0 \uC0AC\uC81C\uAED8 \uC11C\uC2E0 \uD55C \uD1B5 \uAC00\uC57C
      \uD569\uB2C8\uB2E4. \uBCF8 \uB300\uC131\uB2F9 \uBD80\uBCF8 \uBB36\uC74C\uC758
      \uC678\uBD80 \uC99D\uC5B8\uC790 \uCE21 \uBD80\uBCF8\uC5D0 \u2014 \uB450 \uBC88\uC9F8
      \uB9E4\uB4ED\uC758 \uC790\uB9AC\uAC00 \uCD94\uAC00\uB410\uB2E4\uB294 \uD45C\uC2DC\uB97C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240587
    m_Localized: "...\uB2E8\uB9B0\uC5D0\uAC8C \uAC00\uB294 \uC11C\uC2E0\uC740 \uC190\uAE00\uC528\uB85C
      \uBCF4\uB0B4\uB77C. \uD559\uD30C \uD615\uC2DD\uC774 \uC544\uB2C8\uB77C. \uC778\uC7A5
      \uC5C6\uB294 \uC190\uC774 \uBC1B\uC744 \uC11C\uC2E0\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240588
    m_Localized: "...\uAE30\uB85D. \uC190\uAE00\uC528 \uC11C\uC2E0. \uC778\uC7A5
      \uC5C6\uB294 \uC190 \uC218\uC2E0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240589
    m_Localized: "\uB2E4\uB978 \uBB38 \uC55E. \uACF5\uD55C \uD63C\uC790. \uC190\uAC00\uB77D
      \uB9C8\uB514 \uC0AC\uC774 \uB9E4\uB4ED\uC758 \uC790\uAD6D\uC774 \uC870\uAE08
      \uB354 \uC9D9\uAC8C \uBCF4\uC778\uB2E4. \uC5B4\uB290 \uC790\uB9AC\uAC00 \uC0AC\uB77C\uC9C8
      \uC190\uAC00\uB77D \uB9E4\uB4ED\uC778\uC9C0, \uACF5\uD55C \uBCF8\uC778\uC740
      \uC548\uB2E4. \uACB0\uC0AC \uC548\uCABD\uC5D0\uC11C \uACB0\uC815\uD55C \uC790\uB9AC\uB294
      \u2014 \uC2DC\uC870 \uBCF8\uC778\uC758 \uC190\uBC14\uB2E5\uC5D0\uC11C \uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240590
    m_Localized: "...\uBD88\uC744 \uCB10\uB358 \uC190\uC774 \uB530\uB73B\uD588\uB2E4.
      1800\uB144 \uC804."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240591
    m_Localized: "\uACF5\uD55C\uC774 \uC190\uBC14\uB2E5\uC744 \uD55C \uBC88 \uBCF8\uB2E4.
      \uADF8 \uB530\uB73B\uD55C \uC190\uC774 \uAC00\uB974\uCCD0 \uC900 \uB9E4\uB4ED
      \uD615\uC2DD. \uADF8 \uC190\uC774 \uBB36\uC740 \uB9E4\uB4ED \uC911 \uD55C \uC790\uB9AC.
      \uADF8 \uC790\uB9AC\uAC00 \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240592
    m_Localized: "...\uAD1C\uCC2E\uB2E4. \uB530\uB73B\uD55C \uC190\uC774 \uBB36\uC740
      \uB9E4\uB4ED\uC774 \uC0AC\uB77C\uC9C0\uB294 \uAC83\uBCF4\uB2E4, \uB530\uB73B\uD55C
      \uC190\uC774 1800\uB144 \uB3D9\uC548 \uC678\uC6CC\uC9C4 \uCC44\uB85C \uB0A8\uB294
      \uAC83\uC774 \uB354 \uBB34\uAC70\uC6B8 \uC218\uB3C4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240593
    m_Localized: "\uACF5\uD55C\uC774 \uACA9\uC790 \uB9E4\uB4ED \uD654\uC0B4\uC744
      \uD65C\uC2DC\uC704\uC5D0 \uD55C \uBC88 \uAC78\uC5B4 \uBCF8\uB2E4. \uB9E4\uB4ED
      \uD615\uC2DD\uC774 \uD3C9\uC18C\uC640 \uB2E4\uB974\uB2E4 \u2014 \uB9E4\uB4ED
      \uD55C \uC790\uB9AC\uAC00 \uD5D0\uAC81\uB2E4. \uC5B4\uB290 \uC190\uAC00\uB77D\uC774
      \uACE7 \uC0AC\uB77C\uC9C8\uC9C0, \uC190\uBC14\uB2E5\uC774 \uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240594
    m_Localized: "...\uBB38\uBC16\uC740 \uCDA5\uB2E4. \uADF8\uB798\uC11C \uBD88\uC744
      \uB450\uACA0\uB2E4. \uB2E4\uC74C \uB9E4\uB4ED\uC740 \uB2E4\uC74C \uB9E4\uB4ED\uC744
      \uC704\uD574 \uBB36\uC778\uB2E4 \u2014 \uADF8 \uB2E4\uC74C \uB9E4\uB4ED\uC774,
      \uC0AC\uB77C\uC9C4 \uB9E4\uB4ED\uC774 \uAC00\uB9AC\uD0A8 \uAE38\uB85C \uBB36\uC778\uB2E4\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240595
    m_Localized: "\uB2E4\uB978 \uBB38\uC774 \uB2EB\uD78C \uCC44\uB85C \uADF8\uB300\uB85C
      \uC788\uB2E4. \uACF5\uD55C\uC774 \uBC1C\uC790\uAD6D \uD55C \uAC1C\uB97C \uBB38\uC5D0\uC11C
      \uD55C \uBC1C \uBA40\uC5B4\uC9C4\uB2E4. \uADF8 \uBC1C\uC790\uAD6D \uC790\uB9AC\uC5D0
      \uD759\uC774 \uD55C \uBC88 \uD754\uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240596
    m_Localized: "\uB2E4\uB978 \uBB38. \uB2EB\uD78C \uCC44\uB85C. \uADF8\uB7EC\uB098
      \uBB38\uD2C8\uC5D0 \uC791\uC740 \uBE5B\uC774 \uD55C \uC904 \uB354 \uAE38\uAC8C
      \uBA38\uBB38\uB2E4. \uCCAB \uB3C4\uC2DC \uBB38\uACFC \uAC19\uC740 \uD615\uC2DD\uC758
      \uBE5B \u2014 \uACF5\uD55C\uC758 \uC678\uBD80 \uC99D\uC5B8\uC774 \uB450 \uBC88\uC9F8
      \uC790\uB9AC\uC5D0\uC11C\uB3C4 \uBE5B\uC744 \uB0A8\uAE34 \uD45C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240597
    m_Localized: "\uBA40\uB9AC\uC11C \uCE68\uC6D4\uC774 \uD6C4\uB4DC\uB97C \uB2E4\uC2DC
      \uC4F4\uB2E4. \uACB0\uC0AC \uC548\uCABD\uC73C\uB85C \uBC1C\uC790\uAD6D \uB450
      \uAC1C\uB97C \uC62E\uAE34\uB2E4. \uC2DC\uC870\uC758 \uC190\uAC00\uB77D \uC57D\uC18D
      \uD558\uB098\uC758 \uC790\uB9AC\uC5D0\uC11C \uC0C8 \uC758\uB840\uB97C \uBC1C\uB3D9\uD560
      \uC2DC\uAC04."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240598
    m_Localized: "\uBA85\uC74C\uC774 \uAC70\uC6B8\uC744 \uBB34\uB98E \uC704\uC5D0\uC11C
      \uC606\uC5D0 \uB454\uB2E4. \uAC70\uC6B8 \uC548 \uB2E4\uC12F \uBC88\uC9F8 \uBE5B\uC774
      \uC7A0\uC2DC \uB354 \uBA38\uBB38\uB2E4. \uB2E8\uB9B0\uC5D0\uAC8C \uBCF4\uB0BC
      \uC190\uAE00\uC528 \uC11C\uC2E0\uC774 \uBB34\uB98E \uC704\uC5D0 \uD55C \uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240599
    m_Localized: "...\uAD1C\uCC2E\uB2E4. \uBB38\uBC16\uC740 \uCDA5\uB2E4. \uADF8\uB798\uC11C
      \uBD88\uC744 \uB450\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240600
    m_Localized: "\uACF5\uD55C\uC758 \uC190\uC774 \uD65C\uC2DC\uC704\uC5D0\uC11C
      \uD480\uB9B0\uB2E4. \uACA9\uC790 \uB9E4\uB4ED \uD654\uC0B4\uC740 \uC3D8\uC9C0
      \uC54A\uC740 \uCC44 \uB2E4\uC2DC \uB4F1 \uB4A4\uB85C. \uBB38\uD2C8\uC758 \uC791\uC740
      \uBE5B\uC774 \uBA40\uB9AC\uC11C \uD55C \uBC88 \uB354 \uAE5C\uBC15\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240601
    m_Localized: "\uBCC0\uBC29\uBB38\uC740 \uC548\uCABD\uC73C\uB85C \uBB34\uB108\uC838
      \uC788\uB2E4. \uCCA0 \uD30C\uD3B8\uC774 \uB4E4\uD310\uAE4C\uC9C0 \uD280\uC5C8\uACE0,
      \uADF8 \uC0AC\uC774\uC5D0 \uB450 \uAC00\uC9C0 \uBC1C\uC790\uAD6D\uC774 \uC5C9\uCF1C
      \uC788\uB2E4 \u2014 \uC194\uB77C\uB8F8 \uAD70\uD654, \uC774\uB9AC\uC194 \uC0AC\uB0E5\uAFBC\uC758
      \uB9E8\uBC1C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240602
    m_Localized: "\uC5EC\uAE30\uC11C \uC2F8\uC6E0\uC5B4. \uB108\uD76C \uCABD\uD558\uACE0
      \uC6B0\uB9AC \uCABD\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240603
    m_Localized: "...\uAD6D\uACBD \uC21C\uCC30\uB07C\uB9AC \uB9C8\uC8FC\uCE5C \uAC78\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240604
    m_Localized: "\uC21C\uCC30\uC774 \uC774\uB807\uAC8C \uAE4A\uC774 \uB4E4\uC5B4\uC640?
      \uB0C4\uC0C8\uB294 \uADF8\uB807\uAC8C \uB9D0 \uC548 \uD574. \uC591\uCABD \uB2E4
      \uBA3C\uC800 \uB9DE\uC558\uB2E4\uACE0 \uBBFF\uACE0 \uB2EC\uB824\uB4E0 \uC790\uAD6D\uC774\uC57C.
      \uD55C\uCABD\uC774 \uC2DC\uC791\uD55C \uAC8C \uC544\uB2C8\uB77C \u2014 \uB458
      \uB2E4 \uC2DC\uC791\uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240605
    m_Localized: "\uADF8\uB7EC\uBA74 \uB204\uAC00 \uBA3C\uC800 \uB3C4\uBC1C\uD588\uB294\uC9C0\uBD80\uD130
      \uBD10\uC57C\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240606
    m_Localized: "\uC0AC\uC81C\uB294 \uCC38, \uB204\uAC00 \uBA3C\uC800\uC600\uB294\uC9C0\uB97C
      \uC88B\uC544\uD558\uB294\uAD70. \uC8FD\uC740 \uC0AC\uB78C\uD55C\uD14C\uB294
      \uC21C\uC11C\uAC00 \uC548 \uC911\uC694\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179963240607
    m_Localized: "...\uC21C\uC11C\uB97C \uC54C\uC544\uC57C \uBA48\uCD9C \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434752
    m_Localized: "\uADF8\uAC74 \uB9DE\uB294 \uB9D0\uC774\uB124. \uCCAB \uB3D9\uD589\uC5D0
      \uB450 \uBC88\uC9F8 \uB9DE\uB294 \uB9D0\uC774\uC57C. \uC544\uAEF4 \uC368."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434753
    m_Localized: "...\uC138\uACE0 \uACC4\uC168\uAD70\uC694. \uC81C \uB9D0\uC744."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434754
    m_Localized: "\uB0C4\uC0C8\uB3C4 \uC138\uACE0 \uBC1C\uC790\uAD6D\uB3C4 \uC138.
      \uB9D0\uC774\uB77C\uACE0 \uC548 \uC138\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434755
    m_Localized: "\uB2E8\uB9B0\uC774 \uC0AC\uC81C\uBCF5 \uC790\uC218 \uB05D\uC744
      \uD55C \uBC88 \uB9CC\uC9C4\uB2E4. \uC785\uAC00\uAC00 \uC7A0\uAE50 \uD480\uB838\uB2E4
      \uB3CC\uC544\uC628\uB2E4. \uB450 \uBC1C\uC790\uAD6D\uC774 \uBCC0\uBC29\uBB38
      \uC548\uCABD\uC73C\uB85C \uB4E4\uC5B4\uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434756
    m_Localized: "...\uC55E\uC5D0 \uC0AC\uB78C\uC774 \uC788\uC5B4. \uD55C \uBA85.
      \uC548 \uC6C0\uC9C1\uC774\uACE0 \uC11C \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434757
    m_Localized: "\uB4E4\uD310 \uB108\uBA38\uC5D0\uC11C \uD55C \uC0AC\uB78C\uC774
      \uAC78\uC5B4\uC628\uB2E4. \uC194\uB77C\uB8F8 \uC815\uADDC\uAD70 \uAC11\uC637.
      \uC5B4\uAE68\uC5D0 \uC61B \uBCC0\uBC29 \uC218\uBE44\uB300 \uD45C\uC2DD. \uAC78\uC74C\uC5D0
      \uB9DD\uC124\uC784\uC774 \uC5C6\uB2E4 \u2014 \uC624\uB798 \uAD73\uC740 \uAC78\uC74C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434758
    m_Localized: "\uBCC0\uBC29 \uC218\uBE44\uB300\uC785\uB2C8\uB2E4. ...40\uB144
      \uC804\uC5D0 \uD574\uC0B0\uD55C \uBD80\uB300\uC608\uC694. \uC800 \uD45C\uC2DD\uC744
      \uB2E8 \uC0AC\uB78C\uC774 \uC544\uC9C1 \uC5EC\uAE30 \uC788\uC744 \uB9AC\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434759
    m_Localized: "\uC788\uC796\uC544. \uB208\uC55E\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434760
    m_Localized: "\uD1B5\uD589 \uD5C8\uAC00\uB97C \uC81C\uC2DC\uD558\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434761
    m_Localized: "\uBCC0\uBC29\uBB38\uC740 \uBB34\uB108\uC84C\uC2B5\uB2C8\uB2E4.
      \uC9C0\uD0AC \uBB38\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434762
    m_Localized: "\uD1B5\uD589 \uD5C8\uAC00\uB97C \uC81C\uC2DC\uD558\uB77C. \uBBF8\uC81C\uC2DC
      \uC2DC \uC808\uCC28\uC5D0 \uB530\uB77C \uC81C\uC555\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434763
    m_Localized: "\uB9D0\uC774 \uC548 \uD1B5\uD574. \uBA85\uB839\uC744 \uB4E3\uACE0
      \uC788\uB294\uB370, \uADF8 \uBA85\uB839\uC744 \uB0B4\uB9B0 \uC0AC\uB78C\uC774
      \uC774 \uC138\uC0C1\uC5D0 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434764
    m_Localized: "...\uD574\uC0B0 \uBA85\uB839\uC744 \uBABB \uBC1B\uC740 \uAC81\uB2C8\uB2E4.
      \uBD80\uB300\uB294 \uC0AC\uB77C\uC84C\uB294\uB370, \uC774 \uBD84\uC740 \uB9C8\uC9C0\uB9C9
      \uBA85\uB839\uC5D0 \uADF8\uB300\uB85C \uC11C \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434765
    m_Localized: "\uADF8\uB7FC \uBA85\uB839\uC744 \uBABB \uB05D\uB0B8 \uAC70\uC9C0.
      \uB05D\uB0B4 \uC8FC\uB294 \uC218\uBC16\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434766
    m_Localized: "\uACA9\uD22C. \uACE0\uC9C4\uC740 \uCE7C\uC744 \uBE7C\uC9C0 \uC54A\uB294\uB2E4.
      \uC808\uCC28\uB300\uB85C \uD55C \uBC1C\uC529 \uAC70\uB9AC\uB9CC \uC881\uD78C\uB2E4.
      \uC774\uBE68\uBC14\uB78C\uC758 \uC0AC\uB0E5\uCE7C\uC774 \uAC11\uC637 \uC5B4\uAE68
      \uB9E4\uB4ED\uC744 \uB04A\uB294\uB2E4. \uACE0\uC9C4\uC774 \uBB34\uB98E\uC744
      \uAFC7\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434767
    m_Localized: "\uADF8\uAC00 \uD55C \uBC88 \uC228\uC744 \uC270\uB2E4. \uAD73\uC5B4
      \uC788\uB358 \uAC78\uC74C\uC758 \uD798\uC774 \uBE60\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434768
    m_Localized: "...\uBB38\uC740. \uB2EB\uC558\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434769
    m_Localized: "\uADF8\uC758 \uBAA9\uC18C\uB9AC\uB2E4. \uB2E8\uB9B0\uC774 \uD55C
      \uBC1C \uB2E4\uAC00\uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434770
    m_Localized: "...\uC544\uB2C8\uC694. \uB2EB\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uBBF8\uC548\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434771
    m_Localized: "\uACE0\uC9C4\uC774 \uD55C \uBC88 \uB354 \uC228\uC744 \uC270\uB2E4.
      \uB2E4\uC74C \uB9D0\uC740 \uADF8\uC758 \uAC83\uC774 \uC544\uB2C8\uB2E4 \u2014
      \uC5B4\uB514\uC120\uAC00 \uC678\uC6CC \uB454, \uB9E4\uB044\uB7FD\uACE0 \uCC28\uAC00\uC6B4
      \uBB38\uC7A5\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434772
    m_Localized: "\uC815\uACB0\uC740 \uC9C8\uC11C\uC758 \uCCAB \uAC78\uC74C. \uD1B5\uC81C\uD560
      \uC218 \uC788\uB294 \uAC83\uC744 \uD1B5\uC81C\uD558\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434773
    m_Localized: "...\uC774 \uB9D0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434774
    m_Localized: "\uB2E8\uB9B0\uC774 \uD3C9\uC0DD \uC678\uC6B4 \uCCAB \uAE30\uB3C4\uC640,
      \uD55C \uB2E8\uC5B4\uB9CC \uB2E4\uB974\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434775
    m_Localized: "\uC5B4\uBA38\uB2C8\uAC00 \uAC00\uB974\uCCD0 \uC8FC\uC2E0 \uAE30\uB3C4\uB294
      '\uC815\uACB0\uC740 \uCD95\uBCF5\uC758 \uCCAB \uAC78\uC74C'\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB204\uAC00 '\uCD95\uBCF5'\uC744 '\uC9C8\uC11C'\uB85C \uBC14\uAFE8\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434776
    m_Localized: "\uB9E4\uB044\uB7EC\uC6B4 \uBB38\uC7A5\uC774 \uC7A6\uC544\uB4E0\uB2E4.
      \uD55C \uD638\uD761, \uC0AC\uB78C\uC758 \uC5BC\uAD74\uC774 \uB3CC\uC544\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434777
    m_Localized: "...\uBB38 \uC548\uCABD\uC5D0. \uB098 \uAC19\uC740 \uAC8C \uB354
      \uC788\uC5B4. \uBA48\uCD94\uB77C\uB294 \uB9D0\uC744 \uB05D\uB0B4 \uBABB \uB4E4\uC740
      \uAC83\uB4E4\uC774. \uB108\uD76C\uAC00 \uBCF8 \uAC74 \u2014 \uC2DC\uC791\uB3C4
      \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434778
    m_Localized: "\uADF8 \uB9D0\uC744 \uB05D\uC73C\uB85C \uACE0\uC9C4\uC774 \uC870\uC6A9\uD574\uC9C4\uB2E4.
      \uB2E8\uB9B0\uC774 \uD480\uB9B0 \uC5B4\uAE68 \uB9E4\uB4ED \uC790\uB9AC\uC5D0
      \uC190\uC744 \uB304\uB2E4. \uAC11\uC637 \uAC00\uC2B4\uD310 \uC548\uCABD, \uB2E8\uAC80
      \uB05D\uC73C\uB85C \uADF8\uC5B4 \uC0C8\uAE34 \uAE00\uC790 \uD558\uB098. \u300C\uACE0\uC9C4\u300D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434779
    m_Localized: "\u300C\uACE0\uC9C4\u300D. \uBCF8\uC778\uC774 \uC9C1\uC811 \uC0C8\uACBC\uC2B5\uB2C8\uB2E4.
      \uC544\uBB34\uB3C4 \uBABB \uBCF4\uB294 \uC790\uB9AC\uC5D0 \u2014 \uC790\uAE30
      \uC774\uB984\uC744 \uC78A\uC9C0 \uC54A\uC73C\uB824\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434780
    m_Localized: "\uBCC0\uBC29 \uC218\uBE44\uB300 \uBA85\uBD80\uC5D0 \uC788\uB294
      \uBD84\uC774\uC5D0\uC694. \uBCF8 \uB300\uC131\uB2F9 \uC911\uC559 \uBA85\uBD80\uB77C\uBA74,
      \uC774 \uC774\uB984 \uC606\uC5D0 \uC544\uC9C1 \uBBF8\uC815\uB9AC \uD45C\uC2DD\uC774
      \uB0A8\uC544 \uC788\uC744 \uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434781
    m_Localized: "\uACE0\uC9C4\uC758 \uAC11\uC637 \uC704\uB85C \uC7AC\uAC00 \uB2E4\uC2DC
      \uB0B4\uB824\uC549\uB294\uB2E4. \uB2E8\uB9B0\uC774 \uBB35\uC8FC\uB97C \uAEBC\uB0B4
      \uB450 \uC190\uC5D0 \uAC10\uC2FC\uB2E4. \uCCAB \uC54C\uC5D0\uC11C \uC190\uAC00\uB77D\uC774
      \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434782
    m_Localized: "\uC5B4\uBA38\uB2C8\uB294 '\uC815\uACB0\uC740 \uCD95\uBCF5\uC758
      \uCCAB \uAC78\uC74C'\uC774\uB77C\uACE0 \uAC00\uB974\uCE58\uC168\uC5B4\uC694.
      \uD3C9\uC0DD \uADF8\uB807\uAC8C \uC678\uC6E0\uC2B5\uB2C8\uB2E4. \uADF8\uB7F0\uB370
      \uC800 \uC0AC\uB78C \uC785\uC5D0\uC11C \uB098\uC628 \uAC74 '\uC9C8\uC11C'\uC600\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434783
    m_Localized: "\uD55C \uB2E8\uC5B4\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434784
    m_Localized: "\uD55C \uB2E8\uC5B4\uAC00 \uBC29\uD5A5\uC744 \uBC14\uAFC9\uB2C8\uB2E4.
      \uCD95\uBCF5\uC740 \uC0AC\uB78C\uC5D0\uAC8C \uC8FC\uB294 \uAC70\uC608\uC694.
      \uC9C8\uC11C\uB294 \u2014 \uC0AC\uB78C\uC744 \uC904 \uC138\uC6B0\uB294 \uAC70\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434785
    m_Localized: "...\uADF8\uAC74 \uBB34\uAC70\uC6B4 \uD55C \uB2E8\uC5B4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434786
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uC77C\uC5B4\uC120\uB2E4. \uADF8\uB294
      \uC624\uB798 \uC549\uC544 \uC788\uB294 \uC0AC\uB78C\uC774 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434787
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uD5C8\uB9AC\uCDA4\uC5D0\uC11C \uB9C8\uB978
      \uACE0\uAE30 \uD55C \uC870\uAC01\uC744 \uAEBC\uB0B4 \uB2E8\uB9B0\uC5D0\uAC8C
      \uB358\uC9C4\uB2E4. \uB2E8\uB9B0\uC774 \uC5C9\uAC81\uACB0\uC5D0 \uBC1B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434788
    m_Localized: "\uC539\uC5B4. \uBE48 \uC18D\uC5D0 \uBB34\uAC70\uC6B4 \uB2E8\uC5B4
      \uB123\uC73C\uBA74 \uCCB4\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434789
    m_Localized: "...\uBB34\uB9AC\uC758 \uBC95\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434790
    m_Localized: "\uB0B4 \uBC95\uC774\uC57C. \uAC19\uC774 \uAC77\uB294 \uC0AC\uB78C\uC740
      \uC548 \uAD76\uACA8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434791
    m_Localized: "\uB291\uB300\uC18C\uB098\uBB34 \uAE38. \uC18C\uB098\uBB34 \uAECD\uC9C8\uC5D0
      \uAC08\uD034 \uC790\uAD6D\uC774 \uAE4A\uB2E4. \uB2E4\uC12F \uC904. \uC190\uD1B1\uC774
      \uC544\uB2C8\uB77C \uBC1C\uD1B1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434792
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0\uB294 \uC6B0\uB9AC \uBB34\uB9AC \uB545\uC774\uC57C.
      \uC5EC\uAE30\uC11C\uBD80\uD130\uB294 \u2014 \uD68C\uC870 \uBB34\uB9AC \uB545\uC774\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434793
    m_Localized: "\uD1A0\uD15C\uC774 \uC788\uAD70\uC694. \uB4E4\uC5B4\uAC00\uB3C4
      \uB418\uB294 \uC790\uB9AC\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434794
    m_Localized: "\uC6D0\uB798\uB294 \uB0B4\uAC00 \uBB3C\uC5B4\uBCFC \uAC83\uB3C4
      \uC5C6\uB294 \uC790\uB9AC\uC57C. \uD615\uC81C \uB545\uC774\uB2C8\uAE4C. \uADF8\uB7F0\uB370
      \u2014 \uB9E4\uB4ED\uC744 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434795
    m_Localized: "\uD1A0\uD15C \uC55E\uC5D0 \uB9E4\uB4ED\uC774 \uBB36\uC5EC \uC788\uB2E4.
      \uC774\uBE68\uBC14\uB78C\uC774 \uADF8 \uC55E\uC5D0\uC11C \uC190\uC744 \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434796
    m_Localized: "\uBB34\uB9AC \uB9E4\uB4ED\uC740 \uC2DC\uACC4 \uBC29\uD5A5\uC774\uC57C.
      \uC774\uAC74 \uBC18\uB300\uB85C \uBB36\uC600\uC5B4. \uBD84\uB9AC\uD30C \uB9E4\uB4ED\uC774\uC9C0.
      ...\uD615\uC81C\uAC00 \uBCF8\uB300 \uB9E4\uB4ED\uC744 \uBC84\uB838\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434797
    m_Localized: "\uC5B8\uC81C\uBD80\uD130 \uC54C\uACE0 \uACC4\uC168\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434798
    m_Localized: "\uC7BF\uACE8 \uB5A0\uB0A0 \uB54C\uBD80\uD130 \uB0C4\uC0C8\uB85C\uB294
      \uC54C\uC558\uC5B4. \uB9E4\uB4ED\uC73C\uB85C \uBCF4\uB294 \uAC74 \u2014 \uC9C0\uAE08\uC774
      \uCC98\uC74C\uC774\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434799
    m_Localized: "\uC548\uAC1C \uC0AC\uC774\uB85C \uB178\uB780 \uB208\uC774 \uD55C
      \uC30D \uBE5B\uB09C\uB2E4. \uC0AC\uB78C\uC758 \uB208\uC774\uB2E4. \uADF8 \uB4A4\uB85C
      \uD65C\uC744 \uB4E0 \uBB34\uB9AC\uAC00 \uCC9C\uCC9C\uD788 \uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434800
    m_Localized: "...\uC654\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434801
    m_Localized: "\uC0AC\uC81C \uC778\uC7A5\uC744 \uBCF4\uC77C\uAE4C\uC694. \uC194\uB77C\uB8F8\uC740
      \uC801\uC774 \uC544\uB2C8\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434802
    m_Localized: "\uBCF4\uC774\uC9C0 \uB9C8. \uC9C0\uAE08 \uC800 \uC790\uB9AC\uC5D0\uC11C
      \uC194\uB77C\uB8F8 \uC778\uC7A5\uC740 \u2014 \uAC00\uC7A5 \uBE68\uB9AC \uD654\uC0B4
      \uB9DE\uB294 \uBC95\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434803
    m_Localized: "\uD68C\uC870\uAC00 \uBB34\uB9AC \uC55E\uC73C\uB85C \uB098\uC120\uB2E4.
      \uC774\uBE68\uBC14\uB78C\uACFC \uAC19\uC740 \uD0A4, \uAC19\uC740 \uAC78\uC74C.
      \uC190\uBAA9 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uAC19\uC740 \uD749\uD130 \u2014
      \uAC19\uC740 \uB0A0 \uAC19\uC740 \uCE7C\uB85C \uC0C8\uAE34 \uD53C\uC758 \uC11C\uC57D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434804
    m_Localized: "\uD615\uC81C. \uBA48\uCDB0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434805
    m_Localized: "\uD68C\uC870."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434806
    m_Localized: "\uC678\uBD80\uC778\uC744 \uB370\uB824\uC654\uB124. \uADF8\uAC83\uB3C4
      \uC194\uB77C\uB8F8 \uC0AC\uC81C\uB97C. \uC774 \uAE38\uC740 \uBABB \uC9C0\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434807
    m_Localized: "\uBCC0\uBC29\uBB38\uC774 \uBB34\uB108\uC84C\uC5B4. \uC548\uCABD\uC5D0\uC11C
      \uBB54\uAC00 \uC0C8\uC5B4 \uB098\uC624\uACE0 \uC788\uACE0, \uC6B0\uB9AC\uB294
      \uADF8\uAC78 \uBCF4\uB7EC \uAC00\uB294 \uAC70\uC57C. \uB108\uD76C \uB545\uC744
      \uBE8F\uC73C\uB7EC \uC628 \uAC8C \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434808
    m_Localized: "\uC548\uCABD\uC5D0\uC11C \uBB50\uAC00 \uC0C8\uC5B4 \uB098\uC624\uB4E0
      \uADF8\uAC74 \uD751\uC9C0\uB098 \uCE68\uC6D4\uC774 \uAC71\uC815\uD560 \uC77C\uC774\uC57C.
      \uC6B0\uB9AC \uBB34\uB9AC\uB294 \u2014 \uADF8 \uC61B\uB0A0 \uC77C\uC5D0\uC11C
      \uC190\uC744 \uB5BC\uAE30\uB85C \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434809
    m_Localized: "\uADF8 '\uC61B\uB0A0 \uC77C'\uC744 \uBAA8\uB974\uACE0 \uC190\uC744
      \uB5C4 \uC218 \uC788\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434810
    m_Localized: "\uC0AC\uC81C. \uC6B0\uB9AC \uBB34\uB9AC\uB294 \uC2DC\uC870\uC758
      \uC8C4\uAE4C\uC9C0 \uC9CA\uC5B4\uC9C8 \uD798\uC774 \uC5C6\uC5B4. \uB4F1\uC774
      \uBD80\uB7EC\uC9C4 \uBB34\uB9AC\uD55C\uD14C \uC9C4\uC2E4\uC744 \uB354 \uC5B9\uB294
      \uAC74 \u2014 \uCE5C\uC808\uC774 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434811
    m_Localized: "\uADF8\uB798\uC11C \uB9E4\uB4ED\uC744 \uAC70\uAFB8\uB85C \uBB36\uC5C8\uC5B4?
      \uBCF8\uB300\uB97C \uBC84\uB9AC\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434812
    m_Localized: "\uBC84\uB9B0 \uAC8C \uC544\uB2C8\uB77C \u2014 \uB0B4\uB824\uB193\uC740
      \uAC70\uC57C. \uD615\uC81C, \uB108\uB294 \uB298 \uB2E4 \uB4E4\uACE0 \uAC00\uB824\uACE0
      \uD558\uC9C0. \uB098\uB294 \uBABB \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434813
    m_Localized: "\uD68C\uC870\uAC00 \uAC08\uD034\uB97C \uB4E0\uB2E4. \uBB34\uB9AC\uC758
      \uD65C\uC774 \uD568\uAED8 \uC62C\uB77C\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434814
    m_Localized: "...\uAE38\uC744 \uBE44\uCF1C \uC904 \uC218\uB294 \uC5C6\uC5B4.
      \uB178\uC120\uC774\uC57C. \uC801\uC758\uAC00 \uC544\uB2C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434815
    m_Localized: "\uAC08\uD034\uC640 \uC0AC\uB0E5\uCE7C\uC774 \uB450 \uBC88 \uBD80\uB52A\uACE0,
      \uB450 \uBC88 \uB2E4 \uBE57\uB098\uAC04\uB2E4. \uB458 \uB2E4 \uC548\uB2E4 \u2014
      \uAC19\uC740 \uC2A4\uC2B9\uC5D0\uAC8C \uAC19\uC740 \uCE7C\uC744 \uBC30\uC6E0\uB2E4.
      \uD68C\uC870\uAC00 \uBA3C\uC800 \uD55C \uBC1C \uBB3C\uB7EC\uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434816
    m_Localized: "...\uB108\uB294 \uB0A0 \uBABB \uC774\uACA8, \uD615\uC81C. \uB098\uB3C4
      \uB108\uB97C \uBABB \uC774\uAE30\uACE0. \uC6B0\uB9AC\uB294 \uB298 \uC774\uB7AC\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434817
    m_Localized: "\uADF8\uB7FC \uBA48\uCDB0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434818
    m_Localized: "\uBA48\uCD94\uBA74 \uB124\uAC00 \uADF8 \uC0AC\uC81C\uB97C \uB370\uB9AC\uACE0
      \uC6B0\uB9AC \uB545\uC744 \uC9C0\uB098\uAC00\uACA0\uC9C0. \uADF8\uAC74 \uBABB
      \uBA48\uCDB0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434819
    m_Localized: "\uD68C\uC870, \uBCC0\uBC29\uBB38 \uC548\uC5D0\uC11C \uC6B0\uB9AC\uAC00
      \uBB58 \uBD24\uB294\uC9C0 \uC54C\uC544? \uC194\uB77C\uB8F8 \uB178\uC778 \uD558\uB098\uAC00,
      40\uB144 \uC804\uC5D0 \uC8FD\uC740 \uBA85\uB839\uC5D0 \uBB36\uC5EC\uC11C \uC544\uC9C1\uB3C4
      \uBB38\uC744 \uC9C0\uD0A4\uACE0 \uC788\uC5C8\uC5B4. \uBA85\uB839 \uB0B4\uB9B0
      \uC0AC\uB78C\uC740 \uC5C6\uB294\uB370 \u2014 \uBA85\uB839\uB9CC \uC0B4\uC544\uC11C
      \uADF8 \uC0AC\uB78C\uC744 \uC6C0\uC9C1\uC600\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434820
    m_Localized: "...\uADF8\uAC8C \uC6B0\uB9AC\uB791 \uBB34\uC2A8 \uC0C1\uAD00\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434821
    m_Localized: "\uAD6D\uACBD\uC5D0\uC11C \uB108\uD76C\uD558\uACE0 \uC194\uB77C\uB8F8\uC774
      \uCE58\uACE0\uBC1B\uB294 \uAC70. \uADF8\uAC70 \uB204\uAC00 \uBBF8\uC6CC\uC11C
      \uC2DC\uC791\uD55C \uAC8C \uC544\uB2D0 \uC218\uB3C4 \uC788\uB2E4\uB294 \uAC70\uC57C.
      \uC8FD\uC740 \uBA85\uB839\uC774 \uC2DC\uC791\uD588\uC744 \uC218\uB3C4 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434822
    m_Localized: "...\uB108\uB294 \uC99D\uBA85 \uBABB \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434823
    m_Localized: "\uC99D\uBA85\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC81C\uAC00
      \uBD24\uC73C\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434824
    m_Localized: "\uD68C\uC870\uAC00 \uAC08\uD034 \uB05D\uC744 \uB0B4\uB9B0\uB2E4.
      \uC644\uC804\uD788\uB294 \uC544\uB2C8\uB2E4. \uB2E8\uB9B0\uC744 \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434825
    m_Localized: "\uBCC0\uBC29\uBB38\uC758 \uADF8 \uB178\uC778\uC740 \uACE0\uC9C4\uC785\uB2C8\uB2E4.
      \uC194\uB77C\uB8F8 \uBCC0\uBC29 \uC218\uBE44\uB300. \uADF8\uB294 \uB204\uAD6C\uB97C
      \uBBF8\uC6CC\uD574\uC11C \uCE7C\uC744 \uB4E0 \uAC8C \uC544\uB2C8\uC5C8\uC5B4\uC694.
      40\uB144 \uC804 \uBA85\uB839\uC774 \uC544\uC9C1 \uADF8\uB97C \uBD99\uB4E4\uACE0
      \uC788\uC5C8\uC744 \uBFD0\uC785\uB2C8\uB2E4. \uAD6D\uACBD\uC5D0\uC11C \uB2F9\uC2E0
      \uBB34\uB9AC\uB97C \uCE5C \uC194\uB77C\uB8F8 \uBCD1\uC0AC \uC911\uC5D0\uB3C4,
      \uADF8\uB7F0 \uC0AC\uB78C\uC774 \uC788\uC5C8\uC744 \uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434826
    m_Localized: "\uADF8\uB7EC\uBA74 \u2014 \uC194\uB77C\uB8F8\uC774 \uC6B0\uB9AC\uB97C
      \uCE5C \uAC8C \uC544\uB2C8\uB77C, \uC8FD\uC740 \uC885\uC774 \uD55C \uC7A5\uC774
      \uC6B0\uB9AC\uB97C \uCCE4\uB2E4\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434827
    m_Localized: "\uC804\uBD80\uB294 \uC544\uB2D9\uB2C8\uB2E4. \uC0B4\uC544 \uC788\uB294
      \uC190\uB3C4 \uC788\uC5C8\uC744 \uAC70\uC608\uC694. \uD558\uC9C0\uB9CC \uC801\uC5B4\uB3C4,
      \uB2F9\uC2E0\uACFC \uB2F9\uC2E0 \uBB34\uB9AC\uAC00 \uC194\uB77C\uB8F8 \uC804\uCCB4\uB97C
      \uC801\uC73C\uB85C \uB458 \uC774\uC720\uB294 \u2014 \uC81C\uAC00 \uBCF8 \uB9CC\uD07C\uC740
      \uC904\uC5B4\uB4ED\uB2C8\uB2E4. \uC800\uB294 \uADF8\uAC78 \uC194\uB77C\uB8F8
      \uCABD\uC5D0 \uADF8\uB300\uB85C \uC99D\uC5B8\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434828
    m_Localized: "\uC0AC\uC81C \uB9D0 \uD55C \uB9C8\uB514\uB85C \uAD6D\uACBD\uC774
      \uC870\uC6A9\uD574\uC9C0\uC9C4 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434829
    m_Localized: "\uC555\uB2C8\uB2E4. \uADF8\uB798\uC11C \uC804\uBD80\uAC00 \uC544\uB2C8\uB77C
      \u2014 \uC774 \uD55C \uACE8\uC9DC\uAE30, \uC774 \uD55C \uBC88\uC758 \uCDA9\uB3CC\uB9CC.
      \uC5EC\uAE30\uC11C\uB9CC \uBA48\uCD94\uC790\uB294 \uAC81\uB2C8\uB2E4. \uC791\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434830
    m_Localized: "\uD68C\uC870. \uC791\uAC8C \uC2DC\uC791\uD558\uC790. \uD615\uC81C
      \uB9D0 \uD55C \uBC88 \uB4E4\uC5B4 \uBD10. \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB4E4\uC5C8\uC744
      \uB54C \uB108 \uC190\uD574 \uBCF8 \uC801 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434831
    m_Localized: "\uD68C\uC870\uAC00 \uC774\uBE68\uBC14\uB78C\uC744 \uC624\uB798
      \uBCF8\uB2E4. \uAC08\uD034 \uB05D\uC774 \uD759\uC5D0 \uB2FF\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434832
    m_Localized: "...\uD55C \uACE8\uC9DC\uAE30. \uC784\uC2DC\uC57C. \uADF8\uB9AC\uACE0
      \uC774\uAC74 \uD654\uD574\uAC00 \uC544\uB2C8\uC57C \u2014 \uB0B4\uAC00 \uBB34\uB9AC\uD55C\uD14C
      \uC124\uBA85\uD560 \uC218 \uC788\uB294 \uC120\uAE4C\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434833
    m_Localized: "\uCDA9\uBD84\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434834
    m_Localized: "\uD68C\uC870\uAC00 \uBB34\uB9AC\uC5D0\uAC8C \uC190\uC9D3\uD55C\uB2E4.
      \uC62C\uB77C\uAC00 \uC788\uB358 \uD65C\uC774 \uB0B4\uB824\uAC04\uB2E4. \uACE8\uC9DC\uAE30\uC5D0
      \uBC14\uB78C \uC18C\uB9AC\uB9CC \uB0A8\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434835
    m_Localized: "\uD615\uC81C. \uC774 \uACE8\uC9DC\uAE30\uB294 \uC624\uB298\uBD80\uD130
      \uC870\uC6A9\uD574. \uB0B4\uAC00 \uBB34\uB9AC\uD55C\uD14C \uADF8\uB807\uAC8C
      \uC804\uD560\uAC8C. ...\uADF8 \uC774\uC0C1\uC740 \uC57D\uC18D \uBABB \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434836
    m_Localized: "\uADF8 \uC774\uC0C1\uC740 \uC548 \uBC14\uB790\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434837
    m_Localized: "\uAC70\uC9D3\uB9D0. \uB108\uB294 \uB298 \uADF8 \uC774\uC0C1\uC744
      \uBC14\uB77C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434838
    m_Localized: "...\uADF8\uB798. \uBC14\uB77C. \uADFC\uB370 \uC624\uB298\uC740
      \uC774\uB9CC\uD07C\uB9CC \uBC1B\uC744\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434839
    m_Localized: "\uD68C\uC870\uAC00 \uB3CC\uC544\uC120\uB2E4. \uD55C \uBC1C \uB5BC\uACE0
      \uBA48\uCD98\uB2E4. \uB3CC\uC544\uBCF4\uC9C0\uB294 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434840
    m_Localized: "...\uD615\uC81C. \uBCC0\uBC29\uBB38\uC5D0\uC11C \uC0C8\uC5B4 \uB098\uC628
      \uAC70, \uADF8\uAC8C \uAC70\uAE30 \uD558\uB098\uBFD0\uC77C \uAC83 \uAC19\uC544?
      \uBCC0\uBC29 \uACF3\uACF3\uC5D0\uC11C \uAC19\uC740 \uAC8C \uC62C\uB77C\uC624\uACE0
      \uC788\uC5B4. \uD751\uC9C0\uB3C4 \uCE68\uC6D4\uB3C4 \uBC8C\uC368 \uB0C4\uC0C8\uB97C
      \uB9E1\uC558\uACE0. \uB108\uB294 \uB05D\uAE4C\uC9C0 \uCAD3\uC744 \uAC70\uC57C.
      \uADF8\uB7EC\uB2E4 \u2014 \uBABB \uB0B4\uB824\uB193\uAC8C \uB3FC. \uB098\uB294
      \uB108\uB97C \uC54C\uC544\uC11C \uD558\uB294 \uB9D0\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434841
    m_Localized: "\uD68C\uC870\uC640 \uBB34\uB9AC\uAC00 \uC548\uAC1C \uC18D\uC73C\uB85C
      \uB4E4\uC5B4\uAC04\uB2E4. \uC774\uBE68\uBC14\uB78C\uC740 \uD615\uC81C\uAC00
      \uC0AC\uB77C\uC9C4 \uC790\uB9AC\uB97C \uD55C\uCC38 \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434842
    m_Localized: "...\uAD1C\uCC2E\uC73C\uC2ED\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434843
    m_Localized: "\uC548 \uAD1C\uCC2E\uC544. \uADF8\uB7F0\uB370 \u2014 \uC6B0\uB9AC\uAC00
      \uBC29\uAE08 \uD55C \uACE8\uC9DC\uAE30\uB97C \uBA48\uCDC4\uC5B4, \uC0AC\uC81C.
      \uB9CC\uB09C \uC9C0 \uC774\uD2C0 \uB41C \uB450 \uC0AC\uB78C\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434844
    m_Localized: "\uC608. \uBA48\uCDC4\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434845
    m_Localized: "\uC791\uB124. \uADFC\uB370 \uD070 \uAC83\uB3C4 \uB2E4 \u2014 \uC774\uB9CC\uD55C
      \uB370\uC11C \uC2DC\uC791\uD558\uB294 \uAC70 \uC544\uB2C8\uC5C8\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434846
    m_Localized: "\uC7BF\uACE8 \uCABD\uC5D0\uC11C \uD55C\uC0C8\uC758 \uB4F1\uBD88\uC774
      \uBA40\uB9AC \uBCF4\uC778\uB2E4. \uB450 \uBC1C\uC790\uAD6D\uC774 \uADF8\uCABD\uC73C\uB85C
      \uD5A5\uD55C\uB2E4. \uACE8\uC9DC\uAE30\uB294, \uC624\uB298\uC740, \uC870\uC6A9\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434847
    m_Localized: "\uC7BF\uACE8. \uD55C\uC0C8\uAC00 \uAC70\uC810 \uBB38 \uC55E\uC5D0\uC11C
      \uB4F1\uBD88\uC744 \uB4E4\uACE0 \uAE30\uB2E4\uB9B0\uB2E4. \uACE8\uC9DC\uAE30
      \uCABD\uC5D0\uC11C \uB450 \uC0AC\uB78C\uC758 \uBC1C\uC790\uAD6D\uC774 \uB3CC\uC544\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434848
    m_Localized: "\uB450 \uBD84 \uB2E4 \uC0B4\uC544 \uB3CC\uC544\uC624\uC168\uB124\uC694.
      ...\uACE8\uC9DC\uAE30 \uD55C\uCABD\uC774 \uC870\uC6A9\uD574\uC84C\uB2E4\uB294
      \uC18C\uC2DD\uC774 \uBC1C\uBCF4\uB2E4 \uBA3C\uC800 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434849
    m_Localized: "\uC18C\uC2DD\uC774 \uBC1C\uBCF4\uB2E4 \uBE60\uB974\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434850
    m_Localized: "\uBA85\uBD80\uC5D0 \uC801\uACA0\uC2B5\uB2C8\uB2E4. \uBCC0\uBC29\uBB38
      \uD55C \uACE8\uC9DC\uAE30, \uC784\uC2DC \uC815\uC804. \uC194\uB77C\uB8F8 \uC0AC\uC81C\uC640
      \uC774\uB9AC\uC194 \uC0AC\uB0E5\uAFBC \uACF5\uB3D9 \uC911\uAC1C. ...\uC774\uB7F0
      \uC904\uC740 \uC7BF\uACE8 \uBA85\uBD80\uC5D0 \uCC98\uC74C \uC801\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434851
    m_Localized: "\uC5EC\uAD00 \uCABD\uC5D0\uC11C \uB2EC\uBAA9\uC774 \uCC3B\uC8FC\uC804\uC790\uB97C
      \uB4E4\uACE0 \uB098\uC628\uB2E4. \uAE40\uC774 \uCC9C\uCC9C\uD788 \uC624\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434852
    m_Localized: "\uC7AC \uB0C4\uC0C8 \uBB3B\uD788\uACE0\uB4E4 \uC624\uC168\uB124\uC694.
      \uCC28 \uB450 \uC794, \uB530\uB73B\uD558\uAC8C\uC694. \uC774\uB9AC\uC194 \uBB34\uB9AC
      \uBD84\uB3C4 \uC6B0\uB9AC \uC5EC\uAD00\uC5D0\uC120 \uAC19\uC740 \uC790\uB9AC\uC608\uC694.
      \uC7BF\uACE8\uC740 \uADF8\uB807\uAC8C \uC791\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434853
    m_Localized: "\uC194\uB77C\uB8F8 \uB9C8\uC744\uC5D0\uC11C \uADF8\uB7F0 \uB9D0\uC740
      \uCC98\uC74C \uB4E4\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434854
    m_Localized: "\uBCC0\uBC29\uC774\uB2C8\uAE4C\uC694. \uBCC0\uBC29\uC5D0\uC120
      \uC790\uB9AC\uBD80\uD130 \uB0B4\uC8FC\uACE0, \uC774\uB984\uC740 \uCC9C\uCC9C\uD788
      \uBB3B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434855
    m_Localized: "\uC7A1\uD654\uC0C1 \uC194\uAE38\uC774 \uD5A5\uCD08 \uD55C \uC790\uB8E8\uB97C
      \uB4E4\uACE0 \uB2E4\uAC00\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434856
    m_Localized: "\uD68C\uC870 \uADF8\uBD84, \uC6B0\uB9AC \uAC00\uAC8C \uB2E8\uACE8\uC774\uC168\uC5B4\uC694.
      \uC774\uB9AC\uC194 \uBD80\uC871\uC774\uB77C\uB3C4 \uC88B\uC740 \uBD84\uC774\uC168\uB294\uB370.
      \uC0AC\uC81C\uB2D8, \uD5A5\uCD08 \uD55C \uC790\uB8E8 \u2014 \uADF8\uBD84 \uCABD\uC73C\uB85C
      \uD55C \uBC88 \uCF1C \uB4DC\uB9AC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434857
    m_Localized: "\uD68C\uC870 \uC528\uB294 \uC0B4\uC544 \uC788\uC2B5\uB2C8\uB2E4.
      \uAE38\uC774 \uAC08\uB838\uC744 \uBFD0\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434858
    m_Localized: "\uADF8\uB7EC\uBA74 \uB354 \uC88B\uC9C0\uC694. \uC0B0 \uC0AC\uB78C\uD55C\uD14C
      \uCF1C\uB294 \uD5A5\uCD08\uAC00 \uB354 \uC624\uB798 \uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434859
    m_Localized: "\uD615\uC81C\uAC00 \uC0B4\uC544 \uC788\uB294\uB370 \uD5A5\uCD08\uB97C
      \uCF20\uB2E4\uB77C. ...\uC6C3\uAE30\uB294 \uB9D0\uC778\uB370, \uC2EB\uC9C0\uB294
      \uC54A\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434860
    m_Localized: "\uBA85\uBD80 \uB9C8\uC9C0\uB9C9 \uC904 \u2014 \uD68C\uC870, \uC0DD\uC874.
      \uBD84\uB9AC \uB178\uC120. \uC774 \uC904\uC740 \uB2EB\uC9C0 \uC54A\uACE0 \uBE44\uC6CC
      \uB450\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434861
    m_Localized: "\uBE44\uC6CC \uB46C. \uD615\uC81C \uC904\uC740 \uB0B4\uAC00 \uC5B8\uC820\uAC00
      \uC9C1\uC811 \uCC44\uC6B8 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434862
    m_Localized: "\uC624\uB298\uC740 \uD55C \uACE8\uC9DC\uAE30\uC600\uC2B5\uB2C8\uB2E4.
      \uC791\uC9C0\uB9CC, \uC791\uC740 \uC77C\uC740 \uC544\uB2C8\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434863
    m_Localized: "Atlas\uC758 \uD574\uC548\uC120\uC774 \uBC88\uC9C4 \uC789\uD06C\uCC98\uB7FC
      \uD750\uB824\uC838 \uC788\uB2E4. \uADF8 \uC544\uB798 \uC624\uB798\uB41C \uBCF4\uB8E8
      \uD45C\uC2DC. \uC774\uB984\uC740 \uAE01\uD600 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434864
    m_Localized: "\uAC00\uB77C\uC549\uC740 \uBCF4\uB8E8. \uD3D0\uC1C4 \uAE30\uB85D\uC774
      40\uB144 \uC804\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434865
    m_Localized: "40\uB144 \uC804\uC5D0 \uB2EB\uC558\uB2E4\uB294 \uAE38\uC5D0 \uBC1C\uC790\uAD6D\uC774
      \uCD95\uCD95\uD574. \uADF8\uAC83\uB3C4 \uD55C\uB458\uC774 \uC544\uB2C8\uC57C.
      \uB2EB\uD78C \uBB38\uC5D0\uC11C\uB294 \uC774\uB7F0 \uB0C4\uC0C8\uAC00 \uC548
      \uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434866
    m_Localized: "\uB204\uAD70\uAC00 \uC544\uC9C1 \uB4DC\uB098\uB4E0\uB2E4\uB294
      \uB73B\uC774\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434867
    m_Localized: "\uB2E8\uB9B0\uC774 \uC9C0\uB3C4 \uAC00\uC7A5\uC790\uB9AC\uC758
      \uBD09\uC778\uC744 \uD655\uC778\uD55C\uB2E4. \uBC31\uC0C9 \uBC00\uB78D. \uCD5C\uADFC
      \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434868
    m_Localized: "\uB2E8\uD604 \uD559\uD30C\uC758 \uBD09\uC778\uC785\uB2C8\uB2E4.
      \uD3D0\uC1C4\uB41C \uBCF4\uB8E8\uAC00 \uC544\uB2C8\uC5D0\uC694 \u2014 \uD559\uD30C\uAC00
      \uC9C0\uAE08\uB3C4 \uC4F0\uACE0 \uC788\uB294 \uC790\uB9AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434869
    m_Localized: "\uB2E8\uD604 \uD559\uD30C. \uB124\uAC00 \uC0AC\uC81C \uB41C \uADF8
      \uD559\uD30C \uB9DE\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434870
    m_Localized: "...\uC81C\uAC00 \uBC30\uC6B4 \uAE30\uB3C4\uC758 \uBFCC\uB9AC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434871
    m_Localized: "\uADF8\uB7FC \uAC00 \uBCF4\uC790. \uADF8 \uBFCC\uB9AC\uAC00 \uBB3C\uBC11\uC5D0\uC11C
      \uBB58 \uD558\uACE0 \uC788\uC5C8\uB294\uC9C0. \uC0AC\uC81C\uB294 \uBAA8\uB974\uB294
      \uB208\uCE58\uB2C8\uAE4C \u2014 \uB0C4\uC0C8\uB294 \uB0B4\uAC00 \uBA3C\uC800
      \uB9E1\uC544 \uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434872
    m_Localized: "\uB300\uB9AC\uC11D \uAE30\uB465\uC774 \uBB3C\uC18D\uC73C\uB85C
      \uAE30\uC6B8\uC5B4\uC838 \uC788\uB2E4. \uBCF5\uB3C4 \uCC9C\uC7A5\uC5D0 \uC794\uC744
      \uBC1B\uB4DC\uB294 \uB124 \uC190\uC758 \uBD80\uC870\uAC00 \uC0C8\uACA8\uC838
      \uC788\uB2E4. \uD55C \uC190\uB9CC \uAE01\uD600 \uB098\uAC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434873
    m_Localized: "...\uB300\uC131\uB2F9 \uBB38\uC591\uC785\uB2C8\uB2E4. \uC131\uB2F9
      \uCC9C\uC7A5\uC5D0\uB9CC \uC788\uC5B4\uC57C \uD558\uB294 \uBD80\uC870\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434874
    m_Localized: "\uC5EC\uAE30\uAC00 \uC131\uB2F9\uC774\uC57C? \uBB3C\uC5D0 \uC7A0\uAE34
      \uC131\uB2F9?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434875
    m_Localized: "\uC544\uB2C8\uC694. \uAD70\uC0AC \uBCF4\uB8E8\uC785\uB2C8\uB2E4.
      \uC131\uB2F9 \uBB38\uC591\uC774 \uAD70\uC0AC \uBCF4\uB8E8 \uCC9C\uC7A5\uC5D0
      \uC788\uC744 \uC774\uC720\uAC00 \uC5C6\uC5B4\uC694. \uADF8\uB798\uC11C \uC774\uC0C1\uD55C
      \uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434876
    m_Localized: "\uB2E8\uB9B0\uC774 \uC816\uC740 \uBCBD\uC744 \uB9CC\uC9C4\uB2E4.
      \uC190\uB05D \uC544\uB798\uB85C \uC775\uC219\uD55C \uAE30\uB3C4\uBB38 \uCCAB
      \uC904\uC774 \uB4DC\uB7EC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434877
    m_Localized: "\uC815\uACB0\uC740 \uC9C8\uC11C\uC758 \uCCAB \uAC78\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434878
    m_Localized: "\uAD70\uB300 \uBCF4\uB8E8 \uBCBD\uC5D0 \uAE30\uB3C4\uBB38\uC744
      \uC0C8\uACA8 \uB1A8\uB124. \uB108\uD76C\uB294 \uCE7C \uC606\uC5D0 \uAE30\uB3C4\uB97C
      \uB450\uB294 \uC0AC\uB78C\uB4E4\uC778\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434879
    m_Localized: "\uC785\uD68C\uC2DD \uB54C \uC678\uC6B4 \uBB38\uC7A5\uC785\uB2C8\uB2E4.
      ...\uC774 \uBCBD\uC5D0 \uC788\uC744 \uBB38\uC7A5\uC774 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434880
    m_Localized: "\uAC19\uC740 \uBB38\uC7A5 \uC544\uB798\uC5D0 \uB2E4\uB978 \uAE00\uC528\uAC00
      \uB367\uC0C8\uACA8\uC838 \uC788\uB2E4. \u2018\uC815\uD654 \uC7AC\uD310\uC7A5\uC73C\uB85C
      \uC774\uC1A1.\u2019"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434881
    m_Localized: "\uAE30\uB3C4\uBB38 \uBC14\uB85C \uBC11\uC5D0 \uD310\uACB0 \uAE30\uB85D\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uAC19\uC740 \uB04C\uB85C, \uC774\uC5B4\uC11C \uC0C8\uACBC\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434882
    m_Localized: "\uBD09\uC778 \uD615\uC2DD\uB3C4 \uBCF8 \uB300\uC131\uB2F9 \uC591\uC2DD\uC785\uB2C8\uB2E4.
      \uBCC0\uBC29 \uD559\uD30C \uD63C\uC790 \uB2EB\uC740 \uBB38\uC774 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434883
    m_Localized: "\uAE30\uB3C4\uB97C \uC0C8\uAE30\uACE0, \uADF8 \uBC11\uC5D0 \uB204\uAD6C
      \uC8FD\uC77C\uC9C0 \uC801\uACE0. \uAC19\uC740 \uC190\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434884
    m_Localized: "\uBCF4\uB8E8 \uC548\uCABD\uC5D0\uC11C \uCCA0\uBB38\uC774 \uC6C0\uC9C1\uC778\uB2E4.
      \uBB3C\uC774 \uAC80\uC740 \uACC4\uB2E8 \uC544\uB798\uB85C \uBE60\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434885
    m_Localized: "\uBB3C \uBE60\uC9C0\uB294 \uC18C\uB9AC\uC5D0 \uBC1C\uC18C\uB9AC\uAC00
      \uC11E\uC5EC. \uC0C8 \uAC11\uC637 \uB0C4\uC0C8\uC57C \u2014 \uAE30\uB984\uC774
      \uC544\uC9C1 \uC548 \uB9D0\uB790\uC5B4. \uC774 \uBCF4\uB8E8, \uBE44\uC5B4 \uC788\uB294
      \uAC8C \uC544\uB2C8\uB77C \uD559\uD30C\uAC00 \uC0AC\uB78C\uC744 \uC138\uC6CC\uC11C
      \uC9C0\uD0A4\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434886
    m_Localized: "\uAE30\uB85D\uC2E4\uC740 \uC704\uCABD \uC120\uBC18\uB9CC \uBB3C\uC5D0
      \uC7A0\uAE30\uC9C0 \uC54A\uC558\uB2E4. \uB2E8\uB9B0\uC774 \uAC00\uC7A5 \uB9C8\uB978
      \uCC45\uC744 \uAEBC\uB0B8\uB2E4. \uD45C\uC9C0\uC5D0 \uBC31\uAE08 \uC789\uD06C\uB85C
      \uC774\uB984\uC774 \uC801\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434887
    m_Localized: "\uD45C\uC9C0 \uC548\uCABD\uC5D0\uB294 \uC911\uC559 \uBB38\uC11C\uACE0
      \uC591\uC2DD\uC758 \uC0AC\uBCF8 \uBC88\uD638\uAC00 \uB20C\uB824 \uC788\uB2E4.
      \uC774 \uCC45\uC740 \uC5EC\uAE30\uC5D0\uB9CC \uB0A8\uC740 \uAE30\uB85D\uC774
      \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434888
    m_Localized: "\uB2E8\uD604 \uC2A4\uD134\uD640\uD2B8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434889
    m_Localized: "\uC544\uB294 \uC774\uB984\uC778\uAC00 \uBCF4\uB124. \uB204\uAD70\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434890
    m_Localized: "\uCD08\uB300 \uD559\uC790\uC7A5\uC785\uB2C8\uB2E4. \uC81C\uAC00
      \uBC30\uC6B4 \uAE30\uB3C4\uB3C4, \uAD50\uB9AC\uB3C4, \uB2E4 \uC774\uBD84\uC5D0\uAC8C\uC11C
      \uC2DC\uC791\uB410\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434891
    m_Localized: "\uB2E8\uB9B0\uC758 \uC190\uAC00\uB77D\uC774 \uC0AC\uC81C\uBCF5
      \uC790\uC218 \uB05D\uC5D0 \uB2FF\uB294\uB2E4. \uC5B4\uBA38\uB2C8\uAC00 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uB9CC\uC838 \uC900 \uC790\uB9AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434892
    m_Localized: "\uC5B4\uBA38\uB2C8\uAC00 \uC774\uBD84 \uBB38\uC7A5\uC744 \uC88B\uC544\uD558\uC168\uC5B4\uC694.
      \uADF8\uB798\uC11C \uC800\uB97C \uC0AC\uC81C\uB85C \uBCF4\uB0B4\uC168\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434893
    m_Localized: "\uC77D\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434894
    m_Localized: "\uC9C8\uC11C\uB860\uC740 \uAE30\uB85D\uC744 \uBD84\uB958\uD558\uB294
      \uBC95\uC774\uB2E4. \uC720\uBB3C\uACFC \uBB38\uC11C\uC640 \uC99D\uC5B8\uC744
      \uC11E\uC9C0 \uC54A\uC73C\uB824\uB294 \uD559\uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434895
    m_Localized: "\uADF8\uB7EC\uB098 \uC774 \uBD84\uB958\uB97C \uC0AC\uB78C\uC5D0\uAC8C
      \uC368\uC11C\uB294 \uC548 \uB41C\uB2E4. \uC0AC\uB78C\uC744 \uC815\uACB0\uACFC
      \uC624\uC5FC\uC73C\uB85C \uAC00\uB974\uB294 \uC21C\uAC04, \uD559\uBB38\uC740
      \uCE7C\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434896
    m_Localized: "\uB2E8\uB9B0\uC758 \uC785\uC220\uC774 \uBA48\uCD98\uB2E4. \uB2E4\uC74C
      \uBB38\uC7A5\uC740 \uD55C\uCC38 \uC77D\uC9C0 \uBABB\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434897
    m_Localized: "\uC65C \uBA48\uCDB0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434898
    m_Localized: "\uC81C\uAC00 \uBC30\uC6B4 \uC815\uD654 \uAD50\uB9AC\uC5D0... \uC0AC\uB78C\uC744
      \uC624\uC5FC\uC774\uB77C \uBD80\uB974\uB294 \uC7A5\uC774 \uC788\uC5B4\uC694.
      \uADF8\uAC8C \u2014 \uC774 \uACBD\uACE0\uB97C \uADF8\uB300\uB85C \uB4A4\uC9D1\uC740
      \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434899
    m_Localized: "\uD398\uC774\uC9C0 \uB4A4\uCABD\uC5D0 \uB2E4\uB978 \uC190\uAE00\uC528\uAC00
      \uBD99\uC5B4 \uC788\uB2E4. \uD6C4\uB300 \uD559\uD30C\uC758 \uC8FC\uC11D\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434900
    m_Localized: "\uC624\uC5FC \uBD84\uB958\uB294 \uBCC0\uBC29 \uD1B5\uCE58\uB97C
      \uC704\uD574 \uD655\uC7A5 \uAC00\uB2A5. \uC7AC\uD310 \uC808\uCC28\uC5D0 \uC801\uC6A9\uD560
      \uAC83."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434901
    m_Localized: "\uACBD\uACE0\uB97C \uC77D\uACE0, \uCE7C \uB9CC\uB4DC\uB294 \uBC95\uB9CC
      \uBC30\uC6E0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434902
    m_Localized: "\uC608."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434903
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC7A5\uC740 \uC5EC\uB7EC \uBC88 \uC811\uD614\uB2E4
      \uD3B4\uC9C4 \uC790\uAD6D\uC774 \uC788\uB2E4. \uC789\uD06C\uB294 \uBC88\uC84C\uC9C0\uB9CC,
      \uB9C8\uC9C0\uB9C9 \uBB38\uC7A5\uC744 \uAFB9 \uB20C\uB7EC\uC4F4 \uD754\uC801\uB9CC\uC740
      \uC120\uBA85\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434904
    m_Localized: "\uB0B4 \uAE00\uC774 \uC0AC\uB78C\uC744 \uC8FD\uC774\uB294 \uB370
      \uC4F0\uC778\uB2E4\uBA74, \uADF8 \uCE7C\uC740 \uB0B4 \uC190\uC5D0\uC11C \uC2DC\uC791\uB41C
      \uAC83\uC774\uB2E4. \uC774 \uAE30\uB85D\uC744 \uBCF4\uB294 \uC790\uB294, \uAC19\uC740
      \uC2E4\uC218\uB97C \uB418\uD480\uC774\uD558\uC9C0 \uB9D0\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434905
    m_Localized: "\uC800\uB294 \uC774 \uBB38\uC7A5\uC744 \uC704\uC548\uC73C\uB85C
      \uBC30\uC6E0\uC2B5\uB2C8\uB2E4. \uADF8\uB7F0\uB370 \uC4F0\uC2E0 \uBD84\uC740
      \u2014 \uACBD\uACE0\uB85C \uC4F0\uC168\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434906
    m_Localized: "\uB2E4 \uC77D\uC5C8\uC73C\uBA74 \uAC00\uC790. \uC774\uAC70 \uC4F4
      \uC0AC\uB78C\uC740 \uC8FD\uC5C8\uC5B4\uB3C4, \uC774\uAC78\uB85C \uC0AC\uB78C
      \uC8FD\uC774\uB294 \uB188\uB4E4\uC740 \uC0B4\uC544 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434907
    m_Localized: "\uAE38 \uC591\uCABD\uC5D0 \uACE0\uD574\uC18C\uC640 \uCC98\uD615\uB300\uAC00
      \uBC88\uAC08\uC544 \uC11C \uC788\uB2E4. \uACE0\uD574\uC18C \uBB38 \uC548\uCABD\uC5D0\uB294
      \uC190\uD1B1 \uC790\uAD6D\uC774 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434908
    m_Localized: "\uC815\uD654 \uC7AC\uD310\uC7A5\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434909
    m_Localized: "\uC0AC\uB78C\uC744 \uC624\uC5FC\uC73C\uB85C \uBD80\uB974\uB358
      \uACF3."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434910
    m_Localized: "\uC608."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434911
    m_Localized: "\uCC98\uD615\uB300 \uB4A4\uCABD \uBA85\uBD80\uC5D0\uB294 \uC774\uB984\uACFC
      \uBB3C\uAC74\uC774 \uAC19\uC774 \uC801\uD600 \uC788\uB2E4. \uCE7C, \uD1A0\uD15C
      \uC870\uAC01, \uAC00\uC8FD\uB048. \uC555\uC218\uD488 \uBAA9\uB85D\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434912
    m_Localized: "\uD1A0\uD15C \uC870\uAC01."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434913
    m_Localized: "\uADF8\uB294 \uC816\uC740 \uC0C1\uC790 \uC548\uC5D0\uC11C \uC791\uC740
      \uC870\uAC01 \uD558\uB098\uB97C \uAEBC\uB0B8\uB2E4. \uC138 \uAC08\uB798 \uC774\uBE68
      \uBB38\uC591."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434914
    m_Localized: "\uC14B\uC9F8 \uB204\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434915
    m_Localized: "\uAC00\uC871\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434916
    m_Localized: "\uC774\uB984\uC740 \uBA85\uBD80\uC5D0 \uC5C6\uC5B4. \uBB3C\uAC74\uB9CC
      \uC788\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434917
    m_Localized: "\uC0AC\uB78C\uC744 \uC9C0\uC6B0\uACE0, \uBB3C\uAC74\uB9CC \uB0A8\uACBC\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434918
    m_Localized: "\uC774\uC81C \uC54C\uC558\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434919
    m_Localized: "\uB2E8\uB9B0\uC740 \uB2F5\uD558\uC9C0 \uBABB\uD55C\uB2E4. \uBA85\uBD80
      \uC704\uC758 \uC789\uD06C\uAC00 \uBB3C\uC5D0 \uBC88\uC9C4\uB2E4. \uC774\uB984\uC774
      \uC544\uB2C8\uB77C \uBC88\uD638\uB9CC \uB0A8\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434920
    m_Localized: "\uC7AC\uD310\uC7A5 \uB05D\uC5D0 \uC0C8 \uBD09\uC778\uC774 \uBD99\uC5B4
      \uC788\uB2E4. \uC624\uB798\uB41C \uD53C \uC704\uC5D0 \uC0C8 \uBC00\uB78D. \uB2E8\uD604
      \uD559\uD30C\uC758 \uBC31\uC0C9 \uC778\uC7A5\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434921
    m_Localized: "\uC0AC\uC81C \uB2E8\uB9B0. \uC774\uB2E8\uACFC \uB3D9\uD589\uD55C
      \uC8C4\uB85C \uC5F4\uB78C \uAD8C\uD55C\uC744 \uBC15\uD0C8\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434922
    m_Localized: "\uC774\uB2E8\uC774\uB77C \uBD80\uB974\uB294 \uADFC\uAC70\uB294
      \uBB34\uC5C7\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434923
    m_Localized: "\uC624\uC5FC \uBD84\uB958."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434924
    m_Localized: "\uB2E8\uD604\uC740 \uADF8 \uBD84\uB958\uB97C \uC0AC\uB78C\uC5D0\uAC8C
      \uC4F0\uC9C0 \uB9D0\uB77C\uACE0 \uC801\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434925
    m_Localized: "\uCD08\uB300 \uD559\uC790\uC758 \uACBD\uACE0\uB294 \uD6C4\uB300
      \uD559\uC790\uAC00 \uD574\uC11D\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434926
    m_Localized: "\uC8FD\uC740 \uC0AC\uB78C \uAE00\uAE4C\uC9C0 \uB72F\uC5B4\uBA39\uB294\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434927
    m_Localized: "\uC624\uC5FC\uB41C \uC99D\uC5B8\uC740 \uAE30\uB85D\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434928
    m_Localized: "\uADF8\uB7FC \uC81C\uAC00 \uAE30\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434929
    m_Localized: "\uACA9\uD22C. \uC9D1\uD589\uAD00\uC774 \uC4F0\uB7EC\uC9C4\uB2E4.
      \uC0C8 \uBD09\uC778\uC774 \uBB3C\uC5D0 \uB5A8\uC5B4\uC9C0\uACE0, \uD770 \uBC00\uB78D\uC774
      \uAC80\uC740 \uBB3C \uC704\uB85C \uD480\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434930
    m_Localized: "\uC815\uACB0\uC740... \uC9C8\uC11C\uC758..."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434931
    m_Localized: "\uCCAB \uAC78\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434932
    m_Localized: "\uB2E8\uB9B0\uC774 \uADF8 \uBB38\uC7A5\uC744 \uB05D\uAE4C\uC9C0
      \uB9D0\uD55C\uB2E4. \uCC98\uC74C\uC73C\uB85C, \uC678\uC6B0\uC9C0 \uC54A\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434933
    m_Localized: "\uC81C\uAC00 \uD3C9\uC0DD \uC678\uC6B4 \uAE30\uB3C4\uAC00, \uC774
      \uBCBD\uC758 \uBB38\uC7A5\uACFC \uAC19\uC740 \uACF3\uC5D0\uC11C \uB098\uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434934
    m_Localized: "\uC0AC\uC81C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434935
    m_Localized: "...\uC544\uB2D9\uB2C8\uB2E4. \uC544\uB2C8, \uADF8\uAC8C \u2014
      \uC800\uB294 \uC544\uC9C1 \uC0AC\uC81C\uC608\uC694. \uADF8\uB7F0\uB370 \uC608\uC804\uACFC
      \uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C\uB294, \uBABB \uC678\uC6B0\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434936
    m_Localized: "\uC7AC\uD310\uC7A5 \uB4A4\uCABD \uBB38\uC774 \uC5F4\uB9B0\uB2E4.
      \uC774\uB984 \uC5C6\uB294 \uC720\uACE8\uD568\uC774 \uC904\uC9C0\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434937
    m_Localized: "\uC720\uACE8\uD568\uC5D0\uB294 \uC774\uB984\uC774 \uC5C6\uB2E4.
      \uC555\uC218\uD488 \uBC88\uD638\uB9CC \uBD99\uC5B4 \uC788\uB2E4. \uD1A0\uD15C
      \uC870\uAC01, \uC0AC\uB0E5\uCE7C, \uC544\uC774\uC758 \uAC00\uC8FD\uB048."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434938
    m_Localized: "\uC14B\uC9F8 \uB204\uC774."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434939
    m_Localized: "\uADF8\uB294 \uD1A0\uD15C \uC870\uAC01\uC744 \uBC14\uB2E5\uC5D0
      \uB193\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434940
    m_Localized: "\uD070 \uD615."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434941
    m_Localized: "\uC0AC\uB0E5\uCE7C\uC774 \uB193\uC778\uB2E4. \uCE7C\uC9D1 \uB05D\uC774
      \uB2F3\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434942
    m_Localized: "\uB458\uC9F8 \uB9C9\uB0B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434943
    m_Localized: "\uAC00\uC8FD\uB048\uC774 \uB193\uC778\uB2E4. \uB108\uBB34 \uC791\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434944
    m_Localized: "\uB4E3\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434945
    m_Localized: "\uC0AC\uACFC \uC548 \uD574?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434946
    m_Localized: "\uC81C\uAC00 \uC0AC\uACFC\uD574\uB3C4 \uC544\uBB34\uB3C4 \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434947
    m_Localized: "\uADF8\uB7FC \uBB58 \uD560 \uAC74\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434948
    m_Localized: "\uC774\uB984\uC744 \uD2C0\uB9AC\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434949
    m_Localized: "\uAE30\uB85D \uB9D0\uACE0 \uAE30\uC5B5\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434950
    m_Localized: "\uC608. \uAE30\uC5B5\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uD2C0\uB9AC\uBA74,
      \uB2E4\uC2DC \uB9D0\uC500\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434951
    m_Localized: "\uB2E8\uB9B0\uC774 \uBB35\uC8FC\uB97C \uAEBC\uB0B4\uC9C0 \uC54A\uB294\uB2E4.
      \uB300\uC2E0 \uC816\uC740 \uBA85\uBD80\uC758 \uBE48 \uC5EC\uBC31\uC5D0 \uC138
      \uD45C\uC2DD\uC744 \uADF8\uB9B0\uB2E4. \uC138 \uAC08\uB798 \uC774\uBE68. \uD070
      \uBC1C\uC790\uAD6D. \uC791\uC740 \uC774\uBE68."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434952
    m_Localized: "\uADF8\uB9BC \uBABB \uADF8\uB9AC\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434953
    m_Localized: "\uB2E4\uC2DC \uADF8\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434954
    m_Localized: "\uBB3C\uC774 \uBC1C\uBAA9\uAE4C\uC9C0 \uCC28\uC624\uB978\uB2E4.
      \uC774\uBE68\uBC14\uB78C\uC740 \uBA3C\uC800 \uB098\uAC00\uC9C0 \uC54A\uB294\uB2E4.
      \uB2E8\uB9B0\uC774 \uC138 \uD45C\uC2DD\uC744 \uB2E4 \uADF8\uB9B4 \uB54C\uAE4C\uC9C0
      \uAE30\uB2E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434955
    m_Localized: "\uC7BF\uACE8 \uAC70\uC810. \uB2E8\uB9B0\uC740 \uD488\uC5D0 \uB2E8\uD604
      \uC77C\uC9C0\uB97C \uC548\uACE0, \uC774\uBE68\uBC14\uB78C\uC740 \uCC9C\uC5D0
      \uC2FC \uC791\uC740 \uAFB8\uB7EC\uBBF8\uB97C \uB4E4\uACE0 \uB4E4\uC5B4\uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434956
    m_Localized: "\uBCF4\uB8E8\uC5D0\uC11C \uB3CC\uC544\uC624\uC168\uAD70\uC694.
      ...\uB450 \uBD84 \uB2E4, \uB4E4\uACE0 \uB098\uC628 \uAC8C \uC788\uC73C\uC2DC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434957
    m_Localized: "\uAE30\uB85D \uD558\uB098\uD558\uACE0, \uC774\uB984 \uC14B\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434958
    m_Localized: "\uB300\uC7A5\uAC04 \uCABD\uC5D0\uC11C \uC1E0\uB9E4\uAC00 \uB9DD\uCE58\uB97C
      \uB0B4\uB824\uB193\uACE0 \uB2E4\uAC00\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434959
    m_Localized: "\uAC00\uB77C\uC549\uC740 \uBCF4\uB8E8\uB77C. ...30\uB144 \uC804\uC5D0
      \uAC70\uAE30\uC11C \uB9C8\uC9C0\uB9C9 \uC57C\uC601\uC744 \uD55C \uB3D9\uB8CC\uAC00
      \uC788\uC5C8\uC5B4. \uCE68\uBAB0\uD55C \uC904 \uC54C\uC558\uB354\uB2C8, \uD559\uD30C\uAC00
      \uC4F0\uACE0 \uC788\uC5C8\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434960
    m_Localized: "\uD559\uD30C\uAC00 \uC0AC\uB78C\uC744 \uC138\uC6CC\uC11C \uC9C0\uD0A4\uACE0
      \uC788\uC5C8\uC5B4. \uBE44\uC5B4 \uC788\uB358 \uAC8C \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434961
    m_Localized: "...\uADF8\uB807\uAD70. \uBE48 \uC904 \uC54C\uC558\uB358 \uC790\uB9AC\uAC00
      \uC81C\uC77C \uC704\uD5D8\uD558\uC9C0. \uB2E8\uAC80 \uC190\uC9C8\uC740 \uB2E4\uC74C\uC5D0
      \uBC1B\uC544. \uC624\uB298\uC740 \uC190\uC774 \uBB34\uAC70\uC6CC \uBCF4\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434962
    m_Localized: "\uB2EC\uBAA9\uC774 \uCC3B\uC794\uC744 \uB0B4\uB824\uB193\uB294\uB2E4.
      \uC774\uBE68\uBC14\uB78C\uC774 \uB4E0 \uAFB8\uB7EC\uBBF8\uB97C \uD55C \uBC88
      \uBCF4\uACE0, \uB354 \uBB3B\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434963
    m_Localized: "\uC774\uBE68\uBC14\uB78C \uBB34\uB9AC \uBD84. \uC190\uC5D0 \uB4E0
      \uAC70, \uBB34\uAC81\uC9C0\uC694. ...\uBB34\uAC70\uC6B4 \uAC74 \uBB3B\uC9C0
      \uC54A\uC744\uAC8C\uC694. \uCC28\uB9CC \uB530\uB73B\uD558\uAC8C \uB458\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434964
    m_Localized: "...\uACE0\uB9D9\uB124. \uBB3B\uC9C0 \uC54A\uC544\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434965
    m_Localized: "\uBA85\uBD80\uC5D0 \uC801\uC2B5\uB2C8\uB2E4. \uAC00\uB77C\uC549\uC740
      \uBCF4\uB8E8 \u2014 \uB2E8\uD604 \uD559\uD30C \uC0AC\uC6A9 \uC911. \uC815\uD654
      \uC7AC\uD310 \uC81C\uB3C4, \uD604\uC7AC \uC9C4\uD589. \uB2E8\uB9B0 \uC0AC\uC81C,
      \uB2E8\uD604 \uC77C\uC9C0 \uD655\uBCF4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434966
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uD55C \uC904\uC740 \uC544\uC9C1 \uBE44\uC6CC
      \uB450\uC2ED\uC2DC\uC624. \uC774 \uC77C\uC9C0\uB97C \uC5B4\uB5BB\uAC8C \uC4F8\uC9C0\uB294,
      \uC624\uB298 \uBC24 \uBAA8\uB2E5\uBD88 \uC55E\uC5D0\uC11C \uC815\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434967
    m_Localized: "\uBE44\uC6CC \uB450\uACA0\uC2B5\uB2C8\uB2E4. ...\uC7BF\uACE8 \uBA85\uBD80\uB294
      \uBE44\uC6B4 \uC904\uC774 \uC810\uC810 \uB298\uC5B4\uB098\uB294\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434968
    m_Localized: "\uBE44\uC6B4 \uC904\uC774 \uB298\uC5B4\uB09C\uB2E4\uB294 \uAC74
      \uC544\uC9C1 \uC548 \uB05D\uB0AC\uB2E4\uB294 \uAC70\uC57C. \uB05D\uB09C \uBA85\uBD80\uAC00
      \uB354 \uBB34\uC11C\uC6CC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434969
    m_Localized: "\uC7BF\uACE8\uC758 \uBC24. \uBAA8\uB2E5\uBD88 \uC5F0\uAE30\uAC00
      \uCC9C\uB9C9 \uCC9C\uC7A5\uC5D0 \uD55C \uC904 \uBAA8\uC778\uB2E4. \uB2E8\uB9B0\uC774
      \uB2E8\uD604 \uC77C\uC9C0 \uC0AC\uBCF8\uC744 \uBAA8\uB2E5\uBD88 \uAC00\uAE4C\uC774
      \uD3B4\uC11C \uB9D0\uB9AC\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434970
    m_Localized: "\uADF8 \uC77C\uC9C0\uB85C \uBB58 \uD560 \uAC74\uB370. ...\uB610
      \u2018\uAE30\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4\u2019\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434971
    m_Localized: "\uAE30\uB85D\uD558\uACA0\u2014 ...\uC544\uB2C8\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434972
    m_Localized: "\uB2E8\uB9B0\uC774 \uC790\uAE30 \uB9D0\uC744 \uB04A\uB294\uB2E4.
      \uC0AC\uC81C\uBCF5 \uC790\uC218 \uB05D\uC744 \uB9CC\uC9C0\uB358 \uC190\uC774
      \uC778\uC7A5 \uCABD\uC73C\uB85C \uAC00\uB2E4 \uB9CC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434973
    m_Localized: "\uAE30\uB85D\uD558\uBA74 \uC774 \uC0AC\uBCF8\uC740 \uBCF8 \uB300\uC131\uB2F9
      \uC11C\uACE0\uC5D0 \uB4E4\uC5B4\uAC00\uC11C, \uB2E4\uB978 \uAE30\uB85D\uB4E4
      \uC0AC\uC774\uC5D0 \uC548\uC804\uD558\uAC8C \uB07C\uC5B4 \uC788\uACA0\uC9C0\uC694.
      \uC544\uBB34\uB3C4 \uC548 \uBCF4\uAC8C. \uADF8\uAC8C \u2018\uAE30\uB85D\u2019\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434974
    m_Localized: "\uADF8\uAC74 \uC548 \uD569\uB2C8\uB2E4. \uC774 \uC0AC\uBCF8\uC744
      \uC0AC\uC81C\uB2E8 \uD68C\uC758\uC5D0 \uC9C1\uC811 \uB4E4\uACE0 \uAC00\uACA0\uC2B5\uB2C8\uB2E4.
      \uC815\uD654 \uC7AC\uD310\uC744 \uBC00\uC5B4\uBD99\uC774\uB294 \uAC15\uACBD\uD30C
      \uC55E\uC5D0\uC11C \u2014 \uB2E8\uD604 \uBCF8\uC778\uC774 \u2018\uC774 \uD559\uC124\uC744
      \uBB34\uAE30\uB85C \uC4F0\uC9C0 \uB9D0\uB77C\u2019\uACE0 \uC4F4 \uBB38\uC7A5\uC744,
      \uADF8 \uC0AC\uB78C\uB4E4 \uC5BC\uAD74\uC5D0 \uB300\uACE0 \uC77D\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434975
    m_Localized: "\uC0AC\uC81C\uAC00 \uC0AC\uC81C\uB4E4 \uD68C\uC758\uC5D0 \uCE7C\uC744
      \uB4E4\uACE0 \uB4E4\uC5B4\uAC00\uACA0\uB2E4\uB294 \uAC70\uB124. \uC885\uC774
      \uCE7C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434976
    m_Localized: "\uC608. \uC885\uC774\uB77C\uB3C4, \uD718\uB450\uB97C \uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434977
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uB2E8\uB9B0\uC744 \uD55C \uBC88
      \uBCF8\uB2E4. \uBCC0\uBC29\uBB38 \uC55E\uC5D0\uC11C \uBE44\uC6C3\uB358 \uADF8
      \uC0AC\uC81C \uC790\uC138\uAC00 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434978
    m_Localized: "\uADF8 \uD68C\uC758\uC5D0\uC11C \uC6B0\uB9AC \uAC00\uC871 \uC774\uB984\uC744
      \uC77D\uC744 \uAC70\uBA74 \u2014 \uB0B4 \uC774\uB984\uC740 \uBE7C. \uB098\uB294
      \uC544\uC9C1 \uC548 \uC8FD\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434979
    m_Localized: "\uC608. \uBE48 \uC904\uB85C \uB450\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434980
    m_Localized: "\uB2E8\uB9B0\uC774 \uBA85\uBD80\uC5D0 \uBE48 \uC904 \uD558\uB098\uB97C
      \uB0A8\uAE34\uB2E4. \uC774\uBE68\uBC14\uB78C\uC740 \uADF8 \uBE48 \uC904\uC744
      \uBCF4\uACE0 \uC544\uBB34 \uB9D0 \uD558\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434981
    m_Localized: "\uC138 \uAC08\uB798 \uC774\uBE68. \uD070 \uBC1C\uC790\uAD6D. \uC791\uC740
      \uC774\uBE68."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434982
    m_Localized: "\uD2C0\uB838\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434983
    m_Localized: "\uC544\uB2C8. \uBABB\uC0DD\uACBC\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434984
    m_Localized: "\uB2E4\uC2DC \uADF8\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434985
    m_Localized: "\uB0B4\uC77C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434986
    m_Localized: "\uADF8\uB294 \uBA85\uBD80 \uC606\uC5D0 \uC549\uB294\uB2E4. \uB4F1\uC744
      \uB3CC\uB9AC\uC9C0\uB294 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434987
    m_Localized: "\uC0C8\uBCBD. \uAC70\uC810 \uBB38 \uC55E\uC5D0 \uAC80\uC740 \uC885\uC774
      \uD55C \uC7A5\uC774 \uAF42\uD600 \uC788\uB2E4. \uBA39\uC774 \uB9C8\uB974\uC9C0
      \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434988
    m_Localized: "\uB204\uAC00 \uB450\uACE0 \uAC04 \uAC81\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434989
    m_Localized: "\uBC1C\uC790\uAD6D\uC774 \uC5C6\uC5B4. \uC885\uC774\uB9CC \uC654\uC5B4.
      \uB0C4\uC0C8\uB294... \uBA3C\uC9C0, \uC789\uD06C, \uC624\uB798\uB41C \uD53C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434990
    m_Localized: "\uC624\uB798\uB41C \uD53C\uC5D0\uB3C4 \uB0C4\uC0C8\uAC00 \uB0A8\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434991
    m_Localized: "\uB0A8\uC544. \uC9C0\uC6B0\uB824 \uB4E0 \uD53C\uC77C\uC218\uB85D
      \uC624\uB798 \uB0A8\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434992
    m_Localized: "\uC885\uC774\uC5D0\uB294 \uC9E7\uAC8C \uC801\uD600 \uC788\uB2E4.
      '\uBB34\uB108\uC9C4 \uBB18\uC5ED\uC73C\uB85C \uC624\uC9C0 \uB9C8\uB77C. \uC774\uB984\uC740
      \uC0AC\uB78C\uC744 \uC0B4\uB9AC\uAE30\uB3C4 \uD558\uACE0 \uC8FD\uC774\uAE30\uB3C4
      \uD55C\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434993
    m_Localized: "\uD611\uBC15\uC785\uB2C8\uAE4C, \uACBD\uACE0\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434994
    m_Localized: "\uB458 \uB2E4\uC57C. \uC4F4 \uC0AC\uB78C\uC740 \uC6B0\uB9AC\uBCF4\uB2E4
      \uBA3C\uC800 \uBB18\uC5ED\uC744 \uBCF4\uACE0 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434995
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC. \uC8FD\uC740 \uC790\uC758 \uC774\uB984\uC744
      \uC678\uC6B0\uB294 \uC9D1\uB2E8\uC774\uB77C\uACE0 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434996
    m_Localized: "\uC8FD\uC740 \uC790 \uC774\uB984\uC744 \uC65C \uC678\uC6CC. \uC0B0
      \uC0AC\uB78C \uC774\uB984\uB3C4 \uAC00\uB054 \uD5F7\uAC08\uB9AC\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434997
    m_Localized: "\uC774\uB984\uC774 \uC0AC\uB77C\uC9C0\uBA74 \uC8C4\uB3C4 \uC0AC\uB77C\uC9C4\uB2E4\uACE0
      \uBBFF\uB294 \uC790\uB4E4\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434998
    m_Localized: "\uADF8\uB7EC\uBA74 \uC774\uB984\uC744 \uBD99\uC7A1\uB294 \uB188\uB4E4\uB3C4
      \uC788\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967434999
    m_Localized: "\uC608. \uC774\uBC88\uC5D0\uB294 \uADF8 \uC0AC\uB78C\uB4E4\uC744
      \uB9CC\uB098\uB7EC \uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435000
    m_Localized: "\uC11D\uAD00\uC774 \uCE35\uCE35\uC774 \uC313\uC5EC \uC788\uB2E4.
      \uBCBD\uB9C8\uB2E4 \uC774\uB984\uC774 \uC0C8\uACA8\uC838 \uC788\uACE0, \uC9C0\uC6CC\uC9C4
      \uC774\uB984\uC5D0\uB294 \uC0C8 \uBA39\uC774 \uB367\uCE60\uB418\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435001
    m_Localized: "\uC5B4, \uC190\uB2D8\uC774\uB124. \uC624\uB798\uAC04\uB9CC\uC774\uC57C.
      \uD55C 300\uB144? 400\uB144? \uBB50, \uC0C1\uAD00\uC5C6\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435002
    m_Localized: "\uB0C4\uC0C8\uAC00 \uC605\uC5B4. \uC0B0 \uC0AC\uB78C \uB0C4\uC0C8\uC778\uB370
      \uC624\uB798\uB41C \uB3CC \uD2C8\uC5D0 \uBB3B\uD614\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435003
    m_Localized: "\uC88B\uC740 \uCF54\uB124. \uC8FD\uC740 \uC0AC\uB78C\uC740 \uC544\uB2C8\uC57C.
      \uC544\uC9C1\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435004
    m_Localized: "\uB2F9\uC2E0\uC740 \uB204\uAD6C\uC2ED\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435005
    m_Localized: "\uBB35\uD5A5. \uC5EC\uAE30\uC11C\uB294 \uC774\uB984\uC744 \uC9C0\uC6B0\uC9C0
      \uC54A\uAC8C \uBD99\uC7A1\uB294 \uC77C\uC744 \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435006
    m_Localized: "\uC7A5\uB840\uAFBC?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435007
    m_Localized: "\uC7A5\uB840\uB294 \uB05D\uB0AC\uC5B4. \uC6B0\uB9AC\uB294 \uC78A\uB294
      \uAC78 \uB9C9\uB294 \uC0AC\uB78C\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435008
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC\uC758 \uAE30\uC5B5 \uAD00\uB9AC\uAD00\uC774\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435009
    m_Localized: "\uB9DE\uC544. \uC9C1\uD568 \uAE38\uC9C0? \uC904\uC5EC\uC11C \uBB34\uB364\uC9C0\uAE30\uB77C\uACE0
      \uBD80\uB974\uAE30\uB3C4 \uD558\uB294\uB370, \uADF8\uAC74 \uC880 \uCE59\uCE59\uD574\uC11C
      \uC2EB\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435010
    m_Localized: "\uBB35\uD5A5\uC774 \uC11D\uAD00 \uD558\uB098\uB97C \uC190\uAC00\uB77D\uC73C\uB85C
      \uD22D \uCE5C\uB2E4. \uBA3C\uC9C0\uAC00 \uC791\uAC8C \uC77C\uC5B4\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435011
    m_Localized: "\uC774 \uC0AC\uB78C\uC740 270\uB144 \uC804\uC5D0 \uC8FD\uC5C8\uC5B4.
      \uD638\uBC00\uBE75\uC744 \uC88B\uC544\uD588\uACE0, \uAC70\uC9D3\uB9D0\uC744
      \uBABB\uD588\uC9C0. \uAC70\uC9D3\uB9D0\uD558\uBA74 \uC67C\uCABD \uB208\uC379\uC774
      \uC62C\uB77C\uAC14\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435012
    m_Localized: "\uADF8\uB7F0 \uAC83\uAE4C\uC9C0 \uAE30\uC5B5\uD574?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435013
    m_Localized: "\uADF8\uB7F0 \uAC83\uBD80\uD130 \uC0AC\uB77C\uC9C0\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435014
    m_Localized: "\uC774\uB984\uBCF4\uB2E4 \uC0AC\uC18C\uD55C \uAC83\uB4E4\uC774
      \uBA3C\uC800 \uC0AC\uB77C\uC9C0\uB294\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435015
    m_Localized: "\uC751. \uADF8\uB798\uC11C \uC0AC\uC18C\uD55C \uAC78 \uC7A1\uC544
      \uB46C. \uD070 \uC8C4\uC640 \uD070 \uC5C5\uC801\uC740 \uB298 \uB204\uAC00 \uAC00\uC838\uAC00\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435016
    m_Localized: "\uC0AC\uC18C\uD55C \uB0C4\uC0C8\uAC00 \uC9C4\uC9DC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435017
    m_Localized: "\uC5ED\uC2DC \uC88B\uC740 \uCF54\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435018
    m_Localized: "\uCE68\uBB35\uC758 \uAE30\uB85D\uAD00. \uD68C\uC0C1 \uACB0\uC0AC\uAC00
      \uC81C\uC77C \uAE4A\uC740 \uAE30\uB85D\uC744 \uB9E1\uAE30\uB294 \uC790\uB9AC\uC57C.
      \uC0B0 \uC0AC\uB78C\uC774\uACE0, \uB9F9\uC138\uB85C \uADF8 \uBC29\uC744 \uC7A0\uAC00
      \uC628 \uC0AC\uB78C\uC774\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435019
    m_Localized: "\uC6B0\uB9AC\uB294 \uAE30\uB85D\uC744 \uD6D4\uCE58\uB7EC \uC628
      \uAC83\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435020
    m_Localized: "\uC800 \uC0AC\uB78C\uC774 \uC885\uC744 \uCE58\uBA74 \uD751\uC9C0\uC758
      \uBA85\uB2E8\uC774 \uBA3C\uC800 \uC640. \uADF8\uB7EC\uBA74 \uC774 \uBC29\uC740
      \uC77D\uD788\uAE30 \uC804\uC5D0 \uB2E8\uC8C4\uBB38\uC774 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435021
    m_Localized: "\uADF8\uB7FC \uC885\uBD80\uD130 \uC6B8\uB9AC\uC9C0 \uBABB\uD558\uAC8C
      \uC190\uC744 \uBB36\uC5B4. \uC8FD\uC77C \uD544\uC694\uB294 \uC5C6\uC5B4. \uC190\uB9CC
      \uBA48\uCD94\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435022
    m_Localized: "\uAE30\uB85D\uAD00\uC774 \uCE7C\uC744 \uB0B4\uB9B0\uB2E4. \uC624\uB798
      \uC7A0\uAC00 \uC628 \uBC29\uC758 \uBB38\uC5D0\uC11C \uD55C \uBC1C \uBE44\uCF1C\uC120\uB2E4.
      \uBE44\uCF1C\uC11C\uB294 \uAC78\uC74C\uC774 \uAD73\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435023
    m_Localized: "\uBE44\uCF1C \uC92C\uB124. \uC77D\uC5B4\uB3C4 \uB41C\uB2E4\uB294
      \uB73B\uC774\uC57C. \uB9F9\uC138\uB97C \uC5B4\uAE34 \uAC8C \uC544\uB2C8\uB77C,
      \uB9F9\uC138\uBCF4\uB2E4 \uBB34\uAC70\uC6B4 \uAC78 \uBCF8 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435024
    m_Localized: "\uD5C8\uB77D\uBC1B\uC740 \uC9C4\uC2E4\uB3C4 \uBB34\uAC81\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435025
    m_Localized: "\uAC00\uBCBC\uC6B4 \uC9C4\uC2E4\uC740 \uB300\uAC1C \uC7A5\uC2DD\uD488\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435026
    m_Localized: "\uC5F4\uB9B0 \uBC29 \uC548\uCABD, \uAC80\uC740 \uB450\uB8E8\uB9C8\uB9AC
      \uC0AC\uBCF8\uC774 \uB3CC\uBABB\uC5D0 \uACE0\uC815\uB418\uC5B4 \uC788\uB2E4.
      \uC774\uB984\uB4E4\uC774 \uCD18\uCD18\uD788 \uC801\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435027
    m_Localized: "\uB610 \uBA85\uB2E8\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435028
    m_Localized: "\uD751\uC9C0 \uAC83\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435029
    m_Localized: "\uD751\uC9C0? \uC0AC\uB78C \uC774\uB984\uC774\uC57C, \uBB3C\uAC74
      \uC774\uB984\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435030
    m_Localized: "\uC0AC\uB78C. \uC624\uB798\uB41C \uB3D9\uB8CC. \uAE30\uC5B5\uC744
      \uC99D\uC5B8\uC73C\uB85C \uC4F0\uC9C0 \uC54A\uACE0 \uD310\uACB0\uBB38\uC73C\uB85C
      \uC4F0\uB294 \uCABD."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435031
    m_Localized: "\uBB34\uC5C7\uC744 \uD310\uACB0\uD569\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435032
    m_Localized: "\uCCAB \uB3C4\uC2DC\uC758 \uD559\uC0B4. \uADF8\uB9AC\uACE0 \uADF8
      \uD559\uC0B4\uC744 \uC228\uAE34 \uC0AC\uB78C\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435033
    m_Localized: "\uBB35\uD5A5\uC758 \uC190\uAC00\uB77D\uC774 \uD55C \uC904\uC5D0\uC11C
      \uBA48\uCD98\uB2E4. '\uAE30\uB85D\uC744 \uC228\uAE34 \uC790: \uBB35\uD5A5.'"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435034
    m_Localized: "\uB124 \uC774\uB984\uC774 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435035
    m_Localized: "...\uC751. \uB0B4 \uC774\uB984\uC774\uB124. \uAE00\uC528\uB294
      \uC5EC\uC804\uD788 \uC131\uC9C8 \uAE09\uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435036
    m_Localized: "\uBC18\uBC15\uD558\uC9C0 \uC54A\uC73C\uC2ED\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435037
    m_Localized: "\uC774 \uBA85\uB2E8\uC740 \uAC70\uC9D3\uB9D0\uC774 \uC544\uB2C8\uC57C.
      \uB2E4\uB9CC \uC804\uBD80\uB3C4 \uC544\uB2C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435038
    m_Localized: "\uBCBD\uBA74\uC758 \uBA3C\uC9C0\uAC00 \uAC77\uD788\uC790 \uD558\uB098\uC758
      \uB3C4\uC2DC\uAC00 \uB4DC\uB7EC\uB09C\uB2E4. \uAD11\uC7A5 \uD55C\uAC00\uC6B4\uB370\uC5D0\uB294
      \uC6B0\uBB3C\uC774 \uC788\uACE0, \uC6B0\uBB3C\uAC00\uC5D0\uB294 \uB0A1\uC740
      \uBB3C\uB3D9\uC774 \uD558\uB098\uAC00 \uB9E4\uB2EC\uB824 \uC788\uB2E4. \uBB3C\uB3D9\uC774
      \uC190\uC7A1\uC774\uC5D0\uB294 \uB124 \uAC00\uC9C0 \uBB38\uC591\uC774 \uAC19\uC740
      \uB192\uC774\uB85C \uC0C8\uACA8\uC838 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435039
    m_Localized: "\uC194\uB77C\uB8F8 \uC778\uC7A5\uC785\uB2C8\uB2E4. \uADF8\uB7F0\uB370
      \uAC19\uC740 \uC190\uC7A1\uC774\uC5D0... \uC774\uB9AC\uC194 \uD1A0\uD15C\uB3C4
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435040
    m_Localized: "\uBA39 \uBB38\uC591\uB3C4 \uC788\uC5B4. \uC800 \uB9E4\uB4ED \uBB34\uB2AC\uB294
      \uC6B0\uB9AC\uAC00 \uBAA8\uB974\uB294 \uB0C4\uC0C8\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435041
    m_Localized: "\uADF8\uBB3C \uACB0\uC0AC. \uB3C4\uC2DC\uC758 \uBB38\uC744 \uC9C0\uD0A4\uB358
      \uC0AC\uB78C\uB4E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435042
    m_Localized: "\uB2E4\uC74C \uBCBD\uD654\uC5D0\uB294 \uC2DC\uC7A5\uC774 \uC788\uB2E4.
      \uC0AC\uC81C\uBCF5\uC744 \uC785\uC740 \uC544\uC774\uAC00 \uB291\uB300 \uC774\uBE68
      \uBAA9\uAC78\uC774\uB97C \uB9CC\uC9C0\uACE0, \uBA39 \uBB3B\uC740 \uC190\uC758
      \uB178\uC778\uC774 \uBE75\uC744 \uBC18\uC73C\uB85C \uAC00\uB978\uB2E4. \uC544\uBB34\uB3C4
      \uC11C\uB85C\uB97C \uC774\uC0C1\uD558\uAC8C \uBCF4\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435043
    m_Localized: "\uC804\uC7C1 \uC774\uC804\uBD80\uD130 \uB530\uB85C \uC788\uC5C8\uB358
      \uAC8C \uC544\uB2C8\uC5C8\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435044
    m_Localized: "\uB530\uB85C\uC600\uB2E4\uAC00 \uB9CC\uB09C \uAC8C \uC544\uB2C8\uC57C.
      \uD55C \uB3C4\uC2DC\uC5D0\uC11C \uAC08\uB77C\uC9C4 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435045
    m_Localized: "\uC6B0\uB9AC \uC870\uC0C1\uACFC \uB108\uD76C \uC870\uC0C1\uC774
      \uAC19\uC740 \uC6B0\uBB3C\uBB3C\uC744 \uB9C8\uC168\uB2E4\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435046
    m_Localized: "\uC751. \uAC19\uC740 \uC6B0\uBB3C. \uAC19\uC740 \uBE75. \uAC19\uC740
      \uC7A5\uB840 \uB178\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435047
    m_Localized: "\uADF8\uB7F0 \uAE30\uB85D\uC744 \uC65C \uC544\uBB34\uB3C4 \uAC00\uB974\uCE58\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435048
    m_Localized: "\uAC00\uB974\uCE58\uBA74 \uC9C0\uAE08\uC758 \uAE43\uBC1C\uB4E4\uC774
      \uB108\uBB34 \uAC00\uBCBC\uC6CC\uC9C0\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435049
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uBB3C\uB3D9\uC774 \uC190\uC7A1\uC774\uB97C
      \uC190\uAC00\uB77D\uC73C\uB85C \uBB38\uC9C0\uB978\uB2E4. \uD759\uBA3C\uC9C0
      \uC544\uB798 \uB124 \uBB38\uC591\uC740 \uAC19\uC740 \uAE4A\uC774\uB85C \uD30C\uC5EC
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435050
    m_Localized: "\uB2E4\uC74C \uBCBD\uD654\uB294 \uC911\uAC04\uC774 \uAE01\uD600
      \uC788\uB2E4. \uAC19\uC740 \uAD11\uC7A5, \uAC19\uC740 \uC6B0\uBB3C. \uBC14\uB2E5\uC5D0\uB294
      \uAE68\uC9C4 \uC544\uC774 \uC794\uC774 \uAD74\uB7EC\uAC00\uACE0, \uBB3C \uB300\uC2E0
      \uD53C\uAC00 \uC6B0\uBB3C\uAC00 \uD648\uC744 \uB530\uB77C \uD750\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435051
    m_Localized: "\uBCBD\uD654 \uAC00\uC7A5\uC790\uB9AC\uC5D0 \uB124 \uAC00\uC9C0
      \uBB3C\uAC74\uC774 \uC11C\uB85C \uC5C9\uCF1C \uC788\uB2E4. \uC0AC\uC81C \uBB35\uC8FC,
      \uB291\uB300 \uC774\uBE68 \uBAA9\uAC78\uC774, \uBA39 \uBB3B\uC740 \uB450\uB8E8\uB9C8\uB9AC
      \uB048, \uB2EB\uD78C \uB9E4\uB4ED. \uBAA8\uB450 \uD55C \uBC88\uC529 \uB04A\uC5B4\uC838
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435052
    m_Localized: "\uAC00\uD574\uC790\uB294 \uB204\uAD6C\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435053
    m_Localized: "\uD55C\uCABD\uC774\uBA74 \uC26C\uC6E0\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435054
    m_Localized: "\uC804\uBD80\uAC00 \uBB3C\uC5C8\uACE0, \uC804\uBD80\uAC00 \uBB3C\uB838\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435055
    m_Localized: "\uBB35\uD5A5\uC774 \uAE68\uC9C4 \uC544\uC774 \uC794 \uC55E\uC5D0\uC11C
      \uBA48\uCD98\uB2E4. \uC190\uC744 \uBED7\uC5C8\uB2E4\uAC00 \uAC70\uB454\uB2E4.
      \uBA3C\uC9C0\uB9CC \uC544\uC8FC \uC870\uAE08 \uC6C0\uC9C1\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435056
    m_Localized: "\uC774 \uAE30\uB85D\uC758 \uCCAB \uBB38\uC7A5\uC740 \uADF8\uAC70\uC57C.
      \uC6B0\uB9AC\uAC00 \uC8FD\uC600\uACE0, \uC6B0\uB9AC\uAC00 \uC8FD\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435057
    m_Localized: "\uADF8\uB7EC\uBA74 \uC6B0\uB9AC \uAD50\uB9AC\uB3C4, \uBD80\uC871\uC758
      \uBD84\uB178\uB3C4, \uACB0\uC0AC\uC758 \uCE68\uBB35\uB3C4..."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435058
    m_Localized: "\uC804\uBD80 \uAC70\uC9D3\uC740 \uC544\uB2C8\uC57C. \uD558\uC9C0\uB9CC
      \uC804\uBD80 \uC2DC\uC791\uC744 \uC228\uACBC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435059
    m_Localized: "\uC228\uAE34 \uC2DC\uC791\uC740 \uB0C4\uC0C8\uAC00 \uC369\uC5B4.
      \uC5B8\uC820\uAC00 \uB2E4 \uC0C8\uC5B4 \uB098\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435060
    m_Localized: "\uC5B4\uBA38\uB2C8\uAC00 \uAC00\uB974\uCE58\uC2E0 \uC7A5\uB840
      \uAE30\uB3C4\uC5D0\uB294, \uC544\uC774 \uC794\uC744 \uBA3C\uC800 \uCE58\uC6B0\uB77C\uB294
      \uAD6C\uC808\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435061
    m_Localized: "\uC5EC\uAE30\uC11C\uB294 \uC544\uBB34\uB3C4 \uBABB \uCE58\uC6E0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435062
    m_Localized: "\uC544\uBB34\uB3C4 \uBC14\uB85C \uB2E4\uC74C \uBCBD\uD654\uB97C
      \uBCF4\uC9C0 \uC54A\uB294\uB2E4. \uBA3C\uC9C0\uAC00 \uB2E4\uC2DC \uB0B4\uB824\uC549\uC744
      \uB54C\uAE4C\uC9C0, \uB124 \uC0AC\uB78C\uC740 \uAC19\uC740 \uAE68\uC9C4 \uC794
      \uC55E\uC5D0 \uC11C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435063
    m_Localized: "\uBF08\uAC00 \uB098\uBB34\uCC98\uB7FC \uC790\uB77C \uC788\uB2E4.
      \uAC00\uC9C0\uB9C8\uB2E4 \uC791\uC740 \uC774\uB984\uD45C\uAC00 \uB9E4\uB2EC\uB824
      \uC788\uACE0, \uBA87\uBA87\uC740 \uC77C\uBD80\uB7EC \uAE01\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435064
    m_Localized: "\uC232\uC778\uB370 \uC0B4\uC544 \uC788\uC9C0 \uC54A\uC544. \uB3CC
      \uB0C4\uC0C8, \uBF08 \uB0C4\uC0C8, \uADF8\uB9AC\uACE0 \uBB38 \uB0C4\uC0C8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435065
    m_Localized: "\uBB38 \uB0C4\uC0C8\uB77C\uB294 \uAC83\uC774 \uC788\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435066
    m_Localized: "\uC788\uC5B4. \uB4E4\uC5B4\uAC04 \uB188\uC740 \uB9CE\uC740\uB370
      \uB098\uC628 \uB188\uC774 \uC801\uC740 \uACF3\uC5D0\uC11C \uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435067
    m_Localized: "\uC720\uACE8 \uACFC\uC218\uC6D0. \uBB18\uC5ED\uC758 \uB05D\uC774\uACE0,
      \uB3C4\uC2DC \uC785\uAD6C\uC758 \uC2DC\uC791\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435068
    m_Localized: "\uC81C4\uC218\uBB38... \uB2E8\uD604\uC758 \uC77C\uC9C0\uC5D0 \uC788\uB358
      \uB9D0\uC774 \uC5EC\uAE30\uB85C \uC774\uC5B4\uC9C0\uB294\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435069
    m_Localized: "\uB2E8\uD604\uC740 \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uC5B4. \uADF8\uB9AC\uACE0
      \uB3CC\uC544\uAC00\uC9C0 \uBABB\uD588\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435070
    m_Localized: "\uACFC\uC218\uC6D0 \uC911\uC2EC\uC758 \uB3CC\uBB38 \uC55E, \uD65C\uC744
      \uB4E0 \uB0A8\uC790\uAC00 \uC549\uC544 \uC788\uB2E4. \uC7A0\uB4E4\uC5B4 \uC788\uB358
      \uAC83\uCC98\uB7FC \uBCF4\uC774\uC9C0\uB9CC \uB208\uC740 \uC774\uBBF8 \uB728\uC5EC
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435071
    m_Localized: "...\uC2DC\uB044\uB7FD\uB2E4. \uC678\uBD80\uC758 \uB9D0\uC740 \uC774\uB807\uAC8C
      \uB9CE\uC558\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435072
    m_Localized: "\uC0B4\uC544 \uC788\uB294 \uC0AC\uB78C\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435073
    m_Localized: "\uC0B4\uC544 \uC788\uC5B4. \uADF8\uB7F0\uB370 \uC2DC\uAC04 \uB0C4\uC0C8\uAC00
      \uB108\uBB34 \uC624\uB798\uB410\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435074
    m_Localized: "\uB108 \uB204\uAD6C\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435075
    m_Localized: "\uACF5\uD55C. \uC774 \uBB38\uC744 \uB2EB\uC740 \uC190\uC774\uB2E4.
      \uC624\uB798 \uB2EB\uC544 \uB454 \uC190\uC740, \uC5F4 \uB54C\uB3C4 \uBA3C\uC800
      \uB5A8\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435076
    m_Localized: "\uC774 \uB9E4\uB4ED... \uBCF8\uC778\uC774 \uBB36\uC73C\uC168\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435077
    m_Localized: "\uADF8\uB807\uB2E4. \uB0B4 \uC190\uC774 \uBB36\uC740 \uB9E4\uB4ED\uC774\uB2E4.
      \uADF8\uB798\uC11C, \uB0B4\uAC00 \uD480\uC5B4\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435078
    m_Localized: "1800\uB144 \uBB35\uC740 \uC790\uAE30\uC18C\uAC1C\uCE58\uACE0\uB294
      \uC9E7\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435079
    m_Localized: "\uC9E7\uC740 \uB9D0\uBD80\uD130 \uB2E4\uC2DC \uBC30\uC6B4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435080
    m_Localized: "\uC790\uB791\uD560 \uC0DD\uAC01 \uC5C6\uB2E4\uB294 \uB0C4\uC0C8\uB294
      \uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435081
    m_Localized: "\uC790\uB791\uD560 \uC77C\uC774 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435082
    m_Localized: "\uC65C 1800\uB144 \uB3D9\uC548 \uCE68\uBB35\uD558\uC168\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435083
    m_Localized: "\uCCAB\uB0A0, \uC6B0\uB9AC\uB294 \uBB38\uC744 \uB2EB\uC558\uB2E4.
      \uC8C4\uAC00 \uBC16\uC73C\uB85C \uB098\uAC00\uBA74 \uB354 \uB9CE\uC740 \uC0AC\uB78C\uC774
      \uC11C\uB85C\uB97C \uC8FD\uC77C \uAC70\uB77C \uBBFF\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435084
    m_Localized: "\uB2EB\uC544 \uB454 \uB3D9\uC548 \uBC16\uC5D0\uC11C\uB3C4 \uC8FD\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435085
    m_Localized: "\uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435086
    m_Localized: "\uADF8 \uB9D0 \uC9E7\uC544\uC11C \uC2EB\uC5B4. \uC54C\uBA74 \uBB50\uAC00
      \uB2EC\uB77C\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435087
    m_Localized: "\uACF5\uD55C. \uC9E7\uAC8C \uB9D0\uD558\uB294 \uAC74 \uC88B\uC740\uB370,
      \uC8C4\uAE4C\uC9C0 \uC9E7\uC544\uC9C0\uC9C4 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435088
    m_Localized: "\uC6B0\uB9AC\uB294 \uC8FD\uC740 \uC0AC\uB78C\uC744 \uC9C0\uD0A4\uB824
      \uD588\uB2E4. \uC0B0 \uC0AC\uB78C\uC758 \uC785\uC744 \uB2EB\uC544 \uBC84\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435089
    m_Localized: "\uADF8\uB7FC \uC9C0\uAE08\uC740 \uC65C \uC5EC\uC2ED\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435090
    m_Localized: "\uB2E8\uD604\uC758 \uD559\uD30C\uAC00 \uC785\uAD6C\uB97C \uCC3E\uC558\uB2E4.
      \uC6B0\uB9AC\uAC00 \uB9D0\uD558\uC9C0 \uC54A\uC73C\uBA74, \uADF8\uB4E4\uC774
      \uBA3C\uC800 \uB9D0\uD55C\uB2E4. \uCE7C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435091
    m_Localized: "\uD751\uC9C0\uB294 \uB2E8\uC8C4\uB85C \uC5F4\uB824 \uD558\uACE0,
      \uCE68\uC6D4\uC740 \uBC29\uD328\uB85C \uB2EB\uC73C\uB824 \uD574. \uB108\uB294?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435092
    m_Localized: "\uC190\uC73C\uB85C \uC5F4\uACA0\uB2E4. \uC624\uB798 \uB2EB\uC740
      \uC790\uC758 \uC190\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435093
    m_Localized: "\uC5F4\uACE0 \uB3C4\uB9DD\uCE58\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435094
    m_Localized: "\uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435095
    m_Localized: "...\uBB38\uC740 \uD558\uB098\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uC6B0\uB9AC\uAC00
      \uB2EB\uC740 \uAC83\uC740 \uC774\uCABD \uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435096
    m_Localized: "\uADF8\uB7FC \uC6B0\uB9AC\uB3C4 \uAC19\uC774 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      \uD55C\uCABD\uC758 \uB9D0\uC774 \uB418\uAE30 \uC804\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435097
    m_Localized: "\uAD00\uB9DD\uC790. \uADF8\uBB3C \uACB0\uC0AC\uAC00 \uCCAB \uB3C4\uC2DC
      \uC785\uAD6C\uC5D0 \uC138\uC6B0\uB358 \uD30C\uC218\uB2E4. \uC2DC\uC870\uAC00
      \uC790\uB9AC\uB97C \uBE44\uC6B4 \uC0AC\uC774, \uADDC\uC728\uB9CC \uB0A8\uC544
      \uC0AC\uB78C\uC744 \uBB36\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435098
    m_Localized: "\uC9C0\uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4. \uBAA8\uC695\uD558\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435099
    m_Localized: "\uACE0\uC9C4\uD558\uACE0 \uAC19\uC740 \uC790\uB9AC\uC57C. \uC0AC\uB78C\uC740
      \uAC14\uB294\uB370 \uBA85\uB839\uB9CC \uC11C \uC788\uC5B4. \uADF8\uB798\uB3C4
      \u2014 \uBB38 \uC55E\uC5D0\uC11C\uB294 \uC608\uC758 \uC9C0\uD0A4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435100
    m_Localized: "\uC608\uC758 \uC788\uB294 \uC2F8\uC6C0\uC774\uB77C. \uC624\uB798
      \uC0B4\uACE0 \uBCFC \uC77C\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435101
    m_Localized: "\uAD00\uB9DD\uC790\uAC00 \uD55C\uCABD \uBB34\uB98E\uC744 \uAFC7\uB294\uB2E4.
      \uADF8\uAC00 \uB4F1\uC9C0\uACE0 \uB9C9\uB358 \uB3CC\uBB38\uC774 \uCC9C\uCC9C\uD788
      \uC5F4\uB9B0\uB2E4. \uBB38 \uC704\uC5D0 \uB124 \uAC08\uB798 \uBB38\uC591\uC774
      \uAC19\uC740 \uB192\uC774\uB85C \uC0C8\uACA8\uC838 \uC788\uB2E4 \u2014 \uC5B4\uB290
      \uD558\uB098\uB3C4 \uC704\uC5D0 \uC788\uC9C0 \uC54A\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435102
    m_Localized: "\uB9C9\uB358 \uC0AC\uB78C\uC774 \uBE44\uCF30\uB2E4. \uD1B5\uACFC\uD574\uB3C4
      \uB41C\uB2E4\uB294 \uB73B\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435103
    m_Localized: "\uC6B0\uB9AC\uAC00 \uC790\uACA9\uC744 \uC5BB\uC740 \uAC81\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435104
    m_Localized: "\uC544\uB2C8\uB2E4. \uCC45\uC784\uC744 \uBC1B\uC740 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435105
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC740 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0
      \uC54A\uB294\uB2E4. \uC5F4\uB9B0 \uBB38\uD2C8\uC5D0\uC11C \uC62C\uB77C\uC624\uB294
      \uBC14\uB78C\uC744 \uD55C \uBC88, \uAE4A\uAC8C \uB4E4\uC774\uB9C8\uC2E4 \uBFD0\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435106
    m_Localized: "\uB124 \uC0AC\uB78C\uC774 \uC5F4\uB9B0 \uB3CC\uBB38 \uC55E\uC5D0
      \uC120\uB2E4. \uBB38 \uC548\uCABD\uC5D0\uC11C \uC624\uB798\uB41C \uB3C4\uC2DC\uC758
      \uBC14\uB78C\uC774 \uC62C\uB77C\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435107
    m_Localized: "\uB3C4\uC2DC\uB294 \uB2EB\uD600 \uC788\uB2E4. \uADF8\uB7EC\uB098
      \uD559\uD30C\uAC00 \uBB38 \uC55E\uC5D0 \uC654\uB2E4. \uC6B0\uB9AC\uAC00 1800\uB144
      \uC9C0\uD0A8 \uCE68\uBB35\uC774, \uC774\uC81C \uADF8 \uC190\uC5D0\uC11C\uB294
      \uBB34\uAE30\uAC00 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435108
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC\uB3C4 \uB2E4\uB974\uC9C0 \uC54A\uC544.
      \uC6B0\uB9AC\uAC00 \uBAA8\uC740 \uC774\uB984\uC774 \uD751\uC9C0 \uC190\uC5D0\uC11C\uB294
      \uB2E8\uC8C4 \uBA85\uB2E8\uC774 \uB418\uB2C8\uAE4C. \uAC19\uC740 \uAE30\uB85D,
      \uB2E4\uB978 \uCE7C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435109
    m_Localized: "\uADF8\uB798\uC11C \u2014 \uB098\uB294 \uADF8\uBB3C \uACB0\uC0AC\uB97C
      \uB370\uB824\uC624\uACA0\uB2E4. \uACB0\uC0AC\uAC00 \uC678\uBD80\uC640 \uAC19\uC740
      \uD0C1\uC790\uC5D0 \uC549\uB294 \uAC74, 1800\uB144 \uB9CC\uC5D0 \uCC98\uC74C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435110
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC\uB3C4 \uB370\uB824\uC640 \uBCF4\uC9C0.
      \uD751\uC9C0\uAC00 \uBC18\uB300\uD574\uB3C4 \uBC18\uCABD\uC740 \uAC08 \uAC70\uC57C.
      1800\uB144 \uB9CC\uC774\uB77C\uBA70 \u2014 \uBC18\uCABD\uC774\uB77C\uB3C4 \uC5B4\uB514\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435111
    m_Localized: "\uB450 \uBD84\uC774 \uBA3C\uC800 \uBB38\uC744 \uC5EC\uC2DC\uB294\uAD70\uC694.
      1800\uB144\uC744 \uB2EB\uACE0 \uACC4\uC168\uC73C\uBA74\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435112
    m_Localized: "\uBB3C\uB824\uBC1B\uC740 \uBD84\uB178\uB294 \uB0B4\uB824\uB193\uC744
      \uB370\uAC00 \uC5C6\uC5C8\uC5B4. ...\uC774\uC81C \uB450\uACE0 \uAC08 \uC790\uB9AC\uAC00
      \uD558\uB098 \uC0DD\uACBC\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435113
    m_Localized: "\uCD9C\uBC1C\uC774 \uC880 \uB2A6\uC5C8\uC9C0. \uD55C 1800\uB144\uCBE4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435114
    m_Localized: "\uB124 \uC0AC\uB78C\uC758 \uADF8\uB9BC\uC790\uAC00 \uB3CC\uBB38
      \uBE5B\uC5D0 \uAC19\uC740 \uAE38\uC774\uB85C \uB298\uC5B4\uC120\uB2E4. \uB137\uC774
      \uAC19\uC774 \uBB38 \uC548\uC73C\uB85C \uD55C \uBC1C \uB0B4\uB51B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435117
    m_Localized: "\uACFC\uC218\uC6D0 \uCD9C\uAD6C. \uB2EC\uBE5B\uCC98\uB7FC \uC605\uC740
      \uBCF4\uB77C\uC0C9 \uB85C\uBE0C\uB97C \uC785\uC740 \uC5EC\uC790\uAC00 \uAE38
      \uC606\uC5D0 \uC11C \uC788\uB2E4. \uBC1C\uC790\uAD6D\uC740 \uC5C6\uB2E4. \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC5C8\uB358 \uAC83\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435118
    m_Localized: "\uC2DC\uC870 \uACF5\uD55C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435119
    m_Localized: "\uC2DC\uC870\uB97C... \uC54C\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435120
    m_Localized: "\uCE68\uC6D4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435121
    m_Localized: "1800\uB144 \uC804, \uB2F9\uC2E0\uC774 \uB2EB\uC740 \uBB38\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435122
    m_Localized: "\uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435123
    m_Localized: "\uADF8 \uBB38\uC744 \uB2F9\uC2E0\uC774 \uC5EC\uB294 \uC21C\uAC04,
      \uB0A8\uC740 \uC6B0\uB9AC\uAC00 \uC9C0\uD0A8 \uC138\uC6D4\uC740 \uBC30\uC2E0\uC774
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435124
    m_Localized: "\uCE68\uBB35\uC774 \uD559\uC0B4\uC744 \uB9C9\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435125
    m_Localized: "\uCE68\uBB35\uC740 \uBC29\uD328\uC600\uC2B5\uB2C8\uB2E4. \uBC29\uD328\uB97C
      \uB0B4\uB824\uB193\uC73C\uBA74 \uBA3C\uC800 \uD53C \uD758\uB9B4 \uC0AC\uB78C\uC740
      \uBC14\uAE65\uC774 \uC544\uB2C8\uB77C \uC548\uCABD\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435126
    m_Localized: "\uC548\uCABD \uC0AC\uB78C\uB9CC \uC0AC\uB78C\uC778\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435127
    m_Localized: "\uBC14\uAE65\uC758 \uD53C\uB97C \uAC00\uBCCD\uAC8C \uBCF8 \uC801
      \uC5C6\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uC11C \uB354 \uB2EB\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435128
    m_Localized: "\uC800\uCABD\uB3C4 \uC790\uAE30 \uBC29\uC2DD\uC73C\uB85C \uBB34\uAC8C\uB97C
      \uB4E4\uACE0 \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435129
    m_Localized: "\uCE68\uC6D4\uC740 \uC801\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435130
    m_Localized: "\uC57D\uC18D\uC744 \uAE00\uC790 \uADF8\uB300\uB85C \uC9C0\uD0A4\uB294
      \uC790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435131
    m_Localized: "\uADF8\uB9AC\uACE0 \uB2F9\uC2E0\uC740 \uC57D\uC18D\uC758 \uB73B\uC774\uB77C\uB294
      \uB9D0\uB85C \uC57D\uC18D\uC744 \uCC22\uB294 \uC790\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435132
    m_Localized: "\uADF8\uB7F4 \uC218\uB3C4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435133
    m_Localized: "\uCE68\uC6D4\uC758 \uB208\uC774 \uCC98\uC74C\uC73C\uB85C \uD754\uB4E4\uB9B0\uB2E4.
      \uC544\uC8FC \uC9E7\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435134
    m_Localized: "\uADF8 \uB9D0\uC744 \uC778\uC815\uD558\uB294 \uAC83\uC774 \uB354
      \uC794\uC778\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435135
    m_Localized: "\uCE68\uC6D4\uC740 \uAE38\uC744 \uB9C9\uC9C0 \uC54A\uB294\uB2E4.
      \uB2E4\uB9CC \uB4A4\uB3CC\uC544\uC11C\uBA70 \uB9C8\uC9C0\uB9C9 \uB9D0\uC744
      \uB0A8\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435136
    m_Localized: "\uB3C4\uC2DC \uC785\uAD6C\uC5D0\uC11C \uB2E4\uC2DC \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      \uADF8\uB54C\uB294 \uAE38 \uC606\uC5D0 \uC11C \uC788\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435137
    m_Localized: "\uB2E8\uB9B0\uACFC \uC774\uBE68\uBC14\uB78C\uC774 \uC55E\uC11C
      \uAC77\uB294\uB2E4. \uBB35\uD5A5\uACFC \uACF5\uD55C\uC774 \uC870\uAE08 \uB4A4\uC5D0
      \uB0A8\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435138
    m_Localized: "\uADF8 \uB9CE\uC740 \uC774\uB984\uC744 \uC5B4\uB5BB\uAC8C \uC9C0\uACE0
      \uAC00\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435139
    m_Localized: "\uB18D\uB2F4\uC744 \uD574. 400\uB144 \uC804 \uC77C\uC744 \uC5B4\uC81C
      \uC77C\uCC98\uB7FC \uB9D0\uD558\uBA74 \uC0AC\uB78C\uB4E4\uC774 \uC6C3\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435140
    m_Localized: "\uC6C3\uAE30 \uC704\uD574 \uB9D0\uD558\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435141
    m_Localized: "...\uACAC\uB514\uAE30 \uC704\uD574 \uB9D0\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435142
    m_Localized: "\uADF8\uB807\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435143
    m_Localized: "\uB108\uB294 \uC548 \uC6C3\uB294\uAD6C\uB098. 1800\uB144 \uB3D9\uC548
      \uD63C\uC790 \uC788\uC73C\uBA74 \uADF8\uB807\uAC8C \uB418\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435144
    m_Localized: "\uC6C3\uC744 \uC0AC\uB78C\uC774 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435145
    m_Localized: "\uADF8\uB7FC \uC774\uC81C \uD55C \uBA85\uCBE4\uC740 \uC0DD\uACBC\uB124.
      \uB0B4\uAC00 \uC6C3\uC73C\uBA74 \uB530\uB77C \uC6C3\uC5B4. \uCC98\uC74C\uC5D4
      \uD749\uB0B4\uB77C\uB3C4 \uAD1C\uCC2E\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435146
    m_Localized: "...\uAD1C\uCC2E\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435147
    m_Localized: "\uADF8 \uB9D0, \uAD1C\uCC2E\uC9C0 \uC54A\uC744 \uB54C \uD558\uB294
      \uB9D0\uC774\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435148
    m_Localized: "\uC7BF\uACE8 \uAC70\uC810. \uD0C1\uC790 \uC704\uC5D0 \uC138 \uAC00\uC9C0\uAC00
      \uB193\uC778\uB2E4 \u2014 \uAC80\uC740 \uB2E8\uC8C4 \uBA85\uB2E8 \uC0AC\uBCF8,
      \uCCAB \uB3C4\uC2DC \uBCBD\uD654\uC758 \uBA39 \uD0C1\uBCF8, \uB2E8\uD604 \uC77C\uC9C0\uC758
      '\uC81C4\uC218\uBB38' \uD398\uC774\uC9C0. \uD55C\uC0C8\uAC00 \uD0C1\uC790 \uB05D\uC5D0\uC11C
      \uADF8 \uC14B\uC744 \uBA85\uB2E8\uC5D0 \uC62E\uACA8 \uC801\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435149
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC \uD55C \uBD84, \uADF8\uBB3C \uACB0\uC0AC
      \uD55C \uBD84. ...\uC7BF\uACE8 \uBA85\uB2E8\uC5D0 \uC774 \uB450 \uC9C4\uC601
      \uC774\uB984\uC774 \uC624\uB978 \uAC74, \uC81C\uAC00 \uC801\uAE30 \uC2DC\uC791\uD55C
      \uB4A4\uB85C \uCC98\uC74C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435150
    m_Localized: "\uC194\uB77C\uB8F8\uB3C4 \uC801\uC73C\uC2ED\uC2DC\uC624. \uC0AC\uC81C
      \uC778\uC7A5\uC73C\uB85C\uAC00 \uC544\uB2C8\uB77C \u2014 \uC81C\uAC00 \uCCAB
      \uB3C4\uC2DC\uC5D0\uC11C \uBCF8 \uAC83\uC744 \uB4E4\uACE0 \uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435151
    m_Localized: "\uC774\uB9AC\uC194\uB3C4. \uB137\uC774 \uD55C \uBA85\uB2E8\uC5D0
      \uAC19\uC774 \uC624\uB974\uB294 \uAC70, \uCCAB \uB3C4\uC2DC \uAC08\uB77C\uC9C4
      \uB4A4\uB85C \uCC98\uC74C\uC774\uB77C\uBA70. ...\uADF8\uB7FC \uB0B4 \uC774\uB984\uB3C4
      \uAC70\uAE30 \uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435152
    m_Localized: "\uCC98\uC74C\uC774\uC9C0. \uC6B0\uB9AC \uACB0\uC0AC\uB294 \uD55C
      300\uB144 \uBA85\uB2E8\uC774\uB780 \uB370 \uC548 \uC62C\uB790\uC5B4. \uAE30\uBD84\uC774
      \uBB18\uD558\uB124 \u2014 \uB098\uC058\uC9C4 \uC54A\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435153
    m_Localized: "\uB2E8\uD604\uC740 \uB3C4\uC2DC \uC785\uAD6C\uC5D0 \uB2FF\uC558\uACE0,
      \uD559\uD30C\uB294 \uADF8 \uAE38\uC744 \uB2E4\uC2DC \uCC3E\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC74C \uAE38\uC740 \uC720\uB9AC\uC758 \uC232 \u2014 \uD559\uD30C\uAC00
      \uAC70\uAE30\uC11C \uB3C4\uC2DC \uAE30\uB85D\uC744 \uD574\uC11D\uD558\uACE0
      \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435154
    m_Localized: "\uD751\uC9C0\uB294 \uC774\uB984\uC73C\uB85C \uBC8C\uD558\uB824
      \uD558\uACE0, \uCE68\uC6D4\uC740 \uBB38\uC744 \uB2EB\uC73C\uB824 \uD558\uACE0.
      \uC6B0\uB9AC\uB294 \uADF8 \uC0AC\uC774\uC5D0\uC11C \uC77D\uACE0, \uB0C4\uC0C8
      \uB9E1\uACE0, \uAC70\uC9D3\uC774\uBA74 \uBB3C\uC5B4\uB72F\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435155
    m_Localized: "\uC88B\uC544, \uC9C0\uC131\uC801\uC778 \uACC4\uD68D\uC774\uB124.
      \uB9C8\uC9C0\uB9C9 \uBD80\uBD84\uB9CC \uBE7C\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435156
    m_Localized: "\uC5EC\uAD00 \uCABD\uC5D0\uC11C \uB2EC\uBAA9\uC774 \uCC3B\uC8FC\uC804\uC790\uB97C
      \uB4E4\uACE0 \uC628\uB2E4. \uC794\uC744 \uB2E4\uC12F \uAC1C \uB0B4\uB824\uB193\uB294\uB2E4
      \u2014 \uD3C9\uC18C\uBCF4\uB2E4 \uB458 \uB9CE\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435157
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC \uBD84\uC774 \uC6B0\uB9AC \uC5EC\uAD00
      \uCC28\uB97C \uB4DC\uC2DC\uB294 \uB0A0\uC774 \uC62C \uC904\uC740. ...\uC5B4\uBA38\uB2D8\uC774
      \uC0B4\uC544 \uACC4\uC168\uC73C\uBA74, \uBB35\uD5A5 \uC5B4\uB978\uC774\uB791
      \uD55C \uC2DC\uAC04\uC740 \uCC28\uB97C \uC6B0\uB9AC\uC168\uC744 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435158
    m_Localized: "\uD55C \uC2DC\uAC04? \uC88B\uC9C0. \uB098\uB294 \uCC28 \uC6B0\uB9AC\uB294
      \uB370 \uD55C 300\uB144\uCBE4 \uAE30\uB2E4\uB824 \uBCF8 \uC0AC\uB78C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435159
    m_Localized: "\uC720\uB9AC\uCC98\uB7FC \uAD73\uC740 \uC232. \uB098\uBB34 \uC18D\uC5D0
      \uC5BC\uC5B4\uBD99\uC740 \uC190\uC790\uAD6D\uB4E4\uC774 \uC788\uB2E4. \uC5B4\uB5A4
      \uC190\uC740 \uC0AC\uC81C \uC778\uC7A5\uC744 \uC950\uACE0 \uC788\uACE0, \uC5B4\uB5A4
      \uC190\uC740 \uD1A0\uD15C\uC744 \uC950\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435160
    m_Localized: "\uBA40\uB9AC\uC11C \uC5EC\uC790\uC758 \uBAA9\uC18C\uB9AC\uAC00
      \uB4E4\uB9B0\uB2E4. \uAE30\uB3C4\uBB38\uCC98\uB7FC \uB0AE\uACE0, \uAC15\uC758\uCC98\uB7FC
      \uC815\uD655\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435161
    m_Localized: "\uC790\uB9E4\uC5EC, \uADF8\uBD84\uC758 \uC74C\uC131\uC774 \uB4E4\uB9BD\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435162
    m_Localized: "...\uC774 \uC74C\uC131, \uBCF8 \uB300\uC131\uB2F9\uC5D0\uC11C \uB4E4\uC740
      \uC801\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435163
    m_Localized: "\uC544\uB294 \uB0C4\uC0C8\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435164
    m_Localized: "\uC0AC\uC81C \uC218\uB828\uC744 \uD568\uAED8 \uBC1B\uC740 \uC0AC\uB78C\uC785\uB2C8\uB2E4.
      \uC120\uC601."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435165
    m_Localized: "\uC61B \uB3D9\uB8CC\uAC00 \uC88B\uC740 \uC18C\uC2DD\uC73C\uB85C
      \uB098\uD0C0\uB098\uB294 \uACBD\uC6B0\uAC00 \uC880 \uB4DC\uBB3C\uAE34 \uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435166
    m_Localized: "\uC232 \uC548\uCABD\uC5D0\uC11C \uAE30\uB85D\uC744 \uBD80\uB974\uACE0
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435167
    m_Localized: "\uAE30\uB3C4\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uC808\uCC28\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435168
    m_Localized: "\uD0C1\uC790 \uC704\uC5D0 \uB2E8\uD604 \uC77C\uC9C0 \uC0AC\uBCF8,
      \uCCAB \uB3C4\uC2DC \uBCBD\uD654 \uD0C1\uBCF8, \uAC80\uC740 \uB2E8\uC8C4 \uBA85\uB2E8\uC774
      \uB193\uC5EC \uC788\uB2E4. \uADF8 \uC606\uC5D0 \uC0C8\uB85C \uAC00\uC838\uC628
      \uD559\uD30C \uBA85\uB839\uC11C\uAC00 \uD3BC\uCCD0\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435169
    m_Localized: "\uC774 \uC11C\uBA85. \uBC31\uADDC \uC2A4\uD134\uD558\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435170
    m_Localized: "\uBC31\uADDC. \uC774\uB984\uC740 \uAE68\uB057\uD558\uB124. \uBCF4\uD1B5
      \uADF8\uB7F0 \uC774\uB984\uC77C\uC218\uB85D \uBB38\uC11C\uAC00 \uB354\uB7FD\uB358\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435171
    m_Localized: "\uBCC0\uBC29 \uB3C4\uAD74 \uD559\uD30C\uC758 \uD604 \uD559\uC790\uC7A5\uC785\uB2C8\uB2E4.
      \uB2E8\uD604\uC758 \uC9C1\uC811 \uC81C\uC790\uB294 \uC544\uB2C8\uC9C0\uB9CC,
      \uD559\uC124\uC744 \uC774\uC5B4\uBC1B\uC740 \uC0AC\uB78C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435172
    m_Localized: "\uADF8\uB7FC \uB2E8\uD604\uC774 \uB0A8\uAE34 \uCE7C\uC744 \uC9C0\uAE08
      \uC800\uB188\uC774 \uD718\uB450\uB974\uB294 \uAC70\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435173
    m_Localized: "\uCE7C\uC774 \uC544\uB2C8\uB77C \uBB38\uC7A5\uC774\uB2E4. \uB354
      \uC624\uB798 \uBCA4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435174
    m_Localized: "\uC720\uB9AC\uC758 \uC232\uC73C\uB85C \uAC00\uACA0\uC2B5\uB2C8\uB2E4.
      \uD559\uD30C\uAC00 \uADF8\uACF3\uC5D0\uC11C \uCCAB \uB3C4\uC2DC \uAE30\uB85D\uC744
      \uD574\uC11D\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435175
    m_Localized: "\uB0C4\uC0C8\uAC00 \uB04A\uACA8. \uC232\uC778\uB370 \uBC14\uB78C\uC774
      \uC548 \uC9C0\uB098\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435176
    m_Localized: "\uC720\uB9AC \uC232\uC740 \uB298 \uADF8\uB798. \uB0C4\uC0C8\uB3C4
      \uAE30\uC5B5\uB3C4 \uC548\uCABD\uC5D0 \uAC07\uD600\uC11C \uBC18\uC9DD\uC774\uAE30\uB9CC
      \uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435177
    m_Localized: "\uB2EB\uD78C \uAE30\uB85D\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435178
    m_Localized: "\uC5F4\uAE30 \uC804\uC5D0, \uBB34\uC5C7\uC744 \uAEBC\uB0BC\uC9C0
      \uC815\uD574\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435179
    m_Localized: "\uAEBC\uB0B4 \uBCF4\uACE0 \uC815\uD558\uBA74 \uC548 \uB3FC?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435180
    m_Localized: "\uBB18\uC5ED\uC5D0\uC11C \uBD24\uC796\uC2B5\uB2C8\uAE4C. \uC5B4\uB5A4
      \uAE30\uB85D\uC740 \uBC16\uC73C\uB85C \uB098\uC624\uB294 \uC21C\uAC04 \uCE7C\uC9D1\uBD80\uD130
      \uCC3E\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435181
    m_Localized: "\uAC70\uBAA9\uB4E4\uC774 \uC720\uB9AC\uCC98\uB7FC \uAD73\uC5B4
      \uC788\uB2E4. \uC904\uAE30 \uC548\uC5D0\uB294 \uC624\uB798\uB41C \uC804\uD22C\uC758
      \uADF8\uB9BC\uC790\uAC00 \uAC07\uD600 \uC788\uACE0, \uAC00\uC9C0 \uB05D\uB9C8\uB2E4
      \uAE68\uC9C4 \uC778\uC7A5 \uC870\uAC01\uC774 \uB9E4\uB2EC\uB824 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435182
    m_Localized: "\uD558\uB298\uC774 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435183
    m_Localized: "1800\uB144 \uB9CC\uC5D0 \uCC98\uC74C \uBCF4\uB294 \uBC14\uAE65
      \uD558\uB298\uC774 \uC800 \uBAA8\uC591\uC774\uB77C\uB2C8. \uC880 \uBBF8\uC548\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435184
    m_Localized: "\uC2DC\uB044\uB7FD\uC9C0 \uC54A\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435185
    m_Localized: "\uC6C3\uAE34 \uC232\uC774\uC57C. \uD53C \uB0C4\uC0C8\uAC00 \uBCF4\uC774\uB294\uB370
      \uB9E1\uC544\uC9C0\uC9C0\uB294 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435186
    m_Localized: "\uC720\uB9AC \uC548\uCABD\uC5D0 \uC804\uD22C \uD754\uC801\uC774
      \uAC07\uD600 \uC788\uC2B5\uB2C8\uB2E4. \uC194\uB77C\uB8F8 \uC778\uC7A5\uB9CC
      \uC788\uB294 \uAC8C \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435187
    m_Localized: "\uB124 \uBB38\uC591\uC774 \uB2E4 \uC788\uB124. \uCCAB \uB3C4\uC2DC
      \uAE30\uB85D\uC758 \uADF8\uB9BC\uC790\uAC00 \uC5EC\uAE30\uAE4C\uC9C0 \uBC88\uC9C4
      \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435188
    m_Localized: "\uADF8\uB9BC\uC790\uBA74 \uBC1F\uC73C\uBA74 \uB418\uB294\uB370,
      \uC774\uAC74 \uBC1C\uC5D0 \uBC15\uD788\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435189
    m_Localized: "\uAE68\uC9C4 \uC5F0\uAD6C \uCC9C\uB9C9 \uC548. \uC720\uB9AC\uD310
      \uC704\uC5D0 \uBD89\uC740 \uC2E4\uC774 \uC774\uC5B4\uC838 \uC788\uB2E4. \uCCAB
      \uB3C4\uC2DC \uBCBD\uD654\uC758 \uB124 \uBB38\uC591\uC774 \uC815\uACB0, \uC624\uC5FC,
      \uBCF4\uC874, \uCE68\uBB35\uC774\uB77C\uB294 \uB124 \uB2E8\uC5B4\uB85C \uB2E4\uC2DC
      \uC801\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435190
    m_Localized: "\uC774\uAC74 \uD574\uC11D\uC774 \uC544\uB2D9\uB2C8\uB2E4. \uD310\uACB0\uD45C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435191
    m_Localized: "\uBCBD\uD654\uB97C \uC77D\uC740 \uAC8C \uC544\uB2C8\uB77C \uC0AC\uB78C\uC744
      \uBD84\uB958\uD560 \uCE78\uC73C\uB85C \uC798\uB77C \uB1A8\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435192
    m_Localized: "\uB204\uAC00 \uC774\uB807\uAC8C \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435193
    m_Localized: "\uD604\uC7A5 \uD574\uC11D \uAD8C\uD55C. \uBC31\uADDC \uC2A4\uD134\uD558\uC784.
      \uC801\uC6A9 \uB300\uC0C1: \uBCC0\uBC29 \uC815\uCC29\uBBFC, \uC774\uB9AC\uC194
      \uC811\uCD09\uC790, \uACB0\uC0AC \uC794\uC874\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435194
    m_Localized: "...\uADF8\uB7F0\uB370 \uACB0\uC7AC\uB780\uC740 \uBCF8 \uB300\uC131\uB2F9
      \uD615\uC2DD\uC785\uB2C8\uB2E4. \uBC31\uADDC \uD55C \uC0AC\uB78C\uC758 \uBB38\uC81C\uAC00
      \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435195
    m_Localized: "\uC6B0\uB9AC \uCE68\uBB35\uC774 \uB2A6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435196
    m_Localized: "\uC544\uB2D9\uB2C8\uB2E4. \uB2A6\uC5C8\uB2E4\uACE0 \uD574\uC11C
      \uC800\uB4E4\uC758 \uD310\uACB0\uC774 \uC815\uB2F5\uC774 \uB418\uC9C0\uB294
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435197
    m_Localized: "\uC88B\uC544. \uC624\uB298\uC740 \uBB38\uC11C\uB97C \uBD88\uD0DC\uC6B0\uAE30
      \uC804\uC5D0 \uC880 \uC77D\uC5B4 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435198
    m_Localized: "\uC77D\uACE0 \uB098\uC11C \uBB3C\uC5B4\uB72F\uB294 \uAC74 \uAD1C\uCC2E\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435199
    m_Localized: "\uC808\uCC28\uC0C1 \uAC00\uB2A5\uD558\uC9C0 \uC54A\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435200
    m_Localized: "\uAE38\uBAA9\uC5D0 \uC0AC\uB78C\uC774 \uC11C \uC788\uB2E4. \uD63C\uC790,
      \uBB34\uC7A5\uD558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435201
    m_Localized: "\uD559\uD30C \uACBD\uBE44\uBCD1\uC785\uB2C8\uB2E4. \uC232 \uC548\uCABD\uC5D0
      \uC9C0\uD0AC \uAC8C \uC788\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435202
    m_Localized: "\uC5EC\uAE30\uC11C\uBD80\uD130 \uD559\uD30C \uAD00\uD560\uC774\uB2E4.
      \uC778\uAC00 \uC5C6\uB294 \uC790\uB294 \uB3CC\uC544\uAC00\uB77C. \uBA85\uB839\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435203
    m_Localized: "\uAD00\uD560\uC774\uB77C\uB294 \uB9D0\uC740 \uB298 \uAE68\uB057\uD558\uC9C0.
      \uADF8 \uB9D0 \uB4A4\uC5D0 \uBB58 \uC228\uACA8\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435204
    m_Localized: "\uC548 \uBE44\uCF1C \uC8FC\uBA74, \uC6B0\uB9AC\uAC00 \uBE44\uCF1C
      \uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435205
    m_Localized: "\uACBD\uBE44\uBCD1\uC774 \uBB34\uB98E\uC744 \uAFC7\uB294\uB2E4.
      \uADF8\uAC00 \uB4F1\uC73C\uB85C \uB9C9\uACE0 \uC788\uB358 \uBE44\uD0C8\uAE38\uC774
      \uB4DC\uB7EC\uB09C\uB2E4. \uC544\uB798\uCABD\uC5D0 \uC1E0\uC6B0\uB9AC\uAC00
      \uC904\uC9C0\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435206
    m_Localized: "...\uC6B0\uB9AC\uC785\uB2C8\uB2E4. \uC0AC\uB78C \uD06C\uAE30\uC758."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435207
    m_Localized: "\uC0AC\uB78C\uC744 \uAC00\uB454 \uB0C4\uC0C8\uAC00 \uC62C\uB77C\uC640.
      \uC774\uAC74 \uC232 \uB0C4\uC0C8\uAC00 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435208
    m_Localized: "\uACBD\uBE44\uBCD1\uC744 \uC138\uC6B4 \uC774\uC720\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435209
    m_Localized: "\uC9C0\uD0A4\uB294 \uAC8C \uB354\uB7EC\uC6B8\uC218\uB85D \uBB38\uC9C0\uAE30\uB294
      \uAE68\uB057\uD55C \uCC99\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435210
    m_Localized: "\uC720\uB9AC \uD30C\uD3B8 \uC0AC\uC774\uB85C \uC5EC\uC790\uC758
      \uAE30\uB3C4\uAC00 \uD750\uB978\uB2E4. \uBB38\uC7A5\uC740 \uAE30\uB3C4\uCC98\uB7FC
      \uC2DC\uC791\uD558\uC9C0\uB9CC, \uB05D\uC740 \uC8FC\uC11D\uCC98\uB7FC \uC815\uD655\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435211
    m_Localized: "\uC815\uACB0\uC740 \uBB34\uC8C4\uAC00 \uC544\uB2C8\uBA70, \uC624\uC5FC\uC740
      \uC720\uC8C4\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uBD84\uB958\uB294 \uAD6C\uC6D0\uC744
      \uC704\uD55C \uCCAB \uC9C8\uC11C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435212
    m_Localized: "\uC120\uC601..."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435213
    m_Localized: "\uC544\uB294 \uBAA9\uC18C\uB9AC\uAC00 \uC800\uB807\uAC8C \uB4E4\uB9AC\uBA74,
      \uBCF4\uD1B5 \uC88B\uC740 \uC77C\uC740 \uC544\uB2C8\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435214
    m_Localized: "\uD53C\uD574 \uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uBE44\uCF1C
      \uAC00\uBA74, \uC800 \uBAA9\uC18C\uB9AC\uAC00 \uC6B0\uB9AC\uBCF4\uB2E4 \uBA3C\uC800
      \uC0AC\uB78C\uB4E4\uC744 \uB9CC\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435217
    m_Localized: "\uC1E0\uC6B0\uB9AC\uB4E4\uC774 \uC904\uC9C0\uC5B4 \uC788\uB2E4.
      \uC5B4\uB5A4 \uC6B0\uB9AC\uC5D0\uB294 \uC57C\uC218\uAC00, \uC5B4\uB5A4 \uC6B0\uB9AC\uC5D0\uB294
      \uCC22\uC5B4\uC9C4 \uC0AC\uC81C\uBCF5\uC774, \uC5B4\uB5A4 \uC6B0\uB9AC\uC5D0\uB294
      \uC774\uB984\uD45C\uB9CC \uB0A8\uC544 \uC788\uB2E4. \uC774\uB984\uD45C\uC5D0\uB294
      \uC815\uCC29\uBBFC\uC758 \uC774\uB984\uACFC \uD568\uAED8 '\uC815\uD654 \uC808\uCC28
      \uB300\uC0C1'\uC774 \uC801\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435218
    m_Localized: "\uAC00\uC7A5 \uC791\uC740 \uC774\uB984\uD45C \uB4A4\uC5D0\uB294
      \uC190\uD1B1\uC73C\uB85C \uAE01\uC740 \uAE00\uC528\uAC00 \uC788\uB2E4. `\uB098\uB8E8`.
      \uADF8 \uC544\uB798\uC5D0 \uD559\uD30C \uAE00\uC528\uB85C `\uD45C\uBCF8 B-17`\uC774
      \uB367\uBD99\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435219
    m_Localized: "\uC0AC\uB78C\uC744... \uC0AC\uC721\uC7A5\uC5D0 \uB123\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435220
    m_Localized: "\uB0C4\uC0C8\uAC00 \uC0AC\uB78C \uB0C4\uC0C8\uC57C. \uAC81\uBA39\uC740
      \uC0AC\uB78C \uB0C4\uC0C8. \uC544\uC774 \uB0C4\uC0C8\uB3C4 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435221
    m_Localized: "\uBC31\uADDC\uC758 \uD310\uACB0\uD45C\uAC00 \uC5EC\uAE30\uC11C
      \uBC88\uD638\uD45C\uAC00 \uB41C \uAC70\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435222
    m_Localized: "\uCCAB \uB3C4\uC2DC\uC758 \uC8C4\uAC00 \uB2E4\uC2DC \uC2DC\uC791\uB410\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435223
    m_Localized: "\uC544\uB2D9\uB2C8\uB2E4. \uC774\uAC74 \uC2DC\uC791\uC774 \uC544\uB2C8\uB77C
      \uBC18\uBCF5\uC785\uB2C8\uB2E4. \uADF8\uB798\uC11C \uB354 \uB098\uC069\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435224
    m_Localized: "\uC0B4\uC544 \uC788\uB294 \uC0AC\uB78C\uBD80\uD130 \uCC3E\uC544.
      \uC774\uB984\uD45C\uB294 \uB098\uC911\uC5D0 \uC138\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435225
    m_Localized: "\uC544\uB2C8. \uC774\uB984\uD45C\uB3C4 \uAC19\uC774 \uCC59\uACA8.
      \uC0B0 \uC0AC\uB78C \uCC3E\uB2E4\uAC00 \uC8FD\uC740 \uC0AC\uB78C \uC774\uB984\uC744
      \uB610 \uC783\uC73C\uBA74, \uADF8\uAC74 \uC6B0\uB9AC\uAC00 \uD55C \uC9D3\uC774
      \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435226
    m_Localized: "\uC0AC\uC721\uC7A5 \uBC14\uAE65\uC5D0\uC11C \uAE09\uD55C \uBC1C\uC18C\uB9AC\uAC00
      \uB4E4\uB9B0\uB2E4. \uC5B4\uB9B0 \uC0AC\uB0E5\uAFBC \uD558\uB098\uAC00 \uAC70\uC758
      \uB118\uC5B4\uC9C0\uB4EF \uB6F0\uC5B4 \uB4E4\uC5B4\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435227
    m_Localized: "\uC624\uBE60!"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435228
    m_Localized: "\uC5F0\uC8FC? \uC65C \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435229
    m_Localized: "\uC7A5\uB85C\uB4E4\uC774... \uD68C\uC870\uAC00 \uC11C\uC57D\uC744
      \uCCA0\uD68C\uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435230
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC758 \uC190\uC774 \uBA48\uCD98\uB2E4.
      \uCE7C\uB05D\uC774 \uC544\uC8FC \uC870\uAE08 \uB0B4\uB824\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435231
    m_Localized: "\uB2E4\uC2DC \uB9D0\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435232
    m_Localized: "\uBB34\uB9AC\uC758 \uBC18\uC774 \uB5A0\uB0AC\uC5B4\uC694. \uD68C\uC870\uAC00
      \uC55E\uC5D0 \uC130\uACE0, \uC774\uBE68\uBC14\uB78C \uC624\uBE60\uAC00 \uACB0\uC0AC
      \uC0AC\uB78C\uB4E4\uACFC \uB2E4\uB2CC \uAC78 \uBC30\uC2E0\uC774\uB77C\uACE0
      \uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435233
    m_Localized: "...\uBD81\uCABD \uC528\uC871\uC740 \uB2F5\uC744 \uBBF8\uB918\uACE0,
      \uC11C\uCABD\uC740 \uC544\uBB34 \uB9D0\uB3C4 \uC548 \uD588\uC5B4\uC694. \uB0A8\uBD80\uB9CC
      \uBA3C\uC800 \uCC22\uC5B4\uC9C4 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435234
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435235
    m_Localized: "\uC9C0\uAE08\uC740 \uB18D\uB2F4 \uC548 \uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435236
    m_Localized: "\uB0B4\uAC00 \uC5F0 \uBB38\uC774, \uB108\uD76C \uBB34\uB9AC\uB3C4
      \uAC08\uB790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435237
    m_Localized: "\uC544\uB2C8. \uAC08\uB77C\uC9C8 \uBB34\uB9AC\uAC00 \uBB38 \uC18C\uB9AC\uC5D0
      \uB9DE\uCDB0 \uAC08\uB77C\uC9C4 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435238
    m_Localized: "\uC800\uB294 \uC5B4\uB290 \uCABD\uC744 \uB530\uB77C\uC57C \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435239
    m_Localized: "\uB124 \uBC1C\uB85C \uC11C. \uD615\uC81C\uB97C \uB530\uB974\uB4E0
      \uBB34\uB9AC\uB97C \uB530\uB974\uB4E0, \uB124 \uBC1C\uB85C \uC11C\uC57C \uC0AC\uB0E5\uAFBC\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435240
    m_Localized: "...\uADF8\uB7FC \uC800\uB294 \uC9C0\uAE08\uC740 \uC5EC\uAE30 \uC788\uC744\uB798\uC694.
      \uB6F0\uC5B4\uC628 \uBC1C\uC774 \uC5EC\uAE30\uC11C \uBA48\uCDC4\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435241
    m_Localized: "\uC5F0\uC8FC\uAC00 \uD488\uC5D0\uC11C \uBB34\uC5B8\uAC00\uB97C
      \uAEBC\uB0B8\uB2E4. \uAC00\uC8FD \uB048 \uD558\uB098. \uB9E4\uB4ED\uC774 \uD480\uB824
      \uC788\uACE0, \uD55C\uCABD \uB05D\uC5D0 \uB9C8\uB978 \uD53C\uAC00 \uBC30\uC5B4
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435242
    m_Localized: "\uD68C\uC870 \uC624\uBE60\uAC00... \uC774\uAC78 \uC624\uBE60\uD55C\uD14C
      \uAC16\uB2E4 \uC8FC\uB77C\uACE0 \uD588\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435243
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uB048\uC744 \uBC1B\uB294\uB2E4.
      \uC190\uBC14\uB2E5 \uC704\uC5D0 \uC62C\uB824\uB193\uACE0, \uD55C\uCC38 \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435244
    m_Localized: "\uD53C\uC758 \uC11C\uC57D \uB048\uC774\uC57C. \uD615\uC81C\uB07C\uB9AC
      \uC190\uBAA9\uC744 \uBB36\uC744 \uB54C \uC4F0\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435245
    m_Localized: "\uB3CC\uB824\uBCF4\uB0C8\uB2E4\uB294 \uAC74..."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435246
    m_Localized: "\uB9DE\uC544. \uD615\uC81C\uB97C \uADF8\uB9CC\uB450\uACA0\uB2E4\uB294
      \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435247
    m_Localized: "\uD68C\uC870 \uC624\uBE60, \uD654\uB09C \uC5BC\uAD74\uC740 \uC544\uB2C8\uC5C8\uC5B4\uC694.
      \uADF8\uB0E5... \uB048\uC744 \uC624\uB798 \uB4E4\uACE0 \uC788\uB2E4\uAC00,
      \uCC9C\uCC9C\uD788 \uD480\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435248
    m_Localized: "\uD654\uB0AC\uC73C\uBA74 \uCC28\uB77C\uB9AC \uC26C\uC6E0\uC5B4.
      \uD654\uB294 \uC2DD\uAE30\uB77C\uB3C4 \uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435249
    m_Localized: "\uB370\uB9AC\uB7EC \uAC00\uC2DC\uACA0\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435250
    m_Localized: "\uC544\uB2C8. \uB04C\uACE0 \uC628 \uD615\uC81C\uB294 \uD615\uC81C\uAC00
      \uC544\uB2C8\uC57C. \uC790\uAE30 \uBC1C\uB85C \uC11C\uC11C \uC640\uC57C \uD615\uC81C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435251
    m_Localized: "\uD68C\uC870\uB294 \uC790\uAE30 \uBC1C\uB85C \uBC18\uB300\uCABD\uC73C\uB85C
      \uAC78\uC5C8\uC5B4. \uADF8\uB7EC\uBA74 \u2014 \uAC70\uAE30\uAE4C\uC9C0\uAC00
      \uB0B4\uAC00 \uD560 \uC218 \uC788\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435252
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uB048\uC744 \uBC84\uB9AC\uC9C0
      \uC54A\uB294\uB2E4. \uC190\uBAA9\uC5D0 \uAC10\uB418, \uB9E4\uB4ED\uC740 \uC9D3\uC9C0
      \uC54A\uB294\uB2E4. \uD480\uB9B0 \uCC44\uB85C \uB454\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435253
    m_Localized: "\uC65C \uC548 \uBB36\uC5B4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435254
    m_Localized: "\uBB36\uC73C\uBA74 \uB05D\uC774\uB2C8\uAE4C. \uC544\uC9C1\uC740
      \uC548 \uBB36\uC744\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435255
    m_Localized: "\uC0AC\uC721\uC7A5 \uC548\uCABD \uC608\uBC30\uC2E4. \uC120\uC601\uC774
      \uBB34\uB98E \uAFC7\uC740 \uCC44 \uC720\uB9AC\uD310 \uC704\uC758 \uBB38\uC7A5\uC744
      \uB530\uB77C \uC77D\uACE0 \uC788\uB2E4. \uCD1B\uBD88\uC740 \uD558\uB098\uBFD0\uC774\uACE0,
      \uADF8 \uBD88\uBE5B\uC774 \uC0AC\uC81C \uC778\uC7A5 \uBAA8\uC591\uC73C\uB85C
      \uAE38\uAC8C \uB298\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435256
    m_Localized: "\uC120\uC601. \uC0AC\uB78C\uB4E4\uBD80\uD130 \uBC16\uC73C\uB85C
      \uB0B4\uBCF4\uB0B4\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435257
    m_Localized: "\uC790\uB9E4\uC5EC. \uC544\uC9C1\uB3C4 \uC0AC\uB78C\uBD80\uD130
      \uC138\uB294\uAD70\uC694. \uAE30\uB3C4\uBB38 \uD55C \uC904\uC744 \uD2C0\uB824
      \uD63C\uB098\uB358 \uB0A0\uC5D0\uB3C4, \uC790\uB9E4\uB294 \uC4F0\uB7EC\uC9C4
      \uC544\uC774\uBD80\uD130 \uC138\uC5C8\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435258
    m_Localized: "\uADF8\uB798\uC11C \uB9CE\uC774 \uD63C\uB0AC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435259
    m_Localized: "\uC800\uB294 \uBD80\uB7EC\uC6E0\uC2B5\uB2C8\uB2E4. \uD2C0\uB9AC\uACE0\uB3C4
      \uB2E4\uC2DC \uBB3B\uB294 \uC0AC\uB78C\uC774\uC5C8\uC73C\uB2C8\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435260
    m_Localized: "\uADF8\uB7F0 \uC0AC\uB78C\uC774 \uC9C0\uAE08 \uC0AC\uB78C\uC744
      \uC6B0\uB9AC\uC5D0 \uB123\uC740 \uC608\uBC30\uC2E4\uC744 \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435261
    m_Localized: "\uD559\uD30C\uAC00 \uB354\uB7FD\uD614\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uC11C
      \uC6D0\uBCF8 \uC758\uB3C4\uB97C \uBCF4\uC874\uD574\uC57C \uD569\uB2C8\uB2E4.
      \uC815\uACB0\uC740 \uCC98\uBC8C\uC774 \uC544\uB2C8\uB77C \uBC29\uD5A5\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435262
    m_Localized: "\uBC29\uD5A5\uC774 \uC0AC\uB78C\uC744 \uC6B0\uB9AC\uB85C \uBAB0\uBA74,
      \uADF8 \uBC29\uD5A5\uC774 \uD2C0\uB9B0 \uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435263
    m_Localized: "\uC6D0\uBCF8\uC774\uB77C\uB294 \uB9D0\uC740 \uD3B8\uD558\uC9C0.
      \uB204\uAD6C\uB3C4 \uC6D0\uBCF8\uD55C\uD14C \uC9C1\uC811 \uBB3C\uC744 \uC218
      \uC5C6\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435264
    m_Localized: "\uAE30\uC5B5 \uAD00\uB9AC\uAD00. \uB2F9\uC2E0\uB4E4\uC740 \uC774\uB984\uC744
      \uC9C0\uCF30\uC9C0\uB9CC \uAE38\uC744 \uC8FC\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435265
    m_Localized: "\uAE38 \uD558\uB098\uB85C \uBAA8\uB450\uB97C \uBAB0\uBA74 \uBB38\uC774
      \uC544\uB2C8\uB77C \uAC10\uC625\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435266
    m_Localized: "\uC120\uC601. \uB2E8\uD604 \uD559\uC124 \uC678\uC5D0 \uB2E4\uB978
      \uBB38\uC7A5\uC744 \uC77D\uC5B4 \uBCF8 \uC801 \uC788\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435267
    m_Localized: "\uC120\uC601\uC774 \uCC98\uC74C\uC73C\uB85C \uB2F5\uD558\uC9C0
      \uBABB\uD55C\uB2E4. \uC190\uB05D\uC774 \uC720\uB9AC\uD310 \uC704\uC5D0\uC11C
      \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435268
    m_Localized: "\uAE08\uC774 \uAC14\uB2E4\uACE0 \uB05D\uC740 \uC544\uB2C8\uC5D0\uC694.
      \uAE08 \uAC04 \uC794\uB3C4, \uADF8\uBD84\uC758 \uC190\uC5D0 \uB4E4\uB9AC\uBA74
      \uC131\uBC30\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435269
    m_Localized: "\uADF8 \uB9D0, \uC800\uB3C4 \uC88B\uC544\uD588\uC2B5\uB2C8\uB2E4.
      \uADF8\uB798\uC11C \uBB34\uC12D\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435270
    m_Localized: "\uC790\uB9E4\uC5EC, \uB2F9\uC2E0\uC740 \uC790\uACA9\uC744 \uB0B4\uB824\uB193\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435271
    m_Localized: "\uC544\uB2C8\uC694. \uC800\uB294 \uC790\uACA9\uC73C\uB85C \uC0AC\uB78C\uC744
      \uC790\uB974\uC9C0 \uC54A\uACA0\uB2E4\uACE0 \uC815\uD558\uB294 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435272
    m_Localized: "\uC120\uC601\uC758 \uB208\uC774 \uC9E7\uAC8C \uBE5B\uB09C\uB2E4.
      \uADF8\uB140\uB294 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uB294\uB2E4. \uB300\uC2E0
      \uB4A4\uCABD\uC758 \uC758\uC2DD \uBCF4\uC870\uC790\uB4E4\uC774 \uBB34\uAE30\uB97C
      \uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435273
    m_Localized: "\uADF8\uB7FC \uC2DC\uB828\uC774 \uB2F9\uC2E0\uC744 \uC9C0\uB098\uAC00\uAC8C
      \uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435274
    m_Localized: "\uC6B0\uB9AC \uC0AC\uC774\uC5D0\uC11C \uD55C \uB0A8\uC790\uAC00
      \uAC78\uC5B4 \uB098\uC628\uB2E4. \uC190\uC5D0 \uBA85\uBD80\uB97C \uB4E4\uACE0
      \uC788\uB2E4. \uADF8\uB294 \uC0B0 \uC0AC\uB78C\uACFC \uC8FD\uC740 \uC0AC\uB78C\uC744
      \uAC19\uC740 \uB208\uC73C\uB85C \uC13C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435275
    m_Localized: "\uC678\uBD80 \uC778\uC6D0. \uBA85\uB2E8\uC5D0 \uC5C6\uAD70. \uC808\uCC28\uC0C1,
      \uB2F9\uC2E0\uB4E4\uB3C4 \uBD84\uB958 \uB300\uC0C1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435276
    m_Localized: "\uC0AC\uB78C\uC744 \uC6B0\uB9AC\uC5D0 \uB123\uACE0\uB3C4 \uBAA9\uC18C\uB9AC\uAC00
      \uB5A8\uB9AC\uC9C0 \uC54A\uB294\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435277
    m_Localized: "\uB098\uB294 \uD45C\uBCF8\uC744 \uAD00\uB9AC\uD560 \uBFD0\uC774\uB2E4.
      \uBD84\uB958\uB294 \uC704\uC5D0\uC11C \uB0B4\uB824\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435278
    m_Localized: "\uADF8 '\uC704'\uAC00 \uB124 \uC785\uC744 \uBE4C\uB838\uC744 \uBFD0\uC774\uC57C.
      \uADF8 \uC785\uBD80\uD130 \uB2EB\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435279
    m_Localized: "\uC774\uB984\uD45C\uBD80\uD130 \uCC59\uAE30\uC790. \uC774 \uC0AC\uB78C
      \uC190\uC5D0\uC11C \uD55C \uBC88 \uB354 \uC783\uAE30 \uC804\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435280
    m_Localized: "\uAD00\uB9AC\uC790\uAC00 \uC4F0\uB7EC\uC9C4\uB2E4. \uAC00\uC2B4
      \uC548\uCABD\uC5D0\uC11C \uC816\uC740 \uBA85\uB839\uC11C \uC870\uAC01\uC774
      \uB5A8\uC5B4\uC9C4\uB2E4. \uC778\uC7A5\uC774 \uB0A8\uC544 \uC788\uB2E4. \uBC31\uADDC
      \uC2A4\uD134\uD558\uC784."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435281
    m_Localized: "\uD45C\uBCF8 B-17. \uC774\uB984\uC740 \uBD80\uCC28 \uC815\uBCF4.
      \uC808\uCC28 \uBC18\uC751 \uC591\uD638 \uC2DC \uBCC0\uBC29 \uC815\uCC29\uBBFC\uAD70\uC5D0
      \uD655\uB300 \uC801\uC6A9."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435282
    m_Localized: "\uB098\uB8E8\uAC00 \uBD80\uCC28\uC57C?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435283
    m_Localized: "\uD604\uC7A5 \uCC45\uC784\uC790\uB294 \uB530\uB85C \uC788\uC5C8\uACA0\uC9C0\uB9CC,
      \uAD8C\uD55C\uC740 \uBC31\uADDC\uAC00 \uB0B4\uB838\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435284
    m_Localized: "\uC190\uC744 \uB354\uB7FD\uD788\uC9C0 \uC54A\uC740 \uC190\uC774
      \uC81C\uC77C \uC624\uB798 \uAE68\uB057\uD55C \uCC99\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435285
    m_Localized: "\uADF8\uB294 \uB3C4\uC2DC\uB85C \uAC08 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435286
    m_Localized: "\uADF8\uB7FC \uC6B0\uB9AC\uB3C4 \uAC00. \uB2E8, \uC774\uBC88\uC5D4
      \uD63C\uC790 \uAC00\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435287
    m_Localized: "\uC6D0\uC815\uB300\uAC00 \uC6B0\uB9AC\uB97C \uD558\uB098\uC529
      \uC5F0\uB2E4. \uBE48 \uC6B0\uB9AC\uAC00 \uB354 \uB9CE\uACE0, \uC774\uB984\uD45C\uB9CC
      \uB0A8\uC740 \uC6B0\uB9AC\uAC00 \uB354 \uB9CE\uB2E4. \uADF8\uB7EC\uB098 \uBA87\uBA87
      \uC6B0\uB9AC\uC5D0\uC11C, \uC0AC\uB78C\uC774 \uCC9C\uCC9C\uD788 \uACE0\uAC1C\uB97C
      \uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435288
    m_Localized: "\uC0B0 \uC0AC\uB78C\uC774 \uC788\uC5B4. \uC800\uAE30, \uC791\uC740
      \uC6B0\uB9AC. \uC544\uC774 \uB0C4\uC0C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435289
    m_Localized: "\uAC00\uC7A5 \uC791\uC740 \uC6B0\uB9AC. \uC548\uCABD\uC5D0 \uC544\uC774
      \uD558\uB098\uAC00 \uBB34\uB98E\uC744 \uC548\uACE0 \uC549\uC544 \uC788\uB2E4.
      \uBAA9\uC5D0 \uD559\uD30C \uC774\uB984\uD45C\uAC00 \uAC78\uB824 \uC788\uB2E4.
      `\uD45C\uBCF8 B-17`."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435290
    m_Localized: "...\uB098\uB8E8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435291
    m_Localized: "\uC544\uC774\uAC00 \uACE0\uAC1C\uB97C \uB4E0\uB2E4. \uB2E8\uB9B0\uC744
      \uBCF8\uB2E4. \uADF8\uB9AC\uACE0 \uC790\uAE30 \uBAA9\uC758 \uC774\uB984\uD45C\uB97C
      \uB450 \uC190\uC73C\uB85C \uAC00\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435292
    m_Localized: "...\uADF8\uAC74 \uC81C \uC774\uB984 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435293
    m_Localized: "\uC54C\uC544. \uB124 \uC774\uB984\uC740 \uB124\uAC00 \uC6B0\uB9AC
      \uBCBD\uC5D0 \uAE01\uC5B4 \uB454 \uAC70\uC9C0. \uB098\uB8E8. \uADF8\uAC8C \uB124
      \uC774\uB984\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435294
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uC774\uB984\uD45C \uB048\uC744
      \uCE7C\uB85C \uB04A\uB294\uB2E4. \uC544\uC774 \uBAA9\uC5D0\uC11C `\uD45C\uBCF8
      B-17`\uC774 \uB5A8\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435295
    m_Localized: "\uBC88\uD638\uB294 \uB450\uACE0 \uAC00. \uC774\uB984\uB9CC \uB370\uB824\uAC08
      \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435296
    m_Localized: "...\uC624\uB298\uC740 \uC774\uB984\uD45C\uB97C \uC138\uB294 \uAC8C
      \uC544\uB2C8\uB77C, \uC0AC\uB78C\uC744 \uC138\uB294 \uB0A0\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435297
    m_Localized: "\uD55C \uBA85. \uC0B4\uC544\uC11C \uD55C \uBA85."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435298
    m_Localized: "\uD55C \uBA85\uC774\uB77C\uB3C4, \uC808\uCC28\uC758 \uC148\uC5D0\uC11C\uB294
      0\uC774\uC5C8\uC2B5\uB2C8\uB2E4. \uC6B0\uB9AC\uB294 1\uB85C \uC138\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435299
    m_Localized: "\uC0AC\uC721\uC7A5 \uCD9C\uAD6C\uC758 \uC5B4\uB460\uC5D0\uC11C
      \uAC80\uC740 \uB450\uB8E8\uB9C8\uB9AC\uAC00 \uBA3C\uC800 \uD3BC\uCCD0\uC9C4\uB2E4.
      \uC774\uB984\uB4E4\uC774 \uC904\uC904\uC774 \uB0B4\uB824\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435300
    m_Localized: "\uC815\uD654 \uC7AC\uD310 \uC9D1\uD589\uC790. \uBCC0\uBC29 \uC0AC\uC721\uC7A5
      \uCC45\uC784\uC790. \uBC31\uADDC \uC2A4\uD134\uD558\uC784\uC758 \uC704\uC784\uC790.
      \uC774\uB984\uC740 \uC544\uC9C1 \uBE44\uC5B4 \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435301
    m_Localized: "\uD751\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435302
    m_Localized: "\uBB35\uD5A5. \uC790\uB9E4\uC5EC. \uC774\uBC88\uC5D0\uB3C4 \uB18D\uB2F4\uC73C\uB85C
      \uBB34\uAC8C\uB97C \uB4E4\uACE0 \uC788\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435303
    m_Localized: "\uC624\uB298\uC740 \uC548 \uB4E4\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435304
    m_Localized: "\uC0AC\uC81C\uC5EC. \uADF8\uB300\uC758 \uC778\uC7A5 \uBCF4\uB958\uAC00
      \uC774 \uC774\uB984\uB4E4\uC5D0\uAC8C \uC5B4\uB5A4 \uC815\uC758\uB97C \uC8FC\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435305
    m_Localized: "\uC815\uC758\uB97C \uC8FC\uC9C0 \uBABB\uD569\uB2C8\uB2E4. \uB2E4\uB9CC
      \uC81C\uAC00 \uB354\uB294 \uADF8 \uC778\uC7A5\uC73C\uB85C \uC0AC\uB78C\uC744
      \uBD84\uB958\uD558\uC9C0 \uC54A\uACA0\uB2E4\uB294 \uC2DC\uC791\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435306
    m_Localized: "\uC2DC\uC791\uC740 \uC27D\uB2E4. \uD6C4\uC18D \uC5C6\uB294 \uC2DC\uC791\uC740
      \uC704\uC548\uC77C \uBFD0\uC774\uB77C\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435307
    m_Localized: "\uB9DE\uC544. \uADF8\uB798\uC11C \uD6C4\uC18D\uC744 \uB9CC\uB4E4\uB824\uACE0
      \uD558\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435308
    m_Localized: "\uD654\uD574\uB77C\uB294 \uC774\uB984\uC73C\uB85C \uB2E8\uC8C4\uB97C
      \uC811\uACA0\uB2E4\uB294 \uB9D0\uC778\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435309
    m_Localized: "\uC544\uB2C8. \uB2E8\uC8C4\uB9CC\uC73C\uB85C\uB294 \uC0B0 \uC0AC\uB78C\uC744
      \uBABB \uB370\uB824\uC628\uB2E4\uB294 \uB9D0\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435310
    m_Localized: "\uD751\uC9C0\uC758 \uB450\uB8E8\uB9C8\uB9AC \uB05D\uC5D0\uC11C
      \uBB35\uD5A5\uC758 \uC774\uB984\uC774 \uBCF4\uC778\uB2E4. \uB450 \uC0AC\uB78C
      \uBAA8\uB450 \uADF8 \uC904\uC744 \uBCF8\uB2E4. \uC544\uBB34\uB3C4 \uBA3C\uC800
      \uB9D0\uD558\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435311
    m_Localized: "\uADF8 \uC774\uB984\uC740 \uC544\uC9C1 \uC9C0\uC6B0\uC9C0 \uC54A\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435312
    m_Localized: "\uC9C0\uC6B0\uB77C\uACE0 \uD55C \uC801 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435313
    m_Localized: "\uC0AC\uC721\uC7A5 \uBC16. \uC774\uB984\uD45C\uB4E4\uC774 \uCC9C
      \uC704\uC5D0 \uB193\uC5EC \uC788\uB2E4. \uADF8 \uC606\uC5D0 \uC0B4\uC544 \uB098\uC628
      \uC0AC\uB78C\uB4E4\uC774 \uBAA8\uC5EC \uC549\uC544 \uC788\uB2E4. \uC5F0\uC8FC\uAC00
      \uBB3C\uC744 \uB098\uB974\uACE0, \uB2E8\uB9B0\uC740 \uC0AC\uC81C \uC778\uC7A5\uACFC
      \uBC31\uADDC\uC758 \uBA85\uB839\uC11C\uB97C \uB098\uB780\uD788 \uC190\uBC14\uB2E5
      \uC704\uC5D0 \uC62C\uB824 \uB454\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435314
    m_Localized: "\uC774 \uC778\uC7A5\uC744 \uD310\uACB0\uC5D0 \uC4F0\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.
      \uC801\uC5B4\uB3C4 \uC81C\uAC00 \uBB34\uC5C7\uC744 \uBBFF\uB294\uC9C0 \uB2E4\uC2DC
      \uB9D0\uD560 \uC218 \uC788\uC744 \uB54C\uAE4C\uC9C0\uB294."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435315
    m_Localized: "\uB098\uB294 \uD615\uC81C\uB97C \uC783\uC5C8\uC5B4. \uC8FD\uC740
      \uAC83\uB3C4 \uC544\uB2CC\uB370 \uC783\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435316
    m_Localized: "\uB098\uB294 \uD559\uC0B4\uC758 \uAE30\uC5B5\uC744 \uB4E4\uACE0\uB3C4,
      \uB204\uAD70\uAC00\uB97C \uC0B4\uB9AC\uB294 \uB370 \uB298 \uB2A6\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435317
    m_Localized: "\uB098\uB294 \uBB38\uC744 \uC5F4\uC5C8\uB2E4. \uBB38\uC774 \uC5F4\uB9AC\uC790,
      \uAC01\uC790\uC758 \uC0C1\uCC98\uB3C4 \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435318
    m_Localized: "\uADF8\uB7FC \uB2EB\uC73C\uBA74 \uC548 \uB3FC\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435319
    m_Localized: "\uB2EB\uC73C\uBA74 \uC0C1\uCC98\uB294 \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4.
      \uB0AB\uC9C0\uB3C4 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435320
    m_Localized: "\uB2EB\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uB300\uC2E0 \uC774
      \uBA85\uB839\uC11C\uB97C \uC4F0\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435321
    m_Localized: "\uC4F4\uB2E4\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435322
    m_Localized: "\uACB0\uC7AC\uB780\uC774 \uBCF8 \uB300\uC131\uB2F9 \uD615\uC2DD\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC0AC\uC721\uC7A5\uB3C4, \uD45C\uBCF8 \uBA85\uBD80\uB3C4, \uBC31\uADDC\uC758
      \uC778\uC7A5\uB3C4 \u2014 \uBCF8 \uB300\uC131\uB2F9\uC774 \uC815\uD654 \uC7AC\uD310\uC744
      \uD6C4\uC6D0\uD588\uB2E4\uB294 \uC99D\uAC70\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435323
    m_Localized: "\uC774\uAC78 \uBCF8 \uB300\uC131\uB2F9 \uAC15\uACBD\uD30C\uC5D0\uAC8C
      \uBCF4\uB0C5\uB2C8\uB2E4. \uC99D\uAC70\uAC00 \uACF5\uAC1C\uB418\uBA74 \uAC00\uC7A5
      \uACE4\uB780\uD55C \uAC74 \uADF8\uB4E4\uC785\uB2C8\uB2E4. \uADF8\uB7EC\uB2C8
      \uADF8\uB4E4\uC774 \uBA3C\uC800 \uC815\uD654 \uC7AC\uD310\uC744 \uBA48\uCD9C
      \uAC81\uB2C8\uB2E4 \u2014 \uC790\uAE30\uB97C \uC9C0\uD0A4\uB824\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435324
    m_Localized: "\uC815\uC758\uB85C \uBA48\uCD94\uB294 \uAC8C \uC544\uB2C8\uB77C
      \uC190\uD574 \uBCF4\uAE30 \uC2EB\uC5B4\uC11C \uBA48\uCD98\uB2E4\uB294 \uAC70\uB124.
      ...\uADF8\uB798\uB3C4 \uBA48\uCD94\uAE34 \uBA48\uCD94\uB294 \uAC70\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435325
    m_Localized: "\uBA48\uCD94\uAE30\uB9CC \uD558\uBA74 \uB3FC. \uADF8 \uBA85\uBD80\uC5D0
      \uB0B4 \uAC00\uC871 \uC774\uB984 \uC138 \uAC1C\uAC00 \uC788\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435326
    m_Localized: "\uC555\uB2C8\uB2E4. \uADF8\uB798\uC11C \uBCF4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435327
    m_Localized: "\uADFC\uB370 \uADF8\uAC83\uB9CC\uC73C\uB860 \uBD80\uC871\uD574.
      \uD14C\uC774\uBE14\uC774 \uD544\uC694\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435328
    m_Localized: "\uD68C\uB2F4 \uB9D0\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435329
    m_Localized: "\uADF8\uB7F0 \uC608\uC05C \uB9D0 \uB9D0\uACE0. \uBC14\uB78C\uC744
      \uAC19\uC774 \uB9C8\uC2DC\uB294 \uC790\uB9AC. \uC11C\uB85C \uBB3C\uAE30 \uC804\uC5D0
      \uB0C4\uC0C8\uBD80\uD130 \uB9E1\uB294 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435330
    m_Localized: "\uC815\uCE58\uD559\uC790\uB4E4\uC774 \uB4E4\uC73C\uBA74 \uC6B8\uACA0\uB124.
      \uC88B\uC740 \uB73B\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435331
    m_Localized: "\uB124 \uC138\uB825\uC774 \uAC19\uC740 \uC790\uB9AC\uC5D0\uC11C
      \uAC19\uC740 \uAE30\uB85D\uC744 \uBD10\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435332
    m_Localized: "\uBCC0\uBC29 \uD611\uACE1. \uCCAB \uB3C4\uC2DC \uC785\uAD6C\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435333
    m_Localized: "\uC800, \uC7BF\uACE8\uAE4C\uC9C0 \uAC19\uC774 \uAC00\uB3C4 \uB3FC\uC694?
      \uBB34\uB9AC\uB85C \uB3CC\uC544\uAC00\uBA74 \uC5B4\uB290 \uCABD\uC774\uB0D0\uACE0
      \uBA3C\uC800 \uBB3C\uC744 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435334
    m_Localized: "\uB300\uB2F5\uD560 \uC900\uBE44\uAC00 \uB420 \uB54C\uAE4C\uC9C0
      \uC5EC\uAE30 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435335
    m_Localized: "\uADF8\uB7FC \uC800\uB294 \uB6F0\uB294 \uC77C \uC798\uD574\uC694.
      \uB9D0 \uC804\uD558\uACE0, \uAE38 \uBCF4\uACE0, \uBB3C \uAC00\uC838\uC624\uACE0,
      \uC544... \uB108\uBB34 \uB9CE\uC774 \uB9D0\uD588\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435336
    m_Localized: "\uC544\uB2C8, \uC5EC\uAE30 \uD3C9\uADE0 \uC5F0\uB839\uC774 \uC880
      \uB192\uC544\uC11C \uBE60\uB978 \uBAA9\uC18C\uB9AC\uAC00 \uD544\uC694\uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435337
    m_Localized: "\uBC1C\uC774 \uBE60\uB978 \uC790\uB294 \uB2EB\uD78C \uC790\uB9AC
      \uC0AC\uC774\uB97C \uC787\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435338
    m_Localized: "\uCE6D\uCC2C... \uB9DE\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435339
    m_Localized: "\uB9DE\uC544. \uACF5\uD55C\uC2DD\uC73C\uB85C\uB294 \uAF64 \uD070
      \uCE6D\uCC2C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435340
    m_Localized: "\uC7BF\uACE8 \uAC70\uC810. \uC0AC\uC721\uC7A5\uC5D0\uC11C \uB370\uB824\uC628
      \uC0AC\uB78C\uB4E4\uC774 \uC5EC\uAD00 \uC55E\uC5D0 \uBAA8\uC5EC \uC788\uB2E4.
      \uB2EC\uBAA9\uC774 \uCC28\uB97C \uB530\uB978\uB2E4. \uAE40\uC774 \uC624\uB974\uB294
      \uB3D9\uC548, \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uACE0 \uAE30\uB2E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435341
    m_Localized: "\uC7AC \uB0C4\uC0C8\uAC00 \uC544\uB2C8\uB77C \uC1E0 \uB0C4\uC0C8\uAC00
      \uBB3B\uC73C\uC168\uB124\uC694. \uADF8\uB798\uB3C4 \uB530\uB73B\uD55C \uCC28\uB294
      \uAC19\uC740 \uCC28\uC608\uC694. \uC790\uB9AC\uB294 \uB109\uB109\uD574\uC694.
      \uCC9C\uCC9C\uD788 \uB4DC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435342
    m_Localized: "\uAC08\uB9C8\uAC00 \uD559\uD30C\uC758 \uD45C\uBCF8 \uBA85\uBD80\uB97C
      \uD3BC\uCE5C\uB2E4. `\uD45C\uBCF8 B-17` \uAC19\uC740 \uBC88\uD638\uAC00 \uC904\uC904\uC774
      \uC801\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435343
    m_Localized: "\uD559\uD30C \uBA85\uBD80\uC608\uC694. \uC0AC\uB78C\uC744 \uBC88\uD638\uB85C
      \uC801\uC5B4 \uB1A8\uAD70\uC694. ...\uC815\uCC30\uBCD1 \uAE38\uB4DC \uBA85\uB2E8\uC740
      \uADF8\uB807\uAC8C \uC548 \uC801\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435344
    m_Localized: "\uBC88\uD638 \uC606\uC5D0 \uC774\uB984\uC744 \uB2E4\uC2DC \uC801\uACA0\uC2B5\uB2C8\uB2E4.
      \uD55C \uC904\uC529. \uC2DC\uAC04\uC774 \uAC78\uB824\uB3C4, \uC7BF\uACE8 \uBA85\uB2E8\uC5D0\uC11C\uB294
      \uC0AC\uB78C\uC774 \uC0AC\uB78C\uC73C\uB85C \uC62C\uB77C\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435345
    m_Localized: "...\uC81C \uC774\uB984\uB3C4\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435346
    m_Localized: "\uB124 \uC774\uB984\uC774 \uC81C\uC77C \uC704\uC57C. \uB098\uB8E8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435347
    m_Localized: "\uAC70\uC810\uC740 \uC774 \uC0AC\uB78C\uB4E4\uC744 \uC815\uD654
      \uC7AC\uD310\uC5D0 \uB118\uAE30\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC7A1\uD654\uC0C1
      \uC790\uB9AC\uC5D0\uC11C \uC815\uD560 \uC77C\uC740 \uC544\uB2C8\uC9C0\uB9CC
      \u2014 \uC7BF\uACE8\uC740 \uC774\uBBF8 \uC815\uD588\uC5B4\uC694. \uD5A5\uCD08\uB3C4,
      \uB2F4\uC694\uB3C4, \uC798 \uC790\uB9AC\uB3C4 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435348
    m_Localized: "\uD55C\uC0C8\uAC00 \uC7BF\uACE8 \uBA85\uBD80\uB97C \uD3BC\uCE58\uACE0,
      \uC0C8 \uC904\uC744 \uC801\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435349
    m_Localized: "\uAE30\uB85D\uD569\uB2C8\uB2E4. \uC7BF\uACE8 \uAC70\uC810, \uC815\uD654
      \uD310\uACB0 \uBD88\uC218\uC6A9. \uC0AC\uC721\uC7A5 \uC0DD\uC874\uC790 \uC804\uC6D0
      \u2014 \uD45C\uBCF8 \uC544\uB2D8, \uC0AC\uB78C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435350
    m_Localized: "\uAC70\uC810 \uBB38\uC73C\uB85C \uC804\uB839 \uD558\uB098\uAC00
      \uB4E4\uC5B4\uC628\uB2E4. \uC816\uC740 \uBD09\uC778 \uBB38\uC11C\uB97C \uB2E8\uB9B0\uC5D0\uAC8C
      \uAC74\uB128\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435351
    m_Localized: "\uBCF8 \uB300\uC131\uB2F9 \uC9C1\uC778\uC785\uB2C8\uB2E4. ...\uBCC0\uBC29
      \uC815\uD654 \uC7AC\uD310, \uC77C\uC2DC \uC815\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435352
    m_Localized: "\uBCF4\uB0C8\uB354\uB2C8, \uBA48\uCDC4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435353
    m_Localized: "'\uC77C\uC2DC'\uC785\uB2C8\uB2E4. \uC601\uAD6C\uAC00 \uC544\uB2D9\uB2C8\uB2E4.
      \uADF8\uB4E4\uC740 \uC7AC\uD310\uC744 \uBC84\uB9B0 \uAC8C \uC544\uB2C8\uB77C,
      \uC7A0\uAE50 \uC190\uC5D0\uC11C \uB0B4\uB824\uB193\uC558\uC744 \uBFD0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435354
    m_Localized: "\uADF8\uB798\uB3C4 \uBA48\uCDC4\uC5B4. \uB0B4 \uAC00\uC871 \uC774\uB984\uC744
      \uBA85\uBD80\uC5D0 \uC801\uC740 \uADF8 \uC808\uCC28\uAC00, \uC624\uB298 \uBA48\uCDC4\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435355
    m_Localized: "\uC774\uACBC\uB294\uB370 \uC774\uAE34 \uB0C4\uC0C8\uAC00 \uC548
      \uB098. \uD68C\uC870 \uC790\uB9AC\uAC00 \uBE44\uC5B4\uC11C \uADF8\uB798."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435356
    m_Localized: "\uB0C4\uC0C8\uAC00 \uC548 \uB098\uB3C4, \uC6B0\uB9AC\uB294 \uBE44\uC6E0\uC5B4.
      \uC544\uC774\uB294 \uC0B4\uC544 \uB098\uC654\uACE0. \uADF8\uAC74 \uC774\uAE34
      \uAC70 \uB9DE\uC544, \uC774\uBE68\uBC14\uB78C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435357
    m_Localized: "\uBCC0\uBC29 \uD611\uACE1\uC73C\uB85C \uAC11\uB2C8\uB2E4. \uCCAB
      \uB3C4\uC2DC \uC785\uAD6C\uC5D0\uC11C, \uB124 \uC138\uB825\uC744 \uAC19\uC740
      \uC790\uB9AC\uB85C \uBD80\uB974\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435358
    m_Localized: "\uD68C\uC870 \uC624\uBE60\uB3C4... \uBD80\uB97C \uAC70\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435359
    m_Localized: "\uBD88\uB7EC. \uD615\uC81C\uB294 \uBA40\uC5B4\uC838\uB3C4 \uAE38
      \uC774\uB984\uC740 \uC54C\uC544\uC57C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435360
    m_Localized: "\uCD08\uB300\uC7A5 \uBB38\uAD6C\uB294 \uC880 \uBD80\uB4DC\uB7FD\uAC8C
      \uC4F0\uC790. '\uC548 \uC624\uBA74 \uB9DD\uD55C\uB2E4'\uB294 \uB108\uBB34 \uC9C1\uC124\uC801\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435361
    m_Localized: "\uADFC\uB370 \uB9DE\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435362
    m_Localized: "\uC720\uB9AC \uC232\uC758 \uD30C\uD3B8 \uD558\uB098\uAC00 \uAC70\uC810
      \uCD1B\uBD88 \uC55E\uC5D0 \uC138\uC6CC\uC9C4\uB2E4. \uD30C\uD3B8 \uC548\uC5D0\uB294
      \uB450 \uC5EC\uC790\uAC00 \uBE44\uCE5C\uB2E4. \uD558\uB098\uB294 \uC778\uC7A5\uC744
      \uC190\uC5D0 \uC950\uACE0 \uC788\uACE0, \uD558\uB098\uB294 \uBB34\uB98E \uAFC7\uC740
      \uCC44 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uC74C\uC131\uC744 \uB4E3\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435363
    m_Localized: "\uC120\uC601\uC740 \uAE38\uC744 \uC783\uC740 \uAC8C \uC544\uB2D0\uC9C0\uB3C4
      \uBAA8\uB985\uB2C8\uB2E4. \uAE38\uC744 \uD558\uB098\uB9CC \uB0A8\uAE34 \uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435364
    m_Localized: "\uAE38 \uD558\uB098\uB9CC \uB0A8\uAE30\uBA74 \uD3B8\uD558\uC9C0.
      \uBB38\uC81C\uB294 \uC0AC\uB78C \uBC1C\uC774 \uB458\uC774\uB77C\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435365
    m_Localized: "\uB2E4\uB978 \uD30C\uD3B8\uC5D0\uB294 \uB450 \uC0AC\uB0E5\uAFBC\uC758
      \uC190\uBAA9\uC774 \uBE44\uCE5C\uB2E4. \uAC19\uC740 \uD749\uD130. \uB2E4\uB978
      \uBC29\uD5A5."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435366
    m_Localized: "\uD68C\uC870\uB294 \uC8FD\uC9C0 \uC54A\uC558\uC5B4. \uADF8\uB798\uC11C
      \uB354 \uC544\uD30C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435367
    m_Localized: "\uACC1\uC5D0 \uC788\uACA0\uC2B5\uB2C8\uB2E4. \uC704\uB85C\uAC00
      \uB418\uC9C0 \uC54A\uB354\uB77C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435368
    m_Localized: "\uADF8\uAC74 \uC704\uB85C\uBCF4\uB2E4 \uB098\uC544. \uB3C4\uB9DD\uAC00\uC9C0
      \uC54A\uB294 \uB0C4\uC0C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435369
    m_Localized: "\uB2E4\uC74C\uC740 \uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435370
    m_Localized: "\uADF8\uB9AC\uACE0 \uBB38 \uC55E\uC5D0\uB294, \uC774\uB984\uC744
      \uB4E4\uACE0 \uC628 \uC0AC\uB78C\uB4E4\uC774 \uC11C \uC788\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435371
    m_Localized: "\uD611\uACE1\uC740 \uAE38\uC774 \uC544\uB2C8\uB77C \uBB38\uC774\uC5C8\uB2E4.
      \uBC14\uB78C\uC740 \uC548\uCABD\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC9C0 \uBABB\uD558\uACE0,
      \uB3CC\uBCBD \uC55E\uC5D0\uC11C \uB0AE\uAC8C \uC811\uD614\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435372
    m_Localized: "...\uBC14\uB78C\uC774 \uC8FD\uC5C8\uC5B4. \uC5EC\uAE34 \uC0B0\uAE38\uC774
      \uC544\uB2C8\uC57C. \uB204\uAC00 \uC228\uC744 \uB9C9\uC544 \uB193\uC740 \uC790\uB9AC\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435373
    m_Localized: "\uCCAB \uB3C4\uC2DC\uC758 \uC785\uAD6C\uB2E4. \uC6B0\uB9AC \uACB0\uC0AC\uB294
      \uC774 \uBB38\uC744 1800\uB144 \uB3D9\uC548 \uB2E4\uC2DC \uBB36\uC5B4 \uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435374
    m_Localized: "\uC624\uB798 \uBB36\uC5C8\uB124. \uC190\uAC00\uB77D\uC774 \uB0A8\uC544\uB09C
      \uAC8C \uC2E0\uAE30\uD560 \uC815\uB3C4\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435375
    m_Localized: "\uC624\uB298\uC740 \uD480\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uBB36\uC740
      \uC190\uC774 \uB204\uAD6C\uC758 \uC190\uC778\uC9C0\uB3C4, \uD480 \uC190\uC774
      \uB204\uAD6C\uC758 \uC190\uC778\uC9C0\uB3C4 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435376
    m_Localized: "\uB124 \uAC08\uB798 \uBB38\uC591\uC774 \uAD00\uBB38 \uC704\uC5D0\uC11C
      \uCC28\uB840\uB85C \uBE5B\uC744 \uC783\uC5C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uBE5B\uC740
      \uC548\uCABD\uC73C\uB85C \uB5A8\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435377
    m_Localized: "\uC7BF\uACE8 \uD68C\uC758\uC2E4 \uC911\uC559\uC5D0 \uB0A1\uC740
      \uD0C1\uC790\uAC00 \uB193\uC600\uB2E4. \uC758\uC790\uB294 \uB124 \uAC1C\uC600\uACE0,
      \uADF8\uC911 \uB458\uC740 \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435378
    m_Localized: "\uBCF8 \uB300\uC131\uB2F9\uC758 \uC815\uC2DD \uC758\uC790\uB294
      \uC544\uC9C1 \uBE44\uC6CC \uB454\uB2E4. \uD68C\uC870 \uCABD\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uB2E4.
      \uC624\uB298 \uC549\uC9C0 \uC54A\uB294 \uC790\uB9AC\uAC00 \uB354 \uBA40\uB9AC
      \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435379
    m_Localized: "\uD68C\uC870 \uCABD \uC758\uC790\uB294 \uBE44\uC6CC \uB46C. \uC548
      \uC62C \uAC70\uC57C. \uADF8\uB798\uB3C4 \uBE44\uC6CC \uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435380
    m_Localized: "\uBCF8 \uB300\uC131\uB2F9 \uCABD\uB3C4 \uB2F5\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uB2F5\uD558\uC9C0 \uC54A\uB294 \uAC83\uB3C4 \uB2F5\uC774\uACA0\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435381
    m_Localized: "\uBE48 \uC758\uC790 \uB458, \uC0B4\uC544 \uC788\uB294 \uC0AC\uB78C
      \uB137. \uD68C\uC758\uCE58\uACE0\uB294 \uCD9C\uC11D\uB960\uC774 \uAD1C\uCC2E\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435382
    m_Localized: "\uBE48 \uC790\uB9AC\uAC00 \uC788\uC5B4\uC57C \uC57D\uC18D\uC774
      \uC5B4\uB514\uC11C \uB04A\uACBC\uB294\uC9C0 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435383
    m_Localized: "\uC624\uB298\uC740 \uBCF4\uB7EC \uAC00\uB294 \uAC8C \uC544\uB2C8\uC57C.
      \uB4E4\uACE0 \uB3CC\uC544\uC62C \uAC70\uC57C. \uBB34\uB9AC\uAC00 \uB3C4\uB9DD
      \uBABB \uAC00\uAC8C. \uB098\uB3C4 \uBABB \uAC00\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435384
    m_Localized: "\uADF8\uB7FC \uAC11\uC2DC\uB2E4. \uBB38 \uC55E\uC5D0\uC11C \uB9D0\uC774
      \uD754\uB4E4\uB9AC\uBA74, \uC548\uCABD\uC5D0\uC11C\uB294 \uC544\uBB34\uAC83\uB3C4
      \uC9C0\uD0AC \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435385
    m_Localized: "\uC9C0\uB3C4\uB294 \uBCC0\uBC29 \uD611\uACE1\uC744 \uB9C9\uB2E4\uB978
      \uAE38\uB85C \uD45C\uC2DC\uD588\uB2E4. \uACF5\uD55C\uC740 \uADF8 \uB05D\uC5D0
      \uC791\uC740 \uB9E4\uB4ED \uD45C\uC2DC\uB97C \uB367\uADF8\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435386
    m_Localized: "\uC9C0\uB3C4\uC5D0 \uC5C6\uC5C8\uB358 \uAC8C \uC544\uB2C8\uB2E4.
      \uC9C0\uB3C4\uC5D0 \uB0A8\uAE30\uC9C0 \uC54A\uAE30\uB85C \uD55C \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435387
    m_Localized: "\uACB0\uC0AC \uC0AC\uB78C\uB4E4\uC740 \uBE48\uCE78\uB3C4 \uC131\uC2E4\uD558\uAC8C
      \uAD00\uB9AC\uD55C\uB2E4\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435388
    m_Localized: "\uB0C4\uC0C8\uAC00 \uC548\uCABD\uC73C\uB85C \uB04A\uACA8. \uC0AC\uB78C\uB3C4,
      \uC9D0\uC2B9\uB3C4, \uBC14\uB78C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435389
    m_Localized: "\uADF8\uB7FC \uC548\uCABD\uC5D0 \uC788\uB294 \uAC74 \uAE30\uB85D\uBFD0\uC774\uACA0\uAD70\uC694.
      \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC73C\uB2C8 \uB354 \uC704\uD5D8\uD55C \uAE30\uB85D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435390
    m_Localized: "\uAE30\uB85D\uC740 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC544\uB3C4
      \uC0AC\uB78C\uC744 \uC6C0\uC9C1\uC774\uAC8C \uD55C\uB2E4. \uADF8\uB798\uC11C
      \uB2EB\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435391
    m_Localized: "\uAD00\uBB38\uC740 \uBC18\uCBE4 \uB545\uC5D0 \uBB3B\uD600 \uC788\uC5C8\uB2E4.
      \uB3CC \uC704\uC5D0\uB294 \uB124 \uAC08\uB798\uC758 \uC190\uC790\uAD6D\uC774
      \uB0A8\uC544 \uC788\uC5C8\uACE0, \uAC00\uC7A5 \uAC00\uC6B4\uB370\uB294 \uBE44\uC5B4
      \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435392
    m_Localized: "\uAC00\uC6B4\uB370\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4. \uB204\uAC00
      \uC758\uB3C4\uC801\uC73C\uB85C \uAE4E\uC544 \uB0C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435393
    m_Localized: "\uC544\uB2C8\uB2E4. \uAC00\uC6B4\uB370\uB294 \uC6D0\uB798 \uBE44\uC5B4
      \uC788\uC5C8\uB2E4. \uB124 \uAC08\uB798\uAC00 \uC11C\uB85C\uB97C \uBCF4\uAC8C
      \uD558\uB824\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435394
    m_Localized: "\uC11C\uB85C \uBCF4\uAC8C \uB9CC\uB4E0 \uC790\uB9AC\uAC00 \uC65C
      \uC774\uB807\uAC8C \uC870\uC6A9\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435395
    m_Localized: "\uC11C\uB85C \uBCF8 \uB4A4\uC5D0 \uCE7C\uC744 \uB4E4\uC5C8\uC73C\uB2C8\uAE4C.
      \uC870\uC6A9\uD55C \uC790\uB9AC\uB294 \uB300\uAC1C \uB9C8\uC9C0\uB9C9 \uC0AC\uB78C\uC774
      \uB9CC\uB4E0\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435396
    m_Localized: "\uC624\uB298\uC740 \uB9C8\uC9C0\uB9C9 \uC0AC\uB78C\uC774 \uB418\uC9C0
      \uB9D9\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435397
    m_Localized: "\uB2A6\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uB2E4\uC74C \uC0AC\uB78C\uC774
      \uB420 \uC218\uB294 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435398
    m_Localized: "\uC800\uB294 \uC0AC\uC81C \uC778\uC7A5\uC744 \uB0B4\uB824\uB193\uC744
      \uAC81\uB2C8\uB2E4. \uC624\uB298 \uBCF8 \uAC83\uC744 \uBCF8 \uB300\uC131\uB2F9\uC758
      \uB9D0\uB85C\uB9CC \uC815\uB9AC\uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435399
    m_Localized: "\uB098\uB294 \uBB34\uB9AC \uBC18\uCABD\uC744 \uC783\uC5C8\uC5B4.
      \uB098\uBA38\uC9C0 \uBC18\uCABD\uB3C4 \uB098\uB97C \uBBFF\uC744\uC9C0 \uBAB0\uB77C.
      \uADF8\uB798\uB3C4 \uB0C4\uC0C8\uB97C \uC9C0\uC6B0\uC9C4 \uC54A\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435400
    m_Localized: "\uB098\uB294 \uD751\uC9C0\uC758 \uB450\uB8E8\uB9C8\uB9AC\uB97C
      \uB354 \uB450\uAECD\uAC8C \uB9CC\uB4E4\uACA0\uC9C0. \uC5B4\uCA4C\uACA0\uB098.
      \uC587\uC740 \uB450\uB8E8\uB9C8\uB9AC\uAC00 \uC138\uC0C1\uC744 \uAD6C\uD55C
      \uC801\uC740 \uC5C6\uB354\uB77C\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435401
    m_Localized: "\uB098\uB294 \uACB0\uC0AC \uC548\uC758 \uC774\uB984\uC744 \uC783\uC744
      \uAC83\uC774\uB2E4. \uB300\uC2E0 \uBC14\uAE65\uC5D0\uC11C \uBD80\uB97C \uC774\uB984\uC744
      \uD558\uB098 \uC5BB\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435402
    m_Localized: "\uC783\uB294 \uAC83\uC744 \uBA3C\uC800 \uB9D0\uD588\uC73C\uB2C8,
      \uC774\uC81C \uC11C\uB85C\uC758 \uB9D0\uC744 \uBE4C\uB824 \uC4F8 \uC218 \uC788\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435403
    m_Localized: "\uBE4C\uB824 \uC4F0\uACE0 \uAC1A\uC544. \uBB34\uB9AC\uC758 \uBC95\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435404
    m_Localized: "\uC0AC\uC81C\uB2D8, \uC774\uAC74 \uC774\uC790\uB97C \uAF64 \uC138\uAC8C
      \uBB3C\uC5B4\uC57C\uACA0\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435405
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC740 \uD611\uACE1 \uBC14\uB2E5\uC5D0
      \uC138 \uBC88 \uCE7C\uC9D1\uC744 \uB0C8\uB2E4. \uCCAB \uC0AC\uB0E5 \uB54C \uC4F0\uB358
      \uC2E0\uD638\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435406
    m_Localized: "\uB2F5\uC774 \uC62C\uAE4C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435407
    m_Localized: "\uC624\uC9C0 \uC54A\uB294 \uB2F5\uB3C4 \uC788\uC5B4. \uADF8\uAC78
      \uB4E4\uC73C\uB824\uACE0 \uBCF4\uB0B8 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435408
    m_Localized: "\uBA3C \uC808\uBCBD\uC5D0\uC11C \uB3CC \uD558\uB098\uAC00 \uAD74\uB7EC
      \uB5A8\uC5B4\uC84C\uB2E4. \uC138 \uBC88, \uADF8\uB9AC\uACE0 \uD55C \uBC88 \uB354."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435409
    m_Localized: "...\uC0B4\uC544 \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435410
    m_Localized: "\uC548 \uC628\uB2E4\uB294 \uB9D0\uC774\uAD70. \uADF8\uB798\uB3C4
      \uB04A\uC9C0\uB294 \uC54A\uC558\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435411
    m_Localized: "\uADF8\uB798. \uD615\uC81C\uB2F5\uB124. \uBE44\uAC81\uD558\uAC8C
      \uB2E4\uC815\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435412
    m_Localized: "...\uC790\uB9E4\uC5EC. \uADF8\uB300\uAC00 \uB3C4\uC2DC \uC548\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uB824 \uD55C\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435413
    m_Localized: "\uB4E4\uC5B4\uAC00\uC57C \uD574. \uC548\uCABD\uC5D0\uC11C \uC369\uC740
      \uAC78 \uBC14\uAE65 \uD759\uC73C\uB85C \uB36E\uC744 \uC218\uB294 \uC5C6\uC73C\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435414
    m_Localized: "\uADF8\uB300 \uACB0\uC815\uC758 \uBB34\uAC8C\uB97C \uBA85\uB2E8\uC73C\uB85C
      \uC778\uC815\uD558\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435415
    m_Localized: "\uD751\uC9C0\uB294 \uC774\uB984\uC744 \uC77D\uAE30 \uC2DC\uC791\uD588\uB2E4.
      \uCC98\uC74C\uC5D4 \uB0AE\uAC8C, \uB2E4\uC74C\uC5D4 \uBE60\uB974\uAC8C. \uB9C8\uC9C0\uB9C9
      \uC774\uB984 \uC55E\uC5D0\uC11C \uC228\uC774 \uB04A\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435416
    m_Localized: "...\uBB35\uD5A5."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435417
    m_Localized: "\uADF8\uB798. \uB0B4 \uC774\uB984\uC774\uB124. \uC624\uB798 \uBD10\uB3C4
      \uAE00\uC528\uAC00 \uB098\uC544\uC9C0\uC9C4 \uC54A\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435418
    m_Localized: "\uB3C4\uC2DC \uC548\uC5D0\uC11C \uACB0\uC815\uC744 \uB0B4\uB9B4
      \uB54C \uC774 \uC774\uB984\uB4E4\uC744 \uD568\uAED8 \uB4E4\uACE0 \uB4E4\uC5B4\uAC00\uB77C\uB124.
      \uADF8\uAC83\uC774 \uADF8\uB300\uAC00 \uADF8\uB300 \uC790\uC2E0\uC758 \uC774\uB984\uC744
      \uBA85\uB2E8\uC5D0\uC11C \uBE7C\uB294 \uC720\uC77C\uD55C \uBC29\uBC95\uC774\uB77C\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435419
    m_Localized: "\uBE7C \uB2EC\uB77C\uACE0 \uD558\uC9C4 \uC54A\uC744\uAC8C. \uB2E4\uB9CC
      \uC790\uB9AC\uAC00 \uBE44\uBA74, \uC78E \uD558\uB098\uB294 \uB07C\uC6CC \uB46C.
      \uB0B4\uAC00 \uBD24\uB2E4\uB294 \uD45C\uC2DC\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435420
    m_Localized: "...\uBA48\uCD94\uC2ED\uC2DC\uC624. \uB3C4\uC2DC\uB294 \uC678\uBD80\uC758
      \uBC1C\uC774 \uB2FF\uC744 \uC790\uB9AC\uAC00 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435421
    m_Localized: "\uD615\uC81C. \uB3C4\uC2DC \uC548\uC5D0\uC11C \uD559\uD30C\uAC00
      \uAE30\uB85D\uC744 \uBB34\uAE30\uB85C \uB9CC\uB4E4\uACE0 \uC788\uB2E4. \uC6B0\uB9AC\uAC00
      \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uC73C\uBA74 \uBC31\uADDC\uAC00 \uACB0\uC815\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435422
    m_Localized: "\uD559\uD30C\uAC00 \uACB0\uC815\uD574\uB3C4 \uACB0\uC0AC\uAC00
      \uCE68\uBB35\uD558\uBA74 \uBB34\uAE30\uB294 \uD6A8\uB825\uC744 \uC783\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435423
    m_Localized: "\uCE68\uBB35\uC774 1800\uB144 \uB3D9\uC548 \uD559\uD30C\uC758 \uC57C\uC2EC\uC744
      \uB9C9\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435424
    m_Localized: "\uCE68\uC6D4\uC758 \uCE68\uBB35\uC774 \uAE38\uC5B4\uC84C\uB2E4.
      \uADF8\uB140\uB294 \uCC98\uC74C\uC73C\uB85C \uD6C4\uB4DC\uB97C \uBC97\uC5C8\uB2E4.
      \uB2EC\uBE5B \uAC19\uC740 \uBA38\uB9AC\uCE7C \uC544\uB798, \uC774\uB9C8\uC758
      \uBB38\uC591\uC774 \uCC28\uAC11\uAC8C \uB4DC\uB7EC\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435425
    m_Localized: "\uADF8 \uACB0\uC815\uC758 \uBE44\uC6A9\uC744 \uCCAD\uAD6C\uD558\uB7EC
      \uC654\uC2B5\uB2C8\uB2E4. \uC2DC\uC870\uC758 \uC57D\uC18D\uC744 \uC5B4\uAE34
      \uC790\uB294 \uC2DC\uC870\uC758 \uC790\uB9AC\uB97C \uC783\uC2B5\uB2C8\uB2E4.
      \uB3C4\uC2DC \uC548\uC5D0 \uB4E4\uC5B4\uAC00\uB294 \uC21C\uAC04, \uB2F9\uC2E0\uC740
      \uB354 \uC774\uC0C1 \uACB0\uC0AC \uD6C4\uC608\uAC00 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435426
    m_Localized: "\uC54C\uACE0 \uC788\uB2E4. \uB4E4\uC5B4\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435427
    m_Localized: "\uB4E4\uC5B4\uAC00\uC2ED\uC2DC\uC624. \uB2E4\uB9CC \uBC14\uAE65\uC5D0\uC11C\uB294,
      \uB2F9\uC2E0\uC774 \uACB0\uC0AC \uD6C4\uC608\uC600\uB2E4\uB294 \uC0AC\uC2E4\uC740
      \uC78A\uD799\uB2C8\uB2E4. \uACB0\uC0AC\uAC00 \uADF8\uB807\uAC8C \uACB0\uC815\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435428
    m_Localized: "\uC78A\uC5B4\uB77C. \uB098\uB294 \uAE30\uC5B5\uD558\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435429
    m_Localized: "\uCE68\uC6D4\uC774 \uAE38\uC744 \uBE44\uCF30\uB2E4. \uACF5\uD55C\uC740
      \uBB38 \uC548\uCABD\uC73C\uB85C \uAC78\uC5B4 \uB4E4\uC5B4\uAC14\uB2E4. \uADF8
      \uC21C\uAC04 \uADF8\uC758 \uC774\uB984 \uD558\uB098\uAC00 \uB4A4\uC5D0 \uB0A8\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435430
    m_Localized: "\uB300\uD45C \uC778\uC7A5 \u2014 \uBD88\uC77C\uCE58. \uC774 \uAE30\uB85D\uC740
      \uC989\uC2DC \uBC31\uADDC \uD559\uC790\uC7A5\uC5D0\uAC8C \uAC04\uB2E4. \uC790\uACA9
      \uC5C6\uB294 \uC99D\uC5B8\uC740, \uB3C4\uCC29 \uC804\uC5D0 \uD3D0\uAE30\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435431
    m_Localized: "\uC790\uACA9\uC744 \uBB3B\uB294 \uBB38\uC740 \uB9CE\uC774 \uBD24\uC2B5\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uC99D\uC5B8\uC744 \uD3D0\uAE30\uD558\uB294 \uBB38\uC740,
      \uC624\uB298 \uB04A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435432
    m_Localized: "\uD559\uD30C\uAC00 \uC0AC\uB78C\uC744 \uBB38\uC73C\uB85C \uC138\uC6CC
      \uB1A8\uB124. \uBB38\uC740 \uBD80\uC218\uBA74 \uB418\uC9C0\uB9CC, \uC0AC\uB78C\uD55C\uD14C\uB294
      \uD55C \uBC88 \uBE44\uD0A4\uB77C\uACE0 \uBB3C\uC5B4\uBD10 \uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435433
    m_Localized: "\uC774 \uBB38\uC740 \uACB0\uC0AC\uAC00 \uC7A0\uADFC \uBB38\uC774\uB2E4.
      \uC9C0\uAE08\uC740 \uD559\uD30C\uAC00 \uBE4C\uB824 \uC4F0\uACE0 \uC788\uB2E4.
      \uBE4C\uB9B0 \uC190\uBD80\uD130 \uBE44\uD0A4\uAC8C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435434
    m_Localized: "\uC218\uBB38\uC7A5\uC774 \uBB34\uB98E\uC744 \uAFC7\uC5C8\uB2E4.
      \uC190\uBC14\uB2E5 \uC544\uB798 \uC1A1\uC2E0\uD310\uC744 \uC228\uAE30\uB824
      \uD588\uC9C0\uB9CC, \uC190\uC774 \uB5A8\uB838\uB2E4. \uB2E8\uB9B0\uC740 \uADF8
      \uC190\uC744 \uBC1F\uC9C0 \uC54A\uACE0, \uC1A1\uC2E0\uD310\uB9CC \uAC77\uC5B4
      \uB0C8\uB2E4. \uAD00\uBB38\uC758 \uBE48 \uAC00\uC6B4\uB370\uAC00 \uCC9C\uCC9C\uD788
      \uC5F4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435435
    m_Localized: "\uC774\uC81C \uD551\uACC4\uAC00 \uC5C6\uC5B4\uC84C\uB124. \uBB38\uC774
      \uB9C9\uC544\uC11C \uBABB \uB4E4\uC5B4\uAC14\uB2E4\uACE0 \uB9D0\uD560 \uC218\uB3C4
      \uC5C6\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435436
    m_Localized: "\uC88B\uC2B5\uB2C8\uB2E4. \uD551\uACC4\uAC00 \uC5C6\uB294 \uCABD\uC774
      \uAE30\uB3C4\uBCF4\uB2E4 \uB0AB\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435437
    m_Localized: "\uC548\uCABD\uC5D0 \uAE30\uB85D\uAD00\uC774 \uC788\uB2E4. \uC6B0\uB9AC\uAC00
      \uACB0\uC815\uC744 \uB0B4\uB9AC\uAE30 \uC804\uC5D0, \uACB0\uC815\uC744 \uAE30\uB85D\uD560
      \uC0AC\uB78C\uC774 \uD544\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435438
    m_Localized: "\uBB38 \uC548\uCABD \uC2E0\uC804\uC5D0\uB294 \uAC70\uC6B8 \uD558\uB098\uAC00
      \uC138\uC6CC\uC838 \uC788\uC5C8\uB2E4. \uAC70\uC6B8 \uC55E\uC758 \uC5EC\uC778\uC774
      \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4. \uADF8\uB140\uAC00 \uAC70\uC6B8\uC744
      \uC0B4\uC9DD \uAE30\uC6B8\uC774\uC790, \uB124 \uAC08\uB798 \uBB38\uC591\uC774
      \uCC28\uB840\uB85C \uBE44\uCCE4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435439
    m_Localized: "\uB124 \uAC08\uB798\uC758 \uC57D\uC18D\uC744 \uB4E3\uAE30 \uC704\uD574
      \uC654\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435440
    m_Localized: "\uBA85\uC74C. \uACB0\uC0AC\uAC00 \uD5C8\uB77D\uD588\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435441
    m_Localized: "\uD5C8\uB77D\uC740 \uB4A4\uC5D0 \uBC1B\uACA0\uC2B5\uB2C8\uB2E4.
      \uC9C0\uAE08\uC740 \uAE30\uB85D\uC774 \uBA3C\uC800\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435442
    m_Localized: "\uB9C8\uC74C\uC5D0 \uB4DC\uB124. \uAE30\uB85D\uAD00\uB4E4\uC774\uB780
      \uB300\uCCB4\uB85C \uB9D0\uC774 \uBB34\uC12D\uB2E4\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435443
    m_Localized: "\uC0AC\uC81C \uB2E8\uB9B0. \uC624\uB298\uC758 \uB9D0\uC740 \uD55C
      \uC5BC\uAD74\uB85C \uBD99\uC774\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uAC70\uC6B8\uC740
      \uAE68\uC9C4 \uC120\uC744 \uADF8\uB300\uB85C \uBE44\uCDA5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435444
    m_Localized: "\uADF8\uB807\uB2E4\uBA74 \uC81C \uBB38\uC7A5\uB3C4 \uB0B4\uB824\uB193\uACA0\uC2B5\uB2C8\uB2E4.
      \uD544\uC694\uD55C \uB9CC\uD07C\uB9CC \uC4F0\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435445
    m_Localized: "\uB3C4\uC2DC \uBB38\uD131 \uC55E\uC5D0 \uC120\uC601\uC774 \uBB34\uB98E\uC744
      \uAFC7\uACE0 \uC788\uC5C8\uB2E4. \uC0AC\uC81C\uBCF5 \uC790\uB77D\uC5D0\uB294
      \uD770 \uBA3C\uC9C0\uAC00 \uBB3B\uC5C8\uACE0, \uC190\uB05D\uC740 \uACC4\uC18D
      \uAC19\uC740 \uBB38\uC7A5\uC744 \uB354\uB4EC\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435446
    m_Localized: "...\uC790\uB9E4\uC5EC. \uC774\uBC88\uC5D0\uB294 \uC815\uB9D0 \uB2F5\uBCF4\uB2E4
      \uC9C8\uBB38\uC744 \uBA3C\uC800 \uB4E4\uACE0 \uC624\uC168\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435447
    m_Localized: "\uC120\uC601. \uB098\uB294 \uC778\uC7A5\uC744 \uC7A0\uC815 \uBC18\uB0A9\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435448
    m_Localized: "\uC790\uACA9\uC744 \uB0B4\uB824\uB193\uC740 \uC790\uAC00 \uB3C4\uC2DC\uC5D0
      \uB4E4\uC5B4\uAC00\uB824 \uD558\uB2E4\uB2C8. \uAE30\uB3C4\uBB38 \uD55C \uC904\uC744
      \uD2C0\uB824 \uD63C\uB098\uB358 \uB0A0\uC5D0\uB3C4, \uC790\uB9E4\uB294 \uC4F0\uB7EC\uC9C4
      \uC544\uC774\uBD80\uD130 \uC138\uC5C8\uC9C0\uC694. \uD2C0\uB9AC\uACE0\uB3C4,
      \uC544\uC9C1 \uBB3B\uC2B5\uB2C8\uAE4C. \uADF8\uBD84\uC758 \uC74C\uC131\uC774
      \uB4E4\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435449
    m_Localized: "\uB4E4\uB9AC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098
      \uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uC790\uB3C4 \uBB38 \uC55E\uC5D0 \uC124 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uBB3B\uAE30 \uC704\uD574\uC11C\uB77C\uBA74."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435450
    m_Localized: "\uBB3B\uB294 \uC790... \uC6B0\uB9AC\uB294 \uB2F5\uC744 \uBC30\uC6E0\uB294\uB370\uC694.
      \uB2F5\uC774 \uC788\uC5B4\uC57C \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435451
    m_Localized: "\uADF8\uB798\uC11C \uB0B4\uAC00 \uD2C0\uB838\uC2B5\uB2C8\uB2E4.
      \uB2F5\uB9CC \uBC30\uC6B4 \uC0AC\uC81C\uB294 \uC0AC\uB78C \uC55E\uC5D0\uC11C
      \uB108\uBB34 \uBE68\uB9AC \uBB38\uC7A5\uC744 \uB05D\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435452
    m_Localized: "\uC120\uC601\uC740 \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4.
      \uADF8\uB140\uC758 \uC2DC\uC120\uC740 \uB2E8\uB9B0\uC744 \uC9C0\uB098, \uB3C4\uC2DC
      \uC548\uCABD\uC758 \uBC31\uC0C9 \uBD88\uBE5B\uC744 \uD5A5\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435453
    m_Localized: "\uCCAB \uB3C4\uC2DC\uB294 \uBB34\uB108\uC838 \uC788\uC5C8\uC9C0\uB9CC
      \uD3D0\uD5C8 \uAC19\uC9C0\uB294 \uC54A\uC558\uB2E4. \uB204\uAD70\uAC00 \uB9E4\uC77C
      \uBA3C\uC9C0\uB97C \uD138\uACE0, \uC544\uBB34\uB3C4 \uC0B4\uC9C0 \uC54A\uB294
      \uBC29\uC744 \uC815\uB9AC\uD55C \uD754\uC801\uC774 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435454
    m_Localized: "\uB0C4\uC0C8\uAC00 \uB108\uBB34 \uAE68\uB057\uD574. \uC8FD\uC740
      \uC790\uB9AC\uC778\uB370, \uC369\uC740 \uB0C4\uC0C8\uAC00 \uC5C6\uC5B4. \uB204\uAC00
      \uACC4\uC18D \uC228\uACA8 \uC654\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435455
    m_Localized: "\uC624\uB798 \uC228\uAE30\uBA74 \uB0C4\uC0C8\uB3C4 \uC608\uC808\uC744
      \uBC30\uC6B4\uB2E4\uB124. \uADF8\uB798\uC11C \uB354 \uB098\uBE60."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435456
    m_Localized: "\uACB0\uC0AC\uAC00 \uD55C \uC77C\uC774\uB2E4. \uC8FD\uC74C\uC744
      \uBCF4\uC874\uD558\uB824\uB2E4 \uC8FD\uC74C\uC758 \uB0C4\uC0C8\uB97C \uC9C0\uC6E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435457
    m_Localized: "\uC624\uB298\uC740 \uB0C4\uC0C8\uAE4C\uC9C0 \uAE30\uB85D\uD569\uC2DC\uB2E4.
      \uAE68\uB057\uD55C \uC8C4\uB3C4 \uC8C4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435458
    m_Localized: "\uAE30\uB85D. \uC228\uAE34 \uD754\uC801 \uD3EC\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435459
    m_Localized: "\uD68C\uC758\uC2E4 \uC911\uC559\uC5D0\uB294 \uB124 \uAC1C\uC758
      \uB3C4\uAD6C\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uC0AC\uC81C\uC758 \uC778\uC7A5,
      \uBD80\uC871\uC758 \uCE7C, \uACB0\uC0AC\uC758 \uB450\uB8E8\uB9C8\uB9AC, \uB2EB\uD78C
      \uAC70\uC6B8. \uBAA8\uB450 \uD53C\uAC00 \uBB3B\uC740 \uCC44\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435460
    m_Localized: "\uC0AC\uC81C\uC758 \uC778\uC7A5\uC774... \uC5EC\uAE30 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC815\uD654 \uC7AC\uD310\uBCF4\uB2E4 \uBA3C\uC800."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435461
    m_Localized: "\uCE7C \uBAA8\uC591\uC774 \uC6B0\uB9AC \uCABD\uC774\uC57C. \uC190\uC7A1\uC774
      \uB9E4\uB4ED\uB3C4. \uC820\uC7A5. \uB108\uBB34 \uC775\uC219\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435462
    m_Localized: "\uB450\uB8E8\uB9C8\uB9AC\uB294 \uD68C\uC0C1 \uACB0\uC0AC \uC591\uC2DD\uC774\uB124.
      \uC774\uB984\uC744 \uC9C0\uC6B0\uAE30 \uC804 \uC591\uC2DD."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435463
    m_Localized: "\uAC70\uC6B8\uC740 \uADF8\uBB3C \uACB0\uC0AC\uC758 \uC2DC\uC870
      \uBB3C\uAC74\uC774\uB2E4. \uB2EB\uC740 \uC790\uAC00 \uC6B0\uB9AC\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435464
    m_Localized: "\uAE30\uB85D\uD569\uB2C8\uB2E4. \uB124 \uAC08\uB798 \uBAA8\uB450
      \uC5EC\uAE30 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uD55C \uC8C4\uB85C \uC811\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435465
    m_Localized: "\uADF8\uB7FC \uCCAB \uC904\uC740 \uC5EC\uAE30\uC11C \uC2DC\uC791\uD574\uC57C
      \uD569\uB2C8\uB2E4. \uC0AC\uC81C\uC758 \uC778\uC7A5\uB3C4, \uBD80\uC871\uC758
      \uCE7C\uB3C4, \uB450\uB8E8\uB9C8\uB9AC\uB3C4, \uAC70\uC6B8\uB3C4 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435466
    m_Localized: "\uB3C4\uC2DC \uC911\uC559 \uAD11\uC7A5\uC5D0 \uBC31\uADDC\uAC00
      \uC11C \uC788\uC5C8\uB2E4. \uADF8\uC758 \uC606\uC5D0\uB294 \uC0AC\uC81C\uB2E8
      \uAE30\uB85D\uD568\uC774 \uC5F4\uB824 \uC788\uC5C8\uACE0, \uC120\uC601\uC740
      \uADF8 \uC55E\uC5D0 \uBB34\uB98E\uC744 \uAFC7\uACE0 \uC788\uC5C8\uB2E4. \uAE30\uB85D\uD568\uC758
      \uCE78\uB9C8\uB2E4 \uC774\uBBF8 \uC791\uC740 \uD45C\uC9C0\uAC00 \uAF42\uD600
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435467
    m_Localized: "\uC624\uC168\uC2B5\uB2C8\uAE4C. \uB124 \uBD84\uC758 \uC99D\uC5B8\uB780\uC774
      \uBE44\uC5B4 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uC218\uACE0\uB97C \uB35C\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435468
    m_Localized: "\uD559\uC790\uC7A5. \uC774 \uAE30\uB85D\uC744 \uC5B4\uB5BB\uAC8C
      \uB2E4\uB8F0 \uC0DD\uAC01\uC774\uC2ED\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435469
    m_Localized: "\uC6D0\uBB38\uC740 \uBD09\uC778\uD558\uACE0, \uC694\uC57D\uBCF8\uB9CC
      \uC62C\uB9BD\uB2C8\uB2E4. \uB300\uC131\uB2F9\uACFC \uBCC0\uBC29\uC774 \uAC10\uB2F9\uD560
      \uC218 \uC788\uB294 \uC190\uC0C1\uBD80\uD130 \uACC4\uC0B0\uD574\uC57C \uD569\uB2C8\uB2E4.
      \uC774\uB984\uC740 \uC6D0\uBB38\uC5D0 \uB0A8\uAE30\uACE0, \uBCF4\uACE0\uC11C\uC5D0\uB294
      \uD53C\uD574 \uADDC\uBAA8\uB9CC \uC62C\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435470
    m_Localized: "\uC190\uC0C1? \uC0AC\uB78C\uC774 \uC8FD\uC740 \uAC78 \uADF8\uB807\uAC8C
      \uBD88\uB7EC?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435471
    m_Localized: "\uC8FD\uC74C\uC774\uB77C\uACE0 \uBD80\uB974\uBA74 \uAC01 \uC9C4\uC601\uC740
      \uBA3C\uC800 \uCE7C\uC744 \uCC3E\uC2B5\uB2C8\uB2E4. \uC190\uC0C1\uC774\uB77C\uACE0
      \uBD80\uB974\uBA74 \uD68C\uC758\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4. \uB9D0\uC758
      \uC21C\uC11C\uAC00 \uD53C\uD574\uB97C \uC904\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435472
    m_Localized: "\uC0AC\uB78C \uC8FD\uC740 \uAC78 \uC11C\uB958 \uC811\uB294 \uBC95\uC73C\uB85C
      \uB9D0\uD558\uBA74 \uAE30\uC5B5\uAD00\uB4E4\uC774 \uC544\uC8FC \uC2EB\uC5B4\uD55C\uB2E4\uB124.
      \uAC1C\uC778 \uACBD\uD5D8\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435473
    m_Localized: "\uAE30\uC5B5\uAD00\uB2D8. \uC624\uB798 \uBCF4\uC874\uD55C \uAE30\uC5B5\uC77C\uC218\uB85D
      \uACF5\uAC1C \uC2DC\uC810\uC744 \uC815\uD574\uC57C \uD569\uB2C8\uB2E4. \uBCF4\uC874\uC740
      \uC18C\uC720\uC640 \uB2E4\uB974\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435474
    m_Localized: "\uB2E4\uB974\uB2E4. \uBCF4\uC874\uC740 \uC9C0\uD0A4\uB294 \uC190\uC774\uACE0,
      \uC18C\uC720\uB294 \uB2EB\uB294 \uC190\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435475
    m_Localized: "\uC678\uBD80 \uC99D\uC5B8\uC790\uAED8\uC11C\uB294 \uC190\uC744
      \uBE44\uC6B0\uC168\uC9C0\uC694. \uBE44\uC6B4 \uC190\uC73C\uB85C\uB294 \uBCF4\uAD00
      \uAD8C\uD55C\uC744 \uC8FC\uC7A5\uD558\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435476
    m_Localized: "...\uBCF4\uAD00 \uAD8C\uD55C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435477
    m_Localized: "\uC120\uC601. \uC9C0\uAE08 \uB4E4\uC5C8\uC2B5\uB2C8\uAE4C. \uB2F9\uC2E0\uC774
      \uBCF4\uC874\uD558\uB824\uB358 \uB9D0\uC774 \uB204\uAD6C\uC758 \uCE78\uC5D0
      \uB4E4\uC5B4\uAC00\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435478
    m_Localized: "...\uADF8\uBD84\uC758..."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435479
    m_Localized: "\uC0AC\uC81C \uB2E8\uB9B0. \uADC0\uD658 \uBA85\uB839\uC11C\uB97C
      \uC791\uC131\uD574 \uB450\uC5C8\uC2B5\uB2C8\uB2E4. \uC11C\uBA85\uB9CC \uB0A8\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435480
    m_Localized: "\uC800\uB294 \uC624\uB298 \uC0AC\uC81C \uC778\uC7A5\uC744 \uB0B4\uB824\uB193\uC558\uC2B5\uB2C8\uB2E4.
      \uADF8\uB798\uC11C \uC774 \uBC29\uC744 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435481
    m_Localized: "\uC774\uB9AC\uC194 \uB300\uD45C. \uBB34\uB9AC \uBD84\uC5F4 \uC608\uC0C1\uCE58\uAC00
      \uAC00\uC7A5 \uB192\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC758 \uCE68\uBB35\uC774
      \uB354 \uB9CE\uC740 \uC0DD\uC874\uC744 \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435482
    m_Localized: "\uB0C4\uC0C8\uB97C \uC9C0\uC6B4 \uACE0\uAE30\uB294 \uBB34\uB9AC\uD55C\uD14C
      \uBA39\uC774\uC9C0 \uC54A\uC544. \uADF8\uAC8C \uC6B0\uB9AC \uBC95\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435483
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC \uB300\uD45C. \uC6D0\uBB38 \uACF5\uAC1C\uB294
      \uC0AC\uB9DD\uC790\uC758 \uB450 \uBC88\uC9F8 \uC720\uD1B5\uC785\uB2C8\uB2E4.
      \uC81C \uBCF4\uAD00\uC548\uC774 \uB354 \uC815\uC911\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435484
    m_Localized: "\uACE0\uB9D9\uC9C0\uB9CC \uC0AC\uC591\uD558\uACA0\uB124. \uB0B4
      \uAE30\uC5B5\uC740 \uB0A8\uC758 \uC7A5\uC2DD\uC7A5\uC5D0 \uB4E4\uC5B4\uAC00\uBA74
      \uACF0\uD321\uC774\uAC00 \uD3B4\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435485
    m_Localized: "\uADF8\uBB3C \uACB0\uC0AC \uC678\uBD80 \uC99D\uC5B8\uC790. \uAD8C\uD55C
      \uC5C6\uB294 \uC99D\uC5B8\uC740 \uC8FC\uC11D\uC73C\uB85C \uB0A8\uC2B5\uB2C8\uB2E4.
      \uBCF8\uBB38\uC740 \uAD8C\uD55C\uC790\uAC00 \uC501\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435486
    m_Localized: "\uB300\uD45C\uD558\uC9C0 \uC54A\uB294\uB2E4. \uC99D\uC5B8\uD55C\uB2E4.
      \uC783\uC740 \uC774\uB984\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435487
    m_Localized: "\uAE30\uB85D. \uB124 \uAC70\uC808 \uBAA8\uB450 \uD6A8\uB825 \uC788\uC74C.
      \uB3D9\uC77C \uBB38\uC7A5\uC73C\uB85C \uBCD1\uD569\uD558\uC9C0 \uC54A\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435488
    m_Localized: "\uBC31\uADDC\uC758 \uC758\uC2DD \uAC80\uC774 \uBC14\uB2E5\uC5D0
      \uB5A8\uC5B4\uC84C\uB2E4. \uD559\uC790\uC7A5 \uC778\uC7A5\uC774 \uC190\uB05D\uC5D0\uC11C
      \uD55C \uBC88, \uC9E7\uAC8C \uD754\uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435489
    m_Localized: "...\uC790\uACA9\uC744 \uC783\uC740 \uC790\uAC00 \uD559\uC124\uC758
      \uB4A4\uB97C \uC787\uB294 \uAC83\uC740, \uD559\uBB38\uC758 \uACA9\uC5D0 \uB9DE\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435490
    m_Localized: "\uB2E8\uD604 \uD559\uC790\uC7A5\uC758 \uC77C\uC9C0 \uB9C8\uC9C0\uB9C9
      \uBD80\uBD84\uC744 \uC77D\uC73C\uC168\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435491
    m_Localized: "...\uC77D\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435492
    m_Localized: "\"\uC774 \uD559\uC124\uC744 \uC5B4\uB5BB\uAC8C \uC0AC\uC6A9\uD560\uC9C0\uB97C
      \uB2E4\uC2DC \uC0DD\uAC01\uD558\uB77C.\" \uC800\uB294 \uADF8 \uBB38\uC7A5\uC744
      \uC678\uC6E0\uC2B5\uB2C8\uB2E4. \uC544\uB2C8\uC694. \uC678\uC6B0\uAE30\uB9CC
      \uD588\uC2B5\uB2C8\uB2E4. \uC624\uB298 \uCC98\uC74C\uC73C\uB85C \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435493
    m_Localized: "\uD559\uC790\uC758 \uC0AC\uD6C4 \uBD80\uD0C1\uC740 \uD6C4\uACC4\uAC00
      \uB2E4\uC2DC \uD574\uC11D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435494
    m_Localized: "\uADF8\uB7F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uB2E8\uD604
      \uD559\uC790\uC7A5 \uBCF8\uC778\uC740 \uADF8 \uD574\uC11D\uC744 \uB0A8\uAE30\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uADF8 \uCE68\uBB35\uC758 \uBB34\uAC8C\uB97C
      \uD559\uC790\uC7A5\uAED8\uC11C\uB294 \uC5BC\uB9C8\uB098 \uB4E4\uACE0 \uACC4\uC168\uC2B5\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435495
    m_Localized: "\uBC31\uADDC\uC758 \uC190\uC774 \uC778\uC7A5\uC5D0 \uB2FF\uC558\uB2E4.
      \uC774\uBC88\uC5D0\uB294 \uB9CC\uC9C0\uC791\uAC70\uB9AC\uC9C0 \uC54A\uC558\uB2E4.
      \uADF8\uB294 \uC778\uC7A5\uC744 \uD480\uC5B4 \uBC14\uB2E5\uC5D0 \uB0B4\uB824\uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435496
    m_Localized: "...\uC800\uB294 \uADF8 \uCE68\uBB35\uAE4C\uC9C0 \uC81C \uB17C\uBB38\uC5D0
      \uB123\uC73C\uB824 \uD588\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435497
    m_Localized: "...\uADF8\uBD84\uC758 \uC74C\uC131\uC774... \uB4E4\uB9AC\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435498
    m_Localized: "\uC774\uC81C\uC57C \uC870\uC6A9\uD558\uAD70. \uBB34\uC11C\uC6B4
      \uC870\uC6A9\uD568\uC774\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435499
    m_Localized: "\uAE30\uB85D\uD569\uB2C8\uB2E4. \uD559\uC790\uC7A5 \uC778\uC7A5,
      \uB0B4\uB824\uB193\uC74C. \uBCF4\uACE0 \uAD8C\uD55C, \uBA48\uCDA4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435500
    m_Localized: "\uBA85\uC74C\uC774 \uAC70\uC6B8 \uC55E\uC5D0 \uBE48 \uC885\uC774
      \uC138 \uC7A5\uC744 \uB098\uB780\uD788 \uB193\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435501
    m_Localized: "\uC804\uBD80 \uC5EC\uB294 \uC885\uC774. \uB2E4\uC2DC \uB2EB\uB294
      \uC885\uC774. \uCCAB \uC904\uB9CC \uB4E4\uACE0 \uB098\uAC00\uB294 \uC885\uC774.
      \uC138 \uC7A5 \uC911 \uD558\uB098\uC5D0 \uC190\uC744 \uC5B9\uC73C\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435502
    m_Localized: "\uB2E4 \uC5EC\uB294 \uC885\uC774\uB294 \uBABB \uC368. \uBB34\uB9AC\uAC00
      \uCC22\uACA8. \uB2E4 \uB2EB\uB294 \uC885\uC774\uB3C4 \uBABB \uC368. \uADF8\uB7FC
      \uD68C\uC870 \uB9D0\uC774 \uB9DE\uC558\uB2E4\uB294 \uAC8C \uB418\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179967435503
    m_Localized: "\uB2E4 \uB2EB\uC73C\uBA74 \uD751\uC9C0 \uB450\uB8E8\uB9C8\uB9AC\uB9CC
      \uB450\uAEBC\uC6CC\uC9C0\uC9C0. \uB2E4 \uC5F4\uBA74 \uC774\uB984\uBD80\uD130
      \uD314\uB9B4 \uAC70\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629056
    m_Localized: "\uACB0\uC0AC\uB294 \uB2EB\uB294 \uBC95\uB9CC \uBC30\uC6E0\uB2E4.
      \uCC98\uC74C \uC5EC\uB294 \uBB38\uC744 \uD55C \uBC88\uC5D0 \uD06C\uAC8C \uC5F4\uBA74,
      \uBB38\uC774 \uC544\uB2C8\uB77C \uBCBD\uC774 \uBB34\uB108\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629057
    m_Localized: "\uBB38\uC740 \uD55C \uBC88\uC5D0 \uC5F4\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uBA3C\uC800, \uC774\uB984\uC744 \uC9C0\uC6B0\uC9C0 \uC54A\uB294 \uCCAB \uC904\uBD80\uD130
      \uACE0\uB985\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629058
    m_Localized: "\uB0B4\uC77C \uC544\uCE68 \uD68C\uC870 \uC55E\uC5D0\uC11C \uC77D\uC5B4\uB3C4
      \uBB34\uB9AC\uAC00 \uC11C\uB85C \uBB3C\uC9C0 \uC54A\uC744 \uB9CC\uD07C. \uB0B4\uAC00
      \uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uC744 \uB9CC\uD07C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629059
    m_Localized: "\uD751\uC9C0 \uC55E\uC5D0\uC11C\uB3C4 \uC228\uC9C0 \uC54A\uC744
      \uB9CC\uD07C. \uADF8 \uC0AC\uB78C\uC774 \uB0B4 \uC774\uB984\uC744 \uC9DA\uC5B4\uB3C4
      \uB0B4\uAC00 \uB18D\uB2F4\uC73C\uB85C \uD53C\uD558\uC9C0 \uC54A\uC744 \uB9CC\uD07C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629060
    m_Localized: "\uC6D0\uBB38\uC740 \uACB0\uC0AC\uAC00 \uC9C0\uD0A8\uB2E4. \uADF8\uB7EC\uB098
      \uB0B4\uAC00 \uB2EB\uC558\uB358 \uBB38\uC744 \uD551\uACC4\uB85C \uB2E4\uC2DC
      \uB2EB\uC9C0\uB294 \uC54A\uB294\uB2E4. \uADF8\uAC8C \uB0B4\uAC00 \uC783\uC740
      \uC774\uB984\uC758 \uAC12\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629061
    m_Localized: "\uBC16\uC5D0\uB294 \uBA3C\uC800 \uC774 \uD55C \uC904\uB9CC \uB0B4\uBCF4\uB0C5\uC2DC\uB2E4.
      \u2014 \uCCAB \uB3C4\uC2DC\uB294 \uC788\uC5C8\uB2E4. \uC6B0\uB9AC\uB294 \uB2E4\uC2DC
      \uC0AC\uB78C\uC744 \uBC88\uD638\uB85C \uBD80\uB974\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629062
    m_Localized: "\uC6D0\uBB38\uC740 \uB0A8\uAE41\uB2C8\uB2E4. \uC624\uB298 \uB4E4\uACE0
      \uB098\uAC08 \uAC83\uC740 \uAC19\uC740 \uCCAB \uC904\uBFD0\uC785\uB2C8\uB2E4.
      \uB098\uBA38\uC9C0\uB294 \uC774\uB984\uC744 \uC9C0\uC6B0\uC9C0 \uC54A\uB294
      \uC190\uC774 \uC0DD\uAE38 \uB54C\uB9C8\uB2E4, \uC870\uAE08\uC529 \uC5FD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629063
    m_Localized: "\uB124 \uC0AC\uB78C\uC774 \uC885\uC774 \uC704\uC5D0 \uC190\uC744
      \uC5B9\uC5C8\uB2E4. \uC0AC\uC81C\uC758 \uC190, \uC0AC\uB0E5\uAFBC\uC758 \uC190,
      \uAE30\uC5B5\uAD00\uC758 \uC190, \uC774\uB984\uC744 \uC783\uC740 \uC190. 1800\uB144
      \uB3D9\uC548 \uC11C\uB85C\uB97C \uD5A5\uD574 \uCE7C\uC744 \uB4E4\uB358 \uB124
      \uAC08\uB798\uAC00, \uCC98\uC74C\uC73C\uB85C \uAC19\uC740 \uC885\uC774 \uC704\uC5D0
      \uB098\uB780\uD788 \uB193\uC600\uB2E4. \uD558\uB098\uB85C \uD3EC\uAC1C\uC9C0\uC9C0\uB294
      \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629064
    m_Localized: "\uBA85\uC74C\uC774 \uCCAB \uBC88\uC9F8 \uC885\uC774\uC5D0 \uC791\uC740
      \uAC70\uC6B8 \uBB38\uC591\uC744 \uCC0D\uC5C8\uB2E4. \uBE48 \uC758\uC790 \uB458\uC758
      \uC790\uB9AC\uB294 \uADF8\uB300\uB85C \uB0A8\uACA8 \uB450\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629065
    m_Localized: "\uCCAB \uC904\uC740 \uB098\uAC11\uB2C8\uB2E4. \uC6D0\uBB38\uC740
      \uB0A8\uAE41\uB2C8\uB2E4. \uBE44\uC5B4 \uC788\uB294 \uC790\uB9AC\uB294 \uAC74\uB4DC\uB9AC\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629066
    m_Localized: "\uBA85\uC74C\uC774 \uBD80\uBCF8 \uD558\uB098\uB97C \uB2E8\uB9B0
      \uC55E\uC5D0, \uD558\uB098\uB97C \uACF5\uD55C \uC55E\uC5D0 \uBC00\uC5B4 \uB454\uB2E4.
      \uC138 \uBC88\uC9F8 \uC885\uC774\uB294 \uC811\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629067
    m_Localized: "\uBCF8 \uB300\uC131\uB2F9\uC73C\uB85C \uD558\uB098. \uBB38\uBC16
      \uC99D\uC5B8\uC73C\uB85C \uD558\uB098. \uB2E4\uB978 \uBCC0\uBC29\uC758 \uB4F1\uBD88\uC740
      \uC624\uB298\uC740 \uBE44\uC6CC \uB461\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629068
    m_Localized: "\uD68C\uC870 \uCABD \uC758\uC790\uB3C4 \uBE44\uC6CC \uB46C. \uC5B8\uC820\uAC00
      \uC549\uD790 \uAC70\uC57C. \uC5B5\uC9C0\uB85C\uB294 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629069
    m_Localized: "\uC774 \uC78E\uC740 \uB0B4 \uAE30\uC5B5 \uD55C \uC7A5\uC774\uC57C.
      \uD751\uC9C0 \uBA85\uB2E8\uC5D0 \uB07C\uC6CC \uB450\uB358 \uAC70. \uB4E4\uACE0
      \uAC00. \uBCF8 \uB300\uC131\uB2F9 \uB9D0\uC5D0 \uB9C9\uD788\uAC70\uB4E0, \uC190\uBC14\uB2E5\uC5D0
      \uD3B4 \uBD10. \uC0B0 \uC0AC\uB78C \uB9D0\uC774 \uBA3C\uC800 \uB098\uC62C \uD14C\uB2C8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629070
    m_Localized: "...\uBB34\uAC81\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629071
    m_Localized: "\uC774 \uC778\uC7A5\uC740 \uC81C\uAC00 \uB2E4\uC2DC \uBC1B\uC744
      \uB54C\uAE4C\uC9C0 \uC81C \uAC83\uC774 \uC544\uB2D9\uB2C8\uB2E4. \uB2E4\uC2DC
      \uBC1B\uC744 \uC218 \uC5C6\uC744\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629072
    m_Localized: "\uB0B4 \uD1A0\uD15C\uB3C4 \uBC18\uCABD\uC9DC\uB9AC\uC57C. \uADF8\uB798\uB3C4
      \uB4E4\uACE0 \uB2E4\uB140. \uBC18\uCABD\uC778 \uAC78 \uBCF4\uC5EC \uC8FC\uB824\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629073
    m_Localized: "\uB2E4\uB4E4 \uC7A5\uC2E0\uAD6C \uAD00\uB9AC\uAC00 \uC5C9\uB9DD\uC774\uAD70.
      \uB0B4 \uB450\uB8E8\uB9C8\uB9AC\uB294 \uB0A8\uC758 \uC774\uB984\uAE4C\uC9C0
      \uB4E4\uC5B4\uC640\uC11C \uBB34\uAC70\uC6CC\uC84C\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629074
    m_Localized: "\uB098\uB294 \uC774\uB984\uC744 \uD558\uB098 \uC783\uC5C8\uB2E4.
      \uADF8\uB7F0\uB370 \uC190\uC774 \uBE44\uC5C8\uB2E4. \uC774\uC0C1\uD558\uAC8C
      \uAC00\uBCCD\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629075
    m_Localized: "\uBE48 \uC190\uC73C\uB85C \uBB34\uC5C7\uC744 \uD558\uC2E4 \uAC81\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629076
    m_Localized: "\uC7A1\uC744 \uAC83\uC774\uB2E4. \uC548\uC5D0\uC11C \uB098\uC624\uB824\uB294
      \uC0AC\uB78C\uC744. \uBC16\uC5D0\uC11C \uB4E4\uC5B4\uC624\uB824\uB294 \uC0AC\uB78C\uC744.
      \uB458 \uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629077
    m_Localized: "\uB124 \uB18D\uB2F4\uC774 \uC624\uB298 \uC81C\uC77C \uB2A6\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629078
    m_Localized: "\uADF8\uB7FC \uC544\uC9C1 \uC0B4\uC544 \uC788\uB124. \uC8FD\uC740
      \uC0AC\uB78C\uC740 \uD0C0\uC774\uBC0D\uC774 \uB354 \uB098\uC058\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629079
    m_Localized: "\uC7BF\uACE8\uC758 \uD0C1\uC790\uC5D0\uB294 \uC0C8 \uD760\uC9D1\uC774
      \uC0DD\uACBC\uB2E4. \uB124 \uAC08\uB798 \uBB38\uC591\uC774 \uC544\uB2C8\uB77C,
      \uB124 \uC0AC\uB78C\uC774 \uAC01\uC790 \uC190\uC73C\uB85C \uADF8\uC740 \uB2E4\uB978
      \uC120\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629080
    m_Localized: "\uD68C\uC870 \uCABD\uC740 \uC544\uC9C1 \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.
      \uBCF8 \uB300\uC131\uB2F9 \uCABD\uB3C4 \uC815\uC2DD \uB300\uD45C\uAC00 \uC544\uB2D9\uB2C8\uB2E4.
      \uD68C\uB2F4\uC774\uB77C\uACE0 \uBD80\uB974\uAE30\uC5D4 \uD5C8\uC220\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629081
    m_Localized: "\uD5C8\uC220\uD558\uBA74 \uC624\uB798\uAC00. \uB108\uBB34 \uB2E8\uB2E8\uD55C
      \uAC74 \uC798 \uBD80\uB7EC\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629082
    m_Localized: "\uBCF8 \uB300\uC131\uB2F9\uC5D0\uB294 \uC81C\uAC00 \uAC11\uB2C8\uB2E4.
      \uC0AC\uC81C\uB85C\uC11C\uAC00 \uC544\uB2C8\uB77C \uC99D\uC5B8\uC790\uB85C\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629083
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC\uC5D0\uB294 \uB0B4\uAC00 \uAC00\uC57C\uACA0\uC9C0.
      \uD751\uC9C0\uAC00 \uCC28\uB97C \uB0B4\uC8FC\uC9C4 \uC54A\uC744 \uD14C\uB2C8
      \uBB3C\uC740 \uCC59\uACA8 \uAC00\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629084
    m_Localized: "\uADF8\uBB3C \uACB0\uC0AC\uC5D0\uB294 \uB0B4\uAC00 \uAC00\uC9C0
      \uBABB\uD55C\uB2E4. \uB300\uC2E0 \uBB38 \uBC16\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629085
    m_Localized: "\uAE30\uB85D\uD569\uB2C8\uB2E4. \uBE48 \uC758\uC790 \uB458. \uBE44\uC6CC
      \uB454 \uB73B\uAE4C\uC9C0 \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629086
    m_Localized: "\uBE48 \uC758\uC790\uB294 \uADF8\uB300\uB85C \uB0A8\uC558\uB2E4.
      \uB204\uAD70\uAC00 \uC624\uC9C0 \uC54A\uC558\uAE30 \uB54C\uBB38\uC774 \uC544\uB2C8\uB77C,
      \uC5B8\uC820\uAC00 \uC62C \uC218 \uC788\uAC8C \uD558\uAE30 \uC704\uD574\uC11C\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629087
    m_Localized: "\uCCAB \uB3C4\uC2DC\uB294 \uB2E4\uC2DC \uB2EB\uD788\uC9C0 \uC54A\uC558\uB2E4.
      \uADF8\uB807\uB2E4\uACE0 \uC5F4\uB9B0 \uAC83\uB3C4 \uC544\uB2C8\uC5C8\uB2E4.
      \uBB38\uD2C8\uC5D0\uB294 \uB124 \uC0AC\uB78C\uC758 \uB9D0\uC774 \uB07C\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629088
    m_Localized: "\uAE30\uB85D\uC740 \uC0B0 \uC790\uAC00 \uC4F0\uC9C0\uB9CC, \uC57D\uC18D\uC740
      \uB124 \uAC08\uB798 \uBAA8\uB450 \uC4F4\uB2E4. \uB2E4\uC12F \uBC88\uC9F8 \uB9E4\uB4ED,
      \uC131\uB9BD."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629089
    m_Localized: "\uBCF8 \uB300\uC131\uB2F9\uC5D0\uB294 \uC778\uC7A5 \uC5C6\uB294
      \uC0AC\uC81C\uAC00 \uAC14\uB2E4. \uC774\uB9AC\uC194\uC5D0\uB294 \uBC18\uCABD
      \uD1A0\uD15C\uC758 \uC0AC\uB0E5\uAFBC\uC774 \uAC14\uB2E4. \uD68C\uC0C1 \uACB0\uC0AC\uC5D0\uB294
      \uC774\uB984\uC774 \uC801\uD78C \uAE30\uC5B5\uAD00\uC774 \uAC14\uB2E4. \uADF8\uBB3C
      \uACB0\uC0AC\uC758 \uBB38\uBC16\uC5D0\uB294 \uC774\uB984\uC744 \uC783\uC740
      \uAD00\uCE21\uC790\uAC00 \uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629090
    m_Localized: "...\uC800\uB3C4, \uBB3C\uC5B4\uB3C4 \uB429\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629091
    m_Localized: "\uB530\uB77C\uC624\uB824\uBA74 \uB2F5\uC744 \uB0B4\uB824\uB193\uACE0
      \uC624\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629092
    m_Localized: "\uBCC0\uBC29\uC758 \uC804\uC7C1\uC740 \uB05D\uB098\uC9C0 \uC54A\uC558\uB2E4.
      \uB2E4\uB9CC \uCC98\uC74C\uC73C\uB85C, \uC804\uC7C1\uC774 \uC544\uB2CC \uB9D0\uC774
      \uAC19\uC740 \uD0C1\uC790\uC5D0 \uB193\uC600\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629093
    m_Localized: "\uBA3C \uBCC0\uBC29\uC758 \uB4F1\uBD88\uC740 \uC544\uC9C1 \uAEBC\uC9C0\uC9C0
      \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629094
    m_Localized: "\uC55E\uC11C \uCCA0 \uD30C\uD3B8 \uC704\uC5D0 \uC549\uC544 \uC788\uB358
      \uAE4C\uB9C8\uADC0\uAC00 \uADF8\uB300\uB85C \uC549\uC544 \uC788\uB2E4. \uC7AC\uAC00
      \uB2E4\uC2DC \uBC14\uB78C\uC744 \uD0C0\uACE0 \uC628\uB2E4. \uBCC0\uBC29\uC758
      \uD750\uB9B0 \uC0C8\uBCBD. \uB3D9\uD589\uC774\uB77C \uBD80\uB974\uAE30\uC5D4
      \uC774\uB978 \uB450 \uC0AC\uB78C\uC774 \uAC19\uC740 \uBB38 \uC55E\uC5D0 \uC11C
      \uC788\uB2E4. \uB450 \uC790\uB8E8\uC758 \uD770 \uB048\uC5D0 \uC7BF\uACE8 \uD759\uC774
      \uB9D0\uB77C\uBD99\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629095
    m_Localized: "...\uC9D1\uC815\uAD00 \uD68C\uC758\uAC00 \uBA85\uB839\uC11C\uC5D0
      \uC548 \uC801\uC740 \uC790\uB9AC\uC5D0 \uC640 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629096
    m_Localized: "\uB108\uD76C\uAC00 \uC138\uC6B4 \uBB38\uC774\uC9C0. \uADF8\uB7F0\uB370
      \uC774\uBC88\uC5D4 \uC548\uC5D0\uC11C \uBC00\uC5B4\uB0C8\uC5B4. \uCF54\uB85C\uB3C4
      \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629097
    m_Localized: "\uB2E8\uB9B0\uC774 \uC0AC\uC81C\uBCF5 \uC790\uC218 \uB05D\uC744
      \uB530\uB77C \uB9CC\uC9C4\uB2E4. \uC5B4\uBA38\uB2C8\uAC00 \uB9C8\uC9C0\uB9C9\uC5D0
      \uC9DA\uC73C\uC168\uB358 \uC790\uB9AC. \uC790\uC218 \uB05D\uC5D0 \uC7AC\uAC00
      \uD55C \uC54C \uBB3B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629098
    m_Localized: "...\uC6B0\uB9AC\uAC00 \uC138\uC6B4 \uBB38\uC785\uB2C8\uB2E4. \uC6B0\uB9AC\uAC00
      \uB2EB\uACE0, \uC6B0\uB9AC\uAC00 \uBD80\uC248\uC2B5\uB2C8\uB2E4. \uC548\uC5D0\uC11C
      \uBC00\uC5B4\uB0B8 \uC790\uAC00 \uB204\uAD6C\uC778\uC9C0 \u2014 \uADF8\uAC8C
      \uBA85\uB839\uC11C\uC5D0 \uC5C6\uB294 \uC790\uB9AC\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629099
    m_Localized: "\uCC98\uC74C\uC73C\uB85C \uC0AC\uC81C\uAC00 \uC815\uD655\uD55C
      \uB9D0\uC744 \uD558\uB294\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629100
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uCF54\uB97C \uB4E0\uB2E4. \uB4E4\uD310\uC744
      \uD6D1\uB294\uB2E4. \uD615\uC81C \uB0C4\uC0C8\uAC00 \uC2DD\uC740 \uBD88\uC528\uCC98\uB7FC
      \uB0AE\uAC8C \uC548\uCABD\uC5D0\uC11C \uD758\uB7EC\uB098\uC628\uB2E4. \uC0AC\uB78C
      \uB0C4\uC0C8 \uB05D\uC5D0 \uB179\uC740 \uB3CC \uB0C4\uC0C8\uAC00 \uC605\uAC8C
      \uC11E\uC5EC \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629101
    m_Localized: "...\uC0AC\uB78C\uC774 \uC548\uC5D0 \uC788\uB2E4. \uADF8\uB7F0\uB370
      \uAC78\uC74C\uAC78\uC774\uAC00 \uC0AC\uB78C\uC758 \uAC83\uC774 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629102
    m_Localized: "\uB2E8\uB9B0\uC774 \uB2F5\uD558\uC9C0 \uC54A\uB294\uB2E4. \uBB35\uC8FC\uAC00
      \uC0AC\uC81C\uBCF5 \uC790\uC218 \uC548\uC8FC\uBA38\uB2C8\uC5D0\uC11C \uB9CC\uC838\uC9C4\uB2E4.
      \uCCAB \uC54C\uC774 \uC190\uAC00\uB77D \uB05D\uC5D0\uC11C \uBA48\uCD98\uB2E4.
      \uB450 \uBC1C\uC790\uAD6D\uC774 \uAC19\uC774 \uBCC0\uBC29\uBB38 \uC548\uC73C\uB85C
      \uB4E4\uC5B4\uC120\uB2E4. \uD770 \uB048 \uB450 \uC904\uC774 \uBB38\uD131\uC758
      \uC7AC\uB97C \uC2A4\uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629103
    m_Localized: "\uD68C\uC870\uAC00 \uBB34\uB9AC\uC640 \uD568\uAED8 \uC548\uAC1C
      \uC18D\uC73C\uB85C \uBB3C\uB7EC\uB09C \uB4A4, \uC774\uBE68\uBC14\uB78C\uC774
      \uC790\uAE30 \uC190\uBAA9\uC744 \uBCF8\uB2E4. \uD68C\uC870\uC640 \uAC19\uC740
      \uB0A0 \uAC19\uC740 \uCE7C\uB85C \uC0C8\uAE34 \uD53C\uC758 \uC11C\uC57D \uD749\uD130.
      \uAC70\uAFB8\uB85C \uBB36\uC778 \uBD84\uB9AC\uD30C \uB9E4\uB4ED \uB108\uBA38\uB85C\uB3C4,
      \uB450 \uC0AC\uB78C \uC190\uBAA9\uC758 \uADF8 \uC790\uAD6D\uB9CC\uC740 \uAC19\uC740
      \uC790\uB9AC\uC5D0 \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629104
    m_Localized: "\uC548\uAC1C\uAC00 \uD68C\uC870\uAC00 \uC0AC\uB77C\uC9C4 \uAE38
      \uC704\uB85C \uCC9C\uCC9C\uD788 \uB0B4\uB824\uC549\uB294\uB2E4. \uC774\uBE68\uBC14\uB78C\uC774
      \uD749\uD130 \uC704\uC5D0 \uC190\uC744 \uD55C \uBC88 \uC5B9\uB294\uB2E4. \uB2E8\uB9B0\uC774
      \uC790\uAE30 \uC190\uC744 \uBCF8\uB2E4. \uB5A8\uB9AC\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629105
    m_Localized: "...\uD68C\uC870 \uC528\uB294 \uC0B4\uC544 \uC788\uC2B5\uB2C8\uB2E4.
      \uAE38\uC774 \uAC08\uB838\uC744 \uBFD0\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629106
    m_Localized: "\uC0B4\uC544 \uC788\uB2E4\uB294 \uAC8C \uC704\uB85C\uAC00 \uB418\uB294
      \uC904 \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629107
    m_Localized: "\uB2E8\uB9B0\uC774 \uC0AC\uC81C\uBCF5 \uC790\uC218 \uC548\uC8FC\uBA38\uB2C8\uC5D0\uC11C
      \uBB35\uC8FC\uB97C \uAEBC\uB0B8\uB2E4. \uCCAB \uC54C\uC744 \uC190\uAC00\uB77D
      \uB05D\uC5D0 \uC7A1\uB294\uB2E4. \uC5B4\uBA38\uB2C8\uAC00 \uAC00\uB974\uCE58\uC2E0
      \uCCAB \uAD6C\uC808\uC774 \uB5A0\uC624\uB974\uC9C0 \uC54A\uB294\uB2E4. \uBCC0\uBC29\uBB38\uC5D0\uC11C
      \uACE0\uC9C4\uC774 \uC678\uC6B4 \u201C\uC815\uACB0\uC740 \uC9C8\uC11C\uC758
      \uCCAB \uAC78\uC74C\u201D\uC774 \uADF8 \uC790\uB9AC\uC5D0 \uBA38\uBB34\uB978\uB2E4
      \u2014 \uC5B4\uBA38\uB2C8\uC758 \u201C\uC815\uACB0\uC740 \uCD95\uBCF5\uC758
      \uCCAB \uAC78\uC74C\u201D\uC5D0\uC11C \uD55C \uB2E8\uC5B4\uAC00 \uBC14\uB010
      \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629108
    m_Localized: "\uCCAB \uC54C\uC5D0\uC11C \uBA48\uCD94\uC5B4\uC694. \uB298 \uAC70\uAE30\uC11C
      \uC2DC\uC791\uD588\uB294\uB370. \uC9C0\uAE08\uC740... \uADF8 \uB9D0\uC774 \uC81C
      \uB9D0\uC778\uC9C0, \uD559\uD30C\uC758 \uB9D0\uC778\uC9C0 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629109
    m_Localized: "\uADF8\uAC74 \uB108 \uD63C\uC790 \uD480\uC5B4. \uB098\uB294 \uD615\uC81C\uB97C
      \uB2E4\uC2DC \uBCF4\uB7EC \uAC00\uC57C \uD574. \uC624\uB298\uC740 \uC544\uB2C8\uC5B4\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629110
    m_Localized: "\uB450 \uC790\uB8E8\uC758 \uD770 \uB048\uC774 \uB450 \uC0AC\uB78C\uC758
      \uB4F1 \uB4A4\uC5D0\uC11C \uD754\uB4E4\uB9B0\uB2E4 \u2014 \uC7BF\uACE8\uC5D0\uC11C
      \uD55C\uC0C8\uAC00 \uAC74\uB124\uC900 \uC790\uB8E8. \uD55C \uC0AC\uB78C\uC740
      \uC774\uB984\uC744 \uC783\uC740 \uB178\uBCD1\uC744, \uD55C \uC0AC\uB78C\uC740
      \uAE38\uC774 \uAC08\uB9B0 \uD615\uC81C\uB97C \uB4F1 \uB4A4\uC5D0 \uB450\uACE0
      \uAC19\uC740 \uBB38\uC744 \uB098\uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629111
    m_Localized: "...\uADF8\uB798\uB3C4 \uAC19\uC774 \uAC78\uC5B4. \uB2E4\uC74C \uC790\uB9AC\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629112
    m_Localized: "\uD1A0\uD15C\uC774 \uBA40\uB9AC\uC11C \uD55C \uBC88 \uC6B4\uB2E4.
      \uBB34\uB9AC\uAC00 \uC774\uBE68\uBC14\uB78C\uC744 \uBD80\uB974\uACE0 \uC788\uB2E4.
      \uADF8\uB7EC\uB098 \uADF8\uAC00 \uBA3C\uC800 \uC77C\uC5B4\uC120\uB2E4. \uB2E8\uB9B0\uB3C4
      \uBB35\uC8FC\uB97C \uC790\uC218 \uC548\uC8FC\uBA38\uB2C8\uC5D0 \uB2E4\uC2DC
      \uB123\uACE0 \uC77C\uC5B4\uC120\uB2E4. \uB450 \uBC1C\uC790\uAD6D\uC774 \uC7BF\uACE8
      \uCABD\uC73C\uB85C \uD5A5\uD55C\uB2E4. \uC548\uAC1C\uAC00 \uB450 \uC0AC\uB78C\uC758
      \uB4F1 \uB4A4\uC5D0 \uB0B4\uB824\uC549\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629123
    m_Localized: "\uC0C8\uBCBD \uC548\uAC1C\uAC00 \uD574\uC548\uC120 \uC704\uB85C
      \uD55C \uC904 \uAE38\uAC8C \uD750\uB978\uB2E4. \uCE68\uBAB0\uD55C \uC194\uB77C\uB8F8
      \uBCF4\uB8E8\uC758 \uB300\uB9AC\uC11D \uAE30\uB465\uC774 \uBB3C \uC548\uC5D0\uC11C
      \uBE44\uC2A4\uB4EC\uD788 \uAE30\uC6B8\uC5B4\uC838 \uC788\uB2E4. \uBCF4\uB8E8
      \uC704\uC758 \uCCA8\uD0D1\uC740 \uBC18\uCBE4 \uC798\uB824 \uB098\uAC14\uACE0,
      \uADF8 \uC790\uB9AC\uC5D0 \uAE4C\uB9C8\uADC0 \uD55C \uB9C8\uB9AC\uAC00 \uC549\uC544
      \uC788\uB2E4 \u2014 \uC7AC\uC758 \uBB38 \uCCA0 \uD30C\uD3B8\uC5D0\uC11C \uBCF4\uC558\uB358
      \uAE4C\uB9C8\uADC0\uC640 \uAC19\uC740 \uC0C9\uC758 \uAE43."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629124
    m_Localized: "\uB2E8\uB9B0\uC774 \uBCF4\uB8E8 \uBCBD\uC5D0 \uC190\uC744 \uB304\uB2E4.
      \uC7AC\uC758 \uBB38\uC5D0\uC11C \uACE0\uC9C4\uC774 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uC678\uC6B4 \u201C\uC815\uACB0\uC740 \uC9C8\uC11C\uC758 \uCCAB \uAC78\uC74C\u201D\uC774,
      \uC774 \uBCBD \uC5B4\uB518\uAC00\uC5D0 \uAC19\uC740 \uAE00\uB85C \uC0C8\uACA8\uC838
      \uC788\uC744 \uAC83 \uAC19\uC740 \uC608\uAC10\uC774 \uADF8\uB140\uC758 \uC190\uB05D\uC5D0
      \uBA3C\uC800 \uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629125
    m_Localized: "...\uB2E8\uB9B0, \uC774 \uBCF4\uB8E8\uC57C. \uCF54\uB85C \uC7A1\uC558\uC5B4.
      \uACE0\uC9C4\uC758 \uC5B4\uC870\uAC00 \uC5EC\uAE30\uC11C \uB098\uC654\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629126
    m_Localized: "...\uACE0\uC9C4\uC758 \uC785\uC5D0\uC11C \uD758\uB7EC\uB098\uC628
      \uADF8 \uBB38\uC7A5\uC774, \uC774 \uBCF4\uB8E8 \uBCBD \uC548\uCABD\uC5D0\uC11C
      \uD55C \uBC88 \uB354 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629127
    m_Localized: "\uB2E8\uB9B0\uC774 \uC790\uAE30 \uC190\uC744 \uD55C \uBC88 \uBCF8\uB2E4.
      \uB5A8\uB9AC\uC9C0 \uC54A\uB294\uB2E4. \uC774\uBE68\uBC14\uB78C\uC758 \uC190\uC740
      \uD615\uC81C\uB97C \uB450\uACE0 \uC628 \uC790\uB9AC\uC5D0\uC11C \uC7A0\uAE50
      \uB5A8\uB9B0\uB2E4. \uB450 \uC0AC\uB78C\uC740 \uC11C\uB85C \uB2E4\uB978 \uBB34\uAC8C\uB97C
      \uC548\uACE0 \uAC19\uC740 \uBCF4\uB8E8 \uC55E\uC5D0 \uC120\uB2E4 \u2014 \uC7AC\uC758
      \uBB38 \uC55E\uC5D0 \uC130\uB358 \uB450 \uC0AC\uB78C\uC774 \uAC19\uC740 \uC0C8\uBCBD\uC5D0
      \uB2E4\uC2DC \uAC19\uC774 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629128
    m_Localized: "\uC548\uAC1C \uC0AC\uC774\uB85C \uBCF4\uB8E8 \uC785\uAD6C\uAC00
      \uBCF4\uC778\uB2E4. \uBB3C\uC5D0 \uC7A0\uAE34 \uACC4\uB2E8. \uC194\uB77C\uB8F8
      \uC778\uC7A5\uC774 \uC0C8\uACA8\uC9C4 \uBB38\uD131. \uADF8 \uC548\uCABD\uC5D0\uC11C
      \uD770 \uBC00\uB78D \uBD09\uC778\uC774 \uC0C8\uBCBD \uBE5B\uC5D0 \uD55C \uBC88
      \uBE5B\uB09C\uB2E4 \u2014 \uCD5C\uADFC\uC5D0 \uCC0D\uD78C \uB2E8\uD604 \uD559\uD30C\uC758
      \uBD09\uC778."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629129
    m_Localized: "...\uC5B4\uBA38\uB2C8\uAC00 \uAC00\uB974\uCCD0 \uC8FC\uC2E0 \uAE30\uB3C4\uB9D0\uC774
      \uC5B4\uB514\uC11C \uC2DC\uC791\uB410\uB294\uC9C0, \uC774 \uC548\uC5D0\uC11C
      \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uB450\uB835\uC9C0\uB9CC \uD53C\uD558\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629130
    m_Localized: "\uB450 \uC0AC\uB78C\uC758 \uBC1C\uC790\uAD6D\uC774 \uAC19\uC740
      \uBC15\uC790\uB85C \uBCF4\uB8E8 \uC785\uAD6C\uB97C \uD5A5\uD55C\uB2E4. \uAE4C\uB9C8\uADC0\uAC00
      \uD55C \uBC88 \uB354 \uBC1C\uC744 \uC62E\uAE34\uB2E4. \uC0C8\uBCBD \uC548\uAC1C\uAC00
      \uB450 \uC0AC\uB78C\uC758 \uB4F1 \uB4A4\uC5D0 \uB0B4\uB824\uC549\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629131
    m_Localized: "\uC2ED\uC77C\uC870 \uB3C4\uB85C\uC758 \uB05D. \uCC98\uD615\uB300\uC758
      \uADF8\uB9BC\uC790\uAC00 \uBB3C \uC704\uC5D0 \uD55C \uC904 \uAE38\uAC8C \uB298\uC5B4\uC9C4\uB2E4.
      \uB2E8\uB9B0\uC774 \uB2E8\uD604 \uC77C\uC9C0 \uC0AC\uBCF8\uC744 \uD488\uC5D0
      \uC548\uACE0 \uC788\uB2E4. \uC77C\uC9C0\uC758 \uD45C\uC9C0 \uC548\uCABD\uC5D0
      \uC911\uC559 \uBB38\uC11C\uACE0 \uC591\uC2DD\uC758 \uC0AC\uBCF8 \uBC88\uD638\uAC00
      \uB20C\uB824 \uC788\uB2E4 \u2014 \uC774 \uCC45\uC740 \uC5EC\uAE30\uB9CC \uB0A8\uC740
      \uAE30\uB85D\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629132
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC758 \uC190\uC5D0\uB294 \uC138 \uAC00\uC9C0
      \uBB3C\uAC74\uC774 \uB4E4\uB824 \uC788\uB2E4. \uC14B\uC9F8 \uB204\uC774\uC758
      \uD1A0\uD15C \uC870\uAC01. \uD070 \uD615\uC758 \uC0AC\uB0E5\uCE7C. \uB458\uC9F8
      \uB9C9\uB0B4\uC758 \uAC00\uC8FD\uB048. \uAE38\uACE0 \uC791\uACE0 \uB2F3\uC740
      \uC138 \uAC00\uC9C0\uAC00 \uD55C \uC190\uC5D0 \uBAA8\uC5EC \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629133
    m_Localized: "...\uC140 \uC218 \uC5C6\uB294 \uC790\uB4E4\uC758 \uC774\uB984.
      \uD55C \uBA85\uC529 \uB4E4\uC744\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629134
    m_Localized: "\uCC98\uD615\uB300 \uB4A4\uCABD \uBA85\uBD80\uC758 \uC789\uD06C\uAC00
      \uBB3C\uC5D0 \uBC88\uC9C4\uB2E4. \uC774\uB984\uC774 \uBC88\uD638\uB85C \uBCC0\uD558\uB358
      \uC790\uB9AC. \uB2E8\uB9B0\uC774 \uADF8 \uBC88\uD638 \uC606\uC5D0 \uC190\uAC00\uB77D\uC744
      \uD55C \uBC88 \uB304\uB2E4. \uB2E8\uD604 \uC77C\uC9C0\uC758 \uC0AC\uBCF8 \uBC88\uD638\uC640
      \uAC19\uC740 \uC591\uC2DD. \uB450 \uC591\uC2DD\uC774 \uAC19\uC740 \uC790\uB9AC\uC5D0\uC11C
      \uB9CC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629135
    m_Localized: "\uB0B4 \uBB34\uB9AC\uC5D0\uC11C\uB9CC \u2014 \uC14B\uC9F8 \uB204\uC774.
      \uD070 \uD615. \uB458\uC9F8 \uB9C9\uB0B4. \uB2E4 \uADF8 80\uB144\uC5D0 \uC8FD\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629136
    m_Localized: "\uB2E8\uB9B0\uC774 \uB530\uB77C \uB9D0\uD558\uC9C0 \uC54A\uB294\uB2E4.
      \uC785\uC18D\uC73C\uB85C \uC138 \uBC88 \uAD74\uB9B0\uB2E4. \uBB35\uC8FC\uB97C
      \uAEBC\uB0B4\uC9C0 \uC54A\uB294\uB2E4. \uBB35\uC8FC\uC758 \uCCAB \uC54C \uC790\uB9AC\uC5D0
      \uC190\uAC00\uB77D\uC774 \uC7A0\uC2DC \uBA38\uBB38\uB2E4. \uC5B4\uBA38\uB2C8\uAC00
      \uAC00\uB974\uCE58\uC2E0 \uCCAB \uAD6C\uC808\uC774 \uADF8 \uC790\uB9AC\uC5D0\uC11C
      \uC678\uC6CC\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629137
    m_Localized: "\uB450 \uC0AC\uB78C\uC774 \uAC19\uC740 \uBC29\uD5A5\uC73C\uB85C
      \uD55C \uBC1C\uC529 \uC62E\uAE34\uB2E4. \uB2E8\uD604 \uC77C\uC9C0\uC758 \uC0AC\uBCF8
      \uBC88\uD638\uC640 \uC138 \uBB3C\uAC74\uC774 \uB450 \uC190\uC5D0 \uB098\uB258\uC5B4
      \uC788\uB2E4. \uBE48 \uC131\uBC30\uC758 \uC790\uB9AC\uC640 \uBE48 \uBA85\uBD80\uC758
      \uC790\uB9AC\uAC00 \uAC19\uC740 \uBC15\uC790\uB85C \uBA40\uC5B4\uC9C4\uB2E4.
      \uBCF4\uB8E8\uC758 \uCCA8\uD0D1\uC774 \uB4F1 \uB4A4\uC5D0\uC11C \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uD55C \uBC88 \uAE5C\uBE61\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629138
    m_Localized: "\uBB34\uB108\uC9C4 \uBB18\uC5ED\uC758 \uC785\uAD6C. \uCCAD\uB85D
      \uC778\uAD11 \uC774\uB07C\uAC00 \uB3CC\uBCBD \uC0AC\uC774\uC5D0\uC11C \uD55C
      \uBC15\uC790\uC529 \uAE5C\uBE61\uC778\uB2E4. \uC785\uAD6C \uC548\uCABD\uC73C\uB85C
      \uC11D\uAD00\uC774 \uCE35\uCE35\uC774 \uC313\uC5EC \uC788\uB294 \uAC8C \uBCF4\uC778\uB2E4.
      \uBCBD\uB9C8\uB2E4 \uC774\uB984\uC774 \uC0C8\uACA8\uC838 \uC788\uACE0, \uC9C0\uC6CC\uC9C4
      \uC774\uB984\uC5D0\uB294 \uC0C8 \uBA39\uC774 \uB367\uCE60\uB418\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629139
    m_Localized: "\uB2E8\uB9B0\uC774 \uB2E8\uD604 \uC77C\uC9C0 \uC0AC\uBCF8\uC744
      \uD488\uC5D0 \uC548\uC740 \uCC44\uB85C. \uC774\uBE68\uBC14\uB78C\uC774 \uC138
      \uBB3C\uAC74\uC744 \uC637\uC136 \uC548\uC5D0 \uB123\uC740 \uCC44\uB85C. \uB450
      \uC0AC\uB78C\uC774 \uBB18\uC5ED \uC785\uAD6C \uC55E\uC5D0 \uC120\uB2E4. \uAC00\uB77C\uC549\uC740
      \uBCF4\uB8E8\uC5D0\uC11C \uBCF4\uC558\uB358 \uCC28\uAC00\uC6B4 \uBE5B \uB300\uC2E0
      \uBB18\uC5ED\uC758 \uCCAD\uB85D \uC778\uAD11 \uC774\uB07C\uAC00 \uAC19\uC740
      \uBC15\uC790\uB85C \uAE5C\uBE61\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629140
    m_Localized: "...\uD68C\uC0C1 \uACB0\uC0AC. \uC8FD\uC740 \uC790\uC758 \uC774\uB984\uC744
      \uC678\uC6B0\uB294 \uC9D1\uB2E8\uC774\uB77C\uACE0 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629141
    m_Localized: "\uB0C4\uC0C8\uAC00 \uC548\uCABD\uC73C\uB85C \uB04A\uACA8. \uC0AC\uB78C
      \uB0C4\uC0C8\uC778\uB370 \u2014 \uB108\uBB34 \uC624\uB798 \uD55C \uC790\uB9AC\uC5D0\uC11C
      \uBA38\uBB38 \uB0C4\uC0C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629142
    m_Localized: "\uC785\uAD6C \uC548\uCABD \uC548\uAC1C \uB108\uBA38\uC5D0\uC11C
      \uB204\uAD70\uAC00 \uCC9C\uCC9C\uD788 \uC77C\uC5B4\uC120\uB2E4. \uC9C0\uD321\uC774
      \uB05D\uC758 \uC885\uC774 \uD55C \uBC88 \uAC00\uBCCD\uAC8C \uC6B4\uB2E4. silhouette\uB9CC
      \uBCF4\uC778\uB2E4 \u2014 \uC9C0\uD321\uC774\uC758 \uC885 \uB05D, \uD68C\uC0C9
      \uB450\uAC74\uC758 \uC5B4\uAE68\uC120."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629143
    m_Localized: "...\uC5B4, \uC190\uB2D8\uC774\uB124. \uC624\uB798\uAC04\uB9CC\uC774\uC57C.
      \uD55C 300\uB144? 400\uB144?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629144
    m_Localized: "\uB2E8\uB9B0\uC758 \uC190\uC774 \uBB35\uC8FC\uC5D0 \uD55C \uBC88
      \uB2FF\uB294\uB2E4. \uC190\uAC00\uB77D\uC774 \uCCAB \uC54C\uC5D0\uC11C \uBA48\uCD98\uB2E4.
      \uC774\uBE68\uBC14\uB78C\uC774 \uCF54\uB97C \uD55C \uBC88 \uB354 \uB4E0\uB2E4.
      \uC548\uCABD \uB0C4\uC0C8\uAC00 \uD3C9\uC18C\uC758 \uC0AC\uB78C \uB0C4\uC0C8\uC640
      \uB2E4\uB974\uB2E4 \u2014 \uC8FD\uC9C0 \uC54A\uC558\uB294\uB370 \uC8FD\uC740
      \uC790\uB9AC\uC5D0\uC11C \uBA38\uBB38 \uB0C4\uC0C8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629145
    m_Localized: "\uB2E8\uB9B0, \uC774 \uC790\uB9AC\uB294 \uC0AC\uC81C \uB9D0\uB85C\uB294
      \uBABB \uC77D\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629146
    m_Localized: "\uB450 \uC0AC\uB78C\uC758 \uBC1C\uC790\uAD6D\uC774 \uBB18\uC5ED
      \uC785\uAD6C \uC548\uCABD\uC73C\uB85C \uD5A5\uD55C\uB2E4. \uC778\uAD11 \uC774\uB07C\uAC00
      \uB450 \uC0AC\uB78C\uC758 \uB4F1 \uB4A4\uC5D0\uC11C \uD55C \uC904 \uAE38\uAC8C
      \uAE5C\uBE61\uC778\uB2E4. \uC548\uAC1C \uB108\uBA38 \uBB35\uD5A5\uC758 \uC9C0\uD321\uC774
      \uC885\uC774 \uD55C \uBC88 \uB354 \uAC00\uBCCD\uAC8C \uC6B4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629147
    m_Localized: "\uC7BF\uACE8 \uAC70\uC810\uC758 \uBAA8\uB2E5\uBD88. \uB124 \uC0AC\uB78C\uC774
      \uAC19\uC740 \uC790\uB9AC\uC5D0 \uC549\uC544 \uC788\uB2E4. \uB2E8\uB9B0\uC758
      \uBB35\uC8FC \uCCAB \uC54C\uC774 \uC190\uAC00\uB77D \uB05D\uC5D0 \uC7A0\uC2DC
      \uBA38\uBB38\uB2E4. \uC774\uBE68\uBC14\uB78C\uC758 \uC637\uC136\uC5D0 \uC138
      \uBB3C\uAC74\uC774 \uB4E4\uC5B4 \uC788\uB2E4. \uBB35\uD5A5\uC758 \uC9C0\uD321\uC774\uAC00
      \uC606\uC5D0 \uB193\uC5EC \uC788\uACE0, \uADF8 \uB05D\uC758 \uC885\uC774 \uD55C
      \uBC15\uC790\uC529 \uAC00\uBCCD\uAC8C \uC6B4\uB2E4. \uACF5\uD55C\uC774 \uC190\uBC14\uB2E5\uC744
      \uD55C \uBC88 \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629148
    m_Localized: "\uD0C1\uC790 \uC704\uC5D0 \uC138 \uAC00\uC9C0\uAC00 \uB193\uC5EC
      \uC788\uB2E4. \uAC80\uC740 \uB2E8\uC8C4 \uBA85\uB2E8\uC758 \uC0AC\uBCF8, \uCCAB
      \uB3C4\uC2DC \uBCBD\uD654\uC758 \uBA39 \uD0C1\uBCF8, \uB2E8\uD604 \uC77C\uC9C0\uC758
      '\uC81C4\uC218\uBB38' \uD398\uC774\uC9C0. \uADF8 \uC606\uC5D0 \uB2E8\uD604
      \uC77C\uC9C0 \uD45C\uC9C0 \uC548\uCABD\uC758 \uC911\uC559 \uBB38\uC11C\uACE0
      \uC0AC\uBCF8 \uBC88\uD638\uAC00 \uBAA8\uB2E5\uBD88 \uBE5B\uC5D0 \uD55C \uBC88
      \uBE44\uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629149
    m_Localized: "...\uB124 \uAC08\uB798\uC758 \uC57D\uC18D\uC774 \uD55C \uC790\uB9AC\uC5D0
      \uBAA8\uC774\uB294 \uC790\uB9AC\uB294 \uCC98\uC74C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629150
    m_Localized: "\uBB35\uD5A5\uC774 \uC9C0\uD321\uC774 \uB05D\uC758 \uC885 \uD558\uB098\uB97C
      \uC190\uAC00\uB77D\uC73C\uB85C \uBC00\uC5B4 \uB2E8\uB9B0 \uC55E\uAE4C\uC9C0
      \uAD74\uB9B0\uB2E4. \uB2E8\uB9B0\uC774 \uC7A1\uAE30 \uC804\uC5D0, \uBB35\uD5A5\uC774
      \uB2E4\uC2DC \uC9C0\uD321\uC774\uC5D0 \uBB36\uB294\uB2E4. \uB2E8\uB9B0\uC758
      \uC190\uB05D\uC5D0\uB294 \uC885 \uD45C\uBA74\uC758 \uC624\uB798\uB41C \uBA3C\uC9C0
      \uD55C \uC54C\uB9CC \uB0A8\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629151
    m_Localized: "\uD751\uC9C0\uB294 \uC774\uB984\uC73C\uB85C \uBC8C\uD558\uB824
      \uD558\uACE0, \uCE68\uC6D4\uC740 \uBB38\uC744 \uB2EB\uC73C\uB824 \uD574. \uB108\uD76C
      \uB458\uC740 \u2014 \uC5B4\uB514\uB85C \uAC00\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629152
    m_Localized: "...\uC190\uC73C\uB85C \uC5F4\uACA0\uB2E4. \uC624\uB798 \uB2EB\uC740
      \uC790\uC758 \uC190\uC73C\uB85C. \uB3C4\uB9DD\uCE58\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629153
    m_Localized: "\uAE30\uC5B5\uC740 \uD769\uC5B4\uC838\uC57C \uC0B4\uC544\uB0A8\uB294
      \uAC70\uB2C8\uAE4C. \uD55C \uC870\uAC01\uC529 \uB4E4\uACE0 \uAC00\uB294 \uC790\uB9AC\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629154
    m_Localized: "\uBAA8\uB2E5\uBD88\uC5D0\uC11C \uD55C \uBC88 \uC0C8 \uBD88\uAF43\uC774
      \uD759\uC73C\uB85C \uB5A8\uC5B4\uC9C4\uB2E4. \uB124 \uC0AC\uB78C\uC758 \uADF8\uB9BC\uC790\uAC00
      \uAC19\uC740 \uBC29\uD5A5\uC73C\uB85C \uD55C \uBC88 \uD754\uB4E4\uB9B0\uB2E4.
      \uB2E8\uB9B0\uC758 \uC190\uB05D\uC5D0 \uC624\uB798\uB41C \uBA3C\uC9C0 \uD55C
      \uC54C, \uC774\uBE68\uBC14\uB78C\uC758 \uC637\uC136\uC5D0 \uC138 \uBB3C\uAC74,
      \uBB35\uD5A5\uC758 \uC9C0\uD321\uC774\uC5D0 \uC544\uC9C1 \uBB36\uC5EC \uC788\uB294
      \uC885 \uD558\uB098, \uACF5\uD55C\uC758 \uC190\uBC14\uB2E5\uC5D0 \uACA9\uC790
      \uBB38\uC591 \uD558\uB098. \uB124 \uAC00\uC9C0 \uD45C\uC9C0\uAC00 \uD55C \uBAA8\uB2E5\uBD88
      \uBE5B \uC548\uC5D0 \uBAA8\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629155
    m_Localized: "\uB2E4\uC74C \uC790\uB9AC\uB294 \uC720\uB9AC\uC758 \uC232. \uD559\uD30C\uAC00
      \uB3C4\uC2DC \uAE30\uB85D\uC744 \uD574\uC11D\uD558\uACE0 \uC788\uB294 \uC790\uB9AC.
      \uB124 \uC0AC\uB78C\uC758 \uBC1C\uC790\uAD6D\uC774 \uAC19\uC740 \uBC29\uD5A5\uC73C\uB85C
      \uD55C \uBC1C\uC529 \uB098\uAC04\uB2E4. \uC9C0\uD321\uC774 \uC885\uC774 \uBA40\uB9AC\uC11C
      \uD55C \uBC88 \uB354 \uC6B4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629156
    m_Localized: "\uBCC0\uACBD\uC758 \uD750\uB9B0 \uC0C8\uBCBD. \uC791\uC740 \uBC29\uC758
      \uCC3D\uBB38 \uB108\uBA38\uB85C \uC548\uAC1C\uAC00 \uCC9C\uCC9C\uD788 \uD750\uB978\uB2E4.
      \uCC45\uC0C1 \uC704 \uB4F1\uBD88\uC774 \uB9C8\uC9C0\uB9C9 \uAE30\uB984\uAE4C\uC9C0
      \uD55C \uBC88 \uD754\uB4E4\uB9B0\uB2E4. \uC0AC\uC81C \uC778\uC7A5\uC774 \uCC45\uC0C1\uC5D0
      \uD480\uB9B0 \uCC44 \uB193\uC5EC \uC788\uB2E4. \uB2E8\uB9B0\uC774 \uADF8 \uC606\uC5D0
      \uC549\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629157
    m_Localized: "\uB2E8\uB9B0\uC758 \uC190\uAC00\uB77D\uC774 \uAE30\uB3C4\uBB38
      \uC704\uC5D0 \uBA38\uBB38\uB2E4. \uC5B4\uBA38\uB2C8\uAC00 \uAC00\uB974\uCE58\uC2E0
      \uCCAB \uAD6C\uC808\uC774 \uC801\uD78C \uC885\uC774. \uC190\uAC00\uB77D\uC774
      \uADF8 \uCCAB \uC904\uC744 \uD55C \uBC88 \uB530\uB77C \uADF8\uB9B0\uB2E4. \uC789\uD06C\uAC00
      \uD55C \uC790\uB9AC\uC5D0\uC11C \uC605\uC5B4\uC9C4 \uAC83\uC744 \uBCF8\uB2E4
      \u2014 \uD3C9\uC0DD \uADF8 \uC790\uB9AC\uB9CC \uC9DA\uC5B4 \uC654\uB358 \uD754\uC801."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629158
    m_Localized: "\uAE30\uB3C4\uAC00 \uC870\uC6A9\uD574\uC9C4 \uB4A4\uC5D0\uB3C4,
      \uBB3B\uB294 \uC77C\uC740 \uB0A8\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629159
    m_Localized: "\uB2E8\uB9B0\uC774 \uAE30\uB3C4\uBB38\uC744 \uC811\uAE30 \uC2DC\uC791\uD55C\uB2E4.
      \uD55C \uC904\uC529, \uCC9C\uCC9C\uD788. \uD55C \uBC88\uC5D0 \uAE54\uB054\uD558\uAC8C
      \uC811\uC9C0 \uC54A\uB294\uB2E4. \uC5B4\uBA38\uB2C8\uAC00 \uC774 \uC885\uC774\uB97C
      \uD55C \uBC88 \uC811\uC5B4 \uBCF4\uB0B4\uC168\uC744 \uB54C\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629160
    m_Localized: "\uC811\uD78C \uAE30\uB3C4\uBB38\uC774 \uC0AC\uC81C \uC778\uC7A5
      \uC606\uC5D0 \uB193\uC778\uB2E4. \uB450 \uAC00\uC9C0\uAC00 \uAC19\uC740 \uC790\uB9AC\uC5D0
      \uC788\uC9C0\uB9CC \uBB36\uC5EC \uC788\uC9C0 \uC54A\uB2E4. \uC5B4\uBA38\uB2C8\uAC00
      \uB9C8\uC9C0\uB9C9\uC5D0 \uC9DA\uC73C\uC168\uB358 \uC790\uC218\uC758 \uBC31\uAE08\uACFC
      \uC0AC\uC81C \uC778\uC7A5 \uB05D\uC758 \uBC31\uAE08\uC774 \uAC19\uC740 \uC0C9\uC73C\uB85C
      \uBE5B\uB09C\uB2E4. \uB2E8\uB9B0\uC774 \uADF8 \uB458\uC744 \uCC98\uC74C\uC73C\uB85C
      \uB530\uB85C \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629161
    m_Localized: "\uB2E8\uB9B0\uC774 \uC0AC\uC81C \uC778\uC7A5\uC744 \uC190\uC5D0
      \uD55C \uBC88 \uC954\uB2E4. \uD3C9\uC0DD\uC758 \uC758\uBB34\uAC00 \uC190\uAC00\uB77D
      \uC0AC\uC774\uB97C \uD55C \uBC88 \uC9C0\uB098\uAC04\uB2E4. \uADF8\uB7EC\uB098
      \uC774\uBC88\uC5D0\uB294 \uBB35\uC8FC\uCC98\uB7FC \uC678\uC6B8 \uCCAB \uAD6C\uC808\uC774
      \uB530\uB77C\uC624\uC9C0 \uC54A\uB294\uB2E4. \uC778\uC7A5\uC744 \uB2E4\uC2DC
      \uCC45\uC0C1\uC5D0 \uB454\uB2E4. \uD480\uB9B0 \uCC44\uB85C. \uC190\uBC14\uB2E5\uC5D0
      \uC788\uB358 \uC790\uAD6D\uC774 \uC190\uBAA9\uC73C\uB85C \uC62E\uACA8\uAC00\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629162
    m_Localized: "\uACF5\uD55C\uC774 \uBB38\uBC16\uC5D0 \uB0A8\uAE34 \uB9D0\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uAE38\uC744 \uC783\uC9C0 \uC54A\uAC8C \uBD88\uC744
      \uB450\uACA0\uB2E4\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629163
    m_Localized: "\uB4F1\uBD88\uC758 \uB9C8\uC9C0\uB9C9 \uAE30\uB984\uC774 \uB2E4
      \uD0C4\uB2E4. \uC0C8\uBCBD \uBE5B\uC774 \uCC45\uC0C1 \uC704 \uC0AC\uC81C \uC778\uC7A5\uC744
      \uD55C \uBC88 \uAE38\uAC8C \uBE44\uCD98\uB2E4. \uB2E8\uB9B0\uC774 \uC77C\uC5B4\uC120\uB2E4.
      \uC778\uC7A5\uB3C4 \uAE30\uB3C4\uBB38\uB3C4 \uB530\uB77C\uC624\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629164
    m_Localized: "\uBB38\uC774 \uC5F4\uB9B0\uB2E4. \uC0C8\uBCBD \uC548\uAC1C\uAC00
      \uBC29 \uC548\uC73C\uB85C \uD55C \uC904 \uB4E4\uC5B4\uC640 \uCC45\uC0C1 \uC704
      \uAE30\uB3C4\uBB38\uC5D0 \uB2FF\uB294\uB2E4. \uC885\uC774 \uD55C \uC790\uB77D\uC774
      \uC548\uAC1C\uC758 \uBB34\uAC8C\uC5D0 \uD55C \uBC88 \uD754\uB4E4\uB9AC\uACE0
      \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629165
    m_Localized: "\uCCAB \uB3C4\uC2DC \uBB38\uD131. \uB2EB\uD78C \uACA9\uC790 \uC55E\uC5D0
      \uACF5\uD55C\uC774 \uC11C \uC788\uB2E4. \uACA9\uC790\uB294 \uADF8\uB97C \uBC1B\uC544\uB4E4\uC774\uC9C0
      \uC54A\uB294\uB2E4. \uC544\uB2C8, \uC774\uBC88\uC5D0\uB294 \uADF8\uAC00 \uB4E4\uC5B4\uAC00\uC9C0
      \uC54A\uB294\uB2E4. 1800\uB144 \uC804 \uC2DC\uC870\uC758 \uC190\uAC00\uB77D\uC774
      \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC9DA\uC740 \uB3CC\uC774 \uBB38 \uC548\uCABD\uC5D0\uC11C
      \uC9E7\uAC8C \uBE5B\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629166
    m_Localized: "\uB2E8\uB9B0\uC774 \uC606\uC5D0 \uC549\uC544 \uC788\uB2E4. \uC0AC\uC81C
      \uC778\uC7A5\uC774 \uD480\uB9B0 \uCC44 \uADF8\uB140\uC758 \uC190\uAC00\uB77D
      \uC0AC\uC774\uC5D0 \uAC00\uB9CC\uD788 \uC788\uB2E4. \uB450 \uB3C4\uAD6C \u2014
      \uC3D8\uC9C0 \uC54A\uC740 \uACA9\uC790 \uB9E4\uB4ED \uD654\uC0B4, \uC190\uAC00\uB77D
      \uC0AC\uC774\uC5D0 \uD480\uB9B0 \uC0AC\uC81C \uC778\uC7A5 \u2014 \uAC00 \uAC19\uC740
      \uC790\uB9AC\uC5D0 \uB193\uC778\uB2E4. \uB450 \uC0AC\uB78C \uC0AC\uC774\uC5D0
      \uC9C1\uC811 \uB300\uC0AC\uB294 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629167
    m_Localized: "...\uB0A8\uC740 \uC2DC\uAC04\uC740 \uADF8\uB300\uC758 \uAC83\uC774\uB2E4.
      \uB2E8\uB9B0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629168
    m_Localized: "\uB2E8\uB9B0\uC774 \uC9E7\uAC8C \uB044\uB355\uC778\uB2E4. \uC0AC\uC81C
      \uC778\uC7A5\uC5D0\uC11C \uC190\uC774 \uAC00\uBCCD\uAC8C \uD480\uB9B0\uB2E4.
      \uB450 \uC0AC\uB78C \uB2E4 \uB3C4\uAD6C\uB97C \uC190\uC5D0\uC11C \uD480\uC5B4
      \uB193\uB294 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629169
    m_Localized: "\uC190\uC774 \uBE44\uC5C8\uB2E4. \uADF8\uB798\uC11C \uBB38\uC744
      \uC7A1\uC744 \uC218 \uC788\uB2E4. \uC548\uC5D0\uC11C \uB098\uC624\uB294 \uC0AC\uB78C\uB3C4,
      \uBC16\uC5D0\uC11C \uB4E4\uC5B4\uC624\uB294 \uC0AC\uB78C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629170
    m_Localized: "\uACF5\uD55C\uC774 \uD65C\uC2DC\uC704\uC5D0\uC11C \uD654\uC0B4\uC744
      \uB0B4\uB9B0\uB2E4. \uACA9\uC790 \uB9E4\uB4ED \uD654\uC0B4 \uB05D\uC758 \uC791\uC740
      \uC218\uC815\uC774 \uD55C \uBC88 \uBE5B\uB09C\uB2E4. \uADF8 \uBE5B\uC740 \uBB38
      \uC548\uCABD \uACA9\uC790\uC640 \uACF5\uBA85\uD558\uC9C0\uB9CC, \uBB38\uC740
      \uC5F4\uB9AC\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629171
    m_Localized: "\uACF5\uD55C\uC740 \uB2EB\uD78C \uACA9\uC790 \uC55E\uC5D0 \uC11C\uC11C
      \uC190\uC744 \uB0B4\uB9B0\uB2E4. \uBB38\uBC16\uC5D0 \uB0A8\uC740 \uC190\uC774
      \uCC98\uC74C\uC73C\uB85C \uBE44\uC5B4 \uC788\uB2E4. \uB2E8\uB9B0\uC774 \uADF8
      \uBE48 \uC190\uC744 \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629172
    m_Localized: "\uB2E8\uB9B0\uC774 \uADF8 \uC790\uB9AC\uC5D0 \uC7A0\uC2DC \uB354
      \uBA38\uBB34\uB978\uB2E4. \uC0AC\uC81C \uC778\uC7A5\uC774 \uC190\uAC00\uB77D
      \uC0AC\uC774\uC5D0 \uD480\uB9B0 \uCC44 \uAC00\uB9CC\uD788 \uC788\uB2E4. \uACF5\uD55C\uC740
      \uBB38\uC744 \uB4F1\uC9C0\uC9C0 \uC54A\uB294\uB2E4. \uC544\uC9C1 \uC99D\uC5B8\uD574\uC57C
      \uD560 \uC0AC\uB78C\uC774\uAE30 \uB54C\uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629173
    m_Localized: "...\uBB38\uBC16\uC740 \uCDA5\uB2E4. \uAD1C\uCC2E\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629174
    m_Localized: "\uBB38\uD2C8\uC758 \uBE5B\uC774 \uC791\uAC8C \uB0A8\uB294\uB2E4.
      \uB2EB\uD78C \uBE5B\uC774 \uC544\uB2C8\uB77C, \uB204\uAC00 \uB3CC\uC544\uC62C
      \uB54C \uAE38\uC744 \uC783\uC9C0 \uC54A\uAC8C \uB450\uB294 \uBE5B\uC774\uB2E4.
      \uB2E8\uB9B0\uC774 \uC77C\uC5B4\uC120\uB2E4. \uC0AC\uC81C \uC778\uC7A5\uC740
      \uCC45\uC0C1 \uC704\uC5D0 \uB454\uB2E4. \uD480\uB9B0 \uCC44 \uADF8\uB300\uB85C.
      \uB450 \uB3C4\uAD6C\uAC00 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uB0A8\uB294\uB2E4
      \u2014 \uACA9\uC790 \uB9E4\uB4ED\uACFC \uC0AC\uC81C \uC778\uC7A5. \uB2E4\uC74C
      \uC138\uB300\uAC00 \uD55C \uBC88\uC529 \uC9DA\uC744 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629175
    m_Localized: "\uBB18\uC5ED \uC785\uAD6C \uAC70\uC810. \uC778\uAD11 \uC774\uB07C\uAC00
      \uCCAD\uB85D\uC73C\uB85C \uCC9C\uCC9C\uD788 \uAE5C\uBE61\uC778\uB2E4. 200\uB144
      \uC804 \uB3D9\uB8CC\uAC00 \uB9C8\uC9C0\uB9C9 \uC758\uB840\uB97C \uB9C8\uCE5C
      \uC790\uB9AC\uC640 \uAC19\uC740 \uB9AC\uB4EC\uC774\uB2E4. \uBB35\uD5A5\uC774
      \uC9C0\uD321\uC774\uB97C \uC606\uC5D0 \uB450\uACE0 \uBB34\uB98E \uC704\uC5D0
      \uC190\uBAA9\uC744 \uBCF8\uB2E4. \uC0C8\uB85C \uC0C8\uAE34 \uBC1C\uC5B8\uAD8C
      \uD749\uD130\uAC00 \uC605\uAC8C \uBD89\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629176
    m_Localized: "\uBB35\uD5A5\uC758 \uC9C0\uD321\uC774\uC5D0\uC11C \uC885 \uD558\uB098\uAC00
      \uBE60\uC9C4 \uC790\uB9AC\uAC00 \uBCF4\uC778\uB2E4. \uB2E8\uB9B0\uC5D0\uAC8C
      \uBCF4\uB0B8 \uC885\uC774 \uBE60\uC9C4 \uCC44\uB85C\uB2E4. \uADF8 \uC790\uB9AC\uB294
      \uBE44\uC5B4 \uC788\uB2E4. \uC778\uAD11 \uC774\uB07C\uC758 \uBE5B\uB9CC \uADF8
      \uBE48 \uC790\uB9AC\uC5D0 \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629177
    m_Localized: "\uBB35\uD5A5\uC774 \uC190\uBAA9\uC758 \uD749\uD130\uB97C \uC190\uAC00\uB77D\uC73C\uB85C
      \uCC9C\uCC9C\uD788 \uB530\uB77C \uADF8\uB9B0\uB2E4. \uB2E4\uC12F \uAC1C\uC758
      \uD749\uD130 \uC911 \uAC00\uC7A5 \uC0C8\uB85C\uC6B4 \uD55C \uC904\uC5D0\uC11C
      \uC7A0\uC2DC \uBA48\uCD98\uB2E4. \uC190\uAC00\uB77D \uB05D\uC5D0 \uC78E \uAC00\uB8E8
      \uAC19\uC740 \uBA3C\uC9C0 \uD55C \uC90C\uC774 \uBB3B\uB294\uB2E4 \u2014 \uACB0\uC0AC
      \uC758\uB840 \uC789\uD06C\uC758 \uBD80\uC0B0\uBB3C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629178
    m_Localized: "\uAE30\uC5B5\uC740 \uD769\uC5B4\uC838\uC57C \uC0B4\uC544\uB0A8\uC544.
      \uD55C \uC0AC\uB78C \uC7A5\uB840\uC2DD\uC5D0 \uAC19\uC774 \uBB3B\uD788\uBA74
      \uACE4\uB780\uD558\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629179
    m_Localized: "\uC9C0\uD321\uC774\uC758 \uBE48 \uC790\uB9AC\uB294 \uADF8\uB300\uB85C\uB2E4.
      \uC885\uC774 \uC5C6\uB294\uB370\uB3C4, \uC778\uAD11 \uC774\uB07C\uAC00 \uB2FF\uC790
      \uC9E7\uC740 \uC6B8\uB9BC \uAC19\uC740 \uBE5B\uC774 \uD754\uB4E4\uB9B0\uB2E4.
      \uBB35\uD5A5\uC758 \uC190\uAC00\uB77D\uC774 \uC9C0\uD321\uC774\uB97C \uAC00\uBCCD\uAC8C
      \uC7A1\uC558\uB2E4 \uB193\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629180
    m_Localized: "\uBB35\uD5A5\uC774 \uC9C0\uD321\uC774\uC758 \uBE48 \uC790\uB9AC\uC5D0
      \uC190\uAC00\uB77D\uC744 \uBA38\uBB38\uB2E4. \uADF8 \uC790\uB9AC\uB294 \uBE44\uC5B4
      \uC788\uB294 \uCC44\uB85C \uADF8\uB300\uB85C\uB2E4. \uBD80\uC7AC\uC758 \uBB34\uAC8C\uAC00
      \uAC70\uAE30\uC5D0 \uC788\uC9C0\uB9CC, \uADF8 \uBD80\uC7AC\uAC00 \uB2E8\uB9B0\uC758
      \uBB34\uB98E \uC704\uC5D0 \uB2E4\uB978 \uD615\uD0DC\uB85C \uC788\uB2E4\uB294
      \uAC83\uC744 \uBB35\uD5A5\uC774 \uC548\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629181
    m_Localized: "\uD55C \uC870\uAC01, \uB4E4\uC5B4\uC918\uC11C \uACE0\uB9C8\uC6CC.
      \uC774\uC81C \uADF8 \uD55C \uC870\uAC01\uC774 \uC0C8\uBCBD\uB9C8\uB2E4 \uB2E8\uB9B0\uC758
      \uC785\uAC00\uC5D0\uC11C \uC7A0\uAE50\uC529 \uBA48\uCD98\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629182
    m_Localized: "\uBB35\uD5A5\uC774 \uCC98\uC74C\uC73C\uB85C \uBE48 \uC9C0\uD321\uC774
      \uC790\uB9AC\uB97C \uBCF4\uBA74\uC11C \uBBF8\uC138\uD558\uAC8C \uBBF8\uC18C
      \uC9D3\uB294\uB2E4. \uADF8 \uBBF8\uC18C\uAC00 \uC7A0\uC2DC \uBA38\uBB3C\uACE0
      \uB2E4\uC2DC \uD3C9\uC18C\uC758 \uCC28\uBD84\uC73C\uB85C \uB3CC\uC544\uAC04\uB2E4.
      \uC190\uAC00\uB77D \uB05D\uC758 \uC78E \uAC00\uB8E8\uAC00 \uD759\uC73C\uB85C
      \uB5A8\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629183
    m_Localized: "\uAE30\uC5B5\uD574 \uC904\uAC8C. \uADF8\uB300\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629184
    m_Localized: "\uC778\uAD11 \uC774\uB07C\uAC00 \uD55C \uC790\uB9AC\uC5D0\uC11C
      \uB354 \uC9D9\uAC8C \uAE5C\uBE61\uC778\uB2E4 \u2014 200\uB144 \uC804 \uB3D9\uB8CC\uC758
      \uB9C8\uC9C0\uB9C9 \uC758\uB840 \uC790\uB9AC\uC5D0\uC11C. \uC778\uAD11 \uC774\uB07C\uAC00
      \uB2FF\uC790 \uC885\uC774 \uC5C6\uB294 \uC790\uB9AC\uC5D0\uC11C \uC9E7\uC740
      \uC6B8\uB9BC \uAC19\uC740 \uBE5B\uC774 \uD754\uB4E4\uB9B0\uB2E4. \uBB35\uD5A5\uC740
      \uB4E4\uC9C0 \uC54A\uB294\uB2E4. \uB4E4\uC73C\uBA74, \uB610 \uC6C3\uC5B4\uB118\uAE38
      \uAC83 \uAC19\uC544\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629185
    m_Localized: "\uBCC0\uACBD \uC57C\uC601\uC9C0\uC758 \uBC24. \uBAA8\uB2E5\uBD88\uC774
      \uD55C \uBC88\uC529 \uC791\uC740 \uBD88\uAF43\uC744 \uD759\uC73C\uB85C \uB5A8\uC5B4\uB728\uB9B0\uB2E4.
      \uD759 \uC704\uC5D0\uC11C \uC9E7\uAC8C \uBE5B\uB0AC\uB2E4 \uC0AC\uB77C\uC9C4\uB2E4.
      \uBAA8\uB2E5\uBD88 \uB108\uBA38\uC5D0 \uD55C \uC790\uB9AC\uAC00 \uBE44\uC5B4
      \uC788\uB2E4 \u2014 \uD68C\uC870\uAC00 \uC549\uC544\uC57C \uD588\uB358 \uC790\uB9AC.
      \uADF8 \uC790\uB9AC\uC5D0 \uC0C8 \uBC1C\uC790\uAD6D\uC774 \uD55C \uAC1C\uB3C4
      \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629186
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uC5B4\uAE68\uC5D0\uC11C \uD1A0\uD15C
      \uBCF4\uD638\uB300\uB97C \uD480\uC5B4 \uBB34\uB98E \uC704\uC5D0 \uB193\uB294\uB2E4.
      \uD1A0\uD15C 4 \uB3D9\uBB3C \uBA38\uB9AC \uC790\uC218 \uC911 \uD55C \uC790\uB9AC\uC5D0
      \uAC80\uC740 \uCE60\uC774 \uD55C \uC904\uB85C \uADF8\uC5B4\uC838 \uC788\uB2E4.
      \uCE60\uC774 \uB9C8\uB978 \uC9C0 \uC624\uB798\uB418\uC9C0 \uC54A\uC740 \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629187
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC758 \uC190\uAC00\uB77D\uC774 \uAC80\uC740
      \uCE60 \uBD80\uBD84\uC744 \uCC9C\uCC9C\uD788 \uB530\uB77C \uADF8\uB9B0\uB2E4.
      \uD55C \uBC88. \uB450 \uBC88. \uCE60\uC774 \uC7A0\uAE50 \uD750\uB824\uC9C0\uC9C0\uB9CC
      \uC790\uAD6D\uC740 \uADF8\uB300\uB85C \uB0A8\uB294\uB2E4. \uC190\uAC00\uB77D
      \uB05D\uC5D0 \uCE60 \uAC00\uB8E8 \uD55C \uC54C\uC774 \uBB3B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629188
    m_Localized: "\uAC80\uC740 \uCE60\uC740 \uC601\uAD6C \uB2E8\uC808\uC774 \uC544\uB2C8\uC57C.
      \uADF8\uAC83\uB9CC \uC54C\uC544 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629189
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uC190\uBAA9\uC758 \uD53C\uC758
      \uC11C\uC57D \uD749\uD130\uB97C \uD55C \uBC88 \uB9CC\uC9C4\uB2E4. \uD68C\uC870\uC640
      \uAC19\uC740 \uC790\uB9AC\uC5D0 \uC0C8\uACA8\uC9C4 \uD749\uD130. \uC190\uAC00\uB77D\uC774
      \uD749\uD130 \uB05D\uC744 \uD55C \uBC88 \uB530\uB77C \uADF8\uB9B0\uB2E4. \uB450
      \uC790\uAD6D \u2014 \uAC80\uC740 \uCE60\uACFC \uD749\uD130 \u2014 \uC774 \uAC19\uC740
      \uBB34\uAC8C\uB85C \uC190\uC5D0 \uB2FF\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629190
    m_Localized: "\uBAA8\uB2E5\uBD88 \uB108\uBA38 \uBE48 \uC790\uB9AC\uB97C \uD55C
      \uBC88 \uBCF8\uB2E4. \uCF54\uB97C \uB4E4\uC9C0 \uC54A\uB294\uB2E4. \uD3C9\uC18C\uC758
      \uBC14\uB78C \uC77D\uAE30 \uC790\uC138\uAC00 \uC544\uB2CC \u2014 \uADF8\uC800
      \uBE48 \uC790\uB9AC\uB97C \uBCF4\uB294 \uC790\uC138. \uADF8 \uC790\uB9AC\uC5D0
      \uC0C8 \uBC1C\uC790\uAD6D\uC774 \uD55C \uAC1C\uB3C4 \uC5C6\uB2E4\uB294 \uAC83\uC744,
      \uD55C \uBC88 \uB354 \uD655\uC778\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629191
    m_Localized: "\uD0C1\uC790\uAC00 \uD544\uC694\uD574. \uC11C\uB85C \uBB3C\uAE30
      \uC804\uC5D0, \uAC19\uC740 \uBC14\uB78C\uC744 \uD55C \uBC88 \uB9E1\uB294 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629192
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uD1A0\uD15C \uBCF4\uD638\uB300\uB97C
      \uB2E4\uC2DC \uC5B4\uAE68\uC5D0 \uAC78\uCE5C\uB2E4. \uAC80\uC740 \uCE60\uC774
      \uBE5B \uC544\uB798\uC5D0\uC11C \uD55C \uBC88 \uD750\uB824\uC84C\uB2E4 \uB2E4\uC2DC
      \uB610\uB837\uD574\uC9C4\uB2E4. \uADF8\uAC00 \uCF54\uB97C \uD55C \uBC88 \uB4E0\uB2E4.
      \uBC14\uB78C\uC744 \uC77D\uB294\uB2E4. \uBC14\uB78C\uC758 \uBC29\uD5A5\uC774
      \uBE48 \uC790\uB9AC \uCABD\uC774 \uC544\uB2C8\uB2E4 \u2014 \uCC9C\uB9C9 \uC785\uAD6C
      \uCABD\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629193
    m_Localized: "\uBAA8\uB2E5\uBD88\uC5D0\uC11C \uD55C \uBC88 \uC0C8 \uBD88\uAF43\uC774
      \uD759\uC73C\uB85C \uB5A8\uC5B4\uC9C4\uB2E4. \uC774\uBE68\uBC14\uB78C\uC774
      \uC77C\uC5B4\uC120\uB2E4. \uC190\uAC00\uB77D \uB05D\uC758 \uCE60 \uAC00\uB8E8
      \uD55C \uC54C\uC774 \uBAA8\uB2E5\uBD88 \uBE5B \uC0AC\uC774\uB85C \uD759\uC5D0
      \uB2E4\uC2DC \uB5A8\uC5B4\uC9C4\uB2E4. \uBC1C\uC790\uAD6D \uD55C \uAC1C\uAC00
      \uCC9C\uB9C9 \uC785\uAD6C\uB97C \uD5A5\uD55C\uB2E4. \uD68C\uC870 \uC790\uB9AC\uB294
      \uC5EC\uC804\uD788 \uBE44\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629194
    m_Localized: "\uCCAB \uB3C4\uC2DC\uB294 1800\uB144 \uC804\uC5D0 \uBB34\uB108\uC84C\uB2E4.
      \uD559\uC0B4\uC758 \uC0C8\uBCBD\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629195
    m_Localized: "\uB204\uAC00 \uB204\uAD6C\uB97C \uC8FD\uC600\uB294\uC9C0, \uC0B4\uC544\uB0A8\uC740
      \uC790\uB4E4\uC740 \uD568\uAED8 \uC78A\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629196
    m_Localized: "1800\uB144 \uB4A4. \uBCC0\uBC29\uBB38\uC774 \uBB34\uB108\uC84C\uB2E4.
      \uBC16\uC5D0\uC11C \uBD80\uC21C \uC790\uAD6D\uC740 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629197
    m_Localized: "\uC548\uC5D0\uC11C \uBC00\uC5B4\uB0B8 \uC790\uAD6D\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629198
    m_Localized: "\uAE4C\uB9C8\uADC0 \uD55C \uB9C8\uB9AC\uAC00 \uCCA0 \uD30C\uD3B8
      \uC704\uC5D0 \uC549\uC558\uB2E4. \uAC19\uC740 \uAE4C\uB9C8\uADC0\uB294 \uC544\uB2C8\uC5C8\uB2E4.
      \uAC19\uC740 \uC0C8\uBCBD\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629199
    m_Localized: "**\uC7AC\uC758 \uBB38**"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629200
    m_Localized: "\uBCC0\uBC29 \uC7BF\uACE8 \uB9C8\uC744. \uACE8\uC9DC\uAE30 \uC0C8\uBCBD
      \uC548\uAC1C\uAC00 \uB9C8\uC744 \uCC9C\uB9C9 \uC0AC\uC774\uB85C \uD750\uB978\uB2E4.
      \uC815\uCC30 \uAE38\uB4DC\uC758 \uC791\uC740 \uCC9C\uB9C9 \uC548\uC5D0\uC11C
      \uBAA8\uB2E5\uBD88\uC774 \uC785\uAD6C \uCABD\uC73C\uB85C \uB0AE\uAC8C \uAE30\uC6B8\uC5B4
      \uC788\uB2E4. \uAC15\uC639\uC774 \uBA85\uB839\uC11C\uB97C \uD55C\uC0C8 \uC55E\uC5D0
      \uB454\uB2E4. \uC194\uB77C\uB8F8 \uC9D1\uC815\uAD00 \uD68C\uC758\uC758 \uBC31\uAE08
      \uC778\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629201
    m_Localized: "\uD55C\uC0C8\uAC00 \uBD09\uC778 \uC790\uAD6D\uC5D0 \uC190\uAC00\uB77D\uC744
      \uD55C \uBC88 \uB304\uB2E4. \uBC31\uAE08\uC774 \uD55C \uBC88 \uD480\uB838\uB2E4
      \uB2E4\uC2DC \uB2EB\uD78C \uC790\uAD6D\uC774 \uADF8 \uC606\uC5D0 \uD55C \uBC88
      \uB354 \uC788\uB2E4. \uBA85\uB839\uC11C\uB294 \uB204\uAD70\uAC00 \uBA3C\uC800
      \uC77D\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629202
    m_Localized: "...\uB204\uAC00 \uBA3C\uC800 \uBD24\uB294\uC9C0, \uC790\uB124\uB3C4
      \uBD24\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629203
    m_Localized: "\uD55C\uC0C8\uAC00 \uC9E7\uAC8C \uB044\uB355\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629204
    m_Localized: "\uBA85\uB839\uC11C\uB294 \uC2DC\uD0A4\uB294 \uB9D0\uC744 \uC801\uC9C0.
      \uC228\uAE30\uB294 \uB9D0\uC740 \uC885\uC774 \uAD6C\uC11D\uC5D0 \uB0A8\uB294\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629205
    m_Localized: "\uC790\uB124\uB294 \uC7BF\uACE8\uC5D0 \uB0A8\uC544\uB77C. \uAE38\uB4DC
      \uB9F9\uC138\uAC00 \uBCC0\uBC29\uBB38 \uC548\uCABD\uAE4C\uC9C0 \uB530\uB77C\uAC00
      \uC8FC\uC9C4 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629206
    m_Localized: "\uAC15\uC639\uC774 \uD654\uC0B4 \uB450 \uC790\uB8E8\uB97C \uCC9C
      \uC704\uC5D0 \uB454\uB2E4. \uB05D\uC5D0 \uD770 \uB048. \uC624\uB798 \uBB36\uC5B4
      \uB450\uC5C8\uB358 \uB048\uC774\uB77C \uC0C9\uC774 \uC870\uAE08 \uB204\uB807\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629207
    m_Localized: "\uC0C8 \uCD9C\uBC1C \uD654\uC0B4\uC774\uB2E4. \uBC1B\uB294 \uC0AC\uB78C\uD55C\uD14C
      \uC774\uC720\uB97C \uBB3B\uC9C0 \uC54A\uB294 \uD654\uC0B4\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629208
    m_Localized: "\uC0AC\uC81C\uC640 \uBB34\uB9AC \uC9C0\uB3C4\uC790\uC5D0\uAC8C
      \uD55C \uC790\uB8E8\uC529 \uAC74\uB124\uB77C. \uB450 \uC0AC\uB78C\uC774 \uC11C\uB85C
      \uBABB \uBBFF\uC5B4\uB3C4, \uC774 \uD654\uC0B4\uC740 \uAC19\uC774 \uB4E4\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629209
    m_Localized: "\uD55C\uC0C8\uAC00 \uD654\uC0B4\uC744 \uC790\uB8E8\uC5D0 \uB123\uB294\uB2E4.
      \uBAA8\uB2E5\uBD88\uC5D0\uC11C \uC791\uC740 \uBD88\uAF43 \uD558\uB098\uAC00
      \uD759\uC73C\uB85C \uB5A8\uC5B4\uC9C4\uB2E4. \uC7BF\uACE8\uC758 \uD759\uC740
      \uAC80\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629210
    m_Localized: "\uCC9C\uB9C9 \uD718\uC7A5\uC774 \uD55C \uBC88 \uB4E4\uB9B0\uB2E4.
      \uC80A\uC740 \uC5EC\uC0AC\uC81C \uD55C \uBA85\uC774 \uC7BF\uACE8 \uC0C8\uBCBD
      \uC548\uAC1C\uB97C \uB4F1\uC9C0\uACE0 \uB4E4\uC5B4\uC120\uB2E4. \uC0AC\uC81C\uBCF5
      \uC548\uC8FC\uBA38\uB2C8\uC5D0\uC11C \uBB35\uC8FC\uAC00 \uB9CC\uC838\uC9C4\uB2E4
      \u2014 \uCCAB \uC54C\uC774 \uC190\uAC00\uB77D \uB05D\uC5D0 \uBA48\uCD98\uB2E4.
      \uC5B4\uBA38\uB2C8\uAC00 \uB9C8\uC9C0\uB9C9\uC5D0 \uC9DA\uC73C\uC168\uB358
      \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629211
    m_Localized: "...\uC9D1\uC815\uAD00 \uD68C\uC758\uC758 \uBA85\uC744 \uBC1B\uC544
      \uC654\uC2B5\uB2C8\uB2E4. \uB2E8\uB9B0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629212
    m_Localized: "\uD55C\uC0C8\uAC00 \uC9E7\uAC8C \uACE0\uAC1C\uB97C \uC219\uC778\uB2E4.
      \uB2E8\uB9B0\uC774 \uADF8 \uC790\uC138\uB97C \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629213
    m_Localized: "...\uC774\uB984\uC744 \uBB3B\uC9C0 \uC54A\uC73C\uC154\uB3C4 \uB429\uB2C8\uB2E4.
      \uC0AC\uC81C\uB85C\uC11C\uAC00 \uC544\uB2C8\uB77C \uD55C \uC0AC\uB78C\uC73C\uB85C
      \uBC1B\uC544 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629214
    m_Localized: "\uB2E8\uB9B0\uC774 \uBAA8\uB2E5\uBD88 \uC606\uC5D0 \uC549\uB294\uB2E4.
      \uBB35\uC8FC \uCCAB \uC54C\uC5D0\uC11C \uC190\uAC00\uB77D\uC774 \uD55C \uBC88
      \uB354 \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629215
    m_Localized: "...\uD638\uC704\uB77C \uC801\uD614\uC9C0\uB9CC, \uADF8\uAC83\uBFD0\uC740
      \uC544\uB2D9\uB2C8\uB2E4. \uC0AC\uC81C\uAC00 \uBCC0\uBC29\uC5D0 \uAC00\uB294
      \uAC74 \uBCF4\uD1B5 \u2014 \uBCF4\uB7EC \uAC00\uB294 \uC790\uB9AC\uC785\uB2C8\uB2E4.
      \uADF8\uAC83\uB9CC \uBA3C\uC800 \uB9D0\uC500\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629216
    m_Localized: "\uC0AC\uC81C\uAC00 \uBB34\uC5C7\uC744 \uBCF4\uB7EC \uAC00\uB294\uC9C0\uB294
      \u2014 \uC0AC\uC81C\uB3C4 \uBAA8\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629217
    m_Localized: "\uD55C\uC0C8\uAC00 \uD654\uC0B4 \uC790\uB8E8\uB97C \uC5B4\uAE68\uC5D0
      \uAC78\uCE5C\uB2E4. \uD770 \uB048\uC774 \uBC14\uB78C\uC5D0 \uC9E7\uAC8C \uD754\uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629218
    m_Localized: "\uC7BF\uACE8\uC758 \uC0C8\uBCBD. \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740
      \uC544\uBB34\uB3C4 \uC778\uC0AC\uD558\uC9C0 \uC54A\uC558\uB2E4. \uBCC0\uBC29\uBB38\uC73C\uB85C
      \uAC00\uB294 \uC0C8\uBCBD\uC5D0\uB294, \uC0B4\uC544 \uC788\uB294 \uC0AC\uB78C\uC5D0\uAC8C\uB3C4
      \uBA3C\uC800 \uB9D0\uC744 \uAC78\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629219
    m_Localized: "\uC815\uCC30 \uBAA8\uC9D1 \uAC70\uC810\uC5D0\uC11C \uAC08\uB9C8\uAC00
      \uBA85\uB2E8\uC744 \uD3BC\uCE5C \uCC44 \uD55C \uC790\uB9AC\uC5D0 \uC190\uAC00\uB77D\uC774
      \uBA38\uBB38\uB2E4. 30\uB144 \uC804 \uAC15\uC639\uC774 \uC801\uC740 \uD55C
      \uC904. \uADF8 \uC904 \uC606\uC5D0 \uD55C\uC0C8\uC758 \uC774\uB984\uC774 \uC0C8\uB85C
      \uC62C\uB77C\uC640 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629220
    m_Localized: "\uAC08\uB9C8\uAC00 \uBA85\uB2E8\uC744 \uB36E\uB294\uB2E4. \uB458\uC740
      \uB9D0\uC5C6\uC774 \uACE0\uAC1C\uB9CC \uC219\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629221
    m_Localized: "\uB450 \uBC1C\uC790\uAD6D\uC774 \uC7BF\uACE8 \uC5B4\uADC0\uB85C
      \uD5A5\uD55C\uB2E4. \uC5B4\uADC0 \uB108\uBA38 \u2014 \uB9C8\uC744\uC774 \uB05D\uB098\uACE0
      \uBCC0\uBC29\uBB38\uC774 \uC2DC\uC791\uB418\uAE30 \uC804, \uC791\uC740 \uD1A0\uD15C
      \uD55C \uADF8\uB8E8\uAC00 \uBCF4\uC778\uB2E4. \uD1A0\uD15C \uC606\uC5D0 \uBB34\uB9AC\uC758
      \uBC1C\uC790\uAD6D\uC774 \uBC15\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629222
    m_Localized: "\uC7BF\uACE8 \uC5B4\uADC0\uC758 \uD1A0\uD15C \uD55C \uADF8\uB8E8.
      \uC548\uAC1C \uB108\uBA38\uC5D0\uC11C \uD55C \uC0AC\uB78C\uC774 \uD1A0\uD15C
      \uC606\uC5D0\uC11C \uB098\uC628\uB2E4. \uCF54\uB97C \uB4E4\uC5B4 \uBC14\uB78C\uC744
      \uC77D\uB294\uB2E4. \uBB34\uB9AC\uC758 \uBC1C\uC790\uAD6D\uC774 \uD1A0\uD15C
      \uB4A4\uD3B8 \uD480\uBC2D\uC5D0 \uBC15\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629223
    m_Localized: "...\uC194\uB77C\uB8F8 \uC0AC\uC81C. \uBCC0\uBC29 \uC815\uCC30\uBCD1.
      \uB450 \uBC1C\uC790\uAD6D\uC774 \uAC19\uC740 \uAE38\uC5D0 \uBC15\uD78C \uAC8C
      \u2014 \uB0B4 \uD560\uC544\uBC84\uC9C0 \uB54C \uC774\uD6C4\uB85C \uCC98\uC74C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629224
    m_Localized: "\uD480\uBC2D \uB108\uBA38\uC5D0\uC11C \uBB34\uB9AC\uC758 \uD65C\uC774
      \uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uC790\uC138\uB85C \uB2E8\uB9B0\uC744 \uD5A5\uD55C\uB2E4.
      \uB2E8\uB9B0\uC758 \uC190\uC774 \uC0AC\uC81C \uC778\uC7A5 \uCABD\uC73C\uB85C
      \uAC00\uB824\uB294 \uC790\uC138\uC5D0\uC11C \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629225
    m_Localized: "\uD55C\uC0C8\uAC00 \uD654\uC0B4 \uC790\uB8E8\uB97C \uC5B4\uAE68\uC5D0\uC11C
      \uD480\uC5B4 \uD759 \uC704\uC5D0 \uB454\uB2E4. \uD770 \uB048\uC774 \uD759\uC5D0
      \uB2FF\uB294\uB2E4. \uD55C\uC0C8\uAC00 \uBE48 \uC190\uC73C\uB85C \uD55C \uBC1C
      \uC55E\uC5D0 \uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629226
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uD55C\uC0C8\uC758 \uC790\uB8E8\uB97C
      \uBCF8\uB2E4. \uD770 \uB048\uC774 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629227
    m_Localized: "...\uAC15\uC639 \uC5B4\uB978 \uC790\uB8E8\uB85C\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629228
    m_Localized: "\uBB34\uB9AC\uC758 \uD65C\uC774 \uB0B4\uB824\uAC04\uB2E4. \uB2E8\uB9B0\uC758
      \uC190\uC774 \uC0AC\uC81C \uC778\uC7A5\uC5D0\uC11C \uBA40\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629229
    m_Localized: "\uC5B4\uB9B4 \uB54C \uADF8\uBD84\uC774 \uC6B0\uB9AC \uBB34\uB9AC
      \uBAA8\uB2E5\uBD88\uC5D0 \uD55C \uBC88 \uC549\uC73C\uC168\uC5B4. \uD770 \uB048\uC744
      \uC54C\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629230
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uB2E8\uB9B0\uC744 \uBCF8\uB2E4.
      \uC0AC\uC81C\uBCF5 \uC790\uC218\uC5D0\uC11C \uC7A0\uC2DC \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629231
    m_Localized: "\uC0AC\uC81C\uB294 \uBC1B\uC9C0 \uC54A\uC73C\uB824 \uD588\uC5B4.
      \uB108\uD76C\uAC00 \uC6B0\uB9AC \uD1A0\uD15C\uC744 \uAC00\uC838\uAC04 \uAC8C
      \uD55C 80\uB144 \uB410\uACE0, \uADF8\uB3D9\uC548 \uD55C \uBC88\uB3C4 \uC0AC\uACFC
      \uC5C6\uC5C8\uC73C\uB2C8\uAE4C. \uADF8\uB7F0\uB370 \uAC15\uC639\uC758 \uD654\uC0B4\uC774
      \uAC19\uC774 \uC654\uC5B4. \uADF8\uB798\uC11C \u2014 \uBC1B\uB294\uB2E4. \uB108\uD76C\uB97C
      \uBC1B\uB294 \uAC8C \uC544\uB2C8\uC57C. \uAC15\uC639 \uC5B4\uB978\uC758 \uD770
      \uB048\uC744 \uBC1B\uB294 \uAC70\uB2E4. \uB048\uC774 \uB04A\uC5B4\uC9C0\uBA74,
      \uB098\uB3C4 \uB108\uD76C\uB97C \uC548 \uBC1B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629232
    m_Localized: "\uC0AC\uC81C \uC778\uC0AC \uB9D0\uACE0. \uB108\uB294 \uB108\uD76C
      \uC190\uC774 \uD55C \uC77C\uC744 \uD558\uB098\uB77C\uB3C4 \uC54C\uACE0 \uC654\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629233
    m_Localized: "...\uBAA8\uB985\uB2C8\uB2E4. \uC9C0\uAE08\uC740 \uADF8 \uB9D0\uBC16\uC5D0
      \uBABB \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629234
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uB2E8\uB9B0\uC744 \uB354 \uBCF8\uB2E4.
      \uCF54\uB97C \uD55C \uBC88 \uB354 \uB4E0\uB2E4. \uBB34\uB9AC\uC5D0\uAC8C \uC190\uC9D3\uD55C\uB2E4.
      \uBB34\uB9AC\uAC00 \uC870\uAE08 \uB354 \uBA40\uB9AC \uBB3C\uB7EC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629235
    m_Localized: "\uB3D9\uB9F9\uC774\uB77C \uBD80\uB974\uC9C0 \uB9C8. \uB3D9\uD589\uC774\uB77C
      \uBD80\uB974\uC790. \uB0B4 \uD615\uC81C \uD68C\uC870\uAC00 \uD55C 200\uC77C
      \uC548 \uB3CC\uC544\uC654\uC5B4. \uCF54\uB85C\uB294 \uC2DD\uC9C0 \uC54A\uC740
      \uC790\uAD6D\uC774 \uC548\uCABD\uC5D0\uC11C \uD48D\uACA8. \uAC19\uC774 \uAC00\uC11C
      \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629236
    m_Localized: "\uD55C\uC0C8\uAC00 \uD759 \uC704 \uD654\uC0B4 \uC790\uB8E8\uB97C
      \uB2E4\uC2DC \uC5B4\uAE68\uC5D0 \uAC78\uCE5C\uB2E4. \uC790\uB8E8\uC5D0\uC11C
      \uD654\uC0B4 \uD55C \uC790\uB8E8\uB97C \uBF51\uC544 \uB2E8\uB9B0\uC5D0\uAC8C
      \uAC74\uB128\uB2E4. \uD770 \uB048\uC774 \uBC14\uB78C\uC5D0 \uC9E7\uAC8C \uD754\uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629237
    m_Localized: "\uAC15\uC639 \uC5B4\uB978\uC774 \uBCF4\uB0B4\uC2E0 \uD654\uC0B4\uC785\uB2C8\uB2E4.
      \uD55C \uC790\uB8E8\uB294 \uC0AC\uC81C\uAED8, \uD55C \uC790\uB8E8\uB294 \uBB34\uB9AC
      \uC9C0\uB3C4\uC790\uAED8. \uB450 \uBD84\uC774 \uBCC0\uBC29\uBB38\uC5D0\uC11C
      \uBB34\uC5C7\uC744 \uBCF4\uB4E0 \u2014 \uAC19\uC740 \uD770 \uB048\uC744 \uB4E4\uACE0
      \uBCF4\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629238
    m_Localized: "\uD55C\uC0C8\uAC00 \uB610 \uD55C \uC790\uB8E8\uB97C \uBF51\uC544
      \uC774\uBE68\uBC14\uB78C\uC5D0\uAC8C \uAC74\uB128\uB2E4. \uC774\uBE68\uBC14\uB78C\uC774
      \uC7A0\uC2DC \uBCF8 \uB4A4 \uBC1B\uB294\uB2E4. \uD770 \uB048\uC774 \uC7BF\uACE8\uC758
      \uAC80\uC740 \uD759\uC5D0 \uB2FF\uC740 \uC790\uAD6D \uADF8\uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629239
    m_Localized: "\uBCC0\uBC29 \uC815\uCC30 \uAE38\uB4DC\uB294 \uBCC0\uBC29\uBB38
      \uC548\uCABD\uC73C\uB85C\uB294 \uBABB \uB4E4\uC5B4\uAC11\uB2C8\uB2E4. \uB9F9\uC138\uC785\uB2C8\uB2E4.
      \uB450 \uBD84\uB9CC \uAC00\uC2DC\uC624. \uB3CC\uC544\uC624\uC2DC\uBA74 \u2014
      \uBA85\uB2E8\uC5D0 \uD55C \uC904 \uB354 \uC801\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629240
    m_Localized: "\uD55C\uC0C8\uAC00 \uD55C \uBC1C \uB4A4\uB85C \uBB3C\uB7EC\uB09C\uB2E4.
      \uC7BF\uACE8 \uCABD\uC73C\uB85C. \uC774\uBE68\uBC14\uB78C\uC774 \uD55C\uC0C8\uC758
      \uC790\uC138\uB97C \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629241
    m_Localized: "...\uC815\uCC30 \uAE38\uB4DC \uB9F9\uC138\uAD70. \uC54C\uACA0\uB2E4.
      \uD55C\uC0C8, \uC7BF\uACE8\uC5D0\uC11C \uAE30\uB2E4\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629242
    m_Localized: "...\uBC1B\uACA0\uC2B5\uB2C8\uB2E4. \uAC15\uC639 \uC5B4\uB978\uAED8
      \u2014 \uBB34\uC5C7\uC744 \uBD24\uB4E0, \uB3CC\uC544\uC624\uBA74 \uC804\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629243
    m_Localized: "\uD55C\uC0C8\uAC00 \uC9E7\uAC8C \uACE0\uAC1C\uB97C \uC219\uC778\uB2E4.
      \uC7BF\uACE8 \uCABD\uC73C\uB85C \uD55C \uBC1C\uC790\uAD6D. \uB2E8\uB9B0\uACFC
      \uC774\uBE68\uBC14\uB78C\uC758 \uB450 \uBC1C\uC790\uAD6D\uC774 \uBCC0\uBC29\uBB38
      \uCABD\uC73C\uB85C \uD5A5\uD55C\uB2E4. \uB450 \uC790\uB8E8\uC758 \uD770 \uB048\uC774
      \uB450 \uC0AC\uB78C\uC758 \uB4F1 \uB4A4\uC5D0\uC11C \uBC14\uB78C\uC5D0 \uC9E7\uAC8C
      \uD754\uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629244
    m_Localized: "\uBCC0\uBC29\uBB38 \uC55E. \uAE4C\uB9C8\uADC0 \uD55C \uB9C8\uB9AC\uAC00
      \uCCA0 \uD30C\uD3B8 \uC704\uC5D0 \uC549\uC544 \uC788\uB2E4. \uCCAB \uC0C8\uBCBD\uC5D0\uC11C
      \uBCF8 \uAE4C\uB9C8\uADC0\uC640 \uAC19\uC740 \uC790\uC138. \uB450 \uC0AC\uB78C\uBFD0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629245
    m_Localized: "\uB2E8\uB9B0\uC774 \uC0AC\uC81C\uBCF5 \uC790\uC218 \uB05D\uC5D0
      \uC190\uC744 \uB304\uB2E4. \uBB35\uC8FC \uCCAB \uC54C\uC774 \uC548\uC8FC\uBA38\uB2C8\uC5D0\uC11C
      \uD55C \uBC88 \uB9CC\uC838\uC9C4\uB2E4. \uC5B4\uBA38\uB2C8\uAC00 \uB9C8\uC9C0\uB9C9\uC5D0
      \uC9DA\uC73C\uC168\uB358 \uC790\uB9AC. \uC778\uC7A5\uC740 \uB9CC\uC9C0\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629246
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uCF54\uB97C \uB4E0\uB2E4. \uBCC0\uBC29\uBB38
      \uB108\uBA38\uC758 \uB0C4\uC0C8\uAC00 \uD3C9\uC18C\uC758 \uB0C4\uC0C8\uAC00
      \uC544\uB2C8\uB2E4. \uD615\uC81C\uC758 \uB0C4\uC0C8\uAC00 \uC5F7\uAC8C \uC11E\uC5EC
      \uC788\uB2E4. \uC2DD\uC740 \uC7AC\uCC98\uB7FC \uB0AE\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629247
    m_Localized: "\uB2E8\uB9B0\uC774 \uD759\uC744 \uBCF8\uB2E4. \uBC1C\uC790\uAD6D
      \uD55C \uC0AC\uB78C \uBD84\uB7C9. \uADF8\uB7EC\uB098 \uBB34\uAC8C\uAC00 \uB450
      \uBC88 \uCC0D\uD600 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629248
    m_Localized: "...\uD55C \uC0AC\uB78C\uC774 \uB4E4\uC5B4\uAC14\uB294\uB370. \uB450
      \uC0AC\uB78C\uC774 \uB098\uC628 \uC790\uAD6D\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629249
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uB2E8\uB9B0\uC758 \uC2DC\uC120\uC744
      \uB530\uB77C\uAC04\uB2E4. \uB2E8\uB9B0\uC758 \uC190\uAC00\uB77D\uC774 \uC790\uC218
      \uB05D\uC5D0\uC11C \uD55C \uBC88 \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629250
    m_Localized: "...\uB4E4\uC5B4\uAC04 \uAC8C \uC0AC\uB78C\uB9CC\uC774 \uC544\uB2C8\uC5C8\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629251
    m_Localized: "\uB450 \uC790\uB8E8\uC758 \uD770 \uB048\uC774 \uB450 \uC0AC\uB78C\uC758
      \uB4F1 \uB4A4\uC5D0\uC11C \uC7A0\uC2DC \uB354 \uD754\uB4E4\uB9B0\uB2E4. \uC7BF\uACE8\uC758
      \uAC80\uC740 \uD759\uC774 \uB048\uC5D0 \uBB3B\uC740 \uC790\uAD6D \uADF8\uB300\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629252
    m_Localized: "(\uC7AC\uAC00 \uD654\uBA74\uC744 \uB36E\uACE0, \uAC19\uC740 \uBB38\uD131\uC758
      \uC0C8\uBCBD\uC73C\uB85C \uB118\uC5B4\uAC04\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629253
    m_Localized: "\uC57C\uC601\uC9C0\uC758 \uC5B4\uB450\uC6B4 \uC790\uB9AC. \uBAA8\uB2E5\uBD88
      \uBE5B\uC774 \uBC29\uC9C4\uC758 \uD3F4\uC554 \uB05D \uC791\uC740 \uC218\uC815
      inset\uC5D0 \uC7A0\uC2DC \uBA38\uBB38\uB2E4. \uC815\uC218\uB9AC\uC758 \uC758\uB840
      \uB9E4\uB4ED\uC774 \uB2E8\uB2E8\uD788 \uBB36\uC5EC \uC788\uB2E4. \uC190\uB4F1\uC758
      4 \uB9E4\uB4ED \uD45C\uC2DD \uC911 \u2014 4\uBC88\uC9F8 \uC790\uB9AC\uB294
      \uC0AC\uB77C\uC9C4 \uC790\uAD6D\uC774 \uC605\uAC8C \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629254
    m_Localized: "\uBC29\uC9C4\uC774 \uD3F4\uC554\uC744 \uB4E4\uC5B4 \uD759\uBC14\uB2E5\uC5D0
      \uACA9\uC790 \uBB38\uC591\uC744 \uD55C \uC904 \uADF8\uC5B4 \uBCF4\uC778\uB2E4.
      \uCE60\uB3C4 \uC789\uD06C\uB3C4 \uC544\uB2CC \u2014 \uC190\uBAA9\uACFC \uD3F4\uC554\uC758
      \uBB34\uAC8C\uB85C\uB9CC. \uD759 \uC704\uC5D0 \uC595\uC740 \uC790\uAD6D\uC774
      \uB0A8\uB294\uB2E4. \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C \uC218
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629255
    m_Localized: "\uBC29\uC9C4\uC774 \uD3F4\uC554\uC73C\uB85C \uACA9\uC790 \uBB38\uC591
      \uD55C \uC904\uC744 \uCD94\uAC00\uB85C \uADF8\uB9B0\uB2E4. \uB450 \uBC88\uC9F8
      \uC904\uC774 \uCCAB \uBC88\uC9F8 \uC904\uACFC \uAC19\uC740 \uAE38\uC774\uB85C
      \uD3C9\uD589\uD558\uAC8C \uB193\uC778\uB2E4. \uCCAB \uBC88\uC9F8 \uC904\uACFC
      \uB450 \uBC88\uC9F8 \uC904 \uC0AC\uC774\uC5D0 \uC791\uC740 \uCE78 \uD558\uB098\uAC00
      \uB9CC\uB4E4\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629256
    m_Localized: "\uBC29\uC9C4\uC774 \uC190\uB4F1\uC758 4 \uB9E4\uB4ED \uD45C\uC2DD
      \uC911 \u2014 \uC0AC\uB77C\uC9C4 4\uBC88\uC9F8 \uC790\uB9AC\uB97C \uC190\uAC00\uB77D\uC73C\uB85C
      \uD55C \uBC88 \uC9DA\uB294\uB2E4. \uADF8 \uD6C4 \uD759 \uC704 \uACA9\uC790\uC758
      \uBE48 \uCE78\uC744 \uAC00\uB9AC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629257
    m_Localized: "...\uC57D\uC18D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629258
    m_Localized: "\uBC29\uC9C4\uC774 \uD3F4\uC554\uC744 \uB2E4\uC2DC \uC606\uC5D0
      \uB454\uB2E4. \uD759 \uC704 \uB450 \uC904\uC758 \uACA9\uC790\uAC00 \uBAA8\uB2E5\uBD88
      \uBE5B \uC544\uB798 \uADF8\uB300\uB85C \uB0A8\uB294\uB2E4. \uC791\uC740 \uCE78
      \uC548\uC5D0 \uBAA8\uB2E5\uBD88\uC758 \uBE5B\uC774 \uC7A0\uC2DC \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629259
    m_Localized: "\uBC29\uC9C4\uC774 \uD3F4\uC554\uC744 \uB4E4\uC5B4 \uD55C \uBC88
      \uB354 \uACA9\uC790 \uBB38\uC591 \uD55C \uC904\uC744 \uADF8\uB9B0\uB2E4. \uADF8
      \uC904\uC774 \uB2E4\uB978 \uC904\uB4E4\uACFC \uD55C \uC790\uB9AC\uC5D0\uC11C
      \uB9CC\uB098 \uACA9\uC790\uAC00 \uB2EB\uD78C\uB2E4. \uC57D\uC18D\uC758 \uACA9\uC790\uAC00
      \uC644\uC131\uB41C\uB2E4. \uACA9\uC790 \uC548\uC5D0 \uBAA8\uB2E5\uBD88 \uBE5B\uC774
      \uC7A0\uC2DC \uB354 \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629260
    m_Localized: "...\uC57D\uC18D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629261
    m_Localized: "\uBC29\uC9C4\uC774 \uD3F4\uC554\uC744 \uC606\uC5D0 \uB450\uACE0
      \uC9E7\uAC8C \uACE0\uAC1C\uB97C \uC219\uC778\uB2E4. \uC815\uC218\uB9AC\uC758
      \uC758\uB840 \uB9E4\uB4ED\uC774 \uB2E4\uC2DC \uB2E8\uB2E8\uD574\uC9C4\uB2E4
      \u2014 \uADF8\uB7EC\uB098 \uC7A0\uAE50 \uD480\uB824 \uC788\uB358 \uC790\uAD6D\uC774
      \uB0A8\uB294\uB2E4. \uD759 \uC704 \uACA9\uC790 \uBB34\uB2AC\uAC00 \uBAA8\uB2E5\uBD88\uC758
      \uB9C8\uC9C0\uB9C9 \uBE5B\uC5D0 \uD55C \uBC88 \uD754\uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629262
    m_Localized: "\uBB18\uC5ED \uC785\uAD6C \uAC70\uC810. \uC778\uAD11 \uC774\uB07C\uAC00
      \uCCAD\uB85D\uC73C\uB85C \uAE5C\uBE61\uC774\uB294 \uC790\uB9AC. \uBB18\uC9C1\uC774
      \uB9DD\uCE58\uB97C \uC606 \uBC14\uB2E5\uC5D0 \uB454\uB2E4. \uBB34\uAC8C\uC74C\uC774
      \uB0AE\uAC8C \uB0A8\uB294\uB2E4. \uAC11\uC8FC\uC758 \uB124 \uC790\uC218\uB97C
      \uC190\uAC00\uB77D\uC73C\uB85C \uD6D1\uB294\uB2E4. \uB124 \uBC88\uC9F8 \uC774\uB984
      \uC704\uC5D0\uC11C \uC870\uAE08 \uB354 \uBA38\uBB38\uB2E4 \u2014 \uAC00\uC7A5
      \uCD5C\uADFC\uC5D0 \uC0C8\uAE34 \uC790\uC218. \uB2E4\uC12F \uBC88\uC9F8 \uC790\uB9AC\uB294
      \uBE44\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629263
    m_Localized: "...\uC5EC\uAE30 \uC7A0\uB4E0 \uC790\uB3C4 \uD55C\uB54C \uC0AC\uC81C\uC600\uC2B5\uB2C8\uB2E4,
      \uC0AC\uC81C\uB2D8."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629264
    m_Localized: "\uBB18\uC9C1\uC774 \uC790\uC218\uC5D0\uC11C \uC190\uC744 \uB5C0\uB2E4.
      \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629265
    m_Localized: "\uBB18\uC9C1\uC774 \uB9DD\uCE58\uB97C \uBC14\uB2E5\uC5D0 \uB454\uB2E4.
      \uBB34\uAC8C\uC74C\uC774 \uB0AE\uAC8C \uB0A8\uACE0, \uC778\uAD11 \uC774\uB07C\uAC00
      \uADF8 \uC6B8\uB9BC\uC5D0 \uB9DE\uCDB0 \uAE5C\uBE61\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629266
    m_Localized: "...\uD638\uC704\uC785\uB2C8\uB2E4. \uB2E8\uC8C4\uAC00 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629267
    m_Localized: "\uD751\uC9C0\uB294 \uC774\uB984\uC744 \uBC16\uC73C\uB85C \uC138\uC6C1\uB2C8\uB2E4.
      \uC800\uB294 \uC774\uB984\uC744 \uC11D\uAD00 \uC548\uC5D0\uC11C \uC9C0\uD0B5\uB2C8\uB2E4.
      \uB458 \uB2E4 \uBB34\uAC81\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uC11C \uC11C\uB85C\uB97C
      \uBABB \uBC00\uC5B4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629268
    m_Localized: "\uBB18\uC9C1\uC774 \uB9DD\uCE58\uB97C \uB4E4\uC5B4 \uB2E4\uC2DC
      \uC606 \uBC14\uB2E5\uC5D0 \uB454\uB2E4. \uBB34\uAC8C\uC74C\uC774 \uB0AE\uAC8C
      \uB0A8\uB294\uB2E4. \uAC11\uC8FC\uC758 \uB124 \uC790\uC218\uC5D0 \uC190\uAC00\uB77D\uC774
      \uB2E4\uC2DC \uBA38\uBB38\uB2E4 \u2014 \uB124 \uBC88\uC9F8 \uC774\uB984 \uC704\uC5D0\uC11C
      \uC7A0\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629269
    m_Localized: "...\uBB38\uC740 \uB2EB\uC544 \uB450\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uB984\uC774
      \uD63C\uC790 \uB0A8\uC9C0 \uC54A\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629270
    m_Localized: "\uC778\uAD11 \uC774\uB07C\uAC00 \uBB18\uC5ED \uC548\uCABD\uC5D0\uC11C
      \uD55C \uC904 \uAE38\uAC8C \uAE5C\uBE61\uC778\uB2E4 \u2014 \uB124 \uBC88\uC9F8
      \uC790\uC218\uC758 \uC774\uB984\uC774 \uC7A0\uB4E0 \uC790\uB9AC\uC5D0\uC11C.
      \uBB18\uC9C1\uC774 \uC77C\uC5B4\uC120\uB2E4. \uB9DD\uCE58\uB97C \uB2E4\uC2DC
      \uB4E0\uB2E4. \uB2E4\uC12F \uBC88\uC9F8 \uC790\uC218 \uC790\uB9AC\uB294 \uC5EC\uC804\uD788
      \uBE44\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629271
    m_Localized: "\uBAA8\uB2E5\uBD88\uC5D0\uC11C \uB098\uC628 \uC5F0\uAE30\uAC00
      \uCC9C\uB9C9 \uCC9C\uC7A5\uC5D0 \uD55C \uC904\uB85C \uBAA8\uC778\uB2E4. \uB2E8\uB9B0\uC774
      \uADF8 \uC5F0\uAE30\uB97C \uBCF8\uB2E4. \uC190\uAC00\uB77D\uC740 \uC0AC\uC81C\uBCF5
      \uC790\uC218 \uB05D\uC744 \uB530\uB77C\uAC00\uACE0 \uC788\uB2E4 \u2014 \uC5B4\uBA38\uB2C8\uAC00
      \uB9C8\uC9C0\uB9C9\uC5D0 \uC9DA\uC73C\uC168\uB358 \uC790\uB9AC. \uC778\uC7A5\uC740
      \uB9CC\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629272
    m_Localized: "...\uC624\uB298 \uCCAB \uC54C\uC5D0\uC11C \uBB34\uC5C7\uC744 \uC678\uC6CC\uC57C
      \uD558\uB294\uC9C0, \uB610 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629273
    m_Localized: "\uBB35\uC8FC\uAC00 \uBB34\uB98E \uC704\uC5D0 \uC62C\uB77C\uC640
      \uC788\uB2E4. \uCCAB \uC54C\uC774 \uC190\uAC00\uB77D \uB05D\uC5D0\uC11C \uC7A0\uAE50
      \uBA48\uCD98\uB2E4. \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C \uC218
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629274
    m_Localized: "...\uC544\uB2D9\uB2C8\uB2E4. \uC544\uB2C8, \uADF8\uAC8C... \uB2E8\uD604
      \uD559\uC124\uC774 \uADF8 \uC54C\uC744 \uB2E4\uC2DC \uB9E4\uACBC\uC2B5\uB2C8\uB2E4.
      \uC800\uB3C4 \uD55C \uBC88 \uB9E4\uAE34 \uC0AC\uB78C\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629275
    m_Localized: "\uC5B4\uBA38\uB2C8\uAC00 \uADF8\uAC78 \uBCF4\uC168\uB2E4\uBA74
      \u2014 \uBB35\uC8FC\uB97C \uD55C \uBC88 \uBD80\uC234 \uB193\uACE0 \uAC00\uC168\uACA0\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629276
    m_Localized: "\uB2E8\uB9B0\uC774 \uBB35\uC8FC \uCCAB \uC54C\uC744 \uC190\uAC00\uB77D
      \uB05D\uC5D0\uC11C \uB193\uB294\uB2E4. \uB450 \uBC88\uC9F8 \uC54C\uC740 \uC7A1\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629277
    m_Localized: "\uC5F0\uAE30\uAC00 \uCC9C\uB9C9 \uBC16\uC73C\uB85C \uBE60\uC838\uB098\uAC04\uB2E4.
      \uBAA8\uB2E5\uBD88\uC5D0\uC11C \uD55C \uBC88 \uB354 \uC0C8 \uC5F0\uAE30\uAC00
      \uC62C\uB77C\uC628\uB2E4. \uB2E8\uB9B0\uC774 \uBB35\uC8FC\uB97C \uBB34\uB98E
      \uC704\uC5D0 \uB2E4\uC2DC \uB454\uB2E4. \uC790\uC218\uC5D0 \uC190\uAC00\uB77D\uC740
      \uB2FF\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629278
    m_Localized: "\uAE30\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4 \u2014 \uC774 \uC758\uBB38
      \uC790\uCCB4\uB97C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629279
    m_Localized: "\uB2E8\uB9B0\uC774 \uCC9C\uB9C9 \uC785\uAD6C\uB97C \uBCF8\uB2E4.
      \uC77C\uC5B4\uC11C\uC9C0 \uC54A\uB294\uB2E4. \uBB35\uC8FC\uAC00 \uC190\uBAA9
      \uC548\uCABD\uC5D0 \uD55C \uBC88 \uB2FF\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629280
    m_Localized: "\uC57C\uC601\uC9C0 \uCC9C\uB9C9 \uC548. \uBAA8\uB2E5\uBD88 \uBE5B\uC774
      \uB4E4\uC5B4\uC640 \uC0AC\uC81C\uBCF5 \uC790\uC218\uC5D0 \uBA38\uBB38\uB2E4.
      \uB2E8\uB9B0\uC774 \uC778\uC7A5\uC744 \uC790\uC218 \uC704\uC5D0 \uC62C\uB824\uB193\uB294\uB2E4.
      \uB450 \uBC31\uAE08\uC774 \uAC19\uC740 \uBC1D\uAE30\uB85C \uBE5B\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629281
    m_Localized: "...\uC790\uB9E4 \uD55C \uBD84\uC744 \uBCF8 \uC801 \uC788\uC5B4\uC694.
      \uAC19\uC740 \uC0AC\uC81C\uBCF5\uC744 \uC785\uACE0 \uAC19\uC740 \uC74C\uC131\uC744
      \uB4E3\uB294\uB2E4 \uD588\uB294\uB370, \uC81C\uAC00 \uB354 \uC774\uC0C1 \uB4E4\uC744
      \uC218 \uC5C6\uB294 \uC74C\uC131\uC774\uC5C8\uC5B4\uC694. \uB2F9\uC2E0\uC774\uB77C\uBA74,
      \uADF8 \uC55E\uC5D0\uC11C \uBB34\uC5C7\uC744 \uBD99\uC7A1\uC558\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629282
    m_Localized: "\uB2E8\uB9B0\uC774 \uC778\uC7A5\uC5D0\uC11C \uC190\uAC00\uB77D\uC744
      \uB5BC\uC9C0 \uC54A\uB294\uB2E4. \uC790\uC218\uB9CC \uD55C \uBC88 \uB354 \uB530\uB77C\uAC04\uB2E4.
      \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629283
    m_Localized: "...\uC9C4\uC9DC\uC600\uB294\uC9C0 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4.
      \uB2E4\uB9CC \uC5B4\uBA38\uB2C8\uAED8 \uAC19\uC740 \uC74C\uC131\uC744 \uB4E4\uB824\uB4DC\uB9B0
      \uC801\uC740 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629284
    m_Localized: "\uADF8\uAC8C \uD559\uC124\uC774\uC5C8\uB2E4\uBA74 \u2014 \uC5B4\uBA38\uB2C8\uAED8\uB3C4
      \uD559\uC124\uC774 \uB4E4\uB838\uB098. \uADF8\uAC8C \uB354 \uBB34\uAC81\uB124\uC694.
      \uADF8 \uC74C\uC131\uC744 \uB354 \uC774\uC0C1 \uB4E4\uC744 \uC218 \uC5C6\uB294
      \uC0AC\uB78C\uB3C4 \uC788\uB2E4\uACE0, \uD55C \uBC88 \uB9D0\uD574 \uBCF4\uACE0
      \uC2F6\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629285
    m_Localized: "\uC778\uC7A5\uC774 \uC790\uC218 \uC704\uC5D0\uC11C \uB2E4\uC2DC
      \uD55C \uBC88 \uBBF8\uB044\uB7EC\uC9C4\uB2E4. \uC774\uBC88\uC5D0\uB294 \uBB34\uB98E\uC73C\uB85C
      \uB5A8\uC5B4\uC9C4\uB2E4. \uB2E8\uB9B0\uC774 \uC90D\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629286
    m_Localized: "\uC0AC\uC81C\uB85C\uC11C\uAC00 \uC544\uB2C8\uB77C \uD55C \uC0AC\uB78C\uC73C\uB85C
      \uC774 \uC55E\uC5D0 \uC11C\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629287
    m_Localized: "\uB2E8\uB9B0\uC774 \uC77C\uC5B4\uC120\uB2E4. \uC778\uC7A5\uC740
      \uBB34\uB98E\uC5D0\uC11C \uAD74\uB7EC \uCC9C\uB9C9 \uBC14\uB2E5\uC5D0 \uB2FF\uB294\uB2E4.
      \uB2E8\uB9B0\uC774 \uCC9C\uB9C9 \uC785\uAD6C\uB97C \uD5A5\uD574 \uD55C \uBC1C
      \uB0B4\uB51B\uB294\uB2E4. \uC778\uC7A5\uC740 \uB530\uB77C\uC624\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629288
    m_Localized: "\uC0C8\uBCBD. \uCC45\uC0C1 \uC55E \uC791\uC740 \uB4F1\uBD88 \uD558\uB098.
      \uC778\uC7A5\uC774 \uADF8 \uC606\uC5D0 \uD480\uB9B0 \uCC44 \uB193\uC5EC \uC788\uB2E4.
      \uB2E8\uB9B0\uC774 \uBB35\uC8FC\uB97C \uC190\uC5D0 \uC950\uACE0 \uC788\uB2E4.
      \uCCAB \uC54C\uC744 \uC190\uAC00\uB77D \uB05D\uC5D0 \uC7A1\uB294\uB2E4. \uC785\uC220\uC774
      \uC6C0\uC9C1\uC774\uB824\uB2E4 \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629289
    m_Localized: "\uC624\uB298 \uC544\uCE68\uC5D0\uB3C4 \uAE68\uC5B4\uB098\uBA70
      \uCCAB \uAD6C\uC808\uC774 \uC785\uAC00\uC5D0 \uBA38\uBB3C\uB800\uC5B4\uC694.
      \uC678\uC6B0\uC9C0 \uC54A\uC740 \uCCAB \uAD6C\uC808\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629290
    m_Localized: "\uB2E8\uB9B0\uC758 \uC2DC\uC120\uC774 \uC0AC\uC6A9\uC790 \uCABD\uC73C\uB85C
      \uC62E\uACA8 \uC628\uB2E4. \uADF8\uB7EC\uB098 \uC0AC\uC6A9\uC790\uC5D0\uAC8C
      \uBB34\uC5C7\uC744 \uBB3B\uC9C0 \uC54A\uB294\uB2E4. \uB4E3\uB294 \uC790\uC138\uB97C
      \uAD8C\uD558\uC9C0\uB3C4 \uC54A\uB294\uB2E4. \uC0AC\uC6A9\uC790\uB294 \uADF8\uC800
      \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629291
    m_Localized: "\uB2E8\uB9B0\uC774 \uBB35\uC8FC \uCCAB \uC54C\uC744 \uC190\uAC00\uB77D
      \uB05D\uC5D0 \uC7A1\uB294\uB2E4. \uC7A0\uC2DC \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629292
    m_Localized: "...\uBE48 \uC790\uB9AC\uC5D0 \uC788\uB358 \uC774\uB984\uB4E4\uC5D0\uAC8C.
      \uC5B4\uBA38\uB2C8\uAED8. \uADF8\uB9AC\uACE0 \uB2E8\uD604 \uD559\uC124\uC774
      \uC9C0\uC6B4 \uC790\uB9AC\uC5D0. \uD55C \uC54C\uC529 \uD55C \uBC88 \uC678\uC6B0\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629293
    m_Localized: "\uC678\uC6B0\uC9C0 \uC54A\uB294\uB2E4. \uBB35\uC8FC\uB9CC \uD55C
      \uBC88 \uB354 \uB530\uB77C \uADF8\uB9B0\uB2E4. \uC785\uC220\uC774 \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uB294\uB2E4. \uCCAB \uAD6C\uC808\uC740 \uC785\uAC00\uC5D0 \uBA38\uBB3C\uB7EC
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629294
    m_Localized: "\uAE30\uB3C4\uBB38\uC5D0 \uC5B4\uBA38\uB2C8\uC758 \uC774\uB984\uC744
      \uC801\uC740 \uC801 \uC5C6\uC5B4\uC694. \uC0AC\uC81C\uAC00 \uAC00\uC871 \uC774\uB984\uC744
      \uC801\uC9C0 \uC54A\uC73C\uB2C8\uAE4C\uC694. \uADF8\uB7F0\uB370 \uC678\uC6B0\uC9C0
      \uC54A\uC740 \uCCAB \uAD6C\uC808 \uC548\uC5D0 \u2014 \uC5B4\uBA38\uB2C8\uC758
      \uC774\uB984\uC774 \uD55C \uBC88 \uB4E4\uB838\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629295
    m_Localized: "\uBB35\uD5A5\uC774 \uBCF4\uB0B4\uC2E0 \uD55C \uC870\uAC01\uC758
      \uAE30\uC5B5\uC774, \uC5B4\uBA38\uB2C8\uC758 \uC774\uB984\uACFC \uAC19\uC740
      \uC790\uB9AC\uC5D0 \uC788\uC5B4\uC694. \uC0AC\uC81C\uB3C4 \uC0AC\uB78C\uC774
      \uB418\uACE0, \uC783\uC5B4\uBC84\uB9B0 \uC774\uB984\uB4E4\uB3C4 \uD55C \uC790\uB9AC\uC5D0
      \uBAA8\uC774\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629296
    m_Localized: "\uC0C8\uBCBD\uC774 \uCC3D\uBB38 \uB108\uBA38\uC5D0\uC11C \uD55C
      \uBC88 \uAE38\uAC8C \uBE44\uCD98\uB2E4. \uB2E8\uB9B0\uC774 \uBB35\uC8FC\uB97C
      \uCC45\uC0C1 \uC704\uC5D0 \uB454\uB2E4. \uC778\uC7A5 \uC606\uC5D0. \uB450 \uAC00\uC9C0\uAC00
      \uAC19\uC740 \uBC1D\uAE30\uB85C \uBE5B\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629297
    m_Localized: "...\uC5B4\uBA38\uB2C8\uAED8 \uBCF4\uB0B4\uB4DC\uB9B4 \uC218 \uC788\uC744
      \uAC83 \uAC19\uC544\uC694. \uC0AC\uC81C\uC758 \uB9D0\uC774 \uC544\uB2C8\uB77C,
      \uC81C \uC774\uB984\uC73C\uB85C. \uC778\uC7A5 \uC5C6\uC774\uB3C4 \uD2C0\uB9AC\uC9C0
      \uC54A\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629298
    m_Localized: "\uAE30\uB3C4\uAC00 \uC870\uC6A9\uD574\uC9C4 \uB4A4\uC5D0\uB3C4,
      \uBB3B\uB294 \uC77C\uC740 \uB0A8\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629299
    m_Localized: "\uB2E8\uB9B0\uC774 \uC77C\uC5B4\uC120\uB2E4. \uBB35\uC8FC\uB294
      \uCC45\uC0C1 \uC704\uC5D0. \uC778\uC7A5\uC740 \uCC45\uC0C1 \uC704\uC5D0. \uC790\uC218\uB9CC
      \uC0AC\uC81C\uBCF5\uC5D0 \uB0A8\uB294\uB2E4. \uB2E8\uB9B0\uC774 \uBB38 \uBC16\uC73C\uB85C
      \uB098\uAC04\uB2E4. \uB4F1\uBD88\uC774 \uCC45\uC0C1 \uC704\uC5D0 \uC7A0\uC2DC
      \uB354 \uBE5B\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629300
    m_Localized: "\uC57C\uC601\uC9C0\uC758 \uC5B4\uB450\uC6B4 \uC790\uB9AC. \uB0C9\uC2DC\uAC00
      \uD65C\uC744 \uBB34\uB98E \uC704\uC5D0 \uB450\uACE0 \uC788\uB2E4. \uD65C\uC2DC\uC704\uC5D0
      \uBB36\uC778 \uC778\uAD11 \uB179\uC0C9 \uB9E4\uB4ED \uD55C \uC790\uB9AC\uC5D0
      \uC190\uAC00\uB77D\uC774 \uC7A0\uC2DC \uB354 \uBA38\uBB38\uB2E4 \u2014 90\uB144
      \uC804 \uC785\uD68C \uC2DC \uC190\uC218 \uBB36\uC740 \uB9E4\uB4ED. \uC0AC\uACA9
      \uD6C4 \uC790\uAE30 \uC190\uC744 \uD55C \uBC88 \uBCF8\uB2E4. \uC190\uC774 \uB5A8\uB9AC\uC9C0
      \uC54A\uB294\uB2E4. \uADF8\uB798\uC11C \u2014 \uD55C \uBC88 \uB354 \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629301
    m_Localized: "...\uC3D8\uAE30 \uC804\uC5D0 \uC815\uD655\uD788 \uC555\uB2C8\uB2E4.
      \uADF8\uB7EC\uB2C8\uAE4C \uC3DC \uB2E4\uC74C\uC5D0 \uC758\uC2EC\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629302
    m_Localized: "\uB0C9\uC2DC\uAC00 \uD65C\uC2DC\uC704\uC5D0\uC11C \uC190\uC744
      \uB5C0\uB2E4. \uC2DC\uC120\uC774 \uC790\uAE30 \uC190\uBC14\uB2E5\uC5D0 \uC7A0\uC2DC
      \uBA38\uBB38\uB2E4. \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C \uC218
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629303
    m_Localized: "\uB0C9\uC2DC\uAC00 \uC790\uAE30 \uC190\uC744 \uD55C \uBC88 \uBCF8\uB2E4.
      \uC190\uC774 \uB5A8\uB9AC\uC9C0 \uC54A\uB294\uB2E4. \uCE68\uBB35\uC774 \uAE38\uC5B4\uC9C4\uB2E4.
      \uC778\uAD11 \uB179\uC0C9 \uB9E4\uB4ED\uC774 \uD55C \uBC88 \uC791\uAC8C \uBE5B\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629304
    m_Localized: "...\uC815\uC0C1\uC758 \uC815\uC758\uB97C \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629305
    m_Localized: "90\uB144 \uC804\uC5D0 \uC78A\uC5C8\uC2B5\uB2C8\uB2E4. \uBCF8\uBA85\uB3C4
      \uADF8\uB54C \uC78A\uC5C8\uC2B5\uB2C8\uB2E4. \uBCF8\uBA85\uC744 \uC78A\uC740
      \uAC83\uACFC \uAC10\uC815\uC744 \uBD80\uB974\uB294 \uB9D0\uC744 \uC78A\uC740
      \uAC83\uC774 \uAC19\uC740 \uB0A0 \uC77C\uC5B4\uB0AC\uB294\uC9C0, \uB530\uB85C
      \uC77C\uC5B4\uB0AC\uB294\uC9C0 \u2014 \uBCF8\uC778\uB3C4 \uAD6C\uBD84\uC774
      \uC548 \uB429\uB2C8\uB2E4. \uC0AC\uAC70\uB9AC \uCE21\uC815\uC740 \uC815\uD655\uD569\uB2C8\uB2E4.
      \uADF8\uAC8C \uB2F5\uC774\uB77C\uBA74 \uB2F5\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629306
    m_Localized: "\uB0C9\uC2DC\uAC00 \uD65C\uC744 \uC606\uC5D0 \uB454\uB2E4. \uD65C\uC2DC\uC704\uC758
      \uC778\uAD11 \uB179\uC0C9\uC774 \uC7A0\uC2DC \uB354 \uBA38\uBB38\uB2E4. \uC190\uC774
      \uB5A8\uB9AC\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB7EC\uB098 \uC190\uAC00\uB77D
      \uB05D\uC758 \uC778\uAD11 \uAC00\uB8E8\uB294 \uC7A0\uC2DC \uB354 \uBA38\uBB34\uB978\uB2E4
      \u2014 \uD3C9\uC18C\uC758 \uC815\uC0C1 \uC808\uCC28\uC5D0\uB294 \uC5C6\uB294
      \uD754\uC801."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629307
    m_Localized: "...\uC815\uC0C1\uC785\uB2C8\uB2E4. \uBCF8\uC778\uC5D0\uAC8C\uB3C4
      \uB4E4\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629308
    m_Localized: "\uB0C9\uC2DC\uAC00 \uC790\uAE30 \uC190\uBC14\uB2E5\uC744 \uD55C
      \uBC88 \uB354 \uBCF8\uB2E4. \uC870\uAE08 \uAE38\uAC8C. \uC190\uBC14\uB2E5\uC5D0
      \uBB3B\uC740 \uC778\uAD11 \uAC00\uB8E8\uAC00 \uD55C \uBC88 \uB354 \uBE5B\uB09C\uB2E4.
      \uC544\uC9C1 \uB5A8\uB9BC\uC740 \uC544\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uC190\uC740
      \uB3CC\uC544\uAC08 \uC790\uB9AC\uB97C \uBA3C\uC800 \uC54C\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629309
    m_Localized: "\uBAA8\uB2E5\uBD88\uC5D0\uC11C \uD55C \uBC1C \uB5A8\uC5B4\uC9C4
      \uC790\uB9AC. \uACF5\uD55C\uC774 \uC190\uBC14\uB2E5\uC744 \uD55C \uBC88 \uBCF8\uB2E4.
      \uBAA8\uB2E5\uBD88 \uBE5B\uC774 \uC190\uB4F1\uC758 \uACA9\uC790 \uBB38\uC591
      \uC704\uC5D0\uC11C \uC7A0\uC2DC \uBA38\uBB38\uB2E4. 1800\uB144 \uC7A0\uC5D0\uC11C
      \uAE68\uC5B4\uB09C \uC190\uC774 \uC0C8 \uB9D0\uC744 \uD55C \uB2E8\uC5B4\uC529
      \uBC1B\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629310
    m_Localized: "...\uC624\uB79C\uB9CC\uC5D0 \uBCF8\uB2E4. \uBC16\uC758 \uB9D0\uC744.
      \uD55C \uB2E8\uC5B4\uC529 \uBC30\uC6B4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629311
    m_Localized: "\uACF5\uD55C\uC774 \uC190\uBC14\uB2E5\uC744 \uD55C \uBC88 \uB354
      \uBCF8\uB2E4. \uBD88\uBE5B\uC774 \uC190\uAE08 \uC704\uC5D0\uC11C \uB04A\uAE34\uB2E4.
      \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629312
    m_Localized: "\uACF5\uD55C\uC774 \uD55C \uBC88 \uAE4A\uC740 \uD638\uD761\uC744
      \uD55C\uB2E4. \uC190\uB4F1\uC758 \uACA9\uC790 \uBB38\uC591\uC5D0\uC11C \uC190\uAC00\uB77D\uC774
      \uD55C \uC790\uB9AC\uC5D0 \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629313
    m_Localized: "...\uB098\uB2E4. \uC2DC\uC870 \uBCF8\uC778\uC774 \uC790\uAE30 \uC57D\uC18D\uC744
      \uAE6C\uB2E4. \uD6C4\uACC4\uAC00 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629314
    m_Localized: "...\uADF8\uB798\uC11C \uB354 \uBB34\uAC81\uB2E4. \uD55C \uB2E8\uC5B4\uB97C
      \uBC16\uC5D0 \uC62E\uAE30\uB294 \uAC74 \u2014 \uADF8 \uB2E8\uC5B4\uAC00 1800\uB144
      \uB3D9\uC548 \uB9E4\uC5EC \uC788\uB358 \uB9E4\uB4ED\uC744 \uD55C \uBC88 \uD480\uC5B4
      \uBCF8\uB2E4\uB294 \uAC70\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629315
    m_Localized: "\uBAA8\uB2E5\uBD88\uC5D0\uC11C \uC791\uC740 \uB3CC \uD55C \uC870\uAC01\uC774
      \uBE5B\uC5D0 \uB5A8\uC5B4\uC9C4\uB2E4. \uACF5\uD55C\uC774 \uADF8 \uB3CC\uC744
      \uC190\uBC14\uB2E5\uC5D0 \uBC1B\uB294\uB2E4. 1800\uB144 \uC804 \uBD09\uC778\uC758
      \uB9E4\uB4ED\uC5D0 \uBB3B\uC740 \uB3CC\uACFC \uAC19\uC740 \uC0C9. \uC190\uBC14\uB2E5\uC5D0\uC11C
      \uC2DD\uC5B4 \uAC00\uB294 \uB3CC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629316
    m_Localized: "...\uD55C \uB9E4\uB4ED\uC740 \uB2E4\uC74C \uB9E4\uB4ED\uC744 \uC704\uD574
      \uBB36\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629317
    m_Localized: "\uACF5\uD55C\uC774 \uB3CC\uC744 \uD759\uC5D0 \uB2E4\uC2DC \uB454\uB2E4.
      \uC190\uBC14\uB2E5\uC758 \uACA9\uC790 \uBB38\uC591\uC740 \uB3CC\uC758 \uC790\uAD6D\uACFC
      \uAC19\uC740 \uD615\uD0DC\uB85C \uD55C \uBC88 \uBE5B\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629318
    m_Localized: "\uC57C\uC601\uC9C0\uC758 \uAC00\uC7A5 \uC5B4\uB450\uC6B4 \uC790\uB9AC.
      \uACF5\uD55C\uC758 \uC774\uB9C8 \uACA9\uC790 \uBB38\uC591\uC774 \uD3C9\uC18C\uBCF4\uB2E4
      \uC9D9\uAC8C \uBE5B\uB09C\uB2E4. \uD65C\uC2DC\uC704 \uB05D\uC758 \uC791\uC740
      \uC218\uC815\uC5D0\uC11C\uB3C4 \uAC19\uC740 \uC0C9 \uBE5B\uC774 \uD750\uB978\uB2E4.
      \uB450 \uBE5B\uC774 \uB098\uB780\uD788 \uD55C \uBC88 \uAE5C\uBE61\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629319
    m_Localized: "...\uCE68\uC6D4\uC774 \uBB3B\uB294\uB2E4. \uC57D\uC18D\uC744 \uAE68\uB294
      \uC790\uAC00 \uB204\uAD6C\uC778\uAC00. \uC2DC\uC870 \uBCF8\uC778\uC774 \uC790\uAE30
      \uC57D\uC18D\uC744 \uAE68\uB294 \uC790\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629320
    m_Localized: "\uACF5\uD55C\uC774 \uC190\uBC14\uB2E5\uC744 \uD55C \uBC88 \uBCF8\uB2E4.
      \uACA9\uC790 \uBB38\uC591\uC774 \uC190\uB4F1\uC5D0\uC11C \uC9D9\uC5B4\uC9C4\uB2E4.
      \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629321
    m_Localized: "...\uC99D\uBA85\uD560 \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629322
    m_Localized: "\uB2E4\uB9CC \uC2DC\uC870\uAC00 \uD559\uC0B4 \uBC18\uBCF5 \uBC29\uC9C0\uB97C
      \uC57D\uC18D\uC758 \uB73B\uC73C\uB85C \uB450\uC5C8\uB2E4\uB294 \uAC74 \uC548\uB2E4.
      \uB0B4\uAC00 \uADF8 \uC790\uB9AC\uC5D0 \uC788\uC5C8\uC73C\uB2C8\uAE4C. \uD559\uD30C\uAC00
      \uC9C4\uC2E4\uC744 \uBB34\uAE30\uB85C \uC4F0\uBA74 \uADF8 \uB73B\uC774 \uBD80\uC11C\uC9C4\uB2E4.
      \uAE00\uC790\uB9CC \uC9C0\uD0A4\uB294 \uC190\uC740 \uB73B\uC744 \uBD80\uC218\uB294
      \uC190\uC774\uB2E4. \uADF8\uB798\uC11C \uD55C \uB9E4\uB4ED\uC744 \uBC16\uC5D0\uC11C
      \uB2E4\uC2DC \uD480\uC5B4\uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629323
    m_Localized: "\uACF5\uD55C\uC774 \uD65C\uC2DC\uC704\uC5D0\uC11C \uC190\uC744
      \uB5BC\uACE0 \uC190\uBC14\uB2E5\uC744 \uD55C \uBC88 \uBCF8\uB2E4. \uBAA8\uB2E5\uBD88\uC758
      \uBE5B\uC774 \uC190\uB4F1\uC758 \uACA9\uC790 \uBB38\uC591\uACFC \uC190\uBC14\uB2E5\uC758
      \uBE48 \uC790\uB9AC\uB97C \uB3D9\uC2DC\uC5D0 \uBE44\uCD98\uB2E4. 1800\uB144
      \uC774\uC804\uC758 \uD55C \uAE30\uC5B5 \uC870\uAC01\uC774 \uD758\uB7EC\uB098\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629324
    m_Localized: "...\uBD88\uC744 \uCB10\uB358 \uC190\uC774 \uB530\uB73B\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629325
    m_Localized: "\uACF5\uD55C\uC774 \uC785\uC744 \uBA48\uCD98\uB2E4. \uADF8\uAC00
      \uC0AC\uC721\uC7A5 \uC55E\uC5D0\uC11C \uC0BC\uCF30\uB358 \uCE68\uBB35\uC774
      \uAC19\uC740 \uBAA8\uC591\uC73C\uB85C \uB3CC\uC544\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629326
    m_Localized: "\uADF8\uAC83\uB9CC \uAE30\uC5B5\uD55C\uB2E4. 1800\uB144 \uB3D9\uC548.
      \uADF8 \uC190\uC774 \uB204\uAD6C\uC758 \uAC83\uC774\uC5C8\uB294\uC9C0\uB294
      \u2014 \uC678\uC6B4 \uC801 \uC5C6\uB2E4. \uBC16\uC758 \uB9D0\uB85C\uB3C4 \uC678\uC6B8
      \uC218 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629327
    m_Localized: "...\uC758\uB840\uB294 \uD55C \uC138\uB300\uC758 \uACB0\uC815\uC774
      \uC544\uB2C8\uB2E4. \uD55C \uB9E4\uB4ED\uC740 \uB2E4\uC74C \uB9E4\uB4ED\uC744
      \uC704\uD574 \uBB36\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629328
    m_Localized: "\uBAA8\uB2E5\uBD88\uC758 \uBE5B\uC774 \uD55C \uBC88 \uD750\uD2B8\uB7EC\uC9C4\uB2E4.
      \uACF5\uD55C\uC758 \uC774\uB9C8 \uACA9\uC790 \uBB38\uC591\uC774 \uC548\uC815\uB41C
      \uC9D9\uC740 \uBE5B\uC73C\uB85C \uC790\uB9AC\uC7A1\uB294\uB2E4. \uACB0\uC0AC
      \uC774\uB984\uC744 \uB0B4\uB824\uB193\uACE0 \uBB38\uBC16\uC5D0 \uB0A8\uC744
      \uC0AC\uB78C\uC758 \uC790\uAD6D. \uD65C\uC2DC\uC704\uC5D0 \uC190\uC774 \uB2E4\uC2DC
      \uB2FF\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629329
    m_Localized: "\uCCAB \uB3C4\uC2DC \uBB38\uD131 \uBC14\uAE65. \uB2EB\uD78C \uACA9\uC790
      \uBB38\uC591\uC774 \uBB38 \uC548\uCABD\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uBE5B\uB09C\uB2E4.
      \uACF5\uD55C\uC740 \uBB38 \uC548\uC73C\uB85C \uD55C \uBC1C\uC744 \uC62E\uAE30\uC9C0
      \uC54A\uB294\uB2E4. \uB2E8\uB9B0\uC774 \uC606\uC5D0 \uC0AC\uC81C \uC778\uC7A5
      \uD480\uB9B0 \uCC44 \uC549\uC544 \uC788\uB2E4. \uB450 \uB3C4\uAD6C\uAC00 \uAC19\uC740
      \uC790\uB9AC\uC5D0\uC11C \uB193\uC778 \uC790\uC138 \u2014 \uC778\uC7A5\uACFC
      \uACA9\uC790 \uB9E4\uB4ED. \uC0AC\uC6A9\uC790\uB294 \uADF8\uC800 \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629330
    m_Localized: "...\uB0A8\uC740 \uC2DC\uAC04\uC740 \uADF8\uB300\uC758 \uAC83\uC774\uB2E4.
      \uB2E8\uB9B0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629331
    m_Localized: "\uB2E8\uB9B0\uC774 \uC9E7\uAC8C \uB044\uB355\uC778\uB2E4. \uC0AC\uC81C
      \uC778\uC7A5\uC5D0\uC11C \uC190\uC774 \uD480\uB9B0\uB2E4. \uB450 \uC0AC\uB78C
      \uC0AC\uC774\uC5D0 \uC9C1\uC811 \uB300\uC0AC\uB294 \uC5C6\uB2E4. \uCE68\uBB35
      \uC790\uCCB4\uAC00 \uC758\uB840\uC758 \uD55C \uC790\uB9AC. \uD50C\uB808\uC774\uC5B4\uB294
      \uBC1C\uD654\uD558\uC9C0 \uC54A\uACE0 \uBA38\uBB34\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629332
    m_Localized: "\uC190\uC774 \uBE44\uC5C8\uB2E4. \uADF8\uB798\uC11C \uBB38\uC744
      \uC7A1\uC744 \uC218 \uC788\uB2E4. \uC548\uC5D0\uC11C \uB098\uC624\uB294 \uC0AC\uB78C\uB3C4,
      \uBC16\uC5D0\uC11C \uB4E4\uC5B4\uC624\uB294 \uC0AC\uB78C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629333
    m_Localized: "\uB2E8\uB9B0\uC774 \uC606\uC5D0\uC11C \uC0AC\uC81C \uC778\uC7A5\uC744
      \uB2E4\uC2DC \uC7A1\uC9C0 \uC54A\uB294\uB2E4. \uC9E7\uAC8C \uB044\uB355\uC778\uB2E4.
      \uBB38 \uC548\uCABD\uC758 \uACA9\uC790\uAC00 \uB2EB\uD78C \uBE5B\uC73C\uB85C
      \uC548\uC815\uB41C\uB2E4. \uACF5\uD55C\uC740 \uADF8 \uBE5B\uC744 \uBCF4\uC9C0\uB9CC
      \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629334
    m_Localized: "...\uB2E8\uB9B0, \uC0AC\uC81C\uB85C\uC11C\uAC00 \uC544\uB2C8\uB77C
      \uD55C \uC0AC\uB78C\uC73C\uB85C \uC0C8 \uCCAB \uAD6C\uC808\uC744 \uC678\uC6CC
      \uBCF4\uB0BC \uB54C. \uADF8 \uAD6C\uC808 \uC548\uC5D0 \uC5B4\uBA38\uB2C8\uC758
      \uC774\uB984\uC774 \uC788\uB2E4\uBA74 \u2014 \uBB38\uBC16\uC5D0\uC11C \uADF8
      \uC774\uB984\uC744 \uB4E3\uACA0\uB2E4. \uB2E4\uC74C \uC138\uB300\uAC00 \uB9E4\uB4ED\uC744
      \uBB36\uC744 \uB54C, \uADF8 \uC774\uB984\uC774 \uAE38\uC744 \uC783\uC9C0 \uC54A\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629335
    m_Localized: "...\uB4E4\uC73C\uC154\uB3C4 \uB429\uB2C8\uB2E4. \uC678\uC6B0\uC9C0
      \uC54A\uC740 \uCCAB \uAD6C\uC808\uC774\uC9C0\uB9CC \u2014 \uC5B4\uBA38\uB2C8\uAED8
      \uBCF4\uB0B4\uB294 \uC790\uB9AC\uC5D0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629336
    m_Localized: "\uACF5\uD55C\uC740 \uBB38\uD131 \uC548\uCABD\uC744 \uBCF4\uB2E4\uAC00,
      \uB05D\uB0B4 \uBB38\uBC16\uC5D0 \uC120\uB2E4. \uADF8\uC758 \uC774\uB984 \uD558\uB098\uAC00
      \uC548\uCABD\uC5D0 \uB0A8\uACE0, \uC190\uC740 \uBC14\uAE65 \uACF5\uAE30\uB97C
      \uC7A1\uB294\uB2E4. \uD65C\uC2DC\uC704\uC5D0 \uAC78\uB824 \uC788\uB358 \uACA9\uC790
      \uB9E4\uB4ED \uD654\uC0B4\uC740 \uC3D8\uC9C0 \uC54A\uC740 \uCC44 \uB0B4\uB824\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629337
    m_Localized: "...\uC2DC\uAC04\uC740 \uADF8\uB300\uC758 \uAC83\uC774\uB2E4. \uB2E4\uC74C
      \uB9E4\uB4ED\uC740 \uADF8\uB300\uB4E4\uC774 \uBB36\uC744 \uC790\uB9AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629338
    m_Localized: "...\uAD1C\uCC2E\uB2E4. \uBB38\uBC16\uC740 \uCDA5\uB2E4. \uADF8\uB798\uC11C
      \uBD88\uC744 \uB450\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629339
    m_Localized: "\uACF5\uD55C\uC740 \uBB38\uBC16\uC5D0 \uB0A8\uB294\uB2E4. \uBB38\uD2C8\uC758
      \uBE5B\uC774 \uC791\uAC8C \uB0A8\uB294\uB2E4. \uB2EB\uD78C \uBE5B\uC774 \uC544\uB2C8\uB77C,
      \uB204\uAC00 \uB3CC\uC544\uC62C \uB54C \uAE38\uC744 \uC783\uC9C0 \uC54A\uAC8C
      \uB450\uB294 \uBE5B\uC774\uB2E4. \uB2E8\uB9B0\uC774 \uC77C\uC5B4\uC120\uB2E4.
      \uC0AC\uC81C \uC778\uC7A5\uC740 \uADF8 \uC790\uB9AC\uC5D0 \uD480\uB9B0 \uCC44
      \uADF8\uB300\uB85C \uB454\uB2E4. \uB450 \uB3C4\uAD6C\uAC00 \uAC19\uC740 \uC790\uB9AC\uC5D0
      \u2014 \uACA9\uC790 \uB9E4\uB4ED\uACFC \uC0AC\uC81C \uC778\uC7A5. \uB2E4\uC74C
      \uC138\uB300\uAC00 \uD55C \uBC88\uC529 \uC9DA\uC744 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629340
    m_Localized: "\uBB18\uC5ED \uC785\uAD6C \uAC70\uC810. \uC778\uAD11 \uC774\uB07C\uAC00
      \uCCAD\uB85D\uC73C\uB85C \uAE5C\uBE61\uC774\uB294 \uC790\uB9AC\uC5D0 \uBB35\uD5A5\uC774
      \uC549\uC544 \uC788\uB2E4. \uC9C0\uD321\uC774 \uC885\uC774 \uC190\uBC14\uB2E5\uC5D0
      \uC62C\uB77C\uC640 \uC788\uB2E4. \uD754\uB4E4\uC9C0 \uC54A\uB294 \uCC44\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629341
    m_Localized: "...\uB108\uC5D0\uAC8C \uD55C \uAC00\uC9C0 \uBB3C\uC5B4\uBCFC\uAC8C.
      \uB18D\uB2F4\uC744 \uAC00\uB974\uCE58\uBA74 \uBC1B\uC744 \uC0AC\uB78C\uC778\uC9C0,
      \uC544\uB2C8\uBA74 \uB18D\uB2F4\uC774 \uBE44\uC2F8\uB2E4\uACE0 \uCC98\uC74C\uBD80\uD130
      \uC548 \uBC1B\uC744 \uC0AC\uB78C\uC778\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629342
    m_Localized: "\uBB35\uD5A5\uC774 \uC885\uC744 \uC190\uBC14\uB2E5 \uC704\uC5D0\uC11C
      \uAD74\uB9B0\uB2E4. \uC885 \uC790\uCCB4\uB294 \uC6B8\uB9AC\uC9C0 \uC54A\uB294\uB2E4.
      \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629343
    m_Localized: "...\uBD84\uC1C4\uD558\uB294 \uAC70\uC9C0. \uB9E4\uC77C \uB4E4 \uC218
      \uC788\uB294 \uC78E\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629344
    m_Localized: "\uC78E \uD55C \uC7A5\uC774 \uD55C \uC5FD\uC774\uB77C \uCE58\uC790\uACE0.
      \uD55C 200\uB144 \uB4E4\uACE0 \uB2E4\uB2CC \uC78E\uC774 \uD55C \uBB36\uC74C\uC774\uBA74
      \u2014 \uB18D\uB2F4\uC740 \uADF8 \uBB36\uC74C\uC744 \uD55C \uC7A5\uC529 \uB5BC\uC5B4\uB0B4\uB294
      \uC190\uB180\uB9BC\uC774\uC57C. \uC78E\uC774 \uC904\uC9C0\uB294 \uC54A\uC544.
      \uB4E4\uAE30 \uAC00\uBCBC\uC6CC\uC9C8 \uBFD0\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629345
    m_Localized: "\uBB35\uD5A5\uC774 \uC885\uC744 \uC190\uBC14\uB2E5\uC5D0\uC11C
      \uC9C0\uD321\uC774 \uB05D\uC5D0 \uB2E4\uC2DC \uB07C\uC6B4\uB2E4. \uB9E4\uB4ED
      \uD55C \uC790\uB9AC\uB294 \uBE44\uC5B4 \uC788\uB2E4 \u2014 \uB2E8\uB9B0\uC5D0\uAC8C
      \uBCF4\uB0BC \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629346
    m_Localized: "\uC778\uAD11 \uC774\uB07C\uAC00 \uD55C \uC790\uB9AC\uC5D0\uC11C
      \uC7A0\uC2DC \uB354 \uC9D9\uAC8C \uAE5C\uBE61\uC778\uB2E4. \uBB35\uD5A5\uC758
      \uC190\uBC14\uB2E5\uC5D0\uC11C \uC78E \uAC00\uB8E8 \uAC19\uC740 \uBA3C\uC9C0
      \uD55C \uC90C\uC774 \uD759\uC73C\uB85C \uB5A8\uC5B4\uC9C4\uB2E4 \u2014 200\uB144
      \uC804 \uB3D9\uB8CC\uC758 \uC758\uB840\uC5D0\uC11C \uBB3B\uC740 \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629347
    m_Localized: "\uAE30\uC5B5\uD574 \uC904\uAC8C. \uC774 \uB300\uD654\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629348
    m_Localized: "\uC9C0\uD321\uC774 \uC885\uC774 \uAC00\uBCCD\uAC8C \uD55C \uBC88
      \uC6B4\uB2E4. \uBB35\uD5A5\uC774 \uB4E4\uC9C0 \uC54A\uB294\uB2E4. \uC885\uC774
      \uC2A4\uC2A4\uB85C \uC6B8\uB9B0 \uC790\uB9AC\uC5D0 \uC78E \uAC00\uB8E8\uAC00
      \uC870\uAE08 \uB354 \uD769\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629349
    m_Localized: "\uBB18\uC5ED \uC785\uAD6C \uAC70\uC810. \uBB35\uD5A5\uC774 \uC190\uBAA9\uC758
      \uC0C8 \uD749\uD130\uB97C \uC190\uAC00\uB77D\uC73C\uB85C \uB530\uB77C \uADF8\uB9B0\uB2E4.
      \uD749\uD130\uC5D0 \uBD89\uC740 \uC78E \uD55C \uC7A5 \uAC19\uC740 \uC0C9\uC774
      \uBB3B\uC5B4 \uC788\uB2E4. \uB2E8\uD604 \uC2DC\uB300 \uC7BF\uBE5B\uACFC \uB2E4\uB978
      \uC0C9 \u2014 \uC0C8 \uC7BF\uBE5B."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629350
    m_Localized: "\uD751\uC9C0\uC758 \uB450\uB8E8\uB9C8\uB9AC\uC5D0 \uB0B4 \uC774\uB984\uC774
      \uC788\uC5B4. ...\uADF8\uB798. \uB0B4 \uC774\uB984\uC774\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629351
    m_Localized: "\uBB35\uD5A5\uC774 \uD749\uD130\uC5D0\uC11C \uC190\uC744 \uB5C0\uB2E4.
      \uD749\uD130\uAC00 \uC605\uAC8C \uBE5B\uB09C\uB2E4 \u2014 \uACB0\uC0AC \uC758\uB840
      \uC789\uD06C\uC758 \uBD80\uC0B0\uBB3C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629352
    m_Localized: "\uBC1B\uC544\uB4E4\uC774\uB294 \uAC8C \uC544\uB2C8\uC57C. \uAC70\uAE30
      \uB0B4 \uC774\uB984\uC774 \uC788\uB294 \uAC8C \uC0AC\uC2E4\uC774\uC9C0. \uADF8\uAC74
      \uB2E4\uB978 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629353
    m_Localized: "\uD751\uC9C0\uAC00 \uB0B4 \uC774\uB984\uC744 \uBA85\uB2E8\uC5D0
      \uC4F4 \uC774\uC720\uB294 \u2014 \uC815\uD654 \uC7AC\uD310 \uB54C \uACB0\uC0AC
      \uC77C\uBD80 \uB3D9\uB8CC\uC758 \uCC98\uD615\uC744 \uBABB \uB9C9\uC740 \uAC8C
      \uB0B4 \uCC45\uC784\uC774\uB77C\uB294 \uAC70\uC57C. \uB9C9\uC744 \uC218 \uC788\uC5C8\uB098?
      \uBABB \uB9C9\uC558\uC5B4. \uADF8\uAC74 \uC78E \uD55C \uC7A5\uCC98\uB7FC \uC0AC\uC2E4\uC774\uC57C.
      \uB2E8\uC8C4\uC640 \uC78E\uC774 \uAC19\uC774 \uC788\uC744 \uC218\uB3C4 \uC788\uACE0,
      \uC78E\uB9CC \uB530\uB85C \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uACE0. \uADF8\uAC8C
      \uD751\uC9C0\uC640 \uB0B4 \uAE38\uC758 \uCC28\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629354
    m_Localized: "\uBB35\uD5A5\uC774 \uC9C0\uD321\uC774 \uC885\uC744 \uAC00\uBCCD\uAC8C
      \uD55C \uBC88 \uD754\uB4E0\uB2E4. \uD3C9\uC18C\uC758 \uAC00\uBCBC\uC6C0\uC774
      \uC7A0\uC2DC \uB3CC\uC544\uC628\uB2E4. \uC7A0\uC2DC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629355
    m_Localized: "\uD55C 200\uB144 \uC804\uC5D0 \uAC19\uC740 \uC790\uB9AC\uB97C \uBCF8
      \uC801 \uC788\uC5B4. \uADF8\uB54C\uB294 \uB0B4\uAC00 \uD751\uC9C0 \uC790\uB9AC\uC5D0
      \uC788\uC5C8\uC5B4. \uBA85\uB2E8\uC744 \uB9CC\uB4E0 \uC790\uAC00 \uB098\uC600\uACE0,
      \uB0B4 \uC774\uB984\uC744 \uC4F4 \uAC8C \uB2E4\uB978 \uB3D9\uB8CC\uC600\uC9C0.
      \uB458\uC774 \uAC19\uC774 \uD55C 200\uB144 \uACAC\uB3A0\uC5B4. \uADF8 \uB3D9\uB8CC\uB294
      \uC9C0\uAE08 \uBE44\uC6CC\uC84C\uC5B4. \uBA85\uB2E8\uC740 \uB0B4\uAC00 \uAC16\uACE0
      \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629356
    m_Localized: "\uBB35\uD5A5\uC774 \uC9C0\uD321\uC774 \uB05D\uC758 \uBE48 \uB9E4\uB4ED
      \uC790\uB9AC\uB97C \uBCF8\uB2E4. \uB2E8\uB9B0\uC5D0\uAC8C \uBCF4\uB0BC \uC790\uB9AC\uB294
      \uC544\uC9C1 \uBE44\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629357
    m_Localized: "\uC778\uAD11 \uC774\uB07C\uAC00 \uD55C \uC904 \uAE38\uAC8C \uAE5C\uBE61\uC778\uB2E4.
      \uBB35\uD5A5\uC758 \uC190\uBC14\uB2E5\uC5D0\uC11C \uC78E \uAC00\uB8E8\uAC00
      \uD759\uC73C\uB85C \uB5A8\uC5B4\uC9C4\uB2E4 \u2014 \uC0C8 \uD749\uD130\uC758
      \uBD80\uC0B0\uBB3C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629358
    m_Localized: "\uAE30\uC5B5\uC740 \uD769\uC5B4\uC838\uC57C \uC0B4\uC544\uB0A8\uB294
      \uAC70\uC57C. \uD55C \uC0AC\uB78C \uC548\uC5D0\uB9CC \uC788\uC73C\uBA74, \uADF8
      \uC0AC\uB78C \uC7A5\uB840\uC2DD \uB54C \uAC19\uC774 \uBB3B\uD788\uAC70\uB4E0.
      \uD55C \uC870\uAC01, \uB4E4\uC5B4\uC904\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629359
    m_Localized: "\uBB35\uD5A5\uC774 \uC9C0\uD321\uC774\uC5D0\uC11C \uC885 \uD558\uB098\uB97C
      \uC190\uAC00\uB77D\uC73C\uB85C \uAC00\uBCCD\uAC8C \uD47C\uB2E4. \uC885\uC774
      \uC190\uBC14\uB2E5 \uC704\uC5D0 \uB530\uB85C \uB5A8\uC5B4\uC9C4\uB2E4. \uB2E8\uB9B0\uC758
      \uC790\uB9AC\uB294 \uC544\uC9C1 \uBE44\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629360
    m_Localized: "\uBCC0\uBC29 \uD68C\uB2F4 \uC9C1\uD6C4 \uC57C\uC601\uC9C0. \uBB35\uD5A5\uC758
      \uC9C0\uD321\uC774\uC5D0\uC11C \uC885 \uD558\uB098\uAC00 \uBE60\uC9C4 \uC790\uB9AC\uAC00
      \uBCF4\uC778\uB2E4. \uADF8 \uC790\uB9AC\uC5D0 \uC0C8 \uC885\uC774 \uB4E4\uC5B4\uAC00
      \uC788\uC9C0 \uC54A\uB2E4. \uB2E8\uB9B0\uC5D0\uAC8C \uBCF4\uB0B8 \uC885\uC774
      \uBE60\uC9C4 \uCC44\uB85C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629361
    m_Localized: "\uB0B4\uAC00 \uB354 \uC774\uC0C1 \uBABB \uB4E4\uACE0 \uC788\uC744
      \uB54C \uD55C \uC870\uAC01 \uB9E1\uC558\uB358 \uC77C, \uBB34\uAC70\uC6E0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629362
    m_Localized: "\uBB35\uD5A5\uC774 \uC9C0\uD321\uC774\uC758 \uBE48 \uC790\uB9AC\uB97C
      \uC190\uAC00\uB77D\uC73C\uB85C \uB9CC\uC9C4\uB2E4. \uBD80\uC7AC\uC758 \uBB34\uAC8C\uAC00
      \uAC70\uAE30\uC5D0 \uC788\uB2E4. \uC0AC\uC6A9\uC790\uAC00 \uD55C \uAC00\uC9C0\uB9CC
      \uB2F5\uD560 \uC218 \uC788\uB2E4 \u2014 \uC591\uB3C4 \uBC1B\uB294 \uC790\uC138\uB294
      \uB2E8\uC77C \uC120\uD0DD\uC9C0\uB85C \uCDA9\uBD84\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629363
    m_Localized: "...\uB450 \uBC88\uC9F8\uAD70. \uCCAB \uBC88\uC9F8\uB294 \uACF5\uD55C\uC774
      \uD588\uC9C0. 1800\uB144 \uAC70\uB9AC\uC5D0\uC11C \uAC19\uC740 \uC790\uC138\uB97C
      \uBCF4\uC600\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629364
    m_Localized: "\uACF5\uD55C\uC740 \uBB38\uBC16\uC5D0\uC11C \uB9D0\uD558\uACE0,
      \uB2E8\uB9B0\uC740 \uD55C \uC0AC\uB78C\uC758 \uBB34\uAC8C\uB85C \uC548\uACE0
      \uAC00\uACE0. \uB098\uB294 \uC9C0\uD321\uC774\uC5D0\uC11C \uC885 \uD558\uB098\uB97C
      \uBE7C\uC9C0. \uD769\uC5B4\uC9C4 \uAE30\uC5B5\uCE58\uACE0\uB294 \uC81C\uBC95
      \uC9C8\uC11C \uC788\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629365
    m_Localized: "\uBB35\uD5A5\uC774 \uC9C0\uD321\uC774\uC758 \uBE48 \uC790\uB9AC\uC5D0
      \uC190\uAC00\uB77D\uC744 \uD55C \uBC88 \uB354 \uB304\uB2E4. \uC0C8 \uC885\uC774
      \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uC740 \uCC44\uB85C \uADF8\uB300\uB85C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629366
    m_Localized: "\uB2E4\uB4E4 \uC190\uC5D0 \uC954 \uAC78 \uD558\uB098\uC529 \uB0B4\uB824\uB1A8\uC9C0.
      \uC0AC\uC81C\uB294 \uC778\uC7A5, \uC0AC\uB0E5\uAFBC\uC740 \uBC18\uCABD \uD1A0\uD15C,
      \uB098\uB294 \uC885. \uACF5\uD55C\uC740 \uC774\uB984. \uC78E\uC774 \uD769\uC5B4\uC9C0\uB294
      \uB0A0\uC5D4 \uBC14\uB2E5\uB3C4 \uC880 \uBC14\uBE60\uC9C4\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629367
    m_Localized: "\uBB35\uD5A5\uC774 \uCC98\uC74C\uC73C\uB85C \uBE48 \uC9C0\uD321\uC774
      \uC790\uB9AC\uB97C \uBCF4\uBA74\uC11C \uBBF8\uC138\uD558\uAC8C \uBBF8\uC18C
      \uC9D3\uB294\uB2E4. \uADF8 \uBBF8\uC18C\uAC00 \uC7A0\uC2DC \uBA38\uBB3C\uACE0
      \uB2E4\uC2DC \uD3C9\uC18C\uC758 \uCC28\uBD84\uC73C\uB85C \uB3CC\uC544\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629368
    m_Localized: "\uAE30\uC5B5\uC740 \uD769\uC5B4\uC838\uC57C \uC0B4\uC544\uB0A8\uB294
      \uAC70\uC57C. \uADF8\uAC83\uB9CC \uC54C\uC544 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629369
    m_Localized: "\uBB35\uD5A5\uC774 \uC9C0\uD321\uC774\uB97C \uC606\uC5D0 \uB450\uACE0
      \uC77C\uC5B4\uC120\uB2E4. \uBE48 \uC790\uB9AC\uB294 \uCC44\uC6B0\uC9C0 \uC54A\uB294\uB2E4.
      \uC778\uAD11 \uC774\uB07C\uAC00 \uBA40\uB9AC\uC11C \uD55C \uC904 \uAE38\uAC8C
      \uAE5C\uBE61\uC778\uB2E4. memorial lobby\uAC00 \uD65C\uC131\uD654\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629370
    m_Localized: "\uC57C\uC601\uC9C0 \uD55C \uC790\uB9AC. \uC6D0\uC2DC\uAC00 \uD654\uC0B4\uD1B5\uC744
      \uBB34\uB98E \uC606\uC5D0 \uD3BC\uCCD0 \uB450\uACE0 \uC788\uB2E4. 9\uBD84\uB958
      \uB77C\uBCA8\uC774 \uD654\uC0B4\uB9C8\uB2E4 \uB2E4\uB978 \uC0C9 \uB048\uC73C\uB85C
      \uBB36\uC5EC \uC788\uB2E4. \uC0C8 \uCD9C\uBC1C\uC6A9 \uCE78\uC774 \uD55C \uC790\uB9AC
      \uBE44\uC5B4 \uC788\uB2E4 \u2014 \uB2E8\uB9B0\uC5D0\uAC8C \uBCF4\uB0B8 \uC790\uB9AC.
      \uC2DC\uC704 \uB9E4\uB4ED \uB124 \uAC1C\uAC00 \uD65C \uB05D\uC5D0 \uBB36\uC5EC
      \uC788\uB2E4. \uB2E4\uC12F \uBC88\uC9F8 \uB9E4\uB4ED\uC740 \uBB36\uC774\uC9C0
      \uC54A\uC740 \uCC44."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629371
    m_Localized: "...\uC0C8 \uCD9C\uBC1C\uC6A9 \uD654\uC0B4\uC740 \uBC1B\uB294 \uC790\uAC00
      \uAC00\uAC8C \uB450\uB294 \uAC8C \uC758\uB840\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629372
    m_Localized: "\uC6D0\uC2DC\uAC00 \uAE43\uC5D0\uC11C \uC190\uC744 \uB5C0\uB2E4.
      \uC2DC\uC120\uC774 \uBE44\uC5B4 \uC788\uB294 \uC0C8 \uCD9C\uBC1C\uC6A9 \uCE78\uC5D0
      \uC7A0\uC2DC \uBA38\uBB38\uB2E4. \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C
      \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629373
    m_Localized: "...30\uB144 \uBD24\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629374
    m_Localized: "\uC815\uCE58 \uBC14\uAFC0 \uC218 \uC788\uB2E4\uACE0 \uBBFF\uC5C8\uB358
      \uC0AC\uB0E5\uAFBC \uB3D9\uB8CC\uB4E4\uC774 \uB2E4 \uC8FD\uC5C8\uC2B5\uB2C8\uB2E4.
      \uD65C\uC740 \uC548 \uC8FD\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uAC8C \uB2F5\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629375
    m_Localized: "\uB9D0\uD558\uC9C0 \uC54A\uB294 \uCE78\uC774 \uD65C\uC744 \uC0B4\uB9AC\uB294
      \uC544\uD649 \uBC88\uC9F8 \uBD84\uB958\uC785\uB2C8\uB2E4. \uB77C\uBCA8\uC740
      \uC5C6\uC2B5\uB2C8\uB2E4. \uB77C\uBCA8 \uC5C6\uB294 \uCABD\uC774 \uC624\uB798
      \uC0B4\uC544\uB0A8\uC544\uC11C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629376
    m_Localized: "\uC6D0\uC2DC\uAC00 \uD654\uC0B4\uD1B5\uC758 \uC0C8 \uCD9C\uBC1C\uC6A9
      \uBE48 \uC790\uB9AC\uB97C \uB2E4\uC2DC \uBCF8\uB2E4. \uB2E8\uB9B0\uC5D0\uAC8C
      \uBCF4\uB0B8 \uD654\uC0B4\uC774 \uC5B4\uB514\uAE4C\uC9C0 \uAC14\uB294\uC9C0,
      \uAC70\uB9AC\uB97C \uC7A0\uC2DC \uC7B0\uB2E4. 9\uBD84\uB958 \uB77C\uBCA8\uC774
      \uBAA8\uB2E5\uBD88 \uBE5B\uC5D0 \uD754\uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629377
    m_Localized: "...\uB0AD\uBE44\uD560 \uD654\uC0B4\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uB2E8\uB9B0, \uADF8 \uD654\uC0B4\uC740 \uB2F9\uC2E0\uC5D0\uAC8C \uAC14\uC2B5\uB2C8\uB2E4.
      \uBE57\uB098\uAC00\uBA74 \uC81C\uAC00 \uC544\uB2C8\uB77C \uB2F9\uC2E0 \uCC45\uC784\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629378
    m_Localized: "\uC6D0\uC2DC\uAC00 \uD654\uC0B4\uD1B5\uC744 \uB2E4\uC2DC \uB2EB\uB294\uB2E4.
      \uC2DC\uC704 \uB9E4\uB4ED \uB124 \uAC1C\uC5D0 \uC190\uAC00\uB77D\uC774 \uBA38\uBB38\uB2E4.
      \uB2E4\uC12F \uBC88\uC9F8 \uC790\uB9AC\uB294 \uBE44\uC5B4 \uC788\uB2E4. \uBA40\uB9AC\uC11C
      \uC2DD\uB7C9 \uC790\uB8E8\uC758 \uACB0\uC18D\uC774 \uD480\uB9AC\uB294 \uC18C\uB9AC\uAC00
      \uB09C\uB2E4 \u2014 \uC6D0\uC2DC\uC758 \uC190\uC774 \uADF8 \uBC29\uD5A5\uC73C\uB85C
      \uBC14\uB85C \uC62E\uACA8 \uAC04\uB2E4. \uB2E4\uC74C \uC77C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629379
    m_Localized: "\uBCC0\uBC29 \uD68C\uB2F4 \uC57C\uC601\uC9C0\uC758 \uD55C \uC790\uB9AC.
      \uBA85\uC74C\uC774 \uC758\uB840 \uAC70\uC6B8\uC744 \uC190\uC5D0 \uB4E0\uB2E4.
      \uAC70\uC6B8 \uD14C\uB450\uB9AC\uC758 \uACA9\uC790 \uBB38\uC591\uC774 \uBAA8\uB2E5\uBD88
      \uBE5B\uC5D0 \uC7A0\uC2DC \uBA38\uBB38\uB2E4. \uAC70\uC6B8 \uC548\uC5D0 \uB124
      \uAC08\uB798 \uBE5B\uC774 \uCC28\uB840\uB85C \uBC18\uC0AC\uB41C\uB2E4 \u2014
      \uC194\uB77C\uB8F8\uC758 \uBC31\uAE08, \uC774\uB9AC\uC194\uC758 \uD638\uBC15,
      \uD68C\uC0C1\uC758 \uCCAD\uB85D \uC778\uAD11, \uADF8\uBB3C\uC758 \uBCF4\uB77C
      \uC218\uC815. \uB2E4\uC12F \uBC88\uC9F8 \uBE5B\uC740 \uBE44\uCE58\uC9C0 \uC54A\uB294\uB2E4.
      \uC190\uB4F1\uC758 \uB124 \uB9E4\uB4ED \uC606 \uB2E4\uC12F \uBC88\uC9F8 \uC790\uB9AC\uB294
      \uBE44\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629380
    m_Localized: "...\uAC70\uC6B8\uC5D0 \uB124 \uAC08\uB798 \uBE5B\uC744 \uCC28\uB840\uB85C
      \uBE44\uCDA5\uB2C8\uB2E4. \uB2E4\uC12F \uBC88\uC9F8 \uC790\uB9AC\uAC00 \uBE44\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4. \uB204\uAD6C\uC758 \uBE5B\uC774 \uB4E4\uC5B4\uC635\uB2C8\uAE4C.
      \uBA3C\uC800 \uBB3B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629381
    m_Localized: "\uBA85\uC74C\uC774 \uAC70\uC6B8\uC744 \uC0B4\uC9DD \uAE30\uC6B8\uC778\uB2E4.
      \uAC70\uC6B8 \uC548\uC5D0 \uBAA8\uB2E5\uBD88 \uBE5B\uC774 \uC791\uC740 \uACA9\uC790
      \uBB38\uC591\uC73C\uB85C \uBD84\uC0B0\uB41C\uB2E4. \uC0AC\uC6A9\uC790\uAC00
      \uB2F5\uC744 \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629382
    m_Localized: "\uBA85\uC74C\uC774 \uAC70\uC6B8\uC744 \uC0B4\uC9DD \uAE30\uC6B8\uC778\uB2E4.
      \uAC70\uC6B8 \uC548\uC5D0 \uACA9\uC790 \uBB38\uC591\uC774 \uD55C \uD615\uC2DD\uC73C\uB85C
      \uC7A0\uC2DC \uC815\uB82C\uB41C\uB2E4. \uB124 \uAC08\uB798 \uBE5B\uC774 \uB2E4\uC12F
      \uBC88\uC9F8 \uC790\uB9AC\uB97C \uD5A5\uD574 \uCC28\uB840\uB85C \uAE30\uC6B8\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629383
    m_Localized: "...\uCE68\uC6D4\uC758 \uAC70\uC6B8\uC740 \uC544\uC9C1 \uB2EB\uD600
      \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uC11C \uBE48 \uBE5B\uC744 \uB0A8\uACA8
      \uB461\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629384
    m_Localized: "\uAC70\uC6B8\uC740 \uACB0\uC815\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uB124 \uBE5B\uC774 \uAC08\uB77C\uC9C0\uBA74, \uAC08\uB77C\uC9C4 \uCC44\uB85C
      \uBE44\uCDA5\uB2C8\uB2E4. \uB2E4\uC12F \uBC88\uC9F8 \uBE5B\uC740 \uC544\uC9C1
      \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629385
    m_Localized: "\uBA85\uC74C\uC774 \uAC70\uC6B8\uC744 \uB2E4\uC2DC \uC190\uBC14\uB2E5\uC5D0
      \uB454\uB2E4. \uAC70\uC6B8 \uC548\uC758 \uACA9\uC790 \uBB38\uC591\uC774 \uCC9C\uCC9C\uD788
      \uD3C9\uC18C\uC758 \uD750\uB984\uC73C\uB85C \uB3CC\uC544\uC628\uB2E4. \uBAA8\uB2E5\uBD88\uC758
      \uBE5B\uC774 \uB124 \uAC08\uB798\uC640 \uD55C \uB3D9\uB9F9\uC758 \uC790\uB9AC\uC5D0\uC11C
      \uCC28\uB840\uB85C \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629386
    m_Localized: "\uAE30\uB85D. \uC778\uC7A5 \uD480\uB9BC. \uC885 \uC774\uB3D9. \uD1A0\uD15C
      \uBC18\uCABD. \uBB38\uBC16 \uB300\uAE30. \uB2E4\uC12F\uC774 \uD55C \uB9E4\uB4ED\uC73C\uB85C
      \uBB36\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB2E4\uC12F\uC744 \uB2E4\uC12F\uC73C\uB85C
      \uB461\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629387
    m_Localized: "...\uAC70\uC6B8\uC740 \uBD99\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uAE68\uC9C4 \uC120\uC744 \uC78A\uC9C0 \uC54A\uAC8C \uBE44\uCD9C \uBFD0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629388
    m_Localized: "\uBA85\uC74C\uC774 \uAC70\uC6B8\uC744 \uC606\uC5D0 \uB454\uB2E4.
      \uAC70\uC6B8 \uC548\uC758 \uACA9\uC790 \uBB38\uC591\uC774 \uD55C \uBC88 \uB354
      \uBE5B\uB09C\uB2E4. \uC190\uB4F1\uC758 \uB124 \uB9E4\uB4ED \uC606 \uB2E4\uC12F
      \uBC88\uC9F8 \uC790\uB9AC\uC5D0 \uC0C8 \uB9E4\uB4ED\uC774 \uC0C8\uACA8\uC9C8
      \uC2DC\uAC04\uC774 \uAC00\uAE4C\uC6CC\uC9C4\uB2E4. \uBAA8\uB2E5\uBD88\uC758
      \uB9C8\uC9C0\uB9C9 \uBE5B\uC774 \uAC70\uC6B8 \uB05D\uC5D0\uC11C \uC7A0\uC2DC
      \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629389
    m_Localized: "\uC57C\uC601\uC9C0\uC758 \uC5B4\uB450\uC6B4 \uC790\uB9AC. \uBAA8\uB2E5\uBD88
      \uBE5B\uC774 \uCE7C\uB0A0 \uB05D\uC758 \uC9D1\uC815\uAD00 \uD68C\uC758 \uC778\uC7A5\uC744
      \uBE44\uCD98\uB2E4. \uC778\uC7A5\uC740 \uCE7C\uC9D1\uC5D0\uC11C \uC808\uBC18\uB9CC
      \uB098\uC640 \uC788\uB2E4. \uC11C\uAC80\uC758 \uC190\uC774 \uCE7C\uC790\uB8E8\uC5D0
      \uC788\uB2E4. \uB5BC\uC9C0 \uC54A\uB294\uB2E4. \uC190\uBAA9 \uC548\uCABD\uC758
      \uCC98\uD615\uC790\uB2E8 \uC785\uD68C \uD45C\uC2DD\uC774 \uC605\uAC8C \uBCF4\uC778\uB2E4
      \u2014 \uC5B4\uB9B0 \uB098\uC774\uC5D0 \uC790\uAE30 \uC190\uC73C\uB85C \uC0C8\uAE34
      \uCCAB \uBA85\uB839\uC758 \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629390
    m_Localized: "...\uC218\uD589\uD574 \uC628 \uBA85\uB839\uB4E4. \uADF8 \uCE7C\uC774
      \uBB34\uC5C7\uC774\uC5C8\uB294\uC9C0 \uBB3B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629391
    m_Localized: "\uC11C\uAC80\uC774 \uC0AC\uC6A9\uC790 \uCABD\uC73C\uB85C \uC2DC\uC120\uC744
      \uC62E\uAE30\uC9C0 \uC54A\uB294\uB2E4. \uCE7C\uB0A0 \uB05D\uC758 \uC778\uC7A5\uB9CC
      \uBCF8\uB2E4. \uC0AC\uC6A9\uC790\uAC00 \uD55C \uAC00\uC9C0\uB9CC \uB2F5\uD560
      \uC218 \uC788\uB2E4 \u2014 \uB2E8\uB2F5 \uCE90\uB9AD\uD130\uC5D0\uB294 \uD55C
      \uC120\uD0DD\uC9C0\uB85C \uCDA9\uBD84\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629392
    m_Localized: "\uC11C\uAC80\uC774 \uC9E7\uC740 \uCE68\uBB35\uC744 \uACAC\uB518\uB2E4.
      \uCE7C\uC790\uB8E8\uC5D0\uC11C \uC190\uC774 \uB2A6\uAC8C \uB5A0\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629393
    m_Localized: "...\uC608. \uADF8\uB807\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629394
    m_Localized: "...\uC2A4\uC2B9\uC774 \uAC00\uB974\uCE58\uC2E0 \uCE7C\uC758 \uC790\uC138\uB294
      \uBA85\uB839\uC758 \uC790\uC138\uC600\uC2B5\uB2C8\uB2E4. \uC774\uB984\uC774
      \uBD09\uC778\uB41C \uC790\uB9CC\uC774 \uBA85\uB839\uC744 \uC218\uD589\uD560
      \uC218 \uC788\uB2E4\uB294 \uC808\uCC28\uC600\uC2B5\uB2C8\uB2E4. \uC8C4\uC1A1\uD569\uB2C8\uB2E4.
      \uC800\uB294 \uC544\uC9C1\uB3C4 \uBA85\uB839\uACFC \uC808\uCC28\uB97C \uAC19\uC740
      \uCE7C\uC9D1\uC5D0 \uB123\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629395
    m_Localized: "\uC11C\uAC80\uC758 \uC190\uC774 \uCE7C\uC790\uB8E8\uB97C \uB2E4\uC2DC
      \uC7A1\uB294\uB2E4. \uCE7C\uC774 \uCE7C\uC9D1\uC5D0\uC11C \uC808\uBC18\uCBE4
      \uB354 \uB098\uC624\uB824\uB2E4 \uBA48\uCD98\uB2E4. \uCC98\uC74C\uC758 \uBA48\uCDA4.
      \uBB18\uC5ED\uC5D0\uC11C \uBB35\uD5A5\uC774 \uBCF8 \uADF8 \uC790\uC138."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629396
    m_Localized: "...\uC218\uD589 \uC678 \uB2E8\uC5B4\uB97C \uC785\uC5D0 \uC62C\uB9AC\uB294
      \uAC74, 90\uB144 \uBB35\uC740 \uD45C\uC2DD \uC704\uC5D0 \uC0C8 \uD45C\uC2DD\uC744
      \uC0C8\uAE30\uB294 \uC77C\uC785\uB2C8\uB2E4. \uBCF8\uC778 \uC190\uC73C\uB85C
      \uC0C8\uACA8\uC57C \uD569\uB2C8\uB2E4. \uADF8\uAC8C \uCC98\uD615\uC790\uB2E8
      \uC808\uCC28\uC785\uB2C8\uB2E4. \uBB3C\uC5B4\uBCF4\uC2DC\uC9C0 \uC54A\uC73C\uC154\uB3C4
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629397
    m_Localized: "...\uC218\uD589\uC744 \uBA48\uCD9C \uC218 \uC788\uB294\uAC00. \uCC98\uC74C\uC73C\uB85C,
      \uBA85\uB839\uC11C \uBC16\uC5D0\uC11C \uBB3B\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629398
    m_Localized: "\uC11C\uAC80\uC774 \uCE7C\uC744 \uCE7C\uC9D1\uC5D0 \uB2E4\uC2DC
      \uC808\uBC18\uB9CC \uAF42\uC740 \uCC44\uB85C \uB454\uB2E4. \uCE7C\uB0A0 \uB05D
      \uC778\uC7A5\uC774 \uCE7C\uC9D1 \uC548\uC5D0 \uC7A0\uC2DC \uBA38\uBB38\uB2E4.
      \uB4E4\uC9C0\uB3C4 \uC54A\uACE0 \uB123\uC9C0\uB3C4 \uC54A\uB294 \uC790\uC138.
      \uBAA8\uB2E5\uBD88 \uBE5B\uC774 \uD55C \uBC88 \uD754\uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629399
    m_Localized: "\uBAA8\uB2E5\uBD88 \uC606. \uC774\uBE68\uBC14\uB78C\uC774 \uD759
      \uC704\uC5D0 \uBC18\uCBE4 \uC549\uC544 \uC788\uB2E4. \uCF54\uB97C \uB4E4\uC9C0
      \uC54A\uB294\uB2E4. \uADF8\uAC8C \uD3C9\uC18C\uC640 \uB2E4\uB978 \uC790\uC138\uB2E4.
      \uC190\uBAA9 \uD749\uD130\uB97C \uB2E4\uB978 \uC190\uC73C\uB85C \uD55C \uBC88
      \uB36E\uC5C8\uB2E4 \uB5C0\uB2E4. \uB2E4\uC74C \uBC1C\uC790\uAD6D \uC790\uB9AC\uB294
      \uBAA8\uB974\uB294 \uCC44."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629400
    m_Localized: "\uBAA8\uB2E5\uBD88\uC5D0\uC11C \uD55C \uBC88 \uBD88\uAF43\uC774
      \uD280\uC5B4 \uD759\uC5D0 \uB2FF\uB294\uB2E4. \uD759 \uC704\uC5D0\uC11C \uC9E7\uAC8C
      \uBE5B\uB0AC\uB2E4 \uC0AC\uB77C\uC9C4\uB2E4. \uC774\uBE68\uBC14\uB78C\uC774
      \uADF8 \uC790\uAD6D\uC744 \uBCF8\uB2E4. \uC785\uC740 \uB2E4\uBB3C\uACE0 \uC788\uB2E4.
      \uC0AC\uC6A9\uC790\uAC00 \uCCAB \uB9C8\uB514\uB97C \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629401
    m_Localized: "...\uB204\uC124\uC774\uC57C. \uAC70\uBD80 \uC548 \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629402
    m_Localized: "\uB2E4\uB9CC \uADF8 \uB204\uC124\uC774 \uC0B4\uB9B0 \uBC1C\uC790\uAD6D\uC774\uB791
      \uBD80\uC21C \uBC1C\uC790\uAD6D \u2014 \uAC19\uC740 \uC790\uB9AC\uC5D0\uC11C
      \uBABB \uC138. \uADF8\uAC8C \uC0AC\uB0E5\uAFBC\uC774 \uC544\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629403
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uD749\uD130\uC5D0\uC11C \uC190\uC744
      \uB5C0\uB2E4. \uBAA8\uB2E5\uBD88 \uB108\uBA38 \uBE48 \uC790\uB9AC\uB97C \uBCF8\uB2E4
      \u2014 \uD68C\uC870\uAC00 \uC549\uC544\uC57C \uD588\uB358 \uC790\uB9AC. \uADF8
      \uC790\uB9AC\uC5D0\uB294 \uC0C8 \uBC1C\uC790\uAD6D\uC774 \uD55C \uAC1C\uB3C4
      \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629404
    m_Localized: "\uB0C4\uC0C8\uAC00 \uB2E4\uB974\uB2E4\uB294 \uB9D0, \uADF8 \uC790\uB9AC\uC5D0\uC120
      \uBABB \uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629405
    m_Localized: "\uBAA8\uB2E5\uBD88\uC5D0\uC11C \uC0C8 \uBD88\uAF43 \uD558\uB098\uAC00
      \uD759\uC5D0 \uB5A8\uC5B4\uC9C4\uB2E4. \uC774\uBC88\uC5D0\uB294 \uBE5B\uC774
      \uB354 \uC9E7\uB2E4. \uC774\uBE68\uBC14\uB78C\uC774 \uC190\uBAA9 \uD749\uD130\uB97C
      \uC637\uC136 \uC548\uC5D0 \uB2E4\uC2DC \uB123\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629406
    m_Localized: "\uC57C\uC601\uC9C0\uC758 \uAC00\uC7A5 \uC5B4\uB450\uC6B4 \uC790\uB9AC.
      \uC774\uBE68\uBC14\uB78C\uC774 \uC190\uBAA9 \uD749\uD130\uB97C \uC190\uAC00\uB77D\uC73C\uB85C
      \uCC9C\uCC9C\uD788 \uB530\uB77C \uADF8\uB9B0\uB2E4. \uB450 \uD615\uC81C\uAC00
      \uAC19\uC740 \uC758\uB840\uC5D0\uC11C \uD55C \uBC88 \uAC19\uC774 \uBC1B\uC558\uB358
      \uC790\uAD6D. \uC0C8 \uBC1C\uC790\uAD6D \uC18C\uB9AC\uAC00 \uBA40\uB9AC\uC11C
      \uB4E4\uB9B0\uB2E4 \u2014 \uBB34\uB9AC\uC758 \uBC1C\uC790\uAD6D\uC774 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629407
    m_Localized: "...\uD615\uC81C\uB77C\uB294 \uB9D0\uC774 \uC9C0\uAE08\uB3C4 \uC785\uC5D0\uC11C
      \uB098\uC640. \uB2E4\uB978 \uB9D0\uC744 \uBABB \uCC3E\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629408
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uC2DC\uC120\uC744 \uC0AC\uC6A9\uC790
      \uCABD\uC73C\uB85C \uC7A0\uC2DC \uC62E\uAE34\uB2E4. \uC9C1\uC811 \uBCF4\uC9C0\uB294
      \uC54A\uB294\uB2E4. \uBAA8\uB2E5\uBD88\uC744 \uD1B5\uD574 \uBCF8\uB2E4. \uC0AC\uC6A9\uC790\uAC00
      \uB2F5\uC744 \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629409
    m_Localized: "\uBBFF\uC74C\uC774 \uC544\uB2C8\uB77C \uAE30\uB2E4\uB9BC\uC774\uC57C.
      \uB2E4\uB978 \uD615\uD0DC\uC758 \uAC19\uC740 \uAC70\uB9AC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629410
    m_Localized: "\uB0B4\uAC00 \uBD80\uB974\uB294 \uB3D9\uC548\uC740 \uADF8 \uB9D0\uC774
      \uC0B4\uC544 \uC788\uC5B4. \uADF8\uAC83\uBFD0\uC774\uC57C. \uD68C\uC870 \uBC1C\uC790\uAD6D\uC774
      \uC5B4\uB290 \uBC29\uD5A5\uC73C\uB85C \uAC00\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629411
    m_Localized: "...\uC0AC\uC721\uC7A5\uC5D0\uC11C \uB0C9\uC2DC\uAC00 \uADF8\uB7AC\uC5B4.
      \uB2E8\uB9B0\uC758 \uC0AC\uC81C\uBCF5\uC774 \uC5B4\uB460\uC5D0\uC11C \uB108\uBB34
      \uC798 \uBCF4\uC778\uB2E4\uACE0. \uCC28\uAC00\uC6B4 \uB9D0\uC778\uB370 \u2014
      \uB530\uB73B\uD55C \uBC1C\uC790\uAD6D\uC774\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629412
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uD749\uD130\uC5D0\uC11C \uC190\uC744
      \uB5C0\uB2E4. \uBAA8\uB2E5\uBD88 \uBE5B\uC774 \uD749\uD130 \uC790\uAD6D\uC5D0\uC11C
      \uD55C \uBC88 \uB354 \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629413
    m_Localized: "\uD68C\uC870\uAC00 \uD68C\uB2F4\uC5D0 \uC548 \uC640. \uC640\uB3C4
      \uAC19\uC740 \uC790\uB9AC\uC5D0 \uBABB \uC549\uC544. \uADF8\uAC8C \uBD84\uB9AC\uD30C\uC758
      \uD1A0\uD15C\uC774\uC57C. \uBC1B\uC744 \uC218\uBC16\uC5D0 \uC5C6\uB294 \uBB34\uAC8C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629414
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uCF54\uB97C \uD55C \uBC88 \uB4E0\uB2E4.
      \uADF8\uB7EC\uB098 \uBC14\uB78C\uC744 \uB05D\uAE4C\uC9C0 \uC77D\uC9C0 \uC54A\uB294\uB2E4.
      \uC77C\uC5B4\uC120\uB2E4. \uCC9C\uB9C9 \uC785\uAD6C\uB97C \uD5A5\uD574 \uD55C
      \uBC1C \u2014 \uADF8\uB7EC\uB2E4 \uBA48\uCD98\uB2E4. \uC190\uBAA9 \uD749\uD130\uC5D0
      \uD55C \uBC88 \uB354 \uC190\uC774 \uB2FF\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629415
    m_Localized: "\uADF8 \uD6C4 \uBC1C\uC790\uAD6D \uD55C \uAC1C\uAC00 \uCC9C\uB9C9
      \uBC16\uC73C\uB85C. \uC0AC\uC6A9\uC790 \uCABD\uC73C\uB85C \uB3CC\uC544\uBCF4\uC9C0
      \uC54A\uB294\uB2E4. \uD749\uD130\uB97C \uC637\uC136 \uC548\uC5D0 \uB123\uC9C0
      \uC54A\uC740 \uCC44\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629416
    m_Localized: "\uC57C\uC601\uC9C0 \uBAA8\uB2E5\uBD88 \uC606. \uC774\uBE68\uBC14\uB78C\uC774
      \uC5B4\uAE68\uC5D0\uC11C \uD1A0\uD15C \uBCF4\uD638\uB300\uB97C \uD480\uC5B4
      \uBB34\uB98E \uC704\uC5D0 \uB193\uB294\uB2E4. \uAC80\uC740 \uCE60\uC774 \uD55C
      \uC904\uB85C \uADF8\uC5B4\uC838 \uC788\uB2E4. \uC190\uAC00\uB77D\uC774 \uCE60
      \uBD80\uBD84\uC744 \uB530\uB77C\uAC04\uB2E4. \uD55C \uBC88. \uB450 \uBC88.
      \uCE60\uC774 \uC605\uC5B4\uC9C0\uC9C0\uB9CC \uC790\uAD6D\uC740 \uB0A8\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629417
    m_Localized: "\uAC80\uC740 \uCE60\uC740 \uC601\uAD6C \uB2E8\uC808\uC774 \uC544\uB2C8\uC57C.
      \uADF8\uAC8C \uC774\uB9AC\uC194 \uC758\uB840\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629418
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uCE60 \uBD80\uBD84\uC5D0\uC11C
      \uC190\uC744 \uB5BC\uC9C0 \uC54A\uB294\uB2E4. \uBAA8\uB2E5\uBD88 \uBE5B\uC774
      \uCE60 \uC790\uAD6D\uC5D0 \uBA38\uBB38\uB2E4. \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744
      \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629419
    m_Localized: "\uBBFF\uC74C\uC774 \uC544\uB2C8\uB77C \uC758\uB840\uC57C. \uC758\uB840\uC5D0
      \uB2F5\uC744 \uAC15\uC694 \uC548 \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629420
    m_Localized: "\uC774\uB9AC\uC194 \uC758\uB840\uB294 \uC2DC\uAC04\uC744 \uACAC\uB514\uB294
      \uAC70\uC57C. \uACB0\uACFC\uB97C \uAC15\uC694\uD558\uB294 \uAC8C \uC544\uB2C8\uACE0.
      \uAC80\uC740 \uCE60\uC774 \uD480\uC5B4\uC9C0\uB294 \uC790\uB9AC\uB294 \uD68C\uC870\uAC00
      \uC815\uD574. \uC758\uB840\uB294 \uADF8 \uC790\uB9AC\uB97C \uBE44\uC6CC \uB46C."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629421
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uD1A0\uD15C \uBCF4\uD638\uB300\uB97C
      \uB2E4\uC2DC \uC5B4\uAE68\uC5D0 \uAC78\uCE5C\uB2E4. \uAC80\uC740 \uCE60\uC774
      \uBE5B \uC544\uB798\uC5D0\uC11C \uD55C \uBC88 \uD750\uB824\uC84C\uB2E4 \uB2E4\uC2DC
      \uB610\uB837\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629422
    m_Localized: "\uB2E8\uB9B0\uC774 \uC0AC\uC81C \uC778\uC7A5\uC744 \uCC45\uC0C1\uC5D0
      \uB450\uACE0 \uC77C\uC5B4\uC120 \uAC70. \uBB35\uD5A5\uC774 \uC9C0\uD321\uC774
      \uC885\uC744 \uB2E8\uB9B0\uC5D0\uAC8C \uBCF4\uB0B8 \uAC70. \uB458 \uB2E4 \uC190\uC5D0\uC11C
      \uC9D0\uC744 \uB0B4\uB824\uB193\uC740 \uAC70\uC57C. \uC0AC\uB0E5\uAC10\uC774
      \uC544\uB2C8\uB77C, \uB108\uBB34 \uC624\uB798 \uB4E4\uACE0 \uC788\uB358 \uAC83."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629423
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uCC98\uC74C\uC73C\uB85C \uC5B4\uAE68
      \uBCF4\uD638\uB300\uB97C \uBCF4\uBA74\uC11C \uBBF8\uC138\uD558\uAC8C \uBBF8\uC18C
      \uC9D3\uB294\uB2E4. \uADF8 \uBBF8\uC18C\uAC00 \uD749\uD130\uC758 \uD754\uC801\uACFC
      \uD55C \uC790\uB9AC\uC5D0\uC11C \uB9CC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629424
    m_Localized: "\uAC80\uC740 \uCE60\uC740 \uC601\uAD6C\uAC00 \uC544\uB2C8\uC57C.
      \uADF8\uAC83\uB9CC \uC54C\uC544 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629425
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uC5B4\uAE68 \uBCF4\uD638\uB300\uB97C
      \uB4F1\uC9C0\uACE0 \uC57C\uC601\uC9C0\uB97C \uD55C \uBC14\uD034 \uB3C8\uB2E4.
      \uCF54\uB97C \uD55C \uBC88 \uB4E0\uB2E4. \uBC14\uB78C\uC744 \uC77D\uB294\uB2E4.
      \uD3C9\uC18C\uC758 \uC790\uC138\uAC00 \uAC70\uC758 \uB3CC\uC544\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629426
    m_Localized: "\uC57C\uC601\uC9C0 \uBAA8\uB2E5\uBD88 \uC606. \uD48D\uC758\uAC00
      \uC758\uB840 \uC9C0\uD321\uC774\uC758 \uD1A0\uD15C \uB9E4\uB4ED\uC744 \uD480\uC5B4
      \uC190\uAC00\uB77D \uC0AC\uC774\uB85C \uD1B5\uACFC\uC2DC\uD0A8\uB2E4. \uB2E4\uC12F
      \uAC1C\uC758 \uB9E4\uB4ED\uC774 \uCC28\uB840\uB85C \uC9C0\uB098\uAC04\uB2E4.
      \uB2E4\uC12F \uBC88\uC9F8 \uB9E4\uB4ED\uC740 \uD3C9\uC18C\uBCF4\uB2E4 \uC624\uB798
      \uBA38\uBB38\uB2E4 \u2014 \uCEA0\uD398\uC778 \uC911 \uCD94\uAC00\uB41C \uB9E4\uB4ED.
      \uC783\uC740 \uC790\uB4E4\uC758 \uD45C\uC2DC. \uC9C0\uD321\uC774 \uC885\uC774
      \uB05D\uC5D0\uC11C \uAC00\uBCCD\uAC8C \uC6B4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629427
    m_Localized: "...\uC783\uC5B4\uBC84\uB9B0 \uC790\uB97C \uC704\uD55C \uB178\uB798\uB97C
      \uAC00\uB974\uCCD0\uB4DC\uB9B4\uAE4C\uC694. \uBC15\uC790\uB9CC \uB530\uB77C\uC624\uC2DC\uBA74
      \uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629428
    m_Localized: "\uD48D\uC758\uAC00 \uC0AC\uC6A9\uC790 \uCABD\uC73C\uB85C \uC2DC\uC120\uC744
      \uC62E\uAE34\uB2E4. \uAD8C\uC720\uC870\uC774\uC9C0\uB9CC \uBB34\uAC8C\uAC00
      \uC788\uB2E4. \uC0AC\uC6A9\uC790\uAC00 \uB2F5\uC744 \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629429
    m_Localized: "...\uACAC\uB518 \uAC8C \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629430
    m_Localized: "\uC9C1\uCC45\uC774 \uB5A0\uB118\uACA8\uC84C\uC5B4\uC694. \uC61B
      \uB300\uC758\uB840\uC0AC \uC2A4\uC2B9\uC774 \uBCC0\uBC29 \uBD84\uC7C1 \uB54C
      \uAC00\uC168\uACE0, \uC758\uB840\uAC00 \uC800\uC5D0\uAC8C \uC654\uC5B4\uC694.
      \uB5A0\uB118\uAE34 \uBD84\uC744 \uC6D0\uB9DD\uD558\uC9C0 \uC54A\uC740 \uAC83\uC774
      30\uB144\uC758 \uC758\uB840\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629431
    m_Localized: "\uD48D\uC758\uAC00 \uB2E4\uC12F \uBC88\uC9F8 \uB9E4\uB4ED\uC744
      \uC7A0\uC2DC \uB354 \uD480\uC5B4 \uB450\uC5C8\uB2E4 \uB2E4\uC2DC \uBB36\uB294\uB2E4.
      \uADF8 \uB9E4\uB4ED\uC5D0 \uBB3B\uC740 \uD759 \uD55C \uC54C\uC774 \uC190\uBC14\uB2E5\uC73C\uB85C
      \uB5A8\uC5B4\uC9C4\uB2E4 \u2014 \uCEA0\uD398\uC778 \uC911 \uC5B4\uB518\uAC00\uC5D0\uC11C
      \uBB3B\uC740 \uC790\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629432
    m_Localized: "...\uB465. \uB465. \uB465\uB465. \uB465."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629433
    m_Localized: "\uD48D\uC758\uC758 \uBC15\uC790\uAC00 \uBAA8\uB2E5\uBD88\uC758
      \uD754\uB4E4\uB9BC\uACFC \uB9DE\uBB3C\uB9B0\uB2E4. \uC0AC\uC6A9\uC790\uC758
      \uD638\uD761\uC774 \uADF8 \uBC15\uC790\uC5D0 \uB9DE\uCDB0\uC9C4\uB2E4. \uC758\uB840\uC758
      \uD6A8\uACFC \u2014 \uBC15\uC790 \uB3D9\uAE30\uD654 \uC790\uCCB4. \uC9C0\uD321\uC774
      \uC885\uC774 \uB9E4 \uBC15\uC790\uB9C8\uB2E4 \uC791\uAC8C \uC6B4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629434
    m_Localized: "...\uC0B0 \uC790\uAC00 \uC790\uAE30 \uAE38\uC744 \uCC3E\uB294 \uC758\uB840\uC608\uC694.
      \uC8FD\uC740 \uC790\uB97C \uC704\uD55C \uAC8C \uC544\uB2C8\uC5D0\uC694. \uB2E8\uB9B0
      \uC0AC\uC81C\uB2D8\uAED8 \uAC19\uC740 \uBC15\uC790\uB97C \uAC00\uB974\uCCE4\uC5B4\uC694.
      \uADF8\uBD84\uC758 \uC0AC\uC81C \uC778\uC7A5\uC774 \uD480\uB9B0 \uC790\uB9AC\uC5D0\uC11C
      \uADF8 \uBC15\uC790\uAC00 \uD55C \uB2F5\uC774 \uB410\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629435
    m_Localized: "...\uB2F9\uC2E0 \uCABD \uBD80\uC0C1\uC790\uB3C4 \uAC19\uC740 \uD53C\uC608\uC694.
      \uC774\uB9AC\uC194\uC5D0\uC11C\uB294 \uADF8\uB807\uAC8C \uBC30\uC6E0\uC2B5\uB2C8\uB2E4.
      \uC544\uB2C8, \uB354 \uC815\uD655\uD788\uB294 \u2014 \uC6B0\uB9AC \uC528\uC871\uC774
      \uADF8\uB807\uAC8C \uC0B4\uC544\uC654\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629436
    m_Localized: "\uD48D\uC758\uAC00 \uC758\uB840 \uC9C0\uD321\uC774\uB97C \uC606\uC5D0
      \uB450\uACE0 \uC9C0\uD321\uC774 \uC885\uC744 \uD55C \uBC88 \uB354 \uD754\uB4E0\uB2E4.
      \uC885 \uC18C\uB9AC\uAC00 \uBAA8\uB2E5\uBD88 \uB05D\uAE4C\uC9C0 \uC7A0\uC2DC
      \uB0A8\uB294\uB2E4. \uB2E4\uC12F \uBC88\uC9F8 \uB9E4\uB4ED\uC5D0 \uC190\uAC00\uB77D\uC774
      \uB2E4\uC2DC \uB2FF\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629437
    m_Localized: "\uC57C\uC601\uC9C0 \uD55C \uC790\uB9AC. \uC232\uC0B4\uC774\uAC00
      \uBA38\uB9AC\uB760\uB97C \uB9CC\uC9C0\uB824 \uC190\uC744 \uC62C\uB9B0\uB2E4.
      \uC190\uC774 \uBA38\uB9AC\uB760 \uC55E\uC5D0\uC11C \uBA48\uCDC4\uB2E4\uAC00,
      \uD5C8\uB9AC\uC758 \uB450 \uB2E8\uAC80\uC744 \uCC28\uB840\uB85C \uD655\uC778\uD55C\uB2E4
      \u2014 \uC194\uB77C\uB8F8 \uD45C\uC900 \uB2E8\uAC80 \uD55C \uC790\uB8E8, \uC774\uB9AC\uC194
      \uC0AC\uB0E5\uC6A9 \uB2E8\uAC80 \uD55C \uC790\uB8E8. \uD3C9\uC18C\uC758 \uB18D\uB2F4
      \uC9C1\uC804 \uC790\uC138\uAC00 \uB04A\uAE34 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629438
    m_Localized: "...\uC591\uCABD \uB2E4 \uC8C4\uC9C0\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uAC8C
      \uBCC0\uACBD\uC758 \uC9C4\uC2E4\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629439
    m_Localized: "\uC785\uAC00\uC5D0 \uBBF8\uC18C\uAC00 \uC62C\uB77C\uC624\uB2E4
      \uB2E8\uAC80 \uB05D\uC5D0\uC11C \uB04A\uAE34\uB2E4. \uC0AC\uC6A9\uC790\uAC00
      \uB2F5\uC744 \uACE0\uB97C \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629440
    m_Localized: "\uC9E7\uC740 \uBBF8\uC18C\uAC00 \uB2E8\uAC80 \uB05D\uC5D0\uC11C
      \uB04A\uAE34\uB2E4. \uBA38\uB9AC\uB760\uB97C \uB9CC\uC9C0\uC9C0 \uC54A\uC740
      \uCC44 \uB2F5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629441
    m_Localized: "...\uC790\uC720\uB294 \uBE44\uC2F8\uC694. \uBD80\uBAA8\uB2D8 \uB450
      \uBD84 \uB2E4 \uBCC0\uACBD \uBD84\uC7C1\uC5D0\uC11C \uAC00\uC168\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629442
    m_Localized: "\uC591\uCABD \uB2E8\uAC80\uC744 \uBC1B\uC558\uB294\uB370 \u2014
      \uBD80\uC758 \uC194\uB77C\uB8F8 \uB2E8\uAC80\uACFC \uBAA8\uC758 \uC774\uB9AC\uC194
      \uB2E8\uAC80. \uD55C \uC790\uB8E8\uC529 \uBC1B\uC744 \uB54C\uB9C8\uB2E4 \uAC00\uC871\uC774
      \uD55C \uBA85\uC529 \uC904\uC5C8\uC5B4\uC694. \uADF8\uB7EC\uB2C8\uAE4C \uC790\uC720\uB77C\uB294
      \uB9D0\uB85C\uB294 \uC880 \uBE44\uC2F8\uC694. \uC81C \uB9D0\uB85C \uD558\uBA74
      \uADF8\uB0E5 \u2014 \uB450 \uC790\uB8E8\uB97C \uAC19\uC774 \uCC28\uB294 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629443
    m_Localized: "\uC232\uC0B4\uC774\uAC00 \uB450 \uB2E8\uAC80 \uC790\uB8E8\uB97C
      \uD55C \uBC88 \uBCF8\uB2E4. \uC194\uB77C\uB8F8 \uB2E8\uAC80\uACFC \uC774\uB9AC\uC194
      \uB2E8\uAC80\uC774 \uAC19\uC740 \uD5C8\uB9AC\uC5D0 \uAC78\uB9B0 \uCC44. \uBAA8\uB2E5\uBD88
      \uBE5B\uC774 \uB450 \uC790\uB8E8 \uB05D\uC5D0\uC11C \uAC19\uC740 \uBC15\uC790\uB85C
      \uBA38\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629444
    m_Localized: "\uAE38\uC740 \uB458\uC778\uB370, \uBC1C\uC790\uAD6D\uC740 \uD558\uB098\uB9CC
      \uB0A8\uB354\uB77C\uACE0\uC694. \uADF8\uB798\uC11C \uC81C\uAC00 \uC815\uCC30\uBCD1\uC774
      \uB410\uB098 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19023179971629445
    m_Localized: "\uC232\uC0B4\uC774\uAC00 \uCC98\uC74C\uC73C\uB85C \uBA38\uB9AC\uB760\uB97C
      \uB9CC\uC9C4\uB2E4. \uD3C9\uC18C\uC758 \uC790\uC138\uAC00 \uC7A0\uAE50 \uB3CC\uC544\uC654\uC9C0\uB9CC
      \uBBF8\uC18C\uB294 \uD3C9\uC18C\uBCF4\uB2E4 \uC9E7\uB2E4. \uBAA8\uB2E5\uBD88\uC5D0\uC11C
      \uD55C \uBC88 \uC791\uC740 \uBD88\uAF43\uC774 \uD759\uC73C\uB85C \uB5A8\uC5B4\uC9C4\uB2E4.
      \uB450 \uB2E8\uAC80 \uC790\uB8E8\uC758 \uBE5B\uC774 \uADF8 \uC790\uAD6D \uC704\uC5D0\uC11C
      \uD55C \uBC88 \uB354 \uB9CC\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739132719104
    m_Localized: "\uC0AC\uB78C\uC744 \uBA85\uB839\uC73C\uB85C \uBE44\uC6CC \uB193\uACE0,
      \uADF8 \uBA85\uB839\uC744 \uB204\uAC00 \uB0B4\uB838\uB294\uC9C0\uB294 \uC544\uBB34\uB3C4
      \uC548 \uC801\uC5B4 \uB1A8\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739166273536
    m_Localized: "\uB204\uAC00 \uB0B4\uB838\uB294\uC9C0\uB294, \uC774 \uC5B4\uC870\uAC00
      \uB9D0\uD569\uB2C8\uB2E4. \uC774\uAC74 \uD559\uD30C\uC758 \uB9D0\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739166273537
    m_Localized: "\uD55C\uC0C8\uAC00 \uBA85\uBD80\uB97C \uB36E\uC73C\uB824\uB2E4
      \uBA48\uCD98\uB2E4. \uBCC0\uBC29\uBB38 \uCABD \uD398\uC774\uC9C0\uC5D0 \uC190\uAC00\uB77D\uC744
      \uB454\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739166273538
    m_Localized: "\uD55C \uAC00\uC9C0 \uB354 \uC801\uACA0\uC2B5\uB2C8\uB2E4. \uBCC0\uBC29\uBB38
      \uC548\uCABD\uC5D0\uC11C \uB098\uC628 \uADF8 '\uBA85\uB839\uC758 \uC5B4\uC870'
      \u2014 \uC7BF\uACE8 \uC61B \uAE30\uB85D\uC5D0 \uBE44\uC2B7\uD55C \uAC8C \uC788\uC5B4\uC694.
      \uD574\uC548 \uCABD, 40\uB144 \uC804\uC5D0 \uB2EB\uD614\uB2E4\uB294 \uAC00\uB77C\uC549\uC740
      \uBCF4\uB8E8. \uADF8 \uBD09\uC778\uC774 \uCD5C\uADFC \uB2E4\uC2DC \uCC0D\uD614\uB2E4\uB294
      \uC815\uCC30 \uBCF4\uACE0\uAC00 \uB4E4\uC5B4\uC640 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739166273539
    m_Localized: "\uB2EB\uD78C \uBB38\uC5D0\uC11C \uC0C8 \uBD09\uC778 \uB0C4\uC0C8.
      ...\uB2E4\uC74C\uC740 \uAC70\uAE30\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739166273540
    m_Localized: "\uB2E8\uB9B0\uC774 \uD55C\uC0C8\uAC00 \uAC00\uB9AC\uD0A8 \uBD09\uC778
      \uAE30\uB85D\uC744 \uD55C\uCC38 \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739166273541
    m_Localized: "\uB2EB\uD78C \uBB38\uC5D0 \uC0C8 \uBD09\uC778\uC774\uB77C\uBA74
      \u2014 \uB2EB\uD78C \uAC74 \uBB38\uC774 \uC544\uB2C8\uC5C8\uACA0\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467840
    m_Localized: "...\uB530\uB73B\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467841
    m_Localized: "\uACF5\uD55C\uC774 \uCC3B\uC794\uC744 \uB450 \uC190\uC73C\uB85C
      \uAC10\uC2FC\uB2E4. \uB2E8\uB9B0\uC774 \uADF8 \uBAA8\uC2B5\uC744 \uBCF8\uB2E4.
      \uC624\uB298 \uBA85\uBD80\uC758 \uBE48 \uC904\uC740 \uBE44\uC6CC \uB450\uC9C0
      \uC54A\uC558\uB2E4 \u2014 \uB450 \uC904\uC774 \uC0C8\uB85C \uCC3C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467842
    m_Localized: "\uC7BF\uACE8 \uAC70\uC810. \uB3CC\uC544\uC628 \uC0AC\uB78C \uC218\uAC00
      \uB098\uAC04 \uC218\uBCF4\uB2E4 \uC801\uB2E4. \uD55C\uC0C8\uAC00 \uBA85\uBD80\uC758
      \uBE48 \uC904\uC5D0 \uAC00\uB85C\uC904\uC744 \uAE0B\uC9C0 \uC54A\uB294\uB2E4.
      \uADF8 \uC790\uB9AC\uC5D0 \uC190\uC744 \uC5B9\uC740 \uCC44 \uD55C\uCC38 \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467843
    m_Localized: "\uC774\uBC88\uC5D4... \uD55C \uC790\uB9AC\uAC00 \uBE44\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC774\uB984\uC740 \uC9C0\uC6B0\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uBE44\uC6CC
      \uB450\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467844
    m_Localized: "\uBE44\uC6CC \uB46C. \uCC44\uC6B0\uC9C0 \uB9D0\uACE0. \uBE48 \uC790\uB9AC\uB3C4
      \uBA85\uB2E8\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467845
    m_Localized: "\uD45C\uBCF8\uC774 \uC544\uB2C8\uB77C \uC0AC\uB78C\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC808\uCC28\uC758 \uC148\uC5D0\uC11C 0\uC774 \uB418\uC9C0 \uC54A\uAC8C, \uC6B0\uB9AC\uAC00
      1\uB85C \uAE30\uC5B5\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467846
    m_Localized: "...\uC624\uB298\uC740 \uB18D\uB2F4 \uC548 \uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467847
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uC190\uBAA9\uC744 \uB0B4\uB824\uB2E4\uBCF8\uB2E4.
      \uC5F0\uC8FC\uAC00 \uB3CC\uB824\uC900 \uD53C\uC758 \uC11C\uC57D \uB048\uC774
      \uAC10\uACA8 \uC788\uB2E4. \uB9E4\uB4ED\uC740 \uC544\uC9C1 \uC9D3\uC9C0 \uC54A\uC740
      \uCC44\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467848
    m_Localized: "\uC548 \uBB36\uC5B4. \uC544\uC9C1\uC740. ...\uADFC\uB370 \uB04A\uC9C0\uB3C4
      \uC54A\uC544. \uD615\uC81C\uAC00 \uAC70\uAE30\uAE4C\uC9C0 \uC654\uC73C\uBA74,
      \uB098\uB3C4 \uC5EC\uAE30\uAE4C\uC9C0\uB294 \uBE44\uC6CC \uB450\uB294 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739170467849
    m_Localized: "\uC774\uBE68\uBC14\uB78C\uC774 \uCE7C\uC9D1 \uC2E0\uD638\uB97C
      \uB0B8 \uD611\uACE1 \uBC14\uB2E5\uC744 \uD55C\uCC38 \uBCF8\uB2E4. \uB450 \uBC88\uC9F8
      \uB3CC\uC18C\uB9AC\uB294 \uC624\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB798\uB3C4
      \uADF8\uB294 \uC11C\uB450\uB974\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 19549739174662144
    m_Localized: "\uBE48 \uC790\uB9AC (squad \uC190\uC2E4 acknowledgement)"
    m_Metadata:
      m_Items: []
  - m_Id: 19549739174662145
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 21971942738563072
    m_Localized: "\uB9C9\uC544\uC120 \uAC81\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942797283328
    m_Localized: "\uAE30\uB2E4\uB9AC\uB294 \uC790\uC138\uC57C. \uC6B0\uB9AC\uB97C
      \uAE30\uB2E4\uB9B0 \uAC74 \uC544\uB2C8\uACE0 \u2014 \uC800 \uC790\uB9AC\uC5D0
      \uC544\uC8FC \uC624\uB798 \uC11C \uC788\uC5C8\uB358 \uC0AC\uB78C\uC774\uC57C.
      \uC0B0 \uC0AC\uB78C\uC778\uB370 \uC6C0\uC9C1\uC784\uC774 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942797283329
    m_Localized: "\uADF8 \uD55C \uB2E8\uC5B4\uB294 \uAC78\uC73C\uBA74\uC11C \uD480\uC5B4.
      \uD615\uC81C\uAC00 \uC774 \uC55E\uC5D0 \uC788\uC5B4. \uB354\uB294 \uBABB \uAE30\uB2E4\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942797283330
    m_Localized: "...\uD68C\uC870 \uB9D0\uC785\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942797283331
    m_Localized: "\uB0C4\uC0C8\uB294 \uC9C4\uC791 \uC7A1\uC558\uC5B4. \uB108\uD55C\uD14C
      \uB9D0 \uC548 \uD55C \uAC74 \u2014 \uC785\uC5D0 \uC62C\uB9AC\uBA74 \uC9C4\uC9DC\uAC00
      \uB418\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942797283332
    m_Localized: "\uB2E8\uB9B0\uC774 \uBB35\uC8FC\uB97C \uC790\uC218 \uC548\uC8FC\uBA38\uB2C8\uC5D0
      \uB123\uB294\uB2E4. \uC678\uD22C \uC790\uB77D \uB05D\uC73C\uB85C \uACE0\uC9C4\uC758
      \uAC11\uC637 \uC548\uCABD, \uADF8\uAC00 \uC0C8\uAE34 \uC774\uB984 \uC704\uB97C
      \uD55C \uBC88 \uB36E\uACE0 \uC77C\uC5B4\uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477632
    m_Localized: "\uAC00\uBCBC\uC6B4 \uAE30\uC5B5\uC740 \uBC8C\uC368 \uB2E4 \uD314\uB838\uAC70\uB4E0.
      \uB0A8\uC740 \uAC74 \uB300\uAC1C \uBB34\uAC81\uB2E4\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477633
    m_Localized: "\uB0B4 \uC774\uB984\uC740 \uC5B4\uB5BB\uAC8C \uC801\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477634
    m_Localized: "\uC774\uB984\uC740 \uC544\uC9C1 \uB2EB\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.
      \uACB0\uC0AC \uD6C4\uC608\uC600\uB358 \uC790, \uC9C0\uAE08\uC740 \uBB38\uBC16\uC758
      \uC99D\uC5B8\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477635
    m_Localized: "...\uCDA9\uBD84\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477636
    m_Localized: "\uC7BF\uACE8 \uC815\uCC30 \uAE38\uB4DC \uAC70\uC810. \uD55C\uC0C8\uAC00
      \uBA85\uB2E8\uC744 \uD3BC\uCCD0 \uB454 \uCC44 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2E4.
      \uAC15\uC639\uC758 \uB0A1\uC740 \uD654\uC0B4\uD1B5\uC774 \uCC9C\uB9C9 \uAE30\uB465\uC5D0
      \uAE30\uB300\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477637
    m_Localized: "\uB2E8\uB9B0\uACFC \uC774\uBE68\uBC14\uB78C\uC774 \uB4E4\uC5B4\uC628\uB2E4.
      \uB450 \uC790\uB8E8\uC758 \uD770 \uB048\uC5D0 \uC7BF\uACE8 \uD759\uACFC \uB291\uB300\uC18C\uB098\uBB34
      \uAE38\uC758 \uC7AC\uAC00 \uD568\uAED8 \uBB3B\uC5B4 \uC788\uB2E4. \uD55C\uC0C8\uC758
      \uC2DC\uC120\uC774 \uADF8 \uB048\uC5D0 \uBA3C\uC800 \uB2FF\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477638
    m_Localized: "\uB3CC\uC544\uC624\uC168\uAD70\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477639
    m_Localized: "...\uD55C \uC904 \uB354 \uC801\uC5B4 \uC8FC\uC138\uC694. \uC61B
      \uBCC0\uBC29\uBB38 \uC218\uBB38\uC7A5 \uACE0\uC9C4. \uADF8\uB9AC\uACE0 \uD68C\uC870."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477640
    m_Localized: "\uD68C\uC870\uB294 \uC8FD\uC74C\uC73C\uB85C \uC801\uC9C0 \uB9C8.
      \uC0B4\uC544\uC11C \uBA40\uC5B4\uC84C\uB2E4\uACE0 \uC368."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477641
    m_Localized: "\uD55C\uC0C8\uAC00 \uD39C \uB05D\uC744 \uBA48\uCD98\uB2E4. \uC9E7\uAC8C
      \uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477642
    m_Localized: "\uC0DD\uC874. \uBD84\uB9AC \uB178\uC120. \uD615\uC81C \uC904\uC740
      \uB2EB\uC9C0 \uC54A\uC74C. \uADF8\uB807\uAC8C \uC801\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477643
    m_Localized: "\uAC15\uC639 \uC5B4\uB978\uAED8\uB294... \uBB34\uC5C7\uC744 \uBD24\uB4E0
      \uC804\uD558\uACA0\uB2E4\uACE0 \uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477644
    m_Localized: "\uC804\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uB450 \uBD84\uC740 \uC26C\uC2DC\uC624.
      \uB2E4\uC74C \uAE38\uC740 \uB354 \uC548\uCABD\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21971942801477645
    m_Localized: "\uD55C\uC0C8\uAC00 \uBA85\uB2E8 \uB05D\uC5D0 \uD55C \uC904\uC744
      \uB354 \uC4F4\uB2E4. \uD770 \uB048 \uB450 \uC904\uC774 \uCC9C\uB9C9 \uC785\uAD6C
      \uBC14\uB78C\uC5D0 \uC870\uC6A9\uD788 \uD754\uB4E4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496683823104
    m_Localized: Aegis Sentinel
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183232
    m_Localized: "\uC6D0\uC815\uB300\uAC00 \uCC98\uC74C\uC73C\uB85C \uC870\uC6B0\uD55C
      \uAC01\uC131 Relicborn. \uACA9\uC790 \uB178\uB4DC \uD558\uB098\uAC00 \uC644\uC804\uD788
      \uD30C\uAD34\uB418\uBA74\uC11C \uAC15\uC81C \uAC01\uC131\uD588\uC73C\uBA70,
      \uACA9\uC790 \uBCF5\uC6D0\uC774\uB77C\uB294 \uB300\uC758\uBCF4\uB2E4\uB294
      \uB208\uC55E\uC758 \uB178\uB4DC\uB97C \uC9C0\uD0A4\uACA0\uB2E4\uB294 \uBCF8\uB2A5\uC5D0
      \uAC00\uAE5D\uAC8C \uC6C0\uC9C1\uC778\uB2E4. \uC5B8\uC5B4 \uC18C\uD1B5\uC774
      \uADF9\uD788 \uC81C\uD55C\uC801\uC774\uACE0, \uC758\uC0AC \uD45C\uD604\uC740
      \uAC70\uC758 \uD589\uB3D9\uC73C\uB85C\uB9CC \uC774\uB8E8\uC5B4\uC9C4\uB2E4.
      \uC6D0\uC815\uB300\uB97C \uBCF4\uD638\uD558\uB294 \uC774\uC720\uB97C \uB9D0\uB85C
      \uC124\uBA85\uD55C \uC801\uC740 \uC5C6\uC9C0\uB9CC, \uC704\uAE30 \uC0C1\uD669\uC5D0\uC11C
      \uBC18\uBCF5\uC801\uC73C\uB85C \uC804\uC5F4\uC5D0 \uC11C\uB294 \uD589\uC704
      \uC790\uCCB4\uAC00 \uC2E0\uB8B0\uC758 \uC99D\uBA85\uC774 \uB41C\uB2E4. \uB9D0\uC774
      \uC544\uB2C8\uB77C \uBAB8\uC73C\uB85C \uC99D\uBA85\uD558\uB294 \uC874\uC7AC\uC774\uBA70,
      Relicborn\uC774 \uC801\uC774 \uC544\uB2D8\uC744 \uCC98\uC74C\uC73C\uB85C \uBCF4\uC5EC\uC8FC\uB294
      \uC0AC\uB840\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183233
    m_Localized: "Relicborn\uC758 \uBB38\uC9C0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183234
    m_Localized: "\uC6D0\uC815\uB300\uAC00 \uCC98\uC74C\uC73C\uB85C \uC870\uC6B0\uD55C
      \uAC01\uC131 Relicborn. \uACA9\uC790 \uB178\uB4DC \uD558\uB098\uAC00 \uC644\uC804\uD788
      \uD30C\uAD34\uB418\uBA74\uC11C \uAC15\uC81C \uAC01\uC131\uD588\uC73C\uBA70,
      \uACA9\uC790 \uBCF5\uC6D0\uC774\uB77C\uB294 \uB300\uC758\uBCF4\uB2E4\uB294
      \uB208\uC55E\uC758 \uB178\uB4DC\uB97C \uC9C0\uD0A4\uACA0\uB2E4\uB294 \uBCF8\uB2A5\uC5D0
      \uAC00\uAE5D\uAC8C \uC6C0\uC9C1\uC778\uB2E4. \uC5B8\uC5B4 \uC18C\uD1B5\uC774
      \uADF9\uD788 \uC81C\uD55C\uC801\uC774\uACE0, \uC758\uC0AC \uD45C\uD604\uC740
      \uAC70\uC758 \uD589\uB3D9\uC73C\uB85C\uB9CC \uC774\uB8E8\uC5B4\uC9C4\uB2E4.
      \uC6D0\uC815\uB300\uB97C \uBCF4\uD638\uD558\uB294 \uC774\uC720\uB97C \uB9D0\uB85C
      \uC124\uBA85\uD55C \uC801\uC740 \uC5C6\uC9C0\uB9CC, \uC704\uAE30 \uC0C1\uD669\uC5D0\uC11C
      \uBC18\uBCF5\uC801\uC73C\uB85C \uC804\uC5F4\uC5D0 \uC11C\uB294 \uD589\uC704
      \uC790\uCCB4\uAC00 \uC2E0\uB8B0\uC758 \uC99D\uBA85\uC774 \uB41C\uB2E4. \uB9D0\uC774
      \uC544\uB2C8\uB77C \uBAB8\uC73C\uB85C \uC99D\uBA85\uD558\uB294 \uC874\uC7AC\uC774\uBA70,
      Relicborn\uC774 \uC801\uC774 \uC544\uB2D8\uC744 \uCC98\uC74C\uC73C\uB85C \uBCF4\uC5EC\uC8FC\uB294
      \uC0AC\uB840\uB2E4.\n\nRelicborn\uC758 \uBB38\uC9C0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183235
    m_Localized: Bastion Penitent
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183236
    m_Localized: "\uC655\uAD6D \uBC29\uBCBD \uAD50\uB9AC\uC758 \uC2E4\uD328\uB97C
      \uBAB8\uC73C\uB85C \uACAA\uC740 \uCC38\uD68C\uC790. \uADF8\uB294 \uBB34\uB108\uC9C4
      \uC804\uC120\uC744 \uBCC0\uBA85\uD558\uC9C0 \uC54A\uACE0, \uAC19\uC740 \uBD95\uAD34\uAC00
      \uC6D0\uC815\uB300 \uC548\uC5D0\uC11C \uBC18\uBCF5\uB418\uC9C0 \uC54A\uB3C4\uB85D
      \uAC00\uC7A5 \uC704\uD5D8\uD55C \uC790\uB9AC\uC5D0 \uC120\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183237
    m_Localized: "\uC655\uAD6D \uB0B4\uBD80 \uADE0\uC5F4\uC744 \uC99D\uC5B8\uD558\uB294
      \uBC29\uBCBD\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183238
    m_Localized: "\uC655\uAD6D \uBC29\uBCBD \uAD50\uB9AC\uC758 \uC2E4\uD328\uB97C
      \uBAB8\uC73C\uB85C \uACAA\uC740 \uCC38\uD68C\uC790. \uADF8\uB294 \uBB34\uB108\uC9C4
      \uC804\uC120\uC744 \uBCC0\uBA85\uD558\uC9C0 \uC54A\uACE0, \uAC19\uC740 \uBD95\uAD34\uAC00
      \uC6D0\uC815\uB300 \uC548\uC5D0\uC11C \uBC18\uBCF5\uB418\uC9C0 \uC54A\uB3C4\uB85D
      \uAC00\uC7A5 \uC704\uD5D8\uD55C \uC790\uB9AC\uC5D0 \uC120\uB2E4.\n\n\uC655\uAD6D
      \uB0B4\uBD80 \uADE0\uC5F4\uC744 \uC99D\uC5B8\uD558\uB294 \uBC29\uBCBD\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183239
    m_Localized: Crypt Guardian
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183240
    m_Localized: "\uC5B8\uB370\uB4DC \uBB18\uC5ED\uC758 \uC5EC\uC131 \uC218\uD638\uC790.
      \uC11D\uAD00 \uC18D\uC5D0 \uC7A0\uB4E0 \uAC83\uC740 \uBF08\uAC00 \uC544\uB2C8\uB77C
      \uC0AC\uB791\uD588\uB358 \uC774\uB4E4\uC758 \uAE30\uC5B5\uC774\uBA70, \uADF8
      \uAE30\uC5B5\uC774 \uC18C\uC2E4\uB418\uBA74 \uC9C4\uC815\uD55C \uC8FD\uC74C\uC774
      \uCC3E\uC544\uC628\uB2E4. \uBB18\uC5ED\uC744 \uC9C0\uD0A4\uB294 \uD589\uC704\uB294
      \uACE7 \uC8FD\uC740 \uBB38\uBA85\uC758 \uB9C8\uC9C0\uB9C9 \uC99D\uC778\uC73C\uB85C
      \uC11C\uB294 \uAC83\uC774\uB2E4. \uC6D0\uC815\uC5D0 \uD569\uB958\uD55C \uAC83\uC740
      \uC678\uBD80 \uC138\uB825\uC774 \uBB18\uC5ED\uC744 \uD6FC\uC190\uD558\uB294
      \uAC83\uC744 \uB9C9\uAE30 \uC704\uD574\uC11C\uC600\uC73C\uB098, \uC5EC\uC815\uC774
      \uAE4A\uC5B4\uC9C0\uBA74\uC11C \uADF8\uB140\uAC00 \uC9C0\uD0A4\uB294 \uAE30\uC5B5
      \uC18D\uC5D0 \uBAA8\uB4E0 \uC138\uB825\uC758 \uC8C4\uAC00 \uAE30\uB85D\uB418\uC5B4
      \uC788\uC74C\uC744 \uC99D\uC5B8\uD574\uC57C \uD558\uB294 \uC5ED\uD560\uC744
      \uB5A0\uC548\uAC8C \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183241
    m_Localized: "\uC8FD\uC740 \uBB38\uBA85\uC758 \uC8C4\uB97C \uC99D\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183242
    m_Localized: "\uC5B8\uB370\uB4DC \uBB18\uC5ED\uC758 \uC5EC\uC131 \uC218\uD638\uC790.
      \uC11D\uAD00 \uC18D\uC5D0 \uC7A0\uB4E0 \uAC83\uC740 \uBF08\uAC00 \uC544\uB2C8\uB77C
      \uC0AC\uB791\uD588\uB358 \uC774\uB4E4\uC758 \uAE30\uC5B5\uC774\uBA70, \uADF8
      \uAE30\uC5B5\uC774 \uC18C\uC2E4\uB418\uBA74 \uC9C4\uC815\uD55C \uC8FD\uC74C\uC774
      \uCC3E\uC544\uC628\uB2E4. \uBB18\uC5ED\uC744 \uC9C0\uD0A4\uB294 \uD589\uC704\uB294
      \uACE7 \uC8FD\uC740 \uBB38\uBA85\uC758 \uB9C8\uC9C0\uB9C9 \uC99D\uC778\uC73C\uB85C
      \uC11C\uB294 \uAC83\uC774\uB2E4. \uC6D0\uC815\uC5D0 \uD569\uB958\uD55C \uAC83\uC740
      \uC678\uBD80 \uC138\uB825\uC774 \uBB18\uC5ED\uC744 \uD6FC\uC190\uD558\uB294
      \uAC83\uC744 \uB9C9\uAE30 \uC704\uD574\uC11C\uC600\uC73C\uB098, \uC5EC\uC815\uC774
      \uAE4A\uC5B4\uC9C0\uBA74\uC11C \uADF8\uB140\uAC00 \uC9C0\uD0A4\uB294 \uAE30\uC5B5
      \uC18D\uC5D0 \uBAA8\uB4E0 \uC138\uB825\uC758 \uC8C4\uAC00 \uAE30\uB85D\uB418\uC5B4
      \uC788\uC74C\uC744 \uC99D\uC5B8\uD574\uC57C \uD558\uB294 \uC5ED\uD560\uC744
      \uB5A0\uC548\uAC8C \uB41C\uB2E4.\n\n\uC8FD\uC740 \uBB38\uBA85\uC758 \uC8C4\uB97C
      \uC99D\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183243
    m_Localized: Dawn Priest
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183244
    m_Localized: "\uC194\uB77C\uB8F8\uC758 \uC80A\uC740 \uC5EC\uC0AC\uC81C. \uBCF8
      \uB300\uC131\uB2F9\uC5D0\uC11C \uC815\uD654 \uC758\uB840\uC640 \uC131\uBB3C
      \uAE30\uB85D\uC744 \uB9E1\uB2E4\uAC00 \uBCC0\uBC29 \uC6D0\uC815\uC5D0 \uC790\uC6D0\uD55C
      \uCCAB \uC0AC\uC81C \uACC4\uAE09 \uCD9C\uC2E0\uC774\uB2E4. \uC9D1\uC815\uAD00
      \uD569\uC758\uC81C \uC548\uC5D0\uC11C '\uBCF4\uB7EC \uAC00\uB294 \uC790\uB9AC'\uB97C
      \uC790\uCCAD\uD588\uACE0 \uBCF8\uC778\uC740 \uC2E0\uC559\uC758 \uD655\uC7A5\uC774\uB77C
      \uBBFF\uC5C8\uC73C\uB098, \uC2E4\uC81C\uB85C\uB294 \uB2E8\uD604 \uD559\uD30C\uC758
      \uBCC0\uBC29 \uB3C4\uAD74\uC744 \uC9C0\uCF1C\uBCFC \uAD00\uCC30\uC790\uC5D0
      \uAC00\uAE5D\uB2E4. \uBE5B\uACFC \uC790\uC218, \uC0C8\uACA8\uC9C4 \uC774\uB984,
      \uD759 \uC704\uC758 \uD754\uC801\uC744 \uBA3C\uC800 \uC77D\uB294 \uC0AC\uB78C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183245
    m_Localized: "\uBCC0\uBC29\uC5D0\uC11C \uB2E8\uB9B0\uC740 \uC790\uC2E0\uC774
      \uC678\uC6B4 \uB2E8\uD604 \uD559\uC124\uC774 \uBC29\uD328\uAC00 \uC544\uB2C8\uB77C
      \uCE7C\uC774 \uB420 \uC218 \uC788\uC74C\uC744 \uBCF8\uB2E4. \uC815\uD654 \uC7AC\uD310\uC758
      '\uC815\uACB0/\uC624\uC5FC' \uBD84\uB958\uAC00 \uC0AC\uB78C\uC744 \uBC88\uD638\uB85C
      \uC811\uB294 \uC5B8\uC5B4\uC600\uC74C\uC744 \uC778\uC815\uD558\uBA74\uC11C,
      \uB3D9\uAE30\uB294 '\uC2E0\uC559\uC758 \uC218\uD638'\uC5D0\uC11C '\uD55C \uC0AC\uB78C\uC73C\uB85C
      \uC99D\uC5B8\uD558\uAE30'\uB85C \uC62E\uACA8\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183246
    m_Localized: "\uADF8\uB140\uAC00 \uD3C9\uC0DD \uC678\uC6B4 \uBB38\uC7A5\uC744
      \uC124\uACC4\uD55C \uB2E8\uD604\uC740 \uC774\uBBF8 \uC8FD\uC5C8\uACE0, \uADF8
      \uD559\uC124\uC744 \uC815\uCE58 \uC790\uC6D0\uC73C\uB85C \uBC14\uAFB8\uB824\uB294
      \uBC31\uADDC\uAC00 \uD559\uC790\uC7A5\uC774\uB2E4. ch5\uC5D0\uC11C \uB2E8\uB9B0\uC740
      \uB2E8\uD604 \uC77C\uC9C0\uC758 \uB9C8\uC9C0\uB9C9 \uBD80\uD0C1\uC744 \uBC31\uADDC
      \uC55E\uC5D0\uC11C \uC778\uC6A9\uD558\uACE0, \uC0AC\uC81C \uC778\uC7A5\uC744
      \uB0B4\uB824\uB193\uC740 \uCC44 \uD55C \uC0AC\uB78C\uC73C\uB85C \uC99D\uC5B8\uD55C\uB2E4.
      \uBCF8 \uB300\uC131\uB2F9\uC73C\uB85C \uB3CC\uC544\uAC00\uC9C0 \uC54A\uACE0
      \uC0C8 \uC2E0\uC559\uC744 \uCC3E\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183247
    m_Localized: "\uC194\uB77C\uB8F8\uC758 \uC80A\uC740 \uC5EC\uC0AC\uC81C. \uBCF8
      \uB300\uC131\uB2F9\uC5D0\uC11C \uC815\uD654 \uC758\uB840\uC640 \uC131\uBB3C
      \uAE30\uB85D\uC744 \uB9E1\uB2E4\uAC00 \uBCC0\uBC29 \uC6D0\uC815\uC5D0 \uC790\uC6D0\uD55C
      \uCCAB \uC0AC\uC81C \uACC4\uAE09 \uCD9C\uC2E0\uC774\uB2E4. \uC9D1\uC815\uAD00
      \uD569\uC758\uC81C \uC548\uC5D0\uC11C '\uBCF4\uB7EC \uAC00\uB294 \uC790\uB9AC'\uB97C
      \uC790\uCCAD\uD588\uACE0 \uBCF8\uC778\uC740 \uC2E0\uC559\uC758 \uD655\uC7A5\uC774\uB77C
      \uBBFF\uC5C8\uC73C\uB098, \uC2E4\uC81C\uB85C\uB294 \uB2E8\uD604 \uD559\uD30C\uC758
      \uBCC0\uBC29 \uB3C4\uAD74\uC744 \uC9C0\uCF1C\uBCFC \uAD00\uCC30\uC790\uC5D0
      \uAC00\uAE5D\uB2E4. \uBE5B\uACFC \uC790\uC218, \uC0C8\uACA8\uC9C4 \uC774\uB984,
      \uD759 \uC704\uC758 \uD754\uC801\uC744 \uBA3C\uC800 \uC77D\uB294 \uC0AC\uB78C\uC774\uB2E4.\n\n\uBCC0\uBC29\uC5D0\uC11C
      \uB2E8\uB9B0\uC740 \uC790\uC2E0\uC774 \uC678\uC6B4 \uB2E8\uD604 \uD559\uC124\uC774
      \uBC29\uD328\uAC00 \uC544\uB2C8\uB77C \uCE7C\uC774 \uB420 \uC218 \uC788\uC74C\uC744
      \uBCF8\uB2E4. \uC815\uD654 \uC7AC\uD310\uC758 '\uC815\uACB0/\uC624\uC5FC' \uBD84\uB958\uAC00
      \uC0AC\uB78C\uC744 \uBC88\uD638\uB85C \uC811\uB294 \uC5B8\uC5B4\uC600\uC74C\uC744
      \uC778\uC815\uD558\uBA74\uC11C, \uB3D9\uAE30\uB294 '\uC2E0\uC559\uC758 \uC218\uD638'\uC5D0\uC11C
      '\uD55C \uC0AC\uB78C\uC73C\uB85C \uC99D\uC5B8\uD558\uAE30'\uB85C \uC62E\uACA8\uAC04\uB2E4.\n\n\uADF8\uB140\uAC00
      \uD3C9\uC0DD \uC678\uC6B4 \uBB38\uC7A5\uC744 \uC124\uACC4\uD55C \uB2E8\uD604\uC740
      \uC774\uBBF8 \uC8FD\uC5C8\uACE0, \uADF8 \uD559\uC124\uC744 \uC815\uCE58 \uC790\uC6D0\uC73C\uB85C
      \uBC14\uAFB8\uB824\uB294 \uBC31\uADDC\uAC00 \uD559\uC790\uC7A5\uC774\uB2E4.
      ch5\uC5D0\uC11C \uB2E8\uB9B0\uC740 \uB2E8\uD604 \uC77C\uC9C0\uC758 \uB9C8\uC9C0\uB9C9
      \uBD80\uD0C1\uC744 \uBC31\uADDC \uC55E\uC5D0\uC11C \uC778\uC6A9\uD558\uACE0,
      \uC0AC\uC81C \uC778\uC7A5\uC744 \uB0B4\uB824\uB193\uC740 \uCC44 \uD55C \uC0AC\uB78C\uC73C\uB85C
      \uC99D\uC5B8\uD55C\uB2E4. \uBCF8 \uB300\uC131\uB2F9\uC73C\uB85C \uB3CC\uC544\uAC00\uC9C0
      \uC54A\uACE0 \uC0C8 \uC2E0\uC559\uC744 \uCC3E\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183248
    m_Localized: Dread Marksman
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183249
    m_Localized: "\uC5B8\uB370\uB4DC \uC6D0\uAC70\uB9AC \uCC98\uD615\uC790. \uAC10\uC815\uC744
      \uC18C\uC2E4\uD55C \uCC44 \uAE68\uC5B4\uB0AC\uC73C\uBA70, \uAE30\uC5B5\uC740
      \uB0A8\uC544 \uC788\uC73C\uB098 \uADF8 \uAE30\uC5B5\uC5D0 \uBD99\uC5B4 \uC788\uC5B4\uC57C
      \uD560 \uAC10\uC815\uC774 \uC5C6\uB2E4. \uD45C\uC801\uC744 \uC9C0\uC815\uD558\uBA74
      \uC2E4\uD589\uD558\uACE0, \uC2E4\uD589\uC774 \uB05D\uB098\uBA74 \uB2E4\uC74C
      \uD45C\uC801\uC744 \uAE30\uB2E4\uB9B0\uB2E4. \uC774 \uB0C9\uD639\uD55C \uD6A8\uC728\uC131\uC774
      \uC6D0\uC815\uB300\uC5D0\uC11C\uB294 \uC804\uC220\uC801 \uC790\uC0B0\uC774\uC9C0\uB9CC,
      \uB3D9\uB8CC\uB4E4\uC5D0\uAC8C\uB294 \uBD88\uC548\uC758 \uC6D0\uCC9C\uC774\uAE30\uB3C4
      \uD558\uB2E4. \uBCF8\uC778\uC5D0\uAC8C '\uC65C \uC2F8\uC6B0\uB290\uB0D0'\uB294
      \uC9C8\uBB38\uC740 \uC758\uBBF8\uAC00 \uC5C6\uB2E4. \uC2F8\uC6B0\uB294 \uAC83\uB9CC
      \uB0A8\uC558\uAE30\uC5D0 \uC2F8\uC6B8 \uBFD0\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183250
    m_Localized: "\uC5B8\uB370\uB4DC\uC758 \uB0C9\uD639\uD55C \uD6A8\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183251
    m_Localized: "\uC5B8\uB370\uB4DC \uC6D0\uAC70\uB9AC \uCC98\uD615\uC790. \uAC10\uC815\uC744
      \uC18C\uC2E4\uD55C \uCC44 \uAE68\uC5B4\uB0AC\uC73C\uBA70, \uAE30\uC5B5\uC740
      \uB0A8\uC544 \uC788\uC73C\uB098 \uADF8 \uAE30\uC5B5\uC5D0 \uBD99\uC5B4 \uC788\uC5B4\uC57C
      \uD560 \uAC10\uC815\uC774 \uC5C6\uB2E4. \uD45C\uC801\uC744 \uC9C0\uC815\uD558\uBA74
      \uC2E4\uD589\uD558\uACE0, \uC2E4\uD589\uC774 \uB05D\uB098\uBA74 \uB2E4\uC74C
      \uD45C\uC801\uC744 \uAE30\uB2E4\uB9B0\uB2E4. \uC774 \uB0C9\uD639\uD55C \uD6A8\uC728\uC131\uC774
      \uC6D0\uC815\uB300\uC5D0\uC11C\uB294 \uC804\uC220\uC801 \uC790\uC0B0\uC774\uC9C0\uB9CC,
      \uB3D9\uB8CC\uB4E4\uC5D0\uAC8C\uB294 \uBD88\uC548\uC758 \uC6D0\uCC9C\uC774\uAE30\uB3C4
      \uD558\uB2E4. \uBCF8\uC778\uC5D0\uAC8C '\uC65C \uC2F8\uC6B0\uB290\uB0D0'\uB294
      \uC9C8\uBB38\uC740 \uC758\uBBF8\uAC00 \uC5C6\uB2E4. \uC2F8\uC6B0\uB294 \uAC83\uB9CC
      \uB0A8\uC558\uAE30\uC5D0 \uC2F8\uC6B8 \uBFD0\uC774\uB2E4.\n\n\uC5B8\uB370\uB4DC\uC758
      \uB0C9\uD639\uD55C \uD6A8\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183252
    m_Localized: Echo Savant
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183253
    m_Localized: "\uADF8\uBB3C \uACB0\uC0AC\uC758 \uC2DC\uC870 \uBCF8\uC778. \uCCAB
      \uB3C4\uC2DC \uD559\uC0B4 \uC9C1\uD6C4 \uCE68\uBB35 \uC758\uBB34\uB97C \uBC1B\uC544
      \uB3C4\uC2DC \uC785\uAD6C\uB97C 1800\uB144 \uB3D9\uC548 \uC758\uB840\uC801\uC73C\uB85C
      \uB2E4\uC2DC \uBB36\uC5B4 \uC628 '\uBB38\uC744 \uB2EB\uC740 \uC190'\uC774\uB2E4.
      \uD3C9\uC18C\uC5D0\uB294 \uD3C9\uBC94\uD55C \uC778\uAC04\uC73C\uB85C \uC0B4\uBA70
      \uC678\uBD80 \uC138\uACC4\uB294 \uACB0\uC0AC\uC758 \uC874\uC7AC\uC870\uCC28
      \uBAB0\uB790\uB2E4. \uC624\uB798 \uB2EB\uC544 \uB454 \uC190\uC774\uB77C \uC5F4
      \uB54C\uB3C4 \uBA3C\uC800 \uB5A8\uB9B0\uB2E4\uACE0 \uB9D0\uD55C\uB2E4 \u2014
      \uCC45\uC784\uC758 \uAC10\uAC01\uC774 \uC124\uC815 \uC124\uBA85\uBCF4\uB2E4
      \uBA3C\uC800 \uC624\uB294 \uC778\uBB3C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183254
    m_Localized: "1800\uB144 \uCE68\uBB35\uC744 \uB05D\uB0B4\uB824\uB294 \uC678\uBD80
      \uD65C\uB3D9\uAC00 \uB178\uC120(\uACF5\uD55C)\uACFC, \uC2DC\uC870\uC758 \uC57D\uC18D\uC744
      \uAE00\uC790 \uADF8\uB300\uB85C \uC218\uD638\uD558\uB824\uB294 \uCE68\uBB35
      \uAC15\uACBD\uD30C(\uCE68\uC6D4)\uAC00 \uCDA9\uB3CC\uD55C\uB2E4. \uCE68\uBB35\uC774
      \uD559\uD30C\uC758 \uC57C\uC2EC\uC744 \uB9C9\uC9C0 \uBABB\uD588\uC74C\uC744
      \uC54C\uAE30\uC5D0 \uADF8\uB294 \uCE68\uBB35\uC744 \uB05D\uB0B4\uB294 \uCABD\uC744
      \uD0DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183255
    m_Localized: "ch5\uC5D0\uC11C \uACF5\uD55C\uC740 \uB3C4\uC2DC \uC548\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uB294 \uB300\uAC00\uB85C \uCE68\uC6D4\uC5D0\uAC8C \uACB0\uC0AC
      \uD6C4\uC608\uC758 \uC790\uB9AC\uB97C \uBC15\uD0C8\uB2F9\uD55C\uB2E4. \uB2E4\uC2DC
      \uBD09\uC778\uB418\uC9C0 \uC54A\uACE0, \uACB0\uC0AC \uC548\uC758 \uC774\uB984\uC744
      \uC783\uC740 \uCC44 \uBB38\uBC16\uC758 \uC678\uBD80 \uC99D\uC5B8\uC790\uB85C
      \uB0A8\uB294\uB2E4. '\uC78A\uC5B4\uB77C. \uB098\uB294 \uAE30\uC5B5\uD558\uACA0\uB2E4.'
      \uBE48 \uC190\uC73C\uB85C, \uC548\uC5D0\uC11C \uB098\uC624\uB824\uB294 \uC0AC\uB78C\uACFC
      \uBC16\uC5D0\uC11C \uB4E4\uC5B4\uC624\uB824\uB294 \uC0AC\uB78C\uC744 \uBAA8\uB450
      \uBD99\uC7A1\uACA0\uB2E4\uACE0 \uB9D0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183256
    m_Localized: "\uADF8\uBB3C \uACB0\uC0AC\uC758 \uC2DC\uC870 \uBCF8\uC778. \uCCAB
      \uB3C4\uC2DC \uD559\uC0B4 \uC9C1\uD6C4 \uCE68\uBB35 \uC758\uBB34\uB97C \uBC1B\uC544
      \uB3C4\uC2DC \uC785\uAD6C\uB97C 1800\uB144 \uB3D9\uC548 \uC758\uB840\uC801\uC73C\uB85C
      \uB2E4\uC2DC \uBB36\uC5B4 \uC628 '\uBB38\uC744 \uB2EB\uC740 \uC190'\uC774\uB2E4.
      \uD3C9\uC18C\uC5D0\uB294 \uD3C9\uBC94\uD55C \uC778\uAC04\uC73C\uB85C \uC0B4\uBA70
      \uC678\uBD80 \uC138\uACC4\uB294 \uACB0\uC0AC\uC758 \uC874\uC7AC\uC870\uCC28
      \uBAB0\uB790\uB2E4. \uC624\uB798 \uB2EB\uC544 \uB454 \uC190\uC774\uB77C \uC5F4
      \uB54C\uB3C4 \uBA3C\uC800 \uB5A8\uB9B0\uB2E4\uACE0 \uB9D0\uD55C\uB2E4 \u2014
      \uCC45\uC784\uC758 \uAC10\uAC01\uC774 \uC124\uC815 \uC124\uBA85\uBCF4\uB2E4
      \uBA3C\uC800 \uC624\uB294 \uC778\uBB3C\uC774\uB2E4.\n\n1800\uB144 \uCE68\uBB35\uC744
      \uB05D\uB0B4\uB824\uB294 \uC678\uBD80 \uD65C\uB3D9\uAC00 \uB178\uC120(\uACF5\uD55C)\uACFC,
      \uC2DC\uC870\uC758 \uC57D\uC18D\uC744 \uAE00\uC790 \uADF8\uB300\uB85C \uC218\uD638\uD558\uB824\uB294
      \uCE68\uBB35 \uAC15\uACBD\uD30C(\uCE68\uC6D4)\uAC00 \uCDA9\uB3CC\uD55C\uB2E4.
      \uCE68\uBB35\uC774 \uD559\uD30C\uC758 \uC57C\uC2EC\uC744 \uB9C9\uC9C0 \uBABB\uD588\uC74C\uC744
      \uC54C\uAE30\uC5D0 \uADF8\uB294 \uCE68\uBB35\uC744 \uB05D\uB0B4\uB294 \uCABD\uC744
      \uD0DD\uD55C\uB2E4.\n\nch5\uC5D0\uC11C \uACF5\uD55C\uC740 \uB3C4\uC2DC \uC548\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uB294 \uB300\uAC00\uB85C \uCE68\uC6D4\uC5D0\uAC8C \uACB0\uC0AC
      \uD6C4\uC608\uC758 \uC790\uB9AC\uB97C \uBC15\uD0C8\uB2F9\uD55C\uB2E4. \uB2E4\uC2DC
      \uBD09\uC778\uB418\uC9C0 \uC54A\uACE0, \uACB0\uC0AC \uC548\uC758 \uC774\uB984\uC744
      \uC783\uC740 \uCC44 \uBB38\uBC16\uC758 \uC678\uBD80 \uC99D\uC5B8\uC790\uB85C
      \uB0A8\uB294\uB2E4. '\uC78A\uC5B4\uB77C. \uB098\uB294 \uAE30\uC5B5\uD558\uACA0\uB2E4.'
      \uBE48 \uC190\uC73C\uB85C, \uC548\uC5D0\uC11C \uB098\uC624\uB824\uB294 \uC0AC\uB78C\uACFC
      \uBC16\uC5D0\uC11C \uB4E4\uC5B4\uC624\uB824\uB294 \uC0AC\uB78C\uC744 \uBAA8\uB450
      \uBD99\uC7A1\uACA0\uB2E4\uACE0 \uB9D0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183257
    m_Localized: Fang Bulwark
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183258
    m_Localized: "\uC57C\uC218\uC871 \uD604\uC7A5\uC131\uC758 \uC0C1\uC9D5"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183259
    m_Localized: "\uC57C\uC218\uC871 \uD604\uC7A5\uC131\uC758 \uC0C1\uC9D5"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183260
    m_Localized: "\uC57C\uC218\uC871 \uD604\uC7A5\uC131\uC758 \uC0C1\uC9D5\n\n\uC57C\uC218\uC871
      \uD604\uC7A5\uC131\uC758 \uC0C1\uC9D5"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183261
    m_Localized: Grave Hexer
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183262
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC\uC758 \uAE30\uC5B5 \uC99D\uC5B8\uC790.
      \uCCAB \uB3C4\uC2DC \uD559\uC0B4\uC758 \uC804\uC218 \uAE30\uC5B5\uC744 \uC758\uC2DD\uC73C\uB85C
      \uBB3C\uB824\uBC1B\uC544 \uC790\uAE30 \uCC45\uC784\uC73C\uB85C\uB9CC \uBD99\uB4E4\uC5B4
      \uC628, \uACB0\uC0AC\uC5D0\uC11C \uAC00\uC7A5 \uC624\uB798\uB41C \uCD95\uC758
      \uC778\uBB3C\uC774\uB2E4. \uC9C1\uC811 \uBAA9\uACA9\uC790\uB294 \uC544\uB2C8\uC9C0\uB9CC
      \uADF8 \uAE30\uC5B5\uC758 \uBB34\uAC8C\uB97C \uB204\uAD6C\uBCF4\uB2E4 \uC798
      \uC548\uB2E4. \uBB34\uAC70\uC6B4 \uC9C4\uC2E4\uC744 \uB18D\uB2F4\uACFC \uC0AC\uC18C\uD55C
      \uAE30\uC5B5\uC73C\uB85C \uC539\uC5B4 \uB118\uAE30\uB294 \uC2DC\uAC04 \uAC70\uB9AC\uAC10\uC774
      \uCEA0\uD398\uC778 \uC911\uBC18\uC758 \uAD6C\uBA85\uC904\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183263
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC\uB294 \uD559\uC0B4 \uAE30\uC5B5\uC744
      \uC5B4\uB5BB\uAC8C \uB2E4\uB8F0\uC9C0\uC5D0\uC11C \uAC08\uB77C\uC9C4\uB2E4
      \u2014 \uBCF4\uC874\uD558\uBA70 \uD654\uD574\uC758 \uC5EC\uC9C0\uB97C \uB0A8\uAE30\uB824\uB294
      \uBB35\uD5A5\uACFC, \uB2E8\uC8C4 \uBA85\uB2E8\uC73C\uB85C \uCC45\uC784\uC744
      \uBB3B\uB294 \uD751\uC9C0. \uADF8 \uBA85\uB2E8 \uC704\uC5D0\uB294 \uBB35\uD5A5
      \uC790\uC2E0\uC758 \uC774\uB984\uB3C4 \uC62C\uB77C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183264
    m_Localized: "ch5\uC5D0\uC11C \uBB35\uD5A5\uC740 \uD751\uC9C0\uC758 \uBA85\uB2E8\uC744
      \uB4E4\uACE0 \uB3C4\uC2DC \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uACE0, \uC804\uC218
      \uAE30\uC5B5\uC758 \uC77C\uBD80\uB97C \uB2E8\uB9B0\uC5D0\uAC8C \uB9E1\uAE34\uB2E4.
      \uC790\uAE30 \uC774\uB984\uC744 \uBA85\uB2E8\uC5D0\uC11C \uBE7C \uB2EC\uB77C
      \uCCAD\uD558\uC9C0 \uC54A\uACE0, '\uC790\uB9AC\uAC00 \uBE44\uBA74 \uC78E \uD558\uB098\uB294
      \uB07C\uC6CC \uB450\uB77C'\uBA70 \uC790\uC2E0\uC774 \uBCF4\uC558\uB2E4\uB294
      \uD45C\uC2DC\uB9CC \uB0A8\uAE34\uB2E4. \uD751\uC9C0\uC640\uC758 \uBA85\uB2E8
      \uBB38\uC81C\uB294 \uBBF8\uD574\uACB0\uB85C \uB0A8\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183265
    m_Localized: "\uD68C\uC0C1 \uACB0\uC0AC\uC758 \uAE30\uC5B5 \uC99D\uC5B8\uC790.
      \uCCAB \uB3C4\uC2DC \uD559\uC0B4\uC758 \uC804\uC218 \uAE30\uC5B5\uC744 \uC758\uC2DD\uC73C\uB85C
      \uBB3C\uB824\uBC1B\uC544 \uC790\uAE30 \uCC45\uC784\uC73C\uB85C\uB9CC \uBD99\uB4E4\uC5B4
      \uC628, \uACB0\uC0AC\uC5D0\uC11C \uAC00\uC7A5 \uC624\uB798\uB41C \uCD95\uC758
      \uC778\uBB3C\uC774\uB2E4. \uC9C1\uC811 \uBAA9\uACA9\uC790\uB294 \uC544\uB2C8\uC9C0\uB9CC
      \uADF8 \uAE30\uC5B5\uC758 \uBB34\uAC8C\uB97C \uB204\uAD6C\uBCF4\uB2E4 \uC798
      \uC548\uB2E4. \uBB34\uAC70\uC6B4 \uC9C4\uC2E4\uC744 \uB18D\uB2F4\uACFC \uC0AC\uC18C\uD55C
      \uAE30\uC5B5\uC73C\uB85C \uC539\uC5B4 \uB118\uAE30\uB294 \uC2DC\uAC04 \uAC70\uB9AC\uAC10\uC774
      \uCEA0\uD398\uC778 \uC911\uBC18\uC758 \uAD6C\uBA85\uC904\uC774\uB2E4.\n\n\uD68C\uC0C1
      \uACB0\uC0AC\uB294 \uD559\uC0B4 \uAE30\uC5B5\uC744 \uC5B4\uB5BB\uAC8C \uB2E4\uB8F0\uC9C0\uC5D0\uC11C
      \uAC08\uB77C\uC9C4\uB2E4 \u2014 \uBCF4\uC874\uD558\uBA70 \uD654\uD574\uC758
      \uC5EC\uC9C0\uB97C \uB0A8\uAE30\uB824\uB294 \uBB35\uD5A5\uACFC, \uB2E8\uC8C4
      \uBA85\uB2E8\uC73C\uB85C \uCC45\uC784\uC744 \uBB3B\uB294 \uD751\uC9C0. \uADF8
      \uBA85\uB2E8 \uC704\uC5D0\uB294 \uBB35\uD5A5 \uC790\uC2E0\uC758 \uC774\uB984\uB3C4
      \uC62C\uB77C \uC788\uB2E4.\n\nch5\uC5D0\uC11C \uBB35\uD5A5\uC740 \uD751\uC9C0\uC758
      \uBA85\uB2E8\uC744 \uB4E4\uACE0 \uB3C4\uC2DC \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uACE0,
      \uC804\uC218 \uAE30\uC5B5\uC758 \uC77C\uBD80\uB97C \uB2E8\uB9B0\uC5D0\uAC8C
      \uB9E1\uAE34\uB2E4. \uC790\uAE30 \uC774\uB984\uC744 \uBA85\uB2E8\uC5D0\uC11C
      \uBE7C \uB2EC\uB77C \uCCAD\uD558\uC9C0 \uC54A\uACE0, '\uC790\uB9AC\uAC00 \uBE44\uBA74
      \uC78E \uD558\uB098\uB294 \uB07C\uC6CC \uB450\uB77C'\uBA70 \uC790\uC2E0\uC774
      \uBCF4\uC558\uB2E4\uB294 \uD45C\uC2DC\uB9CC \uB0A8\uAE34\uB2E4. \uD751\uC9C0\uC640\uC758
      \uBA85\uB2E8 \uBB38\uC81C\uB294 \uBBF8\uD574\uACB0\uB85C \uB0A8\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183266
    m_Localized: Grave Reaver
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183267
    m_Localized: "\uD30C\uAD34\uB41C \uCDA9\uC131\uC758 \uC794\uC7AC"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183268
    m_Localized: "\uD30C\uAD34\uB41C \uCDA9\uC131\uC758 \uC794\uC7AC"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183269
    m_Localized: "\uD30C\uAD34\uB41C \uCDA9\uC131\uC758 \uC794\uC7AC\n\n\uD30C\uAD34\uB41C
      \uCDA9\uC131\uC758 \uC794\uC7AC"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183270
    m_Localized: Iron Warden
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183271
    m_Localized: "\uC655\uAD6D \uC815\uADDC\uAD70\uC758 \uB9C8\uC9C0\uB9C9 \uAD6C\uC138\uB300
      \uBC29\uD328\uBCD1. \uB3D9\uB8CC\uB4E4\uC740 Gate \uBD95\uAD34 \uB54C \uC804\uC0AC\uD588\uACE0,
      \uBCF8\uC778\uB9CC \uC0B4\uC544\uB0A8\uC558\uB2E4. \uCDA9\uC131\uC758 \uB300\uC0C1\uC774\uC5C8\uB358
      \uC655\uB3C4, \uC9C0\uCF1C\uC57C \uD560 \uC804\uC120\uB3C4 \uC0AC\uB77C\uC9C4
      \uC9C0\uAE08, \uB0A8\uC740 \uAC83\uC740 \uBAB8\uC5D0 \uC0C8\uACA8\uC9C4 \uC2B5\uAD00\uBFD0\uC774\uB2E4.
      \uB204\uAD70\uAC00\uB97C \uC9C0\uD0A4\uB294 \uAC83 \uC678\uC5D0\uB294 \uC790\uC2E0\uC758
      \uC874\uC7AC \uC774\uC720\uB97C \uC124\uBA85\uD560 \uBC29\uBC95\uC774 \uC5C6\uAE30\uC5D0,
      \uC6D0\uC815\uB300\uC758 \uC804\uC5F4\uC5D0 \uC120\uB2E4. \uC2E0\uB150\uC774
      \uC544\uB2C8\uB77C \uAD00\uC131\uC5D0 \uAC00\uAE4C\uC6B4 \uC758\uBB34\uAC10\uC774\uC9C0\uB9CC,
      \uADF8 \uAD00\uC131\uC774 \uC804\uC120\uC744 \uC9C0\uD0F1\uD558\uB294 \uAC00\uC7A5
      \uB2E8\uB2E8\uD55C \uCD95\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183272
    m_Localized: "\uC9C8\uC11C\uC758 \uC5BC\uAD74, \uCD08\uBC18 \uC548\uC804\uD310"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183273
    m_Localized: "\uC655\uAD6D \uC815\uADDC\uAD70\uC758 \uB9C8\uC9C0\uB9C9 \uAD6C\uC138\uB300
      \uBC29\uD328\uBCD1. \uB3D9\uB8CC\uB4E4\uC740 Gate \uBD95\uAD34 \uB54C \uC804\uC0AC\uD588\uACE0,
      \uBCF8\uC778\uB9CC \uC0B4\uC544\uB0A8\uC558\uB2E4. \uCDA9\uC131\uC758 \uB300\uC0C1\uC774\uC5C8\uB358
      \uC655\uB3C4, \uC9C0\uCF1C\uC57C \uD560 \uC804\uC120\uB3C4 \uC0AC\uB77C\uC9C4
      \uC9C0\uAE08, \uB0A8\uC740 \uAC83\uC740 \uBAB8\uC5D0 \uC0C8\uACA8\uC9C4 \uC2B5\uAD00\uBFD0\uC774\uB2E4.
      \uB204\uAD70\uAC00\uB97C \uC9C0\uD0A4\uB294 \uAC83 \uC678\uC5D0\uB294 \uC790\uC2E0\uC758
      \uC874\uC7AC \uC774\uC720\uB97C \uC124\uBA85\uD560 \uBC29\uBC95\uC774 \uC5C6\uAE30\uC5D0,
      \uC6D0\uC815\uB300\uC758 \uC804\uC5F4\uC5D0 \uC120\uB2E4. \uC2E0\uB150\uC774
      \uC544\uB2C8\uB77C \uAD00\uC131\uC5D0 \uAC00\uAE4C\uC6B4 \uC758\uBB34\uAC10\uC774\uC9C0\uB9CC,
      \uADF8 \uAD00\uC131\uC774 \uC804\uC120\uC744 \uC9C0\uD0F1\uD558\uB294 \uAC00\uC7A5
      \uB2E8\uB2E8\uD55C \uCD95\uC774 \uB41C\uB2E4.\n\n\uC9C8\uC11C\uC758 \uC5BC\uAD74,
      \uCD08\uBC18 \uC548\uC804\uD310"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183274
    m_Localized: Longshot Hunter
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183275
    m_Localized: "\uC6D0\uC815\uB300\uC758 \uC2E4\uBB34 \uBCF4\uAE09 \uB2F4\uB2F9\uC774\uC790
      \uC7A5\uAC70\uB9AC \uC815\uCC30\uBCD1. \uC815\uCE58\uC801 \uBA85\uBD84\uC774\uB098
      \uC2E0\uC559\uC801 \uC0AC\uBA85\uC5D0\uB294 \uAD00\uC2EC\uC774 \uC5C6\uACE0,
      \uC6D0\uC815\uB300\uAC00 \uB0B4\uC77C\uB3C4 \uBA39\uACE0 \uC0B4\uC544\uB0A8\uC744
      \uC218 \uC788\uB294\uAC00\uC5D0\uB9CC \uC9D1\uC911\uD55C\uB2E4. \uC138\uB825
      \uAC04 \uAC08\uB4F1\uC744 \uB0C9\uC815\uD55C \uC2E4\uBB34\uC790\uC758 \uB208\uC73C\uB85C
      \uAD00\uCC30\uD558\uBA70, \uB300\uC758\uBCF4\uB2E4 \uBCF4\uAE09\uC120\uC774
      \uB04A\uAE30\uB294 \uAC83\uC744 \uB354 \uB450\uB824\uC6CC\uD55C\uB2E4. \uC815\uCE58\uB97C
      \uAFF0\uB6AB\uC5B4 \uBCF4\uB294 \uB208\uC774 \uC788\uC9C0\uB9CC, \uADF8 \uD1B5\uCC30\uC744
      \uAD73\uC774 \uACF5\uC720\uD558\uB824 \uB4E4\uC9C0\uB294 \uC54A\uB294\uB2E4.
      \uC0B4\uC544 \uB3CC\uC544\uAC00\uB294 \uAC83\uC774 \uC720\uC77C\uD55C \uBAA9\uD45C\uC774\uBA70,
      \uADF8 \uBAA9\uD45C\uAC00 \uC6D0\uC815\uB300 \uC804\uCCB4\uC758 \uC0DD\uC874\uACFC
      \uACB9\uCE58\uB294 \uD55C\uC5D0\uC11C\uB9CC \uD611\uB825\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183276
    m_Localized: "\uC6D0\uC815 \uC2E4\uBB34\uC790\uC758 \uC2DC\uC120"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183277
    m_Localized: "\uC6D0\uC815\uB300\uC758 \uC2E4\uBB34 \uBCF4\uAE09 \uB2F4\uB2F9\uC774\uC790
      \uC7A5\uAC70\uB9AC \uC815\uCC30\uBCD1. \uC815\uCE58\uC801 \uBA85\uBD84\uC774\uB098
      \uC2E0\uC559\uC801 \uC0AC\uBA85\uC5D0\uB294 \uAD00\uC2EC\uC774 \uC5C6\uACE0,
      \uC6D0\uC815\uB300\uAC00 \uB0B4\uC77C\uB3C4 \uBA39\uACE0 \uC0B4\uC544\uB0A8\uC744
      \uC218 \uC788\uB294\uAC00\uC5D0\uB9CC \uC9D1\uC911\uD55C\uB2E4. \uC138\uB825
      \uAC04 \uAC08\uB4F1\uC744 \uB0C9\uC815\uD55C \uC2E4\uBB34\uC790\uC758 \uB208\uC73C\uB85C
      \uAD00\uCC30\uD558\uBA70, \uB300\uC758\uBCF4\uB2E4 \uBCF4\uAE09\uC120\uC774
      \uB04A\uAE30\uB294 \uAC83\uC744 \uB354 \uB450\uB824\uC6CC\uD55C\uB2E4. \uC815\uCE58\uB97C
      \uAFF0\uB6AB\uC5B4 \uBCF4\uB294 \uB208\uC774 \uC788\uC9C0\uB9CC, \uADF8 \uD1B5\uCC30\uC744
      \uAD73\uC774 \uACF5\uC720\uD558\uB824 \uB4E4\uC9C0\uB294 \uC54A\uB294\uB2E4.
      \uC0B4\uC544 \uB3CC\uC544\uAC00\uB294 \uAC83\uC774 \uC720\uC77C\uD55C \uBAA9\uD45C\uC774\uBA70,
      \uADF8 \uBAA9\uD45C\uAC00 \uC6D0\uC815\uB300 \uC804\uCCB4\uC758 \uC0DD\uC874\uACFC
      \uACB9\uCE58\uB294 \uD55C\uC5D0\uC11C\uB9CC \uD611\uB825\uD55C\uB2E4.\n\n\uC6D0\uC815
      \uC2E4\uBB34\uC790\uC758 \uC2DC\uC120"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183278
    m_Localized: Mirror Cantor
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183279
    m_Localized: "\uAC70\uC6B8 \uC758\uB840\uB85C \uD750\uD2B8\uB7EC\uC9C4 \uBA85\uB839\uACFC
      \uAE30\uC5B5\uC744 \uB9DE\uCD94\uB294 \uC131\uAC00\uB300. \uC804\uC7A5\uC758
      \uC81C\uC5B4\uB97C \uAC77\uC5B4\uB0B4\uB294 \uB3D9\uC2DC\uC5D0, \uAC01 \uC138\uB825\uC774
      \uC11C\uB85C\uB97C \uC5B4\uB5BB\uAC8C \uBE44\uCD94\uB294\uC9C0 \uB05D\uAE4C\uC9C0
      \uD655\uC778\uD558\uAC8C \uB9CC\uB4DC\uB294 \uC778\uBB3C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183280
    m_Localized: "\uC815\uD654\uC640 \uAE30\uC5B5\uC744 \uD55C \uBC15\uC790\uB85C
      \uBB36\uB294 \uC131\uAC00\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183281
    m_Localized: "\uAC70\uC6B8 \uC758\uB840\uB85C \uD750\uD2B8\uB7EC\uC9C4 \uBA85\uB839\uACFC
      \uAE30\uC5B5\uC744 \uB9DE\uCD94\uB294 \uC131\uAC00\uB300. \uC804\uC7A5\uC758
      \uC81C\uC5B4\uB97C \uAC77\uC5B4\uB0B4\uB294 \uB3D9\uC2DC\uC5D0, \uAC01 \uC138\uB825\uC774
      \uC11C\uB85C\uB97C \uC5B4\uB5BB\uAC8C \uBE44\uCD94\uB294\uC9C0 \uB05D\uAE4C\uC9C0
      \uD655\uC778\uD558\uAC8C \uB9CC\uB4DC\uB294 \uC778\uBB3C\uC774\uB2E4.\n\n\uC815\uD654\uC640
      \uAE30\uC5B5\uC744 \uD55C \uBC15\uC790\uB85C \uBB36\uB294 \uC131\uAC00\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183282
    m_Localized: Oath Slayer
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183283
    m_Localized: "\uC655\uAD6D\uC758 \uB9F9\uC138\uAC80(Oath Blade). \uC9D1\uC815\uAD00
      \uD68C\uC758\uC758 \uBA85\uB839\uC744 \uBB3C\uB9AC\uC801\uC73C\uB85C \uC9D1\uD589\uD558\uB294
      \uB3C4\uAD6C\uB85C \uD6C8\uB828\uBC1B\uC740 \uC5EC\uC131 \uCC98\uD615\uC790\uC774\uBA70,
      \uC2A4\uC2A4\uB85C\uB3C4 \uADF8\uB807\uAC8C \uC815\uCCB4\uC131\uC744 \uC815\uC758\uD574
      \uC654\uB2E4. \uADF8\uB140\uC758 \uC874\uC7AC\uB294 \uCE7C \uADF8 \uC790\uCCB4\uB85C
      \uADDC\uC815\uB418\uC5C8\uACE0, \uCE7C\uC774 \uD5A5\uD558\uB294 \uACF3\uC5D0
      \uC758\uBB38\uC744 \uD488\uB294 \uAC83\uC740 \uB9F9\uC138\uC758 \uC704\uBC18\uC774\uB77C
      \uBC30\uC6E0\uB2E4. \uADF8\uB7EC\uB098 \uC6D0\uC815 \uC911 \uC815\uD654 \uC7AC\uD310\uC758
      \uC2E4\uC0C1\uACFC \uACA9\uC790 \uC624\uC6A9\uC758 \uC9C4\uC2E4\uC744 \uBAA9\uACA9\uD558\uBA74\uC11C,
      \uC790\uC2E0\uC774 \uD718\uB458\uB7EC \uC628 \uCE7C\uC774 \uC815\uC758\uAC00
      \uC544\uB2C8\uB77C \uC740\uD3D0\uB97C \uC704\uD55C \uAC83\uC774\uC5C8\uC744
      \uAC00\uB2A5\uC131\uC5D0 \uC9C1\uBA74\uD55C\uB2E4. \uBB34\uAE30\uB85C\uC11C\uC758
      \uC815\uCCB4\uC131 \uBC16\uC5D0\uC11C \uC790\uC2E0\uC774 \uB204\uAD6C\uC778\uC9C0\uB97C
      \uCC98\uC74C\uC73C\uB85C \uBB3B\uAE30 \uC2DC\uC791\uD558\uBA70, \uCE7C\uC744
      \uB4DC\uB294 \uC190\uC774 \uCC98\uC74C\uC73C\uB85C \uB9DD\uC124\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183284
    m_Localized: "\uC655\uAD6D\uC758 \uD3ED\uB825\uC131\uACFC \uBA85\uBD84\uC744
      \uB4DC\uB7EC\uB0B4\uB294 \uCE7C"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183285
    m_Localized: "\uC655\uAD6D\uC758 \uB9F9\uC138\uAC80(Oath Blade). \uC9D1\uC815\uAD00
      \uD68C\uC758\uC758 \uBA85\uB839\uC744 \uBB3C\uB9AC\uC801\uC73C\uB85C \uC9D1\uD589\uD558\uB294
      \uB3C4\uAD6C\uB85C \uD6C8\uB828\uBC1B\uC740 \uC5EC\uC131 \uCC98\uD615\uC790\uC774\uBA70,
      \uC2A4\uC2A4\uB85C\uB3C4 \uADF8\uB807\uAC8C \uC815\uCCB4\uC131\uC744 \uC815\uC758\uD574
      \uC654\uB2E4. \uADF8\uB140\uC758 \uC874\uC7AC\uB294 \uCE7C \uADF8 \uC790\uCCB4\uB85C
      \uADDC\uC815\uB418\uC5C8\uACE0, \uCE7C\uC774 \uD5A5\uD558\uB294 \uACF3\uC5D0
      \uC758\uBB38\uC744 \uD488\uB294 \uAC83\uC740 \uB9F9\uC138\uC758 \uC704\uBC18\uC774\uB77C
      \uBC30\uC6E0\uB2E4. \uADF8\uB7EC\uB098 \uC6D0\uC815 \uC911 \uC815\uD654 \uC7AC\uD310\uC758
      \uC2E4\uC0C1\uACFC \uACA9\uC790 \uC624\uC6A9\uC758 \uC9C4\uC2E4\uC744 \uBAA9\uACA9\uD558\uBA74\uC11C,
      \uC790\uC2E0\uC774 \uD718\uB458\uB7EC \uC628 \uCE7C\uC774 \uC815\uC758\uAC00
      \uC544\uB2C8\uB77C \uC740\uD3D0\uB97C \uC704\uD55C \uAC83\uC774\uC5C8\uC744
      \uAC00\uB2A5\uC131\uC5D0 \uC9C1\uBA74\uD55C\uB2E4. \uBB34\uAE30\uB85C\uC11C\uC758
      \uC815\uCCB4\uC131 \uBC16\uC5D0\uC11C \uC790\uC2E0\uC774 \uB204\uAD6C\uC778\uC9C0\uB97C
      \uCC98\uC74C\uC73C\uB85C \uBB3B\uAE30 \uC2DC\uC791\uD558\uBA70, \uCE7C\uC744
      \uB4DC\uB294 \uC190\uC774 \uCC98\uC74C\uC73C\uB85C \uB9DD\uC124\uC778\uB2E4.\n\n\uC655\uAD6D\uC758
      \uD3ED\uB825\uC131\uACFC \uBA85\uBD84\uC744 \uB4DC\uB7EC\uB0B4\uB294 \uCE7C"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183286
    m_Localized: Pack Raider
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183287
    m_Localized: "\uC774\uB9AC\uC194 \uBD80\uC871 \uBCF8\uB300\uC758 \uC80A\uC740
      \uBB34\uB9AC \uC9C0\uB3C4\uC790. \uB0C4\uC0C8\uC640 \uBC1C\uC790\uAD6D, \uB9E4\uB4ED\uC73C\uB85C
      \uC138\uC0C1\uC744 \uC77D\uB294\uB2E4. \uBCC0\uBC29\uBB38\uC774 \uBB34\uB108\uC9C4
      \uB4A4 \uD615\uC81C \uD68C\uC870\uAC00 200\uC77C \uB118\uAC8C \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC790, \uC194\uB77C\uB8F8 \uC0AC\uC81C \uB2E8\uB9B0\uACFC '\uB3D9\uB9F9\uC774
      \uC544\uB2C8\uB77C \uB3D9\uD589'\uC73C\uB85C \uBCC0\uBC29\uBB38 \uC548\uCABD\uC744
      \uD568\uAED8 \uBCF8\uB2E4. \uAC15\uC639\uC758 \uD770 \uB048 \uD654\uC0B4\uC744
      \uBC1B\uC544\uB4E4\uC778 \uAC83\uC774\uC9C0, \uC194\uB77C\uB8F8\uC744 \uBC1B\uC544\uB4E4\uC778
      \uAC83\uC774 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183288
    m_Localized: "\uC774\uB9AC\uC194\uC740 \uC2DC\uC870\uC758 \uC8C4\uB97C \uB450\uACE0
      \uAC08\uB77C\uC838 \uC788\uB2E4 \u2014 \uC78A\uACE0 \uC0B4\uC544\uB0A8\uC790\uB294
      \uBD84\uB9AC\uD30C(\uD68C\uC870), \uC678\uBD80\uC640 \uC601\uC6D0\uD788 \uC801\uB300\uD558\uC790\uB294
      \uAC15\uACBD\uD30C, \uC9C1\uBA74\uD558\uC790\uB294 \uBCF8\uB300(\uC774\uBE68\uBC14\uB78C).
      \uD615\uC81C \uD68C\uC870\uAC00 \uBD84\uB9AC\uD30C \uB178\uC120\uC73C\uB85C
      \uADF8\uC758 \uAE38\uC744 \uB9C9\uC73C\uBA74\uC11C, \uBD84\uB178\uAC00 \uC544\uB2C8\uB77C
      \uB178\uC120\uC73C\uB85C \uAC08\uB77C\uC120 \uD615\uC81C\uB97C \uC548\uACE0
      \uAC00\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183289
    m_Localized: "ch5\uC5D0\uC11C \uC774\uBE68\uBC14\uB78C\uC740 \uD68C\uC870\uB97C
      \uC5B5\uC9C0\uB85C \uD68C\uB2F4\uC5D0 \uB04C\uC5B4\uC624\uC9C0 \uC54A\uB294\uB2E4.
      \uB3CC\uC18C\uB9AC \uC2E0\uD638\uB85C '\uC624\uC9C0 \uC54A\uC9C0\uB9CC \uB04A\uC9C0\uB3C4
      \uC54A\uC740' \uD615\uC81C\uB97C \uD655\uC778\uD558\uACE0, \uD53C\uC758 \uC11C\uC57D
      \uB9E4\uB4ED\uC744 \uC544\uC9C1 \uC9D3\uC9C0 \uC54A\uC740 \uCC44 \uC790\uB9AC\uB97C
      \uBE44\uC6CC \uB454\uB2E4. \uBB34\uB9AC\uC758 \uBC18\uCABD\uC744 \uC783\uACE0\uB3C4
      \uB0C4\uC0C8\uB97C \uC9C0\uC6B0\uC9C0 \uC54A\uB294 \uCABD\uC744 \uD0DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183290
    m_Localized: "\uC774\uB9AC\uC194 \uBD80\uC871 \uBCF8\uB300\uC758 \uC80A\uC740
      \uBB34\uB9AC \uC9C0\uB3C4\uC790. \uB0C4\uC0C8\uC640 \uBC1C\uC790\uAD6D, \uB9E4\uB4ED\uC73C\uB85C
      \uC138\uC0C1\uC744 \uC77D\uB294\uB2E4. \uBCC0\uBC29\uBB38\uC774 \uBB34\uB108\uC9C4
      \uB4A4 \uD615\uC81C \uD68C\uC870\uAC00 200\uC77C \uB118\uAC8C \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC790, \uC194\uB77C\uB8F8 \uC0AC\uC81C \uB2E8\uB9B0\uACFC '\uB3D9\uB9F9\uC774
      \uC544\uB2C8\uB77C \uB3D9\uD589'\uC73C\uB85C \uBCC0\uBC29\uBB38 \uC548\uCABD\uC744
      \uD568\uAED8 \uBCF8\uB2E4. \uAC15\uC639\uC758 \uD770 \uB048 \uD654\uC0B4\uC744
      \uBC1B\uC544\uB4E4\uC778 \uAC83\uC774\uC9C0, \uC194\uB77C\uB8F8\uC744 \uBC1B\uC544\uB4E4\uC778
      \uAC83\uC774 \uC544\uB2C8\uB2E4.\n\n\uC774\uB9AC\uC194\uC740 \uC2DC\uC870\uC758
      \uC8C4\uB97C \uB450\uACE0 \uAC08\uB77C\uC838 \uC788\uB2E4 \u2014 \uC78A\uACE0
      \uC0B4\uC544\uB0A8\uC790\uB294 \uBD84\uB9AC\uD30C(\uD68C\uC870), \uC678\uBD80\uC640
      \uC601\uC6D0\uD788 \uC801\uB300\uD558\uC790\uB294 \uAC15\uACBD\uD30C, \uC9C1\uBA74\uD558\uC790\uB294
      \uBCF8\uB300(\uC774\uBE68\uBC14\uB78C). \uD615\uC81C \uD68C\uC870\uAC00 \uBD84\uB9AC\uD30C
      \uB178\uC120\uC73C\uB85C \uADF8\uC758 \uAE38\uC744 \uB9C9\uC73C\uBA74\uC11C,
      \uBD84\uB178\uAC00 \uC544\uB2C8\uB77C \uB178\uC120\uC73C\uB85C \uAC08\uB77C\uC120
      \uD615\uC81C\uB97C \uC548\uACE0 \uAC00\uC57C \uD55C\uB2E4.\n\nch5\uC5D0\uC11C
      \uC774\uBE68\uBC14\uB78C\uC740 \uD68C\uC870\uB97C \uC5B5\uC9C0\uB85C \uD68C\uB2F4\uC5D0
      \uB04C\uC5B4\uC624\uC9C0 \uC54A\uB294\uB2E4. \uB3CC\uC18C\uB9AC \uC2E0\uD638\uB85C
      '\uC624\uC9C0 \uC54A\uC9C0\uB9CC \uB04A\uC9C0\uB3C4 \uC54A\uC740' \uD615\uC81C\uB97C
      \uD655\uC778\uD558\uACE0, \uD53C\uC758 \uC11C\uC57D \uB9E4\uB4ED\uC744 \uC544\uC9C1
      \uC9D3\uC9C0 \uC54A\uC740 \uCC44 \uC790\uB9AC\uB97C \uBE44\uC6CC \uB454\uB2E4.
      \uBB34\uB9AC\uC758 \uBC18\uCABD\uC744 \uC783\uACE0\uB3C4 \uB0C4\uC0C8\uB97C
      \uC9C0\uC6B0\uC9C0 \uC54A\uB294 \uCABD\uC744 \uD0DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183291
    m_Localized: Pale Executor
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183292
    m_Localized: "\uAC10\uC815\uBCF4\uB2E4 \uD45C\uC2DD\uC744 \uBA3C\uC800 \uC77D\uB294
      \uC5B8\uB370\uB4DC \uC9D1\uD589\uC790. \uCC98\uD615\uC740 \uC2E0\uB150\uC774
      \uC544\uB2C8\uB77C \uB0A8\uC740 \uC9C8\uC11C\uB97C \uB05D\uB0B4\uB294 \uC808\uCC28\uC774\uBA70,
      \uC6D0\uC815\uB300\uB294 \uADF8 \uB0C9\uC815\uD568\uC744 \uB9C8\uC9C0\uB9C9
      \uC77C\uACA9\uC774 \uD544\uC694\uD55C \uC21C\uAC04\uC5D0\uB9CC \uB04C\uC5B4\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183293
    m_Localized: "\uD45C\uC2DD\uC744 \uB05D\uAE4C\uC9C0 \uB530\uB77C\uAC00\uB294
      \uCC3D\uBC31\uD55C \uC9D1\uD589\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183294
    m_Localized: "\uAC10\uC815\uBCF4\uB2E4 \uD45C\uC2DD\uC744 \uBA3C\uC800 \uC77D\uB294
      \uC5B8\uB370\uB4DC \uC9D1\uD589\uC790. \uCC98\uD615\uC740 \uC2E0\uB150\uC774
      \uC544\uB2C8\uB77C \uB0A8\uC740 \uC9C8\uC11C\uB97C \uB05D\uB0B4\uB294 \uC808\uCC28\uC774\uBA70,
      \uC6D0\uC815\uB300\uB294 \uADF8 \uB0C9\uC815\uD568\uC744 \uB9C8\uC9C0\uB9C9
      \uC77C\uACA9\uC774 \uD544\uC694\uD55C \uC21C\uAC04\uC5D0\uB9CC \uB04C\uC5B4\uB0B8\uB2E4.\n\n\uD45C\uC2DD\uC744
      \uB05D\uAE4C\uC9C0 \uB530\uB77C\uAC00\uB294 \uCC3D\uBC31\uD55C \uC9D1\uD589\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183295
    m_Localized: Prism Seeker
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183296
    m_Localized: "\uC9C4\uC2E4 \uCD94\uC801\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183297
    m_Localized: "\uC9C4\uC2E4 \uCD94\uC801\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183298
    m_Localized: "\uC9C4\uC2E4 \uCD94\uC801\uC790\n\n\uC9C4\uC2E4 \uCD94\uC801\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183299
    m_Localized: Rift Stalker
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183300
    m_Localized: "\uD55C\uB54C \uC6D0\uC815\uB300\uC758 \uC6C0\uC9C1\uC784\uC744
      \uCD94\uC801\uD558\uB358 \uC57C\uC218\uC871 \uCD94\uC801\uC790. \uADE0\uC5F4\uC758
      \uC794\uD5A5\uC744 \uC77D\uB294 \uAC10\uAC01 \uB54C\uBB38\uC5D0 \uC801\uC9C4\uC5D0\uC11C\uB294
      \uAE38\uC7A1\uC774\uC600\uACE0, \uD569\uB958 \uB4A4\uC5D0\uB294 \uC57D\uD55C
      \uCE21\uBA74\uC744 \uBA3C\uC800 \uCC3E\uC544\uB0B4\uB294 \uC815\uCC30 \uC790\uC0B0\uC774
      \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183301
    m_Localized: "\uC801\uC5D0\uC11C \uB3D9\uB9F9\uC73C\uB85C \uB3CC\uC544\uC120
      \uCCAB \uADE0\uC5F4 \uCD94\uC801\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183302
    m_Localized: "\uD55C\uB54C \uC6D0\uC815\uB300\uC758 \uC6C0\uC9C1\uC784\uC744
      \uCD94\uC801\uD558\uB358 \uC57C\uC218\uC871 \uCD94\uC801\uC790. \uADE0\uC5F4\uC758
      \uC794\uD5A5\uC744 \uC77D\uB294 \uAC10\uAC01 \uB54C\uBB38\uC5D0 \uC801\uC9C4\uC5D0\uC11C\uB294
      \uAE38\uC7A1\uC774\uC600\uACE0, \uD569\uB958 \uB4A4\uC5D0\uB294 \uC57D\uD55C
      \uCE21\uBA74\uC744 \uBA3C\uC800 \uCC3E\uC544\uB0B4\uB294 \uC815\uCC30 \uC790\uC0B0\uC774
      \uB41C\uB2E4.\n\n\uC801\uC5D0\uC11C \uB3D9\uB9F9\uC73C\uB85C \uB3CC\uC544\uC120
      \uCCAB \uADE0\uC5F4 \uCD94\uC801\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183303
    m_Localized: Shardblade
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183304
    m_Localized: "\uC911\uD6C4\uBC18 \uC804\uC5F4 \uB3CC\uD30C \uC7A5\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183305
    m_Localized: "\uC911\uD6C4\uBC18 \uC804\uC5F4 \uB3CC\uD30C \uC7A5\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183306
    m_Localized: "\uC911\uD6C4\uBC18 \uC804\uC5F4 \uB3CC\uD30C \uC7A5\uCE58\n\n\uC911\uD6C4\uBC18
      \uC804\uC5F4 \uB3CC\uD30C \uC7A5\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183307
    m_Localized: Storm Shaman
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183308
    m_Localized: "\uC57C\uC218\uC871 \uC528\uC871\uC758 \uC5EC\uC131 \uC758\uB840
      \uAD00\uC7A5\uC790\uC774\uC790 \uACF5\uB3D9\uCCB4 \uCE58\uC720\uC0AC. \uC21C\uD658\uC758
      \uC228\uACB0(Breath of the Cycle) \uC758\uB840\uB97C \uD1B5\uD574 \uC528\uC871\uC758
      \uAE30\uC5B5\uACFC \uC720\uB300\uB97C \uC720\uC9C0\uD558\uB294 \uC5ED\uD560\uC744
      \uB9E1\uACE0 \uC788\uB2E4. \uC6D0\uC815\uC5D0 \uD569\uB958\uD55C \uAC83\uC740
      \uBB34\uB9AC\uC5D0\uC11C \uB5A8\uC5B4\uC838 \uB098\uC628 \uC804\uC0AC\uB4E4\uC758
      \uC601\uD63C\uC744 \uB3CC\uBCF4\uAE30 \uC704\uD574\uC11C\uB2E4. \uADF8\uB140\uB294
      Heartforge\uC758 \uACF5\uBA85\uC744 \uBCF8\uB2A5\uC801\uC73C\uB85C \uAC10\uC9C0\uD558\uBA70,
      \uC774\uAC83\uC774 \uC528\uC871 \uC758\uB840\uC758 \uBFCC\uB9AC\uC640 \uC5F0\uACB0\uB418\uC5B4
      \uC788\uB2E4\uB294 \uC9C1\uAC10\uC744 \uD488\uACE0 \uC788\uB2E4. \uC804\uD22C\uBCF4\uB2E4
      \uCE58\uC720\uB97C, \uD30C\uAD34\uBCF4\uB2E4 \uBCF5\uC6D0\uC744 \uC6B0\uC120\uD558\uBA70,
      \uC528\uC871\uC758 \uC758\uB840\uAC00 \uB04A\uC5B4\uC9C0\uC9C0 \uC54A\uB294
      \uD55C \uD76C\uB9DD\uC740 \uB0A8\uC544 \uC788\uB2E4\uACE0 \uBBFF\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183309
    m_Localized: "\uC57C\uC218\uC871 \uACF5\uB3D9\uCCB4\uC758 \uC758\uB840"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183310
    m_Localized: "\uC57C\uC218\uC871 \uC528\uC871\uC758 \uC5EC\uC131 \uC758\uB840
      \uAD00\uC7A5\uC790\uC774\uC790 \uACF5\uB3D9\uCCB4 \uCE58\uC720\uC0AC. \uC21C\uD658\uC758
      \uC228\uACB0(Breath of the Cycle) \uC758\uB840\uB97C \uD1B5\uD574 \uC528\uC871\uC758
      \uAE30\uC5B5\uACFC \uC720\uB300\uB97C \uC720\uC9C0\uD558\uB294 \uC5ED\uD560\uC744
      \uB9E1\uACE0 \uC788\uB2E4. \uC6D0\uC815\uC5D0 \uD569\uB958\uD55C \uAC83\uC740
      \uBB34\uB9AC\uC5D0\uC11C \uB5A8\uC5B4\uC838 \uB098\uC628 \uC804\uC0AC\uB4E4\uC758
      \uC601\uD63C\uC744 \uB3CC\uBCF4\uAE30 \uC704\uD574\uC11C\uB2E4. \uADF8\uB140\uB294
      Heartforge\uC758 \uACF5\uBA85\uC744 \uBCF8\uB2A5\uC801\uC73C\uB85C \uAC10\uC9C0\uD558\uBA70,
      \uC774\uAC83\uC774 \uC528\uC871 \uC758\uB840\uC758 \uBFCC\uB9AC\uC640 \uC5F0\uACB0\uB418\uC5B4
      \uC788\uB2E4\uB294 \uC9C1\uAC10\uC744 \uD488\uACE0 \uC788\uB2E4. \uC804\uD22C\uBCF4\uB2E4
      \uCE58\uC720\uB97C, \uD30C\uAD34\uBCF4\uB2E4 \uBCF5\uC6D0\uC744 \uC6B0\uC120\uD558\uBA70,
      \uC528\uC871\uC758 \uC758\uB840\uAC00 \uB04A\uC5B4\uC9C0\uC9C0 \uC54A\uB294
      \uD55C \uD76C\uB9DD\uC740 \uB0A8\uC544 \uC788\uB2E4\uACE0 \uBBFF\uB294\uB2E4.\n\n\uC57C\uC218\uC871
      \uACF5\uB3D9\uCCB4\uC758 \uC758\uB840"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183311
    m_Localized: Trail Scout
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183312
    m_Localized: "\uC57C\uC218\uC871\uACFC \uC778\uAC04 \uC601\uC5ED\uC758 \uACBD\uACC4\uC5D0\uC11C
      \uC790\uB780 \uD63C\uD608 \uC5EC\uC131 \uC815\uCC30\uBCD1. \uC5B4\uB290 \uCABD\uC5D0\uB3C4
      \uC644\uC804\uD788 \uC18D\uD558\uC9C0 \uBABB\uD55C \uACBD\uD5D8\uC774 \uC624\uD788\uB824
      \uC591\uCABD \uC0AC\uC774\uC758 \uC644\uCDA9\uC7AC \uC5ED\uD560\uC744 \uAC00\uB2A5\uD558\uAC8C
      \uB9CC\uB4E4\uC5C8\uB2E4. \uAE34\uC7A5\uC774 \uADF9\uC5D0 \uB2EC\uD560 \uB54C
      \uAC74\uC870\uD55C \uB18D\uB2F4\uC73C\uB85C \uBD84\uC704\uAE30\uB97C \uAEBE\uB294
      \uB2A5\uB825\uC774 \uC788\uC73C\uBA70, \uBCF8\uC778\uC740 \uC774\uAC83\uC744
      \uC0DD\uC874 \uAE30\uC220\uC774\uB77C \uBD80\uB978\uB2E4. \uC720\uBA38 \uC544\uB798\uC5D0\uB294
      \uC5B4\uB514\uC5D0\uB3C4 \uC18D\uD558\uC9C0 \uBABB\uD55C \uC790\uC758 \uC678\uB85C\uC6C0\uC774
      \uC788\uC9C0\uB9CC, \uADF8\uB140\uAC00 \uADF8\uAC83\uC744 \uB4DC\uB7EC\uB0B4\uB294
      \uC77C\uC740 \uAC70\uC758 \uC5C6\uB2E4. \uB450 \uC138\uACC4 \uC0AC\uC774\uC758
      \uB2E4\uB9AC\uAC00 \uB418\uB294 \uAC83\uC774 \uC18C\uBA85\uC774\uB77C\uAE30\uBCF4\uB2E4\uB294,
      \uADF8 \uC704\uCE58 \uB9D0\uACE0\uB294 \uC124 \uACF3\uC774 \uC5C6\uAE30 \uB54C\uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183313
    m_Localized: "\uC720\uBA38\uC640 \uACBD\uACC4\uC758 \uC644\uCDA9\uC7AC"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183314
    m_Localized: "\uC57C\uC218\uC871\uACFC \uC778\uAC04 \uC601\uC5ED\uC758 \uACBD\uACC4\uC5D0\uC11C
      \uC790\uB780 \uD63C\uD608 \uC5EC\uC131 \uC815\uCC30\uBCD1. \uC5B4\uB290 \uCABD\uC5D0\uB3C4
      \uC644\uC804\uD788 \uC18D\uD558\uC9C0 \uBABB\uD55C \uACBD\uD5D8\uC774 \uC624\uD788\uB824
      \uC591\uCABD \uC0AC\uC774\uC758 \uC644\uCDA9\uC7AC \uC5ED\uD560\uC744 \uAC00\uB2A5\uD558\uAC8C
      \uB9CC\uB4E4\uC5C8\uB2E4. \uAE34\uC7A5\uC774 \uADF9\uC5D0 \uB2EC\uD560 \uB54C
      \uAC74\uC870\uD55C \uB18D\uB2F4\uC73C\uB85C \uBD84\uC704\uAE30\uB97C \uAEBE\uB294
      \uB2A5\uB825\uC774 \uC788\uC73C\uBA70, \uBCF8\uC778\uC740 \uC774\uAC83\uC744
      \uC0DD\uC874 \uAE30\uC220\uC774\uB77C \uBD80\uB978\uB2E4. \uC720\uBA38 \uC544\uB798\uC5D0\uB294
      \uC5B4\uB514\uC5D0\uB3C4 \uC18D\uD558\uC9C0 \uBABB\uD55C \uC790\uC758 \uC678\uB85C\uC6C0\uC774
      \uC788\uC9C0\uB9CC, \uADF8\uB140\uAC00 \uADF8\uAC83\uC744 \uB4DC\uB7EC\uB0B4\uB294
      \uC77C\uC740 \uAC70\uC758 \uC5C6\uB2E4. \uB450 \uC138\uACC4 \uC0AC\uC774\uC758
      \uB2E4\uB9AC\uAC00 \uB418\uB294 \uAC83\uC774 \uC18C\uBA85\uC774\uB77C\uAE30\uBCF4\uB2E4\uB294,
      \uADF8 \uC704\uCE58 \uB9D0\uACE0\uB294 \uC124 \uACF3\uC774 \uC5C6\uAE30 \uB54C\uBB38\uC774\uB2E4.\n\n\uC720\uBA38\uC640
      \uACBD\uACC4\uC758 \uC644\uCDA9\uC7AC"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183315
    m_Localized: "\"\uC800 \uBE5B\uC740... \uC131\uC720\uBB3C\uC758 \uBE5B\uC785\uB2C8\uB2E4.
      \uC65C \uBB34\uAE30\uC5D0 \uAE43\uB4E4\uC5B4 \uC788\uC2B5\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183316
    m_Localized: "\"\uBE5B\uB098\uB4E0 \uB9D0\uB4E0. \uBD80\uC218\uBA74 \uAEBC\uC838.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183317
    m_Localized: "\uACE8\uB818\uC758 \uAC00\uC2B4\uD310\uC774 \uAC08\uB77C\uC9C0\uACE0,
      \uC548\uCABD\uC5D0\uC11C \uB0AF\uC775\uC740 \uBE5B\uC774 \uC3DF\uC544\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183318
    m_Localized: "\"\uBFCC\uB9AC\uC758 \uAD00\uB9DD\uC790. 1800\uB144 \uB3D9\uC548
      \uC774 \uC790\uB9AC\uB97C \uC9C0\uD0A8 \uBB38\uC9C0\uAE30.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183319
    m_Localized: "\"\uC774\uD574\uB97C \uC704\uD55C \uC2F8\uC6C0\uC785\uB2C8\uB2E4.
      \uC815\uBCF5\uC774 \uC544\uB2D9\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183320
    m_Localized: "\"\uB3D9\uC871\uC774\uB2E4. \uAC00\uBCCD\uAC8C \uD558\uC9C0 \uB9C8\uB77C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183321
    m_Localized: "\"\uACA9\uC790\uAC00 \uAF2C\uC5EC \uC788\uB2E4. \uC800 \uC548\uC5D0
      \uC758\uC9C0\uAC00 \uC788\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183322
    m_Localized: "\"Aldric\uC758 \uAC83\uC785\uB2C8\uB2E4. \uC54C\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183323
    m_Localized: "\"\uC758\uC9C0\uB4E0 \uBB50\uB4E0. \uBD80\uC218\uBA74 \uC870\uC6A9\uD574\uC9C0\uACA0\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183324
    m_Localized: "\"\uAD00\uBB38 \uC218\uD638\uC790\uB2E4. \uB098\uC640 \uAC19\uC740
      \uC2DC\uB300\uC758.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183325
    m_Localized: "\"\uAE38\uC744 \uC5F4\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183326
    m_Localized: "\"\uC5ED\uC0AC \uC218\uC5C5\uC740 \uB098\uC911\uC5D0. \uBA3C\uC800
      \uC9C0\uB098\uAC00\uC790.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183327
    m_Localized: "\"\uCE68\uBB35\uC758 \uAE30\uB85D\uAD00. \uB098\uBCF4\uB2E4 \uC624\uB798\uB41C
      \uAE30\uC5B5\uC744 \uD488\uACE0 \uC788\uC5B4. \uC5F4\uC1E0\uB97C \uC548 \uB118\uAE30\uBA74
      \uC544\uBB34\uAC83\uB3C4 \uBABB \uAEBC\uB0B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183328
    m_Localized: "\"\uC9C4\uC2E4\uC5D0 \uB2E4\uAC00\uAC00\uB294 \uAE38\uC740 \uB9E4\uBC88
      \uC774\uB807\uC2B5\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183329
    m_Localized: "\"\uC26C\uC6E0\uC73C\uBA74 \uC9C4\uC2E4\uC774\uB77C\uACE0 \uC548
      \uBD88\uB800\uACA0\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183330
    m_Localized: "\"\uC800\uAC74 \uC655\uC774\uC5C8\uC5B4. \uC0AC\uB0E5\uD130\uC758
      \uC655. \uC9C0\uAE08\uC740...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183331
    m_Localized: "\"\uACA9\uC790\uAC00 \uB9CC\uB4E0 \uC655\uC774\uB2E4. \uBCF8\uB798
      \uBAA8\uC2B5\uC774 \uC544\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183332
    m_Localized: "\"\uD574\uBC29\uC2DC\uCF1C \uC90D\uC2DC\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183333
    m_Localized: "\"\uC9D1\uC815\uAD00 \uAC01\uD558. \uC9C8\uC11C\uB97C \uC9C0\uD0A4\uACA0\uB2E4\uACE0
      \uB9F9\uC138\uD55C \uBD84\uC774 \uC65C \uC774 \uC790\uB9AC\uC5D0 \uC11C \uACC4\uC2ED\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183334
    m_Localized: "\"\uAC11\uC637\uC5D0\uC11C \uD1A0\uD15C\uC774\uB791 \uAC19\uC740
      \uBE5B\uC774 \uB098. \uC9C1\uC811 \uBC97\uACA8\uC904\uAC8C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183335
    m_Localized: "\uC9D1\uC815\uAD00\uC774 \uB300\uB2F5\uD558\uC9C0 \uC54A\uB294\uB2E4.
      \uAC11\uC637\uC758 \uBE5B\uB9CC\uC774 \uC751\uB2F5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183336
    m_Localized: "\"\uB300\uC2EC\uBB38\uAD00. \uADF8 \uBD88\uAF43\uC774 \uD0DC\uC6B4
      \uAC83\uC740 \uC774\uB2E8\uC774 \uC544\uB2C8\uB77C \uC9C4\uC2E4\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183337
    m_Localized: "\"\uC9C4\uC9DC \uBD88\uAF43 \uC0C9\uC774 \uAD81\uAE08\uD588\uB294\uB370.
      \uAE08\uC0C9\uC774 \uC544\uB2C8\uB77C \uD54F\uBE5B\uC774\uC5C8\uB124.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183338
    m_Localized: "\uB300\uC2EC\uBB38\uAD00\uC758 \uC190\uC5D0\uC11C \uACA9\uC790
      \uBE5B\uC774 \uD0C0\uC624\uB978\uB2E4. Dawn Priest\uC640 \uAC19\uC740 \uBE5B\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183339
    m_Localized: "\"\uD68C\uC0C9 \uC1A1\uACF3\uB2C8. \uD615\uC81C\uC57C. \uB0A0 \uBC30\uC2E0\uC790\uB85C
      \uBD80\uB974\uACA0\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183340
    m_Localized: "\uC232 \uAE4A\uC740 \uACF3\uC5D0\uC11C \uB0AE\uC740 \uC6B8\uC74C\uC18C\uB9AC\uAC00
      \uC6B8\uB824\uC628\uB2E4. \uBD84\uB178\uAC00 \uC544\uB2C8\uB2E4. \uB354 \uC624\uB798\uB41C
      \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183341
    m_Localized: "\"\uADFC\uB370 \uC800\uB188 \uB0C4\uC0C8\uAC00 \uB2EC\uB77C. \uBD84\uB178\uAC00
      \uC774\uB807\uAC8C \uC624\uB798 \uAC00\uB294 \uAC74 \uC790\uC5F0\uC2A4\uB7FD\uC9C0
      \uC54A\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183342
    m_Localized: "\"\uB0B4\uAC00 Heartforge\uB97C \uD1B5\uC81C\uD588\uC18C. \uB0B4\uAC00
      \uD63C\uB3C8\uC5D0 \uC9C8\uC11C\uB97C \uAC00\uC838\uC654\uC18C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183343
    m_Localized: "\"\uB108\uD76C\uB294 \uB0B4\uAC00 \uC138\uC6B4 \uBAA8\uB4E0 \uAC83\uC744
      \uD30C\uAD34\uD558\uACE0 \uC788\uC18C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183344
    m_Localized: "\"\uB2F9\uC2E0\uC774 \uC138\uC6B4 \uAC83\uC740 \uB3C4\uAD74 \uC704\uC758
      \uC131\uC804\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183345
    m_Localized: "\"\uB05D\uC774\uB2E4, \uC124\uACC4\uC790.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183346
    m_Localized: "\uACE8\uB818\uC758 \uBAB8\uCCB4\uAC00 \uAC08\uB77C\uC9C4\uB2E4.
      \uAC00\uC2B4 \uC548\uCABD\uC5D0 \uC8FC\uBA39 \uD06C\uAE30\uC758 \uD30C\uD3B8\uC774
      \uBC15\uD600 \uC788\uB2E4. \uC131\uBB3C\uD568 \uC548\uC5D0 \uC788\uC5B4\uC57C
      \uD560 \uBE5B\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183347
    m_Localized: "\"\uC774\uAC83\uC774... \uACE8\uB818\uC758 \uC2EC\uC7A5\uC5D0...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183348
    m_Localized: "\"\uB124 \uC2E0\uC559\uC758 \uBE5B\uC774 \uB3CC\uB369\uC5B4\uB9AC
      \uC8FC\uBA39 \uC548\uC5D0 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4. \uCD95\uBCF5\uC774\uB77C,
      \uCC38 \uC4F8\uBAA8 \uC788\uB294 \uB9D0\uC774\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183349
    m_Localized: "\"\uBAB0\uB77C\uC11C \uADF8\uB7AC\uB358 \uAC70\uC57C. \uC6B0\uB9AC
      \uBAA8\uB450. \uC11C\uB85C\uB97C \uC801\uC774\uB77C \uBBFF\uC740 \uAC74 \uBB34\uC9C0\uC600\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183350
    m_Localized: "\"\uC778\uAC04\uB3C4, \uC57C\uC218\uC871\uB3C4, \uC5B8\uB370\uB4DC\uB3C4...
      \uAC19\uC740 \uAC83\uC5D0 \uB2F9\uD558\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183351
    m_Localized: "\uAD00\uB9DD\uC790\uC758 \uBAB8\uC774 \uBE5B\uC73C\uB85C \uD769\uC5B4\uC9C4\uB2E4.
      \uBA3C\uC9C0\uAC00 \uC544\uB2C8\uB77C \uAE30\uC5B5\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183352
    m_Localized: "\uACB0\uC815\uC774 \uBD80\uC11C\uC9C0\uBA74\uC11C \uBE5B\uC774
      \uC0AC\uBC29\uC73C\uB85C \uD769\uC5B4\uC9C4\uB2E4. \uC7A0\uC2DC, \uC18D\uC0AD\uC784\uC774
      \uBA48\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183353
    m_Localized: "\"\uC7A0\uC2DC\uBFD0\uC785\uB2C8\uB2E4. \uBCF8\uCCB4\uB294 \uC544\uB798\uC5D0
      \uC788\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183354
    m_Localized: "\"\uC7A0\uC2DC\uB77C\uB3C4 \uC870\uC6A9\uD558\uBA74 \uACE0\uB9C8\uC6B4
      \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183355
    m_Localized: "\uC218\uD638\uC790\uAC00 \uBE5B\uC73C\uB85C \uD769\uC5B4\uC9C4\uB2E4.
      \uAE38\uC774 \uC5F4\uB9B0\uB2E4. \uC544\uB798\uC5D0\uC11C \uC5F4\uAE30\uAC00
      \uC62C\uB77C\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183356
    m_Localized: "\"\uBB38\uC9C0\uAE30 \uCE58\uACE0 \uC608\uC758 \uBC14\uB974\uB354\uB77C.
      \uC8FD\uC73C\uBA74\uC11C\uB3C4 \uAE38\uC744 \uC5F4\uC5B4\uC8FC\uB2E4\uB2C8.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183357
    m_Localized: "\"\uC608\uC758\uAC00 \uC544\uB2C8\uB2E4. \uC778\uACC4\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183358
    m_Localized: "\uAE30\uB85D\uAD00\uC774 \uBB34\uB98E\uC744 \uAFC7\uB294\uB2E4.
      \uAC00\uC2B4\uC5D0\uC11C \uBE5B\uC774 \uC0C8\uC5B4\uB098\uC640 Dawn Priest\uC758
      \uC190\uC73C\uB85C \uD758\uB7EC\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183359
    m_Localized: "\"\uC5F4\uC1E0\uB97C \uB118\uACBC\uC5B4. \uB9C8\uC9C0\uB9C9 \uC21C\uAC04\uC5D0
      \uC6B0\uB9B4 \uC778\uC815\uD55C \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183360
    m_Localized: "\"\uC774 \uBB34\uAC8C\uB97C \uBC1B\uC744 \uC790\uACA9\uC774...
      \uC788\uC744\uAE4C\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183361
    m_Localized: "\uC57C\uC218 \uAD70\uC8FC\uAC00 \uC4F0\uB7EC\uC9C4\uB2E4. \uBAB8\uC774
      \uD480\uB9AC\uBA74\uC11C \u2014 \uD55C \uC21C\uAC04 \u2014 \uC6D0\uB798 \uBAA8\uC2B5\uC774
      \uBE44\uCE5C\uB2E4. \uD06C\uACE0 \uC544\uB984\uB2E4\uC6B4 \uC9D0\uC2B9\uC774\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183362
    m_Localized: "\"\uC798 \uAC00\uB77C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183363
    m_Localized: "\"\uAE30\uC5B5\uD574 \uC904\uAC8C. \uC6D0\uB798 \uBAA8\uC2B5\uC73C\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183364
    m_Localized: "\uD30C\uD3B8\uC774 \uBB3C\uC5D0 \uB2FF\uC790, \uC218\uBA74 \uC704\uB85C
      80\uB144 \uC804\uC758 \uC601\uC0C1\uC774 \uB5A0\uC624\uB978\uB2E4. \uB204\uAD70\uAC00\uAC00
      \uB545\uC744 \uD30C\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183365
    m_Localized: "\"\uC131\uC720\uBB3C\uC774... \uB3C4\uAD74\uD488\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183366
    m_Localized: "\"80\uB144. \uADF8\uB3D9\uC548 \uC0C8\uB07C\uB4E4\uC774 \uC11C\uB85C
      \uBB3C\uC5B4\uB72F\uC740 \uC774\uC720\uAC00 \uC5EC\uAE30 \uC788\uC5C8\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183367
    m_Localized: "\uD0D1 \uB0B4\uBCBD\uC5D0 \uAE4A\uC774 \uC0C8\uACA8\uC9C4 \uBB38\uC591\uC774
      \uC788\uB2E4. \uC778\uAC04\uC758 \uC131\uBB3C \uB3C4\uC548\uB3C4, \uC57C\uC218\uC871\uC758
      \uAC08\uD034 \uC790\uAD6D\uB3C4 \uC544\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183368
    m_Localized: "\"\uC774 \uBB38\uC591\uC740... \uC5B4\uB514\uC11C\uB3C4 \uBCF8
      \uC801\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. \uC131\uC804 \uAE30\uB85D\uC5D0\uB3C4
      \uC5C6\uB294 \uC591\uC2DD\uC774\uC5D0\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183369
    m_Localized: "\"\uC6B0\uB9AC \uAC83\uB3C4 \uC544\uB2C8\uC57C. \uB0C4\uC0C8\uAC00
      \uB2E4\uB974\uAC70\uB4E0. \uB3CC\uBCF4\uB2E4 \uC624\uB798\uB41C \uB0C4\uC0C8.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183370
    m_Localized: "\"\uBCF4\uACE0\uD560 \uAC83\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uBB38\uC740
      \uBC16\uC5D0\uC11C\uAC00 \uC544\uB2C8\uB77C \uC548\uC5D0\uC11C \uBB34\uB108\uC84C\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183371
    m_Localized: "\"\uBCF4\uACE0\uB294 \uC88B\uC740\uB370. \uBBFF\uC744 \uC0AC\uB78C\uC774
      \uC788\uC73C\uB824\uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183372
    m_Localized: "\uB9C8\uC744\uC758 \uBD88\uBE5B\uC774 \uBCF4\uC778\uB2E4. \uC791\uACE0
      \uBD88\uC548\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183373
    m_Localized: "\"\uAD50\uD68C\uC5D0 \uBCF4\uACE0\uD574\uC57C \uD569\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC... \uBB34\uC5C7\uC744 \uBCF4\uACE0\uD574\uC57C \uD560\uC9C0
      \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183374
    m_Localized: "\"\uC9C4\uC2E4\uC744 \uBCF4\uACE0\uD574. \uB108\uD76C\uAC00 \uBB58
      \uD588\uB294\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183375
    m_Localized: "Dawn Priest\uAC00 \uB300\uB2F5\uD558\uC9C0 \uC54A\uB294\uB2E4.
      \uC0AC\uC81C \uC778\uC7A5\uC744 \uB9CC\uC9C0\uC791\uAC70\uB9AC\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183376
    m_Localized: "\"\uB9C8\uC744\uC774 \uC881\uC544 \uBCF4\uC774\uB124. \uC9C0\uD558\uC5D0
      3000\uB144\uCE58 \uAE30\uC5B5\uC744 \uBCF4\uACE0 \uC624\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183377
    m_Localized: "\"\uC2DC\uB044\uB7FD\uB2E4. \uC5EC\uAE30\uB3C4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183378
    m_Localized: "\"\uC774\uC81C \uC2DC\uC791\uC785\uB2C8\uB2E4. \uBAA8\uB4E0 \uAC83\uC774.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183379
    m_Localized: "\"\uB9C8\uC744\uC5D0 \uC640\uB3C4 \uC26C\uB294 \uAE30\uBD84\uC774
      \uC548 \uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183380
    m_Localized: "\"\uC26C\uB294 \uAC74 \uB05D\uB098\uACE0 \uD574. \uB9CC\uC57D \uB05D\uB098\uBA74.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183381
    m_Localized: "\"\uB05D\uB0C5\uB2C8\uB2E4. \uBC18\uB4DC\uC2DC.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183382
    m_Localized: "\uB124 \uC0AC\uB78C\uC774 \uB9C8\uC744\uC744 \uB4F1\uC9C4\uB2E4.
      \uB9C8\uC9C0\uB9C9\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183383
    m_Localized: "\"\uB05D\uB0AC\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183384
    m_Localized: "\"...\uB05D\uB0AC\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183385
    m_Localized: "\uC138 \uC0AC\uB78C\uC774 \uB9C8\uC744\uB85C \uAC78\uC5B4 \uB4E4\uC5B4\uAC04\uB2E4.
      \uBE5B\uC774 \uB4F1 \uB4A4\uC5D0\uC11C \uBE44\uCD94\uACE0 \uC788\uB2E4. \uD55C
      \uBA85\uC774 \uBE60\uC838 \uC788\uB2E4. \uD558\uC9C0\uB9CC \uC11C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183386
    m_Localized: "Endless Cycle\uC774 \uD574\uAE08\uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183387
    m_Localized: "\uC0C8 \uBAA8\uB4DC \uAC1C\uBC29"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183388
    m_Localized: "Aegis Sentinel\uAC00 \uC6D0\uC815\uB300\uC5D0 \uD569\uB958\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183389
    m_Localized: "\uC601\uC6C5 \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183390
    m_Localized: "\uCC38\uD68C \uBC29\uBCBD\uC218\uAC00 \uC6D0\uC815\uB300\uC5D0
      \uD569\uB958\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183391
    m_Localized: "\uC601\uC6C5 \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183392
    m_Localized: "Echo Savant\uAC00 \uC6D0\uC815\uB300\uC5D0 \uD569\uB958\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183393
    m_Localized: "\uC601\uC6C5 \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183394
    m_Localized: "\uAC70\uC6B8 \uC131\uAC00\uB300\uAC00 \uC6D0\uC815\uB300\uC5D0
      \uD569\uB958\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183395
    m_Localized: "\uC601\uC6C5 \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183396
    m_Localized: "\uCC3D\uBC31\uD55C \uC9D1\uD589\uC790\uAC00 \uC6D0\uC815\uB300\uC5D0
      \uD569\uB958\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183397
    m_Localized: "\uC601\uC6C5 \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183398
    m_Localized: "Prism Seeker\uAC00 \uC6D0\uC815\uB300\uC5D0 \uD569\uB958\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183399
    m_Localized: "\uC601\uC6C5 \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183400
    m_Localized: "\uADE0\uC5F4 \uCD94\uC801\uC790\uAC00 \uC6D0\uC815\uB300\uC5D0
      \uD569\uB958\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183401
    m_Localized: "\uC601\uC6C5 \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183402
    m_Localized: "Shardblade\uAC00 \uC6D0\uC815\uB300\uC5D0 \uD569\uB958\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183403
    m_Localized: "\uC601\uC6C5 \uD569\uB958"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183404
    m_Localized: "\uAE30\uC5B5 \uD22C\uC0AC\uAC00 \uBCBD\uC5D0 \uD3BC\uCCD0\uC9C4\uB2E4.
      \uD55C \uB0A8\uC790\uAC00 \uB545\uC5D0\uC11C \uACA9\uC790 \uD30C\uD3B8\uC744
      \uB72F\uC5B4\uB0B4\uACE0 \uC788\uB2E4. \uCC28\uBD84\uD55C \uC5BC\uAD74. \uD655\uC2E0\uC5D0
      \uCC2C \uC190."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183405
    m_Localized: "\"\uC800 \uC5BC\uAD74... \uAD50\uD68C \uCD08\uC0C1\uD654\uC5D0\uC11C
      \uBCF8 \uC801\uC774 \uC788\uC2B5\uB2C8\uB2E4. Aldric Sternholt.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183406
    m_Localized: "\"\uC544, \uC800 \uC0AC\uB78C. \uAE30\uC5B5\uD574. \uAF64 \uB611\uB612\uD55C
      \uC778\uAC04\uC774\uC5C8\uC9C0. 80\uB144 \uC804\uC774\uBA74... \uCD5C\uADFC\uC774\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183407
    m_Localized: "\"\uC774 \uC790\uC758 \uC758\uC9C0\uAC00... \uC544\uC9C1 \uC548\uC5D0
      \uC788\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183408
    m_Localized: "Echo Savant\uC758 \uBAB8\uC774 \uACBD\uC9C1\uB41C\uB2E4. \uBB34\uC5B8\uAC00\uB97C
      \uAC10\uC9C0\uD55C \uAC83\uC774\uB2E4 \u2014 \uACA9\uC790 \uC548\uCABD\uC5D0\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183409
    m_Localized: "\"\uC0B4\uC544 \uC788\uB2E4\uB294 \uAC81\uB2C8\uAE4C? 40\uB144
      \uC804\uC5D0 \uC8FD\uC5C8\uB2E4\uACE0 \uAE30\uB85D\uB418\uC5B4 \uC788\uB294\uB370...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183410
    m_Localized: "\"\uC8FD\uC5C8\uB2E4. \uD558\uC9C0\uB9CC \uC758\uC9C0\uAC00 \uB0A8\uC558\uB2E4.
      \uC2EC\uC7A5\uC774 \uBA39\uC5C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183411
    m_Localized: "\"\uAE30\uC5B5\uC744 \uBA39\uB294 \uAE30\uACC4 \uC548\uC5D0\uC11C
      \uC8FD\uC5C8\uC73C\uBA74, \uAE30\uC5B5\uC774 \uB0A8\uB294 \uAC74 \uB2F9\uC5F0\uD558\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183412
    m_Localized: "\uAE30\uB85D\uC2E4 \uBC14\uB2E5\uC5D0 \uBB3C\uC774 \uCC28 \uC788\uB2E4.
      \uC120\uBC18 \uC704\uCABD\uC5D0\uB9CC \uCC45\uC774 \uB0A8\uC544 \uC788\uB2E4.
      Dawn Priest\uAC00 \uD55C \uAD8C\uC744 \uAEBC\uB0B8\uB2E4. \uD45C\uC9C0\uC5D0
      \uC11C\uBA85."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183413
    m_Localized: "\"A. Sternholt... \uC774 \uC774\uB984\uC744 \uC54C\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uAD50\uD68C \uCC3D\uC124 \uBB38\uC11C\uC5D0...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183414
    m_Localized: "\uC800\uB110 \uB9C8\uC9C0\uB9C9 \uD398\uC774\uC9C0\uC5D0 \uB2E4\uB978
      \uC789\uD06C\uB85C \uC4F4 \uBA54\uBAA8\uAC00 \uC788\uB2E4. '\uC81C4\uC218\uBB38
      \u2014 \uACA9\uC790\uAC00 \uC6B0\uB9AC\uAC00 \uC0DD\uAC01\uD55C \uAC83\uBCF4\uB2E4
      \uB354 \uB9CE\uC740 \uAC83\uC744 \uAE30\uC5B5\uD558\uACE0 \uC788\uB2E4. \uB124
      \uBC88\uC9F8 \uBD09\uC778 \uB4A4\uC5D0 \uBB34\uC5B8\uAC00 \uC7A0\uB4E4\uC5B4
      \uC788\uB2E4.'"
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183415
    m_Localized: "\"\uC81C4\uC218\uBB38? \uC601\uC6D0\uD55C \uC9C8\uC11C\uC758 \uAD50\uB9AC\uC5D0\uB294
      \uC218\uBB38\uC774 \uC138 \uAC1C\uBFD0\uC785\uB2C8\uB2E4. \uB124 \uBC88\uC9F8\uB77C\uB2C8...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183416
    m_Localized: "\"\uC138 \uAC1C\uB77C\uACE0 \uAC00\uB974\uCE58\uACE0 \uB124 \uAC1C\uC9F8\uB97C
      \uC228\uACBC\uB2E4? \uB108\uD76C \uC2E0\uC559\uB2F5\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183417
    m_Localized: "\"\uB204\uAD70\uB370.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183418
    m_Localized: "\"\uCD08\uB300 \uD559\uC790-\uC218\uC7A5\uC785\uB2C8\uB2E4. \uC601\uC6D0\uD55C
      \uC9C8\uC11C\uC758 \uAD50\uB9AC\uB97C \uC124\uACC4\uD55C \uC0AC\uB78C. \uC81C\uAC00
      \uBC30\uC6B4 \uBAA8\uB4E0 \uAE30\uB3C4\uC758... \uADFC\uC6D0\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183419
    m_Localized: "\uADF8\uB140\uC758 \uC190\uC774 \uD398\uC774\uC9C0\uB97C \uB118\uAE34\uB2E4.
      \uD544\uCCB4\uAC00 \uC810\uC810 \uAC70\uCE60\uC5B4\uC9C4\uB2E4. \uCD08\uBC18\uC758
      \uC815\uB3C8\uB41C \uAE00\uC528\uAC00 \uD6C4\uBC18\uC5D0\uB294 \uAC08\uACA8
      \uC4F4 \uAC83\uCC98\uB7FC \uBCC0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183420
    m_Localized: "\"\uB124 \uAE30\uB3C4\uB97C \uB9CC\uB4E0 \uB188\uC774 \uB545\uC744
      \uD30C\uACE0 \uC788\uC5C8\uB2E4\uACE0? \uB300\uB2E8\uD55C \uC2E0\uC774\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183421
    m_Localized: "\"\uC77C\uC9C0\uC5D0 \uACA9\uC790 \uD30C\uD3B8\uC758 \uAD70\uC0AC
      \uC804\uC6A9 \uC808\uCC28\uAC00... \uC774\uAC83\uC774 \uBC29\uBCBD \uAE30\uC220\uC758
      \uAE30\uBC18\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183422
    m_Localized: "Dawn Priest\uAC00 \uC77C\uC9C0\uB97C \uB2EB\uB294\uB2E4. \uC7A0\uC2DC
      \uB3D9\uC548 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uB294\uB2E4. \uBB3C\uC774
      \uBC1C\uBAA9\uC744 \uC801\uC2DC\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183423
    m_Localized: "\"\uC774 \uC0AC\uB78C\uC774 \uBAA8\uB4E0 \uAC83\uC744 \uC124\uACC4\uD588\uC2B5\uB2C8\uB2E4.
      \uAD50\uB9AC\uB3C4. \uBC29\uBCBD\uB3C4. \uC804\uBD80.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183424
    m_Localized: "\"\uC774\uC81C\uC57C \uB124 \uC9D1 \uAE30\uB465\uC774 \uB3C4\uB451\uC9C8\uB85C
      \uC138\uC6CC\uC9C4 \uAC78 \uC54C\uC558\uAD70.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183425
    m_Localized: "\uC720\uB9AC \uD30C\uD3B8\uC774 \uC6B8\uB9AC\uAE30 \uC2DC\uC791\uD55C\uB2E4.
      \uAC19\uC740 \uC18C\uB9AC\uAC00 \uC544\uB2C8\uB2E4. \uAC01\uC790 \uB2E4\uB978
      \uC8FC\uD30C\uC218\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183426
    m_Localized: "(to Dawn Priest) \"\uADF8\uB300\uC758 \uC18D\uC8C4\uAC00 \uC774\uAC83\uC744
      \uC694\uAD6C\uD558\uC624. \uC815\uD654\uB9CC\uC774 \uADF8\uB300\uAC00 \uC9C4
      \uBE5A\uC744 \uAC1A\uB294 \uAE38\uC774\uC624.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183427
    m_Localized: "\"\uC774 \uBAA9\uC18C\uB9AC... \uC800\uB110\uC758 \uD544\uCCB4\uC640
      \uAC19\uC740 \uC0AC\uB78C. \uC65C \uC81C\uAC8C...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183428
    m_Localized: "(to Pack Raider) \"\uBD09\uC778\uD558\uC2DC\uC624. \uBB34\uB9AC\uAC00
      \uC548\uC804\uD574\uC9C0\uC624. \uC9C0\uAE08, \uB2F9\uC7A5. \uD76C\uC0DD\uC740
      \uD544\uC694 \uC5C6\uC18C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183429
    m_Localized: "\"\uAEBC\uC838. \uB124 \uBAA9\uC18C\uB9AC\uAC00 \uB2EC\uCF64\uD560\uC218\uB85D
      \uC369\uC740 \uB0C4\uC0C8\uAC00 \uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183430
    m_Localized: "Pack Raider\uAC00 \uCF54\uB97C \uCC21\uADF8\uB9B0\uB2E4. \uD558\uC9C0\uB9CC
      \uC190\uC774 \uB5A8\uB9B0\uB2E4. \uBD09\uC778\uC774\uB77C\uB294 \uB9D0\uC5D0
      \uD754\uB4E4\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183431
    m_Localized: "\"\uC774 \uC790\uB294 \uC6B0\uB9AC\uAC00 \uB4E3\uACE0 \uC2F6\uC740
      \uB9D0\uC744 \uD558\uACE0 \uC788\uC5B4\uC694. \uADF8\uAC8C \uAC00\uC7A5 \uC704\uD5D8\uD55C
      \uAC70\uC608\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183432
    m_Localized: "\"...\uC54C\uC544. \uC54C\uACE0 \uC788\uC5B4. \uADF8\uB798\uB3C4
      \uBC18\uC740 \uB9DE\uB294 \uB9D0\uC774\uC796\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183433
    m_Localized: "\uC7AC\uAC00 \uBC14\uB78C\uC5D0 \uC2E4\uB824 \uC628\uB2E4. \uAD6D\uACBD\uBB38\uC758
      \uCCA0 \uD30C\uD3B8\uC774 \uB4E4\uD310\uC5D0 \uBC15\uD600 \uC788\uACE0, \uADF8
      \uC704\uB85C \uAE4C\uB9C8\uADC0 \uD55C \uB9C8\uB9AC\uAC00 \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183434
    m_Localized: "\"\uC9D1\uC815\uAD00 \uD68C\uC758\uC758 \uBA85\uC5D0 \uB530\uB77C,
      \uC774 \uBB38 \uB108\uBA38\uB97C \uC870\uC0AC\uD569\uB2C8\uB2E4. \uC601\uC6D0\uD55C
      \uC9C8\uC11C\uC758 \uC774\uB984\uC73C\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183435
    m_Localized: "\uBC14\uB78C\uC774 \uBC29\uD5A5\uC744 \uBC14\uAFBC\uB2E4. \uC7AC\uAC00
      \uC6D0\uC815\uB300\uC758 \uB4F1 \uB4A4\uB85C \uD758\uB7EC\uAC04\uB2E4. \uB3CC\uC544\uAC08
      \uAE38\uC774 \uD68C\uC0C9\uC73C\uB85C \uBB3B\uD78C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183436
    m_Localized: "\"\uAE30\uB85D\uC740 \uC798 \uD558\uC2DC\uB124. \uC0B4\uC544\uC11C
      \uC77D\uC744 \uC218 \uC788\uC73C\uBA74 \uC88B\uACA0\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183437
    m_Localized: "\"\uB108\uD76C\uAC00 \uC138\uC6B4 \uBB38\uC774\uC796\uC544. \uB108\uD76C
      \uC190\uC73C\uB85C \uB2EB\uC558\uACE0, \uB108\uD76C \uC190\uC73C\uB85C \uBD80\uC248\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183438
    m_Localized: "\"\uC548\uC5D0\uC11C\uBD80\uD130 \uBD80\uC11C\uC9C4 \uD754\uC801\uC785\uB2C8\uB2E4.
      \uC678\uBD80 \uCE68\uACF5\uC758 \uC591\uC0C1\uC774 \uC544\uB2D9\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183439
    m_Localized: "Dawn Priest\uAC00 \uCCA0 \uD30C\uD3B8\uC5D0 \uC190\uC744 \uB304\uB2E4.
      \uC190\uB05D\uC5D0 \uC7AC\uAC00 \uBB3B\uACE0, \uADF8 \uC544\uB798 \uAE08\uC18D\uC774
      \uC544\uC9C1 \uB530\uB73B\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183440
    m_Localized: "\"\uC7AC \uB0C4\uC0C8\uAC00 \uC0AC\uD758\uC9F8 \uBC14\uB78C\uC744
      \uD0C0\uACE0 \uC654\uB2E4. \uCF54\uAC00 \uBA39\uBA39\uD574\uC9C8 \uC815\uB3C4\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183441
    m_Localized: "\"\uAE4C\uB9C8\uADC0\uAC00 \uB0AE\uAC8C \uC549\uC544 \uC788\uC2B5\uB2C8\uB2E4.
      \uBA39\uC744 \uAC83\uC774 \uB9CE\uB2E4\uB294 \uB73B\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183442
    m_Localized: "Pack Raider\uAC00 \uCF54\uB97C \uCC21\uADF8\uB9B0\uB2E4. \uADF8\uC758
      \uB208\uC774 \uB4E4\uD310\uC744 \uD6D1\uB294\uB2E4 \u2014 \uC2DC\uCCB4\uAC00
      \uC544\uB2C8\uB77C \uB0C4\uC0C8\uB97C \uC77D\uB294 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183443
    m_Localized: "\"\uC2DC\uCCB4 \uC369\uB294 \uB0C4\uC0C8\uAC00 \uC544\uB2C8\uC57C.
      \uB3CC\uC774 \uD0C4 \uB0C4\uC0C8\uB2E4. \uB545 \uBC11\uC5D0\uC11C \uBB54\uAC00\uAC00
      \uC62C\uB77C\uC654\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183444
    m_Localized: "\"\uAE30\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uBB38\uC740 \uBC16\uC5D0\uC11C\uAC00
      \uC544\uB2C8\uB77C \uC548\uC5D0\uC11C \uBB34\uB108\uC84C\uB2E4\uACE0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183445
    m_Localized: "\uBF08\uAC00 \uB098\uBB34\uCC98\uB7FC \uC790\uB77C \uC788\uB2E4.
      \uAC00\uC9C0\uB9C8\uB2E4 \uC778\uAD11\uC774 \uB9E4\uB2EC\uB824 \uC788\uACE0,
      \uACF5\uAE30\uAC00 \uB450\uAEBC\uC6CC \uC228\uC26C\uAE30\uAC00 \uD798\uB4E4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183446
    m_Localized: "\"\uC5EC\uAE30\uB294 \uAE30\uC5B5\uC758 \uC6B0\uBB3C\uC774 \uC544\uB2C8\uB77C
      \uBC14\uB2E4\uC57C. \uBC00\uB3C4\uAC00 \uBB18\uC5ED\uC758 \uC218\uC2ED \uBC30.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183447
    m_Localized: "\"\uBF08\uAC00 \uBFCC\uB9AC\uCC98\uB7FC \uC790\uB790\uC5B4. \uC232\uC774\uB791\uC740
      \uB2E4\uB978 \uB0C4\uC0C8\uC57C. \uB3CC \uB0C4\uC0C8\uD558\uACE0... \uC2AC\uD514
      \uB0C4\uC0C8.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183448
    m_Localized: "\"\uACA9\uC790 \uC870\uAC01\uC774 \uBE5B\uB098\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uBB34\uC5B8\uAC00\uAC00 \uAE68\uC5B4\uB098\uB824 \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183449
    m_Localized: "\"\uC870\uC2EC\uD574. \uC5EC\uAE30\uC11C \uBE60\uC9C0\uBA74 \uBABB
      \uB098\uC640. \uAE30\uC5B5\uC774 \uC0BC\uCF1C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183450
    m_Localized: "\uBC14\uB2E5\uC758 \uACA9\uC790\uBB38\uC774 \uD76C\uBBF8\uD558\uAC8C
      \uB9E5\uB3D9\uD55C\uB2E4. \uC2EC\uC7A5\uBC15\uB3D9 \uAC19\uC740 \uB9AC\uB4EC."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183451
    m_Localized: "\"\uBC11\uC5D0\uC11C \uBB54\uAC00\uAC00 \uB6F4\uB2E4. \uC2EC\uC7A5
      \uC18C\uB9AC \uAC19\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183452
    m_Localized: "\"\uC2EC\uC7A5\uC774 \uC544\uB2D9\uB2C8\uB2E4. \uB354 \uC624\uB798\uB41C
      \uAC83\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183453
    m_Localized: "\uACA9\uC790\uBB38\uC758 \uBE5B\uC774 \uAC15\uD574\uC9C4\uB2E4.
      \uC11D\uD654 \uB098\uBB34 \uC0AC\uC774\uC5D0\uC11C, \uBB34\uC5B8\uAC00\uAC00
      \uB208\uC744 \uB728\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183454
    m_Localized: "\"...\uC774\uAC74 \uAE30\uC5B5\uC758 \uC794\uD5A5\uC774 \uC544\uB2C8\uC57C.
      \uC0B4\uC544 \uC788\uB294 \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183455
    m_Localized: "\uB300\uC2EC\uBB38\uAD00\uC774 \uC4F0\uB7EC\uC9C4\uB2E4. \uC190\uC5D0\uC11C
      \uAEBC\uC9C0\uB294 \uBE5B\uC774 Dawn Priest\uC758 \uC190\uB05D\uC5D0\uC11C\uB3C4
      \uAC19\uC740 \uC0C9\uC73C\uB85C \uAE5C\uBE61\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183456
    m_Localized: "\"\uCD95\uBCF5\uACFC \uC815\uD654\uAC00 \uAC19\uC740 \uC6D0\uB9AC\uC600\uC2B5\uB2C8\uB2E4.
      \uC81C \uAE30\uB3C4\uC640 \uC800 \uC790\uC758 \uBD88\uAF43\uC740... \uBC29\uD5A5\uB9CC
      \uB2EC\uB790\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183457
    m_Localized: "\"\uC774 \uBAA9\uC18C\uB9AC... \uACBD\uC804\uC758 \uC11C\uBB38\uACFC
      \uAC19\uC740 \uC5B4\uC870\uC785\uB2C8\uB2E4. \uC65C \uBB34\uAE30\uC5D0\uC11C...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183458
    m_Localized: "Dawn Priest\uAC00 \uC790\uAE30 \uC190\uC744 \uB0B4\uB824\uB2E4\uBCF8\uB2E4.
      \uC624\uB798\uB3C4\uB85D."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183459
    m_Localized: "\"\uC0AC\uC81C \uC5BC\uAD74\uC774 \uCC98\uC74C\uC73C\uB85C \uBB34\uB108\uC84C\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183460
    m_Localized: "\"\uBB34\uB108\uC9C4 \uAC8C \uB9DE\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183461
    m_Localized: "\uBB3C\uC774 \uB300\uC2EC\uBB38\uAD00\uC758 \uBAB8 \uC704\uB85C
      \uCC28\uC624\uB978\uB2E4. \uBE5B\uC774 \uC644\uC804\uD788 \uAEBC\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183462
    m_Localized: "\"\uBBFF\uB358 \uAC8C \uBD80\uC11C\uC9C0\uB294 \uC18C\uB9AC\uAC00
      \uC774\uB807\uAC8C \uD06C\uB354\uB77C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183463
    m_Localized: "\"...\uC608.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183464
    m_Localized: "\uB300\uC2EC\uBB38\uAD00\uC758 \uAC11\uC637\uC5D0\uC11C \uACA9\uC790
      \uD30C\uD3B8\uC774 \uBE60\uC838\uB098\uC624\uBA70 \uC9E7\uC740 \uC74C\uC131\uC774
      \uC6B8\uB9B0\uB2E4. \uC624\uB798\uB41C \uB9D0\uD22C. \uAD50\uB9AC\uCC98\uB7FC
      \uB4E4\uB9AC\uC9C0\uB9CC \uBB34\uAE30\uC5D0\uC11C \uB098\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183465
    m_Localized: "\"...\uD1B5\uC81C\uD560 \uC218 \uC788\uC18C. \uC9C8\uC11C\uB294
      \uB3C4\uAD6C\uC5D0\uC11C \uC2DC\uC791\uD558\uC624...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183466
    m_Localized: "\uD68C\uC0C9 \uC1A1\uACF3\uB2C8\uAC00 \uC4F0\uB7EC\uC9C4\uB2E4.
      \uBAB8\uC5D0\uC11C \uBE5B\uC774 \uC0C8\uC5B4\uB098\uC628\uB2E4 \u2014 Heartforge
      \uD30C\uD3B8\uC774 \uADF8\uC758 \uC0B4 \uC548\uC5D0 \uBC15\uD600 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183467
    m_Localized: "\"...\uD615\uC81C\uAC00 \uB9C8\uC9C0\uB9C9\uC5D0 \uB9D0\uD588\uC5B4.
      '\uC774 \uBD84\uB178\uAC00 \uB0B4 \uAC83\uC774 \uC544\uB2D0 \uC218\uB3C4 \uC788\uB2E4'\uACE0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183468
    m_Localized: "Pack Raider\uAC00 \uD615\uC81C\uC758 \uBAB8\uC5D0\uC11C \uD30C\uD3B8\uC744
      \uBF51\uB294\uB2E4. \uC190\uC774 \uB5A8\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183469
    m_Localized: "\"\uBC14\uB78C\uC774 \uC544\uB2C8\uC57C. \uB545 \uBC11\uC5D0\uC11C
      \uC62C\uB77C\uC628 \uAC70\uC57C. \uC774\uB188\uC744 \uBBF8\uCE58\uAC8C \uB9CC\uB4E0
      \uAC83\uC774.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183470
    m_Localized: "\"\uC801\uB300\uAC00 \uC870\uC791\uB41C \uAC83\uC774\uB77C\uBA74...
      \uCC98\uC74C\uC73C\uB85C, \uD568\uAED8 \uAC78\uC744 \uC774\uC720\uAC00 \uC0DD\uACBC\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183471
    m_Localized: "\"\uC774\uC720 \uB530\uC704 \uD544\uC694 \uC5C6\uC5B4. \uD615\uC81C\uB97C
      \uBBF8\uCE58\uAC8C \uB9CC\uB4E0 \uB188\uC774 \uBC11\uC5D0 \uC788\uB2E4\uBA74
      \uAC00\uB294 \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183472
    m_Localized: "Pack Raider\uAC00 \uD30C\uD3B8\uC744 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uB294\uB2E4.
      Dawn Priest\uAC00 \uC190\uC744 \uBED7\uC9C0\uB9CC \u2014 \uADF8\uAC00 \uB208\uC73C\uB85C
      \uAC70\uC808\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183473
    m_Localized: "\"...\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC758 \uAC83\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183474
    m_Localized: "\uC0C1\uC2B9\uC774 \uC2DC\uC791\uB41C\uB2E4. \uAE34 \uD1B5\uB85C.
      \uBC1C\uC18C\uB9AC\uAC00 \uC138 \uC0AC\uB78C\uBD84\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183475
    m_Localized: "Worldscar\uC758 \uC881\uC740 \uD2C8 \uC0AC\uC774\uB85C \uD558\uB298\uC774
      \uBCF4\uC778\uB2E4. \uC7AC\uAC00 \uC544\uB2C8\uB77C \uBE5B\uC774 \uB0B4\uB824\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183476
    m_Localized: "\"\uD55C \uBA85\uC774 \uBE60\uC84C\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183477
    m_Localized: "\uC544\uBB34\uB3C4 \uB300\uAFB8\uD558\uC9C0 \uC54A\uB294\uB2E4.
      \uBE5B\uC774 \uC138 \uC0AC\uB78C\uC758 \uC5BC\uAD74\uC744 \uBE44\uCD98\uB2E4.
      \uC9C0\uCE58\uACE0, \uC0C1\uCC98 \uC785\uACE0, \uC904\uC5B4\uB4E4\uC5C8\uB2E4.
      \uD558\uC9C0\uB9CC \uC11C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183478
    m_Localized: "\"\uBE5B\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183479
    m_Localized: "\uADF8\uB140\uC758 \uC190\uC5D0 \uC0AC\uC81C \uC778\uC7A5\uC774
      \uC5C6\uB2E4. \uB300\uC2E0 Aldric\uC758 \uC77C\uC9C0\uAC00 \uC788\uB2E4. \uC99D\uAC70\uB97C
      \uAC00\uC838\uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183480
    m_Localized: "\"\uB530\uB73B\uD574. \uBC14\uB78C\uC774.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183481
    m_Localized: "Pack Raider\uAC00 \uCF54\uB97C \uB4E4\uC5B4\uC62C\uB9B0\uB2E4.
      \uC7AC \uB0C4\uC0C8\uAC00 \uC544\uB2C8\uB2E4. \uD759 \uB0C4\uC0C8. \uC0B4\uC544
      \uC788\uB294 \uD759."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183482
    m_Localized: "\"...\uC5EC\uAE30 \uCC98\uC74C \uC628 \uAE30\uBD84\uC774\uC57C.
      \uC774\uC0C1\uD558\uB124. \uBD84\uBA85 \uC544\uB294 \uACF3\uC778\uB370.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183483
    m_Localized: "\uADF8\uB140\uAC00 \uC783\uC5B4\uBC84\uB9B0 \uAC83\uC758 \uD754\uC801.
      \uC775\uC219\uD568\uC758 \uBD80\uC7AC."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183484
    m_Localized: "\"\uAD1C\uCC2E\uC2B5\uB2C8\uB2E4. \uC0C8\uB85C\uC6B4 \uAE30\uC5B5\uC744
      \uB9CC\uB4E4\uBA74 \uB429\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183485
    m_Localized: "\uC138 \uC0AC\uB78C\uC774 \uBC16\uC73C\uB85C \uB098\uC628\uB2E4.
      \uD558\uB298\uC774 \uC5F4\uB824 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183486
    m_Localized: "\uC720\uB9AC \uC232 \uACBD\uACC4\uC5D0\uC11C \uC791\uC740 \uADF8\uB9BC\uC790\uAC00
      \uB2EC\uB824\uC628\uB2E4. \uC57C\uC218\uC871 \uC18C\uB140. \uB2E4\uB9AC\uC5D0
      \uD53C\uAC00 \uBB3B\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183487
    m_Localized: "\"\uD615... \uC624\uBE60! \uC7A5\uB85C\uB4E4\uC774... Grey Fang\uC774
      \uC11C\uC57D\uC744 \uCCA0\uD68C\uD588\uC5B4\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183488
    m_Localized: "\"\uC0AC\uC2E4\uC774\uC57C. \uADF8\uB9AC\uACE0 \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC740 \uCABD\uB3C4 \uC0B4\uC558\uC5B4. \uB2E4\uB9CC \uB2E4\uB978 \uC774\uB984\uC73C\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183489
    m_Localized: "\"\uBB50\uB77C\uACE0?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183490
    m_Localized: "\"\uC778\uAC04\uACFC \uC190\uC7A1\uC740 \uAC74 \uBC30\uC2E0\uC774\uB798\uC694.
      \uBB34\uB9AC\uC758 \uBC18\uC774 \uB5A0\uB0AC\uC5B4\uC694. Grey Fang\uC774 \uC774\uB04C\uACE0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183491
    m_Localized: "Pack Raider\uAC00 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uB294\uB2E4.
      \uBD84\uB178\uAC00 \uC544\uB2C8\uB2E4. \uBE44\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183492
    m_Localized: '"Pack Raider..."'
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183493
    m_Localized: "\"...\uD615\uC81C\uAC00 \uB0A0 \uBC84\uB838\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183494
    m_Localized: "\uADF8\uAC00 \uCC98\uC74C\uC73C\uB85C \uB0C4\uC0C8\uB3C4 \uBC14\uB78C\uB3C4
      \uC774\uC57C\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4. \uAC10\uAC01\uC774 \uAEBC\uC9C4
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183495
    m_Localized: "\"400\uB144 \uC804\uC5D0\uB3C4 \uAC19\uC740 \uC77C\uC774 \uC788\uC5C8\uC9C0.
      \uBB34\uB9AC\uAC00 \uCABC\uAC1C\uC9C0\uACE0, \uD55C\uCABD\uC774 \uB3CC\uC544\uC624\uC9C0
      \uC54A\uC558\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183496
    m_Localized: "\"\uC704\uB85C\uC57C? \uB18D\uB2F4\uC774\uC57C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183497
    m_Localized: "\uC720\uB9AC \uC232\uC758 \uAC00\uC7A5\uC790\uB9AC. Worldscar \uD558\uAC15\uB85C\uAC00
      \uBCF4\uC778\uB2E4. \uB124 \uC0AC\uB78C\uC774 \uC11C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183498
    m_Localized: "\"\uC800\uB294 Aldric\uC774 \uB9CC\uB4E0 \uAD50\uB9AC\uB97C \uB193\uC544\uC57C
      \uD569\uB2C8\uB2E4. \uC0AC\uC81C \uC778\uC7A5\uC774 \uBCF4\uC99D\uD558\uB294
      \uAC83\uC774... \uB354 \uC774\uC0C1 \uC81C \uAC83\uC774 \uC544\uB2D9\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183499
    m_Localized: "\"\uB098\uB294 \uB0A8\uB294\uB2E4. \uACA9\uC790 \uC548\uC5D0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183500
    m_Localized: "\uAC00\uC7A5 \uC9E7\uC740 \uBB38\uC7A5. \uAC00\uC7A5 \uBB34\uAC70\uC6B4
      \uBB38\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183501
    m_Localized: "\"...\uBB50\uB77C\uACE0?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183502
    m_Localized: "\"\uC601\uAD6C \uC218\uD638\uC790\uAC00 \uD544\uC694\uD558\uB2E4.
      \uC790\uC6D0\uD55C\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183503
    m_Localized: "\"\uB2E4\uB978 \uBC29\uBC95\uC774...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183504
    m_Localized: "\"1800\uB144 \uC804\uC5D0\uB3C4 \uC120\uD0DD\uD588\uB2E4. \uC774\uBC88\uC5D0\uB294
      \uB208\uC744 \uB728\uACE0 \uD55C\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183505
    m_Localized: "\"\uB09C \uC774\uBBF8 \uC528\uC871 \uBC18\uC744 \uC783\uC5C8\uC5B4.
      \uB354 \uC783\uC744 \uAC83\uB3C4 \uC5C6\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183506
    m_Localized: "\"\uB09C \uAC00\uC7A5 \uC624\uB798\uB41C \uAE30\uC5B5\uC744 \uC918\uC57C
      \uD574. \uB0B4\uAC00 \uB204\uAD6C\uC600\uB294\uC9C0\uC758 \uCC98\uC74C\uC744.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183507
    m_Localized: "Grave Hexer\uAC00 \uC6C3\uB294\uB2E4. \uD3C9\uC18C\uC758 \uAC74\uC870\uD55C
      \uC6C3\uC74C\uC774 \uC544\uB2C8\uB2E4. \uC57D\uAC04 \uB354 \uC587\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183508
    m_Localized: "\"\uBB50, \uCCAB \uAE30\uC5B5 \uC5C6\uC774\uB3C4 400\uB144\uC740
      \uC0B4\uC558\uC796\uC544. \uC5BC\uB9C8\uB098 \uC911\uC694\uD558\uACA0\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183509
    m_Localized: "\"\uC548\uC740 \uB108\uBB34 \uC870\uC6A9\uD558\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183510
    m_Localized: "\"\uBB50\uAC00?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183511
    m_Localized: "\"\uACA9\uC790 \uC548. 1800\uB144. \uC544\uBB34 \uC18C\uB9AC\uB3C4
      \uC5C6\uC5C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183512
    m_Localized: "Grave Hexer\uAC00 \uADF8 \uB9D0\uC758 \uBB34\uAC8C\uB97C \uC774\uD574\uD558\uAE30
      \uC804\uC5D0, Echo Savant\uAC00 \uC785\uC744 \uC5F0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183513
    m_Localized: "\uACA9\uC790 \uC548\uC5D0\uC11C \uD504\uB9AC\uC998 \uBCF4\uB77C\uBE5B\uC774
      \uC77C\uC815\uD55C \uB9AC\uB4EC\uC73C\uB85C \uB9E5\uB3D9\uD55C\uB2E4. Echo
      Savant\uC758 \uD615\uC0C1\uC774 \uD76C\uBBF8\uD558\uAC8C \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183514
    m_Localized: "\"\uAC10\uC0AC\uD569\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183515
    m_Localized: "\uADF8\uC758 \uB9C8\uC9C0\uB9C9 \uB9D0\uC774\uB2E4. \uACA9\uC790\uAC00
      \uACE0\uC694\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183516
    m_Localized: "\uB300\uB2F5\uC774 \uC5C6\uB2E4. \uD55C\uCC38 \uB3D9\uC548."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183517
    m_Localized: "\"...\uB4E4\uB9AC\uB098?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183518
    m_Localized: "\uB9E5\uB3D9\uC774 \uD55C \uBC88 \uAC15\uD574\uC9C4\uB2E4. \uB300\uB2F5\uC778
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183519
    m_Localized: "\"\uAE30\uC5B5\uD574 \uC904\uAC8C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183520
    m_Localized: "Grave Hexer\uAC00 \uBA48\uCD98\uB2E4. \uADF8\uB140\uAC00 \uBB34\uC5C7\uC744
      \uAE30\uC5B5\uD560 \uC218 \uC788\uB294\uC9C0, \uC774\uC81C \uBCF8\uC778\uB3C4
      \uD655\uC2E4\uD558\uC9C0 \uC54A\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183521
    m_Localized: "\"...\uAE30\uC5B5\uD560 \uC218 \uC788\uB294 \uB9CC\uD07C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183522
    m_Localized: "\uB9E5\uB3D9\uC774 \uB610 \uD55C \uBC88. \uC774\uBC88\uC5D0\uB294
      \uC57D\uD558\uB2E4. \uBA40\uC5B4\uC9C0\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183523
    m_Localized: "\"...\uC2DC\uB044\uB7FD\uC9C0 \uC54A\uB2E4. \uCC98\uC74C\uC73C\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183524
    m_Localized: "\uACFC\uC218\uC6D0 \uCD9C\uAD6C. \uBF08\uB098\uBB34 \uC0AC\uC774\uB85C
      \uC778\uAD11\uC774 \uC2A4\uB7EC\uC9C4\uB2E4. \uC55E\uC11C \uAC77\uB294 \uC138
      \uC0AC\uB78C\uACFC \uB5A8\uC5B4\uC838, \uB458\uC774 \uB098\uB780\uD788 \uAC77\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183525
    m_Localized: "\"\uAE30\uC5B5\uC744 \uC5B4\uB5BB\uAC8C \uACAC\uB514\uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183526
    m_Localized: "\"...\uBB50?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183527
    m_Localized: "\"\uADF8 \uBB34\uAC8C\uB97C. \uC218\uBC31 \uB144. \uC5B4\uB5BB\uAC8C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183528
    m_Localized: "\"\uB18D\uB2F4\uC744 \uD574. 400\uB144 \uC804 \uC77C\uC744 \uC5B4\uC81C
      \uC77C\uCC98\uB7FC \uB9D0\uD558\uBA74 \uC0AC\uB78C\uB4E4\uC774 \uC6C3\uAC70\uB4E0.
      \uC6C3\uAE30\uBA74 \uACAC\uB51C \uB9CC\uD574.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183529
    m_Localized: '"..."'
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183530
    m_Localized: "Echo Savant\uAC00 \uC6C3\uC9C0 \uC54A\uB294\uB2E4. Grave Hexer\uB294
      \uADF8\uAC83\uC744 \uC54C\uC544\uCC28\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183531
    m_Localized: "\"\uB108\uB294 \uC548 \uC6C3\uB294\uAD6C\uB098. 1800\uB144 \uB3D9\uC548
      \uD63C\uC790 \uC788\uC73C\uBA74 \uADF8\uB807\uAC8C \uB418\uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183532
    m_Localized: "\"\uC6C3\uB294 \uBC95\uC744 \uC78A\uC5C8\uB2E4. \uACA9\uC790 \uC548\uC5D0\uB294
      \uC6C3\uC744 \uC774\uC720\uAC00 \uC5C6\uC5C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183533
    m_Localized: "\"\uADF8\uB7FC \uB0B4\uAC00 \uB300\uC2E0 \uC6C3\uC5B4 \uC904\uAC8C.
      \uB124 \uBAAB\uAE4C\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183534
    m_Localized: "Aldric\uC774 \uC11C \uC788\uB2E4. \uAD34\uBB3C\uC774 \uC544\uB2C8\uB2E4.
      \uD55C \uB0A8\uC790\uC758 \uD615\uC0C1. \uD559\uC790\uC758 \uAC00\uC6B4\uC744
      \uC785\uACE0 \uC788\uB2E4. \uB208\uC774 \uCC28\uBD84\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183535
    m_Localized: "\"80\uB144\uC774\uC624. 80\uB144 \uB3D9\uC548 \uB0B4\uAC00 \uB9CC\uB4E0
      \uC9C8\uC11C\uAC00 \uC774 \uC138\uACC4\uB97C \uC720\uC9C0\uD588\uC18C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183536
    m_Localized: "\"\uCD5C\uC120\uC774 \uC774\uAC70\uC600\uB2E4\uBA74. \uCD5C\uC120\uC774
      \uB05D\uB0A0 \uB54C\uAC00 \uB410\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183537
    m_Localized: "\"\uB2F9\uC2E0\uC774 \uB9CC\uB4E0 \uC9C8\uC11C\uAC00 \uC544\uB2CC,
      \uC6B0\uB9AC\uAC00 \uC120\uD0DD\uD55C \uC9C8\uC11C\uB97C \uC138\uC6B0\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183538
    m_Localized: "\"\uADF8\uB798\uB3C4... \uAE30\uC5B5\uD574 \uC8FC\uC2DC\uC624.
      \uB0B4\uAC00 \uBA3C\uC800 \uBD88\uC744 \uCF30\uB2E4\uB294 \uAC83\uC744.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183539
    m_Localized: "Aldric\uC758 \uD615\uC0C1\uC774 \uBE5B\uB098\uAE30 \uC2DC\uC791\uD55C\uB2E4.
      \uC804\uD22C\uAC00 \uC2DC\uC791\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183540
    m_Localized: "\"\uC720\uC9C0\uAC00 \uC544\uB2D9\uB2C8\uB2E4. \uCC29\uCDE8\uC600\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183541
    m_Localized: "\"\uCC29\uCDE8\uB77C \uD558\uC2DC\uC624? \uB0B4\uAC00 \uC624\uAE30
      \uC804\uC5D0 \uB108\uD76C\uB294 \uC11C\uB85C\uB97C \uC8FD\uC774\uACE0 \uC788\uC5C8\uC18C.
      \uC774\uC720\uB3C4 \uBAA8\uB978 \uCC44.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183542
    m_Localized: "\uD2C0\uB9B0 \uB9D0\uC774 \uC544\uB2C8\uB2E4. Dawn Priest\uAC00
      \uB300\uAFB8\uD558\uC9C0 \uBABB\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183543
    m_Localized: "\"\uADF8\uB798, \uC774\uC720\uB294 \uBAB0\uB790\uC9C0. \uADFC\uB370
      \uB124\uAC00 \uC774\uC720\uB97C \uC54C\uACE0\uB3C4 \uC774\uC6A9\uD55C \uAC70\uC796\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183544
    m_Localized: "\"\uC774\uC6A9\uC774 \uC544\uB2C8\uB77C \uAD00\uB9AC\uC600\uC18C.
      \uD63C\uB3C8\uC5D0 \uAD6C\uC870\uB97C \uBD80\uC5EC\uD55C \uAC83\uC774\uC624.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183545
    m_Localized: "\"\uAD6C\uC870. \uB0B4 \uB3D9\uC871\uC758 \uAE30\uC5B5\uC744 \uC5F0\uB8CC\uB85C
      \uC4F0\uBA74\uC11C \uADF8\uAC78 \uAD6C\uC870\uB77C\uACE0 \uBD88\uB800\uAD70.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183546
    m_Localized: "\"\uB098\uB294... \uCD5C\uC120\uC744 \uD0DD\uD588\uC18C. \uBD88\uC644\uC804\uD55C
      \uC138\uACC4\uC5D0\uC11C \uBD88\uC644\uC804\uD55C \uC9C8\uC11C\uB97C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183547
    m_Localized: "\uD55C \uC21C\uAC04, Aldric\uC774 \uC9C4\uC2EC\uC73C\uB85C \uC2AC\uD37C
      \uBCF4\uC778\uB2E4. \uADF8\uB798\uC11C \uB354 \uBB34\uC12D\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183548
    m_Localized: "\uC720\uB9AC \uB098\uBB34\uAC00 \uBE5B\uC744 \uAD74\uC808\uC2DC\uD0A8\uB2E4.
      \uBB34\uC9C0\uAC1C \uD30C\uD3B8\uC774 \uC0AC\uBC29\uC5D0 \uD769\uC5B4\uC9C4\uB2E4.
      \uC544\uB984\uB2F5\uB2E4 \u2014 \uBC1C \uC544\uB798\uC11C \uC720\uB9AC\uAC00
      \uBD80\uC11C\uC9C0\uAE30 \uC804\uAE4C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183549
    m_Localized: "\"\uACB0\uC815 \uC548\uC5D0... \uC0AC\uB78C\uC774 \uC788\uC2B5\uB2C8\uB2E4.
      \uAC11\uC637\uC744 \uC785\uC740 \uCC44\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183550
    m_Localized: "\uC720\uB9AC\uB97C \uBC1F\uC744 \uB54C\uB9C8\uB2E4 \uC18C\uB9AC\uAC00
      \uB09C\uB2E4. \uBF08\uAC00 \uBD80\uB7EC\uC9C0\uB294 \uC18C\uB9AC\uC640 \uBE44\uC2B7\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183551
    m_Localized: "\"\uC801\uC5B4\uB3C4 \uACF5\uD3C9\uD558\uAE34 \uD588\uB124. \uBAA8\uB450
      \uAC19\uC774 \uC8FD\uC5C8\uC73C\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183552
    m_Localized: "\"\uAC19\uC774 \uC8FD\uC740 \uAC8C \uC544\uB2C8\uB2E4. \uAC19\uC774
      \uC5BC\uC5B4\uBD99\uC740 \uAC70\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183553
    m_Localized: "\"\uB2E4\uC2DC \uC774\uB7F0 \uC77C\uC774 \uC5C6\uB3C4\uB85D. \uADF8\uAC83\uC774
      \uC774\uC720\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183554
    m_Localized: "\"\uC57C\uC218\uC871\uB3C4 \uC788\uC5B4. \uB2EC\uB9AC\uB2E4\uAC00
      \uAD73\uC740 \uC790\uC138\uC57C. \uB3C4\uB9DD\uCE58\uACE0 \uC788\uC5C8\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183555
    m_Localized: "\"\uB0B4 \uB3D9\uC871\uB3C4 \uBCF4\uC5EC. \uC5EC\uAE30\uC11C \uBAA8\uB450\uAC00
      \uB3D9\uC2DC\uC5D0 \uC8FD\uC5C8\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183556
    m_Localized: "\uACB0\uC815 \uB098\uBB34 \uC0AC\uC774\uB85C \uBE5B\uC774 \uAD74\uC808\uB41C\uB2E4.
      \uB124 \uAC00\uC9C0 \uC0C9 \u2014 \uAC15\uCCA0 \uD68C\uC0C9, \uD638\uBC15\uC0C9,
      \uC778\uAD11 \uB179\uC0C9, \uD504\uB9AC\uC998 \uBCF4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183557
    m_Localized: "Echo Savant\uAC00 \uACE0\uAC1C\uB97C \uB4E0\uB2E4. \uC720\uB9AC
      \uC218\uAD00 \uC0AC\uC774\uB85C \uD558\uB298\uC774 \uBCF4\uC778\uB2E4. 1800\uB144
      \uB9CC\uC5D0 \uCC98\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183558
    m_Localized: "\uD3C9\uAC00\uB3C4, \uBD84\uC11D\uB3C4 \uC544\uB2CC \uD45C\uC815\uC774
      \uADF8\uC758 \uC5BC\uAD74\uC5D0 \uB5A0\uC624\uB978\uB2E4. \uC6D0\uC815\uB300\uAC00
      \uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183559
    m_Localized: "\"\uD3ED\uC8FC \uD754\uC801\uC774\uB2E4. \uC2EC\uC7A5\uC774 \uD55C
      \uBC88 \uD130\uC84C\uB2E4. \uC624\uB798\uC804\uC5D0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183560
    m_Localized: "\"\uBAA8\uB4E0 \uC138\uB825\uC758 \uC804\uC0AC\uAC00... \uAC19\uC740
      \uC21C\uAC04\uC5D0...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183561
    m_Localized: "\"\uC5EC\uAE30\uAC00 \uC911\uB9BD \uC9C0\uB300\uB77C\uB294 \uAC70\uC57C.
      \uC544\uBB34\uB3C4 \uC774\uAE30\uC9C0 \uBABB\uD55C \uACF3.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183562
    m_Localized: "\uC11D\uC870 \uAD00\uBB38\uC774 \uC19F\uC544 \uC788\uB2E4. \uB124
      \uC138\uB825\uC758 \uBB38\uC591\uC774 \uAC01 \uAE30\uB465\uC5D0 \uC0C8\uACA8\uC838
      \uC788\uB2E4. Heartforge\uC758 \uB9E5\uB3D9\uC774 \uAC00\uC2B4\uD30D\uAE4C\uC9C0
      \uC6B8\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183563
    m_Localized: "\"\uB124 \uBB38\uC591\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uB124 \uC138\uB825\uC774
      \uD568\uAED8 \uC788\uC744 \uB54C\uB9CC \uC5F4\uB9AC\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183564
    m_Localized: "\"...\uC84C\uB124.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183565
    m_Localized: "\uAD00\uBB38\uC774 \uC5F4\uB9B0\uB2E4. \uC548\uC5D0\uC11C \uC5B4\uB460\uC774
      \uC544\uB2C8\uB77C \uBE5B\uC774 \uC62C\uB77C\uC628\uB2E4. \uC624\uB798\uB41C
      \uBE5B."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183566
    m_Localized: "\"\uB0B4\uB824\uAC11\uC2DC\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183567
    m_Localized: "\"\uB3CC\uC544\uC62C \uC218 \uC788\uB294 \uAC70\uC9C0?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183568
    m_Localized: "\"\uBB38\uB3C4 \uC6B0\uB9AC\uBCF4\uB2E4 \uBA3C\uC800 \uC54C\uACE0
      \uC788\uC5C8\uB124. \uD568\uAED8 \uC640\uC57C \uD55C\uB2E4\uB294 \uAC78.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183569
    m_Localized: "\"3000\uB144 \uC804 \uBB38\uC774 \uC6B0\uB9AC\uBCF4\uB2E4 \uB611\uB611\uD558\uB2E4\uB2C8.
      \uC790\uC874\uC2EC \uC0C1\uD558\uB124.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183570
    m_Localized: "\"\uBB38\uC774 \uC544\uB2C8\uB2E4. \uC2DC\uD5D8\uC774\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183571
    m_Localized: "\uAD00\uBB38\uC758 \uBB38\uC591\uC774 \uBE5B\uB098\uAE30 \uC2DC\uC791\uD55C\uB2E4.
      \uAC01\uC790\uC758 \uC0C9\uC73C\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183572
    m_Localized: "\"\uBB38\uC774\uB4E0 \uC2DC\uD5D8\uC774\uB4E0. \uC5F4\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183573
    m_Localized: "\"\uADF8\uB798. \uCDA9\uBD84\uD788 \uAE30\uB2E4\uB838\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183574
    m_Localized: "\"\uAE30\uB2E4\uB9B0 \uAC74 \uB098\uC57C. 400\uB144.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183575
    m_Localized: "\"1800\uB144.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183576
    m_Localized: "\uBE5B\uC758 \uD658\uC601\uC774 \uD3BC\uCCD0\uC9C4\uB2E4. \uB124
      \uC885\uC871\uC774 \uAC19\uC740 \uBB3C\uAC00\uC5D0 \uC11C \uC788\uB2E4. \uBB34\uAE30\uAC00
      \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183577
    m_Localized: "\"\uC774 \uAE30\uC5B5 \uBD10. \uC804\uC7C1 \uC774\uC804\uC774\uC57C.
      \uAF64 \uC88B\uC740 \uC2DC\uC808\uC774\uC5C8\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183578
    m_Localized: "\"\uD1A0\uD15C\uC774 \uAE30\uC5B5\uD558\uACE0 \uC788\uC5C8\uC5B4.
      \uC9C4\uB3D9 \uC18D\uC5D0 \uC61B \uB0C4\uC0C8\uAC00 \uB0A8\uC544 \uC788\uC5C8\uB294\uB370...
      \uC774\uAC70\uC600\uAD6C\uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183579
    m_Localized: "\"\uACF5\uC874\uC758 \uC99D\uAC70\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uAE4C?
      \uC65C \uC544\uBB34\uB3C4...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183580
    m_Localized: "\"\uC774 \uAE30\uC5B5\uC744 \uC9C0\uC6B4 \uAC8C \uC655\uAD6D\uC758
      \uCCAB \uBC88\uC9F8 \uC8C4\uC57C. \uACF5\uC874\uC758 \uC99D\uAC70\uB97C \uBB3B\uACE0
      \uC801\uC744 \uB9CC\uB4E4\uC5C8\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183581
    m_Localized: "\uD658\uC601\uC774 \uD750\uB824\uC9C4\uB2E4. \uBB3C\uAC00\uC758
      \uB124 \uC885\uC871\uC774 \uC11C\uC11C\uD788 \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183582
    m_Localized: "\"...\uC88B\uC740 \uB0C4\uC0C8\uC600\uC744 \uAC70\uC57C. \uADF8
      \uBB3C\uAC00.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183583
    m_Localized: "\"\uC6B0\uB9AC\uAC00 \uBB3B\uC740 \uAC83\uC774 \uC774\uB807\uAC8C\uB098
      \uB9CE\uC558\uC2B5\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183584
    m_Localized: "\uACA9\uC790 \uC870\uAC01\uC774 Grave Hexer\uC758 \uC190\uC5D0\uC11C
      \uBC18\uC751\uD55C\uB2E4. \uBE5B\uC774 \uADF8\uB140\uC758 \uAC00\uC7A5 \uC624\uB798\uB41C
      \uAE30\uC5B5 \uCABD\uC73C\uB85C \uD750\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183585
    m_Localized: "\"...\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183586
    m_Localized: "\"\uBB34\uC2A8 \uC77C\uC785\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183587
    m_Localized: "\"\uC815\uD654\uC758 \uC5F4\uC1E0\uAC00 \uAE30\uC5B5\uC774\uC57C.
      \uAC00\uC7A5 \uC624\uB798\uB41C \uAE30\uC5B5. \uADF8\uB7EC\uB2C8\uAE4C...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183588
    m_Localized: "\"\uB0B4 \uAE30\uC6D0 \uAE30\uC5B5\uC774\uC57C. \uB0B4\uAC00 \uB204\uAD6C\uC600\uB294\uC9C0\uC758
      \uCC98\uC74C. \uADF8\uAC78 \uBA39\uC774\uB85C \uC918\uC57C \uD55C\uB2E4\uB294
      \uB73B\uC774\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183589
    m_Localized: "\"\uADF8\uB7EC\uBA74 \uB10C...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183590
    m_Localized: "\"\uBB50, 400\uB144\uCE58 \uB2E4\uB978 \uAE30\uC5B5\uC740 \uB0A8\uC73C\uB2C8\uAE4C.
      \uD638\uBC00\uBE75 \uC88B\uC544\uD588\uB358 \uC0AC\uB78C \uAE30\uC5B5\uC774\uB77C\uB4E0\uAC00.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183591
    m_Localized: "\uB18D\uB2F4\uC744 \uD558\uACE0 \uC788\uB2E4. \uD558\uC9C0\uB9CC
      \uC190\uC774 \uACA9\uC790 \uC870\uAC01\uC744 \uAF49 \uC950\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183592
    m_Localized: "\"...\uBB34\uAC81\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183593
    m_Localized: "\"400\uB144 \uC804 \uC804\uC7C1? \uC544, \uADF8\uAC70. \uD654\uC694\uC77C\uC774\uC5C8\uB098.
      \uC218\uC694\uC77C\uC774\uC5C8\uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183594
    m_Localized: "\"400\uB144\uC744 \uC694\uC77C\uB85C \uAE30\uC5B5\uD574?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183595
    m_Localized: "\"\uBE44\uAC00 \uC654\uAC70\uB4E0. \uBE44 \uC624\uB294 \uB0A0\uC740
      \uAE30\uC5B5\uC774 \uC798 \uD758\uB7EC\uB098\uC640\uC11C \uC815\uB9AC\uD558\uAE30
      \uC88B\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183596
    m_Localized: "\"\uC0B0 \uC790\uBCF4\uB2E4 \uC624\uB798 \uAE30\uC5B5\uD558\uC2DC\uB294
      \uBD84\uC774\uAD70\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183597
    m_Localized: "\"\uAE30\uC5B5\uC740 \uBABB \uB0B4\uB824\uB193\uC544. \uD314\uC774
      \uAE38\uC5B4\uC11C \uB9CE\uC774 \uB4DC\uB294 \uAC8C \uC544\uB2C8\uB77C, \uB0B4\uB824\uB193\uB294
      \uBC95\uC744 \uC78A\uC740 \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183598
    m_Localized: "Grave Hexer\uAC00 \uC11D\uAD00 \uD558\uB098\uB97C \uC190\uAC00\uB77D\uC73C\uB85C
      \uD22D \uCE5C\uB2E4. \uBA3C\uC9C0\uAC00 \uC77C\uC5B4\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183599
    m_Localized: "\"\uC774 \uC0AC\uB78C\uC740 270\uB144 \uC804\uC5D0 \uC8FD\uC5C8\uC5B4.
      \uBE75\uC744 \uC88B\uC544\uD588\uC9C0. \uD638\uBC00\uBE75.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183600
    m_Localized: "\"...\uADF8\uB7F0 \uAC83\uAE4C\uC9C0 \uAE30\uC5B5\uD574?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183601
    m_Localized: "Grave Hexer\uAC00 \uBE5B\uB098\uB294 \uAD6C\uC2AC\uC744 \uC591\uC190\uC5D0
      \uC950\uACE0 \uC788\uB2E4. \uC548\uC5D0\uC11C \uBE5B\uC774 \uB9E5\uB3D9\uD55C\uB2E4.
      \uB204\uAD70\uAC00\uC758 \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uB294
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183602
    m_Localized: "\"\uC774\uAC8C \uB0B4 \uCCAB \uAE30\uC5B5\uC774\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183603
    m_Localized: '"..."'
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183604
    m_Localized: "Grave Hexer\uAC00 \uD55C\uB3D9\uC548 \uC11C \uC788\uB2E4. \uC190\uC774
      \uD5C8\uACF5\uC744 \uC954\uB2E4. \uC544\uAE4C\uAE4C\uC9C0 \uBB34\uC5C7\uC744
      \uC950\uACE0 \uC788\uC5C8\uB294\uC9C0 \uBAA8\uB974\uACA0\uB2E4\uB294 \uC5BC\uAD74\uB85C."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183605
    m_Localized: "\"...\uBB50\uC600\uB354\uB77C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183606
    m_Localized: "\"\uC5B4\uB5A4 \uAE30\uC5B5\uC785\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183607
    m_Localized: "\"...\uD587\uBE5B\uC774\uC5C8\uC5B4. \uADF8\uB9AC\uACE0 \uB204\uAD70\uAC00\uC758
      \uBAA9\uC18C\uB9AC. \uC774\uB984\uC740 \uAE30\uC5B5 \uC548 \uB098. \uADFC\uB370
      \uB530\uB73B\uD588\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183608
    m_Localized: "\uD3C9\uC18C\uC758 \uAC74\uC870\uD568\uC774 \uC5C6\uB2E4. \uCC98\uC74C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183609
    m_Localized: "\"\uB193\uC9C0 \uB9C8. \uB2E4\uB978 \uBC29\uBC95\uC774 \uC788\uC744
      \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183610
    m_Localized: "\"400\uB144 \uB3D9\uC548 \uC774\uAC83\uB9CC\uC740 \uC9C0\uCF30\uC5B4.
      \uB2E4\uB978 \uAE30\uC5B5\uC740 \uD750\uB824\uC838\uB3C4 \uC774\uAC74... \uC774\uAC74
      \uC120\uBA85\uD588\uAC70\uB4E0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183611
    m_Localized: "\uC190\uC774 \uB5A8\uB9B0\uB2E4. \uADF8\uB140\uC758 \uC190\uC774
      \uB5A8\uB9AC\uB294 \uAC83\uC744 \uCC98\uC74C \uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183612
    m_Localized: "\"\uADFC\uB370 \uC774\uAC83\uBCF4\uB2E4 \uC9C0\uCF1C\uC57C \uD560
      \uAC8C \uB354 \uB9CE\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183613
    m_Localized: "\uAD6C\uC2AC\uC744 \uACA9\uC790\uC5D0 \uBC00\uC5B4\uB123\uB294\uB2E4.
      \uBE5B\uC774 \uD37C\uC9C4\uB2E4. \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183614
    m_Localized: "\"\uC138 \uAC00\uC9C0 \uAE38\uC774 \uC788\uB2E4. \uC815\uD654,
      \uBD09\uC778, \uD30C\uAD34.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183615
    m_Localized: "\uC9E7\uC740 \uCE68\uBB35. \uC720\uB9AC \uB098\uBB47\uAC00\uC9C0\uC5D0\uC11C
      \uBE5B\uC774 \uAD74\uC808\uB418\uC5B4 \uB124 \uC0AC\uB78C\uC758 \uC5BC\uAD74\uC5D0
      \uC11C\uB85C \uB2E4\uB978 \uC0C9\uC744 \uC785\uD78C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183616
    m_Localized: "\"\uBD09\uC778\uC740 \uC804\uB840\uAC00 \uC788\uB2E4. \uC6B0\uB9AC\uAC00
      1800\uB144 \uC804\uC5D0 \uD588\uB2E4. \uD558\uC9C0\uB9CC...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183617
    m_Localized: "\"\uACA9\uC790\uAC00 \uB2E4\uC2DC \uD48D\uD654\uB418\uBA74 \uB2E4\uC74C
      \uC138\uB300\uAC00 \uC6B0\uB9AC\uC640 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uC120\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183618
    m_Localized: "\"...\uADF8\uB798\uB3C4 \uC9C0\uAE08 \uC5EC\uAE30\uC11C \uCE5C\uAD6C\uB97C
      \uBB3B\uC744 \uC21C \uC5C6\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183619
    m_Localized: "\uB124 \uC0AC\uB78C\uC774 \uC11C\uB85C \uB2E4\uB978 \uBC29\uD5A5\uC744
      \uBCF4\uACE0 \uC788\uB2E4. \uD569\uC758\uB294 \uC5C6\uB2E4. \uC720\uB9AC\uAC00
      \uBC14\uB78C\uC5D0 \uC6B8\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183620
    m_Localized: "\"\uC815\uD654\uD574\uC57C \uD569\uB2C8\uB2E4. \uC655\uAD6D\uC774
      \uC9C4 \uBE5A\uC744 \uAC1A\uC73C\uB824\uBA74 \uC21C\uD658\uC744 \uC644\uC804\uD788
      \uB05D\uB0B4\uC57C \uD574\uC694. \uB300\uAC00\uAC00 \uC788\uB354\uB77C\uB3C4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183621
    m_Localized: "\"\uB300\uAC00? \uB204\uAD6C \uB300\uAC00? \uB124\uAC00 \uCE58\uB97C
      \uAC70\uC57C, \uC0AC\uC81C? \uC544\uB2C8\uBA74 \uC800 \uCE5C\uAD6C\uB97C \uACA9\uC790
      \uC548\uC5D0 \uAC00\uB458 \uAC70\uC57C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183622
    m_Localized: "\"\uADF8\uAC74...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183623
    m_Localized: "\"\uBD09\uC778\uC774\uBA74 \uC544\uBB34\uB3C4 \uC548 \uC8FD\uC5B4.
      \uC544\uBB34\uB3C4 \uC548 \uAC07\uD600. 200\uB144\uC774\uB4E0 500\uB144\uC774\uB4E0
      \uADF8\uB54C \uAC00\uC11C \uB610 \uC0DD\uAC01\uD558\uBA74 \uB418\uC796\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183624
    m_Localized: "\"200\uB144 \uD6C4\uC5D0 \uAC19\uC740 \uC804\uC7C1\uC774 \uBC18\uBCF5\uB3FC.
      \uB098\uB294 \uADF8 \uC804\uC7C1\uC744 \uAE30\uC5B5\uD558\uACE0 \uC788\uAC70\uB4E0.
      \uB611\uAC19\uC740 \uC804\uC7C1\uC744.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183625
    m_Localized: "\"\uADF8\uB798\uC11C \uAE30\uC5B5\uC744 \uBC14\uCE58\uACA0\uB2E4\uACE0?
      \uB124 \uAE30\uC6D0\uC744? \uADF8\uAC74 \uB124 \uC874\uC7AC \uC790\uCCB4\uC796\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183626
    m_Localized: '"..."'
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183627
    m_Localized: "Grave Hexer\uAC00 \uCC98\uC74C\uC73C\uB85C \uB9D0\uC744 \uC787\uC9C0
      \uBABB\uD55C\uB2E4. \uB18D\uB2F4\uB3C4, \uACFC\uAC70\uD615\uB3C4 \uB098\uC624\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183628
    m_Localized: "\uACA9\uC790 \uBE5B\uC774 \uB124 \uC0AC\uB78C\uC744 \uB3D9\uC2DC\uC5D0
      \uBE44\uCD98\uB2E4. \uCC98\uC74C\uC73C\uB85C \uAC19\uC740 \uBE5B \uC544\uB798
      \uC11C \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183629
    m_Localized: "\"\uACA9\uC790\uAC00 40% \uC774\uD558\uB2E4. \uC2EC\uC7A5\uC758
      \uCD9C\uB825\uC774 \uC5B5\uC81C \uC5C6\uC774 \uD37C\uC9C0\uACE0 \uC788\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183630
    m_Localized: "\"\uC21C\uD658\uC758 \uC885\uACB0\uC774\uB2E4. \uC218\uB9AC\uAC00
      \uC544\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183631
    m_Localized: "\uB124 \uC0AC\uB78C\uC774 \uC544\uB798\uB97C \uBCF8\uB2E4. \uC5B4\uB460\uC774
      \uC62C\uB77C\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183632
    m_Localized: "\"\uC2E0\uC559\uB3C4, \uC804\uC7C1\uB3C4... \uC804\uBD80 \uC774\uAC83\uC758
      \uBD80\uC0B0\uBB3C\uC774\uC5C8\uB2E4\uB294 \uAC81\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183633
    m_Localized: "\"\uBD80\uC0B0\uBB3C\uC774\uB77C\uB2C8. \uAF64 \uBE44\uC2FC \uBD80\uC0B0\uBB3C\uC774\uB124.
      \uC218\uCC9C \uB144\uCE58 \uC804\uC7C1\uC774\uC796\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183634
    m_Localized: "\"\uADF8\uB7FC \uBC11\uC5D0 \uBB50\uAC00 \uC788\uB4E0 \uBD80\uC218\uB7EC
      \uAC00\uBA74 \uB418\uC796\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183635
    m_Localized: "\"\uBD80\uC218\uBA74 \uAE30\uC5B5\uC774 \uC804\uBD80 \uC0AC\uB77C\uC9C4\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183636
    m_Localized: "\uCE68\uBB35. Grave Hexer\uC758 \uD45C\uC815\uC774 \uCC98\uC74C\uC73C\uB85C
      \uAD73\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183637
    m_Localized: "\"...\uADF8\uAC74 \uC548 \uB3FC.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183638
    m_Localized: "\"\uD30C\uAD34\uAC00 \uC544\uB2C8\uB77C \uB2E4\uB978 \uBC29\uBC95\uC744
      \uCC3E\uC544\uC57C \uD569\uB2C8\uB2E4. \uC544\uB798\uB85C \uB0B4\uB824\uAC11\uC2DC\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496713183639
    m_Localized: "\"\uBA85\uBD84\uC774 \uBC14\uB00C\uC5C8\uB124. \uC870\uC0AC\uC5D0\uC11C
      \uC218\uB9AC\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571840
    m_Localized: "\uAD00\uBB38 \uC55E\uC5D0 \uB124 \uAC1C\uC758 \uD648\uC774 \uC788\uB2E4.
      \uAC01 \uC138\uB825\uC758 \uBB38\uC591 \uBAA8\uC591. \uBB34\uC5B8\uAC00\uB97C
      \uB0B4\uB824\uB193\uC544\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571841
    m_Localized: "\"\uAE30\uB3C4\uC11C\uB97C \uB193\uACA0\uC2B5\uB2C8\uB2E4. Aldric\uC774
      \uC4F4 \uC6D0\uBB38\uC785\uB2C8\uB2E4. \uB354 \uC774\uC0C1 \uC774 \uAE30\uB3C4\uB97C
      \uC62C\uB9AC\uC9C0 \uC54A\uACA0\uB2E4\uB294 \uB73B\uC73C\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571842
    m_Localized: "\"...\uAC11\uC2DC\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571843
    m_Localized: "\uB124 \uC0AC\uB78C\uC774 \uAD00\uBB38\uC744 \uB118\uB294\uB2E4.
      \uBE5B\uC774 \uADF8\uB4E4\uC744 \uC0BC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571844
    m_Localized: "Dawn Priest\uAC00 \uAE30\uB3C4\uC11C\uB97C \uD648\uC5D0 \uB193\uB294\uB2E4.
      \uC190\uC774 \uB5A8\uB9AC\uC9C0\uB9CC, \uB193\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571845
    m_Localized: "\"\uD615\uC81C\uC758 \uD30C\uD3B8\uC744 \uB193\uC744\uAC8C. Wolfpine\uC5D0\uC11C
      \uBF51\uC740 \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571846
    m_Localized: "\uD30C\uD3B8\uC774 \uD648\uC5D0 \uB2FF\uC790 \uC9C4\uB3D9\uC774
      \uC6B8\uB9B0\uB2E4. Pack Raider\uAC00 \uC774\uB97C \uC545\uBB38\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571847
    m_Localized: "\"\uB098\uB294... \uC774\uAC83.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571848
    m_Localized: "Grave Hexer\uAC00 \uBE5B\uB098\uB294 \uAD6C\uC2AC\uC744 \uAEBC\uB0B8\uB2E4.
      \uAC00\uC7A5 \uC624\uB798\uB41C \uAE30\uC5B5\uC774 \uB2F4\uAE34 \uAC83. \uC544\uC9C1
      \uB193\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571849
    m_Localized: "\"\uC544\uC9C1\uC740 \uC548 \uB193\uC744 \uAC70\uC57C. \uB9C8\uC9C0\uB9C9\uC5D0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571850
    m_Localized: "\"\uB098\uB294 \uBAB8\uC744 \uB193\uB294\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571851
    m_Localized: "\uC544\uBB34\uB3C4 \uB300\uAFB8\uD558\uC9C0 \uC54A\uB294\uB2E4.
      \uAD00\uBB38\uC758 \uBE5B\uC774 \uB354 \uAC15\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571852
    m_Localized: "Dawn Priest\uAC00 \uBB34\uB98E\uC744 \uAFC7\uB294\uB2E4. \uC7AC\uAC00
      \uB0B4\uB824\uC549\uC544 \uAE30\uB3C4\uD558\uB294 \uC190\uB4F1\uC744 \uB36E\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571853
    m_Localized: "\"\uC601\uC6D0\uD55C \uC9C8\uC11C\uC758 \uC774\uB984\uC73C\uB85C,
      \uC774 \uBB38 \uB108\uBA38\uC758 \uC624\uC5FC\uC744 \uC815\uD654\uD558\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571854
    m_Localized: "\uADF8\uB140\uC758 \uC190\uC774 \uBA48\uCD98\uB2E4. \uBB38 \uC548\uCABD
      \uBCBD\uC5D0 \uCC0D\uD78C \uC790\uAD6D \u2014 \uBC16\uC5D0\uC11C \uB4E4\uC774\uCE5C
      \uD754\uC801\uC774 \uC544\uB2C8\uB2E4. \uC548\uC5D0\uC11C \uBC00\uC5B4\uB0B8
      \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571855
    m_Localized: "\"\uC774 \uBB38\uC740 \uC6B0\uB9AC\uAC00 \uC138\uC6E0\uC2B5\uB2C8\uB2E4.
      \uC6B0\uB9AC\uAC00 \uC9C0\uCF30\uC2B5\uB2C8\uB2E4. \uADF8\uB7F0\uB370... \uC548\uC5D0\uC11C\uBD80\uD130...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571856
    m_Localized: "\uAE30\uB3C4\uB97C \uB9C8\uCE58\uC9C0 \uBABB\uD55C\uB2E4. \uADF8\uB140\uAC00
      \uC77C\uC5B4\uC120\uB2E4. \uBB34\uB98E\uC5D0 \uC7AC\uAC00 \uBB3B\uC5B4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571857
    m_Localized: "\"\uB208\uC744 \uAC10\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uAC83\uC774
      \uC0AC\uC81C\uC5D0\uAC8C \uD5C8\uB77D\uB41C \uC720\uC77C\uD55C \uC6A9\uAE30\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571858
    m_Localized: "Dawn Priest\uAC00 \uC0AC\uC81C \uC778\uC7A5\uC744 \uC190\uC5D0
      \uC950\uACE0 \uC11C \uC788\uB2E4. \uC624\uB7AB\uB3D9\uC548 \uB9D0\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571859
    m_Localized: "\"\uB3C4\uAD74\uD488 \uC704\uC5D0 \uC138\uC6B4 \uC2E0\uC559\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571860
    m_Localized: "\"\uC131\uBB3C\uD568 \uC548\uC5D0 \uB4E0 \uAC83\uC774 \uC2E0\uC758
      \uCD95\uBCF5\uC774 \uC544\uB2C8\uB77C \uB0A8\uC758 \uBF08\uC600\uB2E4\uBA74...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571861
    m_Localized: "\uBB38\uC7A5\uC774 \uB04A\uAE34\uB2E4. \uADF8\uB140\uAC00 \uC785\uC744
      \uB2E4\uBB38\uB2E4. \uB2E4\uC2DC \uC5F0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571862
    m_Localized: "\"\uC6B0\uB9AC\uAC00 \uC62C\uB9B0 \uAE30\uB3C4\uB294... \uB204\uAD6C\uC5D0\uAC8C...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571863
    m_Localized: "\uB05D\uB9FA\uC9C0 \uBABB\uD55C\uB2E4. \uC778\uC7A5\uC774 \uC190\uC5D0\uC11C
      \uBBF8\uB044\uB7EC\uC9C8 \uBED4\uD55C\uB2E4. \uADF8\uB140\uAC00 \uC6C0\uCF1C\uC954\uB2E4
      \u2014 \uC544\uC9C1 \uB193\uC9C0\uB294 \uBABB\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571864
    m_Localized: "\"\uBB34\uB108\uC9C4 \uAC83\uB3C4 \uD759\uC774 \uB3FC.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571865
    m_Localized: "\"...\uD759\uC774\uC694?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571866
    m_Localized: "\"\uD759\uC5D0\uC11C \uBFCC\uB9AC\uAC00 \uB098\uB294 \uBC95\uC774\uC57C.
      \uB124\uAC00 \uC2EC\uC744 \uCC28\uB840\uB2E4, \uC0AC\uC81C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571867
    m_Localized: "Dawn Priest\uAC00 \uC778\uC7A5\uC744 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uB294\uB2E4.
      \uBC84\uB9AC\uC9C0\uB294 \uC54A\uB294\uB2E4. \uC544\uC9C1\uC740."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571868
    m_Localized: "Dawn Priest\uAC00 \uAE30\uB85D\uBD80\uB97C \uC190\uC5D0 \uB4E4\uACE0
      \uC11C \uC788\uB2E4. \uC789\uD06C\uAC00 \uC544\uC9C1 \uB9C8\uB974\uC9C0 \uC54A\uC740
      \uD398\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571869
    m_Localized: "\"\uC81C\uAC00 \uC12C\uAE34 \uC9C8\uC11C... \uADF8 \uBC11\uBC14\uB2E5\uC5D0
      \uC774\uB7F0 \uAC83\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571870
    m_Localized: "\"\uC774\uAC78 \uC544\uB294 \uC790\uB4E4\uC774 \uC788\uC5C8\uACE0,
      \uADF8\uB4E4\uC740 \uCE68\uBB35\uC744 \uD0DD\uD588\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571871
    m_Localized: "\uAE30\uB85D\uBD80\uC758 \uC11C\uBA85\uB780\uC5D0 \"A. Sternholt\"\uAC00
      \uB610 \uC788\uB2E4. \uAC19\uC740 \uD544\uCCB4. \uAC19\uC740 \uC0AC\uB78C."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571872
    m_Localized: "\"\uC758\uC2EC\uD558\uB294 \uAC83\uB3C4 \uC6A9\uAE30\uC57C, \uC0AC\uC81C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571873
    m_Localized: "\"...\uB2F9\uC2E0\uC5D0\uAC8C \uADF8\uB7F0 \uB9D0\uC744 \uB4E4\uC744
      \uC904\uC740 \uBAB0\uB790\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571874
    m_Localized: "\"\uBC14\uB78C\uC744 \uAC70\uC2A4\uB974\uB294 \uC9D0\uC2B9\uC740
      \uBB34\uB9AC\uC5D0\uC11C \uCAD3\uACA8\uB098. \uADFC\uB370 \uAC00\uB054\uC740
      \uADF8\uB188\uC774 \uAE38\uC744 \uCC3E\uAC70\uB4E0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571875
    m_Localized: "Dawn Priest\uAC00 \uAE30\uB85D\uBD80\uB97C \uBC30\uB0AD\uC5D0 \uB123\uB294\uB2E4.
      \uC190\uC774 \uB5A8\uB9AC\uC9C0\uB9CC, \uB193\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571876
    m_Localized: "Dawn Priest\uAC00 \uBA48\uCD98\uB2E4. \uC8FC\uBA38\uB2C8\uC5D0\uC11C
      \uC0AC\uC81C \uC778\uC7A5\uC744 \uAEBC\uB0B8\uB2E4. \uC624\uB798 \uC950\uACE0
      \uC788\uC5C8\uB2E4. \uC190\uC790\uAD6D\uC774 \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571877
    m_Localized: "\"\uC774 \uC778\uC7A5\uC740 Aldric\uC774 \uC124\uACC4\uD55C \uAD50\uB9AC\uC758
      \uC99D\uBA85\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571878
    m_Localized: "\"\uB354 \uC774\uC0C1 \uC774\uAC83\uC73C\uB85C \uC2A4\uC2A4\uB85C\uB97C
      \uC815\uC758\uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571879
    m_Localized: "\uC778\uC7A5\uC744 \uBC14\uB2E5\uC5D0 \uB193\uB294\uB2E4. \uAE08\uC18D\uC774
      \uB3CC\uC5D0 \uB2FF\uB294 \uC18C\uB9AC\uAC00 \uC6B8\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571880
    m_Localized: "\"\uB2E4\uB9CC... \uAE30\uB3C4\uB294 \uACC4\uC18D\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      Aldric\uC758 \uAE30\uB3C4\uAC00 \uC544\uB2C8\uB77C, \uC81C \uAE30\uB3C4\uB97C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571881
    m_Localized: "\uADF8\uB140\uC758 \uB208\uC774 \uC816\uC5B4 \uC788\uB2E4. \uD558\uC9C0\uB9CC
      \uC6B8\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571882
    m_Localized: "\"\uC601\uC6D0\uD55C \uC9C8\uC11C\uC758 \uC774\uB984\uC774 \uC544\uB2C8\uB77C...
      \uADF8\uB0E5. \uC81C \uC774\uB984\uC73C\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571883
    m_Localized: "\uC778\uC7A5\uC774 \uBC14\uB2E5\uC5D0\uC11C \uD76C\uBBF8\uD558\uAC8C
      \uBE5B\uB09C\uB2E4. \uADF8\uB9AC\uACE0 \uAEBC\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571884
    m_Localized: "\uB098\uBA38\uC9C0 \uC14B\uC774 \uC55E\uC11C \uAC77\uB294\uB2E4.
      Dawn Priest\uAC00 \uB4A4\uCC98\uC838 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571885
    m_Localized: "\"\uC81C\uAC00 \uC62C\uB9B0 \uAE30\uB3C4\uB294... \uAE30\uACC4\uC758
      \uBD80\uC0B0\uBB3C \uC704\uC5D0 \uC138\uC6B4 \uAC83\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571886
    m_Localized: "\"Aldric Sternholt\uAC00 \uC124\uACC4\uD55C \uAD50\uB9AC\uB97C
      \uC81C\uAC00... \uC544\uBB34 \uC758\uC2EC \uC5C6\uC774...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571887
    m_Localized: "\uBB38\uC7A5\uC774 \uB610 \uB04A\uAE34\uB2E4. \uC138 \uBC88\uC9F8\uB2E4.
      \uADF8\uB140\uC758 \uC5B4\uBC95\uC774 \uBCC0\uD558\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571888
    m_Localized: "\"\uC758\uC2EC \uC5C6\uC774 \uBBFF\uC740 \uAC74 \uB124 \uC798\uBABB\uC774
      \uC544\uB2C8\uC57C. \uADF8\uB807\uAC8C \uC124\uACC4\uB41C \uAC70\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571889
    m_Localized: "\"\uADF8\uAC8C \uB354 \uB098\uC069\uB2C8\uB2E4. \uC124\uACC4\uB41C
      \uAC78 \uBAA8\uB974\uACE0 \uC0B4\uC558\uB2E4\uB294 \uAC8C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571890
    m_Localized: "Dawn Priest\uAC00 \uAC78\uC74C\uC744 \uC62E\uAE34\uB2E4. \uB2E4\uC2DC
      \uAC77\uB294\uB2E4. \uB290\uB9AC\uC9C0\uB9CC \uBA48\uCD94\uC9C0\uB294 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571891
    m_Localized: "\"\uC544\uC9C1 \uAC77\uB124. \uADF8\uB7EC\uBA74 \uB410\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571892
    m_Localized: "Pack Raider\uC758 \uC190\uC774 \uBB36\uC5EC \uC788\uB2E4. \uD558\uC9C0\uB9CC
      \uCF54\uB294 \uC26C\uC9C0 \uC54A\uB294\uB2E4 \u2014 \uC5F0\uC2E0 \uBC14\uB78C\uC744
      \uC77D\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571893
    m_Localized: "\"\uB4A4\uC5D0 \uC2A4\uBB3C, \uC55E\uC5D0 \uB2E4\uC12F. \uBC14\uB78C
      \uB0C4\uC0C8\uB85C \uB2E4 \uC548\uB2E4. \uB3C4\uB9DD\uCE60 \uC0DD\uAC01\uC740
      \uC5C6\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571894
    m_Localized: "\"\uB2F9\uC2E0\uC758 \uBD88\uC2E0\uC744 \uD0D3\uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571895
    m_Localized: "\"\uBD88\uC2E0? \uB108\uD76C\uAC00 \uC6B0\uB9AC \uC0AC\uB0E5\uD130\uC5D0
      \uCCA0\uC744 \uBC15\uC558\uC796\uC544. \uADF8\uAC78 \uBD88\uC2E0\uC774\uB77C\uACE0
      \uBD88\uB7EC?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571896
    m_Localized: "Dawn Priest\uC758 \uD45C\uC815\uC774 \uAD73\uB294\uB2E4. \uB300\uAFB8\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571897
    m_Localized: "\"\uC0AC\uC81C\uAC00 \uC785 \uC5F4\uBA74 \uBC14\uB78C\uC774 \uBA48\uCDB0.
      \uC57D\uC18D\uC740 \uD759\uC5D0 \uC2EC\uC5B4\uC57C \uBFCC\uB9AC\uAC00 \uB098\uC9C0.
      \uB9D0\uB85C\uB294 \uC548 \uB3FC.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571898
    m_Localized: "\"\uAC19\uC740 \uAE38\uC744 \uAC77\uB294 \uB3D9\uC548\uB9CC\uC774\uB77C\uB3C4
      \uB4F1\uC744 \uB9E1\uAE30\uC2ED\uC2DC\uC624.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571899
    m_Localized: "\"\uB4F1\uC744 \uB9E1\uAE30\uB77C\uACE0? \uB4F1\uC5D0 \uCE7C\uC744
      \uAF42\uB294 \uAC74 \uB108\uD76C \uC804\uD1B5\uC774\uC796\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571900
    m_Localized: "\uCE68\uBB35\uC774 \uB0B4\uB824\uC549\uB294\uB2E4. \uC194\uC78E
      \uC0AC\uC774\uB85C \uBC14\uB78C\uC774 \uBD84\uB2E4. Pack Raider\uC758 \uCF54\uAC00
      \uC6C0\uCC14\uD55C\uB2E4 \u2014 \uBB54\uAC00\uB97C \uAC10\uC9C0\uD55C \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571901
    m_Localized: "\"...\uC88B\uC544. \uADFC\uB370 \uC55E\uC5D0\uC11C \uAC78\uC5B4.
      \uB4F1\uC740 \uB124\uAC00 \uBCF4\uC5EC.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571902
    m_Localized: "\uBC24. Pack Raider\uAC00 \uC528\uC871 \uD1A0\uD15C\uC744 \uC190\uC5D0
      \uC950\uACE0 \uC549\uC544 \uC788\uB2E4. \uC720\uB9AC \uB098\uBB34\uC758 \uBE5B\uC774
      \uADF8\uC758 \uC5BC\uAD74\uC744 \uBE44\uCD98\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571903
    m_Localized: "\"...\uC7A0\uC774 \uC548 \uC635\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571904
    m_Localized: "\"\uD1A0\uD15C\uC774 \uC6B8\uB9AC\uC9C0 \uC54A\uC544. \uBC18\uCABD\uC774
      \uAC08\uB77C\uC9C0\uBA74 \uC9C4\uB3D9\uC774 \uBC18\uC73C\uB85C \uC904\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571905
    m_Localized: "Dawn Priest\uAC00 \uC606\uC5D0 \uC549\uB294\uB2E4. \uB9D0\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571906
    m_Localized: "\"\uC62C\uBC14\uB978 \uC120\uD0DD\uC744 \uD588\uB2E4\uACE0 \uC0DD\uAC01\uD588\uC5B4.
      \uD615\uC81C\uB97C \uBBF8\uCE58\uAC8C \uB9CC\uB4E0 \uAC83\uC774 \uBB54\uC9C0
      \uC54C\uC544\uB0B4\uBA74, \uC528\uC871\uC774 \uC774\uD574\uD560 \uC904 \uC54C\uC558\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571907
    m_Localized: "\"\uC800\uB3C4 \uADF8\uB7AC\uC2B5\uB2C8\uB2E4. \uC9C4\uC2E4\uC744
      \uBC1D\uD788\uBA74 \uAD50\uD68C\uAC00 \uACE0\uCE60 \uC904 \uC54C\uC558\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571908
    m_Localized: "\"\uC6B0\uB9AC \uB458 \uB2E4 \uC21C\uC9C4\uD588\uB124.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571909
    m_Localized: "\uC720\uB9AC\uAC00 \uB2EC\uBE5B\uC5D0 \uC6B8\uB9B0\uB2E4. \uB9D1\uC740
      \uC18C\uB9AC. \uC2AC\uD508 \uC18C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571910
    m_Localized: "\"\uC21C\uC9C4\uD55C \uAC83\uACFC \uC633\uC740 \uAC83\uC740 \uB2E4\uB985\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571911
    m_Localized: "\"...\uADF8\uB798. \uADF8\uB798\uC57C\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571912
    m_Localized: "Pack Raider\uAC00 \uBCBD\uC744 \uBC1C\uD1B1\uC73C\uB85C \uAE01\uB294\uB2E4.
      \uB300\uB9AC\uC11D\uC5D0 \uB2E4\uC12F \uC904\uC758 \uC790\uAD6D\uC774 \uC0DD\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571913
    m_Localized: "\"80\uB144\uC774\uC57C. 80\uB144 \uB3D9\uC548 \uC6B0\uB9AC \uB545
      \uBC11\uC744 \uD30C\uAC14\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571914
    m_Localized: "\"\uC0C8\uB07C\uB4E4\uC774 \uC11C\uB85C \uBB3C\uC5B4\uB72F\uB294
      \uB3D9\uC548, \uB108\uD76C\uB294 \uADF8\uAC78\uB85C \uBCBD\uB3CC\uC744 \uC313\uACE0
      \uC788\uC5C8\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571915
    m_Localized: "\"\uBD80\uC815\uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571916
    m_Localized: "\"\uBD80\uC815 \uC548 \uD55C\uB2E4\uACE0? \uADF8\uAC8C \uBB50 \uB300\uB2E8\uD55C
      \uAC74 \uC904 \uC54C\uC544?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571917
    m_Localized: "Pack Raider\uC758 \uC190\uC774 \uB5A8\uB9B0\uB2E4. \uBD84\uB178\uC640
      \uC2AC\uD514\uC774 \uC11E\uC778 \uB5A8\uB9BC\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571918
    m_Localized: "\"\uC655\uAD6D\uC774 \uC800\uC9C0\uB978 \uC77C\uC758 \uBB34\uAC8C\uB97C
      \uC81C\uAC00 \uB300\uC2E0 \uC9C8 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC
      \uC678\uBA74\uD558\uC9C0\uB3C4 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571919
    m_Localized: "\"\uB9D0\uC740 \uC798 \uD558\uC2DC\uB124. \uD56D\uC0C1.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571920
    m_Localized: "Pack Raider\uAC00 \uD1A0\uD15C\uC744 \uD5C8\uB9AC\uC5D0\uC11C \uD480\uC5B4
      \uC55E\uC5D0 \uB193\uB294\uB2E4. \uBC18\uCABD\uC9DC\uB9AC \uC528\uC871\uC758
      \uD45C\uC2DD."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571921
    m_Localized: "\"\uC528\uC871 \uB9F9\uC138\uAC00 \uC544\uB2C8\uC57C. \uBC18\uCABD\uBC16\uC5D0
      \uC548 \uB0A8\uC558\uC73C\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571922
    m_Localized: "\uADF8\uAC00 \uC774\uBE68\uC744 \uB4DC\uB7EC\uB0B8\uB2E4. \uC57C\uC218\uC871\uC758
      \uC11C\uC57D \uC790\uC138."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571923
    m_Localized: "\"\uB0B4 \uC774\uBE68\uB85C \uB9F9\uC138\uD55C\uB2E4. \uC5EC\uAE30\uC11C
      \uB05D\uB0B4\uACE0, \uB3CC\uC544\uAC00\uC11C, \uB0A8\uC740 \uC528\uC871\uC5D0\uAC8C
      \uC9C4\uC2E4\uC744 \uC804\uD55C\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571924
    m_Localized: '"Pack Raider..."'
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571925
    m_Localized: "\"\uB0B4 \uC774\uB984\uC740 \uC528\uC871\uC5D0\uC11C \uBC1B\uC740
      \uAC70\uC57C. \uBC18\uCABD\uC774 \uB5A8\uC5B4\uC838 \uB098\uAC14\uC9C0\uB9CC
      \uC774\uB984\uC740 \uB0B4\uAC00 \uC9C0\uD0A8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571926
    m_Localized: "\uC774\uBE68\uC774 \uBE5B\uC744 \uBC1B\uC544 \uBC88\uCA4D\uC778\uB2E4.
      \uC704\uD611\uC774 \uC544\uB2C8\uB77C \uC57D\uC18D\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571927
    m_Localized: "\"\uAF64 \uBA4B\uC9C0\uB124.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571928
    m_Localized: "\uC18C\uB098\uBB34 \uD55C \uADF8\uB8E8\uAC00 \uB2E4\uB978 \uB098\uBB34\uBCF4\uB2E4
      \uAE4A\uC774 \uC0C8\uACA8\uC838 \uC788\uB2E4. \uAC08\uD034 \uC790\uAD6D \uC704\uB85C
      \uC218\uC9C0\uAC00 \uAD73\uC5B4 \uD638\uBC15\uC0C9 \uC904\uC744 \uC774\uB8E8\uACE0
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571929
    m_Localized: "\"\uC774\uAC74 \uBB34\uAE30\uAC00 \uC544\uB2C8\uC57C. \uC0AC\uB0E5\uD130\uC758
      \uACBD\uACC4\uC774\uACE0, \uC0C8\uB07C\uB4E4\uC5D0\uAC8C \uB0A8\uAE30\uB294
      \uC57D\uC18D\uC774\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571930
    m_Localized: "\"\uC5B4\uB5A4 \uC57D\uC18D\uC785\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571931
    m_Localized: "\"\uC5EC\uAE30\uAE4C\uC9C0\uB294 \uC548\uC804\uD558\uB2E4. \uC5EC\uAE30\uC11C\uBD80\uD130\uB294
      \uB124 \uBC1C\uB85C \uC11C\uB77C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571932
    m_Localized: "Pack Raider\uAC00 \uB098\uBB34\uC5D0 \uC190\uC744 \uB304\uB2E4.
      \uC190\uBC14\uB2E5 \uC544\uB798\uC5D0\uC11C \uC9C4\uB3D9\uC774 \uC6B8\uB9B0\uB2E4.
      \uADF8\uC758 \uD45C\uC815\uC774 \uBCC0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571933
    m_Localized: "\"\uD1A0\uD15C\uC774 \uBBF8\uCCD0 \uB0A0\uB6F0\uACE0 \uC788\uC5B4.
      \uC548\uC5D0\uC11C \uBB54\uAC00\uAC00 \uC6B8\uB824.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571934
    m_Localized: "\"\uC774 \uC9C4\uB3D9... \uC131\uBB3C\uD568 \uC548\uC758 \uC720\uBB3C\uACFC
      \uAC19\uC740 \uD30C\uC7A5\uC785\uB2C8\uB2E4. \uAC19\uC740 \uBB3C\uC9C8\uC774\uB780
      \uB9D0\uC785\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571935
    m_Localized: "\"\uB108\uD76C\uAC00 \uD6D4\uCCD0\uAC04 \uAC83\uC758 \uBB34\uAC8C\uB97C
      \uC774\uB188\uC774 \uAE30\uC5B5\uD558\uACE0 \uC788\uB294 \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571936
    m_Localized: "\uD1A0\uD15C\uC758 \uC9C4\uB3D9\uC774 \uBC1C\uBC11\uC73C\uB85C
      \uC804\uD574\uC9C4\uB2E4. \uC544\uB798\uB85C. \uB354 \uC544\uB798\uB85C. \uBB34\uC5B8\uAC00\uC640
      \uACF5\uBA85\uD558\uB4EF."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571937
    m_Localized: "\"...\uAE30\uB85D\uC744 \uC218\uC815\uD574\uC57C\uACA0\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571938
    m_Localized: "\uACA9\uC790\uBB38\uC774 \uD478\uB978 \uBE5B\uC73C\uB85C \uD0C0\uC624\uB978\uB2E4.
      \uC11D\uD654 \uB098\uBB34 \uC0AC\uC774\uC5D0\uC11C \uD55C \uC874\uC7AC\uAC00
      \uCC9C\uCC9C\uD788 \uC77C\uC5B4\uC120\uB2E4. \uAD00\uC808\uC774 \uC6C0\uC9C1\uC77C
      \uB54C\uB9C8\uB2E4 \uB3CC \uBD80\uC2A4\uB7EC\uAE30\uAC00 \uB5A8\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571939
    m_Localized: "\"...\uC2DC\uB044\uB7FD\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571940
    m_Localized: "\"...\uC5EC\uAE30\uAC00 \uC5B4\uB514\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571941
    m_Localized: "\"\uAE34 \uC598\uAE30\uC57C. \uC549\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571942
    m_Localized: "Echo Savant\uAC00 \uC549\uC9C0 \uC54A\uB294\uB2E4. \uC11C \uC788\uB2E4.
      \uB2E4\uB9AC\uAC00 \uB5A8\uB9AC\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571943
    m_Localized: "\"\uBF08\uAC00 \uC6B8\uB9B0\uB2E4. \uACA9\uC790\uAC00... \uB2F3\uC558\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571944
    m_Localized: "\uADF8\uC758 \uCCAB \uB9C8\uB514. 1800\uB144 \uB9CC\uC5D0. \uB208\uC774
      \uCD08\uC810\uC744 \uBABB \uC7A1\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571945
    m_Localized: "\"\uBD09\uC778\uC758 \uC218\uD638\uC790\uAC00... \uC0B4\uC544 \uC788\uC5C8\uC2B5\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571946
    m_Localized: "\"\uC0C8 \uB0C4\uC0C8\uC57C. \uBC14\uB78C\uC5D0\uB3C4 \uC5C6\uB358
      \uC885\uB958.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571947
    m_Localized: "\"\uC5B4\uBA38\uB098. \uACA9\uC790 \uC548\uC5D0\uC11C \uC9C4\uC9DC\uB85C
      \uB204\uAC00 \uB098\uC654\uB124.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571948
    m_Localized: "\"\uBA38\uB9AC\uAC00... \uC6B8\uB9B0\uB2E4. \uC774 \uC18C\uB9AC\uAC00
      \uBB50\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571949
    m_Localized: "Echo Savant\uAC00 \uC190\uC744 \uB4E4\uC5B4 \uC62C\uB9B0\uB2E4.
      \uCC9C\uCC9C\uD788. \uC790\uAE30 \uC190\uC744 \uBCF4\uB294 \uAC83 \u2014 1800\uB144
      \uC804\uC5D0 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBCF8 \uC190\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571950
    m_Localized: "\"\uC6B0\uB9AC\uAC00 \uCE68\uB7B5\uC790\uB77C \uBD80\uB978 \uC874\uC7AC\uAC00...
      \uC774 \uC138\uACC4\uB97C \uC9C0\uD0A4\uACE0 \uC788\uC5C8\uB2E4\uB2C8.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571951
    m_Localized: "\"1800\uB144 \uB3D9\uC548 \uC790\uACE0 \uC77C\uC5B4\uB0AC\uC73C\uB2C8
      \uCEE8\uB514\uC158\uC774 \uC880 \uADF8\uB807\uACA0\uB124.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571952
    m_Localized: "\uC11D\uAD00\uC774 \uCE35\uCE35\uC774 \uC313\uC5EC \uC788\uB2E4.
      \uC778\uAD11 \uC774\uB07C\uAC00 \uD1B5\uB85C\uB97C \uD76C\uBBF8\uD558\uAC8C
      \uBC1D\uD78C\uB2E4. \uACF5\uAE30\uAC00 \uCC28\uAC11\uACE0 \uCD95\uCD95\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571953
    m_Localized: "\"\uC8FD\uC74C\uC758 \uB545\uC774\uB77C \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571954
    m_Localized: "\"\uC774 \uBE5B\uC740... \uC8FD\uC74C\uBCF4\uB2E4\uB294 \uAE30\uB2E4\uB9BC\uC5D0
      \uAC00\uAE5D\uAD70\uC694.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571955
    m_Localized: "\"\uB9DE\uC544. \uAE30\uB2E4\uB9BC\uC774\uC57C. \uAF64 \uC624\uB798\uB41C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571956
    m_Localized: "\uC5B4\uB460 \uC18D\uC5D0\uC11C \uBC1C\uC18C\uB9AC. \uB290\uB9BF\uD558\uACE0
      \uC870\uC2EC\uC131 \uC5C6\uB294 \uAC78\uC74C. \uB204\uAD70\uAC00\uAC00 \uAC78\uC5B4
      \uB098\uC628\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571957
    m_Localized: "\"\uC5B4, \uC190\uB2D8\uC774\uB124. \uC624\uB798\uAC04\uB9CC\uC774\uC57C.
      \uD55C 300\uB144? 400\uB144? ...\uBB50, \uC0C1\uAD00\uC5C6\uC9C0\uB9CC.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571958
    m_Localized: "\"\uC8FD\uC740 \uAC83\uC774 \uAC78\uC5B4. \uCF54\uC5D0 \uC544\uBB34
      \uB0C4\uC0C8\uB3C4 \uC548 \uC640.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571959
    m_Localized: "\"\uB0C4\uC0C8\uAC00 \uC548 \uB098\uBA74 \uC704\uD5D8\uD558\uB2E4\uACE0
      \uD588\uC9C0? \uC88B\uC740 \uCF54\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571960
    m_Localized: "\"\uB2F9\uC2E0\uC740 \uB204\uAD6C\uC2ED\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571961
    m_Localized: "\"\uAE30\uC5B5 \uAD00\uB9AC\uC790. \uC5EC\uAE30 \uC788\uB294 \uC18D\uC0AD\uC784
      \uB4E4\uB824? \uACF5\uACA9\uC774 \uC544\uB2C8\uC57C. \uC7A0\uB4E0 \uAE30\uC5B5\uC774
      \uC190\uB2D8\uC744 \uB9DE\uC774\uD558\uB294 \uAC70\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571962
    m_Localized: "\uBCBD \uD2C8\uC5D0\uC11C \uD76C\uBBF8\uD55C \uBE5B\uC774 \uB9E5\uB3D9\uD55C\uB2E4.
      \uC18D\uC0AD\uC784\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571963
    m_Localized: "\"\uC880 \uC2DC\uB044\uB7FD\uAE34 \uD55C\uB370. \uC218\uBC31 \uB144
      \uB9CC\uC758 \uC190\uB2D8\uC774\uB77C \uD765\uBD84\uD55C \uBAA8\uC591\uC774\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571964
    m_Localized: "Aldric\uC758 \uD615\uC0C1\uC774 \uD769\uC5B4\uC9C4\uB2E4. \uBD84\uB178\uB3C4
      \uC6D0\uD55C\uB3C4 \uC544\uB2CC, \uADF8\uC800 \uC0AC\uB77C\uC9C0\uB294 \uD55C
      \uB0A8\uC790\uC758 \uD45C\uC815."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571965
    m_Localized: "\uACA9\uC790\uAC00 \uBC18\uC751\uD55C\uB2E4. \uC815\uD654\uC758
      \uC21C\uC11C\uAC00 \uC2DC\uC791\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571966
    m_Localized: "\uACA9\uC790\uAC00 \uADF8\uB97C \uAC10\uC2FC\uB2E4. \uD504\uB9AC\uC998
      \uBCF4\uB77C\uBE5B\uC774 \uB9E5\uB3D9\uD558\uAE30 \uC2DC\uC791\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571967
    m_Localized: '"Echo Savant..."'
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571968
    m_Localized: "\"\uC798 \uAC78\uC5B4\uB77C. \uC704\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571969
    m_Localized: "\uBE5B\uC774 \uAC15\uD574\uC9C4\uB2E4. Heartforge\uAC00 \uBA48\uCD98\uB2E4.
      \uC2EC\uC7A5\uC774 \uB6F0\uC9C0 \uC54A\uB294\uB2E4. \uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571970
    m_Localized: "\"\uC2DC\uC791\uD569\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571971
    m_Localized: "Dawn Priest\uC758 \uC190\uC5D0\uC11C \uBE5B\uC774 \uB09C\uB2E4.
      \uC0AC\uC81C\uC758 \uBE5B\uC774 \uC544\uB2C8\uB2E4. \uADF8\uB140 \uC790\uC2E0\uC758
      \uBE5B\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571972
    m_Localized: "Grave Hexer\uAC00 \uBE48 \uC190\uC744 \uB4E4\uC5B4\uC62C\uB9B0\uB2E4.
      \uC544\uAE4C \uB193\uC740 \uAD6C\uC2AC\uC774 \uC788\uB358 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571973
    m_Localized: "\"...\uB05D\uB0AC\uC5B4. \uB1A8\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571974
    m_Localized: "Pack Raider\uAC00 \uC774\uBE68\uC744 \uB4DC\uB7EC\uB0B8\uB2E4.
      \uC11C\uC57D \uC790\uC138. \uC6B8\uBD80\uC9D6\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571975
    m_Localized: "\"\uB3CC\uC544\uAC00\uBA74 \uB0A8\uC740 \uC528\uC871\uC5D0\uAC8C
      \uC804\uD55C\uB2E4. \uC804\uBD80.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571976
    m_Localized: "Echo Savant\uAC00 \uACA9\uC790\uC758 \uC911\uC2EC\uC73C\uB85C \uAC78\uC5B4\uAC04\uB2E4.
      \uB290\uB9AC\uAC8C. \uD55C \uAC78\uC74C\uC529."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571977
    m_Localized: "\"\uAD1C\uCC2E\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571978
    m_Localized: "Echo Savant\uAC00 \uC77C\uC5B4\uC120\uB2E4. \uC774\uBC88\uC5D0\uB294
      \uB2E4\uB9AC\uAC00 \uB5A8\uB9AC\uC9C0 \uC54A\uB294\uB2E4. \uB208\uC5D0 \uCD08\uC810\uC774
      \uC7A1\uD78C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571979
    m_Localized: "\"\uC2EC\uC7A5\uC774 \uAE30\uC5B5\uC744 \uBA39\uACE0 \uC788\uB2E4.
      \uBC49\uC5B4\uB0B4\uB294 \uAC83\uC740 \uBD84\uB178.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571980
    m_Localized: "\"\uB124 \uACF5\uBA85\uACFC \uB0B4 \uAE30\uC5B5\uC774 \uAC19\uC740
      \uD30C\uC7A5\uC774\uAD70. 1800\uB144\uC744 \uC0AC\uC774\uC5D0 \uB450\uACE0.
      \uC7AC\uBC0C\uB124.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571981
    m_Localized: "\"\uACA9\uC790\uAC00 \uB2F3\uC558\uB2E4. \uBD84\uB178\uAC00 \uC0C8\uC5B4\uB098\uC628\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571982
    m_Localized: "\"\uC6B0\uB9AC \uBAA8\uB450\uAC00... \uC870\uC885\uB2F9\uD55C \uAC81\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571983
    m_Localized: "\"\uC870\uC885\uC774 \uC544\uB2C8\uB2E4. \uB204\uC218\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571984
    m_Localized: "\"\uB204\uC218\uB4E0 \uC870\uC885\uC774\uB4E0. \uD615\uC81C\uAC00
      \uBBF8\uCCD0 \uC8FD\uC740 \uAC74 \uB611\uAC19\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571985
    m_Localized: "Echo Savant\uAC00 Pack Raider\uB97C \uBCF8\uB2E4. \uC624\uB798.
      \uB300\uB2F5\uD558\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571986
    m_Localized: "\"...\uBBF8\uC548\uD558\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571987
    m_Localized: "\"\uB124\uAC00 \uD55C \uC9D3\uC774 \uC544\uB2C8\uC796\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571988
    m_Localized: "Echo Savant\uAC00 \uBC14\uB2E5\uC5D0 \uC190\uC744 \uB304\uB2E4.
      \uB208\uC744 \uAC10\uB294\uB2E4. \uD504\uB9AC\uC998 \uBCF4\uB77C\uBE5B\uC774
      \uC190\uB05D\uC5D0\uC11C \uD37C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571989
    m_Localized: "\"\uACA9\uC790\uAC00... \uBE44\uBA85\uC744 \uC9C0\uB974\uACE0 \uC788\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571990
    m_Localized: "\"\uC704\uD5D8\uD55C \uAC81\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571991
    m_Localized: "\"\uC704\uD5D8\uD558\uC9C0 \uC54A\uC740 \uAC83\uC774 \uC5C6\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571992
    m_Localized: "\"1800\uB144 \uC790\uACE0 \uC77C\uC5B4\uB098\uC11C \uAE0D\uC815\uC801\uC774\uBA74
      \uC624\uD788\uB824 \uBB34\uC11C\uC6B8 \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571993
    m_Localized: "Echo Savant\uC758 \uBAB8\uC774 \uBBF8\uC138\uD558\uAC8C \uB5A8\uB9B0\uB2E4.
      \uACA9\uC790\uC640 \uB3D9\uAE30\uD654\uB418\uB294 \uC911\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571994
    m_Localized: "\"\uAC08 \uC218 \uC788\uB2E4. \uC544\uB798\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571995
    m_Localized: "\"\uADF8\uB7FC \uAC00\uC790. \uC5EC\uAE30 \uB354 \uC788\uC73C\uBA74
      \uC720\uB9AC\uAC00 \uB420 \uAC83 \uAC19\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571996
    m_Localized: "\uACA9\uC790\uC758 \uC911\uC2EC\uC774 \uBCF4\uC778\uB2E4. \uBE48\uC790\uB9AC.
      \uC218\uD638\uC790\uAC00 \uB4E4\uC5B4\uAC08 \uC790\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571997
    m_Localized: "\"\uC5EC\uAE30\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571998
    m_Localized: "\"\uC815\uB9D0\uB85C... \uB2E4\uB978 \uBC29\uBC95\uC740 \uC5C6\uC2B5\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721571999
    m_Localized: "\"\uC5C6\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572000
    m_Localized: "\"\uB124\uAC00 \uC548 \uB4E4\uC5B4\uAC00\uBA74 \uC548 \uB418\uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572001
    m_Localized: "\"\uACA9\uC790\uB97C \uC77D\uC744 \uC218 \uC788\uB294 \uAC83\uC740
      \uB098\uBFD0\uC774\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572002
    m_Localized: "\uC0AC\uC2E4\uC774\uB2E4. \uC544\uBB34\uB3C4 \uBC18\uBC15\uD558\uC9C0
      \uBABB\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572003
    m_Localized: "\"\uC758\uBB34\uAC00 \uC544\uB2C8\uB2E4. \uC120\uD0DD\uC774\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572004
    m_Localized: "\uC6B8\uD0C0\uB9AC\uAC00 \uC788\uB2E4. \uC720\uB9AC\uAC00 \uC544\uB2C8\uB77C
      \uBF08\uB85C \uB9CC\uB4E0 \uC6B8\uD0C0\uB9AC. \uC548\uC5D0\uC11C \uC6C0\uC9C1\uC774\uB294
      \uAC83\uB4E4\uC774 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572005
    m_Localized: "\"\uC774\uAC74... \uC57C\uC218\uAC00 \uC544\uB2C8\uC57C. \uC57C\uC218\uC600\uB358
      \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572006
    m_Localized: "\uBCC0\uC774\uB41C \uC0DD\uBB3C\uB4E4\uC774 \uC6B8\uD0C0\uB9AC
      \uC548\uC744 \uBC30\uD68C\uD55C\uB2E4. \uB208\uC774 \uC5C6\uB2E4. \uADC0\uB9CC
      \uB0A8\uC544 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572007
    m_Localized: "\"\uACA9\uC790 \uC624\uC5FC\uC774 \uC774 \uC815\uB3C4\uAE4C\uC9C0...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572008
    m_Localized: "\"\uB3D9\uBB3C\uC6D0\uC774\uB77C\uAE30\uBCF4\uB2E4 \uAC10\uC625\uC774\uC57C.
      \uC2A4\uC2A4\uB85C \uB4E4\uC5B4\uC628 \uAC10\uC625.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572009
    m_Localized: "\"\uC6B8\uC74C\uC18C\uB9AC\uAC00 \uC548 \uB098. \uC6B8 \uC904\uB3C4
      \uC78A\uC740 \uAC70\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572010
    m_Localized: "\"\uACA9\uC790\uAC00 \uC0DD\uBA85\uC744 \uBE44\uD2C0\uC5C8\uB2E4.
      \uC624\uB798 \uBC29\uCE58\uB41C \uACF3\uC774\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572011
    m_Localized: "Pack Raider\uAC00 \uC6B8\uD0C0\uB9AC\uC5D0 \uC190\uC744 \uB304\uB2E4.
      \uC548\uC758 \uC0DD\uBB3C\uC774 \uB2E4\uAC00\uC628\uB2E4 \u2014 \uC801\uB300\uAC00
      \uC544\uB2C8\uB77C, \uAE30\uC5B5\uD558\uB294 \uAC83\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572012
    m_Localized: "\"...\uD615\uC81C\uC758 \uC0AC\uB0E5\uAC1C\uB791 \uAC19\uC740 \uB0C4\uC0C8\uAC00
      \uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572013
    m_Localized: "\"\uB05D\uB0B4\uC57C \uD569\uB2C8\uB2E4. \uC774 \uACE0\uD1B5\uC744.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572014
    m_Localized: "\uB300\uB9AC\uC11D \uAE30\uB465\uC774 \uBE44\uC2A4\uB4EC\uD788
      \uC11C \uC788\uB2E4. \uBB3C\uC774 \uBCF5\uB3C4\uB97C \uBC1C\uBAA9\uAE4C\uC9C0
      \uCC44\uC6B0\uACE0 \uC788\uACE0, \uBCBD\uC758 \uBB38\uC591\uC774 \uBC18\uCBE4
      \uBB3C\uC5D0 \uC7A0\uACA8 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572015
    m_Localized: "\"\uC774 \uC591\uC2DD\uC740... \uC81C\uAC00 \uC218\uB828\uBC1B\uB358
      \uACF3\uACFC \uAC19\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572016
    m_Localized: "\"...\uC548\uC73C\uB85C \uB4E4\uC5B4\uAC11\uB2C8\uB2E4. \uC5EC\uAE30\uC11C
      \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB294\uC9C0 \uC54C\uC544\uC57C \uD569\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572017
    m_Localized: "\uB450 \uC0AC\uB78C\uC774 \uAE30\uC6B8\uC5B4\uC9C4 \uBCF5\uB3C4\uB97C
      \uAC77\uB294\uB2E4. \uBB3C\uC774 \uD55C\uCABD\uC73C\uB85C \uD750\uB974\uACE0,
      \uADF8\uB4E4\uC758 \uBC1C\uC18C\uB9AC\uAC00 \uC6B8\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572018
    m_Localized: "\uADF8\uB140\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uAC00\uB77C\uC549\uB294\uB2E4.
      \uAE30\uB465\uC774 \uAE30\uC6B8\uC5B4\uC9C4 \uAC01\uB3C4\uB97C \uBCF4\uACE0
      \uC788\uB2E4 \u2014 \uAD6C\uC870\uAC00 \uC544\uB2C8\uB77C \uC0C1\uC9D5\uC744
      \uC77D\uB294 \uAC83\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572019
    m_Localized: "\"\uC9C8\uC11C\uAC00... \uAC00\uB77C\uC549\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uBB3C\uB9AC\uC801\uC73C\uB85C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572020
    m_Localized: "\"\uC790\uAE30\uAC00 \uC9C0\uC740 \uAC83\uB3C4 \uBABB \uC9C0\uD0A4\uB294\uAD70.
      \uB3CC\uB2F4\uC774 \uBB3C\uC5D0 \uBE60\uC9C0\uB294 \uAF34\uC774\uB77C\uB2C8.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572021
    m_Localized: "Pack Raider\uAC00 \uBB3C\uC18D\uC5D0 \uBC1C\uC744 \uB2F4\uADFC\uB2E4.
      \uBC14\uB2E5\uC5D0 \uB179\uC2A8 \uBB34\uAE30\uAC00 \uC7A0\uACA8 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572022
    m_Localized: "\"\uB179 \uB0C4\uC0C8. \uC624\uB798\uB41C \uD53C \uB0C4\uC0C8.
      \uC5EC\uAE30\uC11C \uC790\uAE30\uB4E4\uB07C\uB9AC \uC2F8\uC6E0\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572023
    m_Localized: "\"\uAC19\uC740 \uC9C8\uC11C\uC758 \uC2E0\uB3C4\uB07C\uB9AC \uCE7C\uC744
      \uACA8\uB234\uB2E4\uB294 \uAC81\uB2C8\uAE4C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572024
    m_Localized: "\uBB3C \uC704\uB85C \uAE30\uB984 \uB9C9\uC774 \uBC88\uC9C4\uB2E4.
      \uC0C9\uC774 \uC774\uC0C1\uD558\uB2E4 \u2014 \uBB34\uC9C0\uAC1C\uAC00 \uC544\uB2C8\uB77C,
      \uACA9\uC790 \uD30C\uD3B8\uC774 \uB179\uC544\uB0B4\uB9B0 \uC0C9\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572025
    m_Localized: "\"\uADF8\uB7EC\uAC8C. \uC9C8\uC11C\uB77C\uB294 \uAC8C \uC6D0\uB798
      \uC774\uB7F0 \uB9DB\uC774\uC57C?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572026
    m_Localized: "\uD3EC\uC7A5 \uB3C4\uB85C \uC591\uD3B8\uC5D0 \uCC98\uD615\uB300\uC640
      \uACE0\uD574\uC18C\uAC00 \uBC88\uAC08\uC544 \uC11C \uC788\uB2E4. \uB3CC\uBC14\uB2E5\uC5D0
      \uAC80\uC740 \uC5BC\uB8E9\uC774 \uADDC\uCE59\uC801\uC73C\uB85C \uCC0D\uD600
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572027
    m_Localized: "\"\uC815\uD654 \uC7AC\uD310\uC758 \uD604\uC7A5\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572028
    m_Localized: "\"\uC548\uC0C9\uC774 \uC88B\uC744 \uC218\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572029
    m_Localized: "\uBC14\uB78C\uC774 \uB3C4\uB85C\uB97C \uB530\uB77C \uBD84\uB2E4.
      \uC7AC\uAC00 \uC544\uB2C8\uB77C \uBA3C\uC9C0\uB2E4. \uC624\uB798\uB41C \uBA3C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572030
    m_Localized: "\"\uC790\uAE30 \uB3D9\uC871\uD55C\uD14C\uB3C4 \uC774\uB7F0 \uC9D3\uC744?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572031
    m_Localized: "Pack Raider\uAC00 \uCC98\uD615\uB300 \uC704\uC758 \uC1E0\uACE0\uB9AC\uB97C
      \uB9CC\uC9C4\uB2E4. \uC190\uAC00\uB77D \uD06C\uAE30\uC5D0 \uB9DE\uAC8C \uB2F3\uC544
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572032
    m_Localized: "\"\uC9D0\uC2B9\uC740 \uCD5C\uC18C\uD55C \uBA39\uC73C\uB824\uACE0
      \uC8FD\uC774\uAE30\uB77C\uB3C4 \uD558\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572033
    m_Localized: "\"\uC815\uD654\uB77C\uB294 \uC774\uB984\uC73C\uB85C \uD589\uD574\uC9C4
      \uC77C\uB4E4\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572034
    m_Localized: "\uBC14\uB2E5\uC5D0 \uAE68\uC9C4 \uC131\uBB3C\uD568\uC774 \uC788\uB2E4.
      \uC548\uC774 \uBE44\uC5B4 \uC788\uB2E4 \u2014 \uC6D0\uB798\uBD80\uD130 \uBE44\uC5B4
      \uC788\uC5C8\uB358 \uAC83\uCC98\uB7FC."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572035
    m_Localized: "\"\uBE48 \uC131\uBB3C\uD568 \uC704\uC5D0 \uD53C\uB97C \uBFCC\uB838\uC2B5\uB2C8\uB2E4.
      \uC774\uAC83\uC744 \uCD95\uBCF5\uC774\uB77C \uBD88\uB800\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572036
    m_Localized: "Dawn Priest\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uD754\uB4E4\uB9B0\uB2E4.
      \uCC98\uC74C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572037
    m_Localized: "\"...\uC0AC\uC81C. \uC548\uC0C9\uC774 \uC548 \uC88B\uC544.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572038
    m_Localized: "\uC18C\uB098\uBB34 \uAECD\uC9C8\uC5D0 \uAC08\uD034 \uC790\uAD6D\uC774
      \uAE4A\uAC8C \uD30C\uC5EC \uC788\uB2E4. \uB2E4\uC12F \uAC1C. \uC190\uD1B1\uC774
      \uC544\uB2C8\uB77C \uBC1C\uD1B1\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572039
    m_Localized: "\"\uC57C\uC218\uC871\uC758 \uC601\uC5ED \uD45C\uC2DD\uC785\uB2C8\uB2E4.
      \uACBD\uACC4\uB97C \uB2A6\uCD94\uC9C0 \uB9C8\uC2ED\uC2DC\uC624.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572040
    m_Localized: "\"\uACBD\uACE0\uAC00 \uC544\uB2C8\uC57C. \uBC14\uB78C\uC5D0\uAC8C
      \uC62C\uB9AC\uB294 \uAE30\uB3C4\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572041
    m_Localized: "\uC548\uAC1C \uC0AC\uC774\uB85C \uB178\uB780 \uB208\uC774 \uBC18\uC9DD\uC778\uB2E4.
      \uD558\uB098, \uB458, \uC14B \u2014 \uB208\uC744 \uAE5C\uBE61\uC774\uBA74 \uC0AC\uB77C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572042
    m_Localized: "\"\uC6C0\uC9C1\uC774\uC9C0 \uB9C8\uC2ED\uC2DC\uC624. \uD3EC\uC704
      \uC9D5\uD6C4\uAC00 \uBCF4\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572043
    m_Localized: "\"\uD3EC\uC704\uAC00 \uC544\uB2C8\uC57C. \uAD6C\uACBD\uD558\uB294
      \uAC70\uC57C. \uB108\uD76C\uAC00 \uC5BC\uB9C8\uB098 \uC2DC\uB044\uB7EC\uC6B4\uC9C0\uB97C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572044
    m_Localized: "Pack Raider\uAC00 \uCF54\uB97C \uB4E4\uC5B4\uC62C\uB9B0\uB2E4.
      \uC194\uC78E \uC544\uB798\uB85C \uC816\uC740 \uD759\uACFC \uD138 \uB0C4\uC0C8\uAC00
      \uACB9\uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572045
    m_Localized: "\"\uC0C8\uB07C\uB4E4\uC774 \uAC00\uAE4C\uC774 \uC788\uC5B4. \uC5EC\uAE30\uC11C\uBD80\uD134
      \uB124 \uC2DD\uB300\uB85C \uD558\uBA74 \uC548 \uB3FC.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572046
    m_Localized: "\"\uB2F9\uC2E0\uC758 \uC601\uC5ED\uC774\uB77C\uB294 \uAC83\uC740
      \uC778\uC815\uD569\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uC6B0\uB9AC\uC758 \uBA85\uBD84\uC740
      \uBCC0\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572047
    m_Localized: "\"\uBA85\uBD84. \uC88B\uC740 \uB0C4\uC0C8\uAC00 \uB098\uB294 \uB2E8\uC5B4\uC57C.
      \uC232\uC5D0\uC120 \uB0C4\uC0C8\uAC00 \uC548 \uB098\uB294 \uAC83\uB9CC \uC704\uD5D8\uD558\uAC70\uB4E0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572048
    m_Localized: "\uBCBD\uBA74\uC774 \uBE5B\uB098\uACE0 \uC788\uB2E4. 3000\uB144\uC758
      \uAE30\uC5B5\uC774 \uC9C0\uCE35\uCC98\uB7FC \uC313\uC5EC \uC788\uB2E4. \uAC78\uC744\uC218\uB85D
      \uC2DC\uB300\uAC00 \uAE4A\uC5B4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572049
    m_Localized: "\"\uC774\uAC74... \uB0B4 \uAE30\uC5B5 \uBCF4\uAD00\uC18C\uBCF4\uB2E4
      \uD06C\uB124. \uD6E8\uC52C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572050
    m_Localized: "\"\uADF8\uB798. \uBD80\uC218\uB294 \uAC74 \uB2F5\uC774 \uC544\uB2C8\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572051
    m_Localized: "\uC544\uB798\uC5D0\uC11C \uB9E5\uB3D9\uC774 \uAC15\uD574\uC9C4\uB2E4.
      \uC2EC\uC7A5\uC5D0 \uAC00\uAE4C\uC6CC\uC9C0\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572052
    m_Localized: "\"\uB9E8 \uC544\uB798 \uCE35\uC5D0 Aldric\uC758 \uC2DC\uB300\uAC00
      \uC788\uC744 \uAC81\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572053
    m_Localized: "\uBCBD\uC5D0 \uC804\uD22C \uC7A5\uBA74\uC774 \uC7AC\uC0DD\uB41C\uB2E4.
      \uC624\uB798\uB41C \uAC83\uBD80\uD130. \uCCAB \uC804\uC7C1, \uBD09\uC778, \uAE34
      \uD3C9\uD654, \uADF8\uB9AC\uACE0 \uD48D\uD654."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572054
    m_Localized: "\"\uC57C\uC218\uC871\uC774 \uBCF4\uC5EC. \uC61B\uB0A0 \uC57C\uC218\uC871.
      \uBB34\uAE30\uAC00 \uC5C6\uC5B4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572055
    m_Localized: "\"\uB098\uB3C4 \uBCF4\uC778\uB2E4. 1800\uB144 \uC804\uC758 \uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572056
    m_Localized: "Echo Savant\uAC00 \uBCBD\uC5D0 \uC190\uC744 \uB304\uB2E4. \uC790\uC2E0\uC758
      \uACFC\uAC70\uC640 \uB9C8\uC8FC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572057
    m_Localized: "\"\uAE30\uBD84 \uC774\uC0C1\uD558\uC9C0?\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572058
    m_Localized: "\"\uC774\uC0C1\uD55C \uAC8C \uC544\uB2C8\uB2E4. \uC544\uD504\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 21974496721572059
    m_Localized: "\"\uBAA8\uB450\uC758 \uAE30\uC5B5\uC785\uB2C8\uB2E4. \uC774\uAC83\uC744
      \uC9C0\uCF1C\uC57C \uD569\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  references:
    version: 2
