    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "\uC7AC\uC804\uD22C\uB294 \uBE60\uB978 \uC804\uD22C\uC5D0\uC11C\uB9CC
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: "\uC9C1\uC811 Town \uBCF5\uADC0\uB294 \uBE60\uB978 \uC804\uD22C\uC5D0\uC11C\uB9CC
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "\uC9C1\uC811 Town\uC73C\uB85C \uB3CC\uC544\uAC00\uB824\uBA74 \uC804\uD22C\uB97C
      \uBA3C\uC800 \uB05D\uB0B4\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "\uD45C\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "\uB514\uBC84\uADF8"
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: "\uBE60\uB978 \uC804\uD22C\uC5D0\uC11C \uC77C\uC2DC\uC815\uC9C0,
      \uB2E4\uC2DC \uC7AC\uC0DD, \uBC30\uC18D \uC870\uC808\uC744 \uC0AC\uC6A9\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "\uD655\uC815\uB41C \uC804\uD22C \uACB0\uACFC\uB97C \uAC00\uC9C0\uACE0
      Reward\uB85C \uC9C4\uD589\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: "\uC804\uD22C\uAC00 \uC644\uC804\uD788 \uB05D\uB09C \uB4A4 Continue\uAC00
      \uD65C\uC131\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: "\uD604\uC7AC \uBE60\uB978 \uC804\uD22C timeline\uC744 \uCC98\uC74C\uBD80\uD130
      \uB2E4\uC2DC \uC7AC\uC0DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 73
    m_Localized: "\uC0C8 seed\uB85C \uBE60\uB978 \uC804\uD22C\uB97C \uB2E4\uC2DC
      \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 74
    m_Localized: "\uC804\uD22C\uAC00 \uB05D\uB09C \uB4A4 \uBE60\uB978 \uC804\uD22C\uB97C
      \uC815\uB9AC\uD558\uACE0 \uC989\uC2DC Town\uC73C\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 75
    m_Localized: "\uD45C\uC2DC \uC124\uC815\uC744 \uC5FD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "\uC804\uC7A5 \uC720\uB2DB \uC704\uC5D0 HP\uC640 \uC0C1\uD0DC\uB97C
      \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: "\uC804\uD22C \uC911 \uD53C\uD574\uC640 \uD68C\uBCF5 \uC218\uCE58\uB97C
      \uD45C\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "\uC591\uCABD \uD300 \uC694\uC57D \uD328\uB110 \uD45C\uC2DC\uB97C
