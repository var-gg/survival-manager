  - m_Id: 168060748029952
    m_Localized: "\uD30C\uD3B8 \uAE30\uC5B5"
    m_Metadata:
      m_Items: []
  - m_Id: 168060748029953
    m_Localized: "\uBB3C\uB9AC \uCD9C\uB825\uACFC \uACF5\uACA9 \uC18D\uB3C4\uAC00
      \uC624\uB985\uB2C8\uB2E4. \uC801\uC744 \uCC98\uCE58\uD558\uBA74 2.5\uCD08\uAC04
      \uB0A8\uC740 \uC801\uB4E4\uC758 \uBE48\uD2C8\uC774 \uB4DC\uB7EC\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 168061335232512
    m_Localized: "\uC120\uACE0\uC758 \uCE7C\uB05D"
    m_Metadata:
      m_Items: []
  - m_Id: 168061335232513
    m_Localized: "\uCE58\uBA85\uD0C0\uC640 \uD761\uD608\uC774 \uC624\uB985\uB2C8\uB2E4.
      \uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uC5D0\uB108\uC9C0 20\uC744 \uC5BB\uC2B5\uB2C8\uB2E4."
