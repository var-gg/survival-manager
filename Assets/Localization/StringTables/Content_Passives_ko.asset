      m_Items: []
  - m_Id: 168072479498241
    m_Localized: "\uC0AC\uAC70\uB9AC\uC640 \uAD50\uC804 \uAC70\uB9AC\uAC00 \uB298\uC5B4\uB0A9\uB2C8\uB2E4.
      \uC790\uC2E0\uC758 \uC561\uD2F0\uBE0C \uC2A4\uD0AC\uC774 \uCE58\uBA85\uD0C0\uB97C
      \uB0BC \uC218 \uC788\uAC8C \uB418\uACE0 \uC0AC\uAC70\uB9AC\uAC00 \uB354 \uB298\uC5B4\uB0A9\uB2C8\uB2E4."
    m_Metadata:
