  - m_Id: 168048764903424
    m_Localized: "\uCCA0\uAC00\uC8FD \uAE30\uC5B5"
    m_Metadata:
      m_Items: []
  - m_Id: 168048764903425
    m_Localized: "\uCCB4\uB825\uACFC \uBC29\uC5B4\uAC00 \uC624\uB985\uB2C8\uB2E4.
      \uCCB4\uB825\uC774 \uC808\uBC18 \uC544\uB798\uB85C \uCC98\uC74C \uB5A8\uC5B4\uC9C0\uBA74
      \uBCF4\uD638\uB9C9 45\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 168049486323712
    m_Localized: "\uB9F9\uC138\uC758 \uBB34\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 168049486323713
    m_Localized: "\uAC15\uC778\uD568\uACFC \uBCF4\uD638 \uBC18\uACBD\uC774 \uC624\uB985\uB2C8\uB2E4.
      \uC804\uD22C \uC2DC\uC791 \uD6C4 8\uCD08\uAC04 \uBC1B\uB294 \uD53C\uD574\uAC00
      \uC904\uC5B4\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 168050060943360
    m_Localized: "vanguard \uAC70\uC810 03"
    m_Metadata:
      m_Items: []
