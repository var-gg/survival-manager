  - m_Id: 7050075351015424
    m_Localized: "\uACAC\uACE0\uD55C \uBC1C\uD310"
    m_Metadata:
      m_Items: []
  - m_Id: 7050076936462336
    m_Localized: "\uC800\uD56D\uC744 \uC18C\uD3ED \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050079583068160
    m_Localized: "\uBCF4\uD638 \uAC70\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 7050079583068161
    m_Localized: "\uBCF4\uD638 \uBC18\uACBD\uC744 \uC18C\uD3ED \uB113\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050081495670784
    m_Localized: "\uBC29\uBCBD \uADDC\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 7050081495670785
    m_Localized: "\uCCB4\uB825\uACFC \uC800\uD56D\uC744 \uD568\uAED8 \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050082787516416
    m_Localized: "\uD754\uB4E4\uB9BC \uC5C6\uB294 \uC804\uC5F4"
    m_Metadata:
      m_Items: []
  - m_Id: 7050082787516417
    m_Localized: "\uBC29\uC5B4\uC640 \uAC15\uC778\uD568\uC744 \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050084087750656
    m_Localized: "\uB3C4\uBC1C \uBC18\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 7050084087750657
    m_Localized: "\uBCF4\uD638\uC640 \uC704\uD611 \uBC18\uACBD\uC744 \uB113\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050086847602688
    m_Localized: "\uBD88\uAD74\uC758 \uBC29\uD328"
    m_Metadata:
      m_Items: []
  - m_Id: 7050086847602689
    m_Localized: "\uC804\uC5F4 \uC720\uC9C0\uB825\uC744 \uD06C\uAC8C \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050088995086336
    m_Localized: "\uC2DC\uC120 \uACE0\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 7050088995086337
    m_Localized: "\uCCAB \uCC98\uCE58 \uB4A4 \uB2E4\uC74C \uD45C\uC801\uC73C\uB85C
      \uB354 \uBE68\uB9AC \uC804\uD658\uD574 \uC5F0\uC1C4 \uD0AC\uC744 \uC900\uBE44\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050090198851584
    m_Localized: "\uAD73\uC13C \uC2EC\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 7050090198851585
    m_Localized: "\uAC15\uC778\uD568\uC744 \uB192\uC5EC \uC81C\uC5B4\uAC00 \uB9CE\uC740
      \uC801\uC744 \uC0C1\uB300\uD558\uB294 \uC120\uD0DD\uC744 \uC5FD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050091364868096
    m_Localized: "\uAC04\uACA9 \uD1B5\uC81C"
    m_Metadata:
      m_Items: []
  - m_Id: 7050091364868097
    m_Localized: "\uC544\uAD70 \uD6C4\uC5F4\uC744 \uBB38 \uC801 \uB2E4\uC774\uBC84\uB97C
      3m \uC548\uC5D0\uC11C \uC694\uACA9\uD569\uB2C8\uB2E4. \uCCB4\uB825\uACFC \uBCF4\uD638
      \uBC18\uACBD\uB3C4 \uB298\uC5B4\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050094317658112
    m_Localized: "\uCD94\uACA9 \uBCF8\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 7050094317658113
    m_Localized: "\uAE34 \uD0C0\uAE43 \uB77D \uC5C6\uC774 \uC774\uB3D9\uACFC \uACF5\uACA9
      \uC608\uC5F4\uC744 \uAC1C\uC120\uD574 \uC720\uC5F0\uD55C \uC554\uC0B4 \uACBD\uB85C\uB97C
      \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050095680806912
    m_Localized: "\uD53C\uC758 \uB300\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 7050095680806913
    m_Localized: "\uCC98\uCE58 \uC2DC 2.5\uCD08 \uC218\uD638\uB97C \uC5BB\uC5B4 \uB09C\uC804\uC5D0\uC11C
      \uD0AC\uC744 \uB538\uC218\uB85D \uB2E8\uB2E8\uD574\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050096762937344
    m_Localized: "\uCD5C\uD6C4\uC758 \uBCF4\uB8E8"
    m_Metadata:
      m_Items: []
  - m_Id: 7050096762937345
    m_Localized: "\uCCB4\uB825\uC774 \uCC98\uC74C 40% \uC774\uD558\uAC00 \uB418\uBA74
      \uBCF4\uD638\uB9C9 6\uACFC 2.5\uCD08 \uC218\uD638\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.
      \uC774\uB3D9 \uC18D\uB3C4\uB97C \uCD94\uAC00\uB85C \uD76C\uC0DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050098428076032
    m_Localized: "\uAE34 \uD638\uD761"
    m_Metadata:
      m_Items: []
  - m_Id: 7050098428076033
    m_Localized: "\uACF5\uACA9 \uC0AC\uAC70\uB9AC\uB97C \uC18C\uD3ED \uB298\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050101007572992
    m_Localized: "\uB0A0\uCE74\uB85C\uC6B4 \uD22C\uC0AC\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 7050101007572993
    m_Localized: "\uD22C\uC0AC\uCCB4 \uC18D\uB3C4\uB97C \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050102018400256
    m_Localized: "\uC57D\uC810 \uC0AC\uAC70\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 7050102018400257
    m_Localized: "\uBB3C\uB9AC \uCD9C\uB825\uACFC \uC0AC\uAC70\uB9AC\uB97C \uB192\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7050102895009792
    m_Localized: "\uC815\uC870\uC900 \uD750\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 7050102895009793
    m_Localized: "\uCE58\uBA85\uD0C0 \uD655\uB960\uACFC \uD22C\uC0AC\uCCB4 \uC18D\uB3C4\uB97C
      \uB192\uC785\uB2C8\uB2E4."
