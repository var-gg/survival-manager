    m_Metadata:
      m_Items: []
  - m_Id: 168051235348481
    m_Localized: "\uCCB4\uB825\uACFC \uB300\uC0C1 \uC804\uD658\uC774 \uAC1C\uC120\uB429\uB2C8\uB2E4.
      \uC544\uAD70\uC774 \uC4F0\uB7EC\uC9C8 \uB54C\uB9C8\uB2E4 \uB0A8\uC740 \uC544\uAD70
      \uC804\uCCB4\uAC00 \uBCF4\uD638\uB9C9 25\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
