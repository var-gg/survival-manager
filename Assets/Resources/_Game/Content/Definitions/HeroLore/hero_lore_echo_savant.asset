  _id: hero_lore_echo_savant
  _heroId: hero_echo_savant
  _tier: 0
  _beatBudget: 6
  _canonBio: "\uADF8\uBB3C \uACB0\uC0AC\uC758 \uC2DC\uC870 \uBCF8\uC778. \uCCAB \uB3C4\uC2DC
    \uD559\uC0B4 \uC9C1\uD6C4 \uCE68\uBB35 \uC758\uBB34\uB97C \uBC1B\uC544 \uB3C4\uC2DC
    \uC785\uAD6C\uB97C 1800\uB144 \uB3D9\uC548 \uC758\uB840\uC801\uC73C\uB85C \uB2E4\uC2DC
    \uBB36\uC5B4 \uC628 '\uBB38\uC744 \uB2EB\uC740 \uC190'\uC774\uB2E4. \uD3C9\uC18C\uC5D0\uB294
    \uD3C9\uBC94\uD55C \uC778\uAC04\uC73C\uB85C \uC0B4\uBA70 \uC678\uBD80 \uC138\uACC4\uB294
    \uACB0\uC0AC\uC758 \uC874\uC7AC\uC870\uCC28 \uBAB0\uB790\uB2E4. \uC624\uB798
    \uB2EB\uC544 \uB454 \uC190\uC774\uB77C \uC5F4 \uB54C\uB3C4 \uBA3C\uC800 \uB5A8\uB9B0\uB2E4\uACE0
    \uB9D0\uD55C\uB2E4 \u2014 \uCC45\uC784\uC758 \uAC10\uAC01\uC774 \uC124\uC815
    \uC124\uBA85\uBCF4\uB2E4 \uBA3C\uC800 \uC624\uB294 \uC778\uBB3C\uC774\uB2E4.\n\n1800\uB144
    \uCE68\uBB35\uC744 \uB05D\uB0B4\uB824\uB294 \uC678\uBD80 \uD65C\uB3D9\uAC00 \uB178\uC120(\uACF5\uD55C)\uACFC,
    \uC2DC\uC870\uC758 \uC57D\uC18D\uC744 \uAE00\uC790 \uADF8\uB300\uB85C \uC218\uD638\uD558\uB824\uB294
    \uCE68\uBB35 \uAC15\uACBD\uD30C(\uCE68\uC6D4)\uAC00 \uCDA9\uB3CC\uD55C\uB2E4.
    \uCE68\uBB35\uC774 \uD559\uD30C\uC758 \uC57C\uC2EC\uC744 \uB9C9\uC9C0 \uBABB\uD588\uC74C\uC744
    \uC54C\uAE30\uC5D0 \uADF8\uB294 \uCE68\uBB35\uC744 \uB05D\uB0B4\uB294 \uCABD\uC744
    \uD0DD\uD55C\uB2E4.\n\nch5\uC5D0\uC11C \uACF5\uD55C\uC740 \uB3C4\uC2DC \uC548\uC73C\uB85C
    \uB4E4\uC5B4\uAC00\uB294 \uB300\uAC00\uB85C \uCE68\uC6D4\uC5D0\uAC8C \uACB0\uC0AC
    \uD6C4\uC608\uC758 \uC790\uB9AC\uB97C \uBC15\uD0C8\uB2F9\uD55C\uB2E4. \uB2E4\uC2DC
    \uBD09\uC778\uB418\uC9C0 \uC54A\uACE0, \uACB0\uC0AC \uC548\uC758 \uC774\uB984\uC744
    \uC783\uC740 \uCC44 \uBB38\uBC16\uC758 \uC678\uBD80 \uC99D\uC5B8\uC790\uB85C
    \uB0A8\uB294\uB2E4. '\uC78A\uC5B4\uB77C. \uB098\uB294 \uAE30\uC5B5\uD558\uACA0\uB2E4.'
    \uBE48 \uC190\uC73C\uB85C, \uC548\uC5D0\uC11C \uB098\uC624\uB824\uB294 \uC0AC\uB78C\uACFC
    \uBC16\uC5D0\uC11C \uB4E4\uC5B4\uC624\uB824\uB294 \uC0AC\uB78C\uC744 \uBAA8\uB450
    \uBD99\uC7A1\uACA0\uB2E4\uACE0 \uB9D0\uD55C\uB2E4."
  _unresolvedHook: hook_memory_custody
