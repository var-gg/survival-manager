  _canonBio: "\uC194\uB77C\uB8F8\uC758 \uC80A\uC740 \uC5EC\uC0AC\uC81C. \uBCF8 \uB300\uC131\uB2F9\uC5D0\uC11C
    \uC815\uD654 \uC758\uB840\uC640 \uC131\uBB3C \uAE30\uB85D\uC744 \uB9E1\uB2E4\uAC00
    \uBCC0\uBC29 \uC6D0\uC815\uC5D0 \uC790\uC6D0\uD55C \uCCAB \uC0AC\uC81C \uACC4\uAE09
    \uCD9C\uC2E0\uC774\uB2E4. \uC9D1\uC815\uAD00 \uD569\uC758\uC81C \uC548\uC5D0\uC11C
    '\uBCF4\uB7EC \uAC00\uB294 \uC790\uB9AC'\uB97C \uC790\uCCAD\uD588\uACE0 \uBCF8\uC778\uC740
    \uC2E0\uC559\uC758 \uD655\uC7A5\uC774\uB77C \uBBFF\uC5C8\uC73C\uB098, \uC2E4\uC81C\uB85C\uB294
    \uB2E8\uD604 \uD559\uD30C\uC758 \uBCC0\uBC29 \uB3C4\uAD74\uC744 \uC9C0\uCF1C\uBCFC
    \uAD00\uCC30\uC790\uC5D0 \uAC00\uAE5D\uB2E4. \uBE5B\uACFC \uC790\uC218, \uC0C8\uACA8\uC9C4
    \uC774\uB984, \uD759 \uC704\uC758 \uD754\uC801\uC744 \uBA3C\uC800 \uC77D\uB294
    \uC0AC\uB78C\uC774\uB2E4.\n\n\uBCC0\uBC29\uC5D0\uC11C \uB2E8\uB9B0\uC740 \uC790\uC2E0\uC774
    \uC678\uC6B4 \uB2E8\uD604 \uD559\uC124\uC774 \uBC29\uD328\uAC00 \uC544\uB2C8\uB77C
    \uCE7C\uC774 \uB420 \uC218 \uC788\uC74C\uC744 \uBCF8\uB2E4. \uC815\uD654 \uC7AC\uD310\uC758
    '\uC815\uACB0/\uC624\uC5FC' \uBD84\uB958\uAC00 \uC0AC\uB78C\uC744 \uBC88\uD638\uB85C
    \uC811\uB294 \uC5B8\uC5B4\uC600\uC74C\uC744 \uC778\uC815\uD558\uBA74\uC11C, \uB3D9\uAE30\uB294
    '\uC2E0\uC559\uC758 \uC218\uD638'\uC5D0\uC11C '\uD55C \uC0AC\uB78C\uC73C\uB85C
    \uC99D\uC5B8\uD558\uAE30'\uB85C \uC62E\uACA8\uAC04\uB2E4.\n\n\uADF8\uB140\uAC00
    \uD3C9\uC0DD \uC678\uC6B4 \uBB38\uC7A5\uC744 \uC124\uACC4\uD55C \uB2E8\uD604\uC740
    \uC774\uBBF8 \uC8FD\uC5C8\uACE0, \uADF8 \uD559\uC124\uC744 \uC815\uCE58 \uC790\uC6D0\uC73C\uB85C
    \uBC14\uAFB8\uB824\uB294 \uBC31\uADDC\uAC00 \uD559\uC790\uC7A5\uC774\uB2E4. ch5\uC5D0\uC11C
    \uB2E8\uB9B0\uC740 \uB2E8\uD604 \uC77C\uC9C0\uC758 \uB9C8\uC9C0\uB9C9 \uBD80\uD0C1\uC744
    \uBC31\uADDC \uC55E\uC5D0\uC11C \uC778\uC6A9\uD558\uACE0, \uC0AC\uC81C \uC778\uC7A5\uC744
    \uB0B4\uB824\uB193\uC740 \uCC44 \uD55C \uC0AC\uB78C\uC73C\uB85C \uC99D\uC5B8\uD55C\uB2E4.
    \uBCF8 \uB300\uC131\uB2F9\uC73C\uB85C \uB3CC\uC544\uAC00\uC9C0 \uC54A\uACE0 \uC0C8
    \uC2E0\uC559\uC744 \uCC3E\uB294\uB2E4."
  _unresolvedHook: hook_faith_crack
