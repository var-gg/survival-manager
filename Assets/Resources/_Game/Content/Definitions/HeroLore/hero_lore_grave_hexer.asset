  _id: hero_lore_grave_hexer
  _heroId: hero_grave_hexer
  _tier: 0
  _beatBudget: 6
  _canonBio: "\uD68C\uC0C1 \uACB0\uC0AC\uC758 \uAE30\uC5B5 \uC99D\uC5B8\uC790. \uCCAB
    \uB3C4\uC2DC \uD559\uC0B4\uC758 \uC804\uC218 \uAE30\uC5B5\uC744 \uC758\uC2DD\uC73C\uB85C
    \uBB3C\uB824\uBC1B\uC544 \uC790\uAE30 \uCC45\uC784\uC73C\uB85C\uB9CC \uBD99\uB4E4\uC5B4
    \uC628, \uACB0\uC0AC\uC5D0\uC11C \uAC00\uC7A5 \uC624\uB798\uB41C \uCD95\uC758
    \uC778\uBB3C\uC774\uB2E4. \uC9C1\uC811 \uBAA9\uACA9\uC790\uB294 \uC544\uB2C8\uC9C0\uB9CC
    \uADF8 \uAE30\uC5B5\uC758 \uBB34\uAC8C\uB97C \uB204\uAD6C\uBCF4\uB2E4 \uC798
    \uC548\uB2E4. \uBB34\uAC70\uC6B4 \uC9C4\uC2E4\uC744 \uB18D\uB2F4\uACFC \uC0AC\uC18C\uD55C
    \uAE30\uC5B5\uC73C\uB85C \uC539\uC5B4 \uB118\uAE30\uB294 \uC2DC\uAC04 \uAC70\uB9AC\uAC10\uC774
    \uCEA0\uD398\uC778 \uC911\uBC18\uC758 \uAD6C\uBA85\uC904\uC774\uB2E4.\n\n\uD68C\uC0C1
    \uACB0\uC0AC\uB294 \uD559\uC0B4 \uAE30\uC5B5\uC744 \uC5B4\uB5BB\uAC8C \uB2E4\uB8F0\uC9C0\uC5D0\uC11C
    \uAC08\uB77C\uC9C4\uB2E4 \u2014 \uBCF4\uC874\uD558\uBA70 \uD654\uD574\uC758 \uC5EC\uC9C0\uB97C
    \uB0A8\uAE30\uB824\uB294 \uBB35\uD5A5\uACFC, \uB2E8\uC8C4 \uBA85\uB2E8\uC73C\uB85C
    \uCC45\uC784\uC744 \uBB3B\uB294 \uD751\uC9C0. \uADF8 \uBA85\uB2E8 \uC704\uC5D0\uB294
    \uBB35\uD5A5 \uC790\uC2E0\uC758 \uC774\uB984\uB3C4 \uC62C\uB77C \uC788\uB2E4.\n\nch5\uC5D0\uC11C
    \uBB35\uD5A5\uC740 \uD751\uC9C0\uC758 \uBA85\uB2E8\uC744 \uB4E4\uACE0 \uB3C4\uC2DC
    \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uACE0, \uC804\uC218 \uAE30\uC5B5\uC758
    \uC77C\uBD80\uB97C \uB2E8\uB9B0\uC5D0\uAC8C \uB9E1\uAE34\uB2E4. \uC790\uAE30
    \uC774\uB984\uC744 \uBA85\uB2E8\uC5D0\uC11C \uBE7C \uB2EC\uB77C \uCCAD\uD558\uC9C0
    \uC54A\uACE0, '\uC790\uB9AC\uAC00 \uBE44\uBA74 \uC78E \uD558\uB098\uB294 \uB07C\uC6CC
    \uB450\uB77C'\uBA70 \uC790\uC2E0\uC774 \uBCF4\uC558\uB2E4\uB294 \uD45C\uC2DC\uB9CC
    \uB0A8\uAE34\uB2E4. \uD751\uC9C0\uC640\uC758 \uBA85\uB2E8 \uBB38\uC81C\uB294
    \uBBF8\uD574\uACB0\uB85C \uB0A8\uB294\uB2E4."
  _unresolvedHook: hook_memory_debt
