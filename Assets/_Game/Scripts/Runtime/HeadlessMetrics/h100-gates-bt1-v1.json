        { "metric_id": "concept_adaptive_completion_lcb95", "operator": "gte", "value": 0.40, "unit": "ratio", "note": "완주율 one-sided 95% LCB" },
        { "metric_id": "no_cheat_macro_family_completion_witness_min", "operator": "gte", "value": 1, "unit": "witnesses", "note": "시너지·독트린, 상태·아이템, 전술·진형 3개 family 각각의 최소 witness" },
        { "metric_id": "oracle_0_8_blocker_chosen_win_rate", "operator": "gte", "value": 0.70, "unit": "ratio", "note": "oracle win 가능성 0.8 이상 blocker의 chosen win rate" },
        { "metric_id": "oracle_0_8_blocker_selection_regret", "operator": "lte", "value": 0.25, "unit": "ratio", "note": "oracle win 가능성 0.8 이상 blocker의 selection regret" },
        { "metric_id": "hard_wall_count", "operator": "eq", "value": 0, "unit": "count", "note": "oracle상 해법이 충분한 반복 hard wall 0" }
      ]
    },
    {
      "id": "BT9",
      "name_ko": "함정 옵션·버그급 지배성 부재",
      "measurement": "intended context의 기계 witness, paired counterfactual과 dominance 확인",
      "role": "hard",
      "evaluable_now": false,
      "depends_on_envelope": ["E08", "E09"],
      "legacy_gate_ids": ["integrity_reproducibility", "build_ecology", "formation_significance", "depth_causality"],
      "thresholds": [
        { "metric_id": "confirmed_trap_count", "operator": "eq", "value": 0, "unit": "count", "note": "확정 함정 옵션 0" },
        { "metric_id": "unresolved_mechanical_defect_count", "operator": "eq", "value": 0, "unit": "count", "note": "미해결 기계 결함 0" },
        { "metric_id": "bug_grade_dominant_count", "operator": "eq", "value": 0, "unit": "count", "note": "명시적 trade-off 없는 버그급 지배 옵션 0" }
      ]
    },
    {
      "id": "BT10",
      "name_ko": "베타테스터 재미·재시도 판정",
      "measurement": "냉시작 LLM의 욕구·커밋·payoff·재시도와 owner two-key 승인",
      "role": "hard",
      "evaluable_now": false,
      "depends_on_envelope": ["E04", "E05", "E07"],
      "legacy_gate_ids": ["spectator_arc", "blind_fun_approval", "final_reproduction"],
      "thresholds": [
        { "metric_id": "cold_start_run_count", "operator": "eq", "value": 6, "unit": "runs", "note": "최종 냉시작 LLM 6회" },
        { "metric_id": "desire_formed_run_count", "operator": "gte", "value": 5, "unit": "runs", "note": "사전에 빌드 욕구를 형성" },
        { "metric_id": "evidence_grounded_commit_run_count", "operator": "gte", "value": 4, "unit": "runs", "note": "욕구와 관측 근거에 따른 실제 커밋" },
        { "metric_id": "payoff_or_legible_near_miss_run_count", "operator": "gte", "value": 4, "unit": "runs", "note": "예상 payoff 또는 납득 가능한 near-miss 경험" },
        { "metric_id": "next_concept_named_run_count", "operator": "gte", "value": 4, "unit": "runs", "note": "다음 run의 다른 구체적 컨셉 명명" },
        { "metric_id": "complaint_repeated_twice_count", "operator": "eq", "value": 0, "unit": "complaints", "note": "같은 불투명한 막힘·starvation·무의미한 선택 불만 2회 반복 0" },
        { "metric_id": "evaluation_sentence_telemetry_link_rate", "operator": "eq", "value": 1.0, "unit": "ratio", "note": "모든 핵심 평가 문장을 telemetry event ID에 연결" },
        { "metric_id": "owner_approval", "operator": "eq", "value": 1, "unit": "boolean", "note": "기계 PASS와 별개인 owner approval 필수 two-key" }
      ]
    }
  ],
  "legacy_gate_migrations": [
    { "legacy_gate_id": "integrity_reproducibility", "role": "hard", "bt_gate_ids": ["BT1", "BT9"], "rationale": "재현성 해시와 런타임 무결성은 hard로 유지하고 결정성·기계 결함 축으로 분리한다." },
    { "legacy_gate_id": "campaign_completion", "role": "diagnostic", "bt_gate_ids": ["BT6", "BT8"], "rationale": "60~80% 완주 밴드는 diagnostic으로 내리고 track availability와 adaptive reachability를 hard로 승계한다." },
    { "legacy_gate_id": "build_ecology", "role": "diagnostic", "bt_gate_ids": ["BT4", "BT9"], "rationale": "승률 평등성은 diagnostic이며 유추 가능한 문법과 trap·bug-grade dominance만 hard로 승계한다." },
    { "legacy_gate_id": "effective_build_diversity", "role": "diagnostic", "bt_gate_ids": ["BT4", "BT6", "BT7"], "rationale": "동급 빌드 수와 점유율은 diagnostic이며 발견·트랙·실현 경험으로 분해한다." },
    { "legacy_gate_id": "decision_depth", "role": "diagnostic", "bt_gate_ids": ["BT4", "BT5", "BT6"], "rationale": "선택 가치 분포는 diagnostic이며 가설·의도·진척 연속성으로 대체한다." },
    { "legacy_gate_id": "formation_significance", "role": "diagnostic", "bt_gate_ids": ["BT3", "BT7", "BT9"], "rationale": "placement leverage 밴드는 diagnostic이며 visible promise, payoff, 기계 진실성만 hard다." },
    { "legacy_gate_id": "spectator_arc", "role": "diagnostic", "bt_gate_ids": ["BT10"], "rationale": "전투 길이와 stomp 비율은 재미 판단의 진단 프록시로만 보존한다." },
    { "legacy_gate_id": "depth_causality", "role": "diagnostic", "bt_gate_ids": ["BT3", "BT7", "BT9"], "rationale": "fired·causal prevalence는 diagnostic이며 설명-동작 정합, payoff witness, 기계 진실성으로 분리한다." },
    { "legacy_gate_id": "blind_fun_approval", "role": "diagnostic", "bt_gate_ids": ["BT10"], "rationale": "legacy blind score는 diagnostic으로 보존하고 냉시작 desire→commit→payoff→retry와 owner two-key로 대체한다." },
    { "legacy_gate_id": "final_reproduction", "role": "diagnostic", "bt_gate_ids": ["BT1", "BT10"], "rationale": "legacy 전체 게이트 재통과·archive 조건은 diagnostic으로 보존하고 결정성 및 최종 two-key RC로 승계한다." }
  ]
