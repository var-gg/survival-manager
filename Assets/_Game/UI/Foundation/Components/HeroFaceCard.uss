/* =============================================================
   HeroFaceCard atom (sm-face-card)
   잿골 hub V3 (`pindoc://decision-town-hub-v3-ashglen-face-cluster`) +
   atom contract (`pindoc://analysis-hero-face-card-bark-emotion-system`).
   NPC + hero 공용 — 얼굴 중심 사각형 카드 + 배지로 위계 분리 + 8 감정 swap class.
   다키스트 던전 패턴: 정적 일러도 표정 + 바크로 살아 숨쉬는 ambient.
   ============================================================= */

.sm-face-card {
    /* wave-32 sepia 통합: 다른 production panel과 mood 일관. 기존 navy(20,26,53,0.78) cross-panel drift. */
    position: relative;
    flex-direction: column;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgba(28, 22, 12, 0.84);
    border-top-width: 1px;
    border-left-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 2.5px;
    border-top-color: var(--sm-gold-200);
    border-left-color: var(--sm-gold-400);
    border-right-color: var(--sm-gold-400);
    border-bottom-color: var(--sm-gold-500);
    transition-property: scale, translate, border-top-color;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.sm-face-card:hover {
    scale: 1.04 1.04;
    translate: 0 -2px;
    border-top-color: var(--sm-gold-100);
}

/* role 위계 */
.sm-face-card--npc {
    /* wave-32: NPC card sepia + slight warm tint (잿골 거점). */
    background-color: rgba(36, 28, 16, 0.92);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-300);
}

.sm-face-card--hero-deploy {
    /* wave-32: deploy 4 hero card sepia + 강한 gold trim — 다른 production panel과 mood 일관. */
    background-color: rgba(48, 36, 20, 0.94);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-300);
    border-top-width: 2px;
    border-bottom-width: 3px;
}

.sm-face-card--hero {
    /* base 그대로 — 일반 roster */
}

/* size variant */
.sm-face-card--lg { width: 128px; height: 144px; }
.sm-face-card--md { width: 96px;  height: 112px; }
.sm-face-card--sm { width: 64px;  height: 80px; }

/* badge — 좌상단 작은 사각/원형. 거점 분류 또는 captain 표시. */
.sm-face-card__badge {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 22px;
    height: 22px;
    background-color: var(--sm-gold-400);
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--sm-gold-100);
    border-left-color: var(--sm-gold-300);
    border-right-color: var(--sm-gold-300);
    border-bottom-color: var(--sm-gold-500);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
    color: rgb(31, 19, 9);
}

.sm-face-card__badge--tavern  { background-color: rgba(127, 163, 224, 0.92); }   /* sapphire — 여관 */
.sm-face-card__badge--forge   { background-color: rgba(181, 138, 54, 0.92); }    /* ranger ochre — 공방 */
.sm-face-card__badge--clinic  { background-color: rgba(166, 220, 154, 0.92); }   /* safe green — 진료소 */
.sm-face-card__badge--records { background-color: rgba(212, 180, 240, 0.92); }   /* mystic — 기록 */
.sm-face-card__badge--captain { background-color: rgba(245, 214, 138, 0.95); }   /* gold-200 — captain */
.sm-face-card__badge--none    { display: none; }

/* portrait — 얼굴 close-up 영역. face_emotion_sheet 1 cell.
   P09 emotion sheet import 후 이 element의 background-image를 cell 1개로 채운다 (Phase 8).
   현재는 glyph(♟⚒✚✧✦) placeholder가 fallback으로 노출. */
.sm-face-card__portrait {
    flex-grow: 1;
    width: 100%;
    /* wave-35-placeholder: navy(8,12,28) → sepia 통일 (다른 production panel과 mood 일관). */
    background-color: rgba(28, 22, 12, 0.55);
    margin-bottom: 4px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.32);
    border-left-color: rgba(0, 0, 0, 0.28);
    border-right-color: rgba(0, 0, 0, 0.28);
    border-bottom-color: rgba(0, 0, 0, 0.18);
    -unity-background-scale-mode: scale-and-crop;
}

.sm-face-card__portrait-glyph {
    flex-grow: 1;
    /* wave-35-placeholder: glyph 가시성 ↑ — P09 import 전 임시 placeholder가 의도되어 보이도록 */
    color: rgba(255, 226, 153, 0.92);
    font-size: 24px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* wave-35-placeholder: NPC role 4명별 portrait BG 미세 tint 차등.
   P09 emotion sheet 도착 전까지 placeholder glyph만으로도 4 NPC가 visually distinct하도록.
   badge color와 같은 hue family로 5-8% tint만 mix → mood drift 없음.
   USS sibling combinator(~)는 Unity USS 미지원이라 portrait element 자체에
   `sm-face-card__portrait--{badge}` class를 View가 직접 추가한다. */
.sm-face-card__portrait--tavern  { background-color: rgba(60, 70, 100, 0.55); }
.sm-face-card__portrait--forge   { background-color: rgba(72, 56, 28, 0.62); }
.sm-face-card__portrait--clinic  { background-color: rgba(40, 58, 36, 0.55); }
.sm-face-card__portrait--records { background-color: rgba(64, 50, 80, 0.55); }

.sm-face-card--lg .sm-face-card__portrait-glyph { font-size: 34px; }
.sm-face-card--md .sm-face-card__portrait-glyph { font-size: 26px; }
.sm-face-card--sm .sm-face-card__portrait-glyph { font-size: 18px; }

/* emotion swap — face_emotion_sheet은 4×2 (8 cell). cell offset은 Unity USS의
   -unity-background-image-tint-color 또는 background-position-x/y로 cell 1개 노출.
   Phase 7에서는 PNG 자체를 emotion별 별도 file로 export하거나 (atlas slice) sprite로 처리.
   default neutral은 base background-image. swap class는 옅은 tint 또는 별도 sprite로.
   본격 sprite atlas slice는 art-pipeline 후속. 현재는 USS color tint overlay placeholder. */
.sm-face-card__emotion--neutral    { -unity-background-image-tint-color: rgba(255, 255, 255, 1); }
.sm-face-card__emotion--confident  { -unity-background-image-tint-color: rgba(255, 240, 200, 1); }
.sm-face-card__emotion--amused     { -unity-background-image-tint-color: rgba(255, 230, 180, 1); }
.sm-face-card__emotion--surprised  { -unity-background-image-tint-color: rgba(220, 230, 255, 1); }
.sm-face-card__emotion--concerned  { -unity-background-image-tint-color: rgba(200, 210, 230, 1); }
.sm-face-card__emotion--pained     { -unity-background-image-tint-color: rgba(220, 180, 180, 1); }
.sm-face-card__emotion--angry      { -unity-background-image-tint-color: rgba(255, 200, 200, 1); }
.sm-face-card__emotion--determined { -unity-background-image-tint-color: rgba(255, 220, 180, 1); }

/* name */
.sm-face-card__name {
    color: var(--sm-vellum);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.sm-face-card--lg .sm-face-card__name { font-size: 13px; }
.sm-face-card--md .sm-face-card__name { font-size: 11px; }
.sm-face-card--sm .sm-face-card__name { font-size: 9px; }

.sm-face-card__pip-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 3px;
}

.sm-face-card__pip {
    width: 5px;
    height: 5px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: rgba(35, 42, 72, 0.86);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.18);
    border-right-color: rgba(230, 183, 81, 0.18);
    border-top-color: rgba(230, 183, 81, 0.18);
    border-bottom-color: rgba(230, 183, 81, 0.18);
}

.sm-face-card__pip--on {
    background-color: var(--sm-gold-300);
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-100);
}

/* state overlay */
.sm-face-card__state-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.sm-face-card__state-overlay--ko       { background-color: rgba(138, 138, 152, 0.55); }
.sm-face-card__state-overlay--injured  { background-color: rgba(182, 51, 74, 0.18); }
.sm-face-card__state-overlay--locked   { background-color: rgba(107, 110, 133, 0.55); }
.sm-face-card__state-overlay--selected {
    background-color: rgba(0, 0, 0, 0);
    border-top-color: var(--sm-gold-100);
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-100);
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

/* bark anchor — BarkPopupView attach point */
.sm-face-card__bark-anchor {
    position: absolute;
    left: 50%;
    top: -8px;
    width: 1px;
    height: 1px;
}

/* =========================================================
   sm-bark-popup — face card 위에 잠깐 떠오르는 1-liner.
   wave-36-barkbus: BarkBus + BarkPopupView 최소 viable.
   다키스트 던전 ambient — emotion key swap class로 색조 변형.
   ========================================================= */
.sm-bark-popup {
    position: absolute;
    left: -52px;
    right: -52px;
    top: -36px;
    padding-top: 4px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(28, 22, 12, 0.94);
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 2px;
    border-top-color: var(--sm-gold-100);
    border-left-color: var(--sm-gold-300);
    border-right-color: var(--sm-gold-300);
    border-bottom-color: var(--sm-gold-500);
    color: var(--sm-vellum);
    font-size: 11px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
}

.sm-bark-popup--neutral    { border-top-color: var(--sm-gold-100); }
.sm-bark-popup--confident  { border-top-color: rgba(255, 234, 174, 0.95); }
.sm-bark-popup--amused     { border-top-color: rgba(245, 200, 122, 0.95); }
.sm-bark-popup--surprised  { border-top-color: rgba(180, 200, 248, 0.95); }
.sm-bark-popup--concerned  { border-top-color: rgba(166, 220, 154, 0.92); }
.sm-bark-popup--pained     { border-top-color: rgba(220, 138, 138, 0.92); }
.sm-bark-popup--angry      { border-top-color: rgba(232, 120, 96, 0.92); }
.sm-bark-popup--determined { border-top-color: rgba(245, 214, 138, 0.95); }
