.rcp-frame {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    background-color: var(--sm-bg-0);
}

.rcp-card {
    background-image: none;
    background-color: rgba(18, 24, 52, 0.96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-left-color: rgba(230, 183, 81, 0.34);
    border-right-color: rgba(230, 183, 81, 0.34);
    border-top-color: rgba(245, 214, 138, 0.24);
    border-bottom-color: rgba(138, 100, 24, 0.54);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
    -unity-font-style: bold;
}

.rcp-card--on-plan {
    background-image: none;
    background-color: rgba(44, 43, 58, 0.96);
    border-left-color: rgba(230, 183, 81, 0.72);
    border-right-color: rgba(230, 183, 81, 0.72);
    border-top-color: rgba(245, 214, 138, 0.78);
    border-bottom-color: rgba(200, 147, 42, 0.82);
}

.rcp-card--protected {
    background-image: none;
    background-color: rgba(18, 24, 55, 0.96);
    border-left-color: rgba(127, 163, 224, 0.68);
    border-right-color: rgba(127, 163, 224, 0.68);
    border-top-color: rgba(180, 205, 255, 0.70);
    border-bottom-color: rgba(74, 114, 184, 0.82);
}

.rcp-card__slot-badge {
    background-color: rgba(28, 34, 67, 0.94);
    color: var(--sm-gold-100);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.32);
    border-right-color: rgba(230, 183, 81, 0.32);
    border-top-color: rgba(245, 214, 138, 0.30);
    border-bottom-color: rgba(138, 100, 24, 0.40);
}

.rcp-card__slot-badge--on-plan {
    background-color: rgba(138, 100, 24, 0.82);
    color: var(--sm-ink-0);
}

.rcp-card__slot-badge--protected {
    background-color: rgba(26, 42, 82, 0.88);
    color: rgb(214, 226, 255);
}

.rcp-card__portrait,
.rcp-card__class-glyph,
.rcp-actions__scout-icon,
.rcp-actions__refresh-icon {
    background-image: none;
    background-color: rgba(8, 12, 28, 0.58);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(245, 214, 138, 0.20);
    border-right-color: rgba(245, 214, 138, 0.20);
    border-top-color: rgba(245, 214, 138, 0.18);
    border-bottom-color: rgba(245, 214, 138, 0.26);
}

.rcp-card__name {
    color: var(--sm-gold-100);
}

.rcp-card__meta-text {
    color: var(--sm-ink-2);
}

.rcp-card__plan-chip {
    background-color: rgba(28, 34, 67, 0.88);
    color: var(--sm-ink-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(127, 163, 224, 0.38);
    border-right-color: rgba(127, 163, 224, 0.38);
    border-top-color: rgba(127, 163, 224, 0.44);
    border-bottom-color: rgba(26, 42, 82, 0.78);
}

.rcp-card__plan-chip--on-plan {
    background-color: rgba(43, 82, 52, 0.82);
    color: rgb(216, 242, 205);
    border-left-color: rgba(120, 200, 140, 0.44);
    border-right-color: rgba(120, 200, 140, 0.44);
    border-top-color: rgba(120, 200, 140, 0.52);
}

.rcp-card__plan-chip--bridge {
    background-color: rgba(26, 42, 82, 0.84);
    color: rgb(214, 226, 255);
}

.rcp-card__plan-chip--off-plan {
    background-color: rgba(42, 38, 46, 0.82);
    color: var(--sm-ink-2);
    border-left-color: rgba(218, 187, 118, 0.30);
    border-right-color: rgba(218, 187, 118, 0.30);
    border-top-color: rgba(218, 187, 118, 0.34);
}

.rcp-card__plan-score,
.rcp-card__skill-slot,
.rcp-card__cost-label {
    color: var(--sm-gold-200);
}

.rcp-card__tag {
    background-color: rgba(26, 42, 82, 0.46);
    border-left-color: rgba(127, 163, 224, 0.34);
    border-right-color: rgba(127, 163, 224, 0.34);
    border-top-color: rgba(127, 163, 224, 0.38);
    border-bottom-color: rgba(26, 42, 82, 0.78);
    color: rgb(196, 214, 250);
}

.rcp-card__skills {
    border-top-color: rgba(230, 183, 81, 0.20);
}

.rcp-card__skill-name {
    color: var(--sm-ink-1);
}

.rcp-card__skill-line--flex .rcp-card__skill-slot {
    color: rgb(127, 163, 224);
}

.rcp-header__ornament,
.rcp-footer__glyph {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Divider/ui_divider_horizontal_diamond.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.rcp-actions__scout {
    color: var(--sm-gold-100);
    border-left-color: rgba(230, 183, 81, 0.40);
    border-right-color: rgba(230, 183, 81, 0.40);
    border-top-color: rgba(245, 214, 138, 0.42);
    border-bottom-color: rgba(138, 100, 24, 0.70);
}

.rcp-card__recruit,
.rcp-actions__refresh {
    color: rgb(36, 25, 8);
}

.rcp-card__recruit {
    border-top-color: var(--sm-gold-100);
    border-left-color: var(--sm-gold-300);
    border-right-color: var(--sm-gold-300);
    border-bottom-color: var(--sm-gold-500);
}

.rcp-actions__scout-icon,
.rcp-actions__refresh-icon {
    display: none;
}
