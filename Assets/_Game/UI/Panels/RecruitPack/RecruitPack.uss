/* Production-owned styles migrated from Assets/_Game/UI/Screens/Town/Preview/RecruitPreview.uss.
   Keep production panel UXML free of Screens/Town/Preview imports. */

/* =============================================================
   Recruit modal V1 production panel surface
   visual SoT: pindoc://town-ui-ux-시안-갤러리-v1 (3. Recruit modal)
   tone: deep navy frame + gold ornamental trim + parchment candidate cards
   ============================================================= */

.rcp-root {
    flex-grow: 1;
    color: var(--sm-ink-1);
}

.rcp-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("project://database/Assets/_Game/UI/Backdrops/ui_recruit_dusk.png");
    -unity-background-scale-mode: scale-and-crop;
}
.rcp-backdrop-dim {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(28, 22, 12, 0.30);
}

/* --- Modal frame ---
   Visual은 sm-modal-frame sm-modal-frame--ceremony, corner는 sm-frame-corner-cap.
   본 rule은 inset position만 유지. corner size 28→24로 통일 (drift 제거). */
.rcp-frame {
    left: 80px; right: 80px; top: 50px; bottom: 50px;
}

/* --- Header (ornamental title + close) --- */
.rcp-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 32px;
    padding-right: 32px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 183, 81, 0.32);
}
.rcp-header__title-block {
    flex-direction: row;
    align-items: center;
}
.rcp-header__ornament {
    width: 56px;
    height: 6px;
    background-color: rgba(230, 183, 81, 0.78);
}
.rcp-header__ornament--left { margin-right: 18px; }
.rcp-header__ornament--right { margin-left: 18px; }
.rcp-header__title {
    font-size: 18px;
    color: var(--sm-gold-100);
    letter-spacing: 3px;
    -unity-font-style: bold;
}
.rcp-header__close {
    width: 36px;
    height: 36px;
    background-color: rgba(38, 45, 84, 0.86);
    color: var(--sm-gold-200);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.55);
    border-right-color: rgba(230, 183, 81, 0.55);
    border-top-color: rgba(230, 183, 81, 0.55);
    border-bottom-color: rgba(230, 183, 81, 0.55);
}

/* --- Card row (4 candidates) --- */
.rcp-decision-layout {
    flex-direction: row;
    flex-grow: 1;
    padding-left: 28px;
    padding-right: 28px;
}

.rcp-card-row {
    flex-direction: row;
    justify-content: flex-start;
    padding-top: 22px;
    padding-bottom: 22px;
    padding-left: 0;
    padding-right: 12px;
    flex-grow: 1;
}

.rcp-card {
    width: 190px;
    height: 100%;
    margin-left: 8px;
    margin-right: 8px;
    padding-bottom: 8px;
    background-color: rgba(245, 234, 208, 0.94);
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_card_frame_normal.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-background-image-tint-color: rgba(245, 220, 170, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(138, 100, 24, 0.72);
    border-right-color: rgba(138, 100, 24, 0.72);
    border-top-color: rgba(138, 100, 24, 0.72);
    border-bottom-color: rgba(138, 100, 24, 0.72);
}
.rcp-card--selected {
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-100);
    background-color: rgba(44, 43, 58, 0.98);
}
.rcp-card--on-plan {
    border-left-color: var(--sm-gold-300);
    border-right-color: var(--sm-gold-300);
    border-top-color: var(--sm-gold-300);
    border-bottom-color: var(--sm-gold-300);
}
.rcp-card--protected {
    border-left-color: var(--sm-gold-200);
    border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200);
    border-bottom-color: var(--sm-gold-200);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
}

/* Pity badge — corner marker. slot type Protected와 별개:
   Metadata.ProtectedByPity = pity 보정으로 tier 보장된 offer. */
.rcp-card__pity-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    background-color: rgba(200, 147, 42, 0.92);
    color: rgba(43, 33, 12, 1);
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

/* Slot type badge — top of card. Recruitment 4 slot 정합 */
.rcp-card__slot-badge {
    align-self: center;
    margin-top: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: 9px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--sm-vellum);
}
.rcp-card__slot-badge--standard { background-color: rgba(38, 45, 84, 0.78); }
.rcp-card__slot-badge--on-plan  { background-color: rgba(200, 147, 42, 0.82); color: rgba(61, 47, 18, 1); }
.rcp-card__slot-badge--protected { background-color: rgba(74, 114, 184, 0.85); }
.rcp-card__slot-badge--scout {
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: var(--sm-gold-100); border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100); border-bottom-color: var(--sm-gold-100);
}

.rcp-card__portrait {
    height: 140px;
    -unity-background-scale-mode: scale-to-fit;
    margin: 4px 4px 0 4px;
}

/* Display name (recruit-contract: unit name 필수) */
.rcp-card__name {
    margin-top: 6px;
    -unity-text-align: middle-center;
    color: rgba(61, 47, 18, 1);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* Formation · class row (recruit-contract: formation line + class) */
.rcp-card__meta-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 3px;
    padding-left: 8px;
    padding-right: 8px;
}
.rcp-card__class-glyph {
    width: 16px;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 6px;
}
.rcp-card__meta-text {
    color: rgba(107, 93, 63, 1);
    font-size: 10px;
    letter-spacing: 1px;
}

/* tier dots + plan chip — single compact row */
.rcp-card__tier-plan-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 12px;
    margin-top: 6px;
}

/* Tier dots (3 dot = Common/Rare/Epic, fill 1/2/3) */
.rcp-card__tier-row {
    flex-direction: row;
    align-items: center;
}
.rcp-card__tier-dot {
    width: 10px;
    height: 10px;
    margin-left: 3px;
    margin-right: 3px;
    background-color: rgba(107, 93, 63, 0.32);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}
.rcp-card__tier-dot--filled { background-color: var(--sm-gold-300); }

/* Plan fit chip (now lives in tier-plan-row alongside tier dots) */
.rcp-card__plan-chip {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--sm-vellum);
}
.rcp-card__plan-chip--on-plan  { background-color: rgba(120, 200, 140, 0.78); color: rgba(20, 40, 22, 1); }
.rcp-card__plan-chip--bridge   { background-color: rgba(127, 163, 224, 0.78); color: rgba(20, 28, 50, 1); }
.rcp-card__plan-chip--off-plan { background-color: rgba(107, 93, 63, 0.55); color: var(--sm-vellum); }

/* Plan group — plan chip + plan score 묶음 (tier-plan-row 우측) */
.rcp-card__plan-group {
    flex-direction: row;
    align-items: center;
}

/* Plan score — Metadata.PlanScore.Total (6-component breakdown 합). 시각 노출 (캡처에서 tooltip 안 보임). */
.rcp-card__plan-score {
    margin-left: 5px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(138, 100, 24, 1);
}

.rcp-card__state-row {
    flex-direction: row;
    justify-content: center;
    min-height: 20px;
    margin-top: 5px;
}

.rcp-card__state-chip {
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-right: 3px;
    color: var(--sm-gold-100);
    background-color: rgba(28, 34, 67, 0.88);
    font-size: 8px;
    -unity-font-style: bold;
}

/* Tag chip row (archetype RecruitPlanTags ≤3 — offer field 아님, archetype 파생) */
.rcp-card__tag-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 6px;
}
.rcp-card__tag {
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-right: 3px;
    margin-bottom: 2px;
    background-color: rgba(127, 163, 224, 0.25);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(127, 163, 224, 0.55);
    border-right-color: rgba(127, 163, 224, 0.55);
    border-top-color: rgba(127, 163, 224, 0.55);
    border-bottom-color: rgba(127, 163, 224, 0.55);
    color: rgba(31, 59, 102, 1);
    font-size: 9px;
    -unity-font-style: bold;
}

/* Skills block — sig active / sig passive / flex active / flex passive */
.rcp-card__skills {
    flex-direction: column;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(138, 100, 24, 0.32);
}
.rcp-card__skill-line {
    flex-direction: row;
    align-items: center;
    padding-top: 1px;
    padding-bottom: 1px;
}
.rcp-card__skill-slot {
    width: 32px;
    color: rgba(138, 100, 24, 1);
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.rcp-card__skill-line--sig .rcp-card__skill-slot { color: var(--sm-gold-500); }
.rcp-card__skill-line--flex .rcp-card__skill-slot { color: rgba(127, 163, 224, 0.92); }
.rcp-card__skill-name {
    flex-grow: 1;
    color: rgba(61, 47, 18, 1);
    font-size: 10px;
}

/* Gold cost row */
.rcp-card__cost-row {
    flex-direction: row;
    justify-content: center;
    padding-bottom: 6px;
}
.rcp-card__cost-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--sm-gold-500);
    letter-spacing: 1px;
}

/* Per-card Recruit CTA — visual은 sm-cta sm-cta--md sm-cta--primary */
.rcp-card__recruit {
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 2px;
    color: rgba(61, 47, 18, 1);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

/* --- Action bar (scout | refresh | recruit) --- */
.rcp-actions {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    padding-bottom: 12px;
    padding-left: 56px;
    padding-right: 56px;
    border-top-width: 1px;
    border-top-color: rgba(230, 183, 81, 0.28);
}

/* Scout CTA: visual은 sm-cta sm-cta--lg sm-cta--secondary. width만 surface 고유.
   recruitment-contract.md: 35 Echo 1회/phase, OnPlan slot scoring bias. */
.rcp-actions__scout {
    width: 280px;
}
.rcp-actions__scout-icon {
    width: 22px;
    height: 22px;
    background-color: rgba(245, 234, 208, 0.92);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    margin-right: 10px;
}
.rcp-actions__scout-label {
    color: var(--sm-vellum);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* Refresh CTA: visual은 sm-cta sm-cta--lg sm-cta--primary. width만 surface 고유.
   recruitment-contract.md: free 1회 → 2/4/6 Gold cap. */
.rcp-actions__refresh {
    width: 280px;
}
.rcp-actions__refresh-icon {
    width: 22px;
    height: 22px;
    background-color: rgba(245, 234, 208, 0.92);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    margin-right: 10px;
}
.rcp-actions__refresh-label {
    color: rgba(61, 47, 18, 1);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.rcp-decision-panel {
    width: 260px;
    margin-top: 22px;
    margin-bottom: 22px;
    padding: 14px;
    background-color: rgba(28, 22, 12, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.34);
    border-right-color: rgba(230, 183, 81, 0.34);
    border-top-color: rgba(245, 214, 138, 0.24);
    border-bottom-color: rgba(138, 100, 24, 0.54);
}

.rcp-detail {
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 183, 81, 0.22);
}

.rcp-detail__name {
    color: var(--sm-gold-100);
    font-size: 14px;
    -unity-font-style: bold;
}

.rcp-detail__meta,
.rcp-detail__plan,
.rcp-detail__cost,
.rcp-pressure__count,
.rcp-pressure__need,
.rcp-pressure__plan {
    margin-top: 5px;
    color: var(--sm-ink-2);
    font-size: 11px;
}

.rcp-detail__plan,
.rcp-detail__cost {
    color: var(--sm-gold-200);
    -unity-font-style: bold;
}

.rcp-detail__skills {
    margin-top: 8px;
    color: var(--sm-ink-1);
    font-size: 10px;
    white-space: normal;
}

.rcp-detail__state-row,
.rcp-detail__tags,
.rcp-pressure__chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 7px;
}

/* chip 4 variants — Design Tokens v1 §4
   state(gold tint) / tag(info-blue tint) / category(ink) / hint(transparent).
   기존 셋이 같은 navy/blue 톤으로 묶여있어 의미 구분 X였음. variant별 토큰으로 분리. */

/* common chip dimension (variant 공통) */
.rcp-detail__state-chip,
.rcp-detail__tag,
.rcp-pressure__need-chip {
    margin-right: 4px;
    margin-bottom: 4px;
    padding-left: var(--sm-chip-px);
    padding-right: var(--sm-chip-px);
    padding-top: var(--sm-chip-py);
    padding-bottom: var(--sm-chip-py);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    font-size: var(--sm-fs-xs);
    -unity-font-style: bold;
}

/* state chip (gold tint) — 계획 적합/보호/정찰/보정 + roster need */
.rcp-detail__state-chip,
.rcp-pressure__need-chip,
.rcp-card__state-chip {
    background-color: var(--sm-chip-state-bg);
    border-left-color: var(--sm-chip-state-border);
    border-right-color: var(--sm-chip-state-border);
    border-top-color: var(--sm-chip-state-border);
    border-bottom-color: var(--sm-chip-state-border);
    color: var(--sm-chip-state-text);
}

/* tag chip (info-blue tint) — archetype tag 전열/결투/폭발/방패술 */
.rcp-detail__tag,
.rcp-card__tag {
    background-color: var(--sm-chip-tag-bg);
    border-left-color: var(--sm-chip-tag-border);
    border-right-color: var(--sm-chip-tag-border);
    border-top-color: var(--sm-chip-tag-border);
    border-bottom-color: var(--sm-chip-tag-border);
    color: var(--sm-chip-tag-text);
}

/* hint chip (transparent dashed) — 보유 골드/잔향 wallet */
.rcp-command-strip__wallet {
    color: var(--sm-chip-hint-text);
}

.rcp-pressure {
    margin-top: 12px;
}

.rcp-footer {
    align-items: center;
    padding-bottom: 12px;
}
.rcp-footer__glyph {
    width: 240px;
    height: 6px;
    background-color: rgba(216, 199, 153, 0.32);
}

/* Panel-local ArtBible ownership overrides. */
.rcp-frame {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    background-color: var(--sm-bg-0);
}

.rcp-card {
    background-image: none;
    background-color: rgba(28, 22, 12, 0.96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-left-color: rgba(230, 183, 81, 0.34);
    border-right-color: rgba(230, 183, 81, 0.34);
    border-top-color: rgba(245, 214, 138, 0.24);
    border-bottom-color: rgba(138, 100, 24, 0.54);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
    -unity-font-style: bold;
}

.rcp-card--on-plan {
    background-image: none;
    background-color: rgba(44, 43, 58, 0.96);
    border-left-color: rgba(230, 183, 81, 0.72);
    border-right-color: rgba(230, 183, 81, 0.72);
    border-top-color: rgba(245, 214, 138, 0.78);
    border-bottom-color: rgba(200, 147, 42, 0.82);
}

.rcp-card--protected {
    background-image: none;
    background-color: rgba(28, 22, 12, 0.96);
    border-left-color: rgba(127, 163, 224, 0.68);
    border-right-color: rgba(127, 163, 224, 0.68);
    border-top-color: rgba(180, 205, 255, 0.70);
    border-bottom-color: rgba(74, 114, 184, 0.82);
}

.rcp-card__slot-badge {
    background-color: rgba(28, 34, 67, 0.94);
    color: var(--sm-gold-100);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.32);
    border-right-color: rgba(230, 183, 81, 0.32);
    border-top-color: rgba(245, 214, 138, 0.30);
    border-bottom-color: rgba(138, 100, 24, 0.40);
}

.rcp-card__slot-badge--on-plan {
    background-color: rgba(138, 100, 24, 0.82);
    color: var(--sm-ink-0);
}

.rcp-card__slot-badge--protected {
    background-color: rgba(26, 42, 82, 0.88);
    color: rgb(214, 226, 255);
}

.rcp-card__portrait,
.rcp-card__class-glyph,
.rcp-actions__scout-icon,
.rcp-actions__refresh-icon {
    background-image: none;
    background-color: rgba(28, 22, 12, 0.58);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(245, 214, 138, 0.20);
    border-right-color: rgba(245, 214, 138, 0.20);
    border-top-color: rgba(245, 214, 138, 0.18);
    border-bottom-color: rgba(245, 214, 138, 0.26);
}

.rcp-card__name {
    color: var(--sm-gold-100);
}

.rcp-card__meta-text {
    color: var(--sm-ink-2);
}

.rcp-card__plan-chip {
    background-color: rgba(28, 34, 67, 0.88);
    color: var(--sm-ink-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(127, 163, 224, 0.38);
    border-right-color: rgba(127, 163, 224, 0.38);
    border-top-color: rgba(127, 163, 224, 0.44);
    border-bottom-color: rgba(26, 42, 82, 0.78);
}

.rcp-card__plan-chip--on-plan {
    background-color: rgba(43, 82, 52, 0.82);
    color: rgb(216, 242, 205);
    border-left-color: rgba(120, 200, 140, 0.44);
    border-right-color: rgba(120, 200, 140, 0.44);
    border-top-color: rgba(120, 200, 140, 0.52);
}

.rcp-card__plan-chip--bridge {
    background-color: rgba(26, 42, 82, 0.84);
    color: rgb(214, 226, 255);
}

.rcp-card__plan-chip--off-plan {
    background-color: rgba(42, 38, 46, 0.82);
    color: var(--sm-ink-2);
    border-left-color: rgba(218, 187, 118, 0.30);
    border-right-color: rgba(218, 187, 118, 0.30);
    border-top-color: rgba(218, 187, 118, 0.34);
}

.rcp-card__plan-score,
.rcp-card__skill-slot,
.rcp-card__cost-label {
    color: var(--sm-gold-200);
}

/* Panel-local override moved to Design Tokens v1 chip tokens — see L535. */

.rcp-card__skills {
    border-top-color: rgba(230, 183, 81, 0.20);
}

.rcp-card__skill-name {
    color: var(--sm-ink-1);
}

.rcp-card__skill-line--flex .rcp-card__skill-slot {
    color: rgb(127, 163, 224);
}

.rcp-header__ornament,
.rcp-footer__glyph {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Divider/ui_divider_horizontal_diamond.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.rcp-actions__scout {
    color: var(--sm-gold-100);
    border-left-color: rgba(230, 183, 81, 0.40);
    border-right-color: rgba(230, 183, 81, 0.40);
    border-top-color: rgba(245, 214, 138, 0.42);
    border-bottom-color: rgba(138, 100, 24, 0.70);
}

.rcp-card__recruit,
.rcp-actions__refresh {
    color: rgb(36, 25, 8);
}

.rcp-card__recruit {
    border-top-color: var(--sm-gold-100);
    border-left-color: var(--sm-gold-300);
    border-right-color: var(--sm-gold-300);
    border-bottom-color: var(--sm-gold-500);
}

.rcp-actions__scout-icon,
.rcp-actions__refresh-icon {
    display: none;
}

/* =============================================================
   Recruit Bible alignment pass — 3-zone candidate choice
   left: roster pressure / center: four candidates / right: selected detail.
   ============================================================= */

/* frame 9-slice border 96px * scale 0.5 = 시각 두께 48px. child가 frame
   border 그래픽 위로 올라가지 않도록 inner padding 48px로 inset.
   기존 .rcp-header / .rcp-command-strip / .rcp-decision-layout / .rcp-actions /
   .rcp-footer 다 이 padding 안으로 자연 들어감. */
.rcp-frame {
    left: 48px;
    right: 48px;
    top: 36px;
    bottom: 36px;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 36px;
    padding-bottom: 36px;
}

.rcp-header {
    padding-top: 14px;
    padding-bottom: 12px;
}

.rcp-command-strip {
    height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 34px;
    padding-right: 34px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 183, 81, 0.18);
    background-color: rgba(28, 22, 12, 0.36);
}

.rcp-command-strip__label,
.rcp-command-strip__hint {
    color: rgba(216, 199, 153, 0.82);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.rcp-command-strip__hint {
    margin-left: auto;
    color: rgba(127, 163, 224, 0.92);
}

.rcp-command-strip__meter {
    width: 76px;
    height: 6px;
    margin-left: 16px;
    background-color: rgba(28, 34, 67, 0.92);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(245, 214, 138, 0.28);
    border-bottom-color: rgba(26, 42, 82, 0.76);
}

.rcp-command-strip__meter--gold { background-color: rgba(138, 100, 24, 0.84); }
.rcp-command-strip__meter--blue { background-color: rgba(26, 42, 82, 0.92); }
.rcp-command-strip__meter--green { background-color: rgba(43, 82, 52, 0.82); }

/* frame padding 48/36이 이미 child를 inset 시킴. decision-layout 자체 padding은
   중복이라 0으로 reset. 단 top/bottom은 header/footer와 간격 유지 위해 작은 값. */
.rcp-decision-layout {
    flex-direction: row;
    flex-grow: 1;
    padding-left: 0;
    padding-right: 0;
    padding-top: 12px;
    padding-bottom: 8px;
}

.rcp-left-rail {
    width: 220px;
    align-self: flex-start;
    margin-top: 4px;
    margin-bottom: 4px;
    margin-right: 16px;
    padding: 16px;
    background-color: rgba(28, 22, 12, 0.86);
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_inner.png");
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-background-image-tint-color: rgba(255, 235, 200, 0.28);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.42);
    border-right-color: rgba(230, 183, 81, 0.42);
    border-top-color: rgba(245, 214, 138, 0.36);
    border-bottom-color: rgba(138, 100, 24, 0.66);
}

.rcp-rail__eyebrow {
    color: var(--sm-gold-100);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.rcp-pressure__count {
    color: var(--sm-gold-100);
    font-size: 18px;
    -unity-font-style: bold;
}

.rcp-pressure__need {
    color: var(--sm-ink-1);
    font-size: 13px;
    margin-top: 8px;
}

.rcp-pressure__plan {
    color: rgba(127, 163, 224, 0.95);
    font-size: 11px;
    margin-top: 8px;
    white-space: normal;
}

.rcp-pressure__chips {
    margin-top: 12px;
}

.rcp-rail__stack {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(230, 183, 81, 0.18);
}

.rcp-rail__signal {
    margin-top: 12px;
}

.rcp-rail__signal-title {
    color: rgba(216, 199, 153, 0.72);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.rcp-rail__signal-bar {
    height: 9px;
    margin-top: 6px;
    background-color: rgba(28, 34, 67, 0.92);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(245, 214, 138, 0.28);
    border-bottom-color: rgba(26, 42, 82, 0.84);
}

.rcp-rail__signal-bar--need { background-color: rgba(74, 114, 184, 0.66); width: 78%; }
.rcp-rail__signal-bar--plan { background-color: rgba(138, 100, 24, 0.82); width: 64%; }
.rcp-rail__signal-bar--scout { background-color: rgba(43, 82, 52, 0.78); width: 42%; }

.rcp-candidate-stage {
    flex-grow: 1;
    min-width: 620px;
}

.rcp-card-row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    padding-top: 0;
    padding-bottom: 0;
    padding-right: 0;
}

.rcp-card {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 166px;
    max-width: 258px;
    margin-left: 6px;
    margin-right: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 10px;
    background-color: rgba(28, 22, 12, 0.98);
}

.rcp-card--selected {
    background-color: rgba(31, 30, 44, 0.98);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 2px;
    border-bottom-width: 3px;
    border-left-color: rgba(245, 214, 138, 0.92);
    border-right-color: rgba(245, 214, 138, 0.92);
    border-top-color: rgba(255, 236, 174, 0.92);
    border-bottom-color: rgba(200, 147, 42, 0.94);
}

.rcp-card__slot-badge {
    align-self: stretch;
    -unity-text-align: middle-center;
    margin-top: 0;
}

.rcp-card__portrait {
    height: 340px;
    min-height: 280px;
    margin-top: 8px;
    margin-left: 0;
    margin-right: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(28, 22, 12, 0.82);
    overflow: hidden;
}

.rcp-card__portrait-shade,
.rcp-detail__portrait-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.06);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(245, 214, 138, 0.20);
    border-bottom-color: rgba(138, 100, 24, 0.38);
}

.rcp-card__portrait-fallback,
.rcp-detail__portrait-fallback {
    align-self: center;
    margin-top: 86px;
    color: rgba(245, 214, 138, 0.84);
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.rcp-card__rank-pips {
    position: absolute;
    right: 8px;
    bottom: 8px;
    flex-direction: row;
}

.rcp-card--selected .rcp-card__portrait {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(245, 214, 138, 0.76);
    border-right-color: rgba(245, 214, 138, 0.76);
    border-top-color: rgba(255, 236, 174, 0.84);
    border-bottom-color: rgba(200, 147, 42, 0.90);
}

.rcp-card__rank-pip {
    width: 9px;
    height: 9px;
    margin-left: 4px;
    background-color: rgba(216, 199, 153, 0.28);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.rcp-card__rank-pip--filled {
    background-color: var(--sm-gold-100);
}

.rcp-card__name {
    margin-top: 10px;
    font-size: 15px;
    white-space: normal;
}

.rcp-card__meta-row {
    justify-content: center;
    min-height: 24px;
}

.rcp-card__class-glyph,
.rcp-detail__class-glyph {
    background-image: none;
    background-color: rgba(138, 100, 24, 0.82);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.rcp-class-vanguard { background-color: rgba(104, 137, 183, 0.80); }
.rcp-class-duelist { background-color: rgba(162, 88, 74, 0.80); }
.rcp-class-ranger { background-color: rgba(89, 137, 96, 0.80); }
.rcp-class-mystic { background-color: rgba(115, 92, 166, 0.80); }

.rcp-card__skill-icons,
.rcp-detail__skill-pips {
    flex-direction: row;
    justify-content: center;
    margin-top: 9px;
}

.rcp-skill-pip {
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    margin-left: 3px;
    margin-right: 3px;
    background-color: rgba(26, 42, 82, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(127, 163, 224, 0.38);
    border-right-color: rgba(127, 163, 224, 0.38);
    border-top-color: rgba(127, 163, 224, 0.44);
    border-bottom-color: rgba(26, 42, 82, 0.84);
}

.rcp-skill-pip--sig {
    background-color: rgba(138, 100, 24, 0.78);
    border-left-color: rgba(245, 214, 138, 0.42);
    border-right-color: rgba(245, 214, 138, 0.42);
    border-top-color: rgba(245, 214, 138, 0.48);
}

.rcp-skill-pip__slot {
    color: var(--sm-ink-0);
    font-size: 9px;
    -unity-font-style: bold;
}

.rcp-card__skills {
    display: none;
}

.rcp-card__skill-line {
    min-height: 13px;
}

/* card recruit CTA: detail "이 후보 영입" CTA(38px)와 height 통일 — CTA primary weight 일관성 */
.rcp-card__recruit {
    margin-top: auto;
    height: 38px;
}

.rcp-decision-panel {
    width: 322px;
    margin-top: 4px;
    margin-bottom: 4px;
    margin-left: 16px;
    padding: 16px;
}

.rcp-detail {
    padding-bottom: 0;
    border-bottom-width: 0;
}

.rcp-detail__portrait-frame {
    height: 214px;
    margin-bottom: 14px;
    background-color: rgba(28, 22, 12, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.34);
    border-right-color: rgba(230, 183, 81, 0.34);
    border-top-color: rgba(245, 214, 138, 0.34);
    border-bottom-color: rgba(138, 100, 24, 0.58);
    overflow: hidden;
}

.rcp-detail__portrait {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.rcp-detail__class-glyph {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 34px;
    height: 34px;
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
}

.rcp-detail__name {
    font-size: 18px;
    -unity-text-align: middle-center;
}

.rcp-detail__meta,
.rcp-detail__plan,
.rcp-detail__cost {
    -unity-text-align: middle-center;
}

.rcp-detail__metrics {
    margin-top: 12px;
}

.rcp-detail__metric {
    margin-top: 8px;
}

.rcp-detail__metric-head {
    flex-direction: row;
    justify-content: space-between;
}

.rcp-detail__metric-label,
.rcp-detail__metric-value {
    color: rgba(216, 199, 153, 0.84);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.rcp-detail__metric-value {
    color: rgba(127, 163, 224, 0.95);
}

.rcp-detail__metric-track {
    height: 8px;
    margin-top: 4px;
    background-color: rgba(28, 22, 12, 0.78);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(245, 214, 138, 0.16);
    border-bottom-color: rgba(26, 42, 82, 0.82);
}

.rcp-detail__metric-fill {
    height: 100%;
    background-color: rgba(138, 100, 24, 0.86);
}

.rcp-detail__metric--safety .rcp-detail__metric-fill {
    background-color: rgba(74, 114, 184, 0.86);
}

.rcp-detail__metric--signal .rcp-detail__metric-fill {
    background-color: rgba(43, 82, 52, 0.86);
}

.rcp-detail__skills {
    padding-top: 10px;
    font-size: 10px;
    max-height: 48px;
    overflow: hidden;
}

.rcp-detail__tags {
    justify-content: center;
}

/* action bar — frame padding 48이 이미 좌우 inset. 추가 padding 0, justify-content space-around. */
.rcp-actions {
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 0;
    padding-right: 0;
    justify-content: space-around;
}

/* =============================================================
   Wallet strip — 보유 자원 노출 (command strip 안)
   ============================================================= */
.rcp-command-strip__divider {
    width: 1px;
    height: 20px;
    margin-left: 18px;
    margin-right: 18px;
    background-color: rgba(230, 183, 81, 0.32);
}

.rcp-command-strip__wallet {
    margin-left: 18px;
    color: var(--sm-gold-100);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.rcp-command-strip__wallet--gold {
    color: var(--sm-gold-100);
}

.rcp-command-strip__wallet--echo {
    color: rgb(180, 205, 255);
}

/* =============================================================
   Detail panel — identity row (이중 표시 완화: portrait-frame 제거,
   class glyph + name + meta만 가로 배치)
   ============================================================= */
.rcp-detail__identity-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.rcp-detail__identity-text {
    flex-grow: 1;
    margin-left: 12px;
}

.rcp-detail__identity-row .rcp-detail__class-glyph {
    position: relative;
    width: 44px;
    height: 44px;
    right: auto;
    bottom: auto;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.rcp-detail__identity-row .rcp-detail__name {
    -unity-text-align: middle-left;
    font-size: 16px;
}

.rcp-detail__identity-row .rcp-detail__meta {
    -unity-text-align: middle-left;
    margin-top: 2px;
}

/* Cost row — plan label + cost를 한 줄에 (균형) */
.rcp-detail__cost-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-width: 1px;
    border-top-color: rgba(230, 183, 81, 0.18);
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 183, 81, 0.18);
}

.rcp-detail__cost-row .rcp-detail__plan,
.rcp-detail__cost-row .rcp-detail__cost {
    margin-top: 0;
    -unity-text-align: middle-left;
}

.rcp-detail__cost-row .rcp-detail__cost {
    -unity-text-align: middle-right;
}

.rcp-detail__cost--insufficient {
    color: rgb(232, 124, 110);
}

/* Detail RECRUIT button — 액션 흐름 fix (이 panel에서 바로 영입) */
.rcp-detail__recruit {
    margin-top: 14px;
    height: 38px;
    color: rgb(36, 25, 8);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    border-top-color: var(--sm-gold-100);
    border-left-color: var(--sm-gold-300);
    border-right-color: var(--sm-gold-300);
    border-bottom-color: var(--sm-gold-500);
}

.rcp-detail__recruit:disabled {
    opacity: 0.55;
}
