<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!--
      Recruit modal V1 preview surface
      visual SoT: pindoc://town-ui-ux-시안-갤러리-v1 (3. Recruit modal)
      structure: navy frame + ornament header + roster pressure rail + 4 candidate cards + selected candidate decision panel
      카드 컬럼은 runtime offer 모델 (RecruitUnitPreview + RecruitOfferMetadata) 정합 — audit §4.1.
      assets:
        hero portraits (Resources/_Game/Art/Characters/hero_{blueprintId}/portrait_full.png — 12 archetype 중 3장만 존재)
        class icon (Assets/_Game/UI/Foundation/Sprites/Class/)
        currency_gold (Assets/_Game/UI/Foundation/Sprites/Currency/currency_gold.png)
    -->
    <Style src="../../Foundation/Styles/ThemeTokens.uss" />
    <Style src="../../Foundation/Styles/RuntimePanelTheme.uss" />
    <Style src="../../Foundation/USS/foundation_glow.uss" />
    <Style src="RecruitPack.uss" />
    <ui:VisualElement name="RcpRoot" class="rcp-root">
        <ui:VisualElement name="Backdrop" class="rcp-backdrop" picking-mode="Ignore" />
        <ui:VisualElement name="BackdropDim" class="rcp-backdrop-dim" picking-mode="Ignore" />

        <ui:VisualElement name="ModalFrame" class="rcp-frame sm-modal-frame sm-modal-frame--ceremony sm-modal-anim">
            <ui:VisualElement class="sm-modal-frame__texture" picking-mode="Ignore" />
            <ui:VisualElement class="sm-frame-corner-cap sm-frame-corner-cap--tl" picking-mode="Ignore" />
            <ui:VisualElement class="sm-frame-corner-cap sm-frame-corner-cap--tr" picking-mode="Ignore" />
            <ui:VisualElement class="sm-frame-corner-cap sm-frame-corner-cap--bl" picking-mode="Ignore" />
            <ui:VisualElement class="sm-frame-corner-cap sm-frame-corner-cap--br" picking-mode="Ignore" />

            <ui:VisualElement class="rcp-header">
                <ui:VisualElement class="rcp-header__title-block">
                    <ui:VisualElement class="rcp-header__ornament rcp-header__ornament--left" picking-mode="Ignore" />
                    <ui:Label class="rcp-header__title" text="영입" />
                    <ui:VisualElement class="rcp-header__ornament rcp-header__ornament--right" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button class="rcp-header__close sm-cta sm-cta--inline sm-cta--secondary" text="X" />
            </ui:VisualElement>

            <ui:VisualElement class="rcp-command-strip">
                <ui:Label class="rcp-command-strip__label" text="후보 선정" />
                <ui:VisualElement class="rcp-command-strip__divider" picking-mode="Ignore" />
                <ui:Label name="WalletGoldLabel" class="rcp-command-strip__wallet rcp-command-strip__wallet--gold" />
                <ui:Label name="WalletEchoLabel" class="rcp-command-strip__wallet rcp-command-strip__wallet--echo" />
                <ui:Label class="rcp-command-strip__hint" text="후보 4 · 결정 패널" />
            </ui:VisualElement>

            <ui:VisualElement class="rcp-decision-layout">
                <ui:VisualElement name="RosterPressurePanel" class="rcp-pressure rcp-left-rail sm-chrome-l2">
                    <ui:Label class="rcp-rail__eyebrow" text="로스터" />
                    <ui:Label name="RosterPressureCountLabel" class="rcp-pressure__count" />
                    <ui:Label name="RosterPressureNeedLabel" class="rcp-pressure__need" />
                    <ui:Label name="RosterPressurePlanLabel" class="rcp-pressure__plan" />
                    <ui:VisualElement name="RosterNeedChips" class="rcp-pressure__chips" />
                </ui:VisualElement>

                <ui:VisualElement class="rcp-candidate-stage">
                    <ui:VisualElement name="CardRow" class="rcp-card-row" />
                </ui:VisualElement>

                <ui:VisualElement name="RecruitDecisionPanel" class="rcp-decision-panel sm-chrome-l2">
                    <ui:VisualElement name="SelectedCandidateDetail" class="rcp-detail">
                        <!-- 우측 결정 패널의 focal point — 선택 후보 흉상. RenderPortrait가 이 요소에
                             backgroundImage를 세팅(없으면 이니셜 fallback). 그동안 UXML 요소 누락으로
                             _detailPortrait=null → no-op이라 dead CSS였던 frame을 회생. -->
                        <ui:VisualElement class="rcp-detail__portrait-frame">
                            <ui:VisualElement name="SelectedCandidatePortrait" class="rcp-detail__portrait" />
                        </ui:VisualElement>
                        <ui:VisualElement class="rcp-detail__identity-row">
                            <ui:VisualElement name="SelectedCandidateClassGlyph" class="rcp-detail__class-glyph" />
                            <ui:VisualElement class="rcp-detail__identity-text">
                                <ui:Label name="SelectedCandidateNameLabel" class="rcp-detail__name" />
                                <ui:Label name="SelectedCandidateMetaLabel" class="rcp-detail__meta" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="rcp-detail__cost-row">
                            <ui:Label name="SelectedCandidatePlanLabel" class="rcp-detail__plan" />
                            <ui:Label name="SelectedCandidateCostLabel" class="rcp-detail__cost" />
                        </ui:VisualElement>
                        <ui:VisualElement name="SelectedCandidateStateChips" class="rcp-detail__state-row" />
                        <ui:VisualElement name="SelectedCandidateMetricBars" class="rcp-detail__metrics" />
                        <ui:VisualElement name="SelectedCandidateSkillPips" class="rcp-detail__skill-pips" />
                        <ui:Label name="SelectedCandidateSkillLabel" class="rcp-detail__skills" />
                        <ui:VisualElement name="SelectedCandidateTags" class="rcp-detail__tags" />
                        <ui:Button name="SelectedCandidateRecruitButton" class="rcp-detail__recruit sm-cta sm-cta--md sm-cta--primary" text="이 후보 영입" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Action bar — Recruit는 per-card로 옮겼고, action bar는 Scout/Refresh만 -->
            <ui:VisualElement class="rcp-actions">
                <ui:Button class="rcp-actions__scout sm-cta sm-cta--lg sm-cta--secondary">
                    <ui:VisualElement class="rcp-actions__scout-icon" picking-mode="Ignore" />
                    <ui:Label name="ScoutLabel" class="rcp-actions__scout-label" text="SCOUT" />
                </ui:Button>
                <ui:Button class="rcp-actions__refresh sm-cta sm-cta--lg sm-cta--primary">
                    <ui:VisualElement class="rcp-actions__refresh-icon" picking-mode="Ignore" />
                    <ui:Label name="RefreshLabel" class="rcp-actions__refresh-label" text="REFRESH" />
                </ui:Button>
            </ui:VisualElement>

            <ui:VisualElement class="rcp-footer">
                <ui:VisualElement class="rcp-footer__glyph" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
