.pap-frame {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    background-color: var(--sm-bg-0);
}

.pap-col--detail,
.pap-col--equip {
    background-image: none;
    background-color: rgba(18, 24, 52, 0.90);
    border-left-color: rgba(230, 183, 81, 0.20);
    border-right-color: rgba(230, 183, 81, 0.20);
    border-top-color: rgba(230, 183, 81, 0.18);
    border-bottom-color: rgba(230, 183, 81, 0.24);
}

.pap-augment-cell,
.pap-meta-row,
.pap-detail-effect,
.pap-detail-flavor {
    background-image: none;
    background-color: rgba(24, 31, 63, 0.86);
    border-left-color: rgba(230, 183, 81, 0.20);
    border-right-color: rgba(230, 183, 81, 0.20);
    border-top-color: rgba(230, 183, 81, 0.18);
    border-bottom-color: rgba(230, 183, 81, 0.24);
}

.pap-augment-cell--selected,
.pap-augment-cell--equipped {
    background-image: none;
}

.pap-augment-cell--locked {
    background-image: none;
}

.pap-augment-cell__icon,
.pap-equip-slot {
    background-image: none;
    background-color: rgba(8, 12, 28, 0.62);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(245, 214, 138, 0.22);
    border-right-color: rgba(245, 214, 138, 0.22);
    border-top-color: rgba(245, 214, 138, 0.20);
    border-bottom-color: rgba(245, 214, 138, 0.28);
}

.pap-header__close {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Button/ui_button_dark.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.34;
}

.pap-equip-cta {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Button/ui_button_gold.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.34;
}
