<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Inventory tab V1 (시안 갤러리 #6) — audit §4.1 P1-3
         currency header (Gold/Echo) / 4 category sidebar (ALL + 3 slot) / item grid / selected item detail (affix 이름+범위) -->
    <Style src="../../Foundation/Styles/ThemeTokens.uss" />
    <Style src="../../Foundation/Styles/RuntimePanelTheme.uss" />
    <Style src="../../Foundation/USS/foundation_glow.uss" />
    <Style src="../../Foundation/USS/common_detail.uss" />
    <Style src="InventoryTab.uss" />
    <ui:VisualElement name="InvRoot" class="inv-root">
        <ui:VisualElement class="inv-backdrop" picking-mode="Ignore" />
        <ui:VisualElement class="inv-backdrop-dim" picking-mode="Ignore" />

        <ui:VisualElement class="inv-frame sm-modal-anim">
            <!-- wave-39 chrome cleanup: parchment frame + texture + corner caps 제거 (책임 매트릭스 §5 chrome budget) -->

            <!-- Top currency header -->
            <ui:VisualElement class="inv-currency-header">
                <ui:VisualElement class="inv-title-block">
                    <ui:Label name="InventoryTitleLabel" class="inv-title-block__title" text="장비 비교" />
                    <ui:Label name="InventorySubtitleLabel" class="inv-title-block__subtitle" text="선택 장비와 대상 영웅의 현재 장비를 비교합니다." />
                </ui:VisualElement>
                <ui:VisualElement class="inv-currency">
                    <ui:VisualElement name="GoldIcon" class="inv-currency__icon inv-currency__icon--gold" picking-mode="Ignore" />
                    <ui:Label class="inv-currency__amount" text="9,876,543" />
                </ui:VisualElement>
                <ui:VisualElement class="inv-currency">
                    <ui:VisualElement name="EchoIcon" class="inv-currency__icon inv-currency__icon--echo" picking-mode="Ignore" />
                    <ui:Label class="inv-currency__amount" text="543,210" />
                </ui:VisualElement>
                <ui:Button class="inv-currency__close sm-cta sm-cta--inline sm-cta--secondary" text="X" />
            </ui:VisualElement>

            <ui:VisualElement class="inv-body">
                <!-- Left sidebar (5 categories) -->
                <ui:VisualElement name="CategorySidebar" class="inv-sidebar" />

                <!-- Center 5x4 grid -->
                <ui:VisualElement class="inv-main">
                    <ui:VisualElement class="inv-main__filter-row">
                        <ui:VisualElement class="inv-main__filter-glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="inv-main__filter-glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="inv-main__filter-glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="inv-main__filter-glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="inv-main__filter-glyph" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:ScrollView name="ItemGridScroll" class="inv-grid-scroll" mode="Vertical">
                        <ui:VisualElement name="ItemGrid" class="inv-grid" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- Right detail panel -->
                <ui:VisualElement class="inv-detail sm-cd-panel">
                    <ui:VisualElement name="DetailIcon" class="inv-detail__icon sm-cd-icon" picking-mode="Ignore" />
                    <ui:VisualElement class="inv-detail__name-bar">
                        <ui:VisualElement class="inv-detail__name-glyph" picking-mode="Ignore" />
                        <ui:VisualElement class="inv-detail__name-copy">
                            <ui:Label name="DetailNameLabel" class="inv-detail__name sm-cd-title" />
                            <ui:Label name="DetailMetaLabel" class="inv-detail__meta sm-cd-meta" />
                            <ui:Label name="DetailSetBonusLabel" class="inv-detail__set sm-cd-body-text" />
                            <ui:VisualElement name="DetailCrossLinks" class="inv-detail__links sm-cd-tag-row" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="DetailAffixes" class="inv-detail__affixes" />
                    <ui:VisualElement class="inv-detail__rune-track" picking-mode="Ignore">
                        <ui:VisualElement class="inv-detail__rune inv-detail__rune--on" />
                        <ui:VisualElement class="inv-detail__rune inv-detail__rune--on" />
                        <ui:VisualElement class="inv-detail__rune inv-detail__rune--on" />
                        <ui:VisualElement class="inv-detail__rune" />
                        <ui:VisualElement class="inv-detail__rune" />
                    </ui:VisualElement>
                    <ui:VisualElement class="inv-detail__owner">
                        <ui:VisualElement class="inv-detail__owner-icon" picking-mode="Ignore" />
                        <ui:VisualElement class="inv-detail__owner-glyph" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <!-- equip / compare — sell은 runtime API 부재로 제거 (audit §4.1 P1-3) -->
                    <ui:VisualElement class="inv-detail__buttons">
                        <ui:Button class="inv-detail__btn inv-detail__btn--equip sm-cta sm-cta--inline sm-cta--primary">
                            <ui:VisualElement class="inv-detail__btn-glyph" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button class="inv-detail__btn inv-detail__btn--compare sm-cta sm-cta--inline sm-cta--secondary">
                            <ui:VisualElement class="inv-detail__btn-glyph" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="CompareLane" class="inv-compare sm-chrome-l2">
                    <ui:VisualElement class="inv-compare__target">
                        <ui:Label name="CompareTargetHeroLabel" class="inv-compare__target-name sm-cd-title" />
                        <ui:Label name="CompareTargetMetaLabel" class="inv-compare__target-meta sm-cd-meta" />
                    </ui:VisualElement>
                    <ui:VisualElement class="inv-compare__cards">
                        <ui:VisualElement class="inv-compare__card inv-compare__card--selected">
                            <ui:VisualElement name="CompareSelectedItemIcon" class="inv-compare__card-icon sm-item-icon" picking-mode="Ignore" />
                            <ui:VisualElement class="inv-compare__card-copy">
                                <ui:Label name="CompareSelectedItemLabel" class="inv-compare__card-title sm-cd-body-text" />
                                <ui:Label name="CompareSelectedItemMetaLabel" class="inv-compare__card-meta sm-cd-meta" />
                            </ui:VisualElement>
                            <ui:Label name="CompareOwnerLabel" class="inv-compare__owner sm-cd-meta" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inv-compare__card inv-compare__card--equipped">
                            <ui:VisualElement name="CompareEquippedItemIcon" class="inv-compare__card-icon sm-item-icon" picking-mode="Ignore" />
                            <ui:VisualElement class="inv-compare__card-copy">
                                <ui:Label name="CompareEquippedItemLabel" class="inv-compare__card-title sm-cd-body-text" />
                                <ui:Label name="CompareEquippedItemMetaLabel" class="inv-compare__card-meta sm-cd-meta" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="CompareRows" class="inv-compare__rows" />
                    <ui:VisualElement class="inv-compare__delta-legend" picking-mode="Ignore">
                        <ui:VisualElement class="inv-compare__delta-chip inv-compare__delta-chip--gain" />
                        <ui:Label name="CompareDeltaGainLabel" class="inv-compare__delta-label" text="상승" />
                        <ui:VisualElement class="inv-compare__delta-chip inv-compare__delta-chip--change" />
                        <ui:Label name="CompareDeltaChangeLabel" class="inv-compare__delta-label" text="변경" />
                        <ui:VisualElement class="inv-compare__delta-chip inv-compare__delta-chip--same" />
                        <ui:Label name="CompareDeltaSameLabel" class="inv-compare__delta-label" text="유지" />
                    </ui:VisualElement>
                    <ui:Label name="CompareEquipStatusLabel" class="inv-compare__status sm-cd-body-text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
