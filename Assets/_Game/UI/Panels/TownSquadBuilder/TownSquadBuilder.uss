.sm-sqb-modal__panel {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    background-color: var(--sm-bg-0);
}

.sm-sqb-modal__section {
    background-image: none;
    background-color: rgba(24, 31, 63, 0.86);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.18);
    border-right-color: rgba(230, 183, 81, 0.18);
    border-top-color: rgba(230, 183, 81, 0.16);
    border-bottom-color: rgba(230, 183, 81, 0.24);
    padding-left: var(--sm-s-4);
    padding-right: var(--sm-s-4);
    padding-top: var(--sm-s-4);
    padding-bottom: var(--sm-s-4);
}

.sm-sqb-modal__divider {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Divider/ui_divider_horizontal_diamond.png");
    -unity-background-scale-mode: scale-to-fit;
}

.sm-sqb-modal__close {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Button/ui_close_button.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Bible visual pass: dense formation board + roster cards. */
.sm-sqb-modal {
    padding-top: 40px;
    padding-bottom: 40px;
}

.sm-sqb-modal__panel {
    width: 1660px;
    height: 830px;
    padding-left: 38px;
    padding-right: 38px;
    padding-top: 26px;
    padding-bottom: 24px;
    background-image: none;
    background-color: #020510;
}

.sm-sqb-modal__header {
    height: 84px;
    padding-bottom: 8px;
}

.sm-sqb-modal__title {
    font-size: 31px;
    color: var(--sm-gold-100);
}

.sm-sqb-modal__divider {
    height: 14px;
    margin-bottom: 10px;
}

.sm-sqb-modal__body {
    min-height: 480px;
    height: 480px;
    margin-bottom: 12px;
}

.sm-sqb-modal__section {
    background-color: rgb(8, 12, 30);
    overflow: hidden;
}

.sm-sqb-modal__section--roster {
    width: 330px;
    margin-right: 16px;
}

.sm-sqb-modal__section--formation {
    flex-grow: 1;
    margin-right: 16px;
}

.sm-sqb-modal__section--detail {
    width: 300px;
}

.sm-sqb-modal__section-title {
    font-size: 15px;
    color: var(--sm-gold-200);
}

.sm-sqb-modal__hint {
    font-size: 10px;
    margin-bottom: 8px;
}

.sm-sqb-modal__section-tabs {
    height: 30px;
    flex-direction: row;
    margin-bottom: 8px;
}

.sm-sqb-modal__section-tab {
    min-width: 84px;
    margin-right: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: var(--sm-ink-3);
    background-color: rgba(10, 17, 40, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.18);
    border-right-color: rgba(230, 183, 81, 0.18);
    border-top-color: rgba(230, 183, 81, 0.16);
    border-bottom-color: rgba(230, 183, 81, 0.24);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.sm-sqb-modal__section-tab--active {
    color: var(--sm-gold-100);
    background-color: rgba(54, 42, 23, 0.88);
}

.sm-sqb-modal__roster-list {
    flex-grow: 1;
    overflow: hidden;
}

.sm-sqb-modal__roster-row {
    height: 40px;
    min-height: 40px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgb(11, 17, 39);
}

.sm-sqb-modal__roster-icon {
    width: 30px;
    height: 30px;
    margin-right: 9px;
    color: rgb(130, 185, 245);
    font-size: 20px;
    -unity-text-align: middle-center;
    background-color: rgba(12, 18, 42, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.24);
    border-right-color: rgba(230, 183, 81, 0.24);
    border-top-color: rgba(245, 214, 138, 0.22);
    border-bottom-color: rgba(138, 100, 24, 0.38);
}

.sm-sqb-modal__roster-row--deployed .sm-sqb-modal__roster-icon {
    color: var(--sm-gold-100);
}

.sm-sqb-modal__roster-copy {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.sm-sqb-modal__roster-name {
    font-size: 12px;
    color: var(--sm-vellum);
}

.sm-sqb-modal__roster-meta {
    font-size: 9px;
    color: var(--sm-ink-3);
    margin-top: 1px;
}

.sm-sqb-modal__roster-pips {
    flex-direction: row;
    margin-top: 3px;
}

.sm-sqb-modal__roster-pip {
    width: 5px;
    height: 5px;
    margin-right: 4px;
    background-color: rgba(28, 36, 68, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.18);
    border-right-color: rgba(230, 183, 81, 0.18);
    border-top-color: rgba(230, 183, 81, 0.18);
    border-bottom-color: rgba(230, 183, 81, 0.18);
    rotate: 45deg;
}

.sm-sqb-modal__roster-pip--on {
    background-color: var(--sm-gold-300);
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-100);
}

.sm-sqb-modal__anchor-grid {
    flex-grow: 1;
    padding-top: 16px;
    padding-bottom: 12px;
}

.sm-sqb-modal__anchor-column {
    margin-left: 10px;
    margin-right: 10px;
}

.sm-sqb-modal__column-title {
    font-size: 13px;
    margin-bottom: 10px;
    color: var(--sm-gold-200);
}

.sm-sqb-modal__anchor-button {
    min-height: 98px;
    height: 98px;
    margin-bottom: 12px;
    font-size: 13px;
    line-height: 16px;
    background-color: rgb(9, 15, 36);
}

.sm-sqb-modal__anchor-button--selected {
    background-color: rgba(54, 42, 23, 0.88);
}

.sm-sqb-modal__detail-name {
    font-size: 24px;
    margin-bottom: 12px;
}

.sm-sqb-modal__detail-meta {
    font-size: 12px;
    line-height: 15px;
}

.sm-sqb-modal__detail-body {
    font-size: 12px;
    line-height: 15px;
}

.sm-sqb-modal__tag {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Input/ui_input_bg.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.4;
}

.sm-sqb-modal__posture-row {
    height: 92px;
    flex-direction: row;
    flex-wrap: wrap;
}

.sm-sqb-modal__posture-button {
    min-width: 132px;
    min-height: 34px;
    height: 34px;
    margin-right: 8px;
    margin-bottom: 8px;
    font-size: 12px;
    background-color: rgba(14, 21, 45, 0.88);
}

.sm-sqb-modal__posture-button--selected {
    background-color: rgba(64, 48, 24, 0.92);
    color: var(--sm-gold-100);
}

.sm-sqb-modal__decision-row {
    height: 148px;
    flex-direction: row;
    margin-bottom: 8px;
}

.sm-sqb-modal__section--posture {
    width: 600px;
    margin-right: 14px;
}

.sm-sqb-modal__section--operation {
    flex-grow: 1;
    margin-right: 14px;
}

.sm-sqb-modal__section--response {
    width: 320px;
}

.sm-sqb-modal__operation-rows {
    flex-grow: 0;
    margin-top: 8px;
}

.sm-sqb-modal__operation-row {
    height: 18px;
    min-height: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 183, 81, 0.12);
}

.sm-sqb-modal__operation-key {
    width: 88px;
    color: var(--sm-ink-3);
    font-size: 10px;
}

.sm-sqb-modal__operation-value {
    flex-grow: 1;
    color: var(--sm-vellum);
    font-size: 10px;
    -unity-text-align: middle-right;
}

.sm-sqb-modal__response-summary {
    font-size: 11px;
    line-height: 14px;
    color: var(--sm-ink-2);
    white-space: normal;
}

.sm-sqb-modal__synergy-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 9px;
}
