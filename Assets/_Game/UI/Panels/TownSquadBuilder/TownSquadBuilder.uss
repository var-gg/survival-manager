.sm-sqb-modal__panel {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    /* sepia 통합 (다른 production panel과 동일 mood). 기존 var(--sm-bg-0) navy는 cross-panel drift 원인. */
    background-color: rgba(28, 22, 12, 0.92);
}

.sm-sqb-modal__section {
    /* wave-test-cleanup: art bible AB001_FORBIDDEN_INNER_ORNATE_CHROME 정책 위반. inner panel frame image 폐기. */
    background-image: none;
    background-color: rgba(28, 22, 12, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.34);
    border-right-color: rgba(230, 183, 81, 0.34);
    border-top-color: rgba(230, 183, 81, 0.28);
    border-bottom-color: rgba(230, 183, 81, 0.48);
    padding-left: var(--sm-s-4);
    padding-right: var(--sm-s-4);
    padding-top: var(--sm-s-4);
    padding-bottom: var(--sm-s-4);
}

.sm-sqb-modal__divider {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Divider/ui_divider_horizontal_diamond.png");
    -unity-background-scale-mode: scale-to-fit;
}

.sm-sqb-modal__close {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Button/ui_close_button.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Bible visual pass: dense formation board + roster cards. */
.sm-sqb-modal {
    padding-top: 20px;
    padding-bottom: 20px;
}

.sm-sqb-modal__panel {
    width: 1840px;
    height: 940px;
    padding-left: 46px;
    padding-right: 46px;
    padding-top: 32px;
    padding-bottom: 28px;
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.36;
    -unity-background-image-tint-color: rgba(255, 235, 200, 0.32);
    background-color: rgb(18, 14, 8);
}

.sm-sqb-modal__header {
    height: 76px;
    padding-bottom: 4px;
}

.sm-sqb-modal__title {
    font-size: 34px;
    color: var(--sm-gold-100);
}

.sm-sqb-modal__divider {
    height: 14px;
    margin-bottom: 10px;
}

.sm-sqb-modal__body {
    min-height: 535px;
    height: 535px;
    margin-bottom: 14px;
}

.sm-sqb-modal__section {
    background-color: rgb(28, 22, 12);
    overflow: hidden;
}

.sm-sqb-modal__section--roster {
    width: 430px;
    margin-right: 18px;
}

.sm-sqb-modal__section--formation {
    flex-grow: 1;
    margin-right: 18px;
}

.sm-sqb-modal__section--detail {
    width: 340px;
}

.sm-sqb-modal__section-title {
    font-size: 15px;
    color: var(--sm-gold-200);
}

.sm-sqb-modal__hint {
    font-size: 10px;
    margin-bottom: 8px;
}

.sm-sqb-modal__section-tabs {
    height: 30px;
    flex-direction: row;
    margin-bottom: 8px;
}

.sm-sqb-modal__section-tab {
    min-width: 84px;
    margin-right: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: var(--sm-ink-3);
    background-color: rgba(28, 22, 12, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.18);
    border-right-color: rgba(230, 183, 81, 0.18);
    border-top-color: rgba(230, 183, 81, 0.16);
    border-bottom-color: rgba(230, 183, 81, 0.24);
    font-size: var(--sm-fs-s);
    -unity-text-align: middle-center;
}

.sm-sqb-modal__section-tab--active {
    color: var(--sm-gold-100);
    background-color: rgba(54, 42, 23, 0.88);
}

.sm-sqb-modal__roster-list {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    overflow: hidden;
}

.sm-sqb-modal__roster-row {
    width: 124px;
    height: 126px;
    min-height: 126px;
    flex-direction: column;
    align-items: stretch;
    margin-right: 8px;
    margin-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgb(28, 22, 12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.36);
    border-right-color: rgba(230, 183, 81, 0.28);
    border-top-color: rgba(245, 214, 138, 0.30);
    border-bottom-color: rgba(138, 100, 24, 0.46);
}

.sm-sqb-modal__roster-icon {
    width: 100%;
    height: 46px;
    margin-right: 0;
    margin-bottom: 7px;
    color: rgb(130, 185, 245);
    font-size: 26px;
    -unity-text-align: middle-center;
    background-color: rgb(28, 22, 12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.24);
    border-right-color: rgba(230, 183, 81, 0.24);
    border-top-color: rgba(245, 214, 138, 0.22);
    border-bottom-color: rgba(138, 100, 24, 0.38);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(180, 205, 255, 0.68);
}

/* 실제 흉상 연결 시 — class 아이콘용 scale-to-fit/파란 tint를 끄고 얼굴을 꽉 채워 crop. */
.sm-sqb-modal__roster-icon--art {
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(20, 16, 10);
}

.sm-sqb-modal__roster-row--deployed .sm-sqb-modal__roster-icon {
    color: var(--sm-gold-100);
}

.sm-sqb-modal__roster-copy {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
}

.sm-sqb-modal__roster-name {
    font-size: var(--sm-fs-eb);
    color: var(--sm-vellum);
    -unity-text-align: middle-center;
}

.sm-sqb-modal__roster-meta {
    font-size: 7px;
    color: var(--sm-ink-3);
    margin-top: 4px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.sm-sqb-modal__roster-pips {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.sm-sqb-modal__roster-pip {
    width: 5px;
    height: 5px;
    margin-right: 4px;
    background-color: rgba(28, 36, 68, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.18);
    border-right-color: rgba(230, 183, 81, 0.18);
    border-top-color: rgba(230, 183, 81, 0.18);
    border-bottom-color: rgba(230, 183, 81, 0.18);
    rotate: 45deg;
}

.sm-sqb-modal__roster-pip--on {
    background-color: var(--sm-gold-300);
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-100);
}

.sm-sqb-modal__anchor-grid {
    flex-grow: 1;
    padding-top: 14px;
    padding-bottom: 8px;
}

.sm-sqb-modal__anchor-column {
    flex-grow: 1;
    margin-left: 10px;
    margin-right: 10px;
}

.sm-sqb-modal__column-title {
    font-size: 13px;
    margin-bottom: 10px;
    color: var(--sm-gold-200);
}

.sm-sqb-modal__anchor-button {
    min-height: 160px;
    height: 160px;
    margin-bottom: 14px;
    font-size: 0;
    line-height: 17px;
    background-color: rgb(28, 22, 12);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.sm-sqb-modal__anchor-button--selected {
    background-color: rgba(54, 42, 23, 0.88);
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-200);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

/* wave-29 GPT Pro patch: anchor state hierarchy.
   --empty는 dim + plus glyph 느낌, --occupied는 normal + 약한 gold tint. */
.sm-sqb-modal__anchor-button--empty {
    opacity: 0.48;
    background-color: rgba(28, 22, 12, 0.62);
}

.sm-sqb-modal__anchor-button--occupied {
    background-color: rgba(40, 30, 14, 0.92);
    border-left-color: rgba(230, 183, 81, 0.42);
    border-right-color: rgba(230, 183, 81, 0.42);
    border-top-color: rgba(230, 183, 81, 0.36);
    border-bottom-color: rgba(230, 183, 81, 0.52);
}

.sm-sqb-modal__anchor-card--occupied {
    /* occupied anchor는 portrait token이 위에 올라가는 컨테이너. opacity full + subtle frame. */
    opacity: 1;
}

.sm-sqb-modal__anchor-card {
    flex-grow: 1;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
}

.sm-sqb-modal__anchor-card--front {
    border-top-width: 3px;
    border-top-color: rgba(103, 160, 238, 0.78);
}

.sm-sqb-modal__anchor-card--back {
    border-bottom-width: 3px;
    border-bottom-color: rgba(218, 74, 67, 0.62);
}

.sm-sqb-modal__anchor-card--empty {
    opacity: 0.62;
}

.sm-sqb-modal__anchor-badge {
    position: absolute;
    top: -4px;
    left: 8px;
    min-width: 42px;
    height: 20px;
    padding-left: 5px;
    padding-right: 5px;
    color: rgb(245, 214, 138);
    background-color: rgba(28, 22, 12, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.42);
    border-right-color: rgba(230, 183, 81, 0.42);
    border-top-color: rgba(245, 214, 138, 0.46);
    border-bottom-color: rgba(138, 100, 24, 0.54);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.sm-sqb-modal__anchor-portrait {
    width: 80px;
    height: 76px;
    margin-top: 8px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgb(28, 22, 12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-left-color: rgba(230, 183, 81, 0.34);
    border-right-color: rgba(230, 183, 81, 0.34);
    border-top-color: rgba(245, 214, 138, 0.32);
    border-bottom-color: rgba(138, 100, 24, 0.56);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(170, 205, 255, 0.72);
}

/* 실제 흉상 연결 시 — 편성 보드 앵커에 얼굴을 꽉 채워 crop(누가 어디 있는지 식별). */
.sm-sqb-modal__anchor-portrait--art {
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(20, 16, 10);
}

.sm-sqb-modal__anchor-glyph {
    flex-grow: 1;
    width: 100%;
    color: rgba(245, 214, 138, 0.92);
    font-size: var(--sm-fs-xl);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.sm-sqb-modal__anchor-name {
    width: 100%;
    flex-grow: 0;
    color: var(--sm-vellum);
    font-size: var(--sm-fs-m);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.sm-sqb-modal__anchor-role {
    width: 100%;
    color: var(--sm-ink-3);
    font-size: 10px;
    margin-top: 3px;
    -unity-text-align: middle-center;
}

.sm-sqb-modal__anchor-pips {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    flex-direction: row;
    justify-content: center;
}

.sm-sqb-modal__anchor-pip {
    width: 6px;
    height: 6px;
    margin-right: 5px;
    rotate: 45deg;
    background-color: rgba(35, 42, 72, 0.86);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.18);
    border-right-color: rgba(230, 183, 81, 0.18);
    border-top-color: rgba(230, 183, 81, 0.18);
    border-bottom-color: rgba(230, 183, 81, 0.18);
}

.sm-sqb-modal__anchor-pip--on {
    background-color: var(--sm-gold-300);
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-100);
}

.sm-sqb-modal__class-icon--vanguard {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_vanguard.png");
}

.sm-sqb-modal__class-icon--duelist {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_duelist.png");
}

.sm-sqb-modal__class-icon--ranger {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_ranger.png");
}

.sm-sqb-modal__class-icon--mystic {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_mystic.png");
}

.sm-sqb-modal__detail-name {
    font-size: var(--sm-fs-3xl);
    margin-bottom: 16px;
}

.sm-sqb-modal__detail-meta {
    font-size: var(--sm-fs-s);
    line-height: 16px;
    margin-bottom: 14px;
}

.sm-sqb-modal__detail-body {
    font-size: var(--sm-fs-s);
    line-height: 16px;
    margin-bottom: 16px;
}

.sm-sqb-modal__tag {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Input/ui_input_bg.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.4;
}

.sm-sqb-modal__posture-row {
    height: 82px;
    flex-direction: row;
    flex-wrap: wrap;
}

.sm-sqb-modal__posture-button {
    min-width: 132px;
    min-height: 34px;
    height: 34px;
    margin-right: 8px;
    margin-bottom: 8px;
    font-size: var(--sm-fs-s);
    background-color: rgba(28, 22, 12, 0.88);
}

.sm-sqb-modal__posture-button--selected {
    background-color: rgba(64, 48, 24, 0.92);
    color: var(--sm-gold-100);
}

.sm-sqb-modal__decision-row {
    height: 170px;
    flex-direction: row;
    margin-bottom: 8px;
}

.sm-sqb-modal__section--posture {
    width: 620px;
    margin-right: 16px;
}

.sm-sqb-modal__section--operation {
    flex-grow: 1;
    margin-right: 16px;
}

.sm-sqb-modal__section--response {
    width: 360px;
}

.sm-sqb-modal__operation-rows {
    flex-grow: 0;
    margin-top: 8px;
}

.sm-sqb-modal__operation-row {
    height: 24px;
    min-height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 183, 81, 0.12);
}

.sm-sqb-modal__operation-key {
    width: 88px;
    color: var(--sm-ink-3);
    font-size: 10px;
}

.sm-sqb-modal__operation-value {
    flex-grow: 1;
    color: var(--sm-vellum);
    font-size: var(--sm-fs-eb);
    -unity-text-align: middle-right;
}

.sm-sqb-modal__response-summary {
    font-size: var(--sm-fs-eb);
    line-height: 14px;
    color: var(--sm-ink-2);
    white-space: normal;
}

.sm-sqb-modal__synergy-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 9px;
}

/* UX Bible 80 pass — make Tactical Setup read as one dense tactical console. */
.sm-sqb-modal__panel {
    background-color: rgb(28, 22, 12);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(230, 183, 81, 0.30);
    border-right-color: rgba(230, 183, 81, 0.30);
    border-top-color: rgba(245, 214, 138, 0.28);
    border-bottom-color: rgba(138, 100, 24, 0.50);
}

.sm-sqb-modal__section {
    background-color: rgba(28, 22, 12, 0.94);
    border-bottom-color: rgba(138, 100, 24, 0.42);
}

.sm-sqb-modal__section--formation {
    /* sepia 통합 (formation board base). 기존 navy(5,10,25,0.96)는 cross-panel drift. */
    background-color: rgba(28, 22, 12, 0.94);
}

.sm-sqb-modal__roster-row {
    width: 128px;
    height: 132px;
    min-height: 132px;
    background-color: rgba(28, 22, 12, 0.96);
}

.sm-sqb-modal__roster-row--deployed {
    background-color: rgba(46, 34, 16, 0.92);
    border-left-color: rgba(245, 214, 138, 0.62);
    border-top-color: rgba(245, 214, 138, 0.54);
}

.sm-sqb-modal__roster-icon {
    height: 54px;
    background-color: rgba(28, 22, 12, 0.98);
}

.sm-sqb-modal__anchor-grid {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
}

.sm-sqb-modal__anchor-column {
    margin-left: 12px;
    margin-right: 12px;
}

.sm-sqb-modal__anchor-button {
    min-height: 168px;
    height: 168px;
    margin-bottom: 16px;
    background-color: rgba(28, 22, 12, 0.98);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(230, 183, 81, 0.26);
    border-right-color: rgba(230, 183, 81, 0.26);
    border-top-color: rgba(245, 214, 138, 0.24);
    border-bottom-color: rgba(138, 100, 24, 0.46);
}

.sm-sqb-modal__anchor-button--selected {
    background-color: rgba(58, 42, 18, 0.94);
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-300);
}

.sm-sqb-modal__anchor-card--front {
    background-color: rgba(28, 22, 12, 0.56);
}

.sm-sqb-modal__anchor-card--back {
    background-color: rgba(35, 16, 22, 0.46);
}

.sm-sqb-modal__anchor-portrait {
    width: 96px;
    height: 84px;
    margin-top: 10px;
    background-color: rgba(28, 22, 12, 0.98);
    border-top-color: rgba(245, 214, 138, 0.42);
}

.sm-sqb-modal__anchor-glyph {
    font-size: 30px;
}

.sm-sqb-modal__detail-name {
    color: var(--sm-gold-100);
}

.sm-sqb-modal__detail-meta,
.sm-sqb-modal__detail-body,
.sm-sqb-modal__response-summary {
    color: var(--sm-ink-1);
}

.sm-sqb-modal__posture-button {
    min-width: 142px;
    height: 38px;
    min-height: 38px;
    border-bottom-color: rgba(138, 100, 24, 0.42);
}

.sm-sqb-modal__operation-row {
    height: 28px;
    min-height: 28px;
    background-color: rgba(28, 22, 12, 0.48);
    padding-left: 6px;
    padding-right: 6px;
}

/* UX Bible visual QA pass 2: reinforce the formation board as a command map behind real anchor buttons. */
.sm-sqb-modal__section--formation {
    position: relative;
}

.sm-sqb-modal__formation-compass {
    position: absolute;
    left: 48px;
    right: 48px;
    top: 84px;
    bottom: 34px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.16);
    border-right-color: rgba(230, 183, 81, 0.16);
    border-top-color: rgba(245, 214, 138, 0.14);
    border-bottom-color: rgba(138, 100, 24, 0.26);
    background-color: rgba(28, 22, 12, 0.28);
}

.sm-sqb-modal__formation-line {
    position: absolute;
    left: 28px;
    right: 28px;
    height: 2px;
    background-color: rgba(230, 183, 81, 0.18);
}

.sm-sqb-modal__formation-line--top {
    top: 28%;
}

.sm-sqb-modal__formation-line--middle {
    top: 50%;
    background-color: rgba(129, 184, 245, 0.16);
}

.sm-sqb-modal__formation-line--bottom {
    top: 72%;
    background-color: rgba(235, 116, 91, 0.14);
}

.sm-sqb-modal__anchor-grid {
    position: relative;
}

.sm-sqb-modal__anchor-name {
    font-size: 15px;
}

.sm-sqb-modal__anchor-role {
    font-size: 10px;
    color: var(--sm-ink-2);
}
