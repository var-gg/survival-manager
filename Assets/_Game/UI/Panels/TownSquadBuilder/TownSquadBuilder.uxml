<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!--
      Tactical Setup modal — legacy TownSquadBuilder implementation alias.
      V1 production owner: anchor 6 + team posture 5 + read-only operation / response summary.
      Foundation atom (RuntimePanelTheme.uss) — sm-backdrop-dim + sm-frame-corner-cap × 4 +
      sm-ornament-divider + sm-cta + sm-modal-anim.
    -->
    <Style src="../../Foundation/Styles/ThemeTokens.uss" />
    <Style src="../../Foundation/Styles/RuntimePanelTheme.uss" />
    <Style src="../../Foundation/USS/foundation_glow.uss" />
    <Style src="../../Screens/Town/SquadBuilder.uss" />
    <Style src="TownSquadBuilder.uss" />
    <ui:VisualElement name="SquadBuilderRoot" class="sm-sqb-modal sm-sqb-modal--closed sm-modal-anim sm-modal-anim--enter" picking-mode="Position">
        <ui:VisualElement class="sm-backdrop-dim sm-sqb-modal__backdrop" picking-mode="Position" />
        <ui:VisualElement class="sm-sqb-modal__panel">
            <ui:VisualElement class="sm-frame-corner-cap sm-frame-corner-cap--tl" picking-mode="Ignore" />
            <ui:VisualElement class="sm-frame-corner-cap sm-frame-corner-cap--tr" picking-mode="Ignore" />
            <ui:VisualElement class="sm-frame-corner-cap sm-frame-corner-cap--bl" picking-mode="Ignore" />
            <ui:VisualElement class="sm-frame-corner-cap sm-frame-corner-cap--br" picking-mode="Ignore" />

            <ui:VisualElement class="sm-sqb-modal__header">
                <ui:VisualElement class="sm-sqb-modal__title-group">
                    <ui:Label name="SquadBuilderEyebrowLabel" class="sm-eyebrow sm-sqb-modal__eyebrow" text="TACTICAL SETUP" />
                    <ui:Label name="SquadBuilderTitleLabel" class="sm-headline sm-sqb-modal__title" text="전술 설정" />
                </ui:VisualElement>
                <ui:Button name="SquadBuilderCloseButton" class="ui-button sm-cta sm-cta--inline sm-cta--secondary sm-sqb-modal__close" text="✕" />
            </ui:VisualElement>
            <ui:VisualElement name="TacticalSetupSectionTabs" class="sm-sqb-modal__section-tabs">
                <ui:Label name="TacticalSetupFormationTab" class="sm-sqb-modal__section-tab sm-sqb-modal__section-tab--active" text="전열" />
                <ui:Label name="TacticalSetupPostureTab" class="sm-sqb-modal__section-tab" text="팀 태세" />
                <ui:Label name="TacticalSetupOperationTab" class="sm-sqb-modal__section-tab" text="운용" />
                <ui:Label name="TacticalSetupResponseTab" class="sm-sqb-modal__section-tab" text="대응" />
            </ui:VisualElement>
            <ui:VisualElement class="sm-ornament-divider sm-sqb-modal__divider" picking-mode="Ignore" />

            <ui:VisualElement name="SquadBuilderThreeZoneLayout" class="sm-sqb-modal__body">
                <ui:VisualElement name="SquadBuilderRosterRail" class="sm-sqb-modal__section sm-sqb-modal__section--roster">
                    <ui:VisualElement class="sm-sqb-modal__section-header">
                        <ui:Label class="sm-sqb-modal__section-title" text="동료 명부" />
                        <ui:Label name="SquadBuilderRosterCountLabel" class="sm-sqb-modal__count" text="· 0" />
                    </ui:VisualElement>
                    <ui:Label class="sm-sqb-modal__hint" text="원정 후보와 현재 배치 상태" />
                    <ui:VisualElement name="SquadBuilderRosterList" class="sm-sqb-modal__roster-list" />
                </ui:VisualElement>

                <ui:VisualElement name="SquadBuilderFormationBoard" class="sm-sqb-modal__section sm-sqb-modal__section--formation">
                    <ui:Label name="TacticalSetupFormationSection" class="sm-sqb-modal__section-title" text="전열" />
                    <ui:Label name="SquadBuilderAnchorHint" class="sm-sqb-modal__hint" text="버튼을 누르면 다음 영웅으로 순환합니다." />
                    <ui:VisualElement class="sm-sqb-modal__anchor-grid">
                        <ui:VisualElement class="sm-sqb-modal__anchor-column">
                            <ui:Label class="sm-sqb-modal__column-title" text="상단" />
                            <ui:Button name="SquadBuilderAnchor_FrontTop" class="ui-button sm-cta sm-cta--md sm-cta--secondary sm-select-snap sm-sqb-modal__anchor-button" />
                            <ui:Button name="SquadBuilderAnchor_BackTop" class="ui-button sm-cta sm-cta--md sm-cta--secondary sm-select-snap sm-sqb-modal__anchor-button" />
                        </ui:VisualElement>
                        <ui:VisualElement class="sm-sqb-modal__anchor-column">
                            <ui:Label class="sm-sqb-modal__column-title" text="중앙" />
                            <ui:Button name="SquadBuilderAnchor_FrontCenter" class="ui-button sm-cta sm-cta--md sm-cta--secondary sm-select-snap sm-sqb-modal__anchor-button" />
                            <ui:Button name="SquadBuilderAnchor_BackCenter" class="ui-button sm-cta sm-cta--md sm-cta--secondary sm-select-snap sm-sqb-modal__anchor-button" />
                        </ui:VisualElement>
                        <ui:VisualElement class="sm-sqb-modal__anchor-column">
                            <ui:Label class="sm-sqb-modal__column-title" text="하단" />
                            <ui:Button name="SquadBuilderAnchor_FrontBottom" class="ui-button sm-cta sm-cta--md sm-cta--secondary sm-select-snap sm-sqb-modal__anchor-button" />
                            <ui:Button name="SquadBuilderAnchor_BackBottom" class="ui-button sm-cta sm-cta--md sm-cta--secondary sm-select-snap sm-sqb-modal__anchor-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="SquadBuilderSelectedDetail" class="sm-sqb-modal__section sm-sqb-modal__section--detail">
                    <ui:Label class="sm-sqb-modal__section-title" text="선택 상세" />
                    <ui:Label name="SquadBuilderSelectedAnchorLabel" class="sm-sqb-modal__detail-kicker" text="선택 앵커" />
                    <ui:Label name="SquadBuilderSelectedHeroName" class="sm-sqb-modal__detail-name" text="비어있음" />
                    <ui:Label name="SquadBuilderSelectedHeroMeta" class="sm-sqb-modal__detail-meta" text="영웅 없음" />
                    <ui:Label name="SquadBuilderSelectedHeroLoadout" class="sm-sqb-modal__detail-body" text="장비 없음" />
                    <ui:VisualElement name="SquadBuilderSelectedHeroTags" class="sm-sqb-modal__tag-row" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="TacticalSetupDecisionRow" class="sm-sqb-modal__decision-row">
                <ui:VisualElement name="TacticalSetupPostureSection" class="sm-sqb-modal__section sm-sqb-modal__section--posture">
                    <ui:Label class="sm-sqb-modal__section-title" text="팀 태세" />
                    <ui:VisualElement class="sm-sqb-modal__posture-row">
                        <ui:Button name="SquadBuilderPosture_HoldLine" class="ui-button sm-cta sm-cta--md sm-cta--utility sm-select-snap sm-sqb-modal__posture-button" text="전열 사수" />
                        <ui:Button name="SquadBuilderPosture_StandardAdvance" class="ui-button sm-cta sm-cta--md sm-cta--utility sm-select-snap sm-sqb-modal__posture-button" text="표준 전진" />
                        <ui:Button name="SquadBuilderPosture_ProtectCarry" class="ui-button sm-cta sm-cta--md sm-cta--utility sm-select-snap sm-sqb-modal__posture-button" text="캐리 보호" />
                        <ui:Button name="SquadBuilderPosture_CollapseWeakSide" class="ui-button sm-cta sm-cta--md sm-cta--utility sm-select-snap sm-sqb-modal__posture-button" text="약측 무너뜨리기" />
                        <ui:Button name="SquadBuilderPosture_AllInBackline" class="ui-button sm-cta sm-cta--md sm-cta--utility sm-select-snap sm-sqb-modal__posture-button" text="후열 깊이 침투" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="TacticalSetupOperationSection" class="sm-sqb-modal__section sm-sqb-modal__section--operation">
                    <ui:Label class="sm-sqb-modal__section-title" text="운용" />
                    <ui:VisualElement name="SquadBuilderOperationRows" class="sm-sqb-modal__operation-rows" />
                </ui:VisualElement>
                <ui:VisualElement name="TacticalSetupResponseSection" class="sm-sqb-modal__section sm-sqb-modal__section--response">
                    <ui:Label class="sm-sqb-modal__section-title" text="대응" />
                    <ui:Label name="SquadBuilderResponseSummaryLabel" class="sm-sqb-modal__response-summary" text="선택 전열과 팀 태세를 기준으로 판단합니다." />
                    <ui:VisualElement name="SquadBuilderSynergyChips" class="sm-sqb-modal__synergy-chips" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="SquadBuilderStatusLabel" class="sm-sqb-modal__status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
