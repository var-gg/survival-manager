/* Production-owned styles migrated from Assets/_Game/UI/Screens/Town/Preview/PassiveBoardPreview.uss.
   Keep production panel UXML free of Screens/Town/Preview imports. */

/* Passive Board V1 production (시안 갤러리 #5) */
.pbp-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: var(--sm-ink-1); }
/* wave-41: flex-grow: 1 -> position: absolute. host flex 슬롯에 갇혀 화면 절반만 차지하던 z-order 이슈 해소. */
.pbp-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("project://database/Assets/_Game/UI/Backdrops/ui_passive_board_dusk.png");
    -unity-background-scale-mode: scale-and-crop; }
.pbp-backdrop-dim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(12, 17, 38, 0.92); }
/* wave-41: dim 0.32 -> 0.78. Town hub UI가 backdrop edge로 새던 z-order 이슈 해소.
   uxqa1: 0.78 -> 0.92. backdrop(ui_passive_board_dusk.png)에 구워진 가짜 UI(헥스 트리·ACTIVATE·
   페이저·X)가 frame 밖 여백으로 판독 가능하게 새던 것을 근접 불투명으로 차단. */

/* Modal frame visual은 sm-modal-frame sm-modal-frame--ceremony + sm-frame-corner-cap.
   uxqa1: wave-39에서 sm-modal-frame 제거 시 position:absolute 상실 → inset이 offset으로
   오작동, 모달이 화면 상단 절반에서 끊기고 하단에 backdrop 가짜 UI 노출. absolute 복원. */
.pbp-frame { position: absolute; left: 60px; right: 60px; top: 50px; bottom: 50px; }

/* Board 헤더 — per-hero 컨텍스트. hero portrait + 이름 + 클래스 보드 인디케이터 (고정, 비대화).
   옛 4-class 자유 전환 탭 폐기 — 보드는 hero 클래스로 고정. */
.pbp-header { flex-direction: row; align-items: center;
    padding: 12px 24px;
    border-bottom-width: 1px; border-bottom-color: rgba(230,183,81,0.32); }
.pbp-header__portrait { width: 52px; height: 52px; margin-right: 14px;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(28, 22, 12, 0.78);
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300); border-right-color: var(--sm-gold-300);
    border-top-color: var(--sm-gold-300); border-bottom-color: var(--sm-gold-300); }
.pbp-header__info { flex-direction: column; }
.pbp-header__hero-name { color: var(--sm-gold-100); font-size: 16px; -unity-font-style: bold;
    letter-spacing: 1px; margin-bottom: var(--sm-s-1); }
.pbp-header__class-row { flex-direction: row; align-items: center; }
.pbp-header__class-icon { width: 18px; height: 18px; margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit; }
.pbp-header__class-label { color: var(--sm-ink-2); font-size: var(--sm-fs-eb); letter-spacing: 3px;
    -unity-font-style: bold; }

.pbp-body { flex-direction: row; flex-grow: 1; padding: 18px; }
.pbp-board { flex-grow: 1; margin-right: 14px;
    background-color: rgba(28, 22, 12, 0.86);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(230,183,81,0.32); border-right-color: rgba(230,183,81,0.32);
    border-top-color: rgba(230,183,81,0.32); border-bottom-color: rgba(230,183,81,0.32); }
.pbp-board__canvas { flex-grow: 1; }

/* --- Board ring guide layer — 옛 flat grey canvas 보강 ---
   center (46%,40%) · 동심 ring r 0.18 / 0.36 · 중앙 warm glow.
   node가 그 위에 올라가도록 BoardCanvas보다 먼저 선언. picking 무시. */
/* 노드 그래프가 주인공이다. 예전엔 보드의 80%를 덮어 노드를 가렸고, 자산에 크로마 잔류가
   불투명하게 남아 중앙이 마젠타 덩어리로 보였다(자산은 별도 수리). 시안의 중심은 은은한
   온기 + 클래스 워터마크지 화면을 채우는 발광이 아니다 — 배경으로 물러난다. */
.pbp-board__glow {
    position: absolute;
    /* 보드 설계 중심은 (46%,40%) — ring-core와 동심이어야 한다. 크기의 절반을 빼서 맞춘다. */
    left: 28%; top: 18%;
    width: 36%; height: 44%;
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Frame/glow_halo_warm_gold.png");
    -unity-background-scale-mode: scale-to-fit;
    /* 2026-07-31 자산 수리 후 재조정. 노드에 실제 아이콘이 붙으면서 보드의 주인공이
       분명해졌으므로, 중앙 온기는 두 단계 더 물러난다(0.13 → 0.05). */
    opacity: 0.05;
}
.pbp-board__ring {
    position: absolute;
    background-color: rgba(0,0,0,0);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a20);
    border-right-color: var(--sm-gold-300-a20);
    border-top-color: var(--sm-gold-300-a20);
    border-bottom-color: var(--sm-gold-300-a20);
    border-top-left-radius: 50%; border-top-right-radius: 50%;
    border-bottom-left-radius: 50%; border-bottom-right-radius: 50%;
}
/* depth 2 ring: r 0.36 → diameter 72%, center (46%,40%) */
.pbp-board__ring--outer { left: 10%; top: 4%; width: 72%; height: 72%; }
/* depth 1 ring: r 0.18 → diameter 36%, center (46%,40%) */
.pbp-board__ring--inner {
    left: 28%; top: 22%; width: 36%; height: 36%;
    border-left-color: rgba(230,183,81,0.32);
    border-right-color: rgba(230,183,81,0.32);
    border-top-color: rgba(230,183,81,0.32);
    border-bottom-color: rgba(230,183,81,0.32);
}
/* center keystone anchor disc */
.pbp-board__ring-core {
    position: absolute;
    left: 40%; top: 31%; width: 12%; height: 18%;
    background-color: rgba(200,147,42,0.09);
    border-top-left-radius: 50%; border-top-right-radius: 50%;
    border-bottom-left-radius: 50%; border-bottom-right-radius: 50%;
}

/* --- Node (passive-board-node-catalog.md V1 floor) ---
   kind 축: small / notable / keystone — 시각 크기와 강조 차이.
   state 축: --active (per-hero 활성, 토글) — base는 inactive (muted). */

.pbp-board__node {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(38,45,84,0.55);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(107,93,63,0.62); border-right-color: rgba(107,93,63,0.62);
    border-top-color: rgba(107,93,63,0.62); border-bottom-color: rgba(107,93,63,0.62);
}

/* Kind — size & shape */
.pbp-board__node--small {
    width: 36px; height: 36px;
    margin-left: -18px; margin-top: -18px;  /* center on coord */
    border-top-left-radius: 18px; border-top-right-radius: 18px;
    border-bottom-left-radius: 18px; border-bottom-right-radius: 18px;
}
.pbp-board__node--notable {
    width: 52px; height: 52px;
    margin-left: -26px; margin-top: -26px;
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
}
.pbp-board__node--keystone {
    width: 68px; height: 68px;
    margin-left: -34px; margin-top: -34px;
    background-color: rgba(200,147,42,0.42);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: var(--sm-gold-200); border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200); border-bottom-color: var(--sm-gold-200);
}

/* State — per-hero active toggle */
.pbp-board__node--active {
    background-color: rgba(91,142,209,0.78);
    border-left-color: var(--sm-gold-200); border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200); border-bottom-color: var(--sm-gold-200);
}
.pbp-board__node--keystone.pbp-board__node--active {
    background-color: rgba(200,147,42,0.78);
}

/* Detail panel — dark navy card. ceremony frame texture가 parchment라
   near-transparent bg면 dark용 text가 저대비 → solid navy로 보정. */
.pbp-detail { width: 280px;
    background-color: rgba(28, 22, 12, 0.92);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(230,183,81,0.32); border-right-color: rgba(230,183,81,0.32);
    border-top-color: rgba(230,183,81,0.32); border-bottom-color: rgba(230,183,81,0.32);
    align-items: center;
}
.pbp-detail__tier-bar { width: 100%; padding: 6px 0; align-items: center;
    background-color: rgba(28,34,67,0.92); }
.pbp-detail__tier-label { color: var(--sm-gold-200); font-size: 13px; letter-spacing: 4px; -unity-font-style: bold; }
.pbp-detail__icon { width: 80px; height: 80px; margin-top: var(--sm-s-4); -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(200,147,42,0.18);
    border-top-left-radius: 40px; border-top-right-radius: 40px; border-bottom-left-radius: 40px; border-bottom-right-radius: 40px;
}
.pbp-detail__title { color: var(--sm-gold-100); font-size: 15px; letter-spacing: 3px; -unity-font-style: bold;
    margin-top: var(--sm-s-3); margin-bottom: var(--sm-s-3); }
.pbp-detail__desc { width: 240px; padding: 8px 14px; }
.pbp-detail__desc-text {
    font-size: var(--sm-fs-s);
    color: var(--sm-ink-1);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: var(--sm-s-2);
}
.pbp-detail__desc-tags {
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(216,199,153,0.78);
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.pbp-detail__available { color: rgba(120,200,140,0.92); font-size: var(--sm-fs-eb); letter-spacing: 3px;
    -unity-font-style: bold; margin-top: 14px; margin-bottom: var(--sm-s-2); }
/* Activate CTA: visual은 sm-cta sm-cta--md sm-cta--primary. width/color/font만 surface 고유. */
.pbp-detail__activate { width: 200px; color: rgba(20,16,8,1);
    font-size: var(--sm-fs-m); letter-spacing: 4px; -unity-font-style: bold; }
.pbp-detail__progress { margin-top: var(--sm-s-2); color: var(--sm-ink-2); font-size: var(--sm-fs-eb); }

/* Footer — point-budget 폐기. per-kind active 카운트만 노출. */
.pbp-footer { flex-direction: row; align-items: center; justify-content: space-between;
    padding: 10px 24px; border-top-width: 1px; border-top-color: var(--sm-gold-300-a28); }
.pbp-footer__breakdown { color: var(--sm-gold-200); font-size: var(--sm-fs-eb); letter-spacing: 2px; -unity-font-style: bold; }
.pbp-footer__close { width: 28px; height: 28px; background-color: rgba(38,45,84,0.72); color: var(--sm-gold-200); }

/* Panel-local ArtBible ownership overrides. */
.pbp-frame {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    background-color: var(--sm-bg-0);
}

.pbp-board,
.pbp-detail {
    background-color: var(--sm-bg-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a20);
    border-right-color: var(--sm-gold-300-a20);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-line-1);
    border-top-left-radius: var(--sm-r-lg);
    border-top-right-radius: var(--sm-r-lg);
    border-bottom-left-radius: var(--sm-r-lg);
    border-bottom-right-radius: var(--sm-r-lg);
}

/* 같은 셀렉터가 이 파일에 두 번 있었고 뒤쪽이 앞쪽 크기·불투명도를 조용히 덮었다.
   배경 투명만 남기고 형상은 위 규칙 하나가 소유한다. */
.pbp-board__glow {
    background-color: rgba(0, 0, 0, 0);
}

.pbp-board__node {
    background-image: none;
    background-color: var(--sm-bg-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-line-1);
    border-right-color: var(--sm-line-1);
    border-top-color: var(--sm-line-2);
    border-bottom-color: var(--sm-line-1);
}

.pbp-detail__desc {
    background-image: none;
    background-color: var(--sm-bg-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-line-1);
    border-right-color: var(--sm-line-1);
    border-top-color: var(--sm-line-2);
    border-bottom-color: var(--sm-line-1);
    border-top-left-radius: var(--sm-r-md);
    border-top-right-radius: var(--sm-r-md);
    border-bottom-left-radius: var(--sm-r-md);
    border-bottom-right-radius: var(--sm-r-md);
}

.pbp-board__node--active {
    background-image: none;
    background-color: var(--sm-bg-3);
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-200);
    border-bottom-color: var(--sm-gold-300-a42);
}

.pbp-header__portrait {
    background-image: none;
    background-color: var(--sm-bg-0-a84);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-vellum-a12);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a15);
    border-bottom-color: var(--sm-vellum-a09);
    border-top-left-radius: var(--sm-r-md);
    border-top-right-radius: var(--sm-r-md);
    border-bottom-left-radius: var(--sm-r-md);
    border-bottom-right-radius: var(--sm-r-md);
}

.pbp-header__class-icon--vanguard { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_vanguard.png"); }
.pbp-header__class-icon--duelist { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_duelist.png"); }
.pbp-header__class-icon--ranger { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_ranger.png"); }
.pbp-header__class-icon--mystic { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_mystic.png"); }

.pbp-detail__icon {
    background-image: none;
    background-color: rgba(200, 147, 42, 0.18);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-vellum-a12);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a15);
    border-bottom-color: var(--sm-vellum-a09);
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
}

.pbp-footer__close {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Button/ui_close_button.png");
    -unity-background-scale-mode: scale-to-fit;
}
