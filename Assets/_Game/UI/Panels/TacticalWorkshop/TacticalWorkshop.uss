/* =============================================================
   Tactical Workshop V1 (Squad Workshop) — Phase 4 wave-38 refactor
   visual SoT: pindoc://analysis-squad-workshop-mockup-brief-v1
                Screenshots/mockups/ui_ux_bible_squad_workshop_v1.png
   책임 SoT:   pindoc://analysis-panel-responsibility-matrix-v1 §2
   tone: dark navy + warm gold trim, dense codex (NOT baroque fantasy)
   chrome budget: 3 layer (outer frame + inner section + cards)
   ============================================================= */

.twp-root {
    flex-grow: 1;
    color: var(--sm-ink-1);
}

/* --- Backdrop --- */
.twp-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("project://database/Assets/_Game/UI/Backdrops/ui_tactical_workshop_dusk.png");
    -unity-background-scale-mode: scale-and-crop;
}
.twp-backdrop-dim {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(12, 17, 38, 0.62);
}

/* --- Modal frame (centered) ---
   chrome budget: outer 1 — frame texture만 사용, corner cap / center ornament 없음. */
.twp-frame {
    /* uxqa1: inset 기반 frame인데 position:absolute 부재 — pap/pbp와 동일 결손 복원 */
    position: absolute;
    left: 60px; right: 60px; top: 40px; bottom: 40px;
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    background-color: var(--sm-bg-0);
    padding-left: var(--sm-s-7);
    padding-right: var(--sm-s-7);
    padding-top: 36px;
    padding-bottom: 36px;
}

/* --- Header (56) --- */
.twp-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding-left: var(--sm-s-2);
    padding-right: var(--sm-s-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--sm-gold-300-a24);
}
.twp-header__title {
    font-size: var(--sm-fs-xl);
    color: var(--sm-gold-100);
    -unity-font-style: bold;
}
.twp-header__close {
    width: 32px;
    height: 32px;
    background-color: var(--sm-bg-2);
    color: var(--sm-gold-200);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-400);
    border-right-color: var(--sm-gold-400);
    border-top-color: var(--sm-gold-400);
    border-bottom-color: var(--sm-gold-400);
}

/* --- Command strip (36) — eyebrow + 3 state chips --- */
.twp-command-strip {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    padding-left: var(--sm-s-2);
    padding-right: var(--sm-s-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--sm-gold-300-a20);
}
.twp-command-strip__eyebrow {
    font-size: var(--sm-fs-eb);
    letter-spacing: 3px;
    color: var(--sm-gold-200);
    -unity-font-style: bold;
}
.twp-command-strip__chips {
    flex-direction: row;
    align-items: center;
}
.twp-command-chip {
    height: var(--sm-chip-h);
    padding-left: 10px;
    padding-right: 10px;
    margin-left: var(--sm-s-2);
    font-size: var(--sm-fs-xs);
    color: var(--sm-chip-state-text);
    background-color: var(--sm-chip-state-bg);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-chip-state-border);
    border-right-color: var(--sm-chip-state-border);
    border-top-color: var(--sm-chip-state-border);
    border-bottom-color: var(--sm-chip-state-border);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    -unity-text-align: middle-center;
}
.twp-command-chip--warn {
    color: var(--sm-state-warn);
    background-color: rgba(232, 169, 59, 0.22);
    border-left-color: var(--sm-state-warn-a56);
    border-right-color: var(--sm-state-warn-a56);
    border-top-color: var(--sm-state-warn-a56);
    border-bottom-color: var(--sm-state-warn-a56);
}

/* --- Main 2-area split --- */
.twp-main {
    flex-direction: row;
    flex-grow: 1;
    padding-top: var(--sm-s-3);
    padding-bottom: var(--sm-s-3);
}

/* LEFT — anchor pad (520) */
.twp-left-anchor {
    width: 520px;
    margin-right: var(--sm-s-4);
    background-color: var(--sm-bg-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a20);
    border-right-color: var(--sm-gold-300-a20);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a20);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding: var(--sm-s-4);
}

.twp-zone-label {
    position: absolute;
    font-size: var(--sm-fs-m);
    letter-spacing: 2px;
    color: var(--sm-gold-200);
    -unity-font-style: bold;
}
.twp-zone-label--front { left: 24px; top: 16px; }
.twp-zone-label--back  { left: 24px; top: 50%; }

.twp-anchor-pad {
    flex-grow: 1;
    background-color: var(--sm-bg-0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a24);
    border-right-color: var(--sm-gold-300-a24);
    border-top-color: var(--sm-gold-300-a24);
    border-bottom-color: var(--sm-gold-300-a24);
    border-top-left-radius: var(--radius-l);
    border-top-right-radius: var(--radius-l);
    border-bottom-left-radius: var(--radius-l);
    border-bottom-right-radius: var(--radius-l);
    margin-top: var(--sm-s-5);
    margin-bottom: var(--sm-s-2);
}

.twp-anchor-pad__readonly-hint {
    -unity-text-align: middle-right;
    font-size: var(--sm-fs-xs);
    color: var(--sm-ink-3);
    padding-right: var(--sm-s-1);
    padding-top: 2px;
}

/* 6 anchor standee — 3x2 isometric (Front × 3 lower + Back × 3 upper).
   View가 RenderAnchors에서 동적 생성. */
.twp-standee {
    position: absolute;
    width: 72px;
    height: 104px;
    align-items: center;
}
.twp-standee--front-top    { left: 18%; bottom: 32px; }
.twp-standee--front-center { left: 42%; bottom: 32px; }
.twp-standee--front-bottom { left: 66%; bottom: 32px; }
.twp-standee--back-top     { left: 18%; bottom: 160px; }
.twp-standee--back-center  { left: 42%; bottom: 160px; }
.twp-standee--back-bottom  { left: 66%; bottom: 160px; }
.twp-standee--empty { opacity: 0.42; }

.twp-standee__pillar {
    width: 60px;
    height: 14px;
    background-color: var(--sm-gold-300-a32);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    margin-bottom: var(--sm-s-1);
}
.twp-standee__pillar--empty { background-color: rgba(157, 138, 94, 0.32); }

.twp-standee__figure {
    width: 60px;
    height: 82px;
    -unity-background-scale-mode: scale-to-fit;
}
.twp-standee__figure--vanguard { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_vanguard.png"); }
.twp-standee__figure--duelist { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_duelist.png"); }
.twp-standee__figure--ranger { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_ranger.png"); }
.twp-standee__figure--mystic { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_mystic.png"); }

/* --- Right stack (3 sections) --- */
.twp-right-stack {
    flex-grow: 1;
    flex-direction: column;
}
.twp-section {
    background-color: var(--sm-bg-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a20);
    border-right-color: var(--sm-gold-300-a20);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a20);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding: var(--sm-s-3);
    margin-bottom: var(--sm-s-3);
}
.twp-section--posture { height: 240px; }
.twp-section--synergy { height: 88px; padding-top: 6px; padding-bottom: 6px; }
.twp-section--threat  { flex-grow: 1; margin-bottom: 0; }

.twp-section-eyebrow {
    font-size: var(--sm-fs-eb);
    letter-spacing: 3px;
    color: var(--sm-gold-200);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

/* --- Posture row (5 cards horizontal evenly distributed) --- */
.twp-posture-row {
    flex-direction: row;
    flex-grow: 1;
}
.twp-posture-card {
    flex-grow: 1;
    flex-basis: 0;
    /* Button 승격 — unity-button 기본 margin/padding 중화 */
    margin-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-right: var(--sm-s-2);
    background-color: var(--sm-bg-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a32);
    border-right-color: var(--sm-gold-300-a32);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a32);
    border-top-left-radius: var(--radius-l);
    border-top-right-radius: var(--radius-l);
    border-bottom-left-radius: var(--radius-l);
    border-bottom-right-radius: var(--radius-l);
    -unity-background-scale-mode: scale-and-crop;
    justify-content: flex-end;
}
.twp-posture-card--selected {
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-100);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    background-color: var(--sm-bg-3);
}
/* posture 카드 일러 — presenter SpriteKey → posture_{key}.png (런타임 texture 미주입 시 USS가 배경 공급) */
.twp-posture-card--art-hold_line          { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Posture/posture_hold_line.png"); }
.twp-posture-card--art-standard_advance   { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Posture/posture_standard_advance.png"); }
.twp-posture-card--art-protect_carry      { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Posture/posture_protect_carry.png"); }
.twp-posture-card--art-collapse_weak_side { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Posture/posture_collapse_weak_side.png"); }
.twp-posture-card--art-all_in_backline    { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Posture/posture_all_in_backline.png"); }

.twp-posture-card__label {
    -unity-text-align: middle-center;
    color: var(--sm-ink-0);
    font-size: var(--sm-fs-m);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding-top: var(--sm-s-1);
    padding-bottom: 6px;
    background-color: rgba(12, 17, 38, 0.78);
    white-space: normal;
}

/* --- Synergy strip — content SoT(snapshot.SynergyCatalog) 기반 텍스트 칩 (이름 N/경계) --- */
.twp-synergy-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-grow: 1;
}
.twp-synergy-chip {
    height: var(--sm-chip-h);
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 6px;
    margin-bottom: 2px;
    font-size: var(--sm-fs-xs);
    -unity-text-align: middle-center;
    color: var(--sm-ink-1);
    background-color: var(--sm-bg-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a32);
    border-right-color: var(--sm-gold-300-a32);
    border-top-color: var(--sm-gold-300-a32);
    border-bottom-color: var(--sm-gold-300-a32);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}
.twp-synergy-chip--active {
    color: var(--sm-gold-100);
    background-color: var(--sm-gold-300-a18);
    border-left-color: var(--sm-gold-200);
    border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200);
    border-bottom-color: var(--sm-gold-200);
}
.twp-synergy-chip--muted {
    color: var(--sm-ink-3);
    background-color: var(--sm-bg-1);
}
.twp-synergy-empty {
    font-size: var(--sm-fs-xs);
    color: var(--sm-ink-3);
    -unity-text-align: middle-left;
}

/* --- Threat grid (8 lane = 4 col × 2 row) --- */
.twp-threat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}
.twp-threat-chip {
    width: 23%;
    height: 48%;
    margin-right: 1%;
    margin-bottom: 2%;
    -unity-background-scale-mode: scale-to-fit;
    background-color: var(--sm-bg-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a32);
    border-right-color: var(--sm-gold-300-a32);
    border-top-color: var(--sm-gold-300-a32);
    border-bottom-color: var(--sm-gold-300-a32);
    border-top-left-radius: var(--radius-l);
    border-top-right-radius: var(--radius-l);
    border-bottom-left-radius: var(--radius-l);
    border-bottom-right-radius: var(--radius-l);
    justify-content: flex-end;
}
.twp-threat-chip__label {
    -unity-text-align: middle-center;
    color: var(--sm-ink-0);
    font-size: var(--sm-fs-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding-top: var(--sm-s-1);
    padding-bottom: var(--sm-s-1);
    background-color: rgba(12, 17, 38, 0.78);
    white-space: normal;
}
.twp-threat-chip--answered {
    border-left-color: var(--sm-state-safe-a86);
    border-right-color: var(--sm-state-safe-a86);
    border-top-color: var(--sm-state-safe-a86);
    border-bottom-color: var(--sm-state-safe-a86);
    background-color: rgba(109, 191, 120, 0.18);
}
.twp-threat-chip--unanswered {
    border-left-color: var(--sm-state-danger);
    border-right-color: var(--sm-state-danger);
    border-top-color: var(--sm-state-danger);
    border-bottom-color: var(--sm-state-danger);
    background-color: rgba(226, 85, 72, 0.18);
}
.twp-threat-chip--partial {
    border-left-color: var(--sm-state-warn-a56);
    border-right-color: var(--sm-state-warn-a56);
    border-top-color: var(--sm-state-warn-a56);
    border-bottom-color: var(--sm-state-warn-a56);
    background-color: rgba(232, 169, 59, 0.14);
}
/* lane glyph art — presenter SpriteKey → threat_{key}.png (런타임 texture 미주입 시 USS가 배경 공급) */
.twp-threat-chip--art-pierce  { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Threat/threat_pierce.png"); }
.twp-threat-chip--art-burst   { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Threat/threat_burst.png"); }
.twp-threat-chip--art-dive    { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Threat/threat_dive.png"); }
.twp-threat-chip--art-swarm   { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Threat/threat_swarm.png"); }
.twp-threat-chip--art-sustain { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Threat/threat_sustain.png"); }
.twp-threat-chip--art-heal    { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Threat/threat_heal.png"); }
.twp-threat-chip--art-control { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Threat/threat_control.png"); }
.twp-threat-chip--art-summon  { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Threat/threat_summon.png"); }

/* --- Action bar (64) — 전술 초기화만 (태세·지시는 즉시 적용, 저장 CTA 없음) --- */
.twp-action-bar {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: 64px;
    padding-left: 56px;
    padding-right: 56px;
    border-top-width: 1px;
    border-top-color: var(--sm-gold-300-a24);
}
.twp-action-bar__reset {
    width: 200px;
    height: 44px;
    background-color: var(--sm-cta-secondary-bg);
    color: var(--sm-cta-secondary-text);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-cta-secondary-border);
    border-right-color: var(--sm-cta-secondary-border);
    border-top-color: var(--sm-cta-secondary-border);
    border-bottom-color: var(--sm-cta-secondary-border);
    font-size: var(--sm-fs-m);
    -unity-font-style: bold;
}
/* --- 유닛 전술 strip (좌측 컬럼, anchor pad 아래) --- */
.twp-tactics-eyebrow {
    margin-top: var(--sm-s-2);
    margin-bottom: var(--sm-s-1);
}
.twp-tactic-rows {
    flex-direction: column;
}
.twp-tactic-hero {
    flex-direction: row;
    align-items: center;
    height: 30px;
    background-color: var(--sm-bg-0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a20);
    border-right-color: var(--sm-gold-300-a20);
    border-top-color: var(--sm-gold-300-a20);
    border-bottom-color: var(--sm-gold-300-a20);
    border-top-left-radius: var(--sm-r-md);
    border-top-right-radius: var(--sm-r-md);
    border-bottom-left-radius: var(--sm-r-md);
    border-bottom-right-radius: var(--sm-r-md);
    padding-top: var(--sm-s-1);
    padding-bottom: var(--sm-s-1);
    padding-left: var(--sm-s-2);
    padding-right: var(--sm-s-2);
    margin-bottom: var(--sm-s-1);
}
.twp-tactic-hero__name {
    width: 96px;
    font-size: var(--sm-fs-s);
    color: var(--sm-ink-0);
    -unity-font-style: bold;
    overflow: hidden;
}
.twp-tactic-hero__role {
    width: 118px;
    font-size: var(--sm-fs-xs);
    color: var(--sm-gold-200);
    overflow: hidden;
}
.twp-tactic-hero__behavior {
    flex-grow: 1;
    font-size: var(--sm-fs-xs);
    color: var(--sm-ink-2);
    overflow: hidden;
}
.twp-tactic-hero__directive {
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: var(--sm-fs-xs);
    color: var(--sm-gold-100);
    background-color: var(--sm-gold-300-a12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}
