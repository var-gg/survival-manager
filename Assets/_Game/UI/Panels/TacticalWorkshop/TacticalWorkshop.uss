/* =============================================================
   Tactical Workshop V1 (Squad Workshop) — Phase 4 wave-38 refactor
   visual SoT: pindoc://analysis-squad-workshop-mockup-brief-v1
                Screenshots/mockups/ui_ux_bible_squad_workshop_v1.png
   책임 SoT:   pindoc://analysis-panel-responsibility-matrix-v1 §2
   tone: dark navy + warm gold trim, dense codex (NOT baroque fantasy)
   chrome budget: 3 layer (outer frame + inner section + cards)
   ============================================================= */

.twp-root {
    flex-grow: 1;
    color: var(--sm-ink-1);
}

/* --- Backdrop --- */
.twp-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("project://database/Assets/_Game/UI/Backdrops/ui_tactical_workshop_dusk.png");
    -unity-background-scale-mode: scale-and-crop;
}
.twp-backdrop-dim {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(12, 17, 38, 0.62);
}

/* --- Modal frame (centered) ---
   chrome budget: outer 1 — frame texture만 사용, corner cap / center ornament 없음. */
.twp-frame {
    left: 60px; right: 60px; top: 40px; bottom: 40px;
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    background-color: var(--sm-bg-0);
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 36px;
    padding-bottom: 36px;
}

/* --- Header (56) --- */
.twp-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sm-gold-300-a24);
}
.twp-header__title {
    font-size: var(--sm-fs-xl);
    color: var(--sm-gold-100);
    -unity-font-style: bold;
}
.twp-header__close {
    width: 32px;
    height: 32px;
    background-color: var(--sm-bg-2);
    color: var(--sm-gold-200);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-400);
    border-right-color: var(--sm-gold-400);
    border-top-color: var(--sm-gold-400);
    border-bottom-color: var(--sm-gold-400);
}

/* --- Command strip (36) — eyebrow + 3 state chips --- */
.twp-command-strip {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sm-gold-300-a20);
}
.twp-command-strip__eyebrow {
    font-size: var(--sm-fs-eb);
    letter-spacing: 3px;
    color: var(--sm-gold-200);
    -unity-font-style: bold;
}
.twp-command-strip__chips {
    flex-direction: row;
    align-items: center;
}
.twp-command-chip {
    height: var(--sm-chip-h);
    padding-left: 10px;
    padding-right: 10px;
    margin-left: 8px;
    font-size: var(--sm-fs-xs);
    color: var(--sm-chip-state-text);
    background-color: var(--sm-chip-state-bg);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-chip-state-border);
    border-right-color: var(--sm-chip-state-border);
    border-top-color: var(--sm-chip-state-border);
    border-bottom-color: var(--sm-chip-state-border);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    -unity-text-align: middle-center;
}
.twp-command-chip--warn {
    color: var(--sm-state-warn);
    background-color: rgba(232, 169, 59, 0.22);
    border-left-color: var(--sm-state-warn-a56);
    border-right-color: var(--sm-state-warn-a56);
    border-top-color: var(--sm-state-warn-a56);
    border-bottom-color: var(--sm-state-warn-a56);
}

/* --- Main 2-area split --- */
.twp-main {
    flex-direction: row;
    flex-grow: 1;
    padding-top: 12px;
    padding-bottom: 12px;
}

/* LEFT — anchor pad (520) */
.twp-left-anchor {
    width: 520px;
    margin-right: 16px;
    background-color: var(--sm-bg-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a20);
    border-right-color: var(--sm-gold-300-a20);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a20);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding: 16px;
}

.twp-zone-label {
    position: absolute;
    font-size: var(--sm-fs-m);
    letter-spacing: 2px;
    color: var(--sm-gold-200);
    -unity-font-style: bold;
}
.twp-zone-label--front { left: 24px; top: 16px; }
.twp-zone-label--back  { left: 24px; top: 50%; }

.twp-anchor-pad {
    flex-grow: 1;
    background-color: var(--sm-bg-0);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a24);
    border-right-color: var(--sm-gold-300-a24);
    border-top-color: var(--sm-gold-300-a24);
    border-bottom-color: var(--sm-gold-300-a24);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-top: 24px;
    margin-bottom: 8px;
}

.twp-anchor-pad__readonly-hint {
    -unity-text-align: middle-right;
    font-size: var(--sm-fs-xs);
    color: var(--sm-ink-3);
    padding-right: 4px;
    padding-top: 2px;
}

/* 6 anchor standee — 3x2 isometric (Front × 3 lower + Back × 3 upper).
   View가 RenderAnchors에서 동적 생성. */
.twp-standee {
    position: absolute;
    width: 72px;
    height: 104px;
    align-items: center;
}
.twp-standee--front-top    { left: 18%; bottom: 32px; }
.twp-standee--front-center { left: 42%; bottom: 32px; }
.twp-standee--front-bottom { left: 66%; bottom: 32px; }
.twp-standee--back-top     { left: 18%; bottom: 160px; }
.twp-standee--back-center  { left: 42%; bottom: 160px; }
.twp-standee--back-bottom  { left: 66%; bottom: 160px; }
.twp-standee--empty { opacity: 0.42; }

.twp-standee__pillar {
    width: 60px;
    height: 14px;
    background-color: var(--sm-gold-300-a32);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    margin-bottom: 4px;
}
.twp-standee__pillar--empty { background-color: rgba(157, 138, 94, 0.32); }

.twp-standee__figure {
    width: 60px;
    height: 82px;
    -unity-background-scale-mode: scale-to-fit;
}

/* --- Right stack (3 sections) --- */
.twp-right-stack {
    flex-grow: 1;
    flex-direction: column;
}
.twp-section {
    background-color: var(--sm-bg-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a20);
    border-right-color: var(--sm-gold-300-a20);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a20);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    padding: 12px;
    margin-bottom: 12px;
}
.twp-section--posture { height: 240px; }
.twp-section--synergy { height: 88px; padding-top: 6px; padding-bottom: 6px; }
.twp-section--threat  { flex-grow: 1; margin-bottom: 0; }

.twp-section-eyebrow {
    font-size: var(--sm-fs-eb);
    letter-spacing: 3px;
    color: var(--sm-gold-200);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

/* --- Posture row (5 cards horizontal evenly distributed) --- */
.twp-posture-row {
    flex-direction: row;
    flex-grow: 1;
}
.twp-posture-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    background-color: var(--sm-bg-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a32);
    border-right-color: var(--sm-gold-300-a32);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a32);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: flex-end;
}
.twp-posture-card--selected {
    border-left-color: var(--sm-gold-100);
    border-right-color: var(--sm-gold-100);
    border-top-color: var(--sm-gold-100);
    border-bottom-color: var(--sm-gold-100);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    background-color: var(--sm-bg-3);
}
.twp-posture-card__label {
    -unity-text-align: middle-center;
    color: var(--sm-ink-0);
    font-size: var(--sm-fs-m);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding-top: 4px;
    padding-bottom: 6px;
    background-color: rgba(12, 17, 38, 0.78);
    white-space: normal;
}

/* --- Synergy strip (7 family chip = race 3 + class 4) --- */
.twp-synergy-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}
.twp-synergy-chip {
    width: 40px;
    height: 40px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: var(--sm-bg-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a32);
    border-right-color: var(--sm-gold-300-a32);
    border-top-color: var(--sm-gold-300-a32);
    border-bottom-color: var(--sm-gold-300-a32);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
/* Race chip — color block placeholder (sprite 미발행) */
.twp-synergy-chip--human    { background-color: var(--sm-chip-category-border); }
.twp-synergy-chip--beastkin { background-color: rgba(122, 138, 82, 0.62); }
.twp-synergy-chip--undead   { background-color: rgba(82, 74, 104, 0.72); }
/* Class chip — sprite */
.twp-synergy-chip--vanguard { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_vanguard.png"); }
.twp-synergy-chip--duelist  { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_duelist.png"); }
.twp-synergy-chip--ranger   { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_ranger.png"); }
.twp-synergy-chip--mystic   { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Class/class_mystic.png"); }

.twp-synergy-divider {
    width: 1px;
    height: 32px;
    background-color: var(--sm-gold-300-a32);
    margin-left: 6px;
    margin-right: 10px;
    align-self: center;
}

/* --- Threat grid (8 lane = 4 col × 2 row) --- */
.twp-threat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}
.twp-threat-chip {
    width: 23%;
    height: 48%;
    margin-right: 1%;
    margin-bottom: 2%;
    -unity-background-scale-mode: scale-to-fit;
    background-color: var(--sm-bg-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a32);
    border-right-color: var(--sm-gold-300-a32);
    border-top-color: var(--sm-gold-300-a32);
    border-bottom-color: var(--sm-gold-300-a32);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    justify-content: flex-end;
}
.twp-threat-chip__label {
    -unity-text-align: middle-center;
    color: var(--sm-ink-0);
    font-size: var(--sm-fs-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgba(12, 17, 38, 0.78);
    white-space: normal;
}
.twp-threat-chip--answered {
    border-left-color: var(--sm-state-safe-a86);
    border-right-color: var(--sm-state-safe-a86);
    border-top-color: var(--sm-state-safe-a86);
    border-bottom-color: var(--sm-state-safe-a86);
    background-color: rgba(109, 191, 120, 0.18);
}
.twp-threat-chip--unanswered {
    border-left-color: var(--sm-state-danger);
    border-right-color: var(--sm-state-danger);
    border-top-color: var(--sm-state-danger);
    border-bottom-color: var(--sm-state-danger);
    background-color: rgba(226, 85, 72, 0.18);
}

/* --- Action bar (80) — 초기화 secondary + 저장 primary --- */
.twp-action-bar {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    height: 80px;
    padding-left: 56px;
    padding-right: 56px;
    border-top-width: 1px;
    border-top-color: var(--sm-gold-300-a24);
}
.twp-action-bar__reset {
    width: 200px;
    height: 44px;
    background-color: var(--sm-cta-secondary-bg);
    color: var(--sm-cta-secondary-text);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-cta-secondary-border);
    border-right-color: var(--sm-cta-secondary-border);
    border-top-color: var(--sm-cta-secondary-border);
    border-bottom-color: var(--sm-cta-secondary-border);
    font-size: var(--sm-fs-m);
    -unity-font-style: bold;
}
.twp-action-bar__save {
    width: 280px;
    height: 44px;
    background-color: var(--sm-cta-primary-bg);
    color: var(--sm-cta-primary-text);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-cta-primary-border);
    border-right-color: var(--sm-cta-primary-border);
    border-top-color: var(--sm-cta-primary-border);
    border-bottom-color: var(--sm-cta-primary-border);
    font-size: var(--sm-fs-m);
    -unity-font-style: bold;
}

/* --- Hidden tactic display (View binding 보존용) --- */
.twp-tactic-rows-hidden {
    display: none;
}

/* === Legacy class shims (View가 dynamic으로 생성하는 element들) === */
/* tactic hero block은 hidden container 안이라 styling 불필요. legacy 클래스만 silent. */
.twp-tactic-hero, .twp-tactic-bias { display: none; }
