.rgp-header,
.rgp-filter-strip {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_inner.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.42;
    background-color: var(--sm-bg-1);
}

.rgp-filter-chip {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Button/ui_button_dark.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.28;
}

.rgp-filter-chip--selected {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Button/ui_button_gold.png");
}

.rgp-grid-scroll {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    background-color: var(--sm-bg-0);
}

.sm-hpc {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_card_frame_normal.png");
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.32;
}

.sm-hpc--selected {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_card_frame_selected_base.png");
}

.sm-hpc__portrait {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/IconSlot/ui_icon_slot_frame.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 56;
    -unity-slice-bottom: 56;
    -unity-slice-scale: 0.32;
}

.rgp-filter-divider {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Divider/ui_divider_vertical_diamond.png");
    -unity-background-scale-mode: scale-and-crop;
}

.rgp-quick-battle {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Button/ui_button_gold.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.34;
}
