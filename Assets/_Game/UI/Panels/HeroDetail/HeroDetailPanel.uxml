<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../Foundation/Styles/ThemeTokens.uss" />
    <Style src="../../Foundation/Styles/RuntimePanelTheme.uss" />
    <Style src="../../Foundation/USS/common_detail.uss" />
    <Style src="HeroDetailPanel.uss" />
    <ui:VisualElement name="HeroDetailRoot" class="sm-hd-root sm-modal-anim sm-modal-anim--enter">
        <ui:VisualElement name="HeroDetailBackdrop" class="sm-hd-backdrop" picking-mode="Ignore" />
        <ui:VisualElement name="HeroDetailFrame" class="sm-hd-frame">

            <ui:VisualElement class="sm-hd-top">
                <ui:Label class="sm-hd-eyebrow" text="영웅 상세 · HERO DETAIL" />
                <ui:Label name="HeroDetailTitle" class="sm-hd-title" />
                <ui:Button name="HeroDetailClose" class="sm-hd-close sm-cta sm-cta--inline sm-cta--secondary" text="X" />
            </ui:VisualElement>

            <ui:VisualElement class="sm-hd-body">

                <ui:VisualElement name="HeroDetailLeft" class="sm-hd-left">
                    <ui:VisualElement name="HeroDetailPortrait" class="sm-hd-portrait">
                        <ui:Label name="HeroDetailPortraitGlyph" class="sm-hd-portrait__glyph" text="✦" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sm-hd-nameplate">
                        <ui:Label name="HeroDetailName" class="sm-hd-name" />
                        <ui:VisualElement class="sm-hd-chip-row">
                            <ui:Label name="HeroDetailLevel" class="sm-hd-chip sm-hd-chip--level" />
                            <ui:Label name="HeroDetailTier" class="sm-hd-chip sm-hd-chip--tier" />
                            <ui:Label name="HeroDetailRole" class="sm-hd-chip sm-hd-chip--role" />
                        </ui:VisualElement>
                        <ui:Label name="HeroDetailArchetype" class="sm-hd-archetype" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sm-hd-section">
                        <ui:Label class="sm-hd-section__cap" text="특성 · TRAITS" />
                        <ui:VisualElement name="HeroDetailTraits" class="sm-hd-traits" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="HeroDetailCenter" class="sm-hd-center">
                    <ui:VisualElement class="sm-hd-section">
                        <ui:Label class="sm-hd-section__cap" text="능력치 · STATS" />
                        <ui:VisualElement name="HeroDetailStats" class="sm-hd-stats" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sm-hd-section sm-hd-section--skills">
                        <ui:Label class="sm-hd-section__cap" text="스킬 위계 · SKILL HIERARCHY" />
                        <ui:VisualElement name="HeroDetailSkills" class="sm-hd-skills" picking-mode="Ignore" />
                        <ui:Label class="sm-hd-skill-legend" text="● 시그니처 잠금   ✓ 플렉스 장착   ↻ 재훈련 풀   ✦ 후반 해금" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="HeroDetailRight" class="sm-hd-right">
                    <ui:VisualElement class="sm-hd-section">
                        <ui:Label class="sm-hd-section__cap" text="장비 · EQUIPMENT" />
                        <ui:VisualElement name="HeroDetailEquip" class="sm-hd-equip" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
