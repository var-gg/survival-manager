/* Common.HeroDetail v0.5 → UITK (scoped). ornate CSS는 buildable subset으로 적응:
   pseudo-element/grid/box-shadow/filter/gradient-text/gap 미사용(이 Unity UITK는 gap 미지원 →
   child margin으로 간격), 토큰 + flex + custom property accent. */

.sm-hd-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.sm-hd-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--sm-backdrop-dim);
}

.sm-hd-frame {
    width: 1040px;
    max-width: 94%;
    max-height: 90%;
    padding: var(--sm-s-5);
    background-color: var(--sm-bg-1);
    border-width: 1px;
    border-color: var(--sm-gold-500);
}

/* TOP BAR */
.sm-hd-top {
    flex-direction: row;
    align-items: center;
    padding-bottom: var(--sm-s-3);
    margin-bottom: var(--sm-s-4);
    border-bottom-width: 1px;
    border-bottom-color: var(--sm-gold-500);
}

.sm-hd-eyebrow {
    margin-right: var(--sm-s-3);
    color: var(--sm-gold-300);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
}

.sm-hd-title {
    flex-grow: 1;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-xl);
    -unity-font-style: bold;
}

/* BODY: 3-rail */
.sm-hd-body {
    flex-direction: row;
}

.sm-hd-left {
    --hd-accent: var(--sm-gold-300);
    width: 264px;
    flex-shrink: 0;
    margin-right: var(--sm-s-4);
}

.sm-hd-left--vanguard { --hd-accent: var(--sm-fam-vanguard); }
.sm-hd-left--duelist { --hd-accent: var(--sm-fam-striker); }
.sm-hd-left--ranger { --hd-accent: var(--sm-fam-ranger); }
.sm-hd-left--mystic { --hd-accent: var(--sm-fam-mystic); }
.sm-hd-left--beastkin { --hd-accent: var(--sm-fam-beastkin); }

.sm-hd-center {
    flex-grow: 1;
    margin-right: var(--sm-s-4);
}

.sm-hd-right {
    width: 240px;
    flex-shrink: 0;
}

/* SECTION shell — rail 안에서 세로로 쌓이므로 margin-bottom */
.sm-hd-section {
    margin-bottom: var(--sm-s-3);
    padding: var(--sm-s-3);
    background-color: var(--sm-vellum-a06);
    border-width: 1px;
    border-color: var(--sm-gold-300-a24);
}

.sm-hd-section__cap {
    color: var(--sm-gold-200);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
    padding-bottom: var(--sm-s-1);
    margin-bottom: var(--sm-s-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--sm-line-2);
}

/* PORTRAIT + NAMEPLATE */
.sm-hd-portrait {
    height: 200px;
    margin-bottom: var(--sm-s-3);
    align-items: center;
    justify-content: center;
    background-color: var(--sm-bg-portrait-a82);
    border-width: 1px;
    border-color: var(--hd-accent);
}

.sm-hd-portrait__glyph {
    color: var(--hd-accent);
    font-size: var(--sm-fs-3xl);
    -unity-font-style: bold;
}

.sm-hd-nameplate {
    margin-bottom: var(--sm-s-3);
}

.sm-hd-name {
    color: var(--sm-ink-0);
    font-size: var(--sm-fs-l);
    -unity-font-style: bold;
    white-space: normal;
}

.sm-hd-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--sm-s-1);
}

.sm-hd-chip {
    margin-right: var(--sm-s-1);
    margin-top: 2px;
    padding-left: var(--sm-chip-px);
    padding-right: var(--sm-chip-px);
    padding-top: var(--sm-chip-py);
    padding-bottom: var(--sm-chip-py);
    font-size: var(--sm-fs-xs);
    -unity-font-style: bold;
    color: var(--sm-chip-category-text);
    background-color: var(--sm-chip-category-bg);
    border-width: 1px;
    border-color: var(--sm-chip-category-border);
}

.sm-hd-chip--level { color: var(--sm-gold-100); border-color: var(--sm-gold-300-a42); }
.sm-hd-chip--tier { color: var(--sm-gold-200); border-color: var(--sm-gold-muted-a54); }
.sm-hd-chip--role { color: var(--hd-accent); border-color: var(--hd-accent); }

.sm-hd-archetype {
    margin-top: var(--sm-s-1);
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-s);
    white-space: normal;
}

/* STATS — 2 column flex wrap */
.sm-hd-stats {
    flex-direction: row;
    flex-wrap: wrap;
}

.sm-hd-stat {
    width: 50%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-right: var(--sm-s-3);
}

.sm-hd-stat__label {
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-eb);
}

.sm-hd-stat__value {
    color: var(--sm-gold-200);
    font-size: var(--sm-fs-s);
    -unity-font-style: bold;
}

.sm-hd-stat--tone-vital .sm-hd-stat__value { color: var(--sm-state-danger); }
.sm-hd-stat--tone-attack .sm-hd-stat__value { color: var(--sm-state-danger); }
.sm-hd-stat--tone-guard .sm-hd-stat__value { color: var(--sm-state-info); }
.sm-hd-stat--tone-magic .sm-hd-stat__value { color: var(--sm-fam-mystic-glow); }
.sm-hd-stat--tone-tempo .sm-hd-stat__value { color: var(--sm-state-safe); }

/* SKILL GRID — 4 slot with hierarchy modifier */
.sm-hd-skills {
    flex-direction: row;
}

.sm-hd-skill-legend {
    margin-top: var(--sm-s-2);
    color: var(--sm-ink-3);
    font-size: var(--sm-fs-xs);
    white-space: normal;
}

.sm-hd-slot {
    --slot-accent: var(--sm-gold-300);
    flex-grow: 1;
    flex-basis: 0;
    margin-right: var(--sm-s-2);
    align-items: center;
    padding: var(--sm-s-2);
    background-color: var(--sm-bg-2-a78);
    border-width: 1px;
    border-color: var(--slot-accent);
    border-top-width: 3px;
}

.sm-hd-slot--signature { --slot-accent: var(--sm-gold-300); }
.sm-hd-slot--flex-active { --slot-accent: var(--sm-state-safe); }
.sm-hd-slot--flex-retrain { --slot-accent: var(--sm-ink-3); opacity: 0.86; }
.sm-hd-slot--late-unlock { --slot-accent: var(--sm-rare-epic); }

.sm-hd-slot__icon {
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sm-s-1);
    background-color: var(--sm-bg-portrait-a82);
    border-width: 1px;
    border-color: var(--slot-accent);
}

.sm-hd-slot-icon--fallback { border-color: var(--sm-ink-3); }
.sm-hd-slot-icon--missing { background-color: var(--sm-bg-portrait-missing-a66); border-color: var(--sm-ink-4); }

.sm-hd-slot__icon-glyph {
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-m);
    -unity-font-style: bold;
}

.sm-hd-slot__badge {
    position: absolute;
    top: -6px;
    right: -6px;
    color: var(--slot-accent);
    font-size: var(--sm-fs-xs);
    -unity-font-style: bold;
}

.sm-hd-slot__name {
    color: var(--sm-vellum);
    font-size: var(--sm-fs-s);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.sm-hd-slot__meta {
    color: var(--sm-ink-3);
    font-size: var(--sm-fs-xs);
    -unity-text-align: middle-center;
}

.sm-hd-slot__cd {
    margin-top: 2px;
    color: var(--sm-gold-200);
    font-size: var(--sm-fs-xs);
}

/* EQUIPMENT — 세로 스택, child margin-bottom */
.sm-hd-equip-slot {
    margin-bottom: var(--sm-s-2);
    padding: var(--sm-s-2);
    background-color: var(--sm-bg-2-a78);
    border-width: 1px;
    border-color: var(--sm-gold-muted-a54);
    border-left-width: 3px;
}

.sm-hd-equip-slot--empty {
    border-color: var(--sm-ink-3);
    opacity: 0.7;
}

.sm-hd-equip-slot__label {
    color: var(--sm-ink-3);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
}

.sm-hd-equip-slot__name {
    color: var(--sm-vellum);
    font-size: var(--sm-fs-s);
    white-space: normal;
}

.sm-hd-equip-slot__meta {
    color: var(--sm-ink-3);
    font-size: var(--sm-fs-xs);
}

/* TRAITS — 세로 스택, child margin-bottom */
.sm-hd-trait {
    --trait-accent: var(--sm-gold-300);
    margin-bottom: var(--sm-s-1);
    padding: var(--sm-s-2);
    background-color: var(--sm-bg-2-a78);
    border-left-width: 3px;
    border-left-color: var(--trait-accent);
}

.sm-hd-trait--boon { --trait-accent: var(--sm-state-safe); }
.sm-hd-trait--bane { --trait-accent: var(--sm-state-danger); }

.sm-hd-trait__name {
    color: var(--sm-vellum);
    font-size: var(--sm-fs-s);
    white-space: normal;
}
