/* Production-owned styles migrated from Assets/_Game/UI/Screens/Town/Preview/EquipmentRefitPreview.uss.
   Keep production panel UXML free of Screens/Town/Preview imports. */

/* Equipment / Refit modal V1 production
   SoT: pindoc://town-ui-ux-시안-갤러리-v1 (2)
   tone: deep navy frame + gold trim + 3 section (standee / affix list / inventory pool) */

.erp-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: var(--sm-ink-1); }
/* wave-41: flex-grow: 1 -> position: absolute. host flex 슬롯에 갇혀 화면 절반만 차지하던 z-order 이슈 해소. */

.erp-backdrop {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("project://database/Assets/_Game/UI/Backdrops/ui_equipment_refit_dusk.png");
    -unity-background-scale-mode: scale-and-crop;
}
.erp-backdrop-dim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(12, 17, 38, 0.78); }
/* wave-41: dim 0.32 -> 0.78. Town hub UI가 backdrop edge로 새던 z-order 이슈 해소. */

/* Modal frame — position absolute (코너 cap 앵커 + inset 정합). chrome = outer frame PNG + 코너 ornament + sm-fx-depth. */
.erp-frame { position: absolute; left: 60px; right: 60px; top: 50px; bottom: 50px; }

.erp-header {
    flex-direction: row; align-items: center; justify-content: space-between;
    padding-top: 18px; padding-bottom: 18px; padding-left: var(--sm-s-6); padding-right: var(--sm-s-6);
    border-bottom-width: 1px; border-bottom-color: rgba(230,183,81,0.32);
}
.erp-header__title { font-size: var(--sm-fs-l); color: var(--sm-gold-100); letter-spacing: 3px; -unity-font-style: bold; }
.erp-header__close { width: 36px; height: 36px; background-color: rgba(38,45,84,0.86); color: var(--sm-gold-200);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(230,183,81,0.55); border-right-color: rgba(230,183,81,0.55);
    border-top-color: rgba(230,183,81,0.55); border-bottom-color: rgba(230,183,81,0.55);
}

.erp-columns { flex-direction: row; flex-grow: 1; padding: 18px; }
.erp-col { margin-left: var(--sm-s-2); margin-right: var(--sm-s-2); flex-direction: column; }
.erp-col--standee { flex-direction: column; width: 280px; }
.erp-col--affix { flex-grow: 1; }
.erp-col--pool { width: 340px; }

/* Standee column — 장착 hero standee + 3 slot (row), 그 아래 선택 item 컨텍스트 */
.erp-standee-row { flex-direction: row; flex-grow: 1; }
.erp-standee { width: 200px; background-color: var(--sm-vellum-a06); border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(230,183,81,0.32);
    border-right-color: rgba(230,183,81,0.32); border-top-color: rgba(230,183,81,0.32); border-bottom-color: rgba(230,183,81,0.32);
}
.erp-standee__portrait { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; }

/* 선택 item 컨텍스트 — item 이름·slot + 장착 hero (EquippedHeroId 파생) */
.erp-item-context {
    flex-direction: column;
    margin-top: var(--sm-s-3);
    padding: 10px 12px;
    background-color: rgba(28,34,67,0.78);
    border-left-width: 2px;
    border-left-color: var(--sm-gold-300);
}
.erp-item-context__name {
    color: var(--sm-gold-100);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}
.erp-item-context__hero {
    color: var(--sm-ink-2);
    font-size: 10px;
    letter-spacing: 1px;
    margin-top: 3px;
}

.erp-slot-stack { flex-direction: column; justify-content: space-around; padding-left: var(--sm-s-3); }
.erp-slot {
    width: 56px; height: 56px; background-color: rgba(28,34,67,0.86);
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300); border-right-color: var(--sm-gold-300);
    border-top-color: var(--sm-gold-300); border-bottom-color: var(--sm-gold-300);
    -unity-background-scale-mode: scale-to-fit;
}
.erp-slot--weapon { border-left-color: rgba(180, 90, 210, 0.85); border-right-color: rgba(180, 90, 210, 0.85);
    border-top-color: rgba(180, 90, 210, 0.85); border-bottom-color: rgba(180, 90, 210, 0.85); }

/* Affix list column — item-and-affix-system.md V1: implicit 1 + prefix 2 + suffix 2 = 5 line */
.erp-affix-list { flex-grow: 1; flex-direction: column; }

/* Group header (IMPLICIT / PREFIX / SUFFIX) */
.erp-affix-group {
    font-size: 10px; letter-spacing: 3px; -unity-font-style: bold;
    color: var(--sm-gold-300);
    padding-top: 6px; padding-bottom: 2px; padding-left: var(--sm-s-1);
    margin-bottom: 2px;
}
.erp-affix-group--implicit { color: var(--sm-gold-200); }
.erp-affix-group--prefix   { color: rgba(127, 163, 224, 0.92); }
.erp-affix-group--suffix   { color: var(--sm-state-safe-a92); }

.erp-affix-row {
    height: 38px; flex-direction: row; align-items: center; margin-bottom: var(--sm-s-1);
    padding-left: var(--sm-s-3); padding-right: var(--sm-s-4);
    background-color: rgba(28,34,67,0.72);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(230,183,81,0.32); border-right-color: rgba(230,183,81,0.32);
    border-top-color: rgba(230,183,81,0.32); border-bottom-color: rgba(230,183,81,0.32);
}
/* Group tint — implicit는 gold strip, prefix는 blue, suffix는 green left border */
.erp-affix-row--implicit { border-left-width: 3px; border-left-color: var(--sm-gold-200); }
.erp-affix-row--prefix   { border-left-width: 3px; border-left-color: rgba(127, 163, 224, 0.78); }
.erp-affix-row--suffix   { border-left-width: 3px; border-left-color: rgba(166, 220, 154, 0.78); }

.erp-affix-row--selected {
    background-color: rgba(38,45,84,0.92);
    border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200);
    border-bottom-color: var(--sm-gold-200);
    border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
}
.erp-affix-row__icon { width: 28px; height: 28px; -unity-background-scale-mode: scale-to-fit; margin-right: 10px; }
/* affix 이름 — AffixDefinition.NameKey resolved */
.erp-affix-row__name {
    flex-grow: 1;
    color: var(--sm-vellum);
    font-size: var(--sm-fs-s);
    -unity-font-style: bold;
}
/* 실제 instance magnitude + percentile + AffixDefinition.ValueMin~ValueMax context */
.erp-affix-row__value {
    color: var(--sm-gold-200);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin-left: var(--sm-s-2);
}

/* CTA block */
.erp-cta-block { flex-direction: row; align-items: center; justify-content: flex-end; margin-top: var(--sm-s-3); }
.erp-echo-cost { flex-direction: row; align-items: center; margin-right: var(--sm-s-4);
    padding-top: var(--sm-s-2); padding-bottom: var(--sm-s-2); padding-left: var(--sm-s-3); padding-right: var(--sm-s-3);
    background-color: rgba(38,45,84,0.78);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(140,98,210,0.85); border-right-color: rgba(140,98,210,0.85);
    border-top-color: rgba(140,98,210,0.85); border-bottom-color: rgba(140,98,210,0.85);
}
.erp-echo-cost__icon { width: 28px; height: 28px; -unity-background-scale-mode: scale-to-fit; margin-right: var(--sm-s-2); }
.erp-echo-cost__icon--echo { background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Currency/currency_echo.png"); }
.erp-echo-cost__glyph { width: 50px; height: 6px; background-color: rgba(180,150,230,0.78); }

/* Refit CTA: visual은 sm-cta sm-cta--lg sm-cta--primary. 15 Echo single-affix reroll.
   uxqa1: 고정폭 220px은 영문 placeholder 기준이라 한글 라벨이 보더 밖으로 흘러나옴
   — min-width로 완화해 라벨이 버튼을 키우게. */
.erp-refit-cta { min-width: 220px; }
.erp-refit-cta__label {
    color: rgba(61, 47, 18, 1);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* Pool column */
.erp-pool { flex-grow: 1; flex-direction: column; padding-top: 0; }
/* uxqa1: flex-shrink 기본 1이라 인벤토리가 늘면 row가 부모 높이에 맞춰 짓눌려
   판독 불가 줄무늬가 되던 것 차단 (InventoryPool ScrollView 전환과 세트). */
.erp-pool-row { flex-direction: row; align-items: center; height: 40px; flex-shrink: 0; margin-bottom: 6px;
    padding-left: var(--sm-s-2); padding-right: var(--sm-s-3);
    background-color: rgba(28,34,67,0.72);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(230,183,81,0.32); border-right-color: rgba(230,183,81,0.32);
    border-top-color: rgba(230,183,81,0.32); border-bottom-color: rgba(230,183,81,0.32);
}
.erp-pool-row--selected {
    background-color: rgba(38,45,84,0.92);
    border-left-color: var(--sm-gold-200); border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200); border-bottom-color: var(--sm-gold-200);
}
.erp-pool-row__weapon-icon { width: 28px; height: 28px; -unity-background-scale-mode: scale-to-fit; margin-right: 10px;
    background-color: var(--sm-vellum-a18); }
/* item 이름 — ItemBaseDefinition.NameKey resolved */
.erp-pool-row__name {
    flex-grow: 1;
    color: var(--sm-vellum);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
}
/* slot 표기 — ItemBaseDefinition.SlotType (weapon/armor/accessory) */
.erp-pool-row__slot {
    color: var(--sm-ink-3);
    font-size: var(--sm-fs-xs);
    letter-spacing: 1px;
    margin-left: 6px;
    margin-right: 6px;
}
.erp-pool-row__family,
.erp-pool-row__identity {
    font-size: 8px;
    margin-left: var(--sm-s-1);
    margin-right: var(--sm-s-1);
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 1px;
    padding-bottom: 1px;
}
.erp-pool-row__rarity { width: 12px; height: 12px; margin-left: 6px;
    border-top-left-radius: var(--sm-r-lg); border-top-right-radius: var(--sm-r-lg); border-bottom-left-radius: var(--sm-r-lg); border-bottom-right-radius: var(--sm-r-lg);
}
.erp-pool-row__rarity.sm-item-rarity {
    min-width: 12px;
    max-width: 12px;
}

.erp-pool-actions { flex-direction: row; justify-content: space-around; padding-top: var(--sm-s-2); }
.erp-pool-actions__chip {
    width: 32px; height: 24px;
    background-color: rgba(38,45,84,0.72);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42); border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42); border-bottom-color: var(--sm-gold-300-a42);
}

/* Panel-local ArtBible ownership overrides. */
.erp-frame {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/ArtBible/Frame/ui_panel_frame_outer.png");
    -unity-slice-left: 96;
    -unity-slice-right: 96;
    -unity-slice-top: 96;
    -unity-slice-bottom: 96;
    -unity-slice-scale: 0.5;
    background-color: var(--sm-bg-0);
}

.erp-standee,
.erp-item-context,
.erp-col--affix,
.erp-col--pool {
    background-color: var(--sm-bg-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a20);
    border-right-color: var(--sm-gold-300-a20);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-line-1);
    border-top-left-radius: var(--sm-r-lg);
    border-top-right-radius: var(--sm-r-lg);
    border-bottom-left-radius: var(--sm-r-lg);
    border-bottom-right-radius: var(--sm-r-lg);
}

.erp-affix-row,
.erp-pool-row {
    background-color: var(--sm-bg-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-line-1);
    border-right-color: var(--sm-line-1);
    border-top-color: var(--sm-line-2);
    border-bottom-color: var(--sm-line-1);
    border-top-left-radius: var(--sm-r-md);
    border-top-right-radius: var(--sm-r-md);
    border-bottom-left-radius: var(--sm-r-md);
    border-bottom-right-radius: var(--sm-r-md);
}

.erp-affix-row.sm-affix-row,
.erp-pool-row.sm-item-cell {
    background-color: var(--sm-bg-2);
}

.erp-affix-row--selected,
.erp-pool-row--selected {
    background-color: var(--sm-bg-3);
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-200);
    border-bottom-color: var(--sm-gold-300-a42);
}

.erp-pool-row__slot.sm-item-badge,
.erp-pool-row__family.sm-item-badge,
.erp-pool-row__identity.sm-item-identity {
    min-width: 0;
}

.erp-slot,
.erp-standee__portrait,
.erp-affix-row__icon,
.erp-pool-row__weapon-icon,
.erp-echo-cost__icon {
    background-color: var(--sm-bg-0-a84);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-vellum-a12);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a15);
    border-bottom-color: var(--sm-vellum-a09);
    border-top-left-radius: var(--sm-r-md);
    border-top-right-radius: var(--sm-r-md);
    border-bottom-left-radius: var(--sm-r-md);
    border-bottom-right-radius: var(--sm-r-md);
}
