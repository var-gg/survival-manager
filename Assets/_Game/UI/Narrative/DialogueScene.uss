/* 미연시(비주얼 노벨) 스타일 — 상단 큰 포트레잇 무대 + 하단 대사창 */

.dialogue-scene-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(16, 15, 20);
}

/* 포트레잇 무대 — 화면 위쪽, 대사창 바로 위까지 */
.dialogue-scene-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 232px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-left: 88px;
    padding-right: 88px;
}

/* 슬롯 — 포트레잇 표시 영역. 높이 고정, 무대 하단(대사창 위)에 정렬 */
.dialogue-scene-slot {
    width: 478px;
    height: 730px;
    max-height: 100%;
}

/* 버스트 — 잘라내지 않고 비율 유지(contain), 바닥 기준 정렬 */
.dialogue-scene-portrait {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-position-x: center;
    background-position-y: bottom;
    background-repeat: no-repeat;
}

/* 하단 대사창 — 화면 폭을 거의 가득 채우는 미연시 텍스트 박스 */
.dialogue-scene-dialoguebox {
    position: absolute;
    left: 48px;
    right: 48px;
    bottom: 36px;
    min-height: 216px;
}

.dialogue-scene-dialoguebox-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--sm-s-3);
}

.dialogue-scene-nameplate {
    font-size: 21px;
    margin-bottom: 0;
}

.dialogue-scene-line {
    font-size: var(--sm-fs-xl);
    min-height: 92px;
    white-space: normal;
}

.dialogue-scene-continue-hint {
    margin-top: 14px;
    -unity-text-align: middle-right;
}

.dialogue-scene-skip-button {
    min-width: 112px;
}

/* skip 확인 오버레이 */
.dialogue-scene-skip-confirm-panel {
    width: 440px;
    max-width: 90%;
}

.dialogue-scene-confirm-title {
    color: var(--story-accent-color);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: var(--sm-s-2);
}

.dialogue-scene-confirm-body {
    color: var(--story-text-color);
    white-space: normal;
    margin-bottom: 18px;
}

.dialogue-scene-confirm-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.dialogue-scene-confirm-actions > Button {
    margin-left: 10px;
}
