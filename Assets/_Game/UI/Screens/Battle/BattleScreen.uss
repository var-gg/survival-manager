    border-left-color: var(--sm-gold-300-a34);
    border-right-color: var(--sm-gold-300-a34);
    border-top-color: var(--sm-gold-300-a34);
    border-bottom-color: var(--sm-gold-300-a34);
}

.battle-screen .sm-bs-combatant-token {
    position: relative;
    width: 112px;
    height: 34px;
    min-width: 88px;
    margin-right: 7px;
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(18, 24, 38, 0.88);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a12);
    border-bottom-color: var(--sm-vellum-a12);
}

.battle-screen .sm-bs-combatant-token--ally {
    border-left-color: var(--sm-state-shield-a82);
}

.battle-screen .sm-bs-combatant-token--enemy {
    border-left-color: var(--sm-fam-striker);
}

.battle-screen .sm-bs-combatant-token--active {
    background-color: rgba(70, 49, 16, 0.92);
    border-top-color: var(--sm-gold-300-a78);
    border-bottom-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-combatant-token--down {
    opacity: 0.46;
}

.battle-screen .sm-bs-combatant-token__mark {
    width: 24px;
    min-width: 24px;
    height: 24px;
    margin-right: 6px;
