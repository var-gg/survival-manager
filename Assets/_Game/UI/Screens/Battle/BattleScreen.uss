    border-color: var(--sm-gold-muted-a54);
}

.battle-screen .sm-bs-combatant-token__copy {
    flex-grow: 1;
    min-width: 0;
}

.battle-screen .sm-bs-combatant-token__name {
    color: var(--sm-vellum);
    font-size: 10px;
