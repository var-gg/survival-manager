.battle-screen {
    background-color: var(--sm-transparent);
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.battle-screen .sm-bs-debug-foldout {
    display: none;
}

.battle-screen .sm-bs-topbar {
    position: absolute;
    top: 8px;
    left: 12px;
    right: 12px;
    height: 48px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--sm-s-3);
    padding-right: 10px;
    background-color: var(--sm-bg-1-a54);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a28);
    border-right-color: var(--sm-gold-300-a28);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a28);
}

.battle-screen .sm-bs-title {
    width: 150px;
    color: var(--sm-gold-200);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

/* Hide dev locale chrome in production handoff view. */
.battle-screen #LocaleStatusLabel,
.battle-screen #LocaleKoButton,
.battle-screen #LocaleEnButton,
.battle-screen #HelpButton,
.battle-screen #HelpStrip {
    display: none;
}

.battle-screen .sm-bs-top-status {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin-left: var(--sm-s-2);
    margin-right: var(--sm-s-2);
}

.battle-screen .sm-bs-summary-header {
    display: none;
}

.battle-screen .sm-bs-summary-body {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.battle-screen .sm-bs-status-headline {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.battle-screen .sm-bs-result {
    min-width: 130px;
    color: var(--sm-vellum);
    font-size: var(--sm-fs-m);
    -unity-font-style: bold;
}

.battle-screen .sm-bs-status-text {
    flex-grow: 1;
    margin-left: 10px;
    color: var(--sm-ink-1);
    font-size: var(--sm-fs-s);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-speed {
    min-width: 150px;
    margin-left: 10px;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-eb);
    -unity-text-align: middle-right;
}

.battle-screen .sm-bs-progress-track {
    width: 210px;
    height: 6px;
    margin-left: var(--sm-s-3);
    background-color: var(--sm-vellum-a12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a24);
    border-right-color: var(--sm-gold-300-a24);
    border-top-color: var(--sm-gold-300-a24);
    border-bottom-color: var(--sm-gold-300-a24);
}

.battle-screen .sm-bs-progress-fill {
    height: 100%;
    background-color: var(--sm-gold-300);
}

.battle-screen .sm-bs-settings-entry {
    min-width: 82px;
    min-height: 30px;
    margin-left: 6px;
}

.battle-screen .sm-bs-help-strip {
    position: absolute;
    top: 62px;
    left: 12px;
    right: 12px;
    z-index: 8;
    background-color: var(--sm-bg-0-a84);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a32);
    border-right-color: var(--sm-gold-300-a32);
    border-top-color: var(--sm-gold-300-a32);
    border-bottom-color: var(--sm-gold-300-a32);
}

.battle-screen .sm-bs-layout {
    position: absolute;
    top: 188px;
    left: 12px;
    right: 12px;
    bottom: 252px;
}

.battle-screen .sm-bs-center {
    flex-grow: 1;
}

.battle-screen .sm-bs-stage {
    flex-grow: 1;
    opacity: 0;
}

.battle-screen .sm-bs-team-column,
.battle-screen .sm-bs-unit-detail-panel,
.battle-screen .sm-bs-event-feed,
.battle-screen .sm-bs-readout-panel,
.battle-screen .sm-bs-settings-panel {
    background-color: var(--sm-bg-2-a78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a36);
    border-right-color: var(--sm-gold-300-a36);
    border-top-color: var(--sm-gold-300-a36);
    border-bottom-color: var(--sm-gold-300-a36);
}

/* 팀 기둥의 위치·치수는 파일 끝 "시안 재정렬" 블록이 소유한다. */
.battle-screen .sm-bs-team-column {
    position: absolute;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
}

.battle-screen .sm-bs-rail-title {
    color: var(--sm-gold-200);
    font-size: 13px;
    -unity-font-style: bold;
}

.battle-screen .sm-bs-rail-summary {
    margin-top: 6px;
    color: var(--sm-ink-1);
    font-size: var(--sm-fs-eb);
    white-space: normal;
}

.battle-screen .sm-bs-roster-list {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.battle-screen .sm-bs-roster-unit {
    margin-right: 10px;
    padding-top: var(--sm-s-2);
    padding-bottom: var(--sm-s-2);
    padding-left: var(--sm-s-2);
    padding-right: var(--sm-s-2);
    flex-direction: row;
    align-items: center;
    background-color: var(--sm-vellum-a08);
    border-left-width: 3px;
    border-left-color: var(--sm-fam-mystic);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--sm-vellum-a10);
    border-bottom-color: var(--sm-vellum-a10);
    border-right-color: var(--sm-vellum-a10);
}

.battle-screen .sm-bs-roster-list--ally .sm-bs-roster-unit {
    flex-grow: 1;
    min-width: 236px;
    max-width: 314px;
    min-height: 184px;
}

.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-unit {
    flex-grow: 1;
    min-width: 196px;
    max-width: 292px;
    min-height: 92px;
    padding-top: 7px;
    padding-bottom: 7px;
}

.battle-screen .sm-bs-roster-unit--enemy {
    border-left-color: var(--sm-fam-striker);
}

.battle-screen .sm-bs-roster-unit--selected {
    background-color: var(--sm-gold-300-a20);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
}

.battle-screen .sm-bs-roster-unit--down {
    opacity: 0.58;
}

.battle-screen .sm-bs-roster-portrait {
    position: relative;
    width: 128px;
    height: 152px;
    min-width: 128px;
    margin-right: var(--sm-s-3);
    background-color: var(--sm-bg-portrait-a82);
    border-width: 1px;
    border-color: var(--sm-gold-muted-a54);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
    -unity-text-align: middle-center;
    color: var(--sm-gold-200);
    -unity-font-style: bold;
    font-size: 22px;
}

.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-portrait {
    width: 64px;
    height: 76px;
    min-width: 64px;
    margin-right: 10px;
    font-size: 16px;
}

.battle-screen .sm-bs-roster-portrait-image {
    position: absolute;
}

.battle-screen .sm-bs-roster-portrait-initial {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: var(--sm-gold-200);
    -unity-font-style: bold;
    font-size: 22px;
}

.battle-screen .sm-bs-roster-portrait--missing {
    background-color: var(--sm-bg-portrait-missing-a66);
}

.battle-screen .sm-bs-roster-meta {
    flex-grow: 1;
}

.battle-screen .sm-bs-roster-name {
    color: var(--sm-ink-0);
    font-size: var(--sm-fs-s);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-roster-status {
    margin-top: 5px;
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-eb);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-roster-hp-track {
    margin-top: var(--sm-s-3);
    height: 8px;
    background-color: var(--sm-vellum-a10);
}

.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-hp-track {
    height: 5px;
    margin-top: 7px;
}

.battle-screen .sm-bs-roster-hp-fill {
    height: 100%;
    background-color: var(--sm-state-safe-a86);
}

.battle-screen .sm-bs-event-feed {
    position: absolute;
    left: 410px;
    right: 410px;
    bottom: 10px;
    min-height: 64px;
    max-height: 92px;
    padding-top: var(--sm-s-2);
    padding-bottom: var(--sm-s-2);
    padding-left: 10px;
    padding-right: 10px;
    opacity: 0.92;
}

.battle-screen .sm-bs-event-feed .sm-bs-section-title {
    color: var(--sm-gold-200);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
}

.battle-screen .sm-bs-log-text {
    margin-top: 3px;
    white-space: normal;
    color: var(--sm-ink-1);
    font-size: var(--sm-fs-eb);
    line-height: 15px;
}

.battle-screen .sm-bs-turn-order {
    display: none;
}

.battle-screen .sm-bs-control-bar {
    /* wave-27 GPT Pro patch: command ribbon을 화면 중심 고정 (battlefield 위 항상 가운데). */
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 520px;
    min-width: 480px;
    margin-left: -260px;
    height: 96px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    /* wave-test-cleanup: art bible AB151 정책 위반. */
    background-image: none;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-background-image-tint-color: rgba(255, 235, 200, 0.24);
    background-color: rgba(28, 22, 12, 0.86);
    border-width: 1px;
    border-color: var(--sm-gold-300-a42);
}

/* wave-27 GPT Pro patch: debug foldout과 debug control btn은 production capture에서 hide.
   battle-screen--debug modifier에서만 표시. */
.battle-screen .sm-bs-debug-foldout,
.battle-screen .sm-bs-control-btn--debug {
    display: none;
}

.battle-screen.battle-screen--debug .sm-bs-debug-foldout,
.battle-screen.battle-screen--debug .sm-bs-control-btn--debug {
    display: flex;
}

.battle-screen .sm-bs-control-group {
    margin-left: var(--sm-s-2);
    margin-bottom: 0;
}

.battle-screen .sm-bs-control-bar .sm-bs-control-title {
    display: none;
}

.battle-screen .sm-bs-control-title {
    color: var(--sm-gold-100);
    font-size: 10px;
    -unity-font-style: bold;
}

.battle-screen .sm-bs-control-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.battle-screen .sm-bs-control-bar .sm-bs-control-row {
    flex-wrap: nowrap;
    align-items: center;
}

.battle-screen .sm-bs-control-btn {
    min-height: 30px;
    min-width: 68px;
    margin-top: 5px;
    margin-right: 5px;
    padding-left: var(--sm-s-2);
    padding-right: var(--sm-s-2);
    background-color: var(--sm-vellum-a09);
    color: var(--sm-vellum);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a34);
    border-right-color: var(--sm-gold-300-a34);
    border-top-color: var(--sm-gold-300-a34);
    border-bottom-color: var(--sm-gold-300-a34);
}

.battle-screen .sm-bs-control-bar .sm-bs-control-btn {
    min-height: 28px;
    min-width: 56px;
    margin-top: 0;
    margin-right: var(--sm-s-1);
    margin-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    font-size: var(--sm-fs-eb);
}

.battle-screen .sm-bs-control-btn:hover {
    background-color: var(--sm-gold-300-a20);
}

.battle-screen .sm-bs-control-btn--small {
    min-width: 58px;
}

.battle-screen .sm-bs-control-bar .sm-bs-control-btn--small {
    min-width: 48px;
}

.battle-screen .sm-bs-control-btn--primary {
    background-color: var(--sm-gold-300-a24);
}

.battle-screen .sm-bs-control-btn--debug {
    border-left-color: var(--sm-fam-vanguard-glow-a45);
    border-right-color: var(--sm-fam-vanguard-glow-a45);
    border-top-color: var(--sm-fam-vanguard-glow-a45);
    border-bottom-color: var(--sm-fam-vanguard-glow-a45);
}

.battle-screen .sm-bs-control-btn--warning {
    border-left-color: var(--sm-state-warn-a56);
    border-right-color: var(--sm-state-warn-a56);
    border-top-color: var(--sm-state-warn-a56);
    border-bottom-color: var(--sm-state-warn-a56);
}

.battle-screen .sm-bs-utility-group {
    display: none;
}

.battle-screen .sm-bs-unit-detail-backdrop {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 8;
    align-items: flex-end;
    justify-content: center;
    padding-right: var(--sm-s-5);
    background-color: var(--sm-bg-void-a20);
}

.battle-screen .sm-bs-unit-detail-panel {
    position: relative;
    width: 760px;
    min-width: 720px;
    max-width: 960px;
    height: 660px;
    min-height: 540px;
    max-height: 720px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 72px;
}

.battle-screen .sm-bs-unit-detail-backdrop--mobile {
    align-items: center;
    justify-content: flex-end;
    padding-right: 10px;
    padding-left: 10px;
    padding-bottom: 10px;
}

.battle-screen .sm-bs-unit-detail-backdrop--mobile .sm-bs-unit-detail-panel {
    width: 100%;
    min-width: 0;
    height: 75%;
    min-height: 0;
    margin-bottom: 0;
}

.battle-screen .sm-bs-unit-detail-backdrop--mobile .sm-bs-unit-detail-content {
    flex-direction: column;
}

.battle-screen .sm-bs-unit-detail-backdrop--mobile .sm-bs-unit-illustration-pane {
    width: 100%;
    min-width: 0;
    height: 180px;
    margin-right: 0;
    margin-bottom: 10px;
}

.battle-screen .sm-bs-unit-detail-header {
    flex-direction: row;
    align-items: center;
    min-height: 36px;
}

.battle-screen .sm-bs-unit-portrait {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 1px;
    border-color: var(--sm-gold-muted-a72);
    background-color: var(--sm-bg-portrait-a82);
    -unity-background-scale-mode: scale-and-crop;
}

.battle-screen .sm-bs-unit-detail-title {
    flex-grow: 1;
    white-space: normal;
}

.battle-screen .sm-bs-unit-detail-close {
    min-width: 34px;
    width: 34px;
    height: 30px;
    margin-left: var(--sm-s-2);
}

.battle-screen .sm-bs-unit-detail-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
    margin-bottom: 10px;
}

.battle-screen .sm-bs-unit-detail-tab {
    min-width: 86px;
    margin-right: 6px;
    font-size: var(--sm-fs-eb);
}

.battle-screen .sm-bs-unit-detail-tab--active {
    background-color: var(--sm-gold-300-a26);
    color: var(--sm-gold-100);
    border-left-color: var(--sm-gold-300-a78);
    border-right-color: var(--sm-gold-300-a78);
    border-top-color: var(--sm-gold-300-a78);
    border-bottom-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-unit-detail-body {
    white-space: normal;
    -unity-text-align: upper-left;
    color: var(--sm-ink-1);
    font-size: var(--sm-fs-s);
    line-height: 16px;
}

.battle-screen .sm-bs-unit-detail-content {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.battle-screen .sm-bs-unit-illustration-pane {
    position: relative;
    width: 40%;
    min-width: 292px;
    margin-right: 14px;
    background-color: var(--sm-bg-portrait-a70);
    border-width: 1px;
    border-color: var(--sm-gold-muted-a44);
    overflow: hidden;
}

.battle-screen .sm-bs-unit-ailment-tint {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--sm-state-injured-a22);
}

.battle-screen .sm-bs-unit-vitals {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
}

.battle-screen .sm-bs-unit-vital-track {
    height: 9px;
    margin-top: var(--sm-s-1);
    background-color: var(--sm-bg-vital-a72);
    border-width: 1px;
    border-color: var(--sm-vellum-a18);
}

.battle-screen .sm-bs-unit-vital-track--shield {
    height: 5px;
}

.battle-screen .sm-bs-unit-hp-fill {
    height: 100%;
    background-color: var(--sm-state-safe-a92);
}

.battle-screen .sm-bs-unit-shield-fill {
    height: 100%;
    background-color: var(--sm-state-shield-a82);
}

.battle-screen .sm-bs-unit-tab-body {
    flex-grow: 1;
    min-width: 0;
}

.battle-screen .sm-bs-unit-tab-content {
    flex-grow: 1;
}

.battle-screen .sm-bs-stat-grid,
.battle-screen .sm-bs-stat-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.battle-screen .sm-bs-stat-row {
    width: 48%;
    min-height: 34px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 7px;
    padding-right: 7px;
    background-color: var(--sm-vellum-a07);
    border-width: 1px;
    border-color: var(--sm-gold-300-a20);
}

.battle-screen .sm-bs-stat-row--compact {
    width: 48%;
    min-height: 32px;
}

.battle-screen .sm-bs-stat-label {
    color: var(--sm-ink-2);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-stat-value {
    margin-top: 2px;
    color: var(--sm-ink-0);
    font-size: var(--sm-fs-s);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-stat-category,
.battle-screen .sm-bs-subtitle,
.battle-screen .sm-bs-tactic-header {
    width: 100%;
    margin-top: var(--sm-s-2);
    margin-bottom: 5px;
    color: var(--sm-gold-200);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
}

.battle-screen .sm-bs-anchor-grid {
    width: 174px;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--sm-s-2);
    margin-bottom: var(--sm-s-2);
}

.battle-screen .sm-bs-anchor-cell {
    width: 52px;
    height: 32px;
    margin-right: 5px;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
    color: var(--sm-ink-2);
    font-size: 10px;
    background-color: var(--sm-vellum-a06);
    border-width: 1px;
    border-color: var(--sm-vellum-a15);
}

.battle-screen .sm-bs-anchor-cell--occupied {
    color: var(--sm-ink-0);
    border-color: var(--sm-gold-300-a36);
}

.battle-screen .sm-bs-anchor-cell--home {
    color: var(--sm-gold-100);
    background-color: var(--sm-gold-300-a25);
    border-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-dial-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.battle-screen .sm-bs-dial-row {
    width: 48%;
    margin-right: 6px;
    margin-bottom: var(--sm-s-2);
}

.battle-screen .sm-bs-dial-header {
    flex-direction: row;
}

.battle-screen .sm-bs-dial-label {
    flex-grow: 1;
    color: var(--sm-ink-1);
    font-size: 10px;
}

.battle-screen .sm-bs-dial-value {
    min-width: 34px;
    color: var(--sm-gold-100);
    font-size: 10px;
    -unity-text-align: middle-right;
}

.battle-screen .sm-bs-dial-track {
    height: 5px;
    margin-top: 3px;
    background-color: var(--sm-vellum-a10);
}

.battle-screen .sm-bs-dial-fill {
    height: 100%;
    background-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-skill-slots {
    margin-top: 10px;
    flex-direction: row;
    flex-wrap: wrap;
}

.battle-screen .sm-bs-skill-slot {
    width: 48%;
    min-height: 124px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 6px;
    padding-right: 6px;
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--sm-vellum-a08);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a28);
    border-right-color: var(--sm-gold-300-a28);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a28);
}

.battle-screen .sm-bs-skill-slot--signature {
    border-left-width: 3px;
    border-left-color: var(--sm-gold-300);
}

.battle-screen .sm-bs-skill-slot--flex {
    border-left-width: 3px;
    border-left-color: var(--sm-fam-mystic);
}

.battle-screen .sm-bs-skill-slot--active {
    background-color: var(--sm-gold-300-a10);
}

.battle-screen .sm-bs-skill-slot--heal,
.battle-screen .sm-bs-skill-slot--support {
    border-top-color: var(--sm-state-safe-a86);
}

.battle-screen .sm-bs-skill-slot--guard {
    border-top-color: var(--sm-fam-vanguard);
}

.battle-screen .sm-bs-skill-slot--control,
.battle-screen .sm-bs-skill-slot--area {
    border-top-color: var(--sm-fam-mystic);
}

.battle-screen .sm-bs-skill-slot--projectile,
.battle-screen .sm-bs-skill-slot--strike {
    border-top-color: var(--sm-fam-striker);
}

.battle-screen .sm-bs-skill-slot--missing {
    background-color: var(--sm-vellum-a05);
}

.battle-screen .sm-bs-skill-icon {
    width: 36px;
    height: 36px;
    min-width: 36px;
    margin-right: 7px;
    background-color: var(--sm-bg-portrait-a82);
    border-width: 1px;
    border-color: var(--sm-gold-muted-a54);
    -unity-background-scale-mode: scale-and-crop;
}

.battle-screen .sm-bs-skill-label {
    flex-grow: 1;
    color: var(--sm-ink-1);
    font-size: var(--sm-fs-eb);
    white-space: normal;
}

.battle-screen .sm-bs-skill-icon--missing,
.battle-screen .sm-bs-status-chip-icon--missing {
    -unity-text-align: middle-center;
    color: var(--sm-gold-200);
    -unity-font-style: bold;
}

.battle-screen .sm-bs-equipment-grid,
.battle-screen .sm-bs-status-chip-grid,
.battle-screen .sm-bs-tactic-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.battle-screen .sm-bs-equipment-slot {
    width: 48%;
    min-height: 64px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-top: var(--sm-s-2);
    padding-bottom: var(--sm-s-2);
    padding-left: var(--sm-s-2);
    padding-right: var(--sm-s-2);
    background-color: var(--sm-vellum-a06);
    border-width: 1px;
    border-color: var(--sm-gold-300-a22);
}

.battle-screen .sm-bs-equipment-slot--placeholder {
    opacity: 0.72;
}

.battle-screen .sm-bs-equipment-label {
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
}

.battle-screen .sm-bs-equipment-item {
    margin-top: 6px;
    color: var(--sm-ink-2);
    font-size: 10px;
    white-space: normal;
}

.battle-screen .sm-bs-tactic-row {
    width: 100%;
    flex-direction: row;
    margin-bottom: 5px;
}

.battle-screen .sm-bs-tactic-key {
    width: 74px;
    color: var(--sm-gold-100);
    font-size: 10px;
}

.battle-screen .sm-bs-tactic-value {
    flex-grow: 1;
    color: var(--sm-ink-1);
    font-size: 10px;
    white-space: normal;
}

.battle-screen .sm-bs-status-chip {
    position: relative;
    width: 112px;
    min-height: 78px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-top: 5px;
    padding-left: 5px;
    padding-right: 5px;
    background-color: var(--sm-vellum-a07);
    border-width: 1px;
    border-color: var(--sm-gold-300-a24);
}

.battle-screen .sm-bs-status-chip--permanent {
    border-left-width: 3px;
    border-left-color: var(--sm-gold-300);
}

.battle-screen .sm-bs-status-chip-icon {
    width: 26px;
    height: 26px;
    min-width: 26px;
    background-color: var(--sm-bg-portrait-a82);
    border-width: 1px;
    border-color: var(--sm-gold-muted-a40);
}

.battle-screen .sm-bs-status-chip-label {
    margin-top: var(--sm-s-1);
    color: var(--sm-ink-1);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-status-chip .sm-cd-meta {
    margin-top: 3px;
    white-space: normal;
}

.battle-screen .sm-bs-status-chip-stack {
    position: absolute;
    right: 4px;
    top: 4px;
    color: var(--sm-gold-100);
    font-size: 10px;
    -unity-font-style: bold;
}

.battle-screen .sm-bs-status-chip-ring {
    height: 3px;
    margin-top: var(--sm-s-1);
    background-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-empty-line {
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-eb);
}

.battle-screen .sm-bs-settings-panel {
    position: absolute;
    right: 12px;
    top: 62px;
    width: 316px;
    z-index: 9;
    padding-top: var(--sm-s-3);
    padding-bottom: var(--sm-s-3);
    padding-left: var(--sm-s-3);
    padding-right: var(--sm-s-3);
}

.battle-screen .sm-bs-settings-section {
    margin-top: var(--sm-s-2);
    margin-bottom: var(--sm-s-2);
}

.battle-screen .screen__locale-status,
.battle-screen .sm-bs-settings-status {
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-eb);
    white-space: normal;
}

.battle-screen .sm-bs-settings-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.battle-screen .battle-settings__section {
    margin-top: 10px;
}

.battle-screen .sm-bs-debug-foldout {
    position: absolute;
    top: 64px;
    right: 16px;
    min-width: 220px;
    max-width: 320px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: var(--sm-s-1);
    background-color: var(--sm-bg-1-a54);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a28);
    border-right-color: var(--sm-gold-300-a28);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a28);
    opacity: 0.85;
    font-size: 10px;
    color: var(--sm-ink-2);
}

.battle-screen .sm-bs-debug-foldout-body {
    flex-direction: column;
    margin-top: 2px;
    margin-left: 6px;
}

.battle-screen .sm-bs-debug-foldout-row {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.battle-screen .sm-bs-debug-foldout-key {
    min-width: 110px;
    color: var(--sm-ink-2);
    font-size: 10px;
    -unity-font-style: bold;
}

.battle-screen .sm-bs-debug-foldout-value {
    flex-grow: 1;
    color: var(--sm-vellum);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* UX Bible visual pass: semantic battle HUD chrome only; the 3D battlefield remains visible. */
.battle-screen {
    background-color: rgba(0, 0, 0, 0);
}

.battle-screen .sm-bs-topbar {
    top: 14px;
    left: 24px;
    right: 520px;
    width: auto;
    height: 76px;
    padding-left: 18px;
    padding-right: 20px;
    background-color: rgba(4, 7, 16, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.battle-screen .sm-bs-title {
    width: 138px;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-l);
}

.battle-screen .sm-bs-result {
    min-width: 118px;
    color: var(--sm-gold-100);
}

.battle-screen .sm-bs-status-text {
    color: var(--sm-vellum);
    min-width: 240px;
    max-width: 360px;
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-progress-track {
    width: 172px;
    height: 8px;
}

.battle-screen .sm-bs-speed {
    width: 140px;
    min-width: 140px;
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-settings-entry {
    min-width: 70px;
    flex-shrink: 0;
}

.battle-screen .sm-bs-roster-unit {
    background-color: rgba(19, 24, 36, 0.84);
}

.battle-screen .sm-bs-roster-list--ally .sm-bs-roster-unit {
    min-width: 122px;
    max-width: 136px;
    min-height: 138px;
    margin-right: var(--sm-s-2);
    padding-left: 7px;
    padding-right: 7px;
    flex-direction: column;
    align-items: stretch;
}

.battle-screen .sm-bs-roster-list--ally .sm-bs-roster-portrait {
    width: 82px;
    height: 70px;
    min-width: 82px;
    margin-right: 0;
    margin-bottom: 7px;
    align-self: center;
}

.battle-screen .sm-bs-roster-list--ally .sm-bs-roster-name {
    -unity-text-align: middle-center;
}

.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-unit {
    min-width: 178px;
    max-width: 220px;
    min-height: 74px;
}

.battle-screen .sm-bs-event-feed {
    left: 50%;
    right: auto;
    bottom: 134px;
    width: 440px;
    margin-left: -220px;
    min-height: 72px;
    max-height: 82px;
    overflow: hidden;
    background-color: rgba(4, 7, 16, 0.95);
}

.battle-screen .sm-bs-control-btn {
    background-color: rgba(18, 24, 38, 0.92);
}

.battle-screen .sm-bs-turn-order {
    position: absolute;
    top: 96px;
    left: 24px;
    right: 520px;
    width: auto;
    height: 48px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: var(--sm-s-3);
    padding-right: var(--sm-s-3);
    background-color: rgba(4, 7, 16, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a34);
    border-right-color: var(--sm-gold-300-a34);
    border-top-color: var(--sm-gold-300-a34);
    border-bottom-color: var(--sm-gold-300-a34);
}

.battle-screen .sm-bs-combatant-token {
    position: relative;
    width: 112px;
    height: 48px;
    min-height: 48px;
    min-width: 88px;
    margin-right: 7px;
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(18, 24, 38, 0.88);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a12);
    border-bottom-color: var(--sm-vellum-a12);
}

.battle-screen .sm-bs-combatant-token--ally {
    border-left-color: var(--sm-state-shield-a82);
}

.battle-screen .sm-bs-combatant-token--enemy {
    border-left-color: var(--sm-fam-striker);
}

.battle-screen .sm-bs-combatant-token--active {
    background-color: rgba(70, 49, 16, 0.92);
    border-top-color: var(--sm-gold-300-a78);
    border-bottom-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-combatant-token--down {
    opacity: 0.46;
}

.battle-screen .sm-bs-combatant-token__mark {
    width: 24px;
    min-width: 24px;
    height: 24px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
    background-color: var(--sm-bg-portrait-a82);
    border-width: 1px;
    border-color: var(--sm-gold-muted-a54);
}

.battle-screen .sm-bs-combatant-token__copy {
    flex-grow: 1;
    min-width: 0;
}

.battle-screen .sm-bs-combatant-token__name {
    color: var(--sm-vellum);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-combatant-token__action {
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-combatant-token__track {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 3px;
    height: 2px;
    background-color: var(--sm-vellum-a10);
}

.battle-screen .sm-bs-combatant-token__fill {
    height: 100%;
    background-color: var(--sm-state-safe-a86);
}

.battle-screen .sm-bs-intel-panel {
    position: absolute;
    top: 14px;
    right: 28px;
    width: 318px;
    height: 178px;
    padding-top: 13px;
    padding-bottom: var(--sm-s-3);
    padding-left: 14px;
    padding-right: 14px;
    flex-direction: column;
    background-color: rgba(4, 7, 16, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.battle-screen .sm-bs-intel-title {
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
}

.battle-screen .sm-bs-intel-board {
    position: relative;
    height: 94px;
    margin-top: var(--sm-s-2);
    overflow: hidden;
    background-color: rgba(12, 17, 29, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-vellum-a12);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a12);
    border-bottom-color: var(--sm-vellum-a12);
}

.battle-screen .sm-bs-intel-axis {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 47%;
    height: 1px;
    background-color: var(--sm-gold-300-a34);
}

.battle-screen .sm-bs-intel-progress {
    position: absolute;
    left: 18px;
    bottom: 10px;
    height: 3px;
    background-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-intel-pip {
    position: absolute;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    -unity-text-align: middle-center;
    color: var(--sm-bg-0);
    font-size: 10px;
    -unity-font-style: bold;
    background-color: var(--sm-state-shield-a82);
    border-width: 2px;
    border-color: rgba(255, 248, 226, 0.76);
}

.battle-screen .sm-bs-intel-pip--enemy {
    background-color: var(--sm-fam-striker);
}

.battle-screen .sm-bs-intel-pip--selected {
    border-color: var(--sm-gold-100);
}

.battle-screen .sm-bs-intel-pip--down {
    opacity: 0.42;
}

.battle-screen .sm-bs-intel-legend {
    flex-direction: row;
    align-items: center;
    margin-top: var(--sm-s-2);
}

.battle-screen .sm-bs-intel-legend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
    min-width: 0;
}

.battle-screen .sm-bs-intel-legend-marker {
    width: 8px;
    height: 8px;
    margin-right: 5px;
    background-color: var(--sm-state-shield-a82);
}

.battle-screen .sm-bs-intel-legend-item--enemy .sm-bs-intel-legend-marker {
    background-color: var(--sm-fam-striker);
}

.battle-screen .sm-bs-intel-legend-item--progress .sm-bs-intel-legend-marker {
    background-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-intel-legend-label {
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-side-rail {
    position: absolute;
    left: 24px;
    top: 158px;
    width: 86px;
    min-height: 318px;
    padding-top: var(--sm-s-3);
    padding-bottom: var(--sm-s-3);
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(4, 7, 16, 0.90);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a12);
    border-bottom-color: var(--sm-vellum-a12);
}

.battle-screen .sm-bs-side-rail-title {
    width: 100%;
    margin-bottom: 9px;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-xs);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-side-rail-steps {
    align-items: center;
}

.battle-screen .sm-bs-side-rail-token {
    position: relative;
    width: 48px;
    height: 34px;
    margin-bottom: var(--sm-s-2);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(18, 24, 38, 0.88);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-state-shield-a82);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a12);
    border-bottom-color: var(--sm-vellum-a12);
}

.battle-screen .sm-bs-side-rail-token--enemy {
    border-left-color: var(--sm-fam-striker);
}

.battle-screen .sm-bs-side-rail-token--active {
    background-color: rgba(70, 49, 16, 0.94);
    border-top-color: var(--sm-gold-300-a78);
    border-bottom-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-side-rail-token--down {
    opacity: 0.44;
}

.battle-screen .sm-bs-side-rail-token__mark {
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-eb);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.battle-screen .sm-bs-side-rail-token__track {
    position: absolute;
    right: 4px;
    top: 5px;
    bottom: 5px;
    width: 3px;
    background-color: var(--sm-vellum-a10);
}

.battle-screen .sm-bs-side-rail-token__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--sm-state-safe-a86);
}

.battle-screen .sm-bs-control-bar {
    position: absolute;
    /* wave-portrait-pass: 좌하단 아군 strip 우측 끝(~756px)에 컨트롤바 좌측(760px)이 바짝 붙어
       카드가 뭉개져 보였고, 컨트롤바 우측~전황판단 사이엔 ~500px 빈 공간이 떴다.
       아군 strip(우측 ~756) ↔ 전황판단(좌측 ~1474) 가용공간의 중앙으로 배치해
       smush 해소 + dead gap 채움 (원래 의도인 화면 중앙 배치 복원). */
    left: 1010px;
    bottom: 28px;
    width: 448px;
    min-width: 420px;
    height: 94px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: var(--sm-s-3);
    padding-bottom: var(--sm-s-3);
    flex-direction: row;
    justify-content: center;
    background-color: rgba(4, 7, 16, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.battle-screen .sm-bs-control-bar .sm-bs-control-btn {
    min-width: 58px;
    min-height: 44px;
    font-size: var(--sm-fs-s);
}

.battle-screen .sm-bs-control-bar .sm-bs-control-btn--primary {
    min-width: 70px;
    background-color: rgba(92, 59, 14, 0.96);
}

.battle-screen .sm-bs-observer-group {
    flex-grow: 1;
    min-width: 0;
    margin-left: 0;
    align-self: stretch;
    justify-content: center;
}

.battle-screen .sm-bs-control-bar .sm-bs-observer-title {
    display: flex;
    height: 14px;
    margin-bottom: 5px;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-xs);
}

.battle-screen .sm-bs-observer-chips {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    min-width: 0;
}

.battle-screen .sm-bs-observer-chip {
    width: 98px;
    height: 42px;
    margin-right: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 7px;
    padding-right: 7px;
    background-color: rgba(18, 24, 38, 0.88);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a78);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a12);
    border-bottom-color: var(--sm-vellum-a12);
}

.battle-screen .sm-bs-observer-chip--speed {
    border-left-color: var(--sm-state-shield-a82);
}

.battle-screen .sm-bs-observer-chip--status {
    border-left-color: var(--sm-fam-vanguard-glow-a45);
}

.battle-screen .sm-bs-observer-chip--progress {
    border-left-color: var(--sm-state-warn-a78);
}

.battle-screen .sm-bs-observer-chip__label {
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-observer-chip__value {
    margin-top: 2px;
    color: var(--sm-vellum);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-readout-panel {
    position: absolute;
    right: 28px;
    bottom: 28px;
    width: 420px;
    min-height: 168px;
    padding-top: 14px;
    padding-bottom: var(--sm-s-3);
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(4, 7, 16, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.battle-screen .sm-bs-readout-panel > .sm-family-tint-rib {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
}

.battle-screen .sm-bs-readout-rows {
    margin-top: var(--sm-s-2);
}

.battle-screen .sm-bs-readout-row {
    margin-bottom: var(--sm-s-2);
}

.battle-screen .sm-bs-readout-row__header {
    flex-direction: row;
    align-items: center;
}

.battle-screen .sm-bs-readout-row__label {
    flex-grow: 1;
    color: var(--sm-ink-2);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-readout-row__value {
    min-width: 132px;
    color: var(--sm-vellum);
    font-size: 10px;
    -unity-text-align: middle-right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-readout-row__track {
    height: 5px;
    margin-top: 3px;
    background-color: var(--sm-vellum-a10);
    border-width: 1px;
    border-color: var(--sm-gold-300-a18);
}

.battle-screen .sm-bs-readout-row__fill {
    height: 100%;
    background-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-readout-row--ally .sm-bs-readout-row__fill {
    background-color: var(--sm-state-shield-a82);
}

.battle-screen .sm-bs-readout-row--enemy .sm-bs-readout-row__fill {
    background-color: var(--sm-fam-striker);
}

.battle-screen .sm-bs-readout-row--warning .sm-bs-readout-row__fill {
    background-color: var(--sm-state-warn-a78);
}

/* ==========================================================================
   2026-07-31 시안 재정렬 — 기준은 `Screenshots/mockups/ui_ux_bible_battle_hud_v1.png`

   앞선 아트 패스는 전투 화면 한 장만 보고 전역 아트 결정을 내렸다. 테두리를 지우고
   불투명도를 낮춰 "창"을 걷어냈는데, 이 게임의 나머지가 전부 금테 장식 프레임이라
   전투만 다른 언어를 쓰게 됐다. 그리고 그 판단의 근거로 삼을 시안이 이미 있었다.

   시안이 정한 것 — 이 블록은 이것만 따른다.

   1) 화면은 다섯 덩어리다. 상단 띠 / 좌측 아군 기둥 / 중앙 액자형 전장 / 우측 적군 기둥 /
      하단 로그 + 재생 바. 크롬이 전장을 <b>둘러싼다</b>. 반투명하게 위에 얹히지 않는다.
   2) 모든 패널은 근검정 남색 바탕(#00040C 계열)에 금색 헤어라인. 아군은 금색, 적군은 적색.
   3) 유닛은 세로 카드다. 초상 + 이름 + 역할 칩 + 수치가 얹힌 HP 바.
   4) 아군 4장과 적군 5장이 <b>동시에</b> 보인다. 적 상태를 머리 위 바로만 읽게 하지 않는다.

   시안을 따르지 않은 것 — 시안이 시스템 정립 전 산출물이라 지금과 다른 자리.

   - 시안의 "Round 3 · 00:42" 는 벽시계다. 이 게임은 결정론 스텝이라 벽시계가 없다.
     같은 자리에 스텝 진행을 둔다.
   - 시안의 "[12:42]" 로그 타임스탬프도 같은 이유로 스텝 태그가 된다.
   - 시안 전장은 그려진 일러스트다. 여기서는 3D 카메라 화면이라 액자 안쪽을 비워
     뒤가 그대로 보이게 하고, 액자 바깥은 기둥과 띠가 <b>가린다</b>.
   - 시안에 없는 0.5x / 재도전 / 설정 / 상세창은 시안 이후 생긴 것이라 그대로 두되
     같은 값 계통으로 맞춘다.
   ========================================================================== */

/* --- 값 계통 -------------------------------------------------------------
   시안에서 뽑은 색이다. 패널 바탕은 #00040C~#000810, 금선은 #C08848 계열
   (= --sm-gold-400 rgb(200,147,42) 과 사실상 같다 — 토큰이 시안에서 나왔다는 증거). */

.battle-screen .sm-bs-team-column,
.battle-screen .sm-bs-topbar,
.battle-screen .sm-bs-event-feed,
.battle-screen .sm-bs-control-bar {
    background-color: rgba(1, 5, 13, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

/* --- 1. 상단 띠 ---------------------------------------------------------- */

.battle-screen .sm-bs-topbar {
    top: 12px;
    left: 14px;
    right: 14px;
    width: auto;
    height: 52px;
    padding-left: 16px;
    padding-right: 12px;
}

.battle-screen .sm-bs-result {
    min-width: 0;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-m);
    letter-spacing: 1px;
}

/* --- 2·4. 좌우 팀 기둥 ---------------------------------------------------
   시안 폭은 화면의 18.9% (316/1672) 지만 여기서는 액자 안이 3D 라 더 양보한다.
   268px x 2 = 536 → 전장에 1384px(72%) 를 남긴다. 시안은 59% 였다. */

.battle-screen .sm-bs-team-column {
    top: 74px;
    bottom: 208px;
    width: 268px;
}

.battle-screen .sm-bs-ally-column {
    left: 14px;
}

.battle-screen .sm-bs-enemy-column {
    right: 14px;
    border-left-color: var(--sm-state-danger-a42);
    border-right-color: var(--sm-state-danger-a42);
    border-top-color: var(--sm-state-danger-a42);
    border-bottom-color: var(--sm-state-danger-a42);
}

.battle-screen .sm-bs-column-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 26px;
    min-height: 26px;
    margin-bottom: 8px;
    padding-left: 2px;
    padding-right: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sm-gold-300-a24);
}

.battle-screen .sm-bs-enemy-column .sm-bs-column-header {
    border-bottom-color: var(--sm-state-danger-a42);
}

/* 라벨 높이를 명시하지 않으면 헤더의 align-items:center 아래에서 폰트 크기보다
   낮게 눌린다(위트니스가 10.5 < 11 로 잡았다) — 글자 위아래가 잘리는 자리다. */
.battle-screen .sm-bs-rail-title {
    min-height: 16px;
    color: var(--sm-gold-200);
    font-size: var(--sm-fs-eb);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.battle-screen .sm-bs-enemy-column .sm-bs-rail-title {
    color: var(--sm-state-danger);
}

.battle-screen .sm-bs-rail-summary {
    margin-top: 0;
    min-height: 16px;
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-eb);
    white-space: nowrap;
}

/* --- 3. 유닛 카드 (세로) -------------------------------------------------- */

.battle-screen .sm-bs-roster-list {
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
}

/* 카드는 기둥 높이를 <b>나눠 갖는다</b>.
   고정 높이로 두면 아군 4장이 790px 기둥의 위쪽 절반만 채우고 아래가 통째로 빈 검정이 됐다.
   max-height 로 상한을 두는 이유는 적이 3명일 때 카드가 기둥만큼 부풀지 않게 하기 위해서다. */
.battle-screen .sm-bs-roster-unit,
.battle-screen .sm-bs-roster-list--ally .sm-bs-roster-unit,
.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-unit {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 72px;
    max-height: 178px;
    flex-direction: row;
    align-items: center;
    width: auto;
    min-width: 0;
    max-width: none;
    margin-right: 0;
    margin-bottom: 8px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 8px;
    padding-right: 9px;
    background-color: rgba(8, 13, 24, 0.90);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a36);
    border-right-color: var(--sm-gold-300-a36);
    border-top-color: var(--sm-gold-300-a36);
    border-bottom-color: var(--sm-gold-300-a36);
}

.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-unit {
    background-color: rgba(20, 8, 10, 0.88);
    border-left-color: var(--sm-state-danger-a42);
    border-right-color: var(--sm-state-danger-a42);
    border-top-color: var(--sm-state-danger-a42);
    border-bottom-color: var(--sm-state-danger-a42);
}

.battle-screen .sm-bs-roster-unit--selected {
    background-color: rgba(48, 36, 12, 0.92);
    border-left-color: var(--sm-gold-200);
    border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200);
    border-bottom-color: var(--sm-gold-200);
}

.battle-screen .sm-bs-roster-unit--down {
    opacity: 0.42;
}

.battle-screen .sm-bs-roster-list--ally .sm-bs-roster-portrait,
.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-portrait {
    width: 86px;
    min-width: 86px;
    height: auto;
    align-self: stretch;
    margin-right: 10px;
    margin-bottom: 0;
    background-color: var(--sm-bg-portrait-a82);
    border-width: 1px;
    border-color: var(--sm-gold-muted-a54);
    font-size: 18px;
}

.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-portrait {
    border-color: var(--sm-state-danger-a42);
}

.battle-screen .sm-bs-roster-meta {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.battle-screen .sm-bs-roster-list--ally .sm-bs-roster-name,
.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-name {
    -unity-text-align: middle-left;
    color: var(--sm-vellum);
    font-size: var(--sm-fs-s);
    -unity-font-style: bold;
}

/* 역할 칩 — 시안이 이름 밑에 둔 작은 상자. 지금은 RoleTag 가 실데이터로 있다. */
.battle-screen .sm-bs-roster-role {
    align-self: flex-start;
    margin-top: 3px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    color: var(--sm-gold-200);
    font-size: 10px;
    background-color: var(--sm-gold-300-a12);
    border-width: 1px;
    border-color: var(--sm-gold-300-a36);
}

.battle-screen .sm-bs-roster-list--enemy .sm-bs-roster-role {
    color: var(--sm-state-danger);
    background-color: var(--sm-state-danger-a14);
    border-color: var(--sm-state-danger-a42);
}

/* 카드에서는 동사를 뺀다 — 시안이 그 자리에 역할을 뒀고, 지금 무엇을 하는지는
   전장 아래 콜아웃과 로그가 말한다. 카드가 상태 기계처럼 읽히던 원인이기도 하다. */
.battle-screen .sm-bs-roster-status {
    display: none;
}

.battle-screen .sm-bs-roster-hp-text {
    position: absolute;
    right: 4px;
    top: 0;
    bottom: 0;
    color: var(--sm-vellum);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* --- 5. 하단 로그 + 재생 바 ----------------------------------------------
   시안은 여러 줄 타임스탬프 로그를 기둥 사이 전폭으로 깔았다. */

.battle-screen .sm-bs-event-feed {
    left: 14px;
    right: 14px;
    bottom: 96px;
    width: auto;
    margin-left: 0;
    min-height: 104px;
    max-height: 104px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 14px;
    opacity: 1;
    overflow: hidden;
}

.battle-screen .sm-bs-event-feed .sm-bs-section-title {
    display: none;
}

.battle-screen .sm-bs-log-text {
    margin-top: 0;
    color: var(--sm-ink-1);
    font-size: 12px;
    line-height: 19px;
    white-space: normal;
}

.battle-screen .sm-bs-control-bar {
    left: 14px;
    right: 14px;
    width: auto;
    min-width: 0;
    margin-left: 0;
    bottom: 14px;
    height: 70px;
    justify-content: space-between;
    padding-left: 16px;
    padding-right: 16px;
    background-image: none;
}

/* 시안의 중앙 타이틀. 상단 띠가 전폭을 쓰는데 안에 상태 라벨 하나뿐이면
   내용 없는 검은 띠가 되고, 그게 이 화면이 "타이틀바"처럼 읽히던 원인이었다. */
.battle-screen .sm-bs-battle-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-l);
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 하단 재생 바로 내려온 타임라인 스크러버. 상단 띠에 있던 210px 짜리 짧은 막대가
   화면 오른쪽 끝에서 홀로 떠 있었다 — 조작(속도·일시정지)과 진행 표시가 화면 위아래로
   갈라져 있으면 둘이 같은 것을 다룬다는 게 안 읽힌다. */
.battle-screen .sm-bs-control-bar .sm-bs-progress-track {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    height: 10px;
    margin-left: 20px;
    margin-right: 20px;
    background-color: var(--sm-vellum-a12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a36);
    border-right-color: var(--sm-gold-300-a36);
    border-top-color: var(--sm-gold-300-a36);
    border-bottom-color: var(--sm-gold-300-a36);
}
