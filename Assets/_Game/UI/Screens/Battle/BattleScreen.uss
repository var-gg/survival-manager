    height: 88px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    flex-direction: row;
    justify-content: center;
    background-color: rgba(4, 7, 16, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.battle-screen .sm-bs-control-bar .sm-bs-control-btn {
    min-width: 58px;
    min-height: 44px;
    font-size: var(--sm-fs-s);
}

.battle-screen .sm-bs-control-bar .sm-bs-control-btn--primary {
    min-width: 70px;
    background-color: rgba(92, 59, 14, 0.96);
}

.battle-screen .sm-bs-observer-group {
    flex-grow: 1;
    min-width: 0;
    margin-left: 0;
    align-self: stretch;
    justify-content: center;
}

.battle-screen .sm-bs-control-bar .sm-bs-observer-title {
    display: flex;
    height: 14px;
    margin-bottom: 5px;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-xs);
}

.battle-screen .sm-bs-observer-chips {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    min-width: 0;
}

.battle-screen .sm-bs-observer-chip {
    width: 98px;
    height: 42px;
    margin-right: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 7px;
    padding-right: 7px;
    background-color: rgba(18, 24, 38, 0.88);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a78);
    border-right-color: var(--sm-vellum-a12);
    border-top-color: var(--sm-vellum-a12);
    border-bottom-color: var(--sm-vellum-a12);
}

.battle-screen .sm-bs-observer-chip--speed {
    border-left-color: var(--sm-state-shield-a82);
}

.battle-screen .sm-bs-observer-chip--status {
    border-left-color: var(--sm-fam-vanguard-glow-a45);
}

.battle-screen .sm-bs-observer-chip--progress {
    border-left-color: var(--sm-state-warn-a78);
}

.battle-screen .sm-bs-observer-chip__label {
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-observer-chip__value {
    margin-top: 2px;
    color: var(--sm-vellum);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-readout-panel {
    position: absolute;
    right: 28px;
    bottom: 28px;
    width: 420px;
    min-height: 168px;
    padding-top: 14px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(4, 7, 16, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.battle-screen .sm-bs-readout-panel > .sm-family-tint-rib {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
}

.battle-screen .sm-bs-readout-rows {
    margin-top: 8px;
}

.battle-screen .sm-bs-readout-row {
    margin-bottom: 8px;
}

.battle-screen .sm-bs-readout-row__header {
    flex-direction: row;
    align-items: center;
}

.battle-screen .sm-bs-readout-row__label {
    flex-grow: 1;
    color: var(--sm-ink-2);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-readout-row__value {
    min-width: 132px;
    color: var(--sm-vellum);
    font-size: 10px;
    -unity-text-align: middle-right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.battle-screen .sm-bs-readout-row__track {
    height: 5px;
    margin-top: 3px;
    background-color: var(--sm-vellum-a10);
    border-width: 1px;
    border-color: var(--sm-gold-300-a18);
}

.battle-screen .sm-bs-readout-row__fill {
    height: 100%;
    background-color: var(--sm-gold-300-a78);
}

.battle-screen .sm-bs-readout-row--ally .sm-bs-readout-row__fill {
    background-color: var(--sm-state-shield-a82);
}

.battle-screen .sm-bs-readout-row--enemy .sm-bs-readout-row__fill {
    background-color: var(--sm-fam-striker);
}

.battle-screen .sm-bs-readout-row--warning .sm-bs-readout-row__fill {
    background-color: var(--sm-state-warn-a78);
}
