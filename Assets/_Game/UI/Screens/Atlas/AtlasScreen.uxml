<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../../Panels/SiteEventChoice/SiteEventChoice.uss" />
    <ui:Template name="SiteEventChoiceTemplate" src="../../Panels/SiteEventChoice/SiteEventChoice.uxml" />
    <ui:VisualElement name="atlas-root" class="atlas-root">
        <ui:VisualElement class="atlas-topbar">
            <ui:Label name="atlas-region-title" class="atlas-title" />
            <ui:Label name="atlas-placement-summary" class="atlas-summary" />
        </ui:VisualElement>

        <ui:VisualElement name="atlas-content" class="atlas-content">
            <ui:VisualElement class="atlas-left-rail">
                <ui:VisualElement class="atlas-rail-tabs" picking-mode="Ignore">
                    <ui:Label text="✦" class="atlas-rail-tab atlas-rail-tab--active" />
                    <ui:Label text="⚔" class="atlas-rail-tab" />
                    <ui:Label text="◆" class="atlas-rail-tab" />
                    <ui:Label text="☠" class="atlas-rail-tab" />
                </ui:VisualElement>
                <ui:Label text="각인석" class="atlas-section-title" />
                <ui:VisualElement name="atlas-sigil-pool" class="atlas-sigil-pool" />
                <ui:Label text="현재 단계 후보" class="atlas-section-title" />
                <ui:VisualElement name="atlas-stage-candidate-list" class="atlas-stage-candidate-list" />
            </ui:VisualElement>

            <ui:VisualElement name="atlas-board-pane" class="atlas-board-pane">
                <ui:VisualElement name="atlas-board" class="atlas-board" />
                <ui:VisualElement name="atlas-map-overlay" class="atlas-map-overlay" picking-mode="Ignore" />
                <ui:VisualElement name="atlas-layer-overlay" class="atlas-layer-overlay" />
                <ui:VisualElement name="atlas-stage-candidate-overlay" class="atlas-stage-candidate-overlay" />
            </ui:VisualElement>

            <ui:VisualElement class="atlas-preview">
                <ui:VisualElement class="atlas-decision-card atlas-decision-card--primary">
                    <ui:VisualElement class="atlas-preview-banner" picking-mode="Ignore">
                        <ui:VisualElement class="atlas-preview-banner__sigil" picking-mode="Ignore" />
                        <ui:VisualElement class="atlas-preview-banner__image" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="atlas-preview-title" class="atlas-preview-title" />
                    <ui:Label name="atlas-preview-judgement" class="atlas-judgement" />
                    <ui:VisualElement class="atlas-preview-status-row">
                        <ui:Label name="atlas-preview-action-ribbon" class="atlas-preview-action-ribbon" />
                        <ui:Label name="atlas-preview-threat-band" class="atlas-preview-threat-band" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- wave-25 closure (GPT Pro P0): recommendations card를 primary 직후로 이동.
                     decision-atlas-regional-sigil의 "지도 선택이 곧 캐릭터 운용 선택" 정합. -->
                <ui:VisualElement class="atlas-decision-card atlas-preview-card--recommendations">
                    <ui:Label text="추천 캐릭터 3" class="atlas-preview-label" />
                    <ui:Label name="atlas-preview-recommendations" class="atlas-preview-body" />
                </ui:VisualElement>

                <!-- wave-25 closure: Guide/Scout slot (squad 4-6 외 1명) — preview depth + reward bias + lore unlock.
                     decision-atlas-regional-sigil 결정의 별도 layer. Presenter wire는 후속. -->
                <ui:VisualElement class="atlas-decision-card atlas-preview-card--scout">
                    <ui:Label text="가이드 / 정찰" class="atlas-preview-label" />
                    <ui:Label name="atlas-preview-scout" class="atlas-preview-body" text="(정찰원 미선택)" />
                </ui:VisualElement>

                <ui:VisualElement class="atlas-decision-card atlas-preview-card--modifiers">
                    <ui:Label text="각인 효과" class="atlas-preview-label" />
                    <ui:Label name="atlas-preview-modifiers" class="atlas-preview-body" />
                </ui:VisualElement>

                <ui:VisualElement class="atlas-decision-card atlas-preview-card--enemy">
                    <ui:Label text="적 정보" class="atlas-preview-label" />
                    <ui:Label name="atlas-preview-enemy" class="atlas-preview-body" />
                    <ui:Label text="적 징후" class="atlas-preview-label" />
                    <ui:Label name="atlas-preview-enemy-intel" class="atlas-preview-body atlas-preview-body--intel" />
                </ui:VisualElement>

                <ui:VisualElement class="atlas-decision-card atlas-preview-card--reward">
                    <ui:Label text="보상" class="atlas-preview-label" />
                    <ui:Label name="atlas-preview-reward" class="atlas-preview-body" />
                </ui:VisualElement>

                <ui:Label name="atlas-boundary-note" class="atlas-boundary-note atlas-decision-card" />
                <!-- wave-59 mockup-align: 출정 (primary) + 정찰 (secondary, -35 Echo). 시안 갤러리 atlas v1. -->
                <ui:VisualElement name="atlas-action-row" class="atlas-action-row" style="flex-direction: row; gap: 8px; margin-top: 12px; align-items: center;">
                    <ui:Button name="atlas-continue-button" text="출정" class="atlas-continue-button ui-button sm-cta sm-cta--md sm-cta--primary" style="flex-grow: 1;" />
                    <ui:Button name="atlas-scout-button" text="정찰 (-35)" class="atlas-scout-button ui-button sm-cta sm-cta--md sm-cta--secondary" style="flex-grow: 1;" />
                </ui:VisualElement>
                <ui:Label name="atlas-debug-hash" class="atlas-debug-hash" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="atlas-spine-progress-strip" class="atlas-spine-progress-strip" />

        <ui:VisualElement class="atlas-command-legend" picking-mode="Ignore">
            <ui:Label name="AtlasLegendSafeLabel" class="atlas-command-legend__item atlas-command-legend__item--safe" text="안전권" />
            <ui:Label name="AtlasLegendThreatLabel" class="atlas-command-legend__item atlas-command-legend__item--threat" text="위험권" />
            <ui:Label name="AtlasLegendRewardLabel" class="atlas-command-legend__item atlas-command-legend__item--reward" text="보상권" />
            <ui:Label name="AtlasLegendBossLabel" class="atlas-command-legend__item atlas-command-legend__item--boss" text="보스권" />
        </ui:VisualElement>

        <ui:VisualElement name="atlas-sitetrack-strip" class="sitetrack-strip" />

        <!-- wave-59 mockup-align: 하단 footer — 마을 복귀 + 원정 진행도 X/Y. 시안 갤러리 atlas v1. -->
        <ui:VisualElement name="atlas-footer" class="atlas-footer" style="flex-direction: row; justify-content: space-between; align-items: center; padding: 12px 24px; margin-top: 4px;">
            <ui:Button name="atlas-return-town-button" text="◀ 마을 복귀" class="ui-button sm-cta sm-cta--md sm-cta--secondary" />
            <ui:Label name="atlas-progress-label" class="atlas-progress-label" style="color: rgb(216, 199, 153); font-size: 12px; -unity-font-style: bold; letter-spacing: 1px;" text="원정 진행도 —" />
        </ui:VisualElement>

        <ui:VisualElement name="SiteEventChoiceOverlay" class="site-event-choice-overlay" picking-mode="Ignore" style="display: none;">
            <ui:Instance template="SiteEventChoiceTemplate" class="site-event-choice__instance" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
