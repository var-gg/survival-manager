<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="WarrantSelectionRoot" class="screen warrant-screen">
        <ui:VisualElement class="screen__topbar warrant-screen__topbar">
            <ui:Label name="TitleLabel" class="screen__title" />
        </ui:VisualElement>

        <ui:VisualElement class="screen__body warrant-screen__body">
            <ui:VisualElement class="panel warrant-choice-panel">
                <ui:Label name="HeaderLabel" class="panel__title" />
                <ui:VisualElement name="WarrantCardRow" class="card-row warrant-card-row" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="panel panel--dense status-bar warrant-screen__status-band">
            <ui:VisualElement class="action-group">
                <ui:VisualElement class="action-row">
                    <ui:Button name="ProceedButton" class="ui-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="StatusLabel" class="panel__text panel__text--muted" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
