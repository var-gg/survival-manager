.sortie-screen {
    flex-grow: 1;
    background-color: rgba(10, 12, 20, 0.92);
    padding-left: var(--sm-s-5);
    padding-right: var(--sm-s-5);
    padding-top: var(--sm-s-5);
    padding-bottom: var(--sm-s-5);
}

.sortie-screen__body {
    flex-direction: row;
}

.sortie-deploy-panel {
    flex-grow: 2;
    margin-right: var(--sm-s-3);
}

.sortie-synergy-panel {
    flex-grow: 1;
}

.sortie-deploy-list {
    flex-direction: column;
}

.sortie-deploy-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: var(--sm-s-1);
    padding-bottom: var(--sm-s-1);
}

.sortie-deploy-row__portrait {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: rgba(20, 16, 10, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a34);
    border-right-color: var(--sm-gold-300-a34);
    border-top-color: rgba(245, 214, 138, 0.34);
    border-bottom-color: rgba(138, 100, 24, 0.5);
}

/* 실제 흉상 연결 시 — 얼굴을 꽉 채워 crop. */
.sortie-deploy-row__portrait--art {
    -unity-background-scale-mode: scale-and-crop;
}

.sortie-deploy-row__anchor {
    min-width: 96px;
}

.sortie-deploy-row__name {
    flex-grow: 1;
}

.sortie-synergy-chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.sortie-synergy-chip {
    padding-left: var(--sm-s-2);
    padding-right: var(--sm-s-2);
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-top-left-radius: var(--sm-r-md);
    border-top-right-radius: var(--sm-r-md);
    border-bottom-left-radius: var(--sm-r-md);
    border-bottom-right-radius: var(--sm-r-md);
    background-color: rgba(60, 70, 96, 0.6);
}

.sortie-synergy-chip--major {
    -unity-font-style: bold;
    background-color: rgba(96, 120, 72, 0.7);
}

/* breakpoint 미달 — "한 명만 더 모으면 켜진다"를 보여주는 회색(dimmed) 교육 칩 */
.sortie-synergy-chip--inactive {
    background-color: rgba(48, 52, 64, 0.45);
    opacity: 0.6;
}

/* 출격 게이트 CTA 양극화 — 좌측 보조(취소·편성), 우측 끝 primary(출격) 강조. */
.sortie-action-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.sortie-action-row__secondary {
    flex-direction: row;
}

.sortie-launch-button {
    min-width: 240px;
    -unity-font-style: bold;
}
