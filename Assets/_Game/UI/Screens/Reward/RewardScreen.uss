.reward-screen {
    color: var(--sm-ink-1);
    background-color: rgb(7, 10, 19);
    padding-left: var(--sm-s-5);
    padding-right: var(--sm-s-5);
    padding-top: 18px;
    padding-bottom: 18px;
}

.reward-screen .reward-bible__backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/_Game/UI/Backdrops/town_frontier_village_dusk.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(90, 72, 88, 0.28);
    background-color: rgba(14, 10, 12, 0.72);
}

.reward-screen .reward-bible__topbar {
    position: relative;
    height: 96px;
    min-height: 96px;
    margin-left: 96px;
    margin-right: 96px;
    margin-bottom: 14px;
    padding-left: 110px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(13, 17, 29, 0.94);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.reward-screen .reward-bible__crest {
    position: absolute;
    left: -30px;
    top: -18px;
    width: 132px;
    height: 132px;
    border-radius: 66px;
    background-color: rgba(230, 183, 81, 0.14);
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Augment/augment_star.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(245, 214, 138, 0.92);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300);
    border-right-color: var(--sm-gold-300);
    border-top-color: var(--sm-gold-300);
    border-bottom-color: var(--sm-gold-300);
}

.reward-screen .reward-bible__title-stack {
    flex-grow: 1;
}

.reward-screen .reward-bible__title {
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-l);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* Hide dev locale chrome — production handoff view. */
.reward-screen #LocaleStatusLabel,
.reward-screen #LocaleKoButton,
.reward-screen #LocaleEnButton,
.reward-screen #HelpButton {
    display: none;
}

.reward-screen .reward-bible__rune-row {
    margin-top: var(--sm-s-3);
    flex-direction: row;
    align-items: center;
}

.reward-screen .reward-bible__rune {
    width: 10px;
    height: 10px;
    margin-right: var(--sm-s-3);
    rotate: 45deg;
    background-color: var(--sm-vellum-a15);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.reward-screen .reward-bible__rune--active {
    background-color: var(--sm-gold-300);
}

.reward-screen .reward-bible__rune--danger {
    background-color: var(--sm-fam-striker);
}

.reward-screen .screen__toolbar {
    flex-direction: row;
    align-items: center;
}

.reward-screen .screen__locale-status {
    color: var(--sm-gold-200);
    font-size: 10px;
}

.reward-screen .ui-button {
    min-height: 34px;
    color: var(--sm-vellum);
    background-color: rgba(21, 25, 39, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.reward-screen .ui-button--accent {
    color: rgb(38, 25, 8);
    background-color: var(--sm-gold-300);
}

.reward-screen .help-strip {
    display: none;
}

.reward-screen .reward-bible__board {
    position: relative;
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.reward-screen .screen__column {
    min-height: 0;
}

.reward-screen .reward-bible__left-rail {
    width: 29%;
    min-width: 360px;
    margin-right: 14px;
}

.reward-screen .reward-bible__center-stage {
    flex-grow: 1;
    min-width: 0;
    margin-right: 14px;
}

.reward-screen .reward-bible__right-rail {
    width: 23%;
    min-width: 300px;
}

.reward-screen .panel {
    background-color: rgba(36, 26, 14, 0.78);
    /* wave-test-cleanup: art bible AB151 정책 위반. */
    background-image: none;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-background-image-tint-color: rgba(255, 235, 200, 0.32);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a36);
    border-right-color: var(--sm-gold-300-a36);
    border-top-color: var(--sm-gold-300-a36);
    border-bottom-color: var(--sm-gold-300-a36);
}

.reward-screen .panel__title {
    color: var(--sm-gold-100);
    font-size: 16px;
    -unity-font-style: bold;
}

.reward-screen .panel__text {
    color: var(--sm-ink-1);
    font-size: var(--sm-fs-eb);
    line-height: 15px;
    white-space: normal;
}

.reward-screen .panel__text--muted {
    color: var(--sm-gold-200);
}

.reward-screen .reward-settlement-summary {
    height: 168px;
    min-height: 168px;
    overflow: hidden;
    margin-bottom: var(--sm-s-3);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: var(--sm-s-3);
    padding-bottom: 10px;
    background-color: rgba(7, 11, 21, 0.96);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300);
    border-right-color: var(--sm-gold-300-a34);
    border-top-color: var(--sm-gold-300-a34);
    border-bottom-color: var(--sm-gold-300-a34);
}

.reward-screen .reward-settlement-summary__title {
    margin-bottom: var(--sm-s-2);
    color: var(--sm-gold-100);
    font-size: 13px;
}

.reward-screen .reward-settlement-summary__rows {
    flex-direction: column;
    width: 100%;
}

.reward-screen .reward-settlement-summary__row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 20px;
}

.reward-screen .reward-settlement-summary__key {
    width: 90px;
    min-width: 90px;
    color: var(--sm-gold-200);
    font-size: 10px;
    -unity-font-style: bold;
}

.reward-screen .reward-settlement-summary__value {
    flex-grow: 1;
    min-width: 0;
    color: var(--sm-vellum);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.reward-screen .reward-settlement-summary__chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.reward-screen .reward-settlement-summary__chip {
    margin-right: 6px;
    margin-bottom: 3px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-xs);
    background-color: var(--sm-gold-300-a12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.reward-screen .reward-progression-panel {
    flex-grow: 1;
    min-height: 0;
    padding-top: 14px;
    padding-bottom: var(--sm-s-3);
    padding-left: 14px;
    padding-right: 14px;
}

.reward-screen .reward-progression-rows {
    flex-direction: column;
    margin-top: 10px;
}

.reward-screen .reward-progression-row {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
    margin-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(20, 25, 40, 0.72);
    border-left-width: 3px;
    border-left-color: var(--sm-gold-300-a42);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--sm-vellum-a10);
    border-bottom-color: var(--sm-vellum-a10);
    border-right-color: var(--sm-vellum-a10);
}

.reward-screen .reward-progression-row--victory,
.reward-screen .reward-progression-row--applied,
.reward-screen .reward-progression-row--ready {
    border-left-color: var(--sm-state-safe-a86);
}

.reward-screen .reward-progression-row--pending,
.reward-screen .reward-progression-row--locked {
    border-left-color: var(--sm-fam-mystic);
}

/* ADR-0028 #1: 정치 정산 행 — 신뢰 상승(금)/하락(주홍)으로 일반 ledger 행과 구분. */
.reward-screen .reward-progression-row--politics-gain {
    border-left-color: var(--sm-gold-100);
    background-color: rgba(36, 30, 14, 0.80);
}

.reward-screen .reward-progression-row--politics-loss {
    border-left-color: var(--sm-fam-striker);
    background-color: rgba(34, 18, 16, 0.80);
}

.reward-screen .reward-progression-row--permanent-unlock {
    border-left-color: var(--sm-gold-200);
    background-color: rgba(40, 32, 12, 0.85);
}

/* 진형 페이오프 — "내가 그린 그림"의 확인. MVP(밝은 금)/진형 전과(금)/발현(신비 보라)으로 묶어 ledger 에서 구분. */
.reward-screen .reward-progression-row--formation-mvp {
    border-left-color: var(--sm-gold-100);
    background-color: rgba(36, 30, 14, 0.80);
}

.reward-screen .reward-progression-row--formation-highlight {
    border-left-color: var(--sm-gold-200);
    background-color: rgba(36, 30, 14, 0.72);
}

.reward-screen .reward-progression-row--formation-manifest {
    border-left-color: var(--sm-fam-mystic);
    background-color: rgba(28, 22, 36, 0.78);
}

.reward-screen .reward-progression-row__key {
    /* wave-28-continue GPT Pro patch: key width 98→120, font 11→12. */
    width: 120px;
    min-width: 120px;
    color: var(--sm-gold-200);
    font-size: var(--sm-fs-s);
    -unity-font-style: bold;
}

.reward-screen .reward-progression-row__value {
    /* wave-28-continue: value font 10→12, line-height 13→16. survivor row readability. */
    flex-grow: 1;
    color: var(--sm-vellum);
    font-size: var(--sm-fs-s);
    line-height: 16px;
    white-space: normal;
}

/* wave-28-survivor GPT Pro patch: squad survivor row — portrait glyph + name + HP bar + EXP + status chip. */
.reward-screen .reward-survivor-panel {
    margin-bottom: var(--sm-s-3);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: var(--sm-s-3);
    padding-bottom: var(--sm-s-3);
}
.reward-screen .reward-survivor-rows {
    flex-direction: column;
}
.reward-screen .reward-survivor-row {
    flex-direction: row;
    align-items: center;
    padding-top: var(--sm-s-2);
    padding-bottom: var(--sm-s-2);
    padding-left: var(--sm-s-2);
    padding-right: var(--sm-s-2);
    margin-bottom: var(--sm-s-1);
    background-color: rgba(28, 22, 12, 0.74);
    border-left-width: 2px;
    border-left-color: var(--sm-gold-300-a42);
}
.reward-screen .reward-survivor-row--victory {
    border-left-color: var(--sm-gold-100);
}
.reward-screen .reward-survivor-row--downed {
    border-left-color: rgba(220, 80, 70, 0.78);
    opacity: 0.72;
}
.reward-screen .reward-survivor-row--retreat {
    border-left-color: rgba(180, 140, 80, 0.62);
}
.reward-screen .reward-survivor-row__portrait {
    width: 36px;
    height: 36px;
    margin-right: var(--sm-s-3);
    font-size: 22px;
    color: var(--sm-gold-100);
    -unity-text-align: middle-center;
    background-color: rgba(48, 36, 20, 0.92);
}
.reward-screen .reward-survivor-row__copy {
    flex-grow: 1;
    flex-direction: column;
}
.reward-screen .reward-survivor-row__name {
    color: var(--sm-vellum);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}
.reward-screen .reward-survivor-row__stats {
    flex-direction: row;
    align-items: center;
}
.reward-screen .reward-survivor-row__hp {
    color: var(--sm-ink-1);
    font-size: var(--sm-fs-eb);
    min-width: 60px;
}
.reward-screen .reward-survivor-row__hp-bar {
    flex-grow: 1;
    height: 6px;
    margin-left: var(--sm-s-2);
    margin-right: var(--sm-s-2);
    background-color: rgba(28, 22, 12, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a28);
    border-right-color: var(--sm-gold-300-a28);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a28);
}
.reward-screen .reward-survivor-row__hp-fill {
    height: 4px;
    background-color: rgba(160, 220, 120, 0.92);
}
.reward-screen .reward-survivor-row--downed .reward-survivor-row__hp-fill {
    background-color: rgba(220, 80, 70, 0.92);
}
.reward-screen .reward-survivor-row__exp {
    color: var(--sm-gold-200);
    font-size: 10px;
    min-width: 56px;
    -unity-text-align: middle-right;
}
.reward-screen .reward-survivor-row__chip {
    margin-left: 10px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--sm-vellum);
    background-color: rgba(28, 22, 12, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}
.reward-screen .reward-survivor-row__chip--victory {
    color: rgba(180, 232, 140, 0.98);
    border-left-color: rgba(160, 220, 120, 0.62);
    border-right-color: rgba(160, 220, 120, 0.62);
    border-top-color: rgba(160, 220, 120, 0.62);
    border-bottom-color: rgba(160, 220, 120, 0.62);
}
.reward-screen .reward-survivor-row__chip--downed {
    color: rgba(232, 140, 132, 0.98);
    border-left-color: rgba(220, 100, 90, 0.62);
    border-right-color: rgba(220, 100, 90, 0.62);
    border-top-color: rgba(220, 100, 90, 0.62);
    border-bottom-color: rgba(220, 100, 90, 0.62);
}
.reward-screen .reward-survivor-row__chip--retreat {
    color: rgba(232, 200, 132, 0.98);
}

.reward-screen .reward-choice-panel {
    flex-grow: 1;
    min-height: 0;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    padding-right: 18px;
}

.reward-screen .reward-card-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    margin-top: 14px;
}

.reward-screen .reward-card {
    /* wave-28 GPT Pro patch: reward card 500→400px로 density 낮춤.
       left progression + right next-choice column이 secondary로 밀리던 문제 회복. */
    flex-grow: 1;
    min-width: 0;
    min-height: 400px;
    margin-right: var(--sm-s-3);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgba(17, 18, 28, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.reward-screen .reward-card--gold {
    border-left-width: 2px;
    border-left-color: var(--sm-gold-300);
}

.reward-screen .reward-card--steel {
    border-left-width: 2px;
    border-left-color: var(--sm-state-shield-a82);
}

.reward-screen .reward-card--violet {
    border-left-width: 2px;
    border-left-color: var(--sm-fam-mystic);
}

.reward-screen .reward-card__art {
    /* wave-28: card height 축소에 맞춰 art 210→164. */
    height: 164px;
    margin-bottom: 14px;
    align-items: center;
    justify-content: center;
    background-color: rgba(230, 183, 81, 0.08);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a28);
    border-right-color: var(--sm-gold-300-a28);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a28);
}

.reward-screen .reward-card__art--steel {
    background-color: rgba(73, 137, 170, 0.12);
}

.reward-screen .reward-card__art--violet {
    background-color: rgba(114, 70, 170, 0.14);
}

.reward-screen .reward-card__sigil {
    width: 124px;
    height: 124px;
    rotate: 0deg;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(245, 214, 138, 0.96);
}

.reward-screen .reward-card__art--gold .reward-card__sigil {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Currency/currency_gold.png");
}

.reward-screen .reward-card__art--steel .reward-card__sigil {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Affix/affix_atk.png");
    -unity-background-image-tint-color: rgba(140, 210, 255, 0.94);
}

.reward-screen .reward-card__art--violet .reward-card__sigil {
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Augment/augment_star.png");
    -unity-background-image-tint-color: rgba(214, 160, 255, 0.94);
}

.reward-screen .reward-card .card__title {
    color: var(--sm-gold-100);
    font-size: var(--sm-fs-l);
    -unity-font-style: bold;
    white-space: normal;
}

.reward-screen .reward-card .card__body {
    min-height: 58px;
    margin-top: var(--sm-s-3);
    color: var(--sm-ink-1);
    font-size: var(--sm-fs-eb);
    line-height: 15px;
    white-space: normal;
}

.reward-screen .reward-card .panel__text--muted {
    margin-top: 9px;
    font-size: 10px;
    line-height: 13px;
    white-space: normal;
}

.reward-screen .reward-card .ui-button {
    margin-top: 14px;
    min-height: 42px;
}

.reward-screen .reward-bible__decision-glyph {
    height: 190px;
    min-height: 190px;
    margin-bottom: var(--sm-s-3);
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 16, 29, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a36);
    border-right-color: var(--sm-gold-300-a36);
    border-top-color: var(--sm-gold-300-a36);
    border-bottom-color: var(--sm-gold-300-a36);
}

.reward-screen .reward-bible__decision-icon {
    width: 118px;
    height: 118px;
    border-radius: 59px;
    background-color: var(--sm-gold-300-a20);
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Posture/posture_standard_advance.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(245, 214, 138, 0.95);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300);
    border-right-color: var(--sm-gold-300);
    border-top-color: var(--sm-gold-300);
    border-bottom-color: var(--sm-gold-300);
}

.reward-screen .reward-run-delta-panel,
.reward-screen .reward-build-impact-panel {
    height: 188px;
    min-height: 188px;
    margin-bottom: var(--sm-s-3);
    overflow: hidden;
    padding-top: 14px;
    padding-bottom: var(--sm-s-3);
    padding-left: 14px;
    padding-right: 14px;
}

.reward-screen .reward-run-delta-panel .panel__text,
.reward-screen .reward-build-impact-panel .panel__text {
    margin-top: 10px;
    font-size: 10px;
    line-height: 13px;
    overflow: hidden;
}

.reward-screen .reward-timeline-panel {
    position: relative;
    height: 106px;
    min-height: 106px;
    margin-top: 14px;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: var(--sm-s-3);
    padding-bottom: 10px;
}

.reward-screen .reward-timeline-ticks {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--sm-s-2);
}

.reward-screen .reward-timeline-tick {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    margin-right: 10px;
}

.reward-screen .reward-timeline-tick__marker {
    width: 28px;
    height: 28px;
    margin-bottom: 5px;
    border-radius: 14px;
    background-color: rgba(17, 22, 36, 0.96);
    color: var(--sm-gold-200);
    -unity-text-align: middle-center;
    font-size: var(--sm-fs-m);
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a42);
    border-top-color: var(--sm-gold-300-a42);
    border-bottom-color: var(--sm-gold-300-a42);
}

.reward-screen .reward-timeline-tick--complete .reward-timeline-tick__marker {
    background-color: var(--sm-state-safe-a86);
    color: rgb(7, 10, 19);
}

.reward-screen .reward-timeline-tick--current .reward-timeline-tick__marker {
    background-color: var(--sm-gold-300);
    color: rgb(7, 10, 19);
}

.reward-screen .reward-timeline-tick__text {
    color: var(--sm-ink-2);
    font-size: var(--sm-fs-xs);
    line-height: 11px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.reward-screen .reward-bible__status-band {
    height: 72px;
    min-height: 72px;
    margin-top: var(--sm-s-3);
    flex-direction: row;
    align-items: center;
    padding-left: var(--sm-s-4);
    padding-right: var(--sm-s-4);
}

.reward-screen .reward-bible__status-band .action-group {
    width: 250px;
}

.reward-screen .reward-bible__status-band .ui-button {
    min-width: 220px;
}

/* UX Bible 80 pass — stronger result ceremony while preserving existing reward choice flow. */
.reward-screen .reward-choice-panel {
    background-color: rgba(8, 12, 25, 0.94);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--sm-gold-300-a42);
    border-right-color: var(--sm-gold-300-a28);
    border-top-color: rgba(245, 214, 138, 0.34);
    border-bottom-color: rgba(138, 100, 24, 0.56);
}

.reward-screen .reward-bible__victory-medallion {
    height: 116px;
    min-height: 116px;
    margin-top: var(--sm-s-3);
    margin-bottom: var(--sm-s-1);
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 18, 34, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--sm-gold-300-a20);
    border-right-color: var(--sm-gold-300-a20);
    border-top-color: rgba(245, 214, 138, 0.20);
    border-bottom-color: rgba(138, 100, 24, 0.34);
}

.reward-screen .reward-bible__victory-ring {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-radius: 999px;
}

.reward-screen .reward-bible__victory-ring--outer {
    width: 96px;
    height: 96px;
    border-left-color: rgba(245, 214, 138, 0.48);
    border-right-color: rgba(245, 214, 138, 0.48);
    border-top-color: rgba(245, 214, 138, 0.48);
    border-bottom-color: rgba(245, 214, 138, 0.48);
}

.reward-screen .reward-bible__victory-ring--inner {
    width: 68px;
    height: 68px;
    border-left-color: var(--sm-gold-300-a28);
    border-right-color: var(--sm-gold-300-a28);
    border-top-color: var(--sm-gold-300-a28);
    border-bottom-color: var(--sm-gold-300-a28);
}

.reward-screen .reward-bible__victory-icon {
    width: 62px;
    height: 62px;
    background-image: url("project://database/Assets/_Game/UI/Foundation/Sprites/Augment/augment_star.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(245, 214, 138, 0.96);
}

.reward-screen .reward-bible__victory-runes {
    position: absolute;
    left: 34px;
    right: 34px;
    bottom: 14px;
    flex-direction: row;
    justify-content: space-between;
}

.reward-screen .reward-bible__victory-rune {
    width: 46px;
    height: 5px;
    background-color: var(--sm-gold-300-a34);
}

.reward-screen .reward-bible__victory-rune--blue {
    background-color: rgba(129, 184, 245, 0.56);
}

.reward-screen .reward-bible__victory-rune--green {
    background-color: rgba(135, 190, 92, 0.56);
}

.reward-screen .reward-bible__victory-rune--red {
    background-color: rgba(235, 116, 91, 0.50);
}

.reward-screen .reward-card-row {
    margin-top: 10px;
}

.reward-screen .reward-card {
    min-height: 520px;
    background-color: rgba(12, 14, 26, 0.96);
    border-bottom-color: rgba(138, 100, 24, 0.58);
}

.reward-screen .reward-card__art {
    height: 232px;
    background-color: rgba(230, 183, 81, 0.11);
}

.reward-screen .reward-card__sigil {
    width: 142px;
    height: 142px;
}

.reward-screen .reward-run-delta-panel,
.reward-screen .reward-build-impact-panel,
.reward-screen .reward-progression-panel,
.reward-screen .reward-settlement-summary {
    background-color: rgba(8, 13, 31, 0.92);
}

.reward-screen .reward-timeline-panel {
    height: 116px;
    min-height: 116px;
    border-top-width: 2px;
    border-top-color: rgba(245, 214, 138, 0.26);
}

/* UX Bible visual QA pass 2: compact ceremony title inside the real result selector panel. */
.reward-screen .reward-bible__victory-banner {
    position: absolute;
    left: 34px;
    right: 34px;
    top: 12px;
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--sm-gold-300-a22);
}

.reward-screen .reward-bible__victory-banner-text {
    color: rgba(245, 214, 138, 0.86);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0;
}

.reward-screen .reward-bible__victory-banner-text--ko {
    color: var(--sm-ink-2);
    letter-spacing: 0;
}

.reward-screen .reward-card {
    border-left-color: rgba(245, 214, 138, 0.36);
    border-right-color: var(--sm-gold-300-a24);
    border-top-color: rgba(245, 214, 138, 0.30);
}

.reward-screen .reward-card .card__title {
    font-size: 20px;
}
