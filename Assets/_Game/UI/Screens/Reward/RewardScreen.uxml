<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="RewardScreenRoot" class="screen reward-screen reward-bible">
        <ui:VisualElement class="reward-bible__backdrop" />
        <ui:VisualElement class="screen__topbar reward-bible__topbar">
            <!-- wave-39 chrome cleanup: crest + rune row 제거 (책임 매트릭스 §11 chrome budget) -->
            <ui:VisualElement class="reward-bible__title-stack">
                <ui:Label name="TitleLabel" class="screen__title reward-bible__title" />
            </ui:VisualElement>
            <ui:VisualElement class="screen__toolbar">
                <ui:VisualElement class="screen__locale">
                    <ui:Label name="LocaleStatusLabel" class="screen__locale-status" />
                    <ui:Button name="LocaleKoButton" class="ui-button" />
                    <ui:Button name="LocaleEnButton" class="ui-button" />
                </ui:VisualElement>
                <ui:Button name="HelpButton" class="ui-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="HelpStrip" class="panel panel--dense help-strip">
            <ui:Label name="HelpBodyLabel" class="panel__text help-strip__body" />
            <ui:Button name="HelpDismissButton" class="ui-button help-strip__dismiss" />
        </ui:VisualElement>

        <ui:VisualElement class="screen__body reward-bible__board">
            <ui:VisualElement class="screen__column reward-bible__left-rail">
                <ui:VisualElement name="SettlementSummaryPanel" class="panel panel--dense reward-settlement-summary">
                    <ui:Label name="SettlementSummaryTitleLabel" class="panel__title reward-settlement-summary__title" />
                    <ui:VisualElement class="reward-settlement-summary__rows">
                        <ui:VisualElement class="reward-settlement-summary__row">
                            <ui:Label name="SettlementSiteKeyLabel" class="reward-settlement-summary__key" />
                            <ui:Label name="SettlementSiteValueLabel" class="reward-settlement-summary__value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="reward-settlement-summary__row">
                            <ui:Label name="SettlementStageKeyLabel" class="reward-settlement-summary__key" />
                            <ui:Label name="SettlementStageValueLabel" class="reward-settlement-summary__value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="reward-settlement-summary__row">
                            <ui:Label name="SettlementEncounterKeyLabel" class="reward-settlement-summary__key" />
                            <ui:Label name="SettlementEncounterValueLabel" class="reward-settlement-summary__value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="reward-settlement-summary__row">
                            <ui:Label name="SettlementCommitIdKeyLabel" class="reward-settlement-summary__key" />
                            <ui:Label name="SettlementCommitIdValueLabel" class="reward-settlement-summary__value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="SettlementModifierChips" class="reward-settlement-summary__chips">
                        <ui:Label name="SettlementModifierRewardBiasChip" class="reward-settlement-summary__chip" />
                        <ui:Label name="SettlementModifierThreatPressureChip" class="reward-settlement-summary__chip" />
                        <ui:Label name="SettlementModifierAffinityBoostChip" class="reward-settlement-summary__chip" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- wave-28-survivor GPT Pro patch: squad 4 survivor list (portrait + HP/EXP). -->
                <ui:VisualElement class="panel reward-survivor-panel">
                    <ui:Label class="panel__title" text="전투 생존자" />
                    <ui:VisualElement name="RewardSurvivorRows" class="reward-survivor-rows" />
                </ui:VisualElement>
                <ui:VisualElement class="panel reward-progression-panel">
                    <ui:Label name="ProgressionTitleLabel" class="panel__title" />
                    <ui:VisualElement name="RewardProgressionRows" class="reward-progression-rows" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="screen__column reward-bible__center-stage">
                <ui:VisualElement class="panel reward-choice-panel">
                    <ui:Label name="ChoicesHeaderLabel" class="panel__title" />
                    <!-- wave-39 chrome cleanup: victory medallion + runes 제거 (선택 결정 surface, mood ornament 불필요) -->
                    <ui:VisualElement class="reward-bible__victory-banner reward-bible__victory-banner--flat">
                        <ui:Label name="RewardVictoryBannerResultLabel" class="reward-bible__victory-banner-text" text="RESULT" />
                        <ui:Label name="RewardVictoryBannerStatusLabel" class="reward-bible__victory-banner-text reward-bible__victory-banner-text--ko" text="정산 완료" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card-row reward-card-row">
                        <ui:VisualElement class="card reward-card reward-card--gold" name="ChoiceCard1">
                            <ui:VisualElement class="reward-card__art reward-card__art--gold">
                                <ui:VisualElement class="reward-card__sigil" />
                            </ui:VisualElement>
                            <ui:Label name="ChoiceCard1TitleLabel" class="card__title" />
                            <ui:Label name="ChoiceCard1KindLabel" class="panel__text panel__text--muted" />
                            <ui:Label name="ChoiceCard1BodyLabel" class="card__body" />
                            <ui:Label name="ChoiceCard1ContextLabel" class="panel__text panel__text--muted" />
                            <ui:Button name="ChoiceCard1Button" class="ui-button" />
                        </ui:VisualElement>
                        <ui:VisualElement class="card reward-card reward-card--steel" name="ChoiceCard2">
                            <ui:VisualElement class="reward-card__art reward-card__art--steel">
                                <ui:VisualElement class="reward-card__sigil" />
                            </ui:VisualElement>
                            <ui:Label name="ChoiceCard2TitleLabel" class="card__title" />
                            <ui:Label name="ChoiceCard2KindLabel" class="panel__text panel__text--muted" />
                            <ui:Label name="ChoiceCard2BodyLabel" class="card__body" />
                            <ui:Label name="ChoiceCard2ContextLabel" class="panel__text panel__text--muted" />
                            <ui:Button name="ChoiceCard2Button" class="ui-button" />
                        </ui:VisualElement>
                        <ui:VisualElement class="card reward-card reward-card--violet" name="ChoiceCard3">
                            <ui:VisualElement class="reward-card__art reward-card__art--violet">
                                <ui:VisualElement class="reward-card__sigil" />
                            </ui:VisualElement>
                            <ui:Label name="ChoiceCard3TitleLabel" class="card__title" />
                            <ui:Label name="ChoiceCard3KindLabel" class="panel__text panel__text--muted" />
                            <ui:Label name="ChoiceCard3BodyLabel" class="card__body" />
                            <ui:Label name="ChoiceCard3ContextLabel" class="panel__text panel__text--muted" />
                            <ui:Button name="ChoiceCard3Button" class="ui-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="screen__column reward-bible__right-rail">
                <ui:VisualElement class="reward-bible__decision-glyph">
                    <ui:VisualElement class="reward-bible__decision-icon" />
                </ui:VisualElement>
                <ui:VisualElement class="panel reward-run-delta-panel">
                    <ui:Label name="SummaryTitleLabel" class="panel__title" />
                    <ui:Label name="RunDeltaLabel" class="panel__text" />
                </ui:VisualElement>
                <ui:VisualElement class="panel reward-build-impact-panel">
                    <ui:Label name="BuildContextTitleLabel" class="panel__title" />
                    <ui:Label name="BuildContextLabel" class="panel__text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="panel reward-timeline-panel">
            <ui:Label name="TimelineTitleLabel" class="panel__title" />
            <ui:VisualElement name="RewardTimelineTicks" class="reward-timeline-ticks" />
        </ui:VisualElement>

        <ui:VisualElement class="panel panel--dense status-bar reward-bible__status-band">
            <ui:VisualElement class="action-group">
                <ui:VisualElement class="action-row">
                    <ui:Button name="ReturnTownButton" class="ui-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="StatusLabel" class="panel__text panel__text--muted" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
