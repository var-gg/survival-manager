.cmp-root {
    flex-grow: 1;
    color: var(--sm-ink-1);
}

.cmp-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/_Game/UI/Backdrops/town_frontier_village_dusk.png");
    -unity-background-scale-mode: scale-and-crop;
}

.cmp-backdrop-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 12, 28, 0.68);
}

.cmp-frame {
    left: 54px;
    right: 54px;
    top: 42px;
    bottom: 42px;
}

.cmp-header {
    flex-direction: row;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 14px;
    padding-left: 24px;
    padding-right: 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(138, 100, 24, 0.32);
}

.cmp-header__copy {
    flex-grow: 1;
    flex-direction: column;
}

.cmp-title {
    color: var(--sm-vellum);
    font-size: 22px;
    -unity-font-style: bold;
}

.cmp-subtitle {
    color: var(--sm-ink-3);
    font-size: 12px;
    margin-top: 4px;
}

.cmp-close {
    width: 72px;
}

.cmp-tabs {
    flex-direction: row;
    padding-top: 10px;
    padding-bottom: 8px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgba(20, 26, 53, 0.72);
}

.cmp-tab {
    min-width: 108px;
    margin-right: 8px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgba(38, 45, 84, 0.74);
    color: var(--sm-ink-2);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.32);
    border-right-color: rgba(230, 183, 81, 0.32);
    border-top-color: rgba(230, 183, 81, 0.32);
    border-bottom-color: rgba(230, 183, 81, 0.32);
    -unity-font-style: bold;
}

.cmp-tab--selected {
    background-color: rgba(200, 147, 42, 0.32);
    color: var(--sm-gold-100);
    border-left-color: var(--sm-gold-200);
    border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200);
    border-bottom-color: var(--sm-gold-200);
}

.cmp-filters {
    flex-direction: row;
    align-items: center;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgba(13, 18, 40, 0.78);
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 183, 81, 0.18);
}

.cmp-filter__search {
    width: 230px;
    margin-right: 10px;
    color: var(--sm-vellum);
}

.cmp-filter__skill-row {
    flex-direction: row;
    flex-grow: 1;
}

.cmp-filter__dropdown {
    width: 164px;
    margin-right: 8px;
    color: var(--sm-vellum);
}

.cmp-filter__summary {
    min-width: 92px;
    color: var(--sm-ink-3);
    font-size: 11px;
    -unity-text-align: middle-right;
}

.cmp-body {
    flex-direction: row;
    flex-grow: 1;
    padding: 16px;
}

.cmp-entry-scroll {
    width: 440px;
    margin-right: 14px;
}

.cmp-entry-list {
    flex-direction: column;
}

.cmp-entry-list--skill-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.cmp-skill-card {
    width: 206px;
    min-height: 198px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding-top: 10px;
    padding-bottom: 9px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(26, 34, 69, 0.84);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.30);
    border-right-color: rgba(230, 183, 81, 0.30);
    border-top-color: rgba(230, 183, 81, 0.30);
    border-bottom-color: rgba(230, 183, 81, 0.30);
}

.cmp-skill-card--selected {
    background-color: rgba(200, 147, 42, 0.24);
    border-left-color: var(--sm-gold-200);
    border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200);
    border-bottom-color: var(--sm-gold-200);
}

.cmp-skill-card__top {
    flex-direction: row;
    align-items: center;
}

.cmp-skill-card__icon {
    width: 58px;
    height: 58px;
    margin-right: 9px;
    background-color: rgba(245, 234, 208, 0.08);
    -unity-background-scale-mode: scale-to-fit;
}

.cmp-skill-card__headline {
    flex-grow: 1;
    flex-direction: column;
}

.cmp-skill-card__intent {
    color: var(--sm-gold-200);
    font-size: 10px;
    -unity-font-style: bold;
    white-space: normal;
}

.cmp-skill-card__title {
    color: var(--sm-vellum);
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 3px;
    white-space: normal;
}

.cmp-skill-card__chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 9px;
}

.cmp-skill-card__chip {
    margin-right: 5px;
    margin-bottom: 5px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 6px;
    padding-right: 6px;
    color: var(--sm-ink-2);
    font-size: 10px;
    background-color: rgba(245, 234, 208, 0.07);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(245, 234, 208, 0.18);
    border-right-color: rgba(245, 234, 208, 0.18);
    border-top-color: rgba(245, 234, 208, 0.18);
    border-bottom-color: rgba(245, 234, 208, 0.18);
    white-space: normal;
}

.cmp-skill-card__chip--slot {
    color: var(--sm-gold-100);
}

.cmp-skill-card__line {
    color: var(--sm-ink-2);
    font-size: 10px;
    margin-top: 2px;
    white-space: normal;
}

.cmp-skill-card__stats {
    color: var(--sm-vellum);
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 6px;
    white-space: normal;
}

.cmp-skill-card__status {
    color: rgba(116, 255, 190, 0.92);
    font-size: 10px;
    margin-top: 5px;
    white-space: normal;
}

.cmp-skill-card__vfx {
    color: var(--sm-ink-3);
    font-size: 10px;
    margin-top: 5px;
    white-space: normal;
}

.cmp-entry {
    flex-direction: row;
    margin-bottom: 8px;
    padding: 9px;
    min-height: 76px;
    background-color: rgba(28, 34, 67, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.28);
    border-right-color: rgba(230, 183, 81, 0.28);
    border-top-color: rgba(230, 183, 81, 0.28);
    border-bottom-color: rgba(230, 183, 81, 0.28);
}

.cmp-entry--selected {
    background-color: rgba(200, 147, 42, 0.24);
    border-left-color: var(--sm-gold-200);
    border-right-color: var(--sm-gold-200);
    border-top-color: var(--sm-gold-200);
    border-bottom-color: var(--sm-gold-200);
}

.cmp-entry--locked {
    opacity: 0.62;
}

.cmp-entry--locked .cmp-entry__icon {
    background-color: rgba(245, 234, 208, 0.04);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(245, 234, 208, 0.26);
    border-right-color: rgba(245, 234, 208, 0.26);
    border-top-color: rgba(245, 234, 208, 0.26);
    border-bottom-color: rgba(245, 234, 208, 0.26);
}

.cmp-entry__icon {
    width: 54px;
    height: 54px;
    margin-right: 10px;
    background-color: rgba(245, 234, 208, 0.08);
    -unity-background-scale-mode: scale-to-fit;
}

.cmp-entry__copy {
    flex-grow: 1;
    flex-direction: column;
}

.cmp-entry__title {
    color: var(--sm-vellum);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.cmp-entry__meta {
    color: var(--sm-gold-200);
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}

.cmp-entry__hook {
    color: var(--sm-ink-3);
    font-size: 10px;
    margin-top: 3px;
    white-space: normal;
}

.cmp-detail {
    flex-grow: 1;
    padding: 18px;
    background-color: rgba(28, 34, 67, 0.86);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.45);
    border-right-color: rgba(230, 183, 81, 0.45);
    border-top-color: rgba(230, 183, 81, 0.45);
    border-bottom-color: rgba(230, 183, 81, 0.45);
}

.cmp-detail__icon {
    width: 112px;
    height: 112px;
    align-self: flex-start;
    background-color: rgba(245, 234, 208, 0.06);
    -unity-background-scale-mode: scale-to-fit;
}

.cmp-detail__title {
    color: var(--sm-vellum);
    font-size: 24px;
    -unity-font-style: bold;
    margin-top: 14px;
    white-space: normal;
}

.cmp-detail__subtitle {
    color: var(--sm-gold-200);
    font-size: 12px;
    margin-top: 4px;
    white-space: normal;
}

.cmp-detail__description {
    color: var(--sm-ink-2);
    font-size: 13px;
    margin-top: 14px;
    white-space: normal;
}

.cmp-detail__hook {
    color: var(--sm-ink-3);
    font-size: 11px;
    margin-top: 10px;
    white-space: normal;
}

.cmp-vfx-stage {
    height: 178px;
    margin-top: 14px;
    overflow: hidden;
    position: relative;
    background-color: rgba(9, 13, 28, 0.86);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 183, 81, 0.32);
    border-right-color: rgba(230, 183, 81, 0.32);
    border-top-color: rgba(230, 183, 81, 0.32);
    border-bottom-color: rgba(230, 183, 81, 0.32);
}

.cmp-vfx-stage__grid {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(245, 234, 208, 0.03);
}

.cmp-vfx-prefab-preview {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.9;
    -unity-background-scale-mode: scale-to-fit;
}

.cmp-vfx-node {
    position: absolute;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(245, 234, 208, 0.52);
    border-right-color: rgba(245, 234, 208, 0.52);
    border-top-color: rgba(245, 234, 208, 0.52);
    border-bottom-color: rgba(245, 234, 208, 0.52);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.cmp-vfx-node--caster {
    background-color: rgba(87, 161, 255, 0.36);
}

.cmp-vfx-node--target {
    background-color: rgba(255, 111, 99, 0.32);
}

.cmp-vfx-trace {
    position: absolute;
    background-color: rgba(255, 221, 128, 0.68);
}

.cmp-vfx-projectile,
.cmp-vfx-burst,
.cmp-vfx-pulse {
    position: absolute;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.cmp-vfx-projectile {
    background-color: rgba(255, 233, 148, 0.88);
}

.cmp-vfx-burst {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 233, 148, 0.82);
    border-right-color: rgba(255, 233, 148, 0.82);
    border-top-color: rgba(255, 233, 148, 0.82);
    border-bottom-color: rgba(255, 233, 148, 0.82);
    background-color: rgba(255, 122, 82, 0.18);
}

.cmp-vfx-pulse {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 233, 148, 0.52);
    border-right-color: rgba(255, 233, 148, 0.52);
    border-top-color: rgba(255, 233, 148, 0.52);
    border-bottom-color: rgba(255, 233, 148, 0.52);
}

.cmp-vfx-caption {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 9px;
    flex-direction: column;
}

.cmp-vfx-caption__title {
    color: var(--sm-vellum);
    font-size: 11px;
    -unity-font-style: bold;
}

.cmp-vfx-caption__body {
    color: var(--sm-ink-3);
    font-size: 10px;
    margin-top: 2px;
    white-space: normal;
}

.cmp-vfx-replay {
    align-self: flex-start;
    margin-top: 8px;
    min-width: 72px;
}

.cmp-vfx-stage--projectile .cmp-vfx-projectile,
.cmp-vfx-stage--projectile .cmp-vfx-trace {
    background-color: rgba(255, 216, 95, 0.82);
}

.cmp-vfx-stage--arcane .cmp-vfx-projectile,
.cmp-vfx-stage--arcane .cmp-vfx-trace {
    background-color: rgba(118, 212, 255, 0.82);
}

.cmp-vfx-stage--arcane .cmp-vfx-burst,
.cmp-vfx-stage--control .cmp-vfx-burst {
    border-left-color: rgba(148, 189, 255, 0.82);
    border-right-color: rgba(148, 189, 255, 0.82);
    border-top-color: rgba(148, 189, 255, 0.82);
    border-bottom-color: rgba(148, 189, 255, 0.82);
    background-color: rgba(89, 109, 205, 0.20);
}

.cmp-vfx-stage--area .cmp-vfx-burst,
.cmp-vfx-stage--area .cmp-vfx-pulse {
    border-left-color: rgba(255, 171, 88, 0.82);
    border-right-color: rgba(255, 171, 88, 0.82);
    border-top-color: rgba(255, 171, 88, 0.82);
    border-bottom-color: rgba(255, 171, 88, 0.82);
}

.cmp-vfx-stage--heal .cmp-vfx-projectile,
.cmp-vfx-stage--heal .cmp-vfx-trace,
.cmp-vfx-stage--heal .cmp-vfx-burst {
    background-color: rgba(92, 231, 163, 0.30);
}

.cmp-vfx-stage--heal .cmp-vfx-burst,
.cmp-vfx-stage--heal .cmp-vfx-pulse {
    border-left-color: rgba(116, 255, 190, 0.82);
    border-right-color: rgba(116, 255, 190, 0.82);
    border-top-color: rgba(116, 255, 190, 0.82);
    border-bottom-color: rgba(116, 255, 190, 0.82);
}

.cmp-vfx-stage--guard .cmp-vfx-burst,
.cmp-vfx-stage--guard .cmp-vfx-pulse,
.cmp-vfx-stage--aura .cmp-vfx-burst,
.cmp-vfx-stage--aura .cmp-vfx-pulse {
    border-left-color: rgba(118, 204, 255, 0.82);
    border-right-color: rgba(118, 204, 255, 0.82);
    border-top-color: rgba(118, 204, 255, 0.82);
    border-bottom-color: rgba(118, 204, 255, 0.82);
}

.cmp-vfx-stage--control .cmp-vfx-projectile,
.cmp-vfx-stage--control .cmp-vfx-trace {
    background-color: rgba(191, 125, 255, 0.72);
}

.cmp-detail__metrics {
    margin-top: 16px;
    flex-direction: column;
}

.cmp-metric {
    flex-direction: row;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(230, 183, 81, 0.18);
}

.cmp-metric__label {
    width: 112px;
    color: var(--sm-ink-3);
    font-size: 11px;
}

.cmp-metric__value {
    flex-grow: 1;
    color: var(--sm-vellum);
    font-size: 11px;
    white-space: normal;
}
